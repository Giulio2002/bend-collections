def main() -> IO(Unit):
  do IO<Unit>:
    n0 : Nat <- part0(0n)
    n1 : Nat <- part1(n0)
    n2 : Nat <- part2(n1)
    n3 : Nat <- part3(n2)
    n4 : Nat <- part4(n3)
    n5 : Nat <- part5(n4)
