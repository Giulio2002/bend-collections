def digit_if(small: Bool, x: U32) -> Char:
  match small:
    case True{}: Chr{U32.add(48, x)}
    case False{}: Chr{U32.add(87, x)}

def hex_digit(+x: U32) -> Char:
  digit_if(U32.is_lt(x, 10), x)

def hex(bs: List<&2, U32>) -> String:
  match bs:
    case Nil{}: ""
    case +b <> t: SCon{hex_digit(U32.shrn(b, 4n)), SCon{hex_digit(U32.and(b, 15)), hex(t)}}

def show(r: Maybe<&2, List<&2, U32>>) -> String:
  match r:
    case None{}: "none"
    case Some{x}: hex(x)

def bit(b: Bool) -> String:
  match b:
    case True{}: "true"
    case False{}: "false"

def verdict(ok: Bool, label: String, got: String, want: String, n: Nat) -> IO(Nat):
  match ok:
    case True{}: IO.pure(Nat, 1n+n)
    case False{}:
      do IO<Nat>:
        IO.print("FAIL " ++ label ++ ": got " ++ got ++ " want " ++ want)
        return n

def check(label: String, +got: String, +want: String, n: Nat) -> IO(Nat):
  verdict(String.eq(got, want), label, got, want, n)

