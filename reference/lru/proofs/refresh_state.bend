def binding_lookup(-V: Data, +c: C.Cache<String, V>, +key: String, +value: V, +old: T.Int64, +ns: T.Int64, +now: T.Int64, +query: String, +valid: {Inv.representation(~String, ~Codec.string_encode, V, c) == True{} : Bool}, present: {C.lookup(String, V, c, key) == Some{T.Item{key, value, old}} : Maybe<&2, T.Entry<String, V>>}) -> {S.find(~String, ~Lookup.string_same, V, B.model_bindings(String, V, Order.normal(V, C.step_cache(String, V, C.refresh_present(String, V, c, key, T.Item{key, value, Time.deadline(now, ns)})))), query) == S.find(~String, ~Lookup.string_same, V, B.model_bindings(String, V, O.observed_state(String, V, O.refreshed(~String, ~Lookup.string_same, V, Order.normal(V, c), T.Item{key, value, old}, Time.deadline(now, ns)))), query) : Maybe<&2, T.Entry<String, V>>}:
  C.State{+cap, +table, +order, +life, T.Counts{+i, +e, +r, +h, +m}, +cb} = c
  Equal.trans(Maybe<&2, T.Entry<String, V>>, S.find(~String, ~Lookup.string_same, V, B.model_bindings(String, V, Order.normal(V, C.step_cache(String, V, C.refresh_present(String, V, C.State{cap, table, order, life, T.Counts{i, e, r, h, m}, cb}, key, T.Item{key, value, Time.deadline(now, ns)})))), query), C.lookup(String, V, C.step_cache(String, V, C.refresh_present(String, V, C.State{cap, table, order, life, T.Counts{i, e, r, h, m}, cb}, key, T.Item{key, value, Time.deadline(now, ns)})), query), Store.target(V, Order.normal(V, C.State{cap, table, order, life, T.Counts{i, e, r, h, m}, cb}), key, value, Time.deadline(now, ns), False{}, Nil{}, query), Equal.sym(Maybe<&2, T.Entry<String, V>>, C.lookup(String, V, C.step_cache(String, V, C.refresh_present(String, V, C.State{cap, table, order, life, T.Counts{i, e, r, h, m}, cb}, key, T.Item{key, value, Time.deadline(now, ns)})), query), S.find(~String, ~Lookup.string_same, V, B.model_bindings(String, V, Order.normal(V, C.step_cache(String, V, C.refresh_present(String, V, C.State{cap, table, order, life, T.Counts{i, e, r, h, m}, cb}, key, T.Item{key, value, Time.deadline(now, ns)})))), query), Removal.normal_lookup(V, C.step_cache(String, V, C.refresh_present(String, V, C.State{cap, table, order, life, T.Counts{i, e, r, h, m}, cb}, key, T.Item{key, value, Time.deadline(now, ns)})), query, Rep.present(~String, ~Codec.string_encode, V, C.State{cap, table, order, life, T.Counts{i, e, r, h, m}, cb}, key, key, value, old, ns, now, present, valid))), Store.correspondence(V, C.State{cap, table, order, life, T.Counts{i, e, r, h, m}, cb}, key, value, Time.deadline(now, ns), False{}, Nil{}, query, valid))

def lookups_refreshed(-V: Data, +c: C.Cache<String, V>, +key: String, +value: V, +old: T.Int64, +ns: T.Int64, +now: T.Int64, +valid: {Inv.representation(~String, ~Codec.string_encode, V, c) == True{} : Bool}, +present: {C.lookup(String, V, c, key) == Some{T.Item{key, value, old}} : Maybe<&2, T.Entry<String, V>>}, xs: List<&2, String>) -> {E.lookups(~String, ~Lookup.string_same, V, xs, B.model_bindings(String, V, Order.normal(V, C.step_cache(String, V, C.refresh_present(String, V, c, key, T.Item{key, value, Time.deadline(now, ns)}))))) == E.lookups(~String, ~Lookup.string_same, V, xs, B.model_bindings(String, V, O.observed_state(String, V, O.refreshed(~String, ~Lookup.string_same, V, Order.normal(V, c), T.Item{key, value, old}, Time.deadline(now, ns))))) : List<&2, Maybe<&2, T.Entry<String, V>>>}:
  match xs:
    case Nil{}: {==}
    case Con{+q, +rest}: CS.cons_equal(Maybe<&2, T.Entry<String, V>>, S.find(~String, ~Lookup.string_same, V, B.model_bindings(String, V, Order.normal(V, C.step_cache(String, V, C.refresh_present(String, V, c, key, T.Item{key, value, Time.deadline(now, ns)})))), q), S.find(~String, ~Lookup.string_same, V, B.model_bindings(String, V, O.observed_state(String, V, O.refreshed(~String, ~Lookup.string_same, V, Order.normal(V, c), T.Item{key, value, old}, Time.deadline(now, ns)))), q), E.lookups(~String, ~Lookup.string_same, V, rest, B.model_bindings(String, V, Order.normal(V, C.step_cache(String, V, C.refresh_present(String, V, c, key, T.Item{key, value, Time.deadline(now, ns)}))))), E.lookups(~String, ~Lookup.string_same, V, rest, B.model_bindings(String, V, O.observed_state(String, V, O.refreshed(~String, ~Lookup.string_same, V, Order.normal(V, c), T.Item{key, value, old}, Time.deadline(now, ns))))), binding_lookup(V, c, key, value, old, ns, now, q, valid, present), lookups_refreshed(V, c, key, value, old, ns, now, valid, present, rest))

def normalized(-V: Data, +c: C.Cache<String, V>, +key: String, +value: V, +old: T.Int64, +ns: T.Int64, +now: T.Int64, +valid: {Inv.representation(~String, ~Codec.string_encode, V, c) == True{} : Bool}, +present: {C.lookup(String, V, c, key) == Some{T.Item{key, value, old}} : Maybe<&2, T.Entry<String, V>>}) -> E.states(~String, ~Lookup.string_same, V, Order.normal(V, C.step_cache(String, V, C.refresh_present(String, V, c, key, T.Item{key, value, Time.deadline(now, ns)}))), O.observed_state(String, V, O.refreshed(~String, ~Lookup.string_same, V, Order.normal(V, c), T.Item{key, value, old}, Time.deadline(now, ns)))):
  C.State{+cap, +table, +order, +life, T.Counts{+i, +e, +r, +h, +m}, +cb} = c
  Native.by_fields(V, cap, List.append(&2, String, C.without(order, key), Con{key, Nil{}}), List.append(&2, String, S.unlist(~String, ~Lookup.string_same, order, key), Con{key, Nil{}}), life, T.Counts{i, e, r, Word.inc(64n, h), m}, cb, F.bindings(String, V, Map.to_list(&2, Maybe<&2, T.Entry<String, V>>, Map.set(&2, Maybe<&2, T.Entry<String, V>>, table, key, Some{T.Item{key, value, Time.deadline(now, ns)}}))), Con{T.Item{key, value, Time.deadline(now, ns)}, S.erase(~String, ~Lookup.string_same, V, F.bindings(String, V, Map.to_list(&2, Maybe<&2, T.Entry<String, V>>, table)), key)}, Equal.cong(List<&2, String>, List<&2, String>, xs => List.append(&2, String, xs, Con{key, Nil{}}), C.without(order, key), S.unlist(~String, ~Lookup.string_same, order, key), Order.filter(order, key)), lookups_refreshed(V, C.State{cap, table, order, life, T.Counts{i, e, r, h, m}, cb}, key, value, old, ns, now, valid, present, List.append(&2, String, S.unlist(~String, ~Lookup.string_same, order, key), Con{key, Nil{}})), Native.stray_normal(V, cap, Map.set(&2, Maybe<&2, T.Entry<String, V>>, table, key, Some{T.Item{key, value, Time.deadline(now, ns)}}), List.append(&2, String, C.without(order, key), Con{key, Nil{}}), life, T.Counts{i, e, r, Word.inc(64n, h), m}, cb, Rep.present(~String, ~Codec.string_encode, V, C.State{cap, table, order, life, T.Counts{i, e, r, h, m}, cb}, key, key, value, old, ns, now, present, valid)), CS.written_stray(V, cap, F.bindings(String, V, Map.to_list(&2, Maybe<&2, T.Entry<String, V>>, table)), order, life, T.Counts{i, e, r, Word.inc(64n, h), m}, cb, key, value, Time.deadline(now, ns), Native.stray_normal(V, cap, table, order, life, T.Counts{i, e, r, h, m}, cb, valid)))

def correspondence(-V: Data, +c: C.Cache<String, V>, +key: String, +value: V, +old: T.Int64, +ns: T.Int64, +now: T.Int64, +valid: {Inv.representation(~String, ~Codec.string_encode, V, c) == True{} : Bool}, +present: {C.lookup(String, V, c, key) == Some{T.Item{key, value, old}} : Maybe<&2, T.Entry<String, V>>}) -> E.states(~String, ~Lookup.string_same, V, F.abstract(String, V, C.step_cache(String, V, C.refresh_present(String, V, c, key, T.Item{key, value, Time.deadline(now, ns)}))), O.observed_state(String, V, O.refreshed(~String, ~Lookup.string_same, V, F.abstract(String, V, c), T.Item{key, value, old}, Time.deadline(now, ns)))):
  %Equal.sym(S.Model<String, V>, F.abstract(String, V, C.step_cache(String, V, C.refresh_present(String, V, c, key, T.Item{key, value, Time.deadline(now, ns)}))), Order.normal(V, C.step_cache(String, V, C.refresh_present(String, V, c, key, T.Item{key, value, Time.deadline(now, ns)}))), Order.normalize(V, C.step_cache(String, V, C.refresh_present(String, V, c, key, T.Item{key, value, Time.deadline(now, ns)})), Rep.present(~String, ~Codec.string_encode, V, c, key, key, value, old, ns, now, present, valid))) : E.states(~String, ~Lookup.string_same, V, _, O.observed_state(String, V, O.refreshed(~String, ~Lookup.string_same, V, F.abstract(String, V, c), T.Item{key, value, old}, Time.deadline(now, ns))))
  %Equal.sym(S.Model<String, V>, F.abstract(String, V, c), Order.normal(V, c), Order.normalize(V, c, valid)) : E.states(~String, ~Lookup.string_same, V, Order.normal(V, C.step_cache(String, V, C.refresh_present(String, V, c, key, T.Item{key, value, Time.deadline(now, ns)}))), O.observed_state(String, V, O.refreshed(~String, ~Lookup.string_same, V, _, T.Item{key, value, old}, Time.deadline(now, ns))))
  normalized(V, c, key, value, old, ns, now, valid, present)

def observation(-V: Data, +c: C.Cache<String, V>, +key: String, +value: V, +old: T.Int64, +ns: T.Int64, +now: T.Int64, valid: {Inv.representation(~String, ~Codec.string_encode, V, c) == True{} : Bool}, present: {C.lookup(String, V, c, key) == Some{T.Item{key, value, old}} : Maybe<&2, T.Entry<String, V>>}) -> E.observations(~String, ~Lookup.string_same, V, F.observe(String, V, C.refresh_present(String, V, c, key, T.Item{key, value, Time.deadline(now, ns)})), O.refreshed(~String, ~Lookup.string_same, V, F.abstract(String, V, c), T.Item{key, value, old}, Time.deadline(now, ns))):
  C.State{+cap, +table, +order, +life, T.Counts{+i, +e, +r, +h, +m}, +cb} = c
  (correspondence(V, C.State{cap, table, order, life, T.Counts{i, e, r, h, m}, cb}, key, value, old, ns, now, valid, present), {==}, {==}, {==})
