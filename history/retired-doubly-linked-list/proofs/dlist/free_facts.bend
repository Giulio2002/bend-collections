def live(~T: Data, +tag: U32, +fresh: Nat, +depth: Nat, +tv: AR.Tree<Maybe<&2, T>>, +tp: AR.Tree<U32>, +tn: AR.Tree<U32>, +ord: List<&2, Nat>, +free: List<&2, Nat>, +h: {FC.good_parts(~T, tag, fresh, depth, tv, tp, tn, ord, free) == True{} : Bool}) -> {ST.good(~T, ST.Sh{tag, fresh, depth, tv, tp, tn, ord}) == True{} : Bool}:
  L.and_left(ST.good(~T, ST.Sh{tag, fresh, depth, tv, tp, tn, ord}), Bool.and(ST.alllt(free, fresh), Bool.and(ST.nodup(free), Bool.and(SP.disj(ord, free), Bool.and(FC.links(free, AR.slots(U32, tn)), Nat.is_eq(Nat.add(SC.length(Nat, ord), SC.length(Nat, free)), fresh))))), h)

def bounds(~T: Data, +tag: U32, +fresh: Nat, +depth: Nat, +tv: AR.Tree<Maybe<&2, T>>, +tp: AR.Tree<U32>, +tn: AR.Tree<U32>, +ord: List<&2, Nat>, +free: List<&2, Nat>, +h: {FC.good_parts(~T, tag, fresh, depth, tv, tp, tn, ord, free) == True{} : Bool}) -> {ST.alllt(free, fresh) == True{} : Bool}:
  L.and_left(ST.alllt(free, fresh), Bool.and(ST.nodup(free), Bool.and(SP.disj(ord, free), Bool.and(FC.links(free, AR.slots(U32, tn)), Nat.is_eq(Nat.add(SC.length(Nat, ord), SC.length(Nat, free)), fresh)))), L.and_right(ST.good(~T, ST.Sh{tag, fresh, depth, tv, tp, tn, ord}), Bool.and(ST.alllt(free, fresh), Bool.and(ST.nodup(free), Bool.and(SP.disj(ord, free), Bool.and(FC.links(free, AR.slots(U32, tn)), Nat.is_eq(Nat.add(SC.length(Nat, ord), SC.length(Nat, free)), fresh))))), h))

def nodup(~T: Data, +tag: U32, +fresh: Nat, +depth: Nat, +tv: AR.Tree<Maybe<&2, T>>, +tp: AR.Tree<U32>, +tn: AR.Tree<U32>, +ord: List<&2, Nat>, +free: List<&2, Nat>, +h: {FC.good_parts(~T, tag, fresh, depth, tv, tp, tn, ord, free) == True{} : Bool}) -> {ST.nodup(free) == True{} : Bool}:
  L.and_left(ST.nodup(free), Bool.and(SP.disj(ord, free), Bool.and(FC.links(free, AR.slots(U32, tn)), Nat.is_eq(Nat.add(SC.length(Nat, ord), SC.length(Nat, free)), fresh))), L.and_right(ST.alllt(free, fresh), Bool.and(ST.nodup(free), Bool.and(SP.disj(ord, free), Bool.and(FC.links(free, AR.slots(U32, tn)), Nat.is_eq(Nat.add(SC.length(Nat, ord), SC.length(Nat, free)), fresh)))), L.and_right(ST.good(~T, ST.Sh{tag, fresh, depth, tv, tp, tn, ord}), Bool.and(ST.alllt(free, fresh), Bool.and(ST.nodup(free), Bool.and(SP.disj(ord, free), Bool.and(FC.links(free, AR.slots(U32, tn)), Nat.is_eq(Nat.add(SC.length(Nat, ord), SC.length(Nat, free)), fresh))))), h)))

def disjoint(~T: Data, +tag: U32, +fresh: Nat, +depth: Nat, +tv: AR.Tree<Maybe<&2, T>>, +tp: AR.Tree<U32>, +tn: AR.Tree<U32>, +ord: List<&2, Nat>, +free: List<&2, Nat>, +h: {FC.good_parts(~T, tag, fresh, depth, tv, tp, tn, ord, free) == True{} : Bool}) -> {SP.disj(ord, free) == True{} : Bool}:
  L.and_left(SP.disj(ord, free), Bool.and(FC.links(free, AR.slots(U32, tn)), Nat.is_eq(Nat.add(SC.length(Nat, ord), SC.length(Nat, free)), fresh)), L.and_right(ST.nodup(free), Bool.and(SP.disj(ord, free), Bool.and(FC.links(free, AR.slots(U32, tn)), Nat.is_eq(Nat.add(SC.length(Nat, ord), SC.length(Nat, free)), fresh))), L.and_right(ST.alllt(free, fresh), Bool.and(ST.nodup(free), Bool.and(SP.disj(ord, free), Bool.and(FC.links(free, AR.slots(U32, tn)), Nat.is_eq(Nat.add(SC.length(Nat, ord), SC.length(Nat, free)), fresh)))), L.and_right(ST.good(~T, ST.Sh{tag, fresh, depth, tv, tp, tn, ord}), Bool.and(ST.alllt(free, fresh), Bool.and(ST.nodup(free), Bool.and(SP.disj(ord, free), Bool.and(FC.links(free, AR.slots(U32, tn)), Nat.is_eq(Nat.add(SC.length(Nat, ord), SC.length(Nat, free)), fresh))))), h))))

def links(~T: Data, +tag: U32, +fresh: Nat, +depth: Nat, +tv: AR.Tree<Maybe<&2, T>>, +tp: AR.Tree<U32>, +tn: AR.Tree<U32>, +ord: List<&2, Nat>, +free: List<&2, Nat>, +h: {FC.good_parts(~T, tag, fresh, depth, tv, tp, tn, ord, free) == True{} : Bool}) -> {FC.links(free, AR.slots(U32, tn)) == True{} : Bool}:
  L.and_left(FC.links(free, AR.slots(U32, tn)), Nat.is_eq(Nat.add(SC.length(Nat, ord), SC.length(Nat, free)), fresh), L.and_right(SP.disj(ord, free), Bool.and(FC.links(free, AR.slots(U32, tn)), Nat.is_eq(Nat.add(SC.length(Nat, ord), SC.length(Nat, free)), fresh)), L.and_right(ST.nodup(free), Bool.and(SP.disj(ord, free), Bool.and(FC.links(free, AR.slots(U32, tn)), Nat.is_eq(Nat.add(SC.length(Nat, ord), SC.length(Nat, free)), fresh))), L.and_right(ST.alllt(free, fresh), Bool.and(ST.nodup(free), Bool.and(SP.disj(ord, free), Bool.and(FC.links(free, AR.slots(U32, tn)), Nat.is_eq(Nat.add(SC.length(Nat, ord), SC.length(Nat, free)), fresh)))), L.and_right(ST.good(~T, ST.Sh{tag, fresh, depth, tv, tp, tn, ord}), Bool.and(ST.alllt(free, fresh), Bool.and(ST.nodup(free), Bool.and(SP.disj(ord, free), Bool.and(FC.links(free, AR.slots(U32, tn)), Nat.is_eq(Nat.add(SC.length(Nat, ord), SC.length(Nat, free)), fresh))))), h)))))

def count(~T: Data, +tag: U32, +fresh: Nat, +depth: Nat, +tv: AR.Tree<Maybe<&2, T>>, +tp: AR.Tree<U32>, +tn: AR.Tree<U32>, +ord: List<&2, Nat>, +free: List<&2, Nat>, +h: {FC.good_parts(~T, tag, fresh, depth, tv, tp, tn, ord, free) == True{} : Bool}) -> {Nat.is_eq(Nat.add(SC.length(Nat, ord), SC.length(Nat, free)), fresh) == True{} : Bool}:
  L.and_right(FC.links(free, AR.slots(U32, tn)), Nat.is_eq(Nat.add(SC.length(Nat, ord), SC.length(Nat, free)), fresh), L.and_right(SP.disj(ord, free), Bool.and(FC.links(free, AR.slots(U32, tn)), Nat.is_eq(Nat.add(SC.length(Nat, ord), SC.length(Nat, free)), fresh)), L.and_right(ST.nodup(free), Bool.and(SP.disj(ord, free), Bool.and(FC.links(free, AR.slots(U32, tn)), Nat.is_eq(Nat.add(SC.length(Nat, ord), SC.length(Nat, free)), fresh))), L.and_right(ST.alllt(free, fresh), Bool.and(ST.nodup(free), Bool.and(SP.disj(ord, free), Bool.and(FC.links(free, AR.slots(U32, tn)), Nat.is_eq(Nat.add(SC.length(Nat, ord), SC.length(Nat, free)), fresh)))), L.and_right(ST.good(~T, ST.Sh{tag, fresh, depth, tv, tp, tn, ord}), Bool.and(ST.alllt(free, fresh), Bool.and(ST.nodup(free), Bool.and(SP.disj(ord, free), Bool.and(FC.links(free, AR.slots(U32, tn)), Nat.is_eq(Nat.add(SC.length(Nat, ord), SC.length(Nat, free)), fresh))))), h)))))

def make(~T: Data, +tag: U32, +fresh: Nat, +depth: Nat, +tv: AR.Tree<Maybe<&2, T>>, +tp: AR.Tree<U32>, +tn: AR.Tree<U32>, +ord: List<&2, Nat>, +free: List<&2, Nat>, +h0: {ST.good(~T, ST.Sh{tag, fresh, depth, tv, tp, tn, ord}) == True{} : Bool}, +h1: {ST.alllt(free, fresh) == True{} : Bool}, +h2: {ST.nodup(free) == True{} : Bool}, +h3: {SP.disj(ord, free) == True{} : Bool}, +h4: {FC.links(free, AR.slots(U32, tn)) == True{} : Bool}, +h5: {Nat.is_eq(Nat.add(SC.length(Nat, ord), SC.length(Nat, free)), fresh) == True{} : Bool}) -> {FC.good_parts(~T, tag, fresh, depth, tv, tp, tn, ord, free) == True{} : Bool}:
  L.and_intro(ST.good(~T, ST.Sh{tag, fresh, depth, tv, tp, tn, ord}), Bool.and(ST.alllt(free, fresh), Bool.and(ST.nodup(free), Bool.and(SP.disj(ord, free), Bool.and(FC.links(free, AR.slots(U32, tn)), Nat.is_eq(Nat.add(SC.length(Nat, ord), SC.length(Nat, free)), fresh))))), h0, L.and_intro(ST.alllt(free, fresh), Bool.and(ST.nodup(free), Bool.and(SP.disj(ord, free), Bool.and(FC.links(free, AR.slots(U32, tn)), Nat.is_eq(Nat.add(SC.length(Nat, ord), SC.length(Nat, free)), fresh)))), h1, L.and_intro(ST.nodup(free), Bool.and(SP.disj(ord, free), Bool.and(FC.links(free, AR.slots(U32, tn)), Nat.is_eq(Nat.add(SC.length(Nat, ord), SC.length(Nat, free)), fresh))), h2, L.and_intro(SP.disj(ord, free), Bool.and(FC.links(free, AR.slots(U32, tn)), Nat.is_eq(Nat.add(SC.length(Nat, ord), SC.length(Nat, free)), fresh)), h3, L.and_intro(FC.links(free, AR.slots(U32, tn)), Nat.is_eq(Nat.add(SC.length(Nat, ord), SC.length(Nat, free)), fresh), h4, h5)))))
