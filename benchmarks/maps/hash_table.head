import Base
import ../../benchmarks/bend/common.bend as B
import ../../src/containers/hash_table.bend as H

# HashMap side of the HashMap vs Base.Map comparison (generated by
# benchmarks/maps/compare.py from body.bend; do not edit).

type T is Type:
  W{m: H.HashMap<&2, U32>}

def t_new() -> T:
  W{H.new(&2, U32)}

def t_set(t: T, key: String, +x: U32) -> T:
  W{m} = t
  W{H.set(&2, U32, m, key, x)}

def t_get_fin(p: H.HashMap<&2, U32> & U32) -> T & U32:
  (m, x) = p
  (W{m}, x)

def t_get(t: T, key: String) -> T & U32:
  W{m} = t
  t_get_fin(H.get(U32, 4294967295, m, key))

def t_has_fin(p: H.HashMap<&2, U32> & Bool) -> T & Bool:
  (m, x) = p
  (W{m}, x)

def t_has(t: T, key: String) -> T & Bool:
  W{m} = t
  t_has_fin(H.has(&2, U32, m, key))

def t_pop_fin(p: H.HashMap<&2, U32> & Maybe<&2, U32>) -> T & Maybe<&2, U32>:
  (m, x) = p
  (W{m}, x)

def t_pop(t: T, key: String) -> T & Maybe<&2, U32>:
  W{m} = t
  t_pop_fin(H.pop(&2, U32, m, key))

def t_keys_fin(p: H.HashMap<&2, U32> & List<&2, String>) -> T & List<&2, String>:
  (m, x) = p
  (W{m}, x)

def t_keys(t: T) -> T & List<&2, String>:
  W{m} = t
  t_keys_fin(H.keys(&2, U32, m))

def t_size_fin(p: H.HashMap<&2, U32> & U32) -> T & U32:
  (m, x) = p
  (W{m}, x)

def t_size(t: T) -> T & U32:
  W{m} = t
  t_size_fin(H.size(&2, U32, m))
