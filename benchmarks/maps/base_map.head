import Base
import ../../benchmarks/bend/common.bend as B

# Base.Map side of the HashMap vs Base.Map comparison (generated by
# benchmarks/maps/compare.py from body.bend; do not edit). Base.Map's keys
# and size do not hand the map back; the map holds Data, so it is kept.

type T is Type:
  W{m: Map<&2, U32>}

def t_new() -> T:
  W{Map.new(&2, U32)}

def t_set(t: T, key: String, +x: U32) -> T:
  W{m} = t
  W{Map.set(&2, U32, m, key, x)}

def t_get_fin(p: Map<&2, U32> & U32) -> T & U32:
  (m, x) = p
  (W{m}, x)

def t_get(t: T, key: String) -> T & U32:
  W{m} = t
  t_get_fin(Map.get(U32, 4294967295, m, key))

def t_has_fin(p: Map<&2, U32> & Bool) -> T & Bool:
  (m, x) = p
  (W{m}, x)

def t_has(t: T, key: String) -> T & Bool:
  W{m} = t
  t_has_fin(Map.has(&2, U32, m, key))

def t_pop_fin(p: Map<&2, U32> & Maybe<&2, U32>) -> T & Maybe<&2, U32>:
  (m, x) = p
  (W{m}, x)

def t_pop(t: T, key: String) -> T & Maybe<&2, U32>:
  W{m} = t
  t_pop_fin(Map.pop(&2, U32, m, key))

def t_keys(t: T) -> T & List<&2, String>:
  W{+m} = t
  (W{m}, Map.keys(&2, U32, m))

def t_size(t: T) -> T & U32:
  W{+m} = t
  (W{m}, U32.from_nat(Map.size(&2, U32, m)))
