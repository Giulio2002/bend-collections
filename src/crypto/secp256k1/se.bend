# n - b for b below n: (2^256 - 1 - (b + c)) + 1 (L.neg_raw(c, b))
def negrn(x: FE.FE, c: W9) -> FE.FE:
  match x c:
    case FE.FE{+x0, +x1, +x2, +x3, +x4, +x5, +x6, +x7, +x8, +x9, +x10, +x11, +x12, +x13, +x14, +x15} W9{+c0, +c1, +c2, +c3, +c4, +c5, +c6, +c7, +c8}:
      +s1 = Nat.add(x0, c0)
      +l2 = L.lo16(s1)
      +h3 = L.hi16(s1)
      +s4 = Nat.add(h3, Nat.add(x1, c1))
