    case FE.W17{+u0, +u1, +u2, +u3, +u4, +u5, +u6, +u7, +u8, +u9, +u10, +u11, +u12, +u13, +u14, +u15, +u16} W9{+c0, +c1, +c2, +c3, +c4, +c5, +c6, +c7, +c8}:
