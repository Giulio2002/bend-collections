# x mod p for x = lo + 2^256 t below 2 p: lo - p when x + 2^32 + 977 reaches 2^256 (fmod.fin)
def fin(r: W17) -> FE:
  match r:
    case W17{+x0, +x1, +x2, +x3, +x4, +x5, +x6, +x7, +x8, +x9, +x10, +x11, +x12, +x13, +x14, +x15, +x16}:
