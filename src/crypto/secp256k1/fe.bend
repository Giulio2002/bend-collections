# ---- operations (reduced inputs, reduced results) ----


# the limb-wise sum (L.add)
def addr(a: FE, b: FE) -> FE:
  match a b:
    case FE{x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15} FE{y0, y1, y2, y3, y4, y5, y6, y7, y8, y9, y10, y11, y12, y13, y14, y15}:
      FE{Nat.add(x0, y0), Nat.add(x1, y1), Nat.add(x2, y2), Nat.add(x3, y3), Nat.add(x4, y4), Nat.add(x5, y5), Nat.add(x6, y6), Nat.add(x7, y7), Nat.add(x8, y8), Nat.add(x9, y9), Nat.add(x10, y10), Nat.add(x11, y11), Nat.add(x12, y12), Nat.add(x13, y13), Nat.add(x14, y14), Nat.add(x15, y15)}

# p - b for b below p: (2^256 - 1 - (b + 2^32 + 977)) + 1 (L.neg_raw(F.c(), b))
def negr(r: FE) -> FE:
  match r:
    case FE{+x0, +x1, +x2, +x3, +x4, +x5, +x6, +x7, +x8, +x9, +x10, +x11, +x12, +x13, +x14, +x15}:
      +s1 = Nat.add(x0, 977n)
      +l2 = L.lo16(s1)
      +h3 = L.hi16(s1)
      +s4 = Nat.add(h3, Nat.add(x1, 0n))
      +l5 = L.lo16(s4)
      +h6 = L.hi16(s4)
      +s7 = Nat.add(h6, Nat.add(x2, 1n))
      +l8 = L.lo16(s7)
      +h9 = L.hi16(s7)
      +s10 = Nat.add(h9, x3)
      +l11 = L.lo16(s10)
      +h12 = L.hi16(s10)
      +s13 = Nat.add(h12, x4)
      +l14 = L.lo16(s13)
      +h15 = L.hi16(s13)
      +s16 = Nat.add(h15, x5)
      +l17 = L.lo16(s16)
      +h18 = L.hi16(s16)
      +s19 = Nat.add(h18, x6)
      +l20 = L.lo16(s19)
      +h21 = L.hi16(s19)
      +s22 = Nat.add(h21, x7)
      +l23 = L.lo16(s22)
      +h24 = L.hi16(s22)
      +s25 = Nat.add(h24, x8)
      +l26 = L.lo16(s25)
      +h27 = L.hi16(s25)
      +s28 = Nat.add(h27, x9)
      +l29 = L.lo16(s28)
      +h30 = L.hi16(s28)
      +s31 = Nat.add(h30, x10)
      +l32 = L.lo16(s31)
      +h33 = L.hi16(s31)
      +s34 = Nat.add(h33, x11)
      +l35 = L.lo16(s34)
      +h36 = L.hi16(s34)
      +s37 = Nat.add(h36, x12)
      +l38 = L.lo16(s37)
      +h39 = L.hi16(s37)
      +s40 = Nat.add(h39, x13)
      +l41 = L.lo16(s40)
      +h42 = L.hi16(s40)
      +s43 = Nat.add(h42, x14)
      +l44 = L.lo16(s43)
      +h45 = L.hi16(s43)
      +s46 = Nat.add(h45, x15)
      +l47 = L.lo16(s46)
      +h48 = L.hi16(s46)
      FE{Nat.add(L.comp1(l2), 1n), L.comp1(l5), L.comp1(l8), L.comp1(l11), L.comp1(l14), L.comp1(l17), L.comp1(l20), L.comp1(l23), L.comp1(l26), L.comp1(l29), L.comp1(l32), L.comp1(l35), L.comp1(l38), L.comp1(l41), L.comp1(l44), L.comp1(l47)}

# the limbs times 21 (L.scal(21n, xs))
def mul21r(r: FE) -> FE:
  match r:
    case FE{+x0, +x1, +x2, +x3, +x4, +x5, +x6, +x7, +x8, +x9, +x10, +x11, +x12, +x13, +x14, +x15}:
      FE{Nat.mul(x0, 21n), Nat.mul(x1, 21n), Nat.mul(x2, 21n), Nat.mul(x3, 21n), Nat.mul(x4, 21n), Nat.mul(x5, 21n), Nat.mul(x6, 21n), Nat.mul(x7, 21n), Nat.mul(x8, 21n), Nat.mul(x9, 21n), Nat.mul(x10, 21n), Nat.mul(x11, 21n), Nat.mul(x12, 21n), Nat.mul(x13, 21n), Nat.mul(x14, 21n), Nat.mul(x15, 21n)}

def add(a: FE, b: FE) -> FE:
  fin(carry16(addr(a, b)))

def sub(a: FE, b: FE) -> FE:
  fin(carry16(addr(a, negr(b))))

def neg(a: FE) -> FE:
  fin(carry16(negr(a)))

# the reduction of a product: the columns carried to 16 limbs, the high
# columns folded, twice more the carry out folded, and the final subtraction
def mred(c: W31) -> FE:
  fin(carry16(foldt(carry17(fold1(carryp16(c))))))

def mul(a: FE, b: FE) -> FE:
  mred(cols(a, b))

def sq(a: FE) -> FE:
  mred(sqcols(a))

# 21 a (21 = 3 b, the constant of the doubling and addition formulas)
def mul21(a: FE) -> FE:
  fin(carry16(foldt(carry16(mul21r(a)))))

def zero() -> FE:
  FE{0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n}

def one() -> FE:
  FE{1n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n}

# ---- lists ----

def to_list(a: FE) -> List<&2, Nat>:
  match a:
    case FE{x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15}:
      [x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15]

# the record of a 16-limb list (anything else is 0: never met, as every
# list here is reduced), looking at the list first
def of_list(xs: List<&2, Nat>) -> FE:

  match xs:
    case Nil{}: zero()
    case x0 <> t1:
      match t1:
        case Nil{}: zero()
        case x1 <> t2:
          match t2:
            case Nil{}: zero()
            case x2 <> t3:
              match t3:
                case Nil{}: zero()
                case x3 <> t4:
                  match t4:
                    case Nil{}: zero()
                    case x4 <> t5:
                      match t5:
                        case Nil{}: zero()
                        case x5 <> t6:
                          match t6:
                            case Nil{}: zero()
                            case x6 <> t7:
                              match t7:
                                case Nil{}: zero()
                                case x7 <> t8:
                                  match t8:
                                    case Nil{}: zero()
                                    case x8 <> t9:
                                      match t9:
                                        case Nil{}: zero()
                                        case x9 <> t10:
                                          match t10:
                                            case Nil{}: zero()
                                            case x10 <> t11:
                                              match t11:
                                                case Nil{}: zero()
                                                case x11 <> t12:
                                                  match t12:
                                                    case Nil{}: zero()
                                                    case x12 <> t13:
                                                      match t13:
                                                        case Nil{}: zero()
                                                        case x13 <> t14:
                                                          match t14:
                                                            case Nil{}: zero()
                                                            case x14 <> t15:
                                                              match t15:
                                                                case Nil{}: zero()
                                                                case x15 <> t16:
                                                                  match t16:
                                                                    case Nil{}: FE{x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15}
                                                                    case y <> u: zero()

