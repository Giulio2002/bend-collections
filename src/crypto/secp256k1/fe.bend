      +l14 = L.lo16(s13)
      +h15 = L.hi16(s13)
      +s16 = Nat.add(h15, x5)
      +l17 = L.lo16(s16)
      +h18 = L.hi16(s16)
      +s19 = Nat.add(h18, x6)
      +l20 = L.lo16(s19)
      +h21 = L.hi16(s19)
      +s22 = Nat.add(h21, x7)
      +l23 = L.lo16(s22)
      +h24 = L.hi16(s22)
      +s25 = Nat.add(h24, x8)
      +l26 = L.lo16(s25)
      +h27 = L.hi16(s25)
      +s28 = Nat.add(h27, x9)
      +l29 = L.lo16(s28)
      +h30 = L.hi16(s28)
      +s31 = Nat.add(h30, x10)
      +l32 = L.lo16(s31)
      +h33 = L.hi16(s31)
      +s34 = Nat.add(h33, x11)
      +l35 = L.lo16(s34)
      +h36 = L.hi16(s34)
      +s37 = Nat.add(h36, x12)
      +l38 = L.lo16(s37)
      +h39 = L.hi16(s37)
      +s40 = Nat.add(h39, x13)
      +l41 = L.lo16(s40)
