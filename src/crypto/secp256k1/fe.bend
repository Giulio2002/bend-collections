      +s7 = Nat.add(h6, Nat.add(x2, 1n))
      +l8 = L.lo16(s7)
      +h9 = L.hi16(s7)
      +s10 = Nat.add(h9, x3)
      +l11 = L.lo16(s10)
      +h12 = L.hi16(s10)
