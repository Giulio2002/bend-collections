    case a <> b <> c <> d <> e <> f <> g <> h <> rest:
      T.W{pack(a, b, c, d), pack(e, f, g, h)} <> lanes(rest)
    case _:
      Nil{}

def base256(width: Nat, +n: Nat) -> List<&2, U32>:
  match width:
    case 0n:
      Nil{}
    case 1n+p:
      List.append(&2, U32, base256(p, Nat.div(n, 256n)), [U32.from_nat(Nat.mod(n, 256n))])

# 8n as sixteen big-endian octets: n div 32 in the top fifteen, 8 (n mod 32) last.
def bit_length(+n: Nat) -> List<&2, U32>:
