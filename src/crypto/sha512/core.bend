  +t1 = add(add(add(add(h, big1(e)), choose(e, f, g)), k), w)
  t2 = add(big0(a), majority(a, b, c))
  T.H{add(t1, t2), a, b, c, add(d, t1), e, f, g}

def feedforward(x: T.State, y: T.State) -> T.State:
  T.H{a, b, c, d, e, f, g, h} = x
  T.H{i, j, k, l, m, n, o, p} = y
