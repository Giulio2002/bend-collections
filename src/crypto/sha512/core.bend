def pack(a: U32, b: U32, c: U32, d: U32) -> U32:
  U32.or(U32.or(U32.or(U32.shln(U32.and(a, 255), 24n),
    U32.shln(U32.and(b, 255), 16n)), U32.shln(U32.and(c, 255), 8n)), U32.and(d, 255))

# Big-endian 64-bit words, eight bytes each.
def lanes(bytes: List<&2, U32>) -> List<&2, T.Lane>:
