# i + 32, as 32 steps of one.
def nx(+i: Nat) -> Nat:
  Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(Nat.add(i, 1n), 1n), 1n), 1n), 1n), 1n), 1n), 1n), 1n), 1n), 1n), 1n), 1n), 1n), 1n), 1n), 1n), 1n), 1n), 1n), 1n), 1n), 1n), 1n), 1n), 1n), 1n), 1n), 1n), 1n), 1n), 1n)

# The memory with block b replaced by v.
def put(+b: Nat, v: A.Block, a: Array<U32>) -> Array<U32>:
  match v:
    case A.B{r0, r1, r2, r3, r4, r5, r6, r7}:
      +i0 = Nat.mul(b, 256n)
      +i1 = nx(i0)
      +i2 = nx(i1)
      +i3 = nx(i2)
      +i4 = nx(i3)
      +i5 = nx(i4)
      +i6 = nx(i5)
      +i7 = nx(i6)
      wrow(r7, i7, wrow(r6, i6, wrow(r5, i5, wrow(r4, i4, wrow(r3, i3, wrow(r2, i2, wrow(r1, i1, wrow(r0, i0, a))))))))
