# G(X, Y) = P(R) XOR R with R = X XOR Y, P on the rows then the columns
# (RFC 9106 section 3.5).
def fin(+r: A.Block) -> A.Block:
  xor(cols(rows(r)),r)

def compress(x: A.Block, y: A.Block) -> A.Block:
  fin(xor(x,y))

# Version 0x13 passes after the first: G(X, Y) XOR the block being overwritten.
def compress_xor(x: A.Block, y: A.Block, old: A.Block) -> A.Block:
  xor(compress(x,y),old)

