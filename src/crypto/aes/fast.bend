      +b32 = U32.or(U32.shln(a31, 31n), U32.shrn(b31, 1n))
      +c32 = U32.or(U32.shln(b31, 31n), U32.shrn(c31, 1n))
      +d32 = U32.or(U32.shln(c31, 31n), U32.shrn(d31, 1n))
