      +d28 = U32.or(U32.shln(c27, 31n), U32.shrn(d27, 1n))
      +a29 = U32.xor(U32.and(3774873600, U32.sub(0, U32.and(1, d28))), U32.shrn(a28, 1n))
      +b29 = U32.or(U32.shln(a28, 31n), U32.shrn(b28, 1n))
      +c29 = U32.or(U32.shln(b28, 31n), U32.shrn(c28, 1n))
      +d29 = U32.or(U32.shln(c28, 31n), U32.shrn(d28, 1n))
      +a30 = U32.xor(U32.and(3774873600, U32.sub(0, U32.and(1, d29))), U32.shrn(a29, 1n))
      +b30 = U32.or(U32.shln(a29, 31n), U32.shrn(b29, 1n))
      +c30 = U32.or(U32.shln(b29, 31n), U32.shrn(c29, 1n))
      +d30 = U32.or(U32.shln(c29, 31n), U32.shrn(d29, 1n))
      +a31 = U32.xor(U32.and(3774873600, U32.sub(0, U32.and(1, d30))), U32.shrn(a30, 1n))
      +b31 = U32.or(U32.shln(a30, 31n), U32.shrn(b30, 1n))
      +c31 = U32.or(U32.shln(b30, 31n), U32.shrn(c30, 1n))
      +d31 = U32.or(U32.shln(c30, 31n), U32.shrn(d30, 1n))
