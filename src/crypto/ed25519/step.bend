import Base
import ../curve25519/fe.bend as FE

# The Horner step of scalar.bend on 15 limbs, as straight-line code
# (written by tools/gen_scalar.py from scalar.bend's list form `step`; do
# not edit by hand). l holds L in 15 limbs of 17 bits, a a scalar below L
# the same way, d a 17-bit digit: the result is (d + 2^17 a) mod L. The
# 15-limb container is the field element type (only its shape is used).

def step15(+R: Nat, l: FE.Fe, a: FE.Fe, +d: Nat) -> FE.Fe:
  match l a:
    case FE.Fe{+l0, +l1, +l2, +l3, +l4, +l5, +l6, +l7, +l8, +l9, +l10, +l11, +l12, +l13, +l14} FE.Fe{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7, +a8, +a9, +a10, +a11, +a12, +a13, +a14}:
      +w0 = Nat.sub(Nat.div(Nat.add(a13, Nat.mul(a14, R)), Nat.div(R, 8n)), 1n)
      +w1 = Nat.add(Nat.mul(w0, l0), 0n)
      +w2 = Nat.sub(Nat.add(d, R), Nat.add(Nat.mod(w1, R), 0n))
      +w3 = Nat.mod(w2, R)
      +w4 = Nat.sub(Nat.add(w3, R), Nat.add(l0, 0n))
      +w5 = Nat.add(Nat.mul(w0, l1), Nat.div(w1, R))
      +w6 = Nat.add(Nat.mul(w0, l2), Nat.div(w5, R))
      +w7 = Nat.add(Nat.mul(w0, l3), Nat.div(w6, R))
      +w8 = Nat.add(Nat.mul(w0, l4), Nat.div(w7, R))
      +w9 = Nat.add(Nat.mul(w0, l5), Nat.div(w8, R))
      +w10 = Nat.add(Nat.mul(w0, l6), Nat.div(w9, R))
      +w11 = Nat.add(Nat.mul(w0, l7), Nat.div(w10, R))
      +w12 = Nat.add(Nat.mul(w0, l8), Nat.div(w11, R))
      +w13 = Nat.add(Nat.mul(w0, l9), Nat.div(w12, R))
      +w14 = Nat.add(Nat.mul(w0, l10), Nat.div(w13, R))
      +w15 = Nat.add(Nat.mul(w0, l11), Nat.div(w14, R))
      +w16 = Nat.add(Nat.mul(w0, l12), Nat.div(w15, R))
      +w17 = Nat.add(Nat.mul(w0, l13), Nat.div(w16, R))
      +w18 = Nat.add(Nat.mul(w0, l14), Nat.div(w17, R))
      +w19 = Nat.sub(Nat.add(a0, R), Nat.add(Nat.mod(w5, R), Nat.sub(1n, Nat.div(w2, R))))
      +w20 = Nat.sub(Nat.add(a1, R), Nat.add(Nat.mod(w6, R), Nat.sub(1n, Nat.div(w19, R))))
      +w21 = Nat.sub(Nat.add(a2, R), Nat.add(Nat.mod(w7, R), Nat.sub(1n, Nat.div(w20, R))))
      +w22 = Nat.sub(Nat.add(a3, R), Nat.add(Nat.mod(w8, R), Nat.sub(1n, Nat.div(w21, R))))
      +w23 = Nat.sub(Nat.add(a4, R), Nat.add(Nat.mod(w9, R), Nat.sub(1n, Nat.div(w22, R))))
      +w24 = Nat.sub(Nat.add(a5, R), Nat.add(Nat.mod(w10, R), Nat.sub(1n, Nat.div(w23, R))))
      +w25 = Nat.sub(Nat.add(a6, R), Nat.add(Nat.mod(w11, R), Nat.sub(1n, Nat.div(w24, R))))
      +w26 = Nat.sub(Nat.add(a7, R), Nat.add(Nat.mod(w12, R), Nat.sub(1n, Nat.div(w25, R))))
      +w27 = Nat.sub(Nat.add(a8, R), Nat.add(Nat.mod(w13, R), Nat.sub(1n, Nat.div(w26, R))))
      +w28 = Nat.sub(Nat.add(a9, R), Nat.add(Nat.mod(w14, R), Nat.sub(1n, Nat.div(w27, R))))
      +w29 = Nat.sub(Nat.add(a10, R), Nat.add(Nat.mod(w15, R), Nat.sub(1n, Nat.div(w28, R))))
      +w30 = Nat.sub(Nat.add(a11, R), Nat.add(Nat.mod(w16, R), Nat.sub(1n, Nat.div(w29, R))))
      +w31 = Nat.sub(Nat.add(a12, R), Nat.add(Nat.mod(w17, R), Nat.sub(1n, Nat.div(w30, R))))
      +w32 = Nat.sub(Nat.add(a13, R), Nat.add(Nat.mod(w18, R), Nat.sub(1n, Nat.div(w31, R))))
      +w33 = Nat.mod(w32, R)
      +w34 = Nat.mod(w31, R)
      +w35 = Nat.mod(w30, R)
      +w36 = Nat.mod(w29, R)
      +w37 = Nat.mod(w28, R)
      +w38 = Nat.mod(w27, R)
      +w39 = Nat.mod(w26, R)
      +w40 = Nat.mod(w25, R)
      +w41 = Nat.mod(w24, R)
      +w42 = Nat.mod(w23, R)
      +w43 = Nat.mod(w22, R)
      +w44 = Nat.mod(w21, R)
      +w45 = Nat.mod(w20, R)
      +w46 = Nat.mod(w19, R)
      +w47 = Nat.sub(Nat.add(w46, R), Nat.add(l1, Nat.sub(1n, Nat.div(w4, R))))
      +w48 = Nat.sub(Nat.add(w45, R), Nat.add(l2, Nat.sub(1n, Nat.div(w47, R))))
      +w49 = Nat.sub(Nat.add(w44, R), Nat.add(l3, Nat.sub(1n, Nat.div(w48, R))))
      +w50 = Nat.sub(Nat.add(w43, R), Nat.add(l4, Nat.sub(1n, Nat.div(w49, R))))
      +w51 = Nat.sub(Nat.add(w42, R), Nat.add(l5, Nat.sub(1n, Nat.div(w50, R))))
      +w52 = Nat.sub(Nat.add(w41, R), Nat.add(l6, Nat.sub(1n, Nat.div(w51, R))))
      +w53 = Nat.sub(Nat.add(w40, R), Nat.add(l7, Nat.sub(1n, Nat.div(w52, R))))
      +w54 = Nat.sub(Nat.add(w39, R), Nat.add(l8, Nat.sub(1n, Nat.div(w53, R))))
      +w55 = Nat.sub(Nat.add(w38, R), Nat.add(l9, Nat.sub(1n, Nat.div(w54, R))))
      +w56 = Nat.sub(Nat.add(w37, R), Nat.add(l10, Nat.sub(1n, Nat.div(w55, R))))
      +w57 = Nat.sub(Nat.add(w36, R), Nat.add(l11, Nat.sub(1n, Nat.div(w56, R))))
      +w58 = Nat.sub(Nat.add(w35, R), Nat.add(l12, Nat.sub(1n, Nat.div(w57, R))))
      +w59 = Nat.sub(Nat.add(w34, R), Nat.add(l13, Nat.sub(1n, Nat.div(w58, R))))
      +w60 = Nat.sub(Nat.add(w33, R), Nat.add(l14, Nat.sub(1n, Nat.div(w59, R))))
      +w61 = Nat.sub(1n, Nat.div(Nat.sub(Nat.add(Nat.mod(Nat.sub(Nat.add(a14, R), Nat.add(Nat.div(w18, R), Nat.sub(1n, Nat.div(w32, R)))), R), R), Nat.add(0n, Nat.sub(1n, Nat.div(w60, R)))), R))
      +w62 = Nat.sub(1n, w61)
      FE.Fe{Nat.add(Nat.mul(Nat.mod(w4, R), w62), Nat.mul(w3, w61)), Nat.add(Nat.mul(Nat.mod(w47, R), w62), Nat.mul(w46, w61)), Nat.add(Nat.mul(Nat.mod(w48, R), w62), Nat.mul(w45, w61)), Nat.add(Nat.mul(Nat.mod(w49, R), w62), Nat.mul(w44, w61)), Nat.add(Nat.mul(Nat.mod(w50, R), w62), Nat.mul(w43, w61)), Nat.add(Nat.mul(Nat.mod(w51, R), w62), Nat.mul(w42, w61)), Nat.add(Nat.mul(Nat.mod(w52, R), w62), Nat.mul(w41, w61)), Nat.add(Nat.mul(Nat.mod(w53, R), w62), Nat.mul(w40, w61)), Nat.add(Nat.mul(Nat.mod(w54, R), w62), Nat.mul(w39, w61)), Nat.add(Nat.mul(Nat.mod(w55, R), w62), Nat.mul(w38, w61)), Nat.add(Nat.mul(Nat.mod(w56, R), w62), Nat.mul(w37, w61)), Nat.add(Nat.mul(Nat.mod(w57, R), w62), Nat.mul(w36, w61)), Nat.add(Nat.mul(Nat.mod(w58, R), w62), Nat.mul(w35, w61)), Nat.add(Nat.mul(Nat.mod(w59, R), w62), Nat.mul(w34, w61)), Nat.add(Nat.mul(Nat.mod(w60, R), w62), Nat.mul(w33, w61))}
