    case Tuple{m, None{}}:
      (m, False{})
    case Tuple{m, Some{old}}:
      remove_if_apply(~K, ~V, ~cmp, m, id, replacement, eq(old, expected))

def poll_ready(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, r: TreeMap<K, V, cmp> & Nat) -> TreeMap<K, V, cmp> & Maybe<&2, Entry<K, V>>:
