def delete_fix_step(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, m: TreeMap<K, V, cmp>, +x: Nat, +p: Nat) -> TreeMap<K, V, cmp> & DeleteFix:
  delete_fix_step_1(~K, ~V, ~cmp, x, p, root_id(~K, ~V, ~cmp, m))

def delete_fix_loop(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +fuel: Nat, st: TreeMap<K, V, cmp> & DeleteFix) -> TreeMap<K, V, cmp>:
  match fuel st:
    case 0n Tuple{m, fix}:
      black_root(~K, ~V, ~cmp, m)
    case 1n+f Tuple{m, DF{x, p, False{}}}:
      black_root(~K, ~V, ~cmp, m)
    case 1n+f Tuple{m, DF{x, p, True{}}}:
      delete_fix_loop(~K, ~V, ~cmp, f, delete_fix_step(~K, ~V, ~cmp, m, x, p))

