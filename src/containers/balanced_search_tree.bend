  (m, id) = r
  refresh_ends(~K, ~V, ~cmp, unlink(~K, ~V, ~cmp, m, id))

def remove_present_1(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +id: Nat, pair_result: TreeMap<K, V, cmp> & Maybe<&2, V>) -> TreeMap<K, V, cmp> & Maybe<&2, V>:
