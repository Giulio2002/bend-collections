import Base
import ../lib/logic.bend as L
import ../lib/nat.bend as N
import ../lib/list.bend as LL
import ../lib/order.bend as O
import ../spec/common.bend as SC
import ../spec/tree_map.bend as S
import ../../src/containers/balanced_search_tree.bend as M
import ./state.bend as ST
import ./ord.bend as OR
import ./prim.bend as PR

# Insertion at a gap of a sorted list: the specification's ins puts the
# entry there, lookup misses, and order holds; the node and payload lists
# grown by a slot or rewritten at one. (source: tools/generators/tm_hand/ins.src)

%def E M.Entry<K, V>
%def ES List<&2, M.Entry<K, V>>
%def ME Maybe<&2, M.Entry<K, V>>
%def KY(e) S.key(K, V, e)
%def TO ~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, ~o: O.Order(~K, ~cmp)
%def AK ~K, ~V, ~cmp
%def TK_ ~K: Data, ~V: Data, ~cmp: K -> K -> Cmp
%def AO ~K, ~V, ~cmp, ~o
%def EAPP(a, b) SC.append($E, a, b)
%def GTA(k, es) {OR.gtall($AK, k, es) == True{} : Bool}
%def LTA(k, es) {OR.ltall($AK, k, es) == True{} : Bool}
%def ORD(x) {ST.ordered($AK, x) == True{} : Bool}
%def INS(xs) S.ins($AK, k, v, xs)
%def EKV M.Entry{k, v}

def ins_nil($TK_, +k: K, +v: V, +ys: $ES, +hg: $GTA(k, ys)) -> {$INS(ys) == Con{$EKV, ys} : $ES}:
  match ys:
    case Nil{}:
      {==}
    case Con{+e, +t}:
      %Equal.sym(Cmp, cmp(k, $KY(e)), LT{}, O.lt_is(cmp(k, $KY(e)), L.and_left(Cmp.is_lt(cmp(k, $KY(e))), OR.gtall($AK, k, t), hg))) : {S.pick($ES, Cmp.is_lt(_), Con{$EKV, Con{e, t}}, Con{e, $INS(t)}) == Con{$EKV, Con{e, t}} : $ES}
      {==}

# inserting k between the entries below and above it
def ins_gap($TO, +k: K, +v: V, +xs: $ES, +ys: $ES, +hl: $LTA(k, xs), +hg: $GTA(k, ys)) -> {$INS($EAPP(xs, ys)) == $EAPP(xs, Con{$EKV, ys}) : $ES}:
  match xs:
    case Nil{}:
      ins_nil($AK, k, v, ys, hg)
    case Con{+e, +t}:
      %Equal.sym(Cmp, cmp(k, $KY(e)), GT{}, OR.lt_gt(~K, ~cmp, ~o, $KY(e), k, L.and_left(Cmp.is_lt(cmp($KY(e), k)), OR.ltall($AK, k, t), hl))) : {S.pick($ES, Cmp.is_lt(_), Con{$EKV, Con{e, $EAPP(t, ys)}}, Con{e, $INS($EAPP(t, ys))}) == Con{e, $EAPP(t, Con{$EKV, ys})} : $ES}
      %Equal.sym($ES, $INS($EAPP(t, ys)), $EAPP(t, Con{$EKV, ys}), ins_gap($AO, k, v, t, ys, L.and_right(Cmp.is_lt(cmp($KY(e), k)), OR.ltall($AK, k, t), hl), hg)) : {Con{e, _} == Con{e, $EAPP(t, Con{$EKV, ys})} : $ES}
      {==}

# k is found neither below nor above it
def find_gap($TO, +k: K, +xs: $ES, +ys: $ES, +hl: $LTA(k, xs), +hg: $GTA(k, ys)) -> {S.find_e($AK, k, $EAPP(xs, ys)) == None{} : $ME}:
  %Equal.sym($ME, S.find_e($AK, k, $EAPP(xs, ys)), OR.orm($E, S.find_e($AK, k, xs), S.find_e($AK, k, ys)), OR.find_app($AK, k, xs, ys)) : {_ == None{} : $ME}
  %Equal.sym($ME, S.find_e($AK, k, xs), None{}, OR.lt_none($AO, k, xs, hl)) : {OR.orm($E, _, S.find_e($AK, k, ys)) == None{} : $ME}
  OR.gt_none($AK, k, ys, hg)

def ord_cons($TK_, +e: $E, +ys: $ES, +h: $ORD(ys), +hg: $GTA($KY(e), ys)) -> $ORD(Con{e, ys}):
  match ys:
    case Nil{}:
      {==}
    case Con{+e2, +u}:
      L.and_intro(Cmp.is_lt(cmp($KY(e), $KY(e2))), ST.ordered($AK, Con{e2, u}), L.and_left(Cmp.is_lt(cmp($KY(e), $KY(e2))), OR.gtall($AK, $KY(e), u), hg), h)

def ord_step($TK_, +a: $E, +t: $ES, +e: $E, +ys: $ES, +hae: {Cmp.is_lt(cmp($KY(a), $KY(e))) == True{} : Bool}, +h: $ORD(Con{a, $EAPP(t, ys)}), +ih: $ORD($EAPP(t, Con{e, ys}))) -> $ORD(Con{a, $EAPP(t, Con{e, ys})}):
  match t:
    case Nil{}:
      L.and_intro(Cmp.is_lt(cmp($KY(a), $KY(e))), ST.ordered($AK, Con{e, ys}), hae, ih)
    case Con{+b, +u}:
      L.and_intro(Cmp.is_lt(cmp($KY(a), $KY(b))), ST.ordered($AK, Con{b, $EAPP(u, Con{e, ys})}), L.and_left(Cmp.is_lt(cmp($KY(a), $KY(b))), ST.ordered($AK, Con{b, $EAPP(u, ys)}), h), ih)

# an entry between the entries below and above it keeps the order
def ord_ins($TO, +xs: $ES, +e: $E, +ys: $ES, +h: $ORD($EAPP(xs, ys)), +hl: $LTA($KY(e), xs), +hg: $GTA($KY(e), ys)) -> $ORD($EAPP(xs, Con{e, ys})):
  match xs:
    case Nil{}:
      ord_cons($AK, e, ys, h, hg)
    case Con{+a, +t}:
      +ht = OR.ord_tail($AK, a, $EAPP(t, ys), h)
      +ih = ord_ins($AO, t, e, ys, ht, L.and_right(Cmp.is_lt(cmp($KY(a), $KY(e))), OR.ltall($AK, $KY(e), t), hl), hg)
      ord_step($AK, a, t, e, ys, L.and_left(Cmp.is_lt(cmp($KY(a), $KY(e))), OR.ltall($AK, $KY(e), t), hl), h, ih)

