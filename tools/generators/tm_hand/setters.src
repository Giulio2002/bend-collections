def ent_setr(-K: Data, -V: Data, +nl: $NL, +id: Nat, +v: Nat, +j: Nat, +m: $MV) -> {ST.ent(K, V, $NDX(setr(K, nl, id, v), j), m) == ST.ent(K, V, $NDX(nl, j), m) : Maybe<&2, $E>}:
