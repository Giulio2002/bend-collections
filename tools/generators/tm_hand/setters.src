def ent_pkr(-K: Data, -V: Data, +e: Bool, +x: $ND, +v: Nat, +m: $MV) -> {ST.ent(K, V, ST.pk($ND, e, modr(K, x, v), x), m) == ST.ent(K, V, x, m) : Maybe<&2, $E>}:
