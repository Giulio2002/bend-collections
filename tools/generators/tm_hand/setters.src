def oks_setp(~K: Data, ~V: Data, +xs: $LN, +nl: $NL, +pl: List<&2, $MV>, +id: Nat, +v: Nat) -> {EN.oks(~K, ~V, xs, setp(K, nl, id, v), pl) == EN.oks(~K, ~V, xs, nl, pl) : Bool}:
  match xs:
    case Nil{}:
      {==}
    case Con{+j, +t}:
      %Equal.sym(Maybe<&2, $E>, ST.ent(K, V, $NDX(setp(K, nl, id, v), j), ST.pv(V, pl, j)), ST.ent(K, V, $NDX(nl, j), ST.pv(V, pl, j)), ent_setp(K, V, nl, id, v, j, ST.pv(V, pl, j))) : {Bool.and(S.is_some($E, _), EN.oks(~K, ~V, t, setp(K, nl, id, v), pl)) == EN.oks(~K, ~V, Con{j, t}, nl, pl) : Bool}
      %Equal.sym(Bool, EN.oks(~K, ~V, t, setp(K, nl, id, v), pl), EN.oks(~K, ~V, t, nl, pl), oks_setp(~K, ~V, t, nl, pl, id, v)) : {Bool.and(S.is_some($E, ST.ent(K, V, $NDX(nl, j), ST.pv(V, pl, j))), _) == EN.oks(~K, ~V, Con{j, t}, nl, pl) : Bool}
      {==}

# a setter keeps the free chain
def fll_setp(~K: Data, +fl: $LN, +nl: $NL, +id: Nat, +v: Nat) -> {ST.fll(~K, setp(K, nl, id, v), fl) == ST.fll(~K, nl, fl) : Bool}:
  match fl:
    case Nil{}:
      {==}
    case Con{+f, +t}:
      %Equal.sym($ND, $NDX(setp(K, nl, id, v), f), ST.pk($ND, Nat.is_eq(id, f), modp(K, $NDX(nl, f), v), $NDX(nl, f)), ndp(K, nl, id, v, f)) : {Bool.and(ST.is_free(K, _, ST.fst0(t)), ST.fll(~K, setp(K, nl, id, v), t)) == ST.fll(~K, nl, Con{f, t}) : Bool}
      %Equal.sym(Bool, ST.is_free(K, ST.pk($ND, Nat.is_eq(id, f), modp(K, $NDX(nl, f), v), $NDX(nl, f)), ST.fst0(t)), ST.is_free(K, $NDX(nl, f), ST.fst0(t)), free_pkp(K, Nat.is_eq(id, f), $NDX(nl, f), v, ST.fst0(t))) : {Bool.and(_, ST.fll(~K, setp(K, nl, id, v), t)) == ST.fll(~K, nl, Con{f, t}) : Bool}
      %Equal.sym(Bool, ST.fll(~K, setp(K, nl, id, v), t), ST.fll(~K, nl, t), fll_setp(~K, t, nl, id, v)) : {Bool.and(ST.is_free(K, $NDX(nl, f), ST.fst0(t)), _) == ST.fll(~K, nl, Con{f, t}) : Bool}
      {==}

def ent_modc(-K: Data, -V: Data, +x: $ND, +v: Bool, +m: $MV) -> {ST.ent(K, V, modc(K, x, v), m) == ST.ent(K, V, x, m) : Maybe<&2, $E>}:
  match x m:
    case M.Free{f} +m:
      {==}
    case M.N{c, a, b, q, k} None{}:
      {==}
    case M.N{c, a, b, q, k} Some{w}:
      {==}

def free_modc(-K: Data, +x: $ND, +v: Bool, +q: Nat) -> {ST.is_free(K, modc(K, x, v), q) == ST.is_free(K, x, q) : Bool}:
  match x:
    case M.Free{f}:
      {==}
    case M.N{c, a, b, q2, k}:
      {==}

def ent_pkc(-K: Data, -V: Data, +e: Bool, +x: $ND, +v: Bool, +m: $MV) -> {ST.ent(K, V, ST.pk($ND, e, modc(K, x, v), x), m) == ST.ent(K, V, x, m) : Maybe<&2, $E>}:
  match e:
    case True{}:
      ent_modc(K, V, x, v, m)
    case False{}:
      {==}

def free_pkc(-K: Data, +e: Bool, +x: $ND, +v: Bool, +q: Nat) -> {ST.is_free(K, ST.pk($ND, e, modc(K, x, v), x), q) == ST.is_free(K, x, q) : Bool}:
  match e:
    case True{}:
      free_modc(K, x, v, q)
    case False{}:
      {==}

def ent_setc(-K: Data, -V: Data, +nl: $NL, +id: Nat, +v: Bool, +j: Nat, +m: $MV) -> {ST.ent(K, V, $NDX(setc(K, nl, id, v), j), m) == ST.ent(K, V, $NDX(nl, j), m) : Maybe<&2, $E>}:
  %Equal.sym($ND, $NDX(setc(K, nl, id, v), j), ST.pk($ND, Nat.is_eq(id, j), modc(K, $NDX(nl, j), v), $NDX(nl, j)), ndc(K, nl, id, v, j)) : {ST.ent(K, V, _, m) == ST.ent(K, V, $NDX(nl, j), m) : Maybe<&2, $E>}
  ent_pkc(K, V, Nat.is_eq(id, j), $NDX(nl, j), v, m)

# a setter keeps every entry
def ents_setc(~K: Data, ~V: Data, +xs: $LN, +nl: $NL, +pl: List<&2, $MV>, +id: Nat, +v: Bool) -> {ST.ents(~K, ~V, xs, setc(K, nl, id, v), pl) == ST.ents(~K, ~V, xs, nl, pl) : List<&2, $E>}:
  match xs:
    case Nil{}:
      {==}
    case Con{+j, +t}:
      %Equal.sym(Maybe<&2, $E>, ST.ent(K, V, $NDX(setc(K, nl, id, v), j), ST.pv(V, pl, j)), ST.ent(K, V, $NDX(nl, j), ST.pv(V, pl, j)), ent_setc(K, V, nl, id, v, j, ST.pv(V, pl, j))) : {ST.cons_m($E, _, ST.ents(~K, ~V, t, setc(K, nl, id, v), pl)) == ST.ents(~K, ~V, Con{j, t}, nl, pl) : List<&2, $E>}
      %Equal.sym(List<&2, $E>, ST.ents(~K, ~V, t, setc(K, nl, id, v), pl), ST.ents(~K, ~V, t, nl, pl), ents_setc(~K, ~V, t, nl, pl, id, v)) : {ST.cons_m($E, ST.ent(K, V, $NDX(nl, j), ST.pv(V, pl, j)), _) == ST.ents(~K, ~V, Con{j, t}, nl, pl) : List<&2, $E>}
      {==}

def oks_setc(~K: Data, ~V: Data, +xs: $LN, +nl: $NL, +pl: List<&2, $MV>, +id: Nat, +v: Bool) -> {EN.oks(~K, ~V, xs, setc(K, nl, id, v), pl) == EN.oks(~K, ~V, xs, nl, pl) : Bool}:
  match xs:
    case Nil{}:
      {==}
    case Con{+j, +t}:
      %Equal.sym(Maybe<&2, $E>, ST.ent(K, V, $NDX(setc(K, nl, id, v), j), ST.pv(V, pl, j)), ST.ent(K, V, $NDX(nl, j), ST.pv(V, pl, j)), ent_setc(K, V, nl, id, v, j, ST.pv(V, pl, j))) : {Bool.and(S.is_some($E, _), EN.oks(~K, ~V, t, setc(K, nl, id, v), pl)) == EN.oks(~K, ~V, Con{j, t}, nl, pl) : Bool}
      %Equal.sym(Bool, EN.oks(~K, ~V, t, setc(K, nl, id, v), pl), EN.oks(~K, ~V, t, nl, pl), oks_setc(~K, ~V, t, nl, pl, id, v)) : {Bool.and(S.is_some($E, ST.ent(K, V, $NDX(nl, j), ST.pv(V, pl, j))), _) == EN.oks(~K, ~V, Con{j, t}, nl, pl) : Bool}
      {==}

# a setter keeps the free chain
def fll_setc(~K: Data, +fl: $LN, +nl: $NL, +id: Nat, +v: Bool) -> {ST.fll(~K, setc(K, nl, id, v), fl) == ST.fll(~K, nl, fl) : Bool}:
  match fl:
    case Nil{}:
      {==}
    case Con{+f, +t}:
      %Equal.sym($ND, $NDX(setc(K, nl, id, v), f), ST.pk($ND, Nat.is_eq(id, f), modc(K, $NDX(nl, f), v), $NDX(nl, f)), ndc(K, nl, id, v, f)) : {Bool.and(ST.is_free(K, _, ST.fst0(t)), ST.fll(~K, setc(K, nl, id, v), t)) == ST.fll(~K, nl, Con{f, t}) : Bool}
      %Equal.sym(Bool, ST.is_free(K, ST.pk($ND, Nat.is_eq(id, f), modc(K, $NDX(nl, f), v), $NDX(nl, f)), ST.fst0(t)), ST.is_free(K, $NDX(nl, f), ST.fst0(t)), free_pkc(K, Nat.is_eq(id, f), $NDX(nl, f), v, ST.fst0(t))) : {Bool.and(_, ST.fll(~K, setc(K, nl, id, v), t)) == ST.fll(~K, nl, Con{f, t}) : Bool}
      %Equal.sym(Bool, ST.fll(~K, setc(K, nl, id, v), t), ST.fll(~K, nl, t), fll_setc(~K, t, nl, id, v)) : {Bool.and(ST.is_free(K, $NDX(nl, f), ST.fst0(t)), _) == ST.fll(~K, nl, Con{f, t}) : Bool}
      {==}

# ---- recolouring keeps every link ----

%def ISNB(x, a, b, q) ST.is_node(K, x, a, b, q)

def isn_modc(-K: Data, +x: $ND, +v: Bool, +a: Nat, +b: Nat, +q: Nat) -> {$ISNB(modc(K, x, v), a, b, q) == $ISNB(x, a, b, q) : Bool}:
  match x:
    case M.Free{f}:
      {==}
    case M.N{c, x1, x2, x3, k}:
      {==}

def isn_pkc(-K: Data, +e: Bool, +x: $ND, +v: Bool, +a: Nat, +b: Nat, +q: Nat) -> {$ISNB(ST.pk($ND, e, modc(K, x, v), x), a, b, q) == $ISNB(x, a, b, q) : Bool}:
  match e:
    case True{}:
      isn_modc(K, x, v, a, b, q)
    case False{}:
      {==}

def isn_setc(-K: Data, +nl: $NL, +id: Nat, +v: Bool, +j: Nat, +a: Nat, +b: Nat, +q: Nat) -> {$ISNB($NDX(setc(K, nl, id, v), j), a, b, q) == $ISNB($NDX(nl, j), a, b, q) : Bool}:
  %Equal.sym($ND, $NDX(setc(K, nl, id, v), j), ST.pk($ND, Nat.is_eq(id, j), modc(K, $NDX(nl, j), v), $NDX(nl, j)), ndc(K, nl, id, v, j)) : {$ISNB(_, a, b, q) == $ISNB($NDX(nl, j), a, b, q) : Bool}
  isn_pkc(K, Nat.is_eq(id, j), $NDX(nl, j), v, a, b, q)

def rep_setc(~K: Data, +t: ST.Tr, +p: Nat, +nl: $NL, +id: Nat, +v: Bool) -> {ST.rep(~K, t, p, setc(K, nl, id, v)) == ST.rep(~K, t, p, nl) : Bool}:
  match t:
    case ST.TE{}:
      {==}
    case ST.TN{+i, +l, +r}:
      %Equal.sym(Bool, $ISNB($NDX(setc(K, nl, id, v), i), ST.rid(l), ST.rid(r), p), $ISNB($NDX(nl, i), ST.rid(l), ST.rid(r), p), isn_setc(K, nl, id, v, i, ST.rid(l), ST.rid(r), p)) : {Bool.and(Nat.is_lt(0n, i), Bool.and(_, Bool.and(ST.rep(~K, l, i, setc(K, nl, id, v)), ST.rep(~K, r, i, setc(K, nl, id, v))))) == ST.rep(~K, ST.TN{i, l, r}, p, nl) : Bool}
      %Equal.sym(Bool, ST.rep(~K, l, i, setc(K, nl, id, v)), ST.rep(~K, l, i, nl), rep_setc(~K, l, i, nl, id, v)) : {Bool.and(Nat.is_lt(0n, i), Bool.and($ISNB($NDX(nl, i), ST.rid(l), ST.rid(r), p), Bool.and(_, ST.rep(~K, r, i, setc(K, nl, id, v))))) == ST.rep(~K, ST.TN{i, l, r}, p, nl) : Bool}
      %Equal.sym(Bool, ST.rep(~K, r, i, setc(K, nl, id, v)), ST.rep(~K, r, i, nl), rep_setc(~K, r, i, nl, id, v)) : {Bool.and(Nat.is_lt(0n, i), Bool.and($ISNB($NDX(nl, i), ST.rid(l), ST.rid(r), p), Bool.and(ST.rep(~K, l, i, nl), _))) == ST.rep(~K, ST.TN{i, l, r}, p, nl) : Bool}
      {==}

def ctx_setc(~K: Data, +c: List<&2, P.Fr>, +x: Nat, +nl: $NL, +id: Nat, +v: Bool) -> {P.ctxok(~K, c, x, setc(K, nl, id, v)) == P.ctxok(~K, c, x, nl) : Bool}:
  match c:
    case Nil{}:
      {==}
    case Con{P.FR{+p, +lft, +s}, +u}:
      %Equal.sym(Bool, $ISNB($NDX(setc(K, nl, id, v), p), ST.pk(Nat, lft, x, ST.rid(s)), ST.pk(Nat, lft, ST.rid(s), x), P.top(u)), $ISNB($NDX(nl, p), ST.pk(Nat, lft, x, ST.rid(s)), ST.pk(Nat, lft, ST.rid(s), x), P.top(u)), isn_setc(K, nl, id, v, p, ST.pk(Nat, lft, x, ST.rid(s)), ST.pk(Nat, lft, ST.rid(s), x), P.top(u))) : {Bool.and(Bool.and(Nat.is_lt(0n, p), Bool.and(_, ST.rep(~K, s, p, setc(K, nl, id, v)))), P.ctxok(~K, u, p, setc(K, nl, id, v))) == P.ctxok(~K, Con{P.FR{p, lft, s}, u}, x, nl) : Bool}
      %Equal.sym(Bool, ST.rep(~K, s, p, setc(K, nl, id, v)), ST.rep(~K, s, p, nl), rep_setc(~K, s, p, nl, id, v)) : {Bool.and(Bool.and(Nat.is_lt(0n, p), Bool.and($ISNB($NDX(nl, p), ST.pk(Nat, lft, x, ST.rid(s)), ST.pk(Nat, lft, ST.rid(s), x), P.top(u)), _)), P.ctxok(~K, u, p, setc(K, nl, id, v))) == P.ctxok(~K, Con{P.FR{p, lft, s}, u}, x, nl) : Bool}
      %Equal.sym(Bool, P.ctxok(~K, u, p, setc(K, nl, id, v)), P.ctxok(~K, u, p, nl), ctx_setc(~K, u, p, nl, id, v)) : {Bool.and(Bool.and(Nat.is_lt(0n, p), Bool.and($ISNB($NDX(nl, p), ST.pk(Nat, lft, x, ST.rid(s)), ST.pk(Nat, lft, ST.rid(s), x), P.top(u)), ST.rep(~K, s, p, nl))), _) == P.ctxok(~K, Con{P.FR{p, lft, s}, u}, x, nl) : Bool}
      {==}

# the recoloured node's colour
def red_modc(-K: Data, +x: $ND, +v: Bool, +h: {ST.is_red(K, x) == ST.is_red(K, x) : Bool}) -> {ST.is_red(K, modc(K, x, False{})) == False{} : Bool}:
  match x:
    case M.Free{f}:
      {==}
    case M.N{c, a, b, q, k}:
      {==}
