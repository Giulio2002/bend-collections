# Allocating the new slot where the search stopped: appending (room in the
# block, or growing it, or failing at the capacity) or reusing the free
# list's head; each gives the insertion's facts or the specification's
# rejection. (source: tools/generators/tm_hand/alloc.src)

%def ND M.Node<K>
%def NL List<&2, $ND>
%def LN List<&2, Nat>
%def MV Maybe<&2, V>
%def PL List<&2, $MV>
%def E M.Entry<K, V>
%def ES List<&2, $E>
%def CT List<&2, P.Fr>
%def APP(a, b) SC.append(Nat, a, b)
%def EAPP(a, b) SC.append($E, a, b)
%def IDS(t) ST.ids(t)
%def TE ST.TE{}
%def TO ~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, ~o: O.Order(~K, ~cmp)
%def AK ~K, ~V, ~cmp
%def AO ~K, ~V, ~cmp, ~o
%def AO3 ~K, ~cmp, ~o
%def NDX(nl, j) ST.nd(K, nl, j)
%def BA(c) $APP(P.before(c), P.after(c))
%def EB ST.ents(~K, ~V, P.before(c), nl, pl)
%def EA ST.ents(~K, ~V, P.after(c), nl, pl)
%def ES0 ST.ents(~K, ~V, $IDS(tg), nl, pl)
%def RES Result<&2, &2, M.Rejected<K, V>, Maybe<&2, V>>
%def LTA(k, es) {OR.ltall($AK, k, es) == True{} : Bool}
%def GTA(k, es) {OR.gtall($AK, k, es) == True{} : Bool}
%def P0 P.top(c)
%def DR SP.dir(c)
%def NEWN M.N{True{}, 0n, 0n, $P0, k}
%def LNL SC.length($ND, nl)
%def FO0 +n: Nat, +root: Nat, +lo: Nat, +hi: Nat, +l: Nat, +d: Nat, +nl: $NL, +pl: $PL, +tg: ST.Tr, +fl: $LN
%def FOA0 n, root, lo, hi, 0n, l, d, nl, pl, tg, fl
%def SH0 ST.SH{$FOA0}
%def GF0 {ST.goodF($AK, $FOA0) == True{} : Bool}
%def SPH +hbc: {$IDS(tg) == $BA(c) : $LN}, +hplug: {tg == PG.plug(c, $TE) : ST.Tr}, +hok: {P.ctxok(~K, c, 0n, nl) == True{} : Bool}, +hb: $LTA(k, $EB), +ha: $GTA(k, $EA)
%def SPA hbc, hplug, hok, hb, ha
%def SPEC(sh) S.put($AK, ST.model($AK, sh), k, v)
%def REJ Fail{M.Rejected{M.CapacityExceeded{}, k, v}}

def fl_nil(+fl: $LN, +n: Nat, +h0: {0n == ST.fst0(fl) : Nat}, +ha: {ST.allin(fl, n) == True{} : Bool}) -> {fl == Nil{} : $LN}:
  match fl:
    case Nil{}:
      {==}
    case Con{+y, +t}:
      +hy = L.and_left(Nat.is_lt(0n, y), Nat.is_le(y, n), L.and_left(Bool.and(Nat.is_lt(0n, y), Nat.is_le(y, n)), ST.allin(t, n), ha))
      Empty.absurd({Con{y, t} == Nil{} : $LN}, L.false_true(L.subst(Nat, z => {Nat.is_lt(0n, z) == True{} : Bool}, y, 0n, Equal.sym(Nat, 0n, y, h0), hy)))

# the specification rejects at the capacity
def spec_rej($TO, +l: Nat, +n: Nat, +nl: $NL, +pl: $PL, +tg: ST.Tr, +c: $CT, +k: K, +v: V, +hbc: {$IDS(tg) == $BA(c) : $LN}, +hb: $LTA(k, $EB), +ha: $GTA(k, $EA), +hsz: {n == SC.length($E, $ES0) : Nat}, +hfull: {Nat.is_lt(n, SC.pow2(l)) == False{} : Bool}) -> {S.put($AK, S.TM{l, $ES0}, k, v) == (S.TM{l, $ES0}, $REJ) : S.Model<K, V> & $RES}:
  +es = IF.es_split(~K, ~V, nl, pl, tg, c, hbc)
  +hf = INS.find_gap($AO, k, $EB, $EA, hb, ha)
  +hl = L.subst(Nat, z => {Nat.is_lt(z, SC.pow2(l)) == False{} : Bool}, n, SC.length($E, $ES0), hsz, hfull)
  %Equal.sym(Maybe<&2, $E>, S.find_e($AK, k, $ES0), None{}, L.subst($ES, z => {S.find_e($AK, k, z) == None{} : Maybe<&2, $E>}, $EAPP($EB, $EA), $ES0, Equal.sym($ES, $ES0, $EAPP($EB, $EA), es), hf)) : {S.put_at($AK, l, $ES0, k, v, S.val_m(K, V, _)) == (S.TM{l, $ES0}, $REJ) : S.Model<K, V> & $RES}
  %Equal.sym(Bool, Nat.is_lt(SC.length($E, $ES0), SC.pow2(l)), False{}, hl) : {S.pick(S.Model<K, V> & $RES, _, (S.TM{l, S.ins($AK, k, v, $ES0)}, Done{None{}}), (S.TM{l, $ES0}, $REJ)) == (S.TM{l, $ES0}, $REJ) : S.Model<K, V> & $RES}
  {==}

%def I0X $APP(P.before(c), Con{1n+$LNL, P.after(c)})
%def ROOM Nat.is_lt($LNL, SC.pow2(d))
%def GROW Nat.is_lt(d, l)
%def MIRA(room, grow) MI.put_allocated($AK, $P0, $DR, MI.app_room(~K, ~V, n, root, lo, hi, 0n, l, d, nl, pl, tg, fl, k, v, $P0, room, grow))

# appending: into room, growing the block, or rejected at the capacity
