      +edl = N.le_antisym(d, l, ST.g_cd($AK, $FOA0, hg), N.not_lt_le(d, l, hgw))
      +hful0 = L.subst(Nat, z => {Nat.is_lt($LNL, SC.pow2(z)) == False{} : Bool}, d, l, edl, hr)
      +hful = L.subst(Nat, z => {Nat.is_lt(z, SC.pow2(l)) == False{} : Bool}, $LNL, n, Equal.sym(Nat, n, $LNL, hn), hful0)
