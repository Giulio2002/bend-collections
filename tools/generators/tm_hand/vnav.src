import Base
import ../lib/order.bend as O
import ../spec/tree_map.bend as S
import ../../src/containers/balanced_search_tree.bend as M
import ./state.bend as ST
import ./mirror.bend as MI
import ./ends.bend as EN
import ./navm.bend as NM
import ./ord.bend as OR
import ./cur.bend as CU
import ./vsp.bend as VS

# A view's first and last entries and its searches: the mirror starts at the
# bound (or searches from the key, when inside the view) and checks the entry
# found against the range; the specification searches the entries within.
# (source: tools/generators/tm_hand/vnav.src)

%def E M.Entry<K, V>
%def ME Maybe<&2, $E>
%def TK ~K: Data, ~V: Data, ~cmp: K -> K -> Cmp
%def TO ~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, ~o: O.Order(~K, ~cmp)
%def AK ~K, ~V, ~cmp
%def AO ~K, ~V, ~cmp, ~o
%def FT +n: Nat, +root: Nat, +lo: Nat, +hi: Nat, +free: Nat, +l: Nat, +d: Nat, +nl: List<&2, M.Node<K>>, +pl: List<&2, Maybe<&2, V>>, +tg: ST.Tr, +fl: List<&2, Nat>
%def FP +n, +root, +lo, +hi, +free, +l, +d, +nl, +pl, +tg, +fl
%def F n, root, lo, hi, free, l, d, nl, pl, tg, fl
%def SH ST.SH{$F}
%def SHT ST.Sh<K, V>
%def MVT MI.MView<K, V>
%def BD M.Bound<K>
%def GF {ST.good($AK, $SH) == True{} : Bool}
%def EST ST.ents(~K, ~V, ST.ids(tg), nl, pl)
%def W S.within($AK, lo2, hi2, $EST)
%def VWS MI.MV{$SH, lo2, hi2, d2}
%def VB +lo2: $BD, +hi2: $BD, +d2: Bool
%def VBA lo2, hi2, d2
%def HORD ST.g_cord($AK, $F, hg)
%def ES1(r) MI.entry_snapshot($AK, r)

# ---- the entry at a bound ----

def rsf_m($TO, $FT, +hg: $GF, +lw: $BD) -> {$ES1(MI.range_start($AK, $SH, lw, True{})) == ($SH, VS.fal($AK, lw, $EST)) : $SHT & $ME}:
  match lw:
    case M.Unbounded{}:
      %Equal.sym($ME, VS.fal($AK, M.Unbounded{}, $EST), S.head($E, $EST), VS.fal_u($AK, $EST)) : {$ES1(MI.range_start($AK, $SH, M.Unbounded{}, True{})) == ($SH, _) : $SHT & $ME}
      EN.first_entry_m($AK, $F, hg)
    case M.Inclusive{+x}:
      %Equal.sym($ME, VS.fal($AK, M.Inclusive{x}, $EST), S.first_where($AK, x, True{}, $EST), VS.fal_i($AK, x, $EST)) : {$ES1(MI.range_start($AK, $SH, M.Inclusive{x}, True{})) == ($SH, _) : $SHT & $ME}
      NM.nav_entry_m($AO, $F, x, True{}, True{}, hg)
    case M.Exclusive{+x}:
      %Equal.sym($ME, VS.fal($AK, M.Exclusive{x}, $EST), S.first_where($AK, x, False{}, $EST), VS.fal_x($AK, x, $EST)) : {$ES1(MI.range_start($AK, $SH, M.Exclusive{x}, True{})) == ($SH, _) : $SHT & $ME}
      NM.nav_entry_m($AO, $F, x, True{}, False{}, hg)

def rsb_m($TO, $FT, +hg: $GF, +up: $BD) -> {$ES1(MI.range_start($AK, $SH, up, False{})) == ($SH, VS.lbu($AK, up, $EST, None{})) : $SHT & $ME}:
  match up:
    case M.Unbounded{}:
      %Equal.sym($ME, VS.lbu($AK, M.Unbounded{}, $EST, None{}), S.last($E, $EST), Equal.trans($ME, VS.lbu($AK, M.Unbounded{}, $EST, None{}), OR.orm($E, S.last($E, $EST), None{}), S.last($E, $EST), VS.lbu_u($AK, $EST, None{}), OR.orm_none($E, S.last($E, $EST)))) : {$ES1(MI.range_start($AK, $SH, M.Unbounded{}, False{})) == ($SH, _) : $SHT & $ME}
      EN.last_entry_m($AK, $F, hg)
    case M.Inclusive{+y}:
      %Equal.sym($ME, VS.lbu($AK, M.Inclusive{y}, $EST, None{}), S.last_where($AK, y, True{}, $EST, None{}), VS.lbu_i($AK, y, $EST, None{})) : {$ES1(MI.range_start($AK, $SH, M.Inclusive{y}, False{})) == ($SH, _) : $SHT & $ME}
      NM.nav_entry_m($AO, $F, y, False{}, True{}, hg)
    case M.Exclusive{+y}:
      %Equal.sym($ME, VS.lbu($AK, M.Exclusive{y}, $EST, None{}), S.last_where($AK, y, False{}, $EST, None{}), VS.lbu_x($AK, y, $EST, None{})) : {$ES1(MI.range_start($AK, $SH, M.Exclusive{y}, False{})) == ($SH, _) : $SHT & $ME}
      NM.nav_entry_m($AO, $F, y, False{}, False{}, hg)

# ---- the entry found, checked against the range ----

%def MVE $MVT & $ME

def ver_b($TK, +s: $SHT, $VB, +en: $E, +b: Bool) -> {MI.view_entry_checked($AK, s, $VBA, en, b) == (MI.MV{s, $VBA}, S.pick($ME, b, Some{en}, None{})) : $MVE}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

def ver_eq($TK, +s: $SHT, $VB, +m: $ME) -> {MI.view_entry_result($AK, $VBA, (s, m)) == (MI.MV{s, $VBA}, VS.chk($AK, lo2, hi2, m)) : $MVE}:
  match m:
    case None{}:
      {==}
    case Some{M.Entry{+k, +v}}:
      %Equal.sym(Bool, M.in_range($AK, k, lo2, hi2), S.in_range(~K, ~cmp, k, lo2, hi2), CU.inr_eq($AK, k, lo2, hi2)) : {MI.view_entry_checked($AK, s, $VBA, M.Entry{k, v}, _) == (MI.MV{s, $VBA}, VS.chk($AK, lo2, hi2, Some{M.Entry{k, v}})) : $MVE}
      ver_b($AK, s, $VBA, M.Entry{k, v}, S.in_range(~K, ~cmp, k, lo2, hi2))

# a snapshot known, its check the specification's answer
def vres($TK, +s: $SHT, $VB, -r: $SHT & $ME, +m: $ME, +o: $ME, +hr: {r == (s, m) : $SHT & $ME}, +ho: {o == VS.chk($AK, lo2, hi2, m) : $ME}) -> {MI.view_entry_result($AK, $VBA, r) == (MI.MV{s, $VBA}, o) : $MVE}:
  %Equal.sym($SHT & $ME, r, (s, m), hr) : {MI.view_entry_result($AK, $VBA, _) == (MI.MV{s, $VBA}, o) : $MVE}
  %Equal.sym($ME, o, VS.chk($AK, lo2, hi2, m), ho) : {MI.view_entry_result($AK, $VBA, (s, m)) == (MI.MV{s, $VBA}, _) : $MVE}
  ver_eq($AK, s, $VBA, m)

# ---- first and last ----

%def XR(up) {MI.view_entry_result($AK, $VBA, $ES1(MI.range_start($AK, $SH, M.pick($BD, up, lo2, hi2), up))) == ($VWS, S.pick($ME, up, S.head($E, $W), S.last($E, $W))) : $MVE}

def vx_up($TO, $FT, +hg: $GF, $VB, +up: Bool) -> $XR(up):
  match up:
    case True{}:
      vres($AK, $SH, $VBA, $ES1(MI.range_start($AK, $SH, lo2, True{})), VS.fal($AK, lo2, $EST), S.head($E, $W), rsf_m($AO, $F, hg, lo2), VS.first_within($AO, lo2, hi2, $EST, $HORD))
    case False{}:
      vres($AK, $SH, $VBA, $ES1(MI.range_start($AK, $SH, hi2, False{})), VS.lbu($AK, hi2, $EST, None{}), S.last($E, $W), rsb_m($AO, $F, hg, hi2), VS.last_within($AO, lo2, hi2, $EST, $HORD))

%def XO(first) S.pick($ME, S.pick(Bool, d2, Bool.not(first), first), S.head($E, $W), S.last($E, $W))

def vx_m($TO, $FT, +hg: $GF, $VB, +first: Bool) -> {MI.view_extreme($AK, $VWS, first) == ($VWS, $XO(first)) : $MVE}:
  match d2:
    case True{}:
      vx_up($AO, $F, hg, lo2, hi2, True{}, Bool.not(first))
    case False{}:
      vx_up($AO, $F, hg, lo2, hi2, False{}, first)

# ---- searches ----

%def NK +k: K, +incl: Bool
%def NR(up, wth) {MI.view_entry_result($AK, $VBA, $ES1(MI.view_nav_start($AK, $SH, k, lo2, hi2, up, incl, wth))) == ($VWS, S.nav($AK, k, up, incl, $W)) : $MVE}
%def FWK(xs) S.first_where($AK, k, incl, xs)
%def LWK(xs) S.last_where($AK, k, incl, xs, None{})

def vn_t($TO, $FT, +hg: $GF, $VB, $NK, +a: Bool, +ha: {S.above_lower(~K, ~cmp, k, lo2) == a : Bool}) -> $NR(True{}, a):
  match a:
    case True{}:
      vres($AK, $SH, $VBA, $ES1(MI.navigate($AK, $SH, k, True{}, incl)), $FWK($EST), $FWK($W), NM.nav_entry_m($AO, $F, k, True{}, incl, hg), VS.fw_within($AO, lo2, hi2, k, incl, $EST, $HORD, ha))
    case False{}:
      vres($AK, $SH, $VBA, $ES1(MI.range_start($AK, $SH, lo2, True{})), VS.fal($AK, lo2, $EST), $FWK($W), rsf_m($AO, $F, hg, lo2), Equal.trans($ME, $FWK($W), S.head($E, $W), VS.chk($AK, lo2, hi2, VS.fal($AK, lo2, $EST)), VS.fw_below($AO, lo2, hi2, k, incl, $EST, ha), VS.first_within($AO, lo2, hi2, $EST, $HORD)))

def vn_f($TO, $FT, +hg: $GF, $VB, $NK, +b: Bool, +hb: {S.below_upper(~K, ~cmp, k, hi2) == b : Bool}) -> $NR(False{}, b):
  match b:
    case True{}:
      vres($AK, $SH, $VBA, $ES1(MI.navigate($AK, $SH, k, False{}, incl)), $LWK($EST), $LWK($W), NM.nav_entry_m($AO, $F, k, False{}, incl, hg), VS.lw_within($AO, lo2, hi2, k, incl, $EST, $HORD, hb))
    case False{}:
      vres($AK, $SH, $VBA, $ES1(MI.range_start($AK, $SH, hi2, False{})), VS.lbu($AK, hi2, $EST, None{}), $LWK($W), rsb_m($AO, $F, hg, hi2), Equal.trans($ME, $LWK($W), S.last($E, $W), VS.chk($AK, lo2, hi2, VS.lbu($AK, hi2, $EST, None{})), VS.lw_above($AO, lo2, hi2, k, incl, $EST, hb), VS.last_within($AO, lo2, hi2, $EST, $HORD)))

def vn_up($TO, $FT, +hg: $GF, $VB, $NK, +up: Bool) -> $NR(up, M.pick(Bool, up, M.above_lower($AK, k, lo2), M.below_upper($AK, k, hi2))):
  match up:
    case True{}:
      %Equal.sym(Bool, M.above_lower($AK, k, lo2), S.above_lower(~K, ~cmp, k, lo2), CU.al_eq($AK, k, lo2)) : $NR(True{}, _)
      vn_t($AO, $F, hg, $VBA, k, incl, S.above_lower(~K, ~cmp, k, lo2), {==})
    case False{}:
      %Equal.sym(Bool, M.below_upper($AK, k, hi2), S.below_upper(~K, ~cmp, k, hi2), CU.bu_eq($AK, k, hi2)) : $NR(False{}, _)
      vn_f($AO, $F, hg, $VBA, k, incl, S.below_upper(~K, ~cmp, k, hi2), {==})

%def NO(h) S.nav($AK, k, S.pick(Bool, d2, Bool.not(h), h), incl, $W)

def vn_m($TO, $FT, +hg: $GF, $VB, +k: K, +higher: Bool, +incl: Bool) -> {MI.view_nav($AK, $VWS, k, higher, incl) == ($VWS, $NO(higher)) : $MVE}:
  match d2:
    case True{}:
      vn_up($AO, $F, hg, lo2, hi2, True{}, k, incl, Bool.not(higher))
    case False{}:
      vn_up($AO, $F, hg, lo2, hi2, False{}, k, incl, higher)

