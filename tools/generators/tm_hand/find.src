import Base
import ../lib/logic.bend as L
import ../lib/order.bend as O
import ../spec/common.bend as SC
import ../spec/tree_map.bend as S
import ../../src/containers/balanced_search_tree.bend as M
import ./state.bend as ST
import ./ord.bend as OR
import ./tree.bend as TR

# The ghost search finds the specification's value: over a subtree whose
# nodes link as the ghost tree says, have values, and list their entries in
# key order, the payload at the id the search returns is the lookup of the
# key in the subtree's entries. (source: tools/generators/tm_hand/find.src)

%def ND M.Node<K>
%def E M.Entry<K, V>
%def ES List<&2, M.Entry<K, V>>
%def MV Maybe<&2, V>
%def NL List<&2, $ND>
%def PL List<&2, $MV>
%def TK ~K: Data, ~V: Data, ~cmp: K -> K -> Cmp
%def TO ~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, ~o: O.Order(~K, ~cmp)
%def AK ~K, ~V, ~cmp
%def AO ~K, ~V, ~cmp, ~o
%def ENTS(ix) ST.ents(~K, ~V, ix, nl, pl)
%def ORD(x) {ST.ordered(~K, ~V, ~cmp, x) == True{} : Bool}
%def APP(a, b) SC.append($E, a, b)
%def ENT(x, m) ST.ent(K, V, x, m)

def sfound(s: M.Search) -> Nat:
  match s:
    case M.Search{+f, p, lf}:
      f

def cons_m_app(-X: Data, +m: Maybe<&2, X>, +xs: List<&2, X>, +ys: List<&2, X>) -> {SC.append(X, ST.cons_m(X, m, xs), ys) == ST.cons_m(X, m, SC.append(X, xs, ys)) : List<&2, X>}:
  match m:
    case None{}:
      {==}
    case Some{x}:
      {==}

def ents_app(~K: Data, ~V: Data, +xs: List<&2, Nat>, +ys: List<&2, Nat>, +nl: $NL, +pl: $PL) -> {$ENTS(SC.append(Nat, xs, ys)) == $APP($ENTS(xs), $ENTS(ys)) : $ES}:
  match xs:
    case Nil{}:
      {==}
    case Con{+i, +t}:
      %Equal.sym($ES, $APP(ST.cons_m($E, $ENT(ST.nd(K, nl, i), ST.pv(V, pl, i)), $ENTS(t)), $ENTS(ys)), ST.cons_m($E, $ENT(ST.nd(K, nl, i), ST.pv(V, pl, i)), $APP($ENTS(t), $ENTS(ys))), cons_m_app($E, $ENT(ST.nd(K, nl, i), ST.pv(V, pl, i)), $ENTS(t), $ENTS(ys))) : {ST.cons_m($E, $ENT(ST.nd(K, nl, i), ST.pv(V, pl, i)), $ENTS(SC.append(Nat, t, ys))) == _ : $ES}
      %Equal.sym($ES, $ENTS(SC.append(Nat, t, ys)), $APP($ENTS(t), $ENTS(ys)), ents_app(~K, ~V, t, ys, nl, pl)) : {ST.cons_m($E, $ENT(ST.nd(K, nl, i), ST.pv(V, pl, i)), _) == ST.cons_m($E, $ENT(ST.nd(K, nl, i), ST.pv(V, pl, i)), $APP($ENTS(t), $ENTS(ys))) : $ES}
      {==}

def ord_app_l($TK, +xs: $ES, +ys: $ES, +h: $ORD($APP(xs, ys))) -> $ORD(xs):
  match xs:
    case Nil{}:
      {==}
    case Con{+e, +t}:
      match t:
        case Nil{}:
          {==}
        case Con{+e2, +u}:
          L.and_intro(Cmp.is_lt(cmp(S.key(K, V, e), S.key(K, V, e2))), ST.ordered($AK, Con{e2, u}), L.and_left(Cmp.is_lt(cmp(S.key(K, V, e), S.key(K, V, e2))), ST.ordered($AK, Con{e2, $APP(u, ys)}), h), ord_app_l($AK, Con{e2, u}, ys, L.and_right(Cmp.is_lt(cmp(S.key(K, V, e), S.key(K, V, e2))), ST.ordered($AK, Con{e2, $APP(u, ys)}), h)))

def ord_cons_m($TK, +m: Maybe<&2, $E>, +t: $ES, +h: $ORD(ST.cons_m($E, m, t))) -> $ORD(t):
  match m:
    case None{}:
      h
    case Some{+e}:
      OR.ord_tail($AK, e, t, h)

%def TS(t, p, lf) TR.tsearch($AK, t, nl, k, p, lf)
%def FIND(es) S.find($AK, k, es)
%def EL $ENTS(ST.ids(tl))
%def ER $ENTS(ST.ids(tr))

def tf_c($TO, +nl: $NL, +pl: $PL, +i: Nat, +tl: ST.Tr, +tr: ST.Tr, +p: Nat, +left: Bool, +k: K, +key: K, +v: V, +hpi: {ST.pv(V, pl, i) == Some{v} : $MV}, +ho: $ORD($APP($EL, Con{M.Entry{key, v}, $ER})), +ihl: {ST.pv(V, pl, sfound($TS(tl, i, True{}))) == $FIND($EL) : $MV}, +ihr: {ST.pv(V, pl, sfound($TS(tr, i, False{}))) == $FIND($ER) : $MV}, +cc: Cmp, +hcc: {cmp(k, key) == cc : Cmp}) -> {ST.pv(V, pl, sfound(TR.pk3(M.Search, cc, $TS(tl, i, True{}), $TS(tr, i, False{}), M.Search{i, p, left}))) == $FIND($APP($EL, Con{M.Entry{key, v}, $ER})) : $MV}:
  match cc:
    case LT{}:
      %Equal.sym(Maybe<&2, $E>, S.find_e($AK, k, $APP($EL, Con{M.Entry{key, v}, $ER})), S.find_e($AK, k, $EL), OR.find_mid_lt($AO, k, $EL, M.Entry{key, v}, $ER, ho, hcc)) : {ST.pv(V, pl, sfound($TS(tl, i, True{}))) == S.val_m(K, V, _) : $MV}
      ihl
    case GT{}:
      %Equal.sym(Maybe<&2, $E>, S.find_e($AK, k, $APP($EL, Con{M.Entry{key, v}, $ER})), S.find_e($AK, k, $ER), OR.find_mid_gt($AO, k, $EL, M.Entry{key, v}, $ER, ho, hcc)) : {ST.pv(V, pl, sfound($TS(tr, i, False{}))) == S.val_m(K, V, _) : $MV}
      ihr
    case EQ{}:
      %Equal.sym(Maybe<&2, $E>, S.find_e($AK, k, $APP($EL, Con{M.Entry{key, v}, $ER})), Some{M.Entry{key, v}}, OR.find_mid_eq($AO, k, $EL, M.Entry{key, v}, $ER, ho, hcc)) : {ST.pv(V, pl, i) == S.val_m(K, V, _) : $MV}
      hpi

def tf_node($TO, +nl: $NL, +pl: $PL, +i: Nat, +tl: ST.Tr, +tr: ST.Tr, +p: Nat, +left: Bool, +k: K, +x: $ND, +m: $MV, +hx: {ST.is_node(K, x, ST.rid(tl), ST.rid(tr), p) == True{} : Bool}, +hm: {ST.some2(V, m) == True{} : Bool}, +hpi: {ST.pv(V, pl, i) == m : $MV}, +ho: $ORD($APP($EL, ST.cons_m($E, $ENT(x, m), $ER))), +ihl: {ST.pv(V, pl, sfound($TS(tl, i, True{}))) == $FIND($EL) : $MV}, +ihr: {ST.pv(V, pl, sfound($TS(tr, i, False{}))) == $FIND($ER) : $MV}) -> {ST.pv(V, pl, sfound(TR.pk3(M.Search, TR.kc(~K, ~cmp, k, x), $TS(tl, i, True{}), $TS(tr, i, False{}), M.Search{i, p, left}))) == $FIND($APP($EL, ST.cons_m($E, $ENT(x, m), $ER))) : $MV}:
  match x m:
    case M.Free{fx} _:
      Empty.absurd({ST.pv(V, pl, sfound(TR.pk3(M.Search, EQ{}, $TS(tl, i, True{}), $TS(tr, i, False{}), M.Search{i, p, left}))) == $FIND($APP($EL, ST.cons_m($E, $ENT(M.Free{fx}, m), $ER))) : $MV}, L.false_true(hx))
    case M.N{c, a, b, q, +key} None{}:
      Empty.absurd({ST.pv(V, pl, sfound(TR.pk3(M.Search, cmp(k, key), $TS(tl, i, True{}), $TS(tr, i, False{}), M.Search{i, p, left}))) == $FIND($APP($EL, ST.cons_m($E, $ENT(M.N{c, a, b, q, key}, None{}), $ER))) : $MV}, L.false_true(hm))
    case M.N{c, a, b, q, +key} Some{+v}:
      tf_c($AO, nl, pl, i, tl, tr, p, left, k, key, v, hpi, ho, ihl, ihr, cmp(k, key), {==})

%def REP(t, p) {ST.rep(~K, t, p, nl) == True{} : Bool}
%def PAY(t) {ST.pay(~V, t, pl) == True{} : Bool}

def pay_parts(~V: Data, +i: Nat, +tl: ST.Tr, +tr: ST.Tr, +pl: $PL, +h: $PAY(ST.TN{i, tl, tr})) -> {ST.some2(V, ST.pv(V, pl, i)) == True{} : Bool} & ($PAY(tl) & $PAY(tr)):
  +h2 = L.and_right(ST.some2(V, ST.pv(V, pl, i)), Bool.and(ST.pay(~V, tl, pl), ST.pay(~V, tr, pl)), h)
  (L.and_left(ST.some2(V, ST.pv(V, pl, i)), Bool.and(ST.pay(~V, tl, pl), ST.pay(~V, tr, pl)), h), (L.and_left(ST.pay(~V, tl, pl), ST.pay(~V, tr, pl), h2), L.and_right(ST.pay(~V, tl, pl), ST.pay(~V, tr, pl), h2)))

def pay_node(~V: Data, +i: Nat, +tl: ST.Tr, +tr: ST.Tr, +pl: $PL, +h: $PAY(ST.TN{i, tl, tr})) -> {ST.some2(V, ST.pv(V, pl, i)) == True{} : Bool}:
  L.and_left(ST.some2(V, ST.pv(V, pl, i)), Bool.and(ST.pay(~V, tl, pl), ST.pay(~V, tr, pl)), h)

def pay_l(~V: Data, +i: Nat, +tl: ST.Tr, +tr: ST.Tr, +pl: $PL, +h: $PAY(ST.TN{i, tl, tr})) -> $PAY(tl):
  L.and_left(ST.pay(~V, tl, pl), ST.pay(~V, tr, pl), L.and_right(ST.some2(V, ST.pv(V, pl, i)), Bool.and(ST.pay(~V, tl, pl), ST.pay(~V, tr, pl)), h))

def pay_r(~V: Data, +i: Nat, +tl: ST.Tr, +tr: ST.Tr, +pl: $PL, +h: $PAY(ST.TN{i, tl, tr})) -> $PAY(tr):
  L.and_right(ST.pay(~V, tl, pl), ST.pay(~V, tr, pl), L.and_right(ST.some2(V, ST.pv(V, pl, i)), Bool.and(ST.pay(~V, tl, pl), ST.pay(~V, tr, pl)), h))

%def NI $ENT(ST.nd(K, nl, i), ST.pv(V, pl, i))

# the entries of a node's subtree: the left ones, its own, the right ones
def ents_node(~K: Data, ~V: Data, +nl: $NL, +pl: $PL, +i: Nat, +tl: ST.Tr, +tr: ST.Tr) -> {$ENTS(ST.ids(ST.TN{i, tl, tr})) == $APP($EL, ST.cons_m($E, $NI, $ER)) : $ES}:
  ents_app(~K, ~V, ST.ids(tl), Con{i, ST.ids(tr)}, nl, pl)

# the value at the ghost search's id is the lookup of the key
def tfind($TO, +nl: $NL, +pl: $PL, +t: ST.Tr, +p: Nat, +left: Bool, +k: K, +hr: $REP(t, p), +hp: $PAY(t), +ho: $ORD($ENTS(ST.ids(t)))) -> {ST.pv(V, pl, sfound($TS(t, p, left))) == $FIND($ENTS(ST.ids(t))) : $MV}:
  match t:
    case ST.TE{}:
      {==}
    case ST.TN{+i, +tl, +tr}:
      +ho2 = L.subst($ES, z => $ORD(z), $ENTS(ST.ids(ST.TN{i, tl, tr})), $APP($EL, ST.cons_m($E, $NI, $ER)), ents_node(~K, ~V, nl, pl, i, tl, tr), ho)
      +ihl = tfind($AO, nl, pl, tl, i, True{}, k, TR.rep_l(~K, i, tl, tr, p, nl, hr), pay_l(~V, i, tl, tr, pl, hp), ord_app_l($AK, $EL, ST.cons_m($E, $NI, $ER), ho2))
      +ihr = tfind($AO, nl, pl, tr, i, False{}, k, TR.rep_r(~K, i, tl, tr, p, nl, hr), pay_r(~V, i, tl, tr, pl, hp), ord_cons_m($AK, $NI, $ER, OR.ord_app_r($AK, $EL, ST.cons_m($E, $NI, $ER), ho2)))
      %Equal.sym($ES, $ENTS(ST.ids(ST.TN{i, tl, tr})), $APP($EL, ST.cons_m($E, $NI, $ER)), ents_node(~K, ~V, nl, pl, i, tl, tr)) : {ST.pv(V, pl, sfound($TS(ST.TN{i, tl, tr}, p, left))) == $FIND(_) : $MV}
      tf_node($AO, nl, pl, i, tl, tr, p, left, k, ST.nd(K, nl, i), ST.pv(V, pl, i), TR.rep_node(~K, i, tl, tr, p, nl, hr), pay_node(~V, i, tl, tr, pl, hp), {==}, ho2, ihl, ihr)
