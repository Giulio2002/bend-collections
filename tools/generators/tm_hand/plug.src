import Base
import ../lib/logic.bend as L
import ../lib/list.bend as LL
import ../spec/common.bend as SC
import ../../src/containers/balanced_search_tree.bend as M
import ./state.bend as ST
import ./path.bend as P

# A path plugged with a subtree: the tree it leads through. Its ids are the
# ids before, the subtree's, and after; it links as the ghost says when the
# subtree does below the path's parent and the path's frames do.
# (source: tools/generators/tm_hand/plug.src)

%def ND M.Node<K>
%def NL List<&2, $ND>
%def LN List<&2, Nat>
%def APP(a, b) SC.append(Nat, a, b)
%def IDS(t) ST.ids(t)
%def TN(i, a, b) ST.TN{i, a, b}
%def CT List<&2, P.Fr>
%def WH(c, t) $APP(P.before(c), $APP($IDS(t), P.after(c)))
%def REP(t, p) {ST.rep(~K, t, p, nl) == True{} : Bool}
%def COK(c, x) {P.ctxok(~K, c, x, nl) == True{} : Bool}

def plug(c: $CT, t: ST.Tr) -> ST.Tr:
  match c:
    case Nil{}:
      t
    case Con{f, u}:
      match f:
        case P.FR{+p, +lft, s}:
          match lft:
            case True{}:
              plug(u, $TN(p, t, s))
            case False{}:
              plug(u, $TN(p, s, t))

def ids_plug(+c: $CT, +t: ST.Tr) -> {$IDS(plug(c, t)) == $WH(c, t) : $LN}:
  match c:
    case Nil{}:
      Equal.sym($LN, $APP($IDS(t), Nil{}), $IDS(t), LL.append_nil(Nat, $IDS(t)))
    case Con{P.FR{+p, +lft, +s}, +u}:
      match lft:
        case True{}:
          Equal.trans($LN, $IDS(plug(u, $TN(p, t, s))), $WH(u, $TN(p, t, s)), $WH(Con{P.FR{p, True{}, s}, u}, t), ids_plug(u, $TN(p, t, s)), P.ids_l(u, p, t, s))
        case False{}:
          Equal.trans($LN, $IDS(plug(u, $TN(p, s, t))), $WH(u, $TN(p, s, t)), $WH(Con{P.FR{p, False{}, s}, u}, t), ids_plug(u, $TN(p, s, t)), P.ids_r(u, p, s, t))

%def ANDI(a, b, ha, hb) L.and_intro(a, b, ha, hb)

# the plugged tree links when the subtree and the path do
def rep_plug(~K: Data, +nl: $NL, +c: $CT, +t: ST.Tr, +hr: $REP(t, P.top(c)), +hc: $COK(c, ST.rid(t))) -> $REP(plug(c, t), 0n):
  match c:
    case Nil{}:
      hr
    case Con{P.FR{+p, +lft, +s}, +u}:
      match lft:
        case True{}:
          +hk = L.and_left(P.cok1(~K, P.FR{p, True{}, s}, ST.rid(t), P.top(u), nl), P.ctxok(~K, u, p, nl), hc)
          +hu = L.and_right(P.cok1(~K, P.FR{p, True{}, s}, ST.rid(t), P.top(u), nl), P.ctxok(~K, u, p, nl), hc)
          +h0 = L.and_left(Nat.is_lt(0n, p), Bool.and(ST.is_node(K, ST.nd(K, nl, p), ST.rid(t), ST.rid(s), P.top(u)), ST.rep(~K, s, p, nl)), hk)
          +h12 = L.and_right(Nat.is_lt(0n, p), Bool.and(ST.is_node(K, ST.nd(K, nl, p), ST.rid(t), ST.rid(s), P.top(u)), ST.rep(~K, s, p, nl)), hk)
          +hn = L.and_left(ST.is_node(K, ST.nd(K, nl, p), ST.rid(t), ST.rid(s), P.top(u)), ST.rep(~K, s, p, nl), h12)
          +hs = L.and_right(ST.is_node(K, ST.nd(K, nl, p), ST.rid(t), ST.rid(s), P.top(u)), ST.rep(~K, s, p, nl), h12)
          rep_plug(~K, nl, u, $TN(p, t, s), $ANDI(Nat.is_lt(0n, p), Bool.and(ST.is_node(K, ST.nd(K, nl, p), ST.rid(t), ST.rid(s), P.top(u)), Bool.and(ST.rep(~K, t, p, nl), ST.rep(~K, s, p, nl))), h0, $ANDI(ST.is_node(K, ST.nd(K, nl, p), ST.rid(t), ST.rid(s), P.top(u)), Bool.and(ST.rep(~K, t, p, nl), ST.rep(~K, s, p, nl)), hn, $ANDI(ST.rep(~K, t, p, nl), ST.rep(~K, s, p, nl), hr, hs))), hu)
        case False{}:
          +hk = L.and_left(P.cok1(~K, P.FR{p, False{}, s}, ST.rid(t), P.top(u), nl), P.ctxok(~K, u, p, nl), hc)
          +hu = L.and_right(P.cok1(~K, P.FR{p, False{}, s}, ST.rid(t), P.top(u), nl), P.ctxok(~K, u, p, nl), hc)
          +h0 = L.and_left(Nat.is_lt(0n, p), Bool.and(ST.is_node(K, ST.nd(K, nl, p), ST.rid(s), ST.rid(t), P.top(u)), ST.rep(~K, s, p, nl)), hk)
          +h12 = L.and_right(Nat.is_lt(0n, p), Bool.and(ST.is_node(K, ST.nd(K, nl, p), ST.rid(s), ST.rid(t), P.top(u)), ST.rep(~K, s, p, nl)), hk)
          +hn = L.and_left(ST.is_node(K, ST.nd(K, nl, p), ST.rid(s), ST.rid(t), P.top(u)), ST.rep(~K, s, p, nl), h12)
          +hs = L.and_right(ST.is_node(K, ST.nd(K, nl, p), ST.rid(s), ST.rid(t), P.top(u)), ST.rep(~K, s, p, nl), h12)
          rep_plug(~K, nl, u, $TN(p, s, t), $ANDI(Nat.is_lt(0n, p), Bool.and(ST.is_node(K, ST.nd(K, nl, p), ST.rid(s), ST.rid(t), P.top(u)), Bool.and(ST.rep(~K, s, p, nl), ST.rep(~K, t, p, nl))), h0, $ANDI(ST.is_node(K, ST.nd(K, nl, p), ST.rid(s), ST.rid(t), P.top(u)), Bool.and(ST.rep(~K, s, p, nl), ST.rep(~K, t, p, nl)), hn, $ANDI(ST.rep(~K, s, p, nl), ST.rep(~K, t, p, nl), hs, hr))), hu)
