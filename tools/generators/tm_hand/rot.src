# ---- the right rotation: the rotated subtree ----

%def P1 $APP($IA, Con{y, $IB})
%def SR $APP($P1, Con{x, $IC})
%def M5 RM.rotr_nl(K, nl, x, y, ST.rid(tb), q, dir)

def rotr_rep($TO, +nl: $NL, +x: Nat, +y: Nat, +ta: ST.Tr, +tb: ST.Tr, +tc: ST.Tr, +q: Nat, +dir: Bool, +h0x: $LT0(x), +h0y: $LT0(y), +hxn: $ISN($NDX(nl, x), y, ST.rid(tc), q), +hyn: $ISN($NDX(nl, y), ST.rid(ta), ST.rid(tb), x), +hA: $REP(ta, y), +hB: $REP(tb, y), +hC: $REP(tc, x), +hS: $NDL($SR), +hqS: $NMEM(q, $SR)) -> $REPN($TN(y, ta, $TN(x, tb, tc)), q, $M5):
  match tb:
    case ST.TE{}:
      +hP1 = DJ.ndl($APP($IA, Con{y, Nil{}}), Con{x, $IC}, hS)
      +xIC = DJ.nd_head(x, $IC, DJ.ndr($APP($IA, Con{y, Nil{}}), Con{x, $IC}, hS))
      +xP1 = DJ.dj_l($APP($IA, Con{y, Nil{}}), Con{x, $IC}, hS, x, DJ.mem_hd(x, $IC))
      +xIA = DJ.nm_l(x, $IA, Con{y, Nil{}}, xP1)
      +nyx = DJ.nm_ch(x, y, Nil{}, DJ.nm_r(x, $IA, Con{y, Nil{}}, xP1))
      +myP1 = DJ.mem_r(y, $IA, Con{y, Nil{}}, DJ.mem_hd(y, Nil{}))
      +yxc = DJ.dj_r($APP($IA, Con{y, Nil{}}), Con{x, $IC}, hS, y, myP1)
      +nxy = DJ.nm_ch(y, x, $IC, yxc)
      +yIC = DJ.nm_ct(y, x, $IC, yxc)
      +yIA = DJ.dj_l($IA, Con{y, Nil{}}, hP1, y, DJ.mem_hd(y, Nil{}))
      +mx = DJ.mem_r(x, $APP($IA, Con{y, Nil{}}), Con{x, $IC}, DJ.mem_hd(x, $IC))
      +my = DJ.mem_l(y, $APP($IA, Con{y, Nil{}}), Con{x, $IC}, myP1)
      +nqx = DJ.ne_nm(q, x, $APP($APP($IA, Con{y, Nil{}}), Con{x, $IC}), hqS, mx)
      +nqy = DJ.ne_nm(q, y, $APP($APP($IA, Con{y, Nil{}}), Con{x, $IC}), hqS, my)
      +qP1 = DJ.nm_l(q, $APP($IA, Con{y, Nil{}}), Con{x, $IC}, hqS)
      +qIA = DJ.nm_l(q, $IA, Con{y, Nil{}}, qP1)
      +qIC = DJ.nm_ct(q, x, $IC, DJ.nm_r(q, $APP($IA, Con{y, Nil{}}), Con{x, $IC}, hqS))
      +agA = RN.rotr_agr($AO, $IA, nl, x, y, 0n, q, dir, xIA, yIA, zero_ids(~K, nl, ta, y, hA), qIA)
      +agC = RN.rotr_agr($AO, $IC, nl, x, y, 0n, q, dir, xIC, yIC, zero_ids(~K, nl, tc, x, hC), qIC)
      +rx = RN.rotr_x(K, nl, x, y, 0n, q, dir, ST.rid(tc), hxn, nyx, nqx, ne0(x, h0x))
      +ry = RN.rotr_y(K, nl, x, y, 0n, q, dir, ST.rid(ta), hyn, nxy, nqy, ne0(y, h0y))
      rep_intro(~K, RM.rotr_nl(K, nl, x, y, 0n, q, dir), y, ta, $TN(x, ST.TE{}, tc), q, h0y, ry, rep_moved($AO, ta, y, nl, RM.rotr_nl(K, nl, x, y, 0n, q, dir), agA, hA), rep_intro(~K, RM.rotr_nl(K, nl, x, y, 0n, q, dir), x, ST.TE{}, tc, y, h0x, rx, {==}, rep_moved($AO, tc, x, nl, RM.rotr_nl(K, nl, x, y, 0n, q, dir), agC, hC)))
    case ST.TN{+b, +b1, +b2}:
      +hP1 = DJ.ndl($P1, Con{x, $IC}, hS)
      +xIC = DJ.nd_head(x, $IC, DJ.ndr($P1, Con{x, $IC}, hS))
      +xP1 = DJ.dj_l($P1, Con{x, $IC}, hS, x, DJ.mem_hd(x, $IC))
      +xIA = DJ.nm_l(x, $IA, Con{y, $IB}, xP1)
      +xyb = DJ.nm_r(x, $IA, Con{y, $IB}, xP1)
      +nyx = DJ.nm_ch(x, y, $IB, xyb)
      +xIB = DJ.nm_ct(x, y, $IB, xyb)
      +myP1 = DJ.mem_r(y, $IA, Con{y, $IB}, DJ.mem_hd(y, $IB))
      +yxc = DJ.dj_r($P1, Con{x, $IC}, hS, y, myP1)
      +nxy = DJ.nm_ch(y, x, $IC, yxc)
      +yIC = DJ.nm_ct(y, x, $IC, yxc)
      +yIA = DJ.dj_l($IA, Con{y, $IB}, hP1, y, DJ.mem_hd(y, $IB))
      +hYB = DJ.ndr($IA, Con{y, $IB}, hP1)
      +yIB = DJ.nd_head(y, $IB, hYB)
      +mbIB = DJ.mem_r(b, $IDS(b1), Con{b, $IDS(b2)}, DJ.mem_hd(b, $IDS(b2)))
      +mbP1 = DJ.mem_r(b, $IA, Con{y, $IB}, DJ.mem_tl(b, y, $IB, mbIB))
      +mx = DJ.mem_r(x, $P1, Con{x, $IC}, DJ.mem_hd(x, $IC))
      +my = DJ.mem_l(y, $P1, Con{x, $IC}, myP1)
      +mb = DJ.mem_l(b, $P1, Con{x, $IC}, mbP1)
      +nyb = DJ.ne_nm(y, b, $IB, yIB, mbIB)
      +bIA = DJ.dj_l($IA, Con{y, $IB}, hP1, b, DJ.mem_tl(b, y, $IB, mbIB))
      +bxc = DJ.dj_r($P1, Con{x, $IC}, hS, b, mbP1)
      +nxb = DJ.nm_ch(b, x, $IC, bxc)
      +bIC = DJ.nm_ct(b, x, $IC, bxc)
      +nqx = DJ.ne_nm(q, x, $SR, hqS, mx)
      +nqy = DJ.ne_nm(q, y, $SR, hqS, my)
      +nqb = DJ.ne_nm(q, b, $SR, hqS, mb)
      +qP1 = DJ.nm_l(q, $P1, Con{x, $IC}, hqS)
      +qIA = DJ.nm_l(q, $IA, Con{y, $IB}, qP1)
      +qIB = DJ.nm_ct(q, y, $IB, DJ.nm_r(q, $IA, Con{y, $IB}, qP1))
      +qIC = DJ.nm_ct(q, x, $IC, DJ.nm_r(q, $P1, Con{x, $IC}, hqS))
      +hIB = DJ.nd_tail(y, $IB, hYB)
      +bB1 = DJ.dj_l($IDS(b1), Con{b, $IDS(b2)}, hIB, b, DJ.mem_hd(b, $IDS(b2)))
      +bB2 = DJ.nd_head(b, $IDS(b2), DJ.ndr($IDS(b1), Con{b, $IDS(b2)}, hIB))
      +xB1 = DJ.nm_l(x, $IDS(b1), Con{b, $IDS(b2)}, xIB)
      +xB2 = DJ.nm_ct(x, b, $IDS(b2), DJ.nm_r(x, $IDS(b1), Con{b, $IDS(b2)}, xIB))
      +yB1 = DJ.nm_l(y, $IDS(b1), Con{b, $IDS(b2)}, yIB)
      +yB2 = DJ.nm_ct(y, b, $IDS(b2), DJ.nm_r(y, $IDS(b1), Con{b, $IDS(b2)}, yIB))
      +qB1 = DJ.nm_l(q, $IDS(b1), Con{b, $IDS(b2)}, qIB)
      +qB2 = DJ.nm_ct(q, b, $IDS(b2), DJ.nm_r(q, $IDS(b1), Con{b, $IDS(b2)}, qIB))
      +agA = RN.rotr_agr($AO, $IA, nl, x, y, b, q, dir, xIA, yIA, bIA, qIA)
      +agC = RN.rotr_agr($AO, $IC, nl, x, y, b, q, dir, xIC, yIC, bIC, qIC)
      +agB1 = RN.rotr_agr($AO, $IDS(b1), nl, x, y, b, q, dir, xB1, yB1, bB1, qB1)
      +agB2 = RN.rotr_agr($AO, $IDS(b2), nl, x, y, b, q, dir, xB2, yB2, bB2, qB2)
      +h0b = L.and_left(Nat.is_lt(0n, b), Bool.and(ST.is_node(K, ST.nd(K, nl, b), ST.rid(b1), ST.rid(b2), y), Bool.and(ST.rep(~K, b1, b, nl), ST.rep(~K, b2, b, nl))), hB)
      +rx = RN.rotr_x(K, nl, x, y, b, q, dir, ST.rid(tc), hxn, nyx, nqx, $NESY(x, b, nxb))
      +ry = RN.rotr_y(K, nl, x, y, b, q, dir, ST.rid(ta), hyn, nxy, nqy, $NESY(y, b, nyb))
      +rb = RN.rotr_b(K, nl, x, y, b, q, dir, ST.rid(b1), ST.rid(b2), TR.rep_node(~K, b, b1, b2, y, nl, hB), nxb, nyb, nqb)
      +repB = rep_intro(~K, $M5, b, b1, b2, x, h0b, rb, rep_moved($AO, b1, b, nl, $M5, agB1, TR.rep_l(~K, b, b1, b2, y, nl, hB)), rep_moved($AO, b2, b, nl, $M5, agB2, TR.rep_r(~K, b, b1, b2, y, nl, hB)))
      rep_intro(~K, $M5, y, ta, $TN(x, $TN(b, b1, b2), tc), q, h0y, ry, rep_moved($AO, ta, y, nl, $M5, agA, hA), rep_intro(~K, $M5, x, $TN(b, b1, b2), tc, y, h0x, rx, repB, rep_moved($AO, tc, x, nl, $M5, agC, hC)))

# ---- the right rotation: the path ----

%def NCR RM.rotr_nl(K, nl, x, y, b, P.top(c), SP.dir(c))
%def NR(i, lft) RM.rotr_nl(K, nl, x, y, b, 1n+i, lft)

def ctx_frame_r($TO, +nl: $NL, +x: Nat, +y: Nat, +b: Nat, +i: Nat, +lft: Bool, +s: ST.Tr, +u: $CT, +hok: $COK($FRC(1n+i, lft, s, u), x), +hx: $NMEM(x, $BA($FRC(1n+i, lft, s, u))), +hy: $NMEM(y, $BA($FRC(1n+i, lft, s, u))), +hb: $NMEM(b, $BA($FRC(1n+i, lft, s, u))), +hBA: $NDL($BA($FRC(1n+i, lft, s, u))), +mq: {NL.memn(1n+i, $BA($FRC(1n+i, lft, s, u))) == True{} : Bool}) -> $COKN($FRC(1n+i, lft, s, u), y, $NR(i, lft)):
  +hk = L.and_left($CK(i, lft, s, u), P.ctxok(~K, u, 1n+i, nl), hok)
