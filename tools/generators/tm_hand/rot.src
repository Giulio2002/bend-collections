def rotl_ctx($TO, +nl: $NL, +c: $CT, +x: Nat, +y: Nat, +b: Nat, +hok: $COK(c, x), +hx: $NMEM(x, $BA(c)), +hy: $NMEM(y, $BA(c)), +hb: $NMEM(b, $BA(c)), +hBA: $NDL($BA(c))) -> $COKN(c, y, $NC):
  match c:
    case Nil{}:
      {==}
    case Con{P.FR{0n, +lft, +s}, +u}:
      Empty.absurd($COKN($FRC(0n, lft, s, u), y, RM.rotl_nl(K, nl, x, y, b, 0n, lft)), L.false_true(L.and_left(Nat.is_lt(0n, 0n), Bool.and(ST.is_node(K, ST.nd(K, nl, 0n), ST.pk(Nat, lft, x, ST.rid(s)), ST.pk(Nat, lft, ST.rid(s), x), P.top(u)), ST.rep(~K, s, 0n, nl)), L.and_left(P.cok1(~K, P.FR{0n, lft, s}, x, P.top(u), nl), P.ctxok(~K, u, 0n, nl), hok))))
    case Con{P.FR{1n+i, True{}, +s}, +u}:
      ctx_frame($AO, nl, x, y, b, i, True{}, s, u, hok, hx, hy, hb, hBA, DJ.mem_r(1n+i, P.before(u), Con{1n+i, $APP($IDS(s), P.after(u))}, DJ.mem_hd(1n+i, $APP($IDS(s), P.after(u)))))
    case Con{P.FR{1n+i, False{}, +s}, +u}:
