  +h0 = L.and_left(Nat.is_lt(0n, 1n+i), Bool.and($NODEQ(i, lft, s, u), ST.rep(~K, s, 1n+i, nl)), hk)
  +hqn = L.and_left($NODEQ(i, lft, s, u), ST.rep(~K, s, 1n+i, nl), L.and_right(Nat.is_lt(0n, 1n+i), Bool.and($NODEQ(i, lft, s, u), ST.rep(~K, s, 1n+i, nl)), hk))
  +hs = L.and_right($NODEQ(i, lft, s, u), ST.rep(~K, s, 1n+i, nl), L.and_right(Nat.is_lt(0n, 1n+i), Bool.and($NODEQ(i, lft, s, u), ST.rep(~K, s, 1n+i, nl)), hk))
  +nxq = DJ.ne_nm(x, 1n+i, $BA($FRC(1n+i, lft, s, u)), hx, mq)
  +nyq = DJ.ne_nm(y, 1n+i, $BA($FRC(1n+i, lft, s, u)), hy, mq)
  +nbq = DJ.ne_nm(b, 1n+i, $BA($FRC(1n+i, lft, s, u)), hb, mq)
