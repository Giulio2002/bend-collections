def rotr_ctx($TO, +nl: $NL, +c: $CT, +x: Nat, +y: Nat, +b: Nat, +hok: $COK(c, x), +hx: $NMEM(x, $BA(c)), +hy: $NMEM(y, $BA(c)), +hb: $NMEM(b, $BA(c)), +hBA: $NDL($BA(c))) -> $COKN(c, y, $NCR):
  match c:
    case Nil{}:
      {==}
    case Con{P.FR{0n, +lft, +s}, +u}:
