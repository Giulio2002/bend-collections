  +agU = RN.rotr_agr($AO, $BA(u), nl, x, y, b, 1n+i, lft, $FWU(x, i, lft, s, u, hx), $FWU(y, i, lft, s, u, hy), $FWU(b, i, lft, s, u, hb), $FQU(i, lft, s, u))
