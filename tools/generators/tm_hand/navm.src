import Base
import ../lib/logic.bend as L
import ../lib/nat.bend as N
import ../lib/list.bend as LL
import ../lib/order.bend as O
import ../spec/common.bend as SC
import ../spec/tree_map.bend as S
import ../../src/containers/balanced_search_tree.bend as M
import ./nbr.bend as NB
import ./state.bend as ST
import ./mirror.bend as MI
import ./tree.bend as TR
import ./find.bend as FI
import ./reads.bend as RD
import ./ends.bend as EN
import ./path.bend as P
import ./nav.bend as NV
import ./navs.bend as NS
import ../lib/nat_list.bend as NL

# Navigation over a good shadow: navigate is the ghost navigation from the
# root with an empty path, so the entry (and the key) at its id is the
# specification's nav. (source: tools/generators/tm_hand/navm.src)

%def ND M.Node<K>
%def E M.Entry<K, V>
%def ES List<&2, M.Entry<K, V>>
%def ME Maybe<&2, M.Entry<K, V>>
%def MV Maybe<&2, V>
%def NLT List<&2, $ND>
%def PLT List<&2, $MV>
%def LN List<&2, Nat>
%def APP(a, b) SC.append(Nat, a, b)
%def IDS(t) ST.ids(t)
%def TN(i, a, b) ST.TN{i, a, b}
%def CT List<&2, P.Fr>
%def PK(fw, a, b) ST.pk(Nat, fw, a, b)
%def TK ~K: Data, ~V: Data, ~cmp: K -> K -> Cmp
%def TO ~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, ~o: O.Order(~K, ~cmp)
%def AK ~K, ~V, ~cmp
%def AO ~K, ~V, ~cmp, ~o
%def FT +n: Nat, +root: Nat, +lo: Nat, +hi: Nat, +free: Nat, +l: Nat, +d: Nat, +nl: $NLT, +pl: $PLT, +tg: ST.Tr, +fl: List<&2, Nat>
%def F n, root, lo, hi, free, l, d, nl, pl, tg, fl
%def SH ST.SH{$F}
%def SHT ST.Sh<K, V>
%def GF {ST.goodF($AK, $F) == True{} : Bool}
%def WH(c, t) $APP(P.before(c), $APP($IDS(t), P.after(c)))
%def CL(i, r, c) Con{P.FR{i, True{}, r}, c}
%def CR(i, l, c) Con{P.FR{i, False{}, l}, c}
%def ENT(x) ST.ent(K, V, ST.nd(K, nl, x), ST.pv(V, pl, x))
%def ENTS(xs) ST.ents(~K, ~V, xs, nl, pl)
%def EST $ENTS($IDS(tg))
%def OKS(xs) {EN.oks(~K, ~V, xs, nl, pl) == True{} : Bool}
%def REP(t, p) {ST.rep(~K, t, p, nl) == True{} : Bool}
%def PAY(t) {ST.pay(~V, t, pl) == True{} : Bool}
%def G0 NV.gnav(~K, ~cmp, tg, Nil{}, nl, k, h, incl)
%def AN LL.append_nil(Nat, $IDS(tg))

def navigate_m($TK, $FT, +k: K, +h: Bool, +incl: Bool, +hg: $GF) -> {MI.navigate($AK, $SH, k, h, incl) == ($SH, $G0) : $SHT & Nat}:
  +er = N.eq_from_is_eq(root, ST.rid(tg), ST.g_croot($AK, $F, hg))
  +hnd0 = NL.nd_l($IDS(tg), fl, ST.g_cnd($AK, $F, hg))
  +hnd = L.subst($LN, z => {NL.nodupn(z) == True{} : Bool}, $IDS(tg), $APP($IDS(tg), Nil{}), Equal.sym($LN, $APP($IDS(tg), Nil{}), $IDS(tg), $AN), hnd0)
  %Equal.sym(Nat, root, ST.rid(tg), er) : {MI.nav_loop($AK, 1n+n, k, h, incl, _, 0n, MI.probe($AK, $SH, _, k)) == ($SH, $G0) : $SHT & Nat}
  %Equal.sym(Nat, 0n, $PK(h, 0n, 0n), Equal.sym(Nat, $PK(h, 0n, 0n), 0n, NB.pk_same(h, 0n))) : {MI.nav_loop($AK, 1n+n, k, h, incl, ST.rid(tg), _, MI.probe($AK, $SH, ST.rid(tg), k)) == ($SH, $G0) : $SHT & Nat}
  NV.nav_ptr($AK, $F, 1n+n, Nil{}, tg, k, h, incl, ST.g_crep($AK, $F, hg), {==}, hnd, Equal.sym($LN, $APP($IDS(tg), Nil{}), $IDS(tg), $AN), N.eq_from_is_eq(n, SC.length(Nat, $IDS(tg)), ST.g_csz($AK, $F, hg)), RD.fuel_ok($AK, $F, hg))

%def OKT EN.oks_tree(~K, ~V, nl, pl, tg, 0n, ST.g_crep($AK, $F, hg), ST.g_cpay($AK, $F, hg))

# the entry at navigate's id is nav's
def gnav_ent($TO, $FT, +k: K, +h: Bool, +incl: Bool, +hg: $GF) -> {$ENT($G0) == S.nav($AK, k, h, incl, $EST) : $ME}:
  +ho = L.subst($LN, z => {ST.ordered($AK, $ENTS(z)) == True{} : Bool}, $IDS(tg), $APP($IDS(tg), Nil{}), Equal.sym($LN, $APP($IDS(tg), Nil{}), $IDS(tg), $AN), ST.g_cord($AK, $F, hg))
  +hk = L.subst($LN, z => $OKS(z), $IDS(tg), $APP($IDS(tg), Nil{}), Equal.sym($LN, $APP($IDS(tg), Nil{}), $IDS(tg), $AN), $OKT)
  %Equal.sym($LN, $IDS(tg), $APP($IDS(tg), Nil{}), Equal.sym($LN, $APP($IDS(tg), Nil{}), $IDS(tg), $AN)) : {$ENT($G0) == S.nav($AK, k, h, incl, $ENTS(_)) : $ME}
  NS.gspec($AO, nl, pl, tg, Nil{}, k, h, incl, ST.g_crep($AK, $F, hg), ST.g_cpay($AK, $F, hg), ho, hk, {==}, {==})

def nav_entry_m($TO, $FT, +k: K, +h: Bool, +incl: Bool, +hg: $GF) -> {MI.entry_snapshot($AK, MI.navigate($AK, $SH, k, h, incl)) == ($SH, S.nav($AK, k, h, incl, $EST)) : $SHT & $ME}:
  %Equal.sym($SHT & Nat, MI.navigate($AK, $SH, k, h, incl), ($SH, $G0), navigate_m($AK, $F, k, h, incl, hg)) : {MI.entry_snapshot($AK, _) == ($SH, S.nav($AK, k, h, incl, $EST)) : $SHT & $ME}
  %Equal.sym($SHT & $ME, MI.entry_snapshot($AK, ($SH, $G0)), ($SH, $ENT($G0)), EN.ev_m($AK, $F, ST.nd(K, nl, $G0), ST.pv(V, pl, $G0))) : {_ == ($SH, S.nav($AK, k, h, incl, $EST)) : $SHT & $ME}
  %Equal.sym($ME, $ENT($G0), S.nav($AK, k, h, incl, $EST), gnav_ent($AO, $F, k, h, incl, hg)) : {($SH, _) == ($SH, S.nav($AK, k, h, incl, $EST)) : $SHT & $ME}
  {==}

# ---- keys ----

%def KEQ(x) {S.key_m(K, V, $ENT(x)) == M.node_key(~K, ST.nd(K, nl, x)) : Maybe<&2, K>}

def keq_fst(~K: Data, ~V: Data, +nl: $NLT, +pl: $PLT, +xs: $LN, +h: $OKS(xs)) -> $KEQ(ST.fst0(xs)):
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      EN.km_some(K, V, ST.nd(K, nl, x), ST.pv(V, pl, x), L.and_left(S.is_some($E, $ENT(x)), EN.oks(~K, ~V, t, nl, pl), h))

def keq_last(~K: Data, ~V: Data, +nl: $NLT, +pl: $PLT, +xs: $LN, +h: $OKS(xs)) -> $KEQ(ST.last0(xs)):
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      EN.km_some(K, V, ST.nd(K, nl, ST.last0(Con{x, t})), ST.pv(V, pl, ST.last0(Con{x, t})), EN.last0_some(~K, ~V, nl, pl, t, x, h))

def keq_pk(~K: Data, ~V: Data, +nl: $NLT, +pl: $PLT, +h: Bool, +a: $LN, +b: $LN, +ha: $OKS(a), +hb: $OKS(b)) -> $KEQ($PK(h, ST.fst0(a), ST.last0(b))):
  match h:
    case True{}:
      keq_fst(~K, ~V, nl, pl, a, ha)
    case False{}:
      keq_last(~K, ~V, nl, pl, b, hb)

%def X $APP(P.before(c), $IDS(l))
%def Y $APP($IDS(r), P.after(c))
%def GNX(t, c) NV.gnav(~K, ~cmp, t, c, nl, k, h, incl)
%def WHT $WH(c, $TN(i, l, r))

def keq_eq(~K: Data, ~V: Data, +nl: $NLT, +pl: $PLT, +c: $CT, +i: Nat, +l: ST.Tr, +r: ST.Tr, +h: Bool, +incl: Bool, +hi: $KEQ(i), +hx: $OKS($X), +hy: $OKS($Y)) -> $KEQ($PK(incl, i, $PK(h, ST.fst0($Y), ST.last0($X)))):
  match incl:
    case True{}:
      hi
    case False{}:
      keq_pk(~K, ~V, nl, pl, h, $Y, $X, hy, hx)

def keq_c(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +nl: $NLT, +pl: $PLT, +c: $CT, +i: Nat, +l: ST.Tr, +r: ST.Tr, +k: K, +h: Bool, +incl: Bool, +ihl: $KEQ($GNX(l, $CL(i, r, c))), +ihr: $KEQ($GNX(r, $CR(i, l, c))), +he: $KEQ($PK(incl, i, $PK(h, ST.fst0($Y), ST.last0($X)))), +cc: Cmp) -> $KEQ(TR.pk3(Nat, cc, $GNX(l, $CL(i, r, c)), $GNX(r, $CR(i, l, c)), $PK(incl, i, $PK(h, ST.fst0($Y), ST.last0($X))))):
  match cc:
    case LT{}:
      ihl
    case GT{}:
      ihr
    case EQ{}:
      he

# the id navigation returns has a key exactly when it has an entry
def gnav_key(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +nl: $NLT, +pl: $PLT, +t: ST.Tr, +c: $CT, +k: K, +h: Bool, +incl: Bool, +hr: $REP(t, P.top(c)), +hp: $PAY(t), +hk: $OKS($WH(c, t))) -> $KEQ($GNX(t, c)):
  match t:
    case ST.TE{}:
      keq_pk(~K, ~V, nl, pl, h, P.after(c), P.before(c), NS.oks_r(~K, ~V, nl, pl, P.before(c), P.after(c), hk), NS.oks_l(~K, ~V, nl, pl, P.before(c), P.after(c), hk))
    case ST.TN{+i, +l, +r}:
      +hk2 = L.subst($LN, z => $OKS(z), $WHT, $APP($X, Con{i, $Y}), NS.wh_node(c, i, l, r), hk)
      +hx = NS.oks_l(~K, ~V, nl, pl, $X, Con{i, $Y}, hk2)
      +hy = L.and_right(S.is_some($E, $ENT(i)), EN.oks(~K, ~V, $Y, nl, pl), NS.oks_r(~K, ~V, nl, pl, $X, Con{i, $Y}, hk2))
      +hi = EN.km_some(K, V, ST.nd(K, nl, i), ST.pv(V, pl, i), EN.ent_some(K, V, ST.nd(K, nl, i), ST.pv(V, pl, i), ST.rid(l), ST.rid(r), P.top(c), TR.rep_node(~K, i, l, r, P.top(c), nl, hr), FI.pay_node(~V, i, l, r, pl, hp)))
      +ihl = gnav_key(~K, ~V, ~cmp, nl, pl, l, $CL(i, r, c), k, h, incl, TR.rep_l(~K, i, l, r, P.top(c), nl, hr), FI.pay_l(~V, i, l, r, pl, hp), L.subst($LN, z => $OKS(z), $WHT, $WH($CL(i, r, c), l), P.ids_l(c, i, l, r), hk))
      +ihr = gnav_key(~K, ~V, ~cmp, nl, pl, r, $CR(i, l, c), k, h, incl, TR.rep_r(~K, i, l, r, P.top(c), nl, hr), FI.pay_r(~V, i, l, r, pl, hp), L.subst($LN, z => $OKS(z), $WHT, $WH($CR(i, l, c), r), P.ids_r(c, i, l, r), hk))
      keq_c(~K, ~V, ~cmp, nl, pl, c, i, l, r, k, h, incl, ihl, ihr, keq_eq(~K, ~V, nl, pl, c, i, l, r, h, incl, hi, hx, hy), TR.kc(~K, ~cmp, k, ST.nd(K, nl, i)))

def nav_key_m($TO, $FT, +k: K, +h: Bool, +incl: Bool, +hg: $GF) -> {MI.key_id($AK, MI.navigate($AK, $SH, k, h, incl)) == ($SH, S.key_m(K, V, S.nav($AK, k, h, incl, $EST))) : $SHT & Maybe<&2, K>}:
  +hk = L.subst($LN, z => $OKS(z), $IDS(tg), $APP($IDS(tg), Nil{}), Equal.sym($LN, $APP($IDS(tg), Nil{}), $IDS(tg), $AN), $OKT)
  %Equal.sym($SHT & Nat, MI.navigate($AK, $SH, k, h, incl), ($SH, $G0), navigate_m($AK, $F, k, h, incl, hg)) : {MI.key_id($AK, _) == ($SH, S.key_m(K, V, S.nav($AK, k, h, incl, $EST))) : $SHT & Maybe<&2, K>}
  %Equal.sym($ME, S.nav($AK, k, h, incl, $EST), $ENT($G0), Equal.sym($ME, $ENT($G0), S.nav($AK, k, h, incl, $EST), gnav_ent($AO, $F, k, h, incl, hg))) : {($SH, M.node_key(~K, ST.nd(K, nl, $G0))) == ($SH, S.key_m(K, V, _)) : $SHT & Maybe<&2, K>}
  %Equal.sym(Maybe<&2, K>, S.key_m(K, V, $ENT($G0)), M.node_key(~K, ST.nd(K, nl, $G0)), gnav_key(~K, ~V, ~cmp, nl, pl, tg, Nil{}, k, h, incl, ST.g_crep($AK, $F, hg), ST.g_cpay($AK, $F, hg), hk)) : {($SH, M.node_key(~K, ST.nd(K, nl, $G0))) == ($SH, _) : $SHT & Maybe<&2, K>}
  {==}
