import Base
import ../lib/logic.bend as L
import ../lib/list.bend as LL
import ../spec/common.bend as SC
import ./state.bend as ST
import ./path.bend as P
import ./alls.bend as AL
import ../lib/nat_list.bend as NL


# The ids when a node with at most one child leaves the tree for the free
# chain: the tree's ids without it, the free chain with it in front; without
# repeats, in range, of the same length. (source: tools/generators/tm_hand/idmv.src)

%def ND M.Node<K>
%def LN List<&2, Nat>
%def CT List<&2, P.Fr>
%def APP(a, b) SC.append(Nat, a, b)
%def IDS(t) ST.ids(t)
%def TN(i, a, b) ST.TN{i, a, b}
%def TE ST.TE{}
%def WH(c, t) $APP(P.before(c), $APP($IDS(t), P.after(c)))
%def NDL(xs) {NL.nodupn(xs) == True{} : Bool}
%def LEN(xs) SC.length(Nat, xs)
%def ALLIN(xs, n) {ST.allin(xs, n) == True{} : Bool}
%def INB(x, n) Bool.and(Nat.is_lt(0n, x), Nat.is_le(x, n))
%def MV0 $APP($APP(b, a), Con{x, t})
%def MV1 $APP($APP(b, Con{x, a}), t)
%def U 1n+ui
%def I0 $WH(c, ch)
%def WA $WH(c, $TN($U, $TE, ch))
%def WB $WH(c, $TN($U, ch, $TE))
%def UW +flf: $LN, +c: $CT, +ui: Nat, +ch: ST.Tr
%def BC P.before(c)
%def AC P.after(c)
%def WBQ $APP($APP($BC, $IDS(ch)), Con{$U, $AC})

# ---- the ids: the node moves from the tree's ids to the free chain ----

def nd_back(+b: $LN, +a: $LN, +x: Nat, +t: $LN, +h: $NDL($MV1)) -> $NDL($MV0):
  +h1 = L.subst($LN, z => $NDL(z), $MV1, $APP(b, Con{x, $APP(a, t)}), AL.mv_eq(b, a, x, t), h)
  +h2 = L.subst(Bool, w => {w == True{} : Bool}, NL.nodupn($APP(b, Con{x, $APP(a, t)})), Bool.and(NL.nodupn($APP(b, $APP(a, t))), Bool.not(NL.memn(x, $APP(b, $APP(a, t))))), NL.nd_mid(b, x, $APP(a, t)), h1)
  +h3 = L.subst($LN, z => {Bool.and(NL.nodupn(z), Bool.not(NL.memn(x, z))) == True{} : Bool}, $APP(b, $APP(a, t)), $APP($APP(b, a), t), Equal.sym($LN, $APP($APP(b, a), t), $APP(b, $APP(a, t)), LL.append_assoc(Nat, b, a, t)), h2)
  L.subst(Bool, w => {w == True{} : Bool}, Bool.and(NL.nodupn($APP($APP(b, a), t)), Bool.not(NL.memn(x, $APP($APP(b, a), t)))), NL.nodupn($MV0), Equal.sym(Bool, NL.nodupn($MV0), Bool.and(NL.nodupn($APP($APP(b, a), t)), Bool.not(NL.memn(x, $APP($APP(b, a), t)))), NL.nd_mid($APP(b, a), x, t)), h3)

def allin_back(+b: $LN, +a: $LN, +x: Nat, +t: $LN, +n: Nat, +h: $ALLIN($MV1, n)) -> $ALLIN($MV0, n):
  +hbx = AL.allin_l($APP(b, Con{x, a}), t, n, h)
  +ht = AL.allin_r($APP(b, Con{x, a}), t, n, h)
  +hxa = AL.allin_r(b, Con{x, a}, n, hbx)
  +hx = L.and_left($INB(x, n), ST.allin(a, n), hxa)
  AL.allin_app($APP(b, a), Con{x, t}, n, AL.allin_app(b, a, n, AL.allin_l(b, Con{x, a}, n, hbx), L.and_right($INB(x, n), ST.allin(a, n), hxa)), L.and_intro($INB(x, n), ST.allin(t, n), hx, ht))

# the free chain gets the node: the ids with it moved
def mv_a($UW, +h: $NDL($APP($WA, flf))) -> $NDL($APP($I0, Con{$U, flf})):
  nd_back(P.before(c), $APP($IDS(ch), P.after(c)), $U, flf, h)

def mv_b($UW, +h: $NDL($APP($WB, flf))) -> $NDL($APP($I0, Con{$U, flf})):
  +e1 = Equal.trans($LN, $WB, $APP(P.before(c), $APP($IDS(ch), Con{$U, P.after(c)})), $APP($APP(P.before(c), $IDS(ch)), Con{$U, P.after(c)}), L.subst($LN, z => {$WB == $APP(P.before(c), z) : $LN}, $APP($APP($IDS(ch), Con{$U, Nil{}}), P.after(c)), $APP($IDS(ch), Con{$U, P.after(c)}), LL.append_assoc(Nat, $IDS(ch), Con{$U, Nil{}}, P.after(c)), {==}), Equal.sym($LN, $APP($APP(P.before(c), $IDS(ch)), Con{$U, P.after(c)}), $APP(P.before(c), $APP($IDS(ch), Con{$U, P.after(c)})), LL.append_assoc(Nat, P.before(c), $IDS(ch), Con{$U, P.after(c)})))
  +h1 = L.subst($LN, z => $NDL($APP(z, flf)), $WB, $APP($APP(P.before(c), $IDS(ch)), Con{$U, P.after(c)}), e1, h)
  +h2 = nd_back($APP(P.before(c), $IDS(ch)), P.after(c), $U, flf, h1)
  L.subst($LN, z => $NDL($APP(z, Con{$U, flf})), $APP($APP(P.before(c), $IDS(ch)), P.after(c)), $I0, LL.append_assoc(Nat, P.before(c), $IDS(ch), P.after(c)), h2)


# the ids with no left child, and with no right child, as a split at the node
def wb_eq($UW) -> {$WB == $WBQ : $LN}:
  Equal.trans($LN, $WB, $APP($BC, $APP($IDS(ch), Con{$U, $AC})), $WBQ, L.subst($LN, z => {$WB == $APP($BC, z) : $LN}, $APP($APP($IDS(ch), Con{$U, Nil{}}), $AC), $APP($IDS(ch), Con{$U, $AC}), LL.append_assoc(Nat, $IDS(ch), Con{$U, Nil{}}, $AC), {==}), Equal.sym($LN, $WBQ, $APP($BC, $APP($IDS(ch), Con{$U, $AC})), LL.append_assoc(Nat, $BC, $IDS(ch), Con{$U, $AC})))

def i0_eq($UW) -> {$APP($APP($BC, $IDS(ch)), $AC) == $I0 : $LN}:
  LL.append_assoc(Nat, $BC, $IDS(ch), $AC)

def ain_a($UW, +n: Nat, +h: $ALLIN($APP($WA, flf), n)) -> $ALLIN($APP($I0, Con{$U, flf}), n):
  allin_back($BC, $APP($IDS(ch), $AC), $U, flf, n, h)

def ain_b($UW, +n: Nat, +h: $ALLIN($APP($WB, flf), n)) -> $ALLIN($APP($I0, Con{$U, flf}), n):
  +h1 = L.subst($LN, z => $ALLIN($APP(z, flf), n), $WB, $WBQ, wb_eq(flf, c, ui, ch), h)
  L.subst($LN, z => $ALLIN($APP(z, Con{$U, flf}), n), $APP($APP($BC, $IDS(ch)), $AC), $I0, i0_eq(flf, c, ui, ch), allin_back($APP($BC, $IDS(ch)), $AC, $U, flf, n, h1))

def len_a($UW) -> {$LEN($APP($I0, Con{$U, flf})) == $LEN($APP($WA, flf)) : Nat}:
  Equal.sym(Nat, $LEN($APP($WA, flf)), $LEN($APP($I0, Con{$U, flf})), AL.len_move($BC, $APP($IDS(ch), $AC), $U, flf))

def len_b($UW) -> {$LEN($APP($I0, Con{$U, flf})) == $LEN($APP($WB, flf)) : Nat}:
  +e0 = L.subst($LN, z => {$LEN($APP($I0, Con{$U, flf})) == $LEN($APP(z, Con{$U, flf})) : Nat}, $I0, $APP($APP($BC, $IDS(ch)), $AC), Equal.sym($LN, $APP($APP($BC, $IDS(ch)), $AC), $I0, i0_eq(flf, c, ui, ch)), {==})
  +e1 = Equal.sym(Nat, $LEN($APP($WBQ, flf)), $LEN($APP($APP($APP($BC, $IDS(ch)), $AC), Con{$U, flf})), AL.len_move($APP($BC, $IDS(ch)), $AC, $U, flf))
  +e2 = L.subst($LN, z => {$LEN($APP($WBQ, flf)) == $LEN($APP(z, flf)) : Nat}, $WBQ, $WB, Equal.sym($LN, $WB, $WBQ, wb_eq(flf, c, ui, ch)), {==})
  Equal.trans(Nat, $LEN($APP($I0, Con{$U, flf})), $LEN($APP($APP($APP($BC, $IDS(ch)), $AC), Con{$U, flf})), $LEN($APP($WB, flf)), e0, Equal.trans(Nat, $LEN($APP($APP($APP($BC, $IDS(ch)), $AC), Con{$U, flf})), $LEN($APP($WBQ, flf)), $LEN($APP($WB, flf)), e1, e2))

def sz_a($UW) -> {$LEN($WA) == 1n+$LEN($I0) : Nat}:
  AL.len_put($BC, $U, $APP($IDS(ch), $AC))

def sz_b($UW) -> {$LEN($WB) == 1n+$LEN($I0) : Nat}:
  +e1 = L.subst($LN, z => {$LEN($WB) == $LEN(z) : Nat}, $WB, $WBQ, wb_eq(flf, c, ui, ch), {==})
  +e2 = L.subst($LN, z => {1n+$LEN($APP($APP($BC, $IDS(ch)), $AC)) == 1n+$LEN(z) : Nat}, $APP($APP($BC, $IDS(ch)), $AC), $I0, i0_eq(flf, c, ui, ch), {==})
  Equal.trans(Nat, $LEN($WB), $LEN($WBQ), 1n+$LEN($I0), e1, Equal.trans(Nat, $LEN($WBQ), 1n+$LEN($APP($APP($BC, $IDS(ch)), $AC)), 1n+$LEN($I0), AL.len_put($APP($BC, $IDS(ch)), $U, $AC), e2))
