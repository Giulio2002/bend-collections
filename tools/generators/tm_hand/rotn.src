import Base
import ../lib/logic.bend as L
import ../lib/nat.bend as N
import ../../src/containers/balanced_search_tree.bend as M
import ./state.bend as ST
import ./setters.bend as SE
import ./rotm.bend as RM
import ../lib/order.bend as O
import ./agree.bend as AG
import ../lib/nat_list.bend as NL

# Nodes through a sequence of setters: a setter skips other ids and applies
# its field change to its own; a node's links after field changes.
# (source: tools/generators/tm_hand/rotn.src)

%def ND M.Node<K>
%def NL List<&2, $ND>
%def NDX(nl, j) ST.nd(K, nl, j)
%def NE(a, b) {Nat.is_eq(a, b) == False{} : Bool}
%def ISN(x, a, b, q) {ST.is_node(K, x, a, b, q) == True{} : Bool}

def skipl(-K: Data, +nl: $NL, +id: Nat, +v: Nat, +j: Nat, +h: $NE(id, j)) -> {$NDX(SE.setl(K, nl, id, v), j) == $NDX(nl, j) : $ND}:
  %Equal.sym($ND, $NDX(SE.setl(K, nl, id, v), j), ST.pk($ND, Nat.is_eq(id, j), SE.modl(K, $NDX(nl, j), v), $NDX(nl, j)), SE.ndl(K, nl, id, v, j)) : {_ == $NDX(nl, j) : $ND}
  %Equal.sym(Bool, Nat.is_eq(id, j), False{}, h) : {ST.pk($ND, _, SE.modl(K, $NDX(nl, j), v), $NDX(nl, j)) == $NDX(nl, j) : $ND}
  {==}

def hitl(-K: Data, +nl: $NL, +id: Nat, +v: Nat) -> {$NDX(SE.setl(K, nl, id, v), id) == SE.modl(K, $NDX(nl, id), v) : $ND}:
  %Equal.sym($ND, $NDX(SE.setl(K, nl, id, v), id), ST.pk($ND, Nat.is_eq(id, id), SE.modl(K, $NDX(nl, id), v), $NDX(nl, id)), SE.ndl(K, nl, id, v, id)) : {_ == SE.modl(K, $NDX(nl, id), v) : $ND}
  %Equal.sym(Bool, Nat.is_eq(id, id), True{}, N.is_eq_refl(id)) : {ST.pk($ND, _, SE.modl(K, $NDX(nl, id), v), $NDX(nl, id)) == SE.modl(K, $NDX(nl, id), v) : $ND}
  {==}

def skipr(-K: Data, +nl: $NL, +id: Nat, +v: Nat, +j: Nat, +h: $NE(id, j)) -> {$NDX(SE.setr(K, nl, id, v), j) == $NDX(nl, j) : $ND}:
  %Equal.sym($ND, $NDX(SE.setr(K, nl, id, v), j), ST.pk($ND, Nat.is_eq(id, j), SE.modr(K, $NDX(nl, j), v), $NDX(nl, j)), SE.ndr(K, nl, id, v, j)) : {_ == $NDX(nl, j) : $ND}
  %Equal.sym(Bool, Nat.is_eq(id, j), False{}, h) : {ST.pk($ND, _, SE.modr(K, $NDX(nl, j), v), $NDX(nl, j)) == $NDX(nl, j) : $ND}
  {==}

def hitr(-K: Data, +nl: $NL, +id: Nat, +v: Nat) -> {$NDX(SE.setr(K, nl, id, v), id) == SE.modr(K, $NDX(nl, id), v) : $ND}:
  %Equal.sym($ND, $NDX(SE.setr(K, nl, id, v), id), ST.pk($ND, Nat.is_eq(id, id), SE.modr(K, $NDX(nl, id), v), $NDX(nl, id)), SE.ndr(K, nl, id, v, id)) : {_ == SE.modr(K, $NDX(nl, id), v) : $ND}
  %Equal.sym(Bool, Nat.is_eq(id, id), True{}, N.is_eq_refl(id)) : {ST.pk($ND, _, SE.modr(K, $NDX(nl, id), v), $NDX(nl, id)) == SE.modr(K, $NDX(nl, id), v) : $ND}
  {==}

def skipp(-K: Data, +nl: $NL, +id: Nat, +v: Nat, +j: Nat, +h: $NE(id, j)) -> {$NDX(SE.setp(K, nl, id, v), j) == $NDX(nl, j) : $ND}:
  %Equal.sym($ND, $NDX(SE.setp(K, nl, id, v), j), ST.pk($ND, Nat.is_eq(id, j), SE.modp(K, $NDX(nl, j), v), $NDX(nl, j)), SE.ndp(K, nl, id, v, j)) : {_ == $NDX(nl, j) : $ND}
  %Equal.sym(Bool, Nat.is_eq(id, j), False{}, h) : {ST.pk($ND, _, SE.modp(K, $NDX(nl, j), v), $NDX(nl, j)) == $NDX(nl, j) : $ND}
  {==}

def hitp(-K: Data, +nl: $NL, +id: Nat, +v: Nat) -> {$NDX(SE.setp(K, nl, id, v), id) == SE.modp(K, $NDX(nl, id), v) : $ND}:
  %Equal.sym($ND, $NDX(SE.setp(K, nl, id, v), id), ST.pk($ND, Nat.is_eq(id, id), SE.modp(K, $NDX(nl, id), v), $NDX(nl, id)), SE.ndp(K, nl, id, v, id)) : {_ == SE.modp(K, $NDX(nl, id), v) : $ND}
  %Equal.sym(Bool, Nat.is_eq(id, id), True{}, N.is_eq_refl(id)) : {ST.pk($ND, _, SE.modp(K, $NDX(nl, id), v), $NDX(nl, id)) == SE.modp(K, $NDX(nl, id), v) : $ND}
  {==}

def skipc(-K: Data, +nl: $NL, +id: Nat, +v: Bool, +j: Nat, +h: $NE(id, j)) -> {$NDX(SE.setc(K, nl, id, v), j) == $NDX(nl, j) : $ND}:
  %Equal.sym($ND, $NDX(SE.setc(K, nl, id, v), j), ST.pk($ND, Nat.is_eq(id, j), SE.modc(K, $NDX(nl, j), v), $NDX(nl, j)), SE.ndc(K, nl, id, v, j)) : {_ == $NDX(nl, j) : $ND}
  %Equal.sym(Bool, Nat.is_eq(id, j), False{}, h) : {ST.pk($ND, _, SE.modc(K, $NDX(nl, j), v), $NDX(nl, j)) == $NDX(nl, j) : $ND}
  {==}

def hitc(-K: Data, +nl: $NL, +id: Nat, +v: Bool) -> {$NDX(SE.setc(K, nl, id, v), id) == SE.modc(K, $NDX(nl, id), v) : $ND}:
  %Equal.sym($ND, $NDX(SE.setc(K, nl, id, v), id), ST.pk($ND, Nat.is_eq(id, id), SE.modc(K, $NDX(nl, id), v), $NDX(nl, id)), SE.ndc(K, nl, id, v, id)) : {_ == SE.modc(K, $NDX(nl, id), v) : $ND}
  %Equal.sym(Bool, Nat.is_eq(id, id), True{}, N.is_eq_refl(id)) : {ST.pk($ND, _, SE.modc(K, $NDX(nl, id), v), $NDX(nl, id)) == SE.modc(K, $NDX(nl, id), v) : $ND}
  {==}

def skipa(-K: Data, +nl: $NL, +q: Nat, +y: Nat, +dir: Bool, +j: Nat, +h: $NE(q, j)) -> {$NDX(RM.attn(K, nl, q, y, dir), j) == $NDX(nl, j) : $ND}:
  match q dir:
    case 0n +dir:
      {==}
    case 1n+i True{}:
      skipl(K, nl, 1n+i, y, j, h)
    case 1n+i False{}:
      skipr(K, nl, 1n+i, y, j, h)

# the parent's node after attach: the child on its side
def moda(-K: Data, x: $ND, +y: Nat, +dir: Bool) -> $ND:
  match dir:
    case True{}:
      SE.modl(K, x, y)
    case False{}:
      SE.modr(K, x, y)

def hita(-K: Data, +nl: $NL, +i: Nat, +y: Nat, +dir: Bool) -> {$NDX(RM.attn(K, nl, 1n+i, y, dir), 1n+i) == moda(K, $NDX(nl, 1n+i), y, dir) : $ND}:
  match dir:
    case True{}:
      hitl(K, nl, 1n+i, y)
    case False{}:
      hitr(K, nl, 1n+i, y)

# ---- links after field changes ----

%def ANDN(a, b, h) L.and_left(a, b, h)

def isn_pr(-K: Data, +x: $ND, +a: Nat, +b0: Nat, +q0: Nat, +b: Nat, +p: Nat, +h: $ISN(x, a, b0, q0)) -> $ISN(SE.modp(K, SE.modr(K, x, b), p), a, b, p):
  match x:
    case M.Free{f}:
      Empty.absurd($ISN(SE.modp(K, SE.modr(K, M.Free{f}, b), p), a, b, p), L.false_true(h))
    case M.N{c, +x1, +x2, +x3, k}:
      L.and_intro(Nat.is_eq(x1, a), Bool.and(Nat.is_eq(b, b), Nat.is_eq(p, p)), L.and_left(Nat.is_eq(x1, a), Bool.and(Nat.is_eq(x2, b0), Nat.is_eq(x3, q0)), h), L.and_intro(Nat.is_eq(b, b), Nat.is_eq(p, p), N.is_eq_refl(b), N.is_eq_refl(p)))

def isn_pl(-K: Data, +x: $ND, +a0: Nat, +b: Nat, +q0: Nat, +a: Nat, +p: Nat, +h: $ISN(x, a0, b, q0)) -> $ISN(SE.modp(K, SE.modl(K, x, a), p), a, b, p):
  match x:
    case M.Free{f}:
      Empty.absurd($ISN(SE.modp(K, SE.modl(K, M.Free{f}, a), p), a, b, p), L.false_true(h))
    case M.N{c, +x1, +x2, +x3, k}:
      L.and_intro(Nat.is_eq(a, a), Bool.and(Nat.is_eq(x2, b), Nat.is_eq(p, p)), N.is_eq_refl(a), L.and_intro(Nat.is_eq(x2, b), Nat.is_eq(p, p), L.and_left(Nat.is_eq(x2, b), Nat.is_eq(x3, q0), L.and_right(Nat.is_eq(x1, a0), Bool.and(Nat.is_eq(x2, b), Nat.is_eq(x3, q0)), h)), N.is_eq_refl(p)))

def isn_lp(-K: Data, +x: $ND, +a0: Nat, +b: Nat, +q0: Nat, +a: Nat, +p: Nat, +h: $ISN(x, a0, b, q0)) -> $ISN(SE.modl(K, SE.modp(K, x, p), a), a, b, p):
  match x:
    case M.Free{f}:
      Empty.absurd($ISN(SE.modl(K, SE.modp(K, M.Free{f}, p), a), a, b, p), L.false_true(h))
    case M.N{c, +x1, +x2, +x3, k}:
      L.and_intro(Nat.is_eq(a, a), Bool.and(Nat.is_eq(x2, b), Nat.is_eq(p, p)), N.is_eq_refl(a), L.and_intro(Nat.is_eq(x2, b), Nat.is_eq(p, p), L.and_left(Nat.is_eq(x2, b), Nat.is_eq(x3, q0), L.and_right(Nat.is_eq(x1, a0), Bool.and(Nat.is_eq(x2, b), Nat.is_eq(x3, q0)), h)), N.is_eq_refl(p)))

def isn_rp(-K: Data, +x: $ND, +a: Nat, +b0: Nat, +q0: Nat, +b: Nat, +p: Nat, +h: $ISN(x, a, b0, q0)) -> $ISN(SE.modr(K, SE.modp(K, x, p), b), a, b, p):
  match x:
    case M.Free{f}:
      Empty.absurd($ISN(SE.modr(K, SE.modp(K, M.Free{f}, p), b), a, b, p), L.false_true(h))
    case M.N{c, +x1, +x2, +x3, k}:
      L.and_intro(Nat.is_eq(x1, a), Bool.and(Nat.is_eq(b, b), Nat.is_eq(p, p)), L.and_left(Nat.is_eq(x1, a), Bool.and(Nat.is_eq(x2, b0), Nat.is_eq(x3, q0)), h), L.and_intro(Nat.is_eq(b, b), Nat.is_eq(p, p), N.is_eq_refl(b), N.is_eq_refl(p)))

def isn_p(-K: Data, +x: $ND, +a: Nat, +b: Nat, +q0: Nat, +p: Nat, +h: $ISN(x, a, b, q0)) -> $ISN(SE.modp(K, x, p), a, b, p):
  match x:
    case M.Free{f}:
      Empty.absurd($ISN(SE.modp(K, M.Free{f}, p), a, b, p), L.false_true(h))
    case M.N{c, +x1, +x2, +x3, k}:
      L.and_intro(Nat.is_eq(x1, a), Bool.and(Nat.is_eq(x2, b), Nat.is_eq(p, p)), L.and_left(Nat.is_eq(x1, a), Bool.and(Nat.is_eq(x2, b), Nat.is_eq(x3, q0)), h), L.and_intro(Nat.is_eq(x2, b), Nat.is_eq(p, p), L.and_left(Nat.is_eq(x2, b), Nat.is_eq(x3, q0), L.and_right(Nat.is_eq(x1, a), Bool.and(Nat.is_eq(x2, b), Nat.is_eq(x3, q0)), h)), N.is_eq_refl(p)))

# the parent's links with the child on the path's side replaced
def isn_a(-K: Data, +x: $ND, +lft: Bool, +c0: Nat, +s: Nat, +q: Nat, +y: Nat, +h: $ISN(x, ST.pk(Nat, lft, c0, s), ST.pk(Nat, lft, s, c0), q)) -> $ISN(moda(K, x, y, lft), ST.pk(Nat, lft, y, s), ST.pk(Nat, lft, s, y), q):
  match x lft:
    case M.Free{f} +lft:
      Empty.absurd($ISN(moda(K, M.Free{f}, y, lft), ST.pk(Nat, lft, y, s), ST.pk(Nat, lft, s, y), q), L.false_true(h))
    case M.N{c, +x1, +x2, +x3, k} True{}:
      L.and_intro(Nat.is_eq(y, y), Bool.and(Nat.is_eq(x2, s), Nat.is_eq(x3, q)), N.is_eq_refl(y), L.and_right(Nat.is_eq(x1, c0), Bool.and(Nat.is_eq(x2, s), Nat.is_eq(x3, q)), h))
    case M.N{c, +x1, +x2, +x3, k} False{}:
      L.and_intro(Nat.is_eq(x1, s), Bool.and(Nat.is_eq(y, y), Nat.is_eq(x3, q)), L.and_left(Nat.is_eq(x1, s), Bool.and(Nat.is_eq(x2, c0), Nat.is_eq(x3, q)), h), L.and_intro(Nat.is_eq(y, y), Nat.is_eq(x3, q), N.is_eq_refl(y), L.and_right(Nat.is_eq(x2, c0), Nat.is_eq(x3, q), L.and_right(Nat.is_eq(x1, s), Bool.and(Nat.is_eq(x2, c0), Nat.is_eq(x3, q)), h))))

# ---- agreement through the rotations' writes ----

%def LN List<&2, Nat>
%def TO ~K: Data, ~cmp: K -> K -> Cmp, ~o: O.Order(~K, ~cmp)
%def AO ~K, ~cmp, ~o
%def AGR(xs, a, b) {AG.agr(~K, ~cmp, xs, a, b) == True{} : Bool}
%def NMEM(y, xs) {NL.memn(y, xs) == False{} : Bool}

def attn_agr($TO, +xs: $LN, +nl: $NL, +q: Nat, +y: Nat, +dir: Bool, +hq: $NMEM(q, xs)) -> $AGR(xs, nl, RM.attn(K, nl, q, y, dir)):
  match q dir:
    case 0n +dir:
      AG.agr_refl($AO, xs, nl)
    case 1n+i True{}:
      SE.setl_agr($AO, xs, nl, 1n+i, y, hq)
    case 1n+i False{}:
      SE.setr_agr($AO, xs, nl, 1n+i, y, hq)

%def R1L SE.setr(K, nl, x, b)
%def R2L SE.setp(K, $R1L, b, x)
%def R3A RM.attn(K, $R2L, q, y, dir)
%def R3L SE.setp(K, $R3A, y, q)
%def R4L SE.setl(K, $R3L, y, x)
%def R5L SE.setp(K, $R4L, x, y)

# ids the left rotation does not write keep their nodes
def rotl_agr($TO, +xs: $LN, +nl: $NL, +x: Nat, +y: Nat, +b: Nat, +q: Nat, +dir: Bool, +hx: $NMEM(x, xs), +hy: $NMEM(y, xs), +hb: $NMEM(b, xs), +hq: $NMEM(q, xs)) -> $AGR(xs, nl, RM.rotl_nl(K, nl, x, y, b, q, dir)):
  +a1 = SE.setr_agr($AO, xs, nl, x, b, hx)
  +a2 = SE.setp_agr($AO, xs, $R1L, b, x, hb)
  +a3 = attn_agr($AO, xs, $R2L, q, y, dir, hq)
  +a4 = SE.setp_agr($AO, xs, $R3A, y, q, hy)
  +a5 = SE.setl_agr($AO, xs, $R3L, y, x, hy)
  +a6 = SE.setp_agr($AO, xs, $R4L, x, y, hx)
  AG.agr_trans($AO, xs, nl, $R4L, $R5L, AG.agr_trans($AO, xs, nl, $R3L, $R4L, AG.agr_trans($AO, xs, nl, $R3A, $R3L, AG.agr_trans($AO, xs, nl, $R2L, $R3A, AG.agr_trans($AO, xs, nl, $R1L, $R2L, a1, a2), a3), a4), a5), a6)

%def S1R SE.setl(K, nl, x, b)
%def S2R SE.setp(K, $S1R, b, x)
%def S3A RM.attn(K, $S2R, q, y, dir)
%def S3R SE.setp(K, $S3A, y, q)
%def S4R SE.setr(K, $S3R, y, x)
%def S5R SE.setp(K, $S4R, x, y)

def rotr_agr($TO, +xs: $LN, +nl: $NL, +x: Nat, +y: Nat, +b: Nat, +q: Nat, +dir: Bool, +hx: $NMEM(x, xs), +hy: $NMEM(y, xs), +hb: $NMEM(b, xs), +hq: $NMEM(q, xs)) -> $AGR(xs, nl, RM.rotr_nl(K, nl, x, y, b, q, dir)):
  +a1 = SE.setl_agr($AO, xs, nl, x, b, hx)
  +a2 = SE.setp_agr($AO, xs, $S1R, b, x, hb)
  +a3 = attn_agr($AO, xs, $S2R, q, y, dir, hq)
  +a4 = SE.setp_agr($AO, xs, $S3A, y, q, hy)
  +a5 = SE.setr_agr($AO, xs, $S3R, y, x, hy)
  +a6 = SE.setp_agr($AO, xs, $S4R, x, y, hx)
  AG.agr_trans($AO, xs, nl, $S4R, $S5R, AG.agr_trans($AO, xs, nl, $S3R, $S4R, AG.agr_trans($AO, xs, nl, $S3A, $S3R, AG.agr_trans($AO, xs, nl, $S2R, $S3A, AG.agr_trans($AO, xs, nl, $S1R, $S2R, a1, a2), a3), a4), a5), a6)

# ---- the rotated nodes ----

%def NESYM(a, b, h) N.is_eq_sym_false(a, b, h)

# x: its right child b, its parent y
def rotl_x(-K: Data, +nl: $NL, +x: Nat, +y: Nat, +b: Nat, +q: Nat, +dir: Bool, +a: Nat, +hxn: $ISN($NDX(nl, x), a, y, q), +nyx: $NE(y, x), +nqx: $NE(q, x), +nbx: $NE(b, x)) -> $ISN($NDX(RM.rotl_nl(K, nl, x, y, b, q, dir), x), a, b, y):
  +e = Equal.trans($ND, $NDX($R5L, x), SE.modp(K, $NDX($R4L, x), y), SE.modp(K, SE.modr(K, $NDX(nl, x), b), y), hitp(K, $R4L, x, y), L.subst($ND, z => {SE.modp(K, $NDX($R4L, x), y) == SE.modp(K, z, y) : $ND}, $NDX($R4L, x), SE.modr(K, $NDX(nl, x), b), Equal.trans($ND, $NDX($R4L, x), $NDX($R3L, x), SE.modr(K, $NDX(nl, x), b), skipl(K, $R3L, y, x, x, nyx), Equal.trans($ND, $NDX($R3L, x), $NDX($R3A, x), SE.modr(K, $NDX(nl, x), b), skipp(K, $R3A, y, q, x, nyx), Equal.trans($ND, $NDX($R3A, x), $NDX($R2L, x), SE.modr(K, $NDX(nl, x), b), skipa(K, $R2L, q, y, dir, x, nqx), Equal.trans($ND, $NDX($R2L, x), $NDX($R1L, x), SE.modr(K, $NDX(nl, x), b), skipp(K, $R1L, b, x, x, nbx), hitr(K, nl, x, b))))), {==}))
  L.subst($ND, z => $ISN(z, a, b, y), SE.modp(K, SE.modr(K, $NDX(nl, x), b), y), $NDX($R5L, x), Equal.sym($ND, $NDX($R5L, x), SE.modp(K, SE.modr(K, $NDX(nl, x), b), y), e), isn_pr(K, $NDX(nl, x), a, y, q, b, y, hxn))

# y: its left child x, its parent q
def rotl_y(-K: Data, +nl: $NL, +x: Nat, +y: Nat, +b: Nat, +q: Nat, +dir: Bool, +cc: Nat, +hyn: $ISN($NDX(nl, y), b, cc, x), +nxy: $NE(x, y), +nqy: $NE(q, y), +nby: $NE(b, y)) -> $ISN($NDX(RM.rotl_nl(K, nl, x, y, b, q, dir), y), x, cc, q):
  +e = Equal.trans($ND, $NDX($R5L, y), $NDX($R4L, y), SE.modl(K, SE.modp(K, $NDX(nl, y), q), x), skipp(K, $R4L, x, y, y, nxy), Equal.trans($ND, $NDX($R4L, y), SE.modl(K, $NDX($R3L, y), x), SE.modl(K, SE.modp(K, $NDX(nl, y), q), x), hitl(K, $R3L, y, x), L.subst($ND, z => {SE.modl(K, $NDX($R3L, y), x) == SE.modl(K, z, x) : $ND}, $NDX($R3L, y), SE.modp(K, $NDX(nl, y), q), Equal.trans($ND, $NDX($R3L, y), SE.modp(K, $NDX($R3A, y), q), SE.modp(K, $NDX(nl, y), q), hitp(K, $R3A, y, q), L.subst($ND, z => {SE.modp(K, $NDX($R3A, y), q) == SE.modp(K, z, q) : $ND}, $NDX($R3A, y), $NDX(nl, y), Equal.trans($ND, $NDX($R3A, y), $NDX($R2L, y), $NDX(nl, y), skipa(K, $R2L, q, y, dir, y, nqy), Equal.trans($ND, $NDX($R2L, y), $NDX($R1L, y), $NDX(nl, y), skipp(K, $R1L, b, x, y, nby), skipr(K, nl, x, b, y, nxy))), {==})), {==})))
