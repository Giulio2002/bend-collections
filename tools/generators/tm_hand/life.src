import Base
import ../lib/logic.bend as L
import ../lib/nat.bend as N
import ../spec/common.bend as SC
import ../spec/tree_map.bend as S
import ../../src/containers/balanced_search_tree.bend as M
import ../../src/containers/dynamic_array.bend as D
import ./state.bend as ST
import ./mirror.bend as MI

# The empty map: the shadow with no nodes is good at any limit and depth
# within bounds; new and with_limit build it, and its model is the
# specification's empty map. (source: tools/generators/tm_hand/life.src)

%def TK ~K: Data, ~V: Data, ~cmp: K -> K -> Cmp
%def AK ~K, ~V, ~cmp
%def ESH(l, d) ST.SH{0n, 0n, 0n, 0n, 0n, l, d, Nil{}, Nil{}, ST.TE{}, Nil{}}
%def GD(s) {ST.good($AK, s) == True{} : Bool}
%def TMT M.TreeMap<K, V, cmp>
%def MOD S.Model<K, V>

def good_empty($TK, +l: Nat, +d: Nat, +hcl: {Nat.is_le(l, 31n) == True{} : Bool}, +hcd: {Nat.is_le(d, l) == True{} : Bool}) -> $GD($ESH(l, d)):
  ST.good_intro($AK, 0n, 0n, 0n, 0n, 0n, l, d, Nil{}, Nil{}, ST.TE{}, Nil{}, hcl, hcd, N.zero_le(SC.pow2(d)), {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})

def new_ok($TK) -> {ST.real($AK, $ESH(31n, 0n)) == M.new($AK) : $TMT} & ({ST.model($AK, $ESH(31n, 0n)) == S.new(K, V) : $MOD} & $GD($ESH(31n, 0n))):
  ({==}, ({==}, good_empty($AK, 31n, 0n, {==}, {==})))

%def LIM(b) D.clamp_limit(k, b)
%def WLT(b) {ST.real($AK, $ESH($LIM(b), 0n)) == M.TM{0n, 0n, 0n, 0n, 0n, D.DA{$LIM(b), 0n, 1n, 0n, D.empty_slots_at(~M.Node<K>, 0n)}, D.DA{$LIM(b), 0n, 1n, 0n, D.empty_slots_at(~Maybe<&2, V>, 0n)}} : $TMT} & ({ST.model($AK, $ESH($LIM(b), 0n)) == S.TM{S.pick(Nat, b, k, 31n), Nil{}} : $MOD} & $GD($ESH($LIM(b), 0n)))

def wl_c($TK, +k: Nat, +b: Bool, +hb: {Nat.is_lt(k, 31n) == b : Bool}) -> $WLT(b):
  match b:
    case True{}:
      ({==}, ({==}, good_empty($AK, k, 0n, N.lt_le(k, 31n, hb), N.zero_le(k))))
    case False{}:
      ({==}, ({==}, good_empty($AK, 31n, 0n, {==}, {==})))

# with_limit: the limit clamped to 31
def with_limit_ok($TK, +k: Nat) -> {ST.real($AK, $ESH($LIM(Nat.is_lt(k, 31n)), 0n)) == M.with_limit($AK, k) : $TMT} & ({ST.model($AK, $ESH($LIM(Nat.is_lt(k, 31n)), 0n)) == S.with_limit(K, V, k) : $MOD} & $GD($ESH($LIM(Nat.is_lt(k, 31n)), 0n))):
  wl_c($AK, k, Nat.is_lt(k, 31n), {==})

# clearing: the same limit and depth, no nodes
def clear_ok($TK, +n: Nat, +root: Nat, +lo: Nat, +hi: Nat, +free: Nat, +l: Nat, +d: Nat, +nl: List<&2, M.Node<K>>, +pl: List<&2, Maybe<&2, V>>, +tg: ST.Tr, +fl: List<&2, Nat>, +hg: {ST.goodF($AK, n, root, lo, hi, free, l, d, nl, pl, tg, fl) == True{} : Bool}) -> {ST.real($AK, MI.clear($AK, ST.SH{n, root, lo, hi, free, l, d, nl, pl, tg, fl})) == ST.real($AK, $ESH(l, d)) : $TMT} & ({S.clear(K, V, ST.model($AK, ST.SH{n, root, lo, hi, free, l, d, nl, pl, tg, fl})) == ST.model($AK, $ESH(l, d)) : $MOD} & $GD($ESH(l, d))):
  ({==}, ({==}, good_empty($AK, l, d, ST.g_cl($AK, n, root, lo, hi, free, l, d, nl, pl, tg, fl, hg), ST.g_cd($AK, n, root, lo, hi, free, l, d, nl, pl, tg, fl, hg))))
