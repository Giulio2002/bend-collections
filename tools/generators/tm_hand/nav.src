import Base
import ../lib/logic.bend as L
import ../lib/nat.bend as N
import ../spec/common.bend as SC
import ../../src/containers/balanced_search_tree.bend as M
import ./state.bend as ST
import ./mirror.bend as MI
import ./tree.bend as TR
import ./path.bend as P
import ./nbr.bend as NB
import ../lib/nat_list.bend as NL

# Navigation (floor, ceiling, lower, higher): the loop descends by
# comparison keeping the best candidate, which along the path is the first
# id after (upward) or the last before (downward) the current subtree; at an
# equal key it answers the node (inclusive) or its neighbour. The loop is
# the ghost navigation gnav. (source: tools/generators/tm_hand/nav.src)

%def ND M.Node<K>
%def NL List<&2, $ND>
%def LN List<&2, Nat>
%def APP(a, b) SC.append(Nat, a, b)
%def IDS(t) ST.ids(t)
%def TN(i, a, b) ST.TN{i, a, b}
%def CT List<&2, P.Fr>
%def PK(fw, a, b) ST.pk(Nat, fw, a, b)
%def REP(t, p) {ST.rep(~K, t, p, nl) == True{} : Bool}
%def COK(c, x) {P.ctxok(~K, c, x, nl) == True{} : Bool}
%def TK ~K: Data, ~V: Data, ~cmp: K -> K -> Cmp
%def AK ~K, ~V, ~cmp
%def FT +n: Nat, +root: Nat, +lo: Nat, +hi: Nat, +free: Nat, +l0: Nat, +d0: Nat, +nl: $NL, +pl: List<&2, Maybe<&2, V>>, +tg: ST.Tr, +fl: List<&2, Nat>
%def F n, root, lo, hi, free, l0, d0, nl, pl, tg, fl
%def SH ST.SH{$F}
%def SHT ST.Sh<K, V>
%def WH(c, t) $APP(P.before(c), $APP($IDS(t), P.after(c)))
%def CL(i, r, c) Con{P.FR{i, True{}, r}, c}
%def CR(i, l, c) Con{P.FR{i, False{}, l}, c}
%def BEST(h, c) $PK(h, ST.fst0(P.after(c)), ST.last0(P.before(c)))
%def NBR(h, c, l, r) $PK(h, ST.fst0($APP($IDS(r), P.after(c))), ST.last0($APP(P.before(c), $IDS(l))))

def gnav(~K: Data, ~cmp: K -> K -> Cmp, t: ST.Tr, +c: $CT, +nl: $NL, +k: K, +h: Bool, +incl: Bool) -> Nat:
  match t:
    case ST.TE{}:
      $BEST(h, c)
    case ST.TN{+i, +l, +r}:
      TR.pk3(Nat, TR.kc(~K, ~cmp, k, ST.nd(K, nl, i)), gnav(~K, ~cmp, l, $CL(i, r, c), nl, k, h, incl), gnav(~K, ~cmp, r, $CR(i, l, c), nl, k, h, incl), $PK(incl, i, $NBR(h, c, l, r)))

%def GN(t, c) gnav(~K, ~cmp, t, c, nl, k, h, incl)
%def NLP(f, id, best) MI.nav_loop($AK, f, k, h, incl, id, best, MI.probe($AK, $SH, id, k))
%def NVT $SHT & Nat

# the candidate after a step left / right
def best_l(+h: Bool, +i: Nat, +a: Nat, +b: Nat) -> {M.pick(Nat, h, i, $PK(h, a, b)) == $PK(h, i, b) : Nat}:
  match h:
    case True{}:
      {==}
    case False{}:
      {==}

def best_r(+h: Bool, +i: Nat, +a: Nat, +b: Nat) -> {M.pick(Nat, h, $PK(h, a, b), i) == $PK(h, a, i) : Nat}:
  match h:
    case True{}:
      {==}
    case False{}:
      {==}

def nav_eq($TK, $FT, +i: Nat, +h: Bool, +incl: Bool, +v: Nat, +e: {MI.neighbor($AK, $SH, i, h) == ($SH, v) : $NVT}) -> {MI.nav_equal($AK, $SH, i, h, incl) == ($SH, $PK(incl, i, v)) : $NVT}:
  match incl:
    case True{}:
      {==}
    case False{}:
      e

%def BL $PK(h, i, ST.last0(P.before(c)))
%def BR $PK(h, ST.fst0(P.after(c)), i)

def nav_c($TK, $FT, +c: $CT, +i: Nat, +l: ST.Tr, +r: ST.Tr, +k: K, +h: Bool, +incl: Bool, +g: Nat, +cc: Bool, +a: Nat, +b: Nat, +q: Nat, +key: K, +ea: {a == ST.rid(l) : Nat}, +eb: {b == ST.rid(r) : Nat}, +ihl: {$NLP(g, ST.rid(l), $BL) == ($SH, $GN(l, $CL(i, r, c))) : $NVT}, +ihr: {$NLP(g, ST.rid(r), $BR) == ($SH, $GN(r, $CR(i, l, c))) : $NVT}, +ne: {MI.neighbor($AK, $SH, i, h) == ($SH, $NBR(h, c, l, r)) : $NVT}, +o: Cmp) -> {MI.nav_loop($AK, 1n+g, k, h, incl, i, $BEST(h, c), ($SH, (M.N{cc, a, b, q, key}, o))) == ($SH, TR.pk3(Nat, o, $GN(l, $CL(i, r, c)), $GN(r, $CR(i, l, c)), $PK(incl, i, $NBR(h, c, l, r)))) : $NVT}:
  match o:
    case LT{}:
      %Equal.sym(Nat, a, ST.rid(l), ea) : {$NLP(g, _, M.pick(Nat, h, i, $BEST(h, c))) == ($SH, $GN(l, $CL(i, r, c))) : $NVT}
      %Equal.sym(Nat, M.pick(Nat, h, i, $BEST(h, c)), $BL, best_l(h, i, ST.fst0(P.after(c)), ST.last0(P.before(c)))) : {$NLP(g, ST.rid(l), _) == ($SH, $GN(l, $CL(i, r, c))) : $NVT}
      ihl
    case GT{}:
      %Equal.sym(Nat, b, ST.rid(r), eb) : {$NLP(g, _, M.pick(Nat, h, $BEST(h, c), i)) == ($SH, $GN(r, $CR(i, l, c))) : $NVT}
      %Equal.sym(Nat, M.pick(Nat, h, $BEST(h, c), i), $BR, best_r(h, i, ST.fst0(P.after(c)), ST.last0(P.before(c)))) : {$NLP(g, ST.rid(r), _) == ($SH, $GN(r, $CR(i, l, c))) : $NVT}
      ihr
    case EQ{}:
      nav_eq($AK, $F, i, h, incl, $NBR(h, c, l, r), ne)

def nav_node($TK, $FT, +c: $CT, +i: Nat, +l: ST.Tr, +r: ST.Tr, +k: K, +h: Bool, +incl: Bool, +g: Nat, +x: $ND, +hx: {ST.is_node(K, x, ST.rid(l), ST.rid(r), P.top(c)) == True{} : Bool}, +ihl: {$NLP(g, ST.rid(l), $BL) == ($SH, $GN(l, $CL(i, r, c))) : $NVT}, +ihr: {$NLP(g, ST.rid(r), $BR) == ($SH, $GN(r, $CR(i, l, c))) : $NVT}, +ne: {MI.neighbor($AK, $SH, i, h) == ($SH, $NBR(h, c, l, r)) : $NVT}) -> {MI.nav_loop($AK, 1n+g, k, h, incl, i, $BEST(h, c), MI.probe_node($AK, i, k, ($SH, x))) == ($SH, TR.pk3(Nat, TR.kc(~K, ~cmp, k, x), $GN(l, $CL(i, r, c)), $GN(r, $CR(i, l, c)), $PK(incl, i, $NBR(h, c, l, r)))) : $NVT}:
  match x:
    case M.Free{fx}:
      Empty.absurd({MI.nav_loop($AK, 1n+g, k, h, incl, i, $BEST(h, c), MI.probe_node($AK, i, k, ($SH, M.Free{fx}))) == ($SH, TR.pk3(Nat, EQ{}, $GN(l, $CL(i, r, c)), $GN(r, $CR(i, l, c)), $PK(incl, i, $NBR(h, c, l, r)))) : $NVT}, L.false_true(hx))
    case M.N{+cc, +a, +b, +q, +key}:
      +ha = L.and_left(Nat.is_eq(a, ST.rid(l)), Bool.and(Nat.is_eq(b, ST.rid(r)), Nat.is_eq(q, P.top(c))), hx)
      +hb = L.and_left(Nat.is_eq(b, ST.rid(r)), Nat.is_eq(q, P.top(c)), L.and_right(Nat.is_eq(a, ST.rid(l)), Bool.and(Nat.is_eq(b, ST.rid(r)), Nat.is_eq(q, P.top(c))), hx))
      nav_c($AK, $F, c, i, l, r, k, h, incl, g, cc, a, b, q, key, N.eq_from_is_eq(a, ST.rid(l), ha), N.eq_from_is_eq(b, ST.rid(r), hb), ihl, ihr, ne, cmp(k, key))

%def NDP(c, t) {NL.nodupn($WH(c, t)) == True{} : Bool}
%def HID(c, t) {$IDS(tg) == $WH(c, t) : $LN}

# the loop from a subtree the path leads to is the ghost navigation
def nav_ptr($TK, $FT, +f: Nat, +c: $CT, +t: ST.Tr, +k: K, +h: Bool, +incl: Bool, +hr: $REP(t, P.top(c)), +hok: $COK(c, ST.rid(t)), +hnd: $NDP(c, t), +hid: $HID(c, t), +hn: {n == SC.length(Nat, $IDS(tg)) : Nat}, +hf: {Nat.is_lt(TR.ht(t), f) == True{} : Bool}) -> {$NLP(f, ST.rid(t), $BEST(h, c)) == ($SH, $GN(t, c)) : $NVT}:
  match f t:
    case 0n +t:
      Empty.absurd({$NLP(0n, ST.rid(t), $BEST(h, c)) == ($SH, $GN(t, c)) : $NVT}, L.true_not_false(Nat.is_lt(TR.ht(t), 0n), hf, N.not_lt_zero(TR.ht(t))))
    case 1n+g ST.TE{}:
      {==}
    case 1n+g ST.TN{+i, +l, +r}:
      +el = P.ids_l(c, i, l, r)
      +er = P.ids_r(c, i, l, r)
      +ihl = nav_ptr($AK, $F, g, $CL(i, r, c), l, k, h, incl, Pair.snd($COK($CL(i, r, c), ST.rid(l)), $REP(l, i), P.ok_l(~K, nl, c, i, l, r, hr, hok)), Pair.fst($COK($CL(i, r, c), ST.rid(l)), $REP(l, i), P.ok_l(~K, nl, c, i, l, r, hr, hok)), L.subst($LN, z => {NL.nodupn(z) == True{} : Bool}, $WH(c, $TN(i, l, r)), $WH($CL(i, r, c), l), el, hnd), Equal.trans($LN, $IDS(tg), $WH(c, $TN(i, l, r)), $WH($CL(i, r, c), l), hid, el), hn, TR.ht_l(i, l, r, g, hf))
      +ihr0 = nav_ptr($AK, $F, g, $CR(i, l, c), r, k, h, incl, Pair.snd($COK($CR(i, l, c), ST.rid(r)), $REP(r, i), P.ok_r(~K, nl, c, i, l, r, hr, hok)), Pair.fst($COK($CR(i, l, c), ST.rid(r)), $REP(r, i), P.ok_r(~K, nl, c, i, l, r, hr, hok)), L.subst($LN, z => {NL.nodupn(z) == True{} : Bool}, $WH(c, $TN(i, l, r)), $WH($CR(i, l, c), r), er, hnd), Equal.trans($LN, $IDS(tg), $WH(c, $TN(i, l, r)), $WH($CR(i, l, c), r), hid, er), hn, TR.ht_r(i, l, r, g, hf))
      +ihr = L.subst(Nat, z => {$NLP(g, ST.rid(r), $PK(h, ST.fst0(P.after(c)), z)) == ($SH, $GN(r, $CR(i, l, c))) : $NVT}, ST.last0($APP(P.before(c), $APP($IDS(l), Con{i, Nil{}}))), i, NB.last0_end(P.before(c), $IDS(l), i), ihr0)
      +ne = NB.neighbor_m($AK, $F, c, i, l, r, hr, hok, hnd, hid, hn, h)
      nav_node($AK, $F, c, i, l, r, k, h, incl, g, ST.nd(K, nl, i), TR.rep_node(~K, i, l, r, P.top(c), nl, hr), ihl, ihr, ne)
