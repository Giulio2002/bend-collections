    case Tuple{+r, Tuple{nf, Tuple{T, Tuple{eqf0, Tuple{hrep0, Tuple{hr0, Tuple{hids0, Tuple{hrb0, Tuple{he0, Tuple{hoks0, rest7}}}}}}}}}}:
      ins_mok2($AO, $FOA, hg, $AIA, $SPA, $ALA, r, nf, T, eqf0, hrep0, hr0, hids0, hrb0, he0, hoks0, rest7)

%def SHA ST.SH{n, root, lo, hi, fra, l, dra, nla, pla, tg, fl}
