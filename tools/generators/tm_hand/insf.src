  %Equal.sym(ST.Sh<K, V>, MI.attach($AK, $SHA, $P0, x, $DR), ST.SH{n, $RQ, lo, hi, fra, l, dra, $N3, pla, tg, fl}, RM.attach_m($AK, n, root, lo, hi, fra, l, dra, nla, pla, tg, fl, $P0, x, $DR)) : {(MI.insert_fixed($AK, x, MI.size($AK, MI.insert_header($AK, _, x, $P0, $DR))), Done{None{}}) == ($FIXR, Done{None{}}) : ST.Sh<K, V> & $RES}
  {==}

