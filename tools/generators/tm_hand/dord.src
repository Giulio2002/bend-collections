# Deleting a key from sorted entries: del removes exactly the entry holding
# it when the entries before are smaller, and dropping an entry keeps the
# entries sorted. (source: tools/generators/tm_hand/dord.src)

%def E M.Entry<K, V>
%def ES List<&2, $E>
%def EAPP(a, b) SC.append($E, a, b)
%def KY(e) S.key(K, V, e)
%def TO ~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, ~o: O.Order(~K, ~cmp)
%def AK ~K, ~V, ~cmp
%def AO ~K, ~V, ~cmp, ~o
%def LTA(k, es) {OR.ltall($AK, k, es) == True{} : Bool}
%def ORD(x) {ST.ordered($AK, x) == True{} : Bool}
%def DEL(xs) S.del($AK, k, xs)

def del_mid($TO, +k: K, +xs: $ES, +e: $E, +ys: $ES, +hl: $LTA(k, xs), +hc: {cmp(k, $KY(e)) == EQ{} : Cmp}) -> {$DEL($EAPP(xs, Con{e, ys})) == $EAPP(xs, ys) : $ES}:
  match xs:
    case Nil{}:
      %Equal.sym(Cmp, cmp(k, $KY(e)), EQ{}, hc) : {S.pick($ES, S.is_eq(_), ys, Con{e, $DEL(ys)}) == ys : $ES}
      {==}
    case Con{+a, +t}:
      %Equal.sym(Cmp, cmp(k, $KY(a)), GT{}, OR.lt_gt(~K, ~cmp, ~o, $KY(a), k, L.and_left(Cmp.is_lt(cmp($KY(a), k)), OR.ltall($AK, k, t), hl))) : {S.pick($ES, S.is_eq(_), $EAPP(t, Con{e, ys}), Con{a, $DEL($EAPP(t, Con{e, ys}))}) == Con{a, $EAPP(t, ys)} : $ES}
      %Equal.sym($ES, $DEL($EAPP(t, Con{e, ys})), $EAPP(t, ys), del_mid($AO, k, t, e, ys, L.and_right(Cmp.is_lt(cmp($KY(a), k)), OR.ltall($AK, k, t), hl), hc)) : {Con{a, _} == Con{a, $EAPP(t, ys)} : $ES}
      {==}

# the first of the entries after one dropped
def ord_tail($TO, +e: $E, +ys: $ES, +h: $ORD(Con{e, ys})) -> $ORD(ys):
  match ys:
    case Nil{}:
      {==}
    case Con{+b, +u}:
      L.and_right(Cmp.is_lt(cmp($KY(e), $KY(b))), ST.ordered($AK, Con{b, u}), h)

def ord_skip($TO, +a: $E, +e: $E, +ys: $ES, +h: $ORD(Con{a, Con{e, ys}})) -> $ORD(Con{a, ys}):
  match ys:
    case Nil{}:
      {==}
    case Con{+b, +u}:
      +h1 = L.and_left(Cmp.is_lt(cmp($KY(a), $KY(e))), ST.ordered($AK, Con{e, Con{b, u}}), h)
      +h2 = L.and_right(Cmp.is_lt(cmp($KY(a), $KY(e))), ST.ordered($AK, Con{e, Con{b, u}}), h)
      +h3 = L.and_left(Cmp.is_lt(cmp($KY(e), $KY(b))), ST.ordered($AK, Con{b, u}), h2)
      L.and_intro(Cmp.is_lt(cmp($KY(a), $KY(b))), ST.ordered($AK, Con{b, u}), OR.slt_trans(~K, ~cmp, ~o, $KY(a), $KY(e), $KY(b), h1, h3), L.and_right(Cmp.is_lt(cmp($KY(e), $KY(b))), ST.ordered($AK, Con{b, u}), h2))

# dropping an entry keeps the order
def ord_drop($TO, +xs: $ES, +e: $E, +ys: $ES, +h: $ORD($EAPP(xs, Con{e, ys}))) -> $ORD($EAPP(xs, ys)):
  match xs:
    case Nil{}:
      ord_tail($AO, e, ys, h)
    case Con{+a, +t}:
      match t:
        case Nil{}:
          ord_skip($AO, a, e, ys, h)
        case Con{+a2, +u}:
          +h1 = L.and_left(Cmp.is_lt(cmp($KY(a), $KY(a2))), ST.ordered($AK, Con{a2, $EAPP(u, Con{e, ys})}), h)
          +h2 = L.and_right(Cmp.is_lt(cmp($KY(a), $KY(a2))), ST.ordered($AK, Con{a2, $EAPP(u, Con{e, ys})}), h)
          L.and_intro(Cmp.is_lt(cmp($KY(a), $KY(a2))), ST.ordered($AK, Con{a2, $EAPP(u, ys)}), h1, ord_drop($AO, Con{a2, u}, e, ys, h2))
