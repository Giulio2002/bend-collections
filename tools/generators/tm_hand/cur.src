# Cursors: the mirror's cursor holds node ids, the specification's the keys
# at them. A good cursor is over a good shadow, its next and current ids 0 or
# in the tree, and the next one not the current one. (source: tools/generators/tm_hand/cur.src)

%def ND M.Node<K>
%def NL List<&2, $ND>
%def LN List<&2, Nat>
%def CT List<&2, P.Fr>
%def TK ~K: Data, ~V: Data, ~cmp: K -> K -> Cmp
%def TO ~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, ~o: O.Order(~K, ~cmp)
%def AK ~K, ~V, ~cmp
%def AO ~K, ~V, ~cmp, ~o
%def APP(a, b) SC.append(Nat, a, b)
%def IDS(t) ST.ids(t)
%def TN(i, a, b) ST.TN{i, a, b}
%def WH(c, t) $APP(P.before(c), $APP($IDS(t), P.after(c)))
%def REPN(t, p, x) {ST.rep(~K, t, p, x) == True{} : Bool}
%def COKN(c, z, x) {P.ctxok(~K, c, z, x) == True{} : Bool}
%def MEM(y, xs) {HT.memn(y, xs) == True{} : Bool}
%def MC MI.MCursor<K, V>
%def SC_ S.Cursor<K, V>

# the key at an id
def ck(~K: Data, +nl: $NL, +j: Nat) -> Maybe<&2, K>:
  M.node_key(~K, ST.nd(K, nl, j))

# an id is 0 or in the ids
def idok(+xs: $LN, +j: Nat) -> Bool:
  Bool.or(Nat.is_eq(j, 0n), HT.memn(j, xs))

def cmod($TK, c: $MC) -> $SC_:
  match c:
    case MI.MC{ST.SH{n, root, lo, hi, free, +l, d, +nl, +pl, +t, fl}, +nx, +cu, lo2, hi2, fw}:
      S.CR{S.TM{l, ST.ents(~K, ~V, ST.ids(t), nl, pl)}, ck(~K, nl, nx), ck(~K, nl, cu), lo2, hi2, fw}

def cgood($TK, c: $MC) -> Bool:
  match c:
    case MI.MC{ST.SH{+n, +root, +lo, +hi, +free, +l, +d, +nl, +pl, +t, +fl}, +nx, +cu, lo2, hi2, fw}:
      Bool.and(ST.goodF($AK, n, root, lo, hi, free, l, d, nl, pl, t, fl), Bool.and(idok(ST.ids(t), nx), Bool.and(idok(ST.ids(t), cu), Bool.or(Nat.is_eq(nx, 0n), Bool.not(Nat.is_eq(nx, cu))))))

# a mirror cursor result refining a specification's: a good cursor whose real
# cursor the mirror's gives, and whose model the specification's is
def COK($TK, -X: Data, spec: $SC_ & X, mir: $MC & X) -> Type:
  Sigma<&1, &1, $MC, c2 => Sigma<&1, &1, X, o => {MI.rcp($AK, X, mir) == (MI.rc($AK, c2), o) : M.Cursor<K, V, cmp> & X} & ({spec == (cmod($AK, c2), o) : $SC_ & X} & {cgood($AK, c2) == True{} : Bool})>>

def CPOK($TK, -X: Data, spec: $SC_ & X, r: M.Cursor<K, V, cmp> & X) -> Type:
  Sigma<&1, &1, $MC, c2 => Sigma<&1, &1, X, o => {r == (MI.rc($AK, c2), o) : M.Cursor<K, V, cmp> & X} & ({spec == (cmod($AK, c2), o) : $SC_ & X} & {cgood($AK, c2) == True{} : Bool})>>

# a step over the same shadow: the cursor the mirror gives, exactly
def CSTEP($TK, -X: Data, spec: $SC_ & X, mir: $MC & X, +sh: ST.Sh<K, V>, lo2: M.Bound<K>, hi2: M.Bound<K>, +fw: Bool) -> Type:
  Sigma<&1, &1, Nat, nx_ => Sigma<&1, &1, Nat, cu_ => Sigma<&1, &1, X, o => {mir == (MI.MC{sh, nx_, cu_, lo2, hi2, fw}, o) : $MC & X} & ({spec == (cmod($AK, MI.MC{sh, nx_, cu_, lo2, hi2, fw}), o) : $SC_ & X} & {cgood($AK, MI.MC{sh, nx_, cu_, lo2, hi2, fw}) == True{} : Bool})>>>

def cstep_cok($TK, -X: Data, -spec: $SC_ & X, -mir: $MC & X, +sh: ST.Sh<K, V>, +lo2: M.Bound<K>, +hi2: M.Bound<K>, +fw: Bool, p: CSTEP($AK, X, spec, mir, sh, lo2, hi2, fw)) -> COK($AK, X, spec, mir):
  match p:
    case Tuple{+nx, Tuple{+cu, Tuple{+o, Tuple{+h1, rest}}}}:
      (MI.MC{sh, nx, cu, lo2, hi2, fw}, (o, (L.subst($MC & X, z => {MI.rcp($AK, X, z) == (MI.rc($AK, MI.MC{sh, nx, cu, lo2, hi2, fw}), o) : M.Cursor<K, V, cmp> & X}, (MI.MC{sh, nx, cu, lo2, hi2, fw}, o), mir, Equal.sym($MC & X, mir, (MI.MC{sh, nx, cu, lo2, hi2, fw}, o), h1), {==}), rest)))

def cok_cpok($TK, -X: Data, -spec: $SC_ & X, -mir: $MC & X, -r: M.Cursor<K, V, cmp> & X, +hs: {r == MI.rcp($AK, X, mir) : M.Cursor<K, V, cmp> & X}, p: COK($AK, X, spec, mir)) -> CPOK($AK, X, spec, r):
  match p:
    case Tuple{+c2, Tuple{+o, Tuple{+h1, rest}}}:
      (c2, (o, (Equal.trans(M.Cursor<K, V, cmp> & X, r, MI.rcp($AK, X, mir), (MI.rc($AK, c2), o), hs, h1), rest)))

# ---- ids ----

def or_r(+a: Bool, +b: Bool, +h: {b == True{} : Bool}) -> {Bool.or(a, b) == True{} : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      h

def fst0_ok(+xs: $LN) -> {idok(xs, ST.fst0(xs)) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      or_r(Nat.is_eq(x, 0n), HT.memn(x, Con{x, t}), DJ.mem_hd(x, t))

def idok_c(+x: Nat, +xs: $LN, +j: Nat, +h: {idok(xs, j) == True{} : Bool}, +b: Bool, +hb: {Nat.is_eq(j, 0n) == b : Bool}) -> {idok(Con{x, xs}, j) == True{} : Bool}:
  match b:
    case True{}:
      %Equal.sym(Bool, Nat.is_eq(j, 0n), True{}, hb) : {Bool.or(_, HT.memn(j, Con{x, xs})) == True{} : Bool}
      {==}
    case False{}:
      %Equal.sym(Bool, Nat.is_eq(j, 0n), False{}, hb) : {Bool.or(_, HT.memn(j, Con{x, xs})) == True{} : Bool}
      P.mem_cons(j, x, xs, L.subst(Bool, z => {Bool.or(z, HT.memn(j, xs)) == True{} : Bool}, Nat.is_eq(j, 0n), False{}, hb, h))

def idok_cons(+x: Nat, +xs: $LN, +j: Nat, +h: {idok(xs, j) == True{} : Bool}) -> {idok(Con{x, xs}, j) == True{} : Bool}:
  idok_c(x, xs, j, h, Nat.is_eq(j, 0n), {==})

# an id ok in a tail is ok in the list
def lo_up(+x: Nat, +y: Nat, +u: $LN, +h: {idok(Con{y, u}, ST.last0(Con{y, u})) == True{} : Bool}) -> {idok(Con{x, Con{y, u}}, ST.last0(Con{y, u})) == True{} : Bool}:
  idok_cons(x, Con{y, u}, ST.last0(Con{y, u}), h)

def last0_c(+x: Nat, +t: $LN, +ih: {idok(t, ST.last0(t)) == True{} : Bool}) -> {idok(Con{x, t}, ST.last0(Con{x, t})) == True{} : Bool}:
  match t:
    case Nil{}:
      or_r(Nat.is_eq(x, 0n), HT.memn(x, Con{x, Nil{}}), DJ.mem_hd(x, Nil{}))
    case Con{+y, +u}:
      lo_up(x, y, u, ih)

def last0_ok(+xs: $LN) -> {idok(xs, ST.last0(xs)) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      last0_c(x, t, last0_ok(t))


# ---- ranges read the same ----

def oo_eq(+c: Cmp, +b: Bool) -> {M.ordering_ok(c, b) == S.ordering_ok(c, b) : Bool}:
  match c:
    case LT{}:
      {==}
    case EQ{}:
      {==}
    case GT{}:
      {==}

def al_eq($TK, +k: K, +lo: M.Bound<K>) -> {M.above_lower($AK, k, lo) == S.above_lower(~K, ~cmp, k, lo) : Bool}:
  match lo:
    case M.Unbounded{}:
      {==}
    case M.Inclusive{+a}:
      oo_eq(cmp(a, k), True{})
    case M.Exclusive{+a}:
      oo_eq(cmp(a, k), False{})

def bu_eq($TK, +k: K, +hi: M.Bound<K>) -> {M.below_upper($AK, k, hi) == S.below_upper(~K, ~cmp, k, hi) : Bool}:
  match hi:
    case M.Unbounded{}:
      {==}
    case M.Inclusive{+a}:
      oo_eq(cmp(k, a), True{})
    case M.Exclusive{+a}:
      oo_eq(cmp(k, a), False{})

def inr_eq($TK, +k: K, +lo: M.Bound<K>, +hi: M.Bound<K>) -> {M.in_range($AK, k, lo, hi) == S.in_range(~K, ~cmp, k, lo, hi) : Bool}:
  %Equal.sym(Bool, M.above_lower($AK, k, lo), S.above_lower(~K, ~cmp, k, lo), al_eq($AK, k, lo)) : {Bool.and(_, M.below_upper($AK, k, hi)) == S.in_range(~K, ~cmp, k, lo, hi) : Bool}
  %Equal.sym(Bool, M.below_upper($AK, k, hi), S.below_upper(~K, ~cmp, k, hi), bu_eq($AK, k, hi)) : {Bool.and(S.above_lower(~K, ~cmp, k, lo), _) == S.in_range(~K, ~cmp, k, lo, hi) : Bool}
  {==}

# ---- starting a cursor ----

%def FT +n: Nat, +root: Nat, +lo: Nat, +hi: Nat, +free: Nat, +l: Nat, +d: Nat, +nl: $NL, +pl: List<&2, Maybe<&2, V>>, +tg: ST.Tr, +fl: $LN
%def F n, root, lo, hi, free, l, d, nl, pl, tg, fl
%def SH ST.SH{$F}
%def GF {ST.goodF($AK, $F) == True{} : Bool}
%def EST ST.ents(~K, ~V, $IDS(tg), nl, pl)
%def UNB M.Unbounded{}
%def CIT(sp, mc) Sigma<&1, &1, $MC, c2 => {MI.rc($AK, mc) == MI.rc($AK, c2) : M.Cursor<K, V, cmp>} & ({sp == cmod($AK, c2) : $SC_} & {cgood($AK, c2) == True{} : Bool})>
%def OKT EN.oks_tree(~K, ~V, nl, pl, tg, 0n, ST.g_crep($AK, $F, hg), ST.g_cpay($AK, $F, hg))

def or_not(+b: Bool) -> {Bool.or(b, Bool.not(b)) == True{} : Bool}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

def cg_start($TK, $FT, +hg: $GF, +j: Nat, +hj: {idok($IDS(tg), j) == True{} : Bool}, +fw: Bool) -> {cgood($AK, MI.MC{$SH, j, 0n, $UNB, $UNB, fw}) == True{} : Bool}:
  L.and_intro(ST.goodF($AK, $F), Bool.and(idok($IDS(tg), j), Bool.and(idok($IDS(tg), 0n), Bool.or(Nat.is_eq(j, 0n), Bool.not(Nat.is_eq(j, 0n))))), hg, L.and_intro(idok($IDS(tg), j), Bool.and(idok($IDS(tg), 0n), Bool.or(Nat.is_eq(j, 0n), Bool.not(Nat.is_eq(j, 0n)))), hj, L.and_intro(idok($IDS(tg), 0n), Bool.or(Nat.is_eq(j, 0n), Bool.not(Nat.is_eq(j, 0n))), {==}, or_not(Nat.is_eq(j, 0n)))))

def iterator_m($TK, $FT, +hg: $GF) -> $CIT(S.iterator(K, V, ST.model($AK, $SH)), MI.iterator($AK, $SH)):
  %Equal.sym(Nat, lo, ST.fst0($IDS(tg)), N.eq_from_is_eq(lo, ST.fst0($IDS(tg)), ST.g_clo($AK, $F, hg))) : $CIT(S.iterator(K, V, ST.model($AK, $SH)), MI.MC{$SH, _, 0n, $UNB, $UNB, True{}})
  (MI.MC{$SH, ST.fst0($IDS(tg)), 0n, $UNB, $UNB, True{}}, ({==}, (L.subst(Maybe<&2, K>, z => {S.CR{S.TM{l, $EST}, z, None{}, $UNB, $UNB, True{}} == S.CR{S.TM{l, $EST}, ck(~K, nl, ST.fst0($IDS(tg))), None{}, $UNB, $UNB, True{}} : $SC_}, ck(~K, nl, ST.fst0($IDS(tg))), S.key_m(K, V, S.head(M.Entry<K, V>, $EST)), Equal.sym(Maybe<&2, K>, S.key_m(K, V, S.head(M.Entry<K, V>, $EST)), ck(~K, nl, ST.fst0($IDS(tg))), EN.first_key_eq(~K, ~V, nl, pl, $IDS(tg), $OKT)), {==}), cg_start($AK, $F, hg, ST.fst0($IDS(tg)), fst0_ok($IDS(tg)), True{}))))

def descending_iterator_m($TK, $FT, +hg: $GF) -> $CIT(S.descending_iterator(K, V, ST.model($AK, $SH)), MI.descending_iterator($AK, $SH)):
  %Equal.sym(Nat, hi, ST.last0($IDS(tg)), N.eq_from_is_eq(hi, ST.last0($IDS(tg)), ST.g_chi($AK, $F, hg))) : $CIT(S.descending_iterator(K, V, ST.model($AK, $SH)), MI.MC{$SH, _, 0n, $UNB, $UNB, False{}})
  (MI.MC{$SH, ST.last0($IDS(tg)), 0n, $UNB, $UNB, False{}}, ({==}, (L.subst(Maybe<&2, K>, z => {S.CR{S.TM{l, $EST}, z, None{}, $UNB, $UNB, False{}} == S.CR{S.TM{l, $EST}, ck(~K, nl, ST.last0($IDS(tg))), None{}, $UNB, $UNB, False{}} : $SC_}, ck(~K, nl, ST.last0($IDS(tg))), S.key_m(K, V, S.last(M.Entry<K, V>, $EST)), Equal.sym(Maybe<&2, K>, S.key_m(K, V, S.last(M.Entry<K, V>, $EST)), ck(~K, nl, ST.last0($IDS(tg))), EN.last_key_eq(~K, ~V, nl, pl, $IDS(tg), $OKT)), {==}), cg_start($AK, $F, hg, ST.last0($IDS(tg)), last0_ok($IDS(tg)), False{}))))

# ---- has_next: the next id's key in range ----

%def CUR MI.MC{$SH, nx, cu, lo2, hi2, fw}
%def CH +nx: Nat, +cu: Nat, +lo2: M.Bound<K>, +hi2: M.Bound<K>, +fw: Bool, +hc: {cgood($AK, $CUR) == True{} : Bool}
%def HNG(x) COK($AK, Bool, S.iterator_has_next($AK, S.CR{S.TM{l, $EST}, M.node_key(~K, x), ck(~K, nl, cu), lo2, hi2, fw}), MI.iterator_has_checked($AK, nx, cu, lo2, hi2, fw, ($SH, x)))

def has_next_x($TK, $FT, $CH, +x: $ND, +hx: {ST.nd(K, nl, nx) == x : $ND}) -> $HNG(x):
  match x:
    case M.Free{f}:
      ($CUR, (False{}, ({==}, (L.subst(Maybe<&2, K>, z => {(S.CR{S.TM{l, $EST}, None{}, ck(~K, nl, cu), lo2, hi2, fw}, False{}) == (S.CR{S.TM{l, $EST}, z, ck(~K, nl, cu), lo2, hi2, fw}, False{}) : $SC_ & Bool}, None{}, ck(~K, nl, nx), Equal.sym(Maybe<&2, K>, ck(~K, nl, nx), None{}, L.subst($ND, z => {ck(~K, nl, nx) == M.node_key(~K, z) : Maybe<&2, K>}, ST.nd(K, nl, nx), M.Free{f}, hx, {==})), {==}), hc))))
    case M.N{+c0, +x1, +x2, +x3, +k0}:
      +ek = Equal.sym(Maybe<&2, K>, ck(~K, nl, nx), Some{k0}, L.subst($ND, z => {ck(~K, nl, nx) == M.node_key(~K, z) : Maybe<&2, K>}, ST.nd(K, nl, nx), M.N{c0, x1, x2, x3, k0}, hx, {==}))
      +er = inr_eq($AK, k0, lo2, hi2)
      ($CUR, (M.in_range($AK, k0, lo2, hi2), ({==}, (L.subst(Maybe<&2, K>, z => {(S.CR{S.TM{l, $EST}, Some{k0}, ck(~K, nl, cu), lo2, hi2, fw}, S.in_range(~K, ~cmp, k0, lo2, hi2)) == (S.CR{S.TM{l, $EST}, z, ck(~K, nl, cu), lo2, hi2, fw}, M.in_range($AK, k0, lo2, hi2)) : $SC_ & Bool}, Some{k0}, ck(~K, nl, nx), ek, L.subst(Bool, z => {(S.CR{S.TM{l, $EST}, Some{k0}, ck(~K, nl, cu), lo2, hi2, fw}, S.in_range(~K, ~cmp, k0, lo2, hi2)) == (S.CR{S.TM{l, $EST}, Some{k0}, ck(~K, nl, cu), lo2, hi2, fw}, z) : $SC_ & Bool}, S.in_range(~K, ~cmp, k0, lo2, hi2), M.in_range($AK, k0, lo2, hi2), Equal.sym(Bool, M.in_range($AK, k0, lo2, hi2), S.in_range(~K, ~cmp, k0, lo2, hi2), er), {==})), hc))))

def has_next_m($TK, $FT, $CH) -> COK($AK, Bool, S.iterator_has_next($AK, cmod($AK, $CUR)), MI.iterator_has_next($AK, $CUR)):
  has_next_x($AK, $F, nx, cu, lo2, hi2, fw, hc, ST.nd(K, nl, nx), {==})
