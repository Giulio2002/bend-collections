# Removing a found key: the specification's del removes exactly the node's
# entry, and each shape of the node (no left child, no right child, two
# children) gives the unlink and the end of the removal their facts.
# (source: tools/generators/tm_hand/rmd.src)

%include unl.src
%def E M.Entry<K, V>
%def PL1 PR.ex_pl(V, pl, 1n+ui, None{})
%def NLK PR.wr_nl(K, nl, 1n+ui, M.N{c0, a0, b0, q0, ks})
%def PL4 PR.ex_pl(V, PR.ex_pl(V, PR.ex_pl(V, pl, 1n+ui, None{}), 1n+si, None{}), 1n+ui, ST.pv(V, PR.ex_pl(V, pl, 1n+ui, None{}), 1n+si))
%def R4T Sigma<&1, &1, Nat, fr_ => Sigma<&1, &1, List<&2, M.Node<K>>, fn_ => Sigma<&1, &1, ST.Tr, ft_ => {MI.unlink(~K, ~V, ~cmp, ST.SH{n, root, lo, hi, free, l, d, PR.wr_nl(K, nl, 1n+ui, M.N{c0, a0, b0, q0, ks}), PR.ex_pl(V, PR.ex_pl(V, PR.ex_pl(V, pl, 1n+ui, None{}), 1n+si, None{}), 1n+ui, ST.pv(V, PR.ex_pl(V, pl, 1n+ui, None{}), 1n+si)), tg, fl}, 1n+si) == ST.SH{Nat.sub(n, 1n), fr_, lo, hi, 1n+si, l, d, fn_, PR.ex_pl(V, PR.ex_pl(V, PR.ex_pl(V, pl, 1n+ui, None{}), 1n+si, None{}), 1n+ui, ST.pv(V, PR.ex_pl(V, pl, 1n+ui, None{}), 1n+si)), tg, fl} : ST.Sh<K, V>} & {ST.rep(~K, ft_, 0n, fn_) == True{} : Bool} & ({fr_ == ST.rid(ft_) : Nat} & ({ST.ids(ft_) == SC.append(Nat, P.before(cs), SC.append(Nat, ST.ids(sb), P.after(cs))) : List<&2, Nat>} & ({ST.root_black(~K, ft_, fn_) == True{} : Bool} & {ST.ents(~K, ~V, SC.append(Nat, P.before(cs), SC.append(Nat, ST.ids(sb), P.after(cs))), fn_, PR.ex_pl(V, PR.ex_pl(V, PR.ex_pl(V, pl, 1n+ui, None{}), 1n+si, None{}), 1n+ui, ST.pv(V, PR.ex_pl(V, pl, 1n+ui, None{}), 1n+si))) == ST.ents(~K, ~V, SC.append(Nat, P.before(cs), SC.append(Nat, ST.ids(sb), P.after(cs))), PR.wr_nl(K, nl, 1n+ui, M.N{c0, a0, b0, q0, ks}), PR.ex_pl(V, PR.ex_pl(V, PR.ex_pl(V, pl, 1n+ui, None{}), 1n+si, None{}), 1n+ui, ST.pv(V, PR.ex_pl(V, pl, 1n+ui, None{}), 1n+si))) : List<&2, M.Entry<K, V>>} & ({EN.oks(~K, ~V, SC.append(Nat, P.before(cs), SC.append(Nat, ST.ids(sb), P.after(cs))), fn_, PR.ex_pl(V, PR.ex_pl(V, PR.ex_pl(V, pl, 1n+ui, None{}), 1n+si, None{}), 1n+ui, ST.pv(V, PR.ex_pl(V, pl, 1n+ui, None{}), 1n+si))) == True{} : Bool} & ({ST.fll(~K, fn_, Con{1n+si, fl}) == True{} : Bool} & {SC.length(M.Node<K>, fn_) == SC.length(M.Node<K>, PR.wr_nl(K, nl, 1n+ui, M.N{c0, a0, b0, q0, ks})) : Nat})))))>>>
%def R1T Sigma<&1, &1, Nat, fr_ => Sigma<&1, &1, List<&2, M.Node<K>>, fn_ => Sigma<&1, &1, ST.Tr, ft_ => {MI.unlink(~K, ~V, ~cmp, ST.SH{n, root, lo, hi, free, l, d, nl, PR.ex_pl(V, pl, 1n+ui, None{}), tg, fl}, 1n+ui) == ST.SH{Nat.sub(n, 1n), fr_, lo, hi, 1n+ui, l, d, fn_, PR.ex_pl(V, pl, 1n+ui, None{}), tg, fl} : ST.Sh<K, V>} & {ST.rep(~K, ft_, 0n, fn_) == True{} : Bool} & ({fr_ == ST.rid(ft_) : Nat} & ({ST.ids(ft_) == SC.append(Nat, P.before(c), SC.append(Nat, ST.ids(ch), P.after(c))) : List<&2, Nat>} & ({ST.root_black(~K, ft_, fn_) == True{} : Bool} & {ST.ents(~K, ~V, SC.append(Nat, P.before(c), SC.append(Nat, ST.ids(ch), P.after(c))), fn_, PR.ex_pl(V, pl, 1n+ui, None{})) == ST.ents(~K, ~V, SC.append(Nat, P.before(c), SC.append(Nat, ST.ids(ch), P.after(c))), nl, PR.ex_pl(V, pl, 1n+ui, None{})) : List<&2, M.Entry<K, V>>} & ({EN.oks(~K, ~V, SC.append(Nat, P.before(c), SC.append(Nat, ST.ids(ch), P.after(c))), fn_, PR.ex_pl(V, pl, 1n+ui, None{})) == True{} : Bool} & ({ST.fll(~K, fn_, Con{1n+ui, fl}) == True{} : Bool} & {SC.length(M.Node<K>, fn_) == SC.length(M.Node<K>, nl) : Nat})))))>>>
%def EAPP(a, b) SC.append($E, a, b)
%def ENTS(xs) ST.ents(~K, ~V, xs, nl, pl)
%def EST $ENTS($IDS(tg))
%def KY(e) S.key(K, V, e)
%def GF {ST.goodF($AK, $F) == True{} : Bool}
%def ORD(x) {ST.ordered($AK, x) == True{} : Bool}
%def LTA(k, es) {OR.ltall($AK, k, es) == True{} : Bool}
%def DL S.del($AK, k, $EST)
%def XY $APP(xs, ys)
%def HIT +k: K, +i: Nat, +xs: $LN, +ys: $LN, +hW: {$IDS(tg) == $APP(xs, Con{i, ys}) : $LN}, +hfin: {S.is_eq(TR.kc(~K, ~cmp, k, ST.nd(K, nl, i))) == True{} : Bool}, +a0: Nat, +b0: Nat, +q0: Nat, +x: $ND, +m: $MV, +hxi: {ST.nd(K, nl, i) == x : $ND}, +hmi: {ST.pv(V, pl, i) == m : $MV}, +hx: {ST.is_node(K, x, a0, b0, q0) == True{} : Bool}, +hm: {ST.some2(V, m) == True{} : Bool}
%def DHT {$DL == $ENTS($XY) : $ES} & $ORD($DL)
%def EI M.Entry{key, vi}

# the node's entry leaves the entries
def del_hit($TV, $FT, +hg: $GF, $HIT) -> $DHT:
  match x m:
    case M.Free{f} +m:
      Empty.absurd($DHT, L.false_true(hx))
    case M.N{c0, x1, x2, x3, key} None{}:
      Empty.absurd($DHT, L.false_true(hm))
    case M.N{+c0, +x1, +x2, +x3, +key} Some{+vi}:
      +e0 = L.subst($LN, z => {$EST == $ENTS(z) : $ES}, $IDS(tg), $APP(xs, Con{i, ys}), hW, {==})
      +e1 = FI.ents_app(~K, ~V, xs, Con{i, ys}, nl, pl)
      +eent = L.subst($MV, z => {ST.ent(K, V, ST.nd(K, nl, i), ST.pv(V, pl, i)) == ST.ent(K, V, M.N{c0, x1, x2, x3, key}, z) : Maybe<&2, $E>}, ST.pv(V, pl, i), Some{vi}, hmi, L.subst($ND, z => {ST.ent(K, V, ST.nd(K, nl, i), ST.pv(V, pl, i)) == ST.ent(K, V, z, ST.pv(V, pl, i)) : Maybe<&2, $E>}, ST.nd(K, nl, i), M.N{c0, x1, x2, x3, key}, hxi, {==}))
      +e2 = L.subst(Maybe<&2, $E>, z => {$EAPP($ENTS(xs), ST.cons_m($E, ST.ent(K, V, ST.nd(K, nl, i), ST.pv(V, pl, i)), $ENTS(ys))) == $EAPP($ENTS(xs), ST.cons_m($E, z, $ENTS(ys))) : $ES}, ST.ent(K, V, ST.nd(K, nl, i), ST.pv(V, pl, i)), Some{$EI}, eent, {==})
      +hE = Equal.trans($ES, $EST, $ENTS($APP(xs, Con{i, ys})), $EAPP($ENTS(xs), Con{$EI, $ENTS(ys)}), e0, Equal.trans($ES, $ENTS($APP(xs, Con{i, ys})), $EAPP($ENTS(xs), ST.cons_m($E, ST.ent(K, V, ST.nd(K, nl, i), ST.pv(V, pl, i)), $ENTS(ys))), $EAPP($ENTS(xs), Con{$EI, $ENTS(ys)}), e1, e2))
      +hord = L.subst($ES, z => $ORD(z), $EST, $EAPP($ENTS(xs), Con{$EI, $ENTS(ys)}), hE, ST.g_cord($AK, $F, hg))
      +hc = AG.iseq_eq(cmp(k, key), L.subst($ND, z => {S.is_eq(TR.kc(~K, ~cmp, k, z)) == True{} : Bool}, ST.nd(K, nl, i), M.N{c0, x1, x2, x3, key}, hxi, hfin))
      +hlx = L.subst(K, z => $LTA(z, $ENTS(xs)), key, k, Equal.sym(K, k, key, O.antisym(~K, ~cmp, o, k, key, hc)), OR.ord_mid_l($AV, $ENTS(xs), $EI, $ENTS(ys), hord))
      +eD = Equal.trans($ES, $DL, S.del($AK, k, $EAPP($ENTS(xs), Con{$EI, $ENTS(ys)})), $ENTS($XY), L.subst($ES, z => {$DL == S.del($AK, k, z) : $ES}, $EST, $EAPP($ENTS(xs), Con{$EI, $ENTS(ys)}), hE, {==}), Equal.trans($ES, S.del($AK, k, $EAPP($ENTS(xs), Con{$EI, $ENTS(ys)})), $EAPP($ENTS(xs), $ENTS(ys)), $ENTS($XY), DO.del_mid($AV, k, $ENTS(xs), $EI, $ENTS(ys), hlx, hc), Equal.sym($ES, $ENTS($XY), $EAPP($ENTS(xs), $ENTS(ys)), FI.ents_app(~K, ~V, xs, ys, nl, pl))))
      (eD, L.subst($ES, z => $ORD(z), $EAPP($ENTS(xs), $ENTS(ys)), $DL, Equal.sym($ES, $DL, $EAPP($ENTS(xs), $ENTS(ys)), Equal.trans($ES, $DL, $ENTS($XY), $EAPP($ENTS(xs), $ENTS(ys)), eD, FI.ents_app(~K, ~V, xs, ys, nl, pl))), DO.ord_drop($AV, $ENTS(xs), $EI, $ENTS(ys), hord)))

# ---- no left child: the node's right subtree takes its place ----

%def TA $TN($U, $TE, ch)
%def YA $APP($IDS(ch), P.after(c))
%def SH1 ST.SH{n, root, lo, hi, free, l, d, nl, $PL1, tg, fl}
%def ASPC (S.TM{l, $DL}, ST.pv(V, pl, $U))
%def AMIR (MI.refresh_ends($AK, MI.unlink($AK, $SH1, $U)), ST.pv(V, pl, $U))
%def OKT EN.oks_tree(~K, ~V, nl, pl, tg, 0n, ST.g_crep($AK, $F, hg), ST.g_cpay($AK, $F, hg))
%def HOKA L.subst($LN, z => {EN.oks(~K, ~V, z, nl, pl) == True{} : Bool}, $IDS(tg), $WA, hbc, $OKT)
%def AHA k, c, ui, ch, hbc, hplug, hr, hok, hfin
%def AH +k: K, +c: $CT, +ui: Nat, +ch: ST.Tr, +hbc: {$IDS(tg) == $WA : $LN}, +hplug: {tg == PG.plug(c, $TA) : ST.Tr}, +hr: $REPN($TA, P.top(c), nl), +hok: $COKN(c, $U, nl), +hfin: {S.is_eq(TR.kc(~K, ~cmp, k, ST.nd(K, nl, $U))) == True{} : Bool}

# the facts of the unlink: the root, the ids with the free chain, the
# remaining ids' payloads, the free chain, the node in range
def ua_root($TV, $FT, +hg: $GF, $AH) -> {root == ST.rid(PG.plug(c, $TA)) : Nat}:
  Equal.trans(Nat, root, ST.rid(tg), ST.rid(PG.plug(c, $TA)), N.eq_from_is_eq(root, ST.rid(tg), ST.g_croot($AK, $F, hg)), L.subst(ST.Tr, z => {ST.rid(tg) == ST.rid(z) : Nat}, tg, PG.plug(c, $TA), hplug, {==}))

def ua_nd($TV, $FT, +hg: $GF, $AH) -> $NDL($APP($WA, fl)):
  L.subst($LN, z => $NDL($APP(z, fl)), $IDS(tg), $WA, hbc, ST.g_cnd($AK, $F, hg))

def ua_nm($TV, $FT, +hg: $GF, $AH) -> $NMEM($U, $I0):
  DJ.dj_l($I0, Con{$U, fl}, ID.mv_a(fl, c, ui, ch, ua_nd($AV, $F, hg, $AHA)), $U, DJ.mem_hd($U, fl))

%def BC P.before(c)
%def AC P.after(c)

def ua_hk($TV, $FT, +hg: $GF, $AH) -> {EN.oks(~K, ~V, $I0, nl, $PL1) == True{} : Bool}:
  +hb = SL.oks_split_l(~K, ~V, $BC, Con{$U, $YA}, nl, pl, $HOKA)
  +hy = L.and_right(S.is_some($E, ST.ent(K, V, ST.nd(K, nl, $U), ST.pv(V, pl, $U))), EN.oks(~K, ~V, $YA, nl, pl), SL.oks_split_r(~K, ~V, $BC, Con{$U, $YA}, nl, pl, $HOKA))
  Equal.trans(Bool, EN.oks(~K, ~V, $I0, nl, $PL1), EN.oks(~K, ~V, $I0, nl, pl), True{}, SL.oks_pex(~K, ~V, $I0, nl, pl, $U, None{}, ua_nm($AV, $F, hg, $AHA)), EN.oks_app(~K, ~V, nl, pl, $BC, $YA, hb, hy))

def ua_hul($TV, $FT, +hg: $GF, $AH) -> {Nat.is_lt(ui, SC.length($ND, nl)) == True{} : Bool}:
  +hm = L.subst($LN, z => $MEM($U, z), $WA, $IDS(tg), Equal.sym($LN, $IDS(tg), $WA, hbc), DJ.mem_r($U, $BC, Con{$U, $YA}, DJ.mem_hd($U, $YA)))
  +hin = AL.allin_mem($IDS(tg), SC.length($ND, nl), $U, AL.allin_l($IDS(tg), fl, SC.length($ND, nl), ST.g_cin($AK, $F, hg)), hm)
  N.succ_le_lt(ui, SC.length($ND, nl), L.and_right(Nat.is_lt(0n, $U), Nat.is_le($U, SC.length($ND, nl)), hin))

def ua_hm($TV, $FT, +hg: $GF, $AH) -> {ST.some2(V, ST.pv(V, pl, $U)) == True{} : Bool}:
  FI.pay_node(~V, $U, $TE, ch, pl, SL.pay_oks(~K, ~V, $TA, nl, pl, SL.oks_split_l(~K, ~V, $IDS($TA), $AC, nl, pl, SL.oks_split_r(~K, ~V, $BC, $APP($IDS($TA), $AC), nl, pl, $HOKA))))

%def DHTA {$DL == $ENTS($I0) : $ES} & $ORD($DL)

def rm_a3($TV, $FT, +hg: $GF, $AH, +hd1: {$DL == $ENTS($I0) : $ES}, +hd2: $ORD($DL), r: $R1T) -> OK.MOK($AK, $MV, $ASPC, $AMIR):
  +hnd = ID.mv_a(fl, c, ui, ch, ua_nd($AV, $F, hg, $AHA))
  +hin = ID.ain_a(fl, c, ui, ch, SC.length($ND, nl), L.subst($LN, z => $ALLIN($APP(z, fl), SC.length($ND, nl)), $IDS(tg), $WA, hbc, ST.g_cin($AK, $F, hg)))
  +hln0 = L.subst($LN, z => {Nat.is_eq($LEN($APP(z, fl)), SC.length($ND, nl)) == True{} : Bool}, $IDS(tg), $WA, hbc, ST.g_clen($AK, $F, hg))
  +hln = L.subst(Nat, w => {Nat.is_eq(w, SC.length($ND, nl)) == True{} : Bool}, $LEN($APP($WA, fl)), $LEN($APP($I0, Con{$U, fl})), Equal.sym(Nat, $LEN($APP($I0, Con{$U, fl})), $LEN($APP($WA, fl)), ID.len_a(fl, c, ui, ch)), hln0)
  +en = Equal.trans(Nat, n, $LEN($IDS(tg)), 1n+$LEN($I0), N.eq_from_is_eq(n, $LEN($IDS(tg)), ST.g_csz($AK, $F, hg)), Equal.trans(Nat, $LEN($IDS(tg)), $LEN($WA), 1n+$LEN($I0), L.subst($LN, z => {$LEN($IDS(tg)) == $LEN(z) : Nat}, $IDS(tg), $WA, hbc, {==}), ID.sz_a(fl, c, ui, ch)))
  +esub = Equal.trans(Nat, Nat.sub(n, 1n), Nat.sub(1n+$LEN($I0), 1n), $LEN($I0), L.subst(Nat, z => {Nat.sub(n, 1n) == Nat.sub(z, 1n) : Nat}, n, 1n+$LEN($I0), en, {==}), N.add_sub_cancel(1n, $LEN($I0)))
  +hsz = L.subst(Nat, z => {Nat.is_eq(z, $LEN($I0)) == True{} : Bool}, $LEN($I0), Nat.sub(n, 1n), Equal.sym(Nat, Nat.sub(n, 1n), $LEN($I0), esub), N.is_eq_refl($LEN($I0)))
  +hcpl = L.subst(Nat, z => {Nat.is_eq(z, SC.length($ND, nl)) == True{} : Bool}, SC.length($MV, pl), SC.length($MV, $PL1), Equal.sym(Nat, SC.length($MV, $PL1), SC.length($MV, pl), SL.len_ex(V, pl, $U, None{})), ST.g_cpl($AK, $F, hg))
  +hdel = Equal.trans($ES, ST.ents(~K, ~V, $I0, nl, $PL1), $ENTS($I0), $DL, SL.ents_pex(~K, ~V, $I0, nl, pl, $U, None{}, ua_nm($AV, $F, hg, $AHA)), Equal.sym($ES, $DL, $ENTS($I0), hd1))
  RF.rm_fin($AV, n, root, lo, hi, free, l, d, nl, $PL1, tg, fl, fl, c, ui, ch, k, $EST, ST.pv(V, pl, $U), hdel, hd2, hnd, hin, hln, hsz, ST.g_cl($AK, $F, hg), ST.g_cd($AK, $F, hg), ST.g_ccap($AK, $F, hg), hcpl, r)

def rm_a2($TV, $FT, +hg: $GF, $AH, dh: $DHTA, r: $R1T) -> OK.MOK($AK, $MV, $ASPC, $AMIR):
  match dh:
    case Tuple{hd1, hd2}:
      rm_a3($AV, $F, hg, $AHA, hd1, hd2, r)

def rm_a($TV, $FT, +hg: $GF, $AH, r: $R1T) -> OK.MOK($AK, $MV, $ASPC, $AMIR):
  rm_a2($AV, $F, hg, $AHA, del_hit($AV, $F, hg, k, $U, $BC, $YA, hbc, hfin, 0n, ST.rid(ch), P.top(c), ST.nd(K, nl, $U), ST.pv(V, pl, $U), {==}, {==}, TR.rep_node(~K, $U, $TE, ch, P.top(c), nl, hr), ua_hm($AV, $F, hg, $AHA)), r)

# ---- no right child: the node's left subtree takes its place ----

%def TB $TN($U, ch, $TE)
%def XB $APP($BC, $IDS(ch))
%def WQB $APP($XB, Con{$U, $AC})
%def BSH +k: K, +c: $CT, +ui: Nat, +ch: ST.Tr, +hbc: {$IDS(tg) == $WB : $LN}, +hplug: {tg == PG.plug(c, $TB) : ST.Tr}, +hr: $REPN($TB, P.top(c), nl), +hok: $COKN(c, $U, nl), +hfin: {S.is_eq(TR.kc(~K, ~cmp, k, ST.nd(K, nl, $U))) == True{} : Bool}
%def BSA k, c, ui, ch, hbc, hplug, hr, hok, hfin
%def HOKB L.subst($LN, z => {EN.oks(~K, ~V, z, nl, pl) == True{} : Bool}, $IDS(tg), $WB, hbc, $OKT)
%def EWB ID.wb_eq(fl, c, ui, ch)
%def EI0 ID.i0_eq(fl, c, ui, ch)

def ub_nd($TV, $FT, +hg: $GF, $BSH) -> $NDL($APP($WB, fl)):
  L.subst($LN, z => $NDL($APP(z, fl)), $IDS(tg), $WB, hbc, ST.g_cnd($AK, $F, hg))

def ub_nm($TV, $FT, +hg: $GF, $BSH) -> $NMEM($U, $I0):
  DJ.dj_l($I0, Con{$U, fl}, ID.mv_b(fl, c, ui, ch, ub_nd($AV, $F, hg, $BSA)), $U, DJ.mem_hd($U, fl))

def ub_hk($TV, $FT, +hg: $GF, $BSH) -> {EN.oks(~K, ~V, $I0, nl, $PL1) == True{} : Bool}:
  +hq = L.subst($LN, z => {EN.oks(~K, ~V, z, nl, pl) == True{} : Bool}, $WB, $WQB, $EWB, $HOKB)
  +hb = SL.oks_split_l(~K, ~V, $XB, Con{$U, $AC}, nl, pl, hq)
  +hy = L.and_right(S.is_some($E, ST.ent(K, V, ST.nd(K, nl, $U), ST.pv(V, pl, $U))), EN.oks(~K, ~V, $AC, nl, pl), SL.oks_split_r(~K, ~V, $XB, Con{$U, $AC}, nl, pl, hq))
  +hI = L.subst($LN, z => {EN.oks(~K, ~V, z, nl, pl) == True{} : Bool}, $APP($XB, $AC), $I0, $EI0, EN.oks_app(~K, ~V, nl, pl, $XB, $AC, hb, hy))
  Equal.trans(Bool, EN.oks(~K, ~V, $I0, nl, $PL1), EN.oks(~K, ~V, $I0, nl, pl), True{}, SL.oks_pex(~K, ~V, $I0, nl, pl, $U, None{}, ub_nm($AV, $F, hg, $BSA)), hI)

def ub_hul($TV, $FT, +hg: $GF, $BSH) -> {Nat.is_lt(ui, SC.length($ND, nl)) == True{} : Bool}:
  +hm0 = L.subst($LN, z => $MEM($U, z), $WQB, $WB, Equal.sym($LN, $WB, $WQB, $EWB), DJ.mem_r($U, $XB, Con{$U, $AC}, DJ.mem_hd($U, $AC)))
  +hm = L.subst($LN, z => $MEM($U, z), $WB, $IDS(tg), Equal.sym($LN, $IDS(tg), $WB, hbc), hm0)
  +hin = AL.allin_mem($IDS(tg), SC.length($ND, nl), $U, AL.allin_l($IDS(tg), fl, SC.length($ND, nl), ST.g_cin($AK, $F, hg)), hm)
  N.succ_le_lt(ui, SC.length($ND, nl), L.and_right(Nat.is_lt(0n, $U), Nat.is_le($U, SC.length($ND, nl)), hin))

def ub_hm($TV, $FT, +hg: $GF, $BSH) -> {ST.some2(V, ST.pv(V, pl, $U)) == True{} : Bool}:
  FI.pay_node(~V, $U, ch, $TE, pl, SL.pay_oks(~K, ~V, $TB, nl, pl, SL.oks_split_l(~K, ~V, $IDS($TB), $AC, nl, pl, SL.oks_split_r(~K, ~V, $BC, $APP($IDS($TB), $AC), nl, pl, $HOKB))))

%def DHTB {$DL == $ENTS($APP($XB, $AC)) : $ES} & $ORD($DL)

def rm_b3($TV, $FT, +hg: $GF, $BSH, +hd1: {$DL == $ENTS($APP($XB, $AC)) : $ES}, +hd2: $ORD($DL), r: $R1T) -> OK.MOK($AK, $MV, $ASPC, $AMIR):
  +hnd = ID.mv_b(fl, c, ui, ch, ub_nd($AV, $F, hg, $BSA))
  +hin = ID.ain_b(fl, c, ui, ch, SC.length($ND, nl), L.subst($LN, z => $ALLIN($APP(z, fl), SC.length($ND, nl)), $IDS(tg), $WB, hbc, ST.g_cin($AK, $F, hg)))
  +hln0 = L.subst($LN, z => {Nat.is_eq($LEN($APP(z, fl)), SC.length($ND, nl)) == True{} : Bool}, $IDS(tg), $WB, hbc, ST.g_clen($AK, $F, hg))
  +hln = L.subst(Nat, w => {Nat.is_eq(w, SC.length($ND, nl)) == True{} : Bool}, $LEN($APP($WB, fl)), $LEN($APP($I0, Con{$U, fl})), Equal.sym(Nat, $LEN($APP($I0, Con{$U, fl})), $LEN($APP($WB, fl)), ID.len_b(fl, c, ui, ch)), hln0)
  +en = Equal.trans(Nat, n, $LEN($IDS(tg)), 1n+$LEN($I0), N.eq_from_is_eq(n, $LEN($IDS(tg)), ST.g_csz($AK, $F, hg)), Equal.trans(Nat, $LEN($IDS(tg)), $LEN($WB), 1n+$LEN($I0), L.subst($LN, z => {$LEN($IDS(tg)) == $LEN(z) : Nat}, $IDS(tg), $WB, hbc, {==}), ID.sz_b(fl, c, ui, ch)))
  +esub = Equal.trans(Nat, Nat.sub(n, 1n), Nat.sub(1n+$LEN($I0), 1n), $LEN($I0), L.subst(Nat, z => {Nat.sub(n, 1n) == Nat.sub(z, 1n) : Nat}, n, 1n+$LEN($I0), en, {==}), N.add_sub_cancel(1n, $LEN($I0)))
  +hsz = L.subst(Nat, z => {Nat.is_eq(z, $LEN($I0)) == True{} : Bool}, $LEN($I0), Nat.sub(n, 1n), Equal.sym(Nat, Nat.sub(n, 1n), $LEN($I0), esub), N.is_eq_refl($LEN($I0)))
  +hcpl = L.subst(Nat, z => {Nat.is_eq(z, SC.length($ND, nl)) == True{} : Bool}, SC.length($MV, pl), SC.length($MV, $PL1), Equal.sym(Nat, SC.length($MV, $PL1), SC.length($MV, pl), SL.len_ex(V, pl, $U, None{})), ST.g_cpl($AK, $F, hg))
  +hd1b = Equal.trans($ES, $DL, $ENTS($APP($XB, $AC)), $ENTS($I0), hd1, L.subst($LN, z => {$ENTS($APP($XB, $AC)) == $ENTS(z) : $ES}, $APP($XB, $AC), $I0, $EI0, {==}))
  +hdel = Equal.trans($ES, ST.ents(~K, ~V, $I0, nl, $PL1), $ENTS($I0), $DL, SL.ents_pex(~K, ~V, $I0, nl, pl, $U, None{}, ub_nm($AV, $F, hg, $BSA)), Equal.sym($ES, $DL, $ENTS($I0), hd1b))
  RF.rm_fin($AV, n, root, lo, hi, free, l, d, nl, $PL1, tg, fl, fl, c, ui, ch, k, $EST, ST.pv(V, pl, $U), hdel, hd2, hnd, hin, hln, hsz, ST.g_cl($AK, $F, hg), ST.g_cd($AK, $F, hg), ST.g_ccap($AK, $F, hg), hcpl, r)

def rm_b2($TV, $FT, +hg: $GF, $BSH, dh: $DHTB, r: $R1T) -> OK.MOK($AK, $MV, $ASPC, $AMIR):
  match dh:
    case Tuple{hd1, hd2}:
      rm_b3($AV, $F, hg, $BSA, hd1, hd2, r)

def rm_b($TV, $FT, +hg: $GF, $BSH, r: $R1T) -> OK.MOK($AK, $MV, $ASPC, $AMIR):
  rm_b2($AV, $F, hg, $BSA, del_hit($AV, $F, hg, k, $U, $XB, $AC, Equal.trans($LN, $IDS(tg), $WB, $WQB, hbc, $EWB), hfin, ST.rid(ch), 0n, P.top(c), ST.nd(K, nl, $U), ST.pv(V, pl, $U), {==}, {==}, TR.rep_node(~K, $U, ch, $TE, P.top(c), nl, hr), ub_hm($AV, $F, hg, $BSA)), r)

# ---- two children: the successor's key and payload move in, it leaves ----

%def S1 1n+si
%def TS2 $TN($S1, $TE, sb)
%def TT2 $TN($U, ta, tb)
%def CB2 Con{P.FR{$U, False{}, ta}, c}
%def XA2 $APP($BC, $IDS(ta))
%def RR2 $APP($IDS(sb), P.after(cs))
%def PLS2 PR.ex_pl(V, $PL1, $S1, None{})
%def SH4 ST.SH{n, root, lo, hi, free, l, d, $NLK, $PL4, tg, fl}
%def SMIR (MI.refresh_ends($AK, MI.unlink($AK, $SH4, $S1)), ST.pv(V, pl, $U))
%def SSH +k: K, +c: $CT, +ui: Nat, +ta: ST.Tr, +tb: ST.Tr, +cs: $CT, +si: Nat, +sb: ST.Tr, +hbc: {$IDS(tg) == $WH(c, $TT2) : $LN}, +hlw: {$WH(cs, $TS2) == $WH($CB2, tb) : $LN}, +hlb: {P.before(cs) == P.before($CB2) : $LN}, +hr: $REPN($TT2, P.top(c), nl), +hfin: {S.is_eq(TR.kc(~K, ~cmp, k, ST.nd(K, nl, $U))) == True{} : Bool}, +c0: Bool, +a0: Nat, +b0: Nat, +q0: Nat, +ks: K, +cs0: Bool, +as0: Nat, +bs0: Nat, +qs0: Nat, +hsn: {ST.nd(K, nl, $S1) == M.N{cs0, as0, bs0, qs0, ks} : $ND}
%def SSA k, c, ui, ta, tb, cs, si, sb, hbc, hlw, hlb, hr, hfin, c0, a0, b0, q0, ks, cs0, as0, bs0, qs0, hsn
%def RSA k, c, ui, ta, tb, cs, si, sb, hbc, hlw, hlb
%def LS4 c, ui, ta, cs, si, sb
%def HOKT L.subst($LN, z => {EN.oks(~K, ~V, z, nl, pl) == True{} : Bool}, $IDS(tg), $WH(c, $TT2), hbc, $OKT)
%def DHTS {$DL == $ENTS($APP($XA2, Con{$S1, $RR2})) : $ES} & $ORD($DL)

def us_hm($TV, $FT, +hg: $GF, $SSH) -> {ST.some2(V, ST.pv(V, pl, $U)) == True{} : Bool}:
  FI.pay_node(~V, $U, ta, tb, pl, SL.pay_oks(~K, ~V, $TT2, nl, pl, SL.oks_split_l(~K, ~V, $IDS($TT2), $AC, nl, pl, SL.oks_split_r(~K, ~V, $BC, $APP($IDS($TT2), $AC), nl, pl, $HOKT))))

def us_hb($TV, $FT, +hg: $GF, $SSH) -> {Nat.is_lt(ui, SC.length($ND, nl)) == True{} : Bool}:
  +hm = L.subst($LN, z => $MEM($U, z), $APP($XA2, Con{$U, Con{$S1, $RR2}}), $IDS(tg), Equal.sym($LN, $IDS(tg), $APP($XA2, Con{$U, Con{$S1, $RR2}}), RS.eo_s($AV, $F, $RSA)), DJ.mem_r($U, $XA2, Con{$U, Con{$S1, $RR2}}, DJ.mem_hd($U, Con{$S1, $RR2})))
  +hin = AL.allin_mem($IDS(tg), SC.length($ND, nl), $U, AL.allin_l($IDS(tg), fl, SC.length($ND, nl), ST.g_cin($AK, $F, hg)), hm)
  N.succ_le_lt(ui, SC.length($ND, nl), L.and_right(Nat.is_lt(0n, $U), Nat.is_le($U, SC.length($ND, nl)), hin))

# the payload list's length through the exchanges
def us_lp($TV, $FT, +hg: $GF, $SSH) -> {SC.length($ND, nl) == SC.length($MV, $PLS2) : Nat}:
  Equal.sym(Nat, SC.length($MV, $PLS2), SC.length($ND, nl), Equal.trans(Nat, SC.length($MV, $PLS2), SC.length($MV, $PL1), SC.length($ND, nl), SL.len_ex(V, $PL1, $S1, None{}), Equal.trans(Nat, SC.length($MV, $PL1), SC.length($MV, pl), SC.length($ND, nl), SL.len_ex(V, pl, $U, None{}), N.eq_from_is_eq(SC.length($MV, pl), SC.length($ND, nl), ST.g_cpl($AK, $F, hg)))))

def rm_s3($TV, $FT, +hg: $GF, $SSH, +hd1: {$DL == $ENTS($APP($XA2, Con{$S1, $RR2})) : $ES}, +hd2: $ORD($DL), r: $R4T) -> OK.MOK($AK, $MV, $ASPC, $SMIR):
  +hnd = RS.nd_old($AV, $F, hg, $RSA)
  +hb = us_hb($AV, $F, hg, $SSA)
  +hbp = L.subst(Nat, z => {Nat.is_lt(ui, z) == True{} : Bool}, SC.length($ND, nl), SC.length($MV, $PLS2), us_lp($AV, $F, hg, $SSA), hb)
  +hus = RS.us_s($LS4, hnd)
  +enew = RS.ents_new(~K, ~V, nl, pl, ui, si, c0, a0, b0, q0, ks, cs0, as0, bs0, qs0, hb, hbp, hsn, hus, $XA2, $RR2, RS.ux_s($LS4, hnd), RS.sx_s($LS4, hnd), RS.ur_s($LS4, hnd), RS.sr_s($LS4, hnd))
  +hdel = Equal.trans($ES, ST.ents(~K, ~V, $WH(cs, sb), $NLK, $PL4), ST.ents(~K, ~V, $APP($XA2, Con{$U, $RR2}), $NLK, $PL4), $DL, L.subst($LN, z => {ST.ents(~K, ~V, $WH(cs, sb), $NLK, $PL4) == ST.ents(~K, ~V, z, $NLK, $PL4) : $ES}, $WH(cs, sb), $APP($XA2, Con{$U, $RR2}), RS.en_s($AV, $F, $RSA), {==}), Equal.trans($ES, ST.ents(~K, ~V, $APP($XA2, Con{$U, $RR2}), $NLK, $PL4), $ENTS($APP($XA2, Con{$S1, $RR2})), $DL, enew, Equal.sym($ES, $DL, $ENTS($APP($XA2, Con{$S1, $RR2})), hd1)))
  +ews = RS.ew_s($AV, $F, $RSA)
  +hnd0 = L.subst($LN, z => $NDL($APP(z, fl)), $IDS(tg), $WH(cs, $TS2), ews, ST.g_cnd($AK, $F, hg))
  +elw = FRM.len_wr(K, nl, $U, M.N{c0, a0, b0, q0, ks})
  +hin = ID.ain_a(fl, cs, si, sb, SC.length($ND, $NLK), L.subst(Nat, w => $ALLIN($APP($WH(cs, $TS2), fl), w), SC.length($ND, nl), SC.length($ND, $NLK), Equal.sym(Nat, SC.length($ND, $NLK), SC.length($ND, nl), elw), L.subst($LN, z => $ALLIN($APP(z, fl), SC.length($ND, nl)), $IDS(tg), $WH(cs, $TS2), ews, ST.g_cin($AK, $F, hg))))
  +hln0 = L.subst($LN, z => {Nat.is_eq($LEN($APP(z, fl)), SC.length($ND, nl)) == True{} : Bool}, $IDS(tg), $WH(cs, $TS2), ews, ST.g_clen($AK, $F, hg))
  +hln1 = L.subst(Nat, w => {Nat.is_eq(w, SC.length($ND, nl)) == True{} : Bool}, $LEN($APP($WH(cs, $TS2), fl)), $LEN($APP($WH(cs, sb), Con{$S1, fl})), Equal.sym(Nat, $LEN($APP($WH(cs, sb), Con{$S1, fl})), $LEN($APP($WH(cs, $TS2), fl)), ID.len_a(fl, cs, si, sb)), hln0)
  +hln = L.subst(Nat, w => {Nat.is_eq($LEN($APP($WH(cs, sb), Con{$S1, fl})), w) == True{} : Bool}, SC.length($ND, nl), SC.length($ND, $NLK), Equal.sym(Nat, SC.length($ND, $NLK), SC.length($ND, nl), elw), hln1)
  +en = Equal.trans(Nat, n, $LEN($IDS(tg)), 1n+$LEN($WH(cs, sb)), N.eq_from_is_eq(n, $LEN($IDS(tg)), ST.g_csz($AK, $F, hg)), Equal.trans(Nat, $LEN($IDS(tg)), $LEN($WH(cs, $TS2)), 1n+$LEN($WH(cs, sb)), L.subst($LN, z => {$LEN($IDS(tg)) == $LEN(z) : Nat}, $IDS(tg), $WH(cs, $TS2), ews, {==}), ID.sz_a(fl, cs, si, sb)))
  +esub = Equal.trans(Nat, Nat.sub(n, 1n), Nat.sub(1n+$LEN($WH(cs, sb)), 1n), $LEN($WH(cs, sb)), L.subst(Nat, z => {Nat.sub(n, 1n) == Nat.sub(z, 1n) : Nat}, n, 1n+$LEN($WH(cs, sb)), en, {==}), N.add_sub_cancel(1n, $LEN($WH(cs, sb))))
  +hsz = L.subst(Nat, z => {Nat.is_eq(z, $LEN($WH(cs, sb))) == True{} : Bool}, $LEN($WH(cs, sb)), Nat.sub(n, 1n), Equal.sym(Nat, Nat.sub(n, 1n), $LEN($WH(cs, sb)), esub), N.is_eq_refl($LEN($WH(cs, sb))))
  +hcap = L.subst(Nat, w => {Nat.is_le(w, SC.pow2(d)) == True{} : Bool}, SC.length($ND, nl), SC.length($ND, $NLK), Equal.sym(Nat, SC.length($ND, $NLK), SC.length($ND, nl), elw), ST.g_ccap($AK, $F, hg))
  +elp = Equal.trans(Nat, SC.length($MV, $PL4), SC.length($MV, $PLS2), SC.length($ND, nl), SL.len_ex(V, $PLS2, $U, ST.pv(V, $PL1, $S1)), Equal.sym(Nat, SC.length($ND, nl), SC.length($MV, $PLS2), us_lp($AV, $F, hg, $SSA)))
  +hcpl = L.subst(Nat, w => {Nat.is_eq(SC.length($MV, $PL4), w) == True{} : Bool}, SC.length($ND, nl), SC.length($ND, $NLK), Equal.sym(Nat, SC.length($ND, $NLK), SC.length($ND, nl), elw), L.subst(Nat, w => {Nat.is_eq(w, SC.length($ND, nl)) == True{} : Bool}, SC.length($ND, nl), SC.length($MV, $PL4), Equal.sym(Nat, SC.length($MV, $PL4), SC.length($ND, nl), elp), N.is_eq_refl(SC.length($ND, nl))))
  RF.rm_fin($AV, n, root, lo, hi, free, l, d, $NLK, $PL4, tg, fl, fl, cs, si, sb, k, $EST, ST.pv(V, pl, $U), hdel, hd2, ID.mv_a(fl, cs, si, sb, hnd0), hin, hln, hsz, ST.g_cl($AK, $F, hg), ST.g_cd($AK, $F, hg), hcap, hcpl, r)

def rm_s2($TV, $FT, +hg: $GF, $SSH, dh: $DHTS, r: $R4T) -> OK.MOK($AK, $MV, $ASPC, $SMIR):
  match dh:
    case Tuple{hd1, hd2}:
      rm_s3($AV, $F, hg, $SSA, hd1, hd2, r)

def rm_s($TV, $FT, +hg: $GF, $SSH, r: $R4T) -> OK.MOK($AK, $MV, $ASPC, $SMIR):
  rm_s2($AV, $F, hg, $SSA, del_hit($AV, $F, hg, k, $U, $XA2, Con{$S1, $RR2}, RS.eo_s($AV, $F, $RSA), hfin, ST.rid(ta), ST.rid(tb), P.top(c), ST.nd(K, nl, $U), ST.pv(V, pl, $U), {==}, {==}, TR.rep_node(~K, $U, ta, tb, P.top(c), nl, hr), us_hm($AV, $F, hg, $SSA)), r)
