import Base
import ../lib/logic.bend as L
import ../lib/nat.bend as N
import ../lib/list.bend as LL
import ../lib/order.bend as O
import ../spec/common.bend as SC
import ../../src/containers/balanced_search_tree.bend as M
import ../hash_table/state.bend as HT
import ../lru/state.bend as LST
import ../lru/lists.bend as LS
import ./state.bend as ST
import ./mirror.bend as MI
import ./tree.bend as TR
import ./path.bend as P
import ./plug.bend as PG
import ./setters.bend as SE
import ./rotm.bend as RM
import ./rot.bend as RT
import ./nbr.bend as NB
import ./dj.bend as DJ
import ./spath.bend as SP
import ./ends.bend as EN
import ../spec/tree_map.bend as S

# A rotation of the mirror at the subtree a path leads to: its result over
# the node list, the rotated subtree linked, the path leading to it, the
# same ids, the root pointer at the plugged tree's root.
# (source: tools/generators/tm_hand/rotp.src)

%def ND M.Node<K>
%def NL List<&2, $ND>
%def LN List<&2, Nat>
%def CT List<&2, P.Fr>
%def APP(a, b) SC.append(Nat, a, b)
%def IDS(t) ST.ids(t)
%def TN(i, a, b) ST.TN{i, a, b}
%def TK ~K: Data, ~V: Data, ~cmp: K -> K -> Cmp
%def AK ~K, ~V, ~cmp
%def TO ~K: Data, ~cmp: K -> K -> Cmp, ~o: O.Order(~K, ~cmp)
%def TOV ~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, ~o: O.Order(~K, ~cmp)
%def AO ~K, ~cmp, ~o
%def FT +n: Nat, +root: Nat, +lo: Nat, +hi: Nat, +free: Nat, +l: Nat, +d: Nat, +nl: $NL, +pl: List<&2, Maybe<&2, V>>, +tg: ST.Tr, +fl: $LN
%def F n, root, lo, hi, free, l, d, nl, pl, tg, fl
%def SHR(r, x) ST.SH{n, r, lo, hi, free, l, d, x, pl, tg, fl}
%def SH $SHR(root, nl)
%def SHT ST.Sh<K, V>
%def ISN(x, a, b, q) {ST.is_node(K, x, a, b, q) == True{} : Bool}
%def NDX(nl, j) ST.nd(K, nl, j)
%def WH(c, t) $APP(P.before(c), $APP($IDS(t), P.after(c)))
%def REPN(t, p, x) {ST.rep(~K, t, p, x) == True{} : Bool}
%def REP(t, p) $REPN(t, p, nl)
%def COKN(c, x, m) {P.ctxok(~K, c, x, m) == True{} : Bool}
%def COK(c, x) $COKN(c, x, nl)
%def NDL(xs) {LST.nodupn(xs) == True{} : Bool}
%def NMEM(y, xs) {HT.memn(y, xs) == False{} : Bool}
%def BA(c) $APP(P.before(c), P.after(c))

# ---- a node's fields from its links ----

def f_left(-K: Data, +x: $ND, +a: Nat, +b: Nat, +q: Nat, +h: $ISN(x, a, b, q)) -> {M.node_left(~K, x) == a : Nat}:
  match x:
    case M.Free{f}:
      Empty.absurd({M.node_left(~K, M.Free{f}) == a : Nat}, L.false_true(h))
    case M.N{c, +x1, x2, x3, k}:
      N.eq_from_is_eq(x1, a, L.and_left(Nat.is_eq(x1, a), Bool.and(Nat.is_eq(x2, b), Nat.is_eq(x3, q)), h))

def f_right(-K: Data, +x: $ND, +a: Nat, +b: Nat, +q: Nat, +h: $ISN(x, a, b, q)) -> {M.node_right(~K, x) == b : Nat}:
  match x:
    case M.Free{f}:
      Empty.absurd({M.node_right(~K, M.Free{f}) == b : Nat}, L.false_true(h))
    case M.N{c, x1, +x2, x3, k}:
      N.eq_from_is_eq(x2, b, L.and_left(Nat.is_eq(x2, b), Nat.is_eq(x3, q), L.and_right(Nat.is_eq(x1, a), Bool.and(Nat.is_eq(x2, b), Nat.is_eq(x3, q)), h)))

def dir_c(+x: Nat, +lft: Bool, +s: Nat, +h: {Bool.not(Nat.is_eq(x, s)) == True{} : Bool}) -> {Nat.is_eq(ST.pk(Nat, lft, x, s), x) == lft : Bool}:
  match lft:
    case True{}:
      N.is_eq_refl(x)
    case False{}:
      N.is_eq_sym_false(x, s, LS.not_t_f(Nat.is_eq(x, s), h))

# the side the parent's node has x on is the path's
def dir_eq(~K: Data, +nl: $NL, +c: $CT, +x: Nat, +hok: $COK(c, x), +hd: {P.dist(c, x) == True{} : Bool}, +hx: {Nat.is_lt(0n, x) == True{} : Bool}) -> {Nat.is_eq(M.node_left(~K, $NDX(nl, P.top(c))), x) == SP.dir(c) : Bool}:
  match c:
    case Nil{}:
      N.is_eq_sym_false(x, 0n, LS.not_t_f(Nat.is_eq(x, 0n), P.ne_zero(x, hx)))
    case Con{P.FR{+q, +lft, +s}, +u}:
      +hk = L.and_left(P.cok1(~K, P.FR{q, lft, s}, x, P.top(u), nl), P.ctxok(~K, u, q, nl), hok)
      +hn = L.and_left(ST.is_node(K, $NDX(nl, q), ST.pk(Nat, lft, x, ST.rid(s)), ST.pk(Nat, lft, ST.rid(s), x), P.top(u)), ST.rep(~K, s, q, nl), L.and_right(Nat.is_lt(0n, q), Bool.and(ST.is_node(K, $NDX(nl, q), ST.pk(Nat, lft, x, ST.rid(s)), ST.pk(Nat, lft, ST.rid(s), x), P.top(u)), ST.rep(~K, s, q, nl)), hk))
      %Equal.sym(Nat, M.node_left(~K, $NDX(nl, q)), ST.pk(Nat, lft, x, ST.rid(s)), f_left(K, $NDX(nl, q), ST.pk(Nat, lft, x, ST.rid(s)), ST.pk(Nat, lft, ST.rid(s), x), P.top(u), hn)) : {Nat.is_eq(_, x) == lft : Bool}
      dir_c(x, lft, ST.rid(s), L.and_left(Bool.not(Nat.is_eq(x, ST.rid(s))), P.dist(u, q), hd))


# ---- the mirror's rotations at a path ----

%def SUBL $TN(x, ta, $TN(y, tb, tc))
%def SUBL2 $TN(y, $TN(x, ta, tb), tc)
%def SUBR $TN(x, $TN(y, ta, tb), tc)
%def SUBR2 $TN(y, ta, $TN(x, tb, tc))
%def NP M.node_parent(~K, $NDX(nl, x))
%def NRX M.node_right(~K, $NDX(nl, x))
%def NLX M.node_left(~K, $NDX(nl, x))
%def DIRX(z) Nat.is_eq(M.node_left(~K, $NDX(nl, z)), x)

def rl_eq($TK, $FT, +c: $CT, +x: Nat, +y: Nat, +b: Nat, +hxp: {$NP == P.top(c) : Nat}, +hxr: {$NRX == y : Nat}, +hyl: {M.node_left(~K, $NDX(nl, y)) == b : Nat}, +hd: {$DIRX(P.top(c)) == SP.dir(c) : Bool}) -> {MI.rotate_left($AK, $SH, x) == $SHR(RM.rootq(P.top(c), root, y), RM.rotl_nl(K, nl, x, y, b, P.top(c), SP.dir(c))) : $SHT}:
  +e0 = RM.rotate_left_m($AK, $F, x)
  +e1 = L.subst(Nat, z => {MI.rotate_left($AK, $SH, x) == $SHR(RM.rootq(z, root, $NRX), RM.rotl_nl(K, nl, x, $NRX, M.node_left(~K, $NDX(nl, $NRX)), z, $DIRX(z))) : $SHT}, $NP, P.top(c), hxp, e0)
  +e2 = L.subst(Nat, z => {MI.rotate_left($AK, $SH, x) == $SHR(RM.rootq(P.top(c), root, z), RM.rotl_nl(K, nl, x, z, M.node_left(~K, $NDX(nl, z)), P.top(c), $DIRX(P.top(c)))) : $SHT}, $NRX, y, hxr, e1)
  +e3 = L.subst(Nat, z => {MI.rotate_left($AK, $SH, x) == $SHR(RM.rootq(P.top(c), root, y), RM.rotl_nl(K, nl, x, y, z, P.top(c), $DIRX(P.top(c)))) : $SHT}, M.node_left(~K, $NDX(nl, y)), b, hyl, e2)
  L.subst(Bool, z => {MI.rotate_left($AK, $SH, x) == $SHR(RM.rootq(P.top(c), root, y), RM.rotl_nl(K, nl, x, y, b, P.top(c), z)) : $SHT}, $DIRX(P.top(c)), SP.dir(c), hd, e3)

def rr_eq($TK, $FT, +c: $CT, +x: Nat, +y: Nat, +b: Nat, +hxp: {$NP == P.top(c) : Nat}, +hxl: {$NLX == y : Nat}, +hyr: {M.node_right(~K, $NDX(nl, y)) == b : Nat}, +hd: {$DIRX(P.top(c)) == SP.dir(c) : Bool}) -> {MI.rotate_right($AK, $SH, x) == $SHR(RM.rootq(P.top(c), root, y), RM.rotr_nl(K, nl, x, y, b, P.top(c), SP.dir(c))) : $SHT}:
  +e0 = RM.rotate_right_m($AK, $F, x)
  +e1 = L.subst(Nat, z => {MI.rotate_right($AK, $SH, x) == $SHR(RM.rootq(z, root, $NLX), RM.rotr_nl(K, nl, x, $NLX, M.node_right(~K, $NDX(nl, $NLX)), z, $DIRX(z))) : $SHT}, $NP, P.top(c), hxp, e0)
  +e2 = L.subst(Nat, z => {MI.rotate_right($AK, $SH, x) == $SHR(RM.rootq(P.top(c), root, z), RM.rotr_nl(K, nl, x, z, M.node_right(~K, $NDX(nl, z)), P.top(c), $DIRX(P.top(c)))) : $SHT}, $NLX, y, hxl, e1)
  +e3 = L.subst(Nat, z => {MI.rotate_right($AK, $SH, x) == $SHR(RM.rootq(P.top(c), root, y), RM.rotr_nl(K, nl, x, y, z, P.top(c), $DIRX(P.top(c)))) : $SHT}, M.node_right(~K, $NDX(nl, y)), b, hyr, e2)
  L.subst(Bool, z => {MI.rotate_right($AK, $SH, x) == $SHR(RM.rootq(P.top(c), root, y), RM.rotr_nl(K, nl, x, y, b, P.top(c), z)) : $SHT}, $DIRX(P.top(c)), SP.dir(c), hd, e3)

# ---- ids and the root ----

def ids_rl(+x: Nat, +ta: ST.Tr, +y: Nat, +tb: ST.Tr, +tc: ST.Tr) -> {$IDS($SUBL2) == $IDS($SUBL) : $LN}:
  LL.append_assoc(Nat, $IDS(ta), Con{x, $IDS(tb)}, Con{y, $IDS(tc)})

def ids_rr(+x: Nat, +y: Nat, +ta: ST.Tr, +tb: ST.Tr, +tc: ST.Tr) -> {$IDS($SUBR2) == $IDS($SUBR) : $LN}:
  Equal.sym($LN, $IDS($SUBR), $IDS($SUBR2), LL.append_assoc(Nat, $IDS(ta), Con{y, $IDS(tb)}, Con{x, $IDS(tc)}))

def wh_eq(+c: $CT, +t1: ST.Tr, +t2: ST.Tr, +e: {$IDS(t1) == $IDS(t2) : $LN}) -> {$WH(c, t1) == $WH(c, t2) : $LN}:
  L.subst($LN, z => {$WH(c, t1) == $APP(P.before(c), $APP(z, P.after(c))) : $LN}, $IDS(t1), $IDS(t2), e, {==})

def rid_plug_tn(+u: $CT, +p: Nat, +a: ST.Tr, +b: ST.Tr, +a2: ST.Tr, +b2: ST.Tr) -> {ST.rid(PG.plug(u, $TN(p, a, b))) == ST.rid(PG.plug(u, $TN(p, a2, b2))) : Nat}:
  match u:
    case Nil{}:
      {==}
    case Con{P.FR{+q, +lft, +s}, +w}:
      match lft:
        case True{}:
          rid_plug_tn(w, q, $TN(p, a, b), s, $TN(p, a2, b2), s)
        case False{}:
          rid_plug_tn(w, q, s, $TN(p, a, b), s, $TN(p, a2, b2))

# the root after rotating: the rotated subtree's root at the top, else the same
def root_rot(~K: Data, +nl: $NL, +c: $CT, +x: Nat, +y: Nat, +t1: ST.Tr, +t2: ST.Tr, +root: Nat, +hx: {ST.rid(t1) == x : Nat}, +hy: {ST.rid(t2) == y : Nat}, +hok: $COK(c, x), +hroot: {root == ST.rid(PG.plug(c, t1)) : Nat}) -> {RM.rootq(P.top(c), root, y) == ST.rid(PG.plug(c, t2)) : Nat}:
  match c:
    case Nil{}:
      Equal.sym(Nat, ST.rid(t2), y, hy)
    case Con{P.FR{0n, +lft, +s}, +u}:
      Empty.absurd({RM.rootq(0n, root, y) == ST.rid(PG.plug(Con{P.FR{0n, lft, s}, u}, t2)) : Nat}, L.false_true(L.and_left(Nat.is_lt(0n, 0n), Bool.and(ST.is_node(K, $NDX(nl, 0n), ST.pk(Nat, lft, x, ST.rid(s)), ST.pk(Nat, lft, ST.rid(s), x), P.top(u)), ST.rep(~K, s, 0n, nl)), L.and_left(P.cok1(~K, P.FR{0n, lft, s}, x, P.top(u), nl), P.ctxok(~K, u, 0n, nl), hok))))
    case Con{P.FR{1n+j, True{}, +s}, +u}:
      Equal.trans(Nat, root, ST.rid(PG.plug(u, $TN(1n+j, t1, s))), ST.rid(PG.plug(u, $TN(1n+j, t2, s))), hroot, rid_plug_tn(u, 1n+j, t1, s, t2, s))
    case Con{P.FR{1n+j, False{}, +s}, +u}:
      Equal.trans(Nat, root, ST.rid(PG.plug(u, $TN(1n+j, s, t1))), ST.rid(PG.plug(u, $TN(1n+j, s, t2))), hroot, rid_plug_tn(u, 1n+j, s, t1, s, t2))

# ---- facts from no repeated ids ----

def q_notin(~K: Data, +nl: $NL, +c: $CT, +t: ST.Tr, +hr: $REP(t, P.top(c)), +hnd: $NDL($WH(c, t))) -> $NMEM(P.top(c), $IDS(t)):
  match c:
    case Nil{}:
      RT.zero_ids(~K, nl, t, 0n, hr)
    case Con{P.FR{+q, True{}, +s}, +u}:
      DJ.dj_l($IDS(t), Con{q, $APP($IDS(s), P.after(u))}, DJ.ndr(P.before(u), $APP($IDS(t), Con{q, $APP($IDS(s), P.after(u))}), hnd), q, DJ.mem_hd(q, $APP($IDS(s), P.after(u))))
    case Con{P.FR{+q, False{}, +s}, +u}:
      DJ.nm_l(q, $IDS(t), P.after(u), DJ.dj_r($APP(P.before(u), $APP($IDS(s), Con{q, Nil{}})), $APP($IDS(t), P.after(u)), hnd, q, DJ.mem_r(q, P.before(u), $APP($IDS(s), Con{q, Nil{}}), DJ.mem_r(q, $IDS(s), Con{q, Nil{}}, DJ.mem_hd(q, Nil{})))))

def w_notin(+c: $CT, +t: ST.Tr, +hnd: $NDL($WH(c, t)), +w: Nat, +hw: {HT.memn(w, $IDS(t)) == True{} : Bool}) -> $NMEM(w, $BA(c)):
  DJ.nm_app(w, P.before(c), P.after(c), DJ.dj_l(P.before(c), $APP($IDS(t), P.after(c)), hnd, w, DJ.mem_l(w, $IDS(t), P.after(c), hw)), DJ.dj_r($IDS(t), P.after(c), DJ.ndr(P.before(c), $APP($IDS(t), P.after(c)), hnd), w, hw))

def nd_sub(+c: $CT, +t: ST.Tr, +hnd: $NDL($WH(c, t))) -> $NDL($IDS(t)):
  DJ.ndl($IDS(t), P.after(c), DJ.ndr(P.before(c), $APP($IDS(t), P.after(c)), hnd))

# ---- rotating along a path ----

%def PH +c: $CT, +x: Nat, +ta: ST.Tr, +y: Nat, +tb: ST.Tr, +tc: ST.Tr
%def PA c, x, ta, y, tb, tc
%def HBL +hr: $REP($SUBL, P.top(c)), +hok: $COK(c, x), +hnd: $NDL($WH(c, $SUBL))
%def HBR +hr: $REP($SUBR, P.top(c)), +hok: $COK(c, x), +hnd: $NDL($WH(c, $SUBR))
%def H0X L.and_left(Nat.is_lt(0n, x), Bool.and(ST.is_node(K, $NDX(nl, x), ST.rid(ta), y, P.top(c)), Bool.and(ST.rep(~K, ta, x, nl), ST.rep(~K, $TN(y, tb, tc), x, nl))), hr)
%def H0XR L.and_left(Nat.is_lt(0n, x), Bool.and(ST.is_node(K, $NDX(nl, x), y, ST.rid(tc), P.top(c)), Bool.and(ST.rep(~K, $TN(y, ta, tb), x, nl), ST.rep(~K, tc, x, nl))), hr)
%def HXN TR.rep_node(~K, x, ta, $TN(y, tb, tc), P.top(c), nl, hr)
%def HXNR TR.rep_node(~K, x, $TN(y, ta, tb), tc, P.top(c), nl, hr)
%def HY TR.rep_r(~K, x, ta, $TN(y, tb, tc), P.top(c), nl, hr)
%def HYQ TR.rep_l(~K, x, $TN(y, ta, tb), tc, P.top(c), nl, hr)
%def HYN TR.rep_node(~K, y, tb, tc, x, nl, $HY)
%def HYNR TR.rep_node(~K, y, ta, tb, x, nl, $HYQ)
%def H0Y L.and_left(Nat.is_lt(0n, y), Bool.and(ST.is_node(K, $NDX(nl, y), ST.rid(tb), ST.rid(tc), x), Bool.and(ST.rep(~K, tb, y, nl), ST.rep(~K, tc, y, nl))), $HY)
%def H0YR L.and_left(Nat.is_lt(0n, y), Bool.and(ST.is_node(K, $NDX(nl, y), ST.rid(ta), ST.rid(tb), x), Bool.and(ST.rep(~K, ta, y, nl), ST.rep(~K, tb, y, nl))), $HYQ)
%def DISTX(sub_l, sub_r, h0) P.nd_dist(~K, nl, c, x, sub_l, sub_r, h0, hok, hnd)
%def R1L $APP($IDS(tb), Con{y, $IDS(tc)})

def rotl_path_eq($TOV, $FT, $PH, $HBL) -> {MI.rotate_left(~K, ~V, ~cmp, $SH, x) == $SHR(RM.rootq(P.top(c), root, y), RM.rotl_nl(K, nl, x, y, ST.rid(tb), P.top(c), SP.dir(c))) : $SHT}:
  rl_eq(~K, ~V, ~cmp, $F, c, x, y, ST.rid(tb), NB.parent_eq(~K, $NDX(nl, x), ST.rid(ta), y, P.top(c), $HXN), f_right(K, $NDX(nl, x), ST.rid(ta), y, P.top(c), $HXN), f_left(K, $NDX(nl, y), ST.rid(tb), ST.rid(tc), x, $HYN), dir_eq(~K, nl, c, x, hok, $DISTX(ta, $TN(y, tb, tc), $H0X), $H0X))

def rotr_path_eq($TOV, $FT, $PH, $HBR) -> {MI.rotate_right(~K, ~V, ~cmp, $SH, x) == $SHR(RM.rootq(P.top(c), root, y), RM.rotr_nl(K, nl, x, y, ST.rid(tb), P.top(c), SP.dir(c))) : $SHT}:
  rr_eq(~K, ~V, ~cmp, $F, c, x, y, ST.rid(tb), NB.parent_eq(~K, $NDX(nl, x), y, ST.rid(tc), P.top(c), $HXNR), f_left(K, $NDX(nl, x), y, ST.rid(tc), P.top(c), $HXNR), f_right(K, $NDX(nl, y), ST.rid(ta), ST.rid(tb), x, $HYNR), dir_eq(~K, nl, c, x, hok, $DISTX($TN(y, ta, tb), tc, $H0XR), $H0XR))

def rotl_path_rep($TO, +nl: $NL, $PH, $HBL) -> $REPN($SUBL2, P.top(c), RM.rotl_nl(K, nl, x, y, ST.rid(tb), P.top(c), SP.dir(c))):
  RT.rotl_rep($AO, nl, x, ta, y, tb, tc, P.top(c), SP.dir(c), $H0X, $H0Y, $HXN, $HYN, TR.rep_l(~K, x, ta, $TN(y, tb, tc), P.top(c), nl, hr), TR.rep_l(~K, y, tb, tc, x, nl, $HY), TR.rep_r(~K, y, tb, tc, x, nl, $HY), nd_sub(c, $SUBL, hnd), q_notin(~K, nl, c, $SUBL, hr, hnd))

def rotr_path_rep($TO, +nl: $NL, $PH, $HBR) -> $REPN($SUBR2, P.top(c), RM.rotr_nl(K, nl, x, y, ST.rid(tb), P.top(c), SP.dir(c))):
  RT.rotr_rep($AO, nl, x, y, ta, tb, tc, P.top(c), SP.dir(c), $H0XR, $H0YR, $HXNR, $HYNR, TR.rep_l(~K, y, ta, tb, x, nl, $HYQ), TR.rep_r(~K, y, ta, tb, x, nl, $HYQ), TR.rep_r(~K, x, $TN(y, ta, tb), tc, P.top(c), nl, hr), nd_sub(c, $SUBR, hnd), q_notin(~K, nl, c, $SUBR, hr, hnd))

%def MXL DJ.mem_r(x, $IDS(ta), Con{x, $R1L}, DJ.mem_hd(x, $R1L))
%def MYL DJ.mem_r(y, $IDS(ta), Con{x, $R1L}, DJ.mem_tl(y, x, $R1L, DJ.mem_r(y, $IDS(tb), Con{y, $IDS(tc)}, DJ.mem_hd(y, $IDS(tc)))))
%def BAD RT.nd_drop(P.before(c), $IDS($SUBL), P.after(c), hnd)

def rotl_path_ctx($TO, +nl: $NL, $PH, $HBL) -> $COKN(c, y, RM.rotl_nl(K, nl, x, y, ST.rid(tb), P.top(c), SP.dir(c))):
  match tb:
    case ST.TE{}:
      RT.rotl_ctx($AO, nl, c, x, y, 0n, hok, w_notin(c, $TN(x, ta, $TN(y, ST.TE{}, tc)), hnd, x, DJ.mem_r(x, $IDS(ta), Con{x, Con{y, $IDS(tc)}}, DJ.mem_hd(x, Con{y, $IDS(tc)}))), w_notin(c, $TN(x, ta, $TN(y, ST.TE{}, tc)), hnd, y, DJ.mem_r(y, $IDS(ta), Con{x, Con{y, $IDS(tc)}}, DJ.mem_tl(y, x, Con{y, $IDS(tc)}, DJ.mem_hd(y, $IDS(tc))))), RT.zero_ctx(~K, nl, c, x, hok), RT.nd_drop(P.before(c), $IDS($TN(x, ta, $TN(y, ST.TE{}, tc))), P.after(c), hnd))
    case ST.TN{+b, +b1, +b2}:
      +mb = DJ.mem_r(b, $IDS(ta), Con{x, $APP($IDS($TN(b, b1, b2)), Con{y, $IDS(tc)})}, DJ.mem_tl(b, x, $APP($IDS($TN(b, b1, b2)), Con{y, $IDS(tc)}), DJ.mem_l(b, $IDS($TN(b, b1, b2)), Con{y, $IDS(tc)}, P.mem_root(b, b1, b2))))
