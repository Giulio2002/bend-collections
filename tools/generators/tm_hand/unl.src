# Unlinking a node with at most one child: its child's subtree takes its
# place under its parent (or becomes the root); the path then leads to the
# child, the ids lose the node, and the node joins the free chain.
# (source: tools/generators/tm_hand/unl.src)

%def ND M.Node<K>
%def NL List<&2, $ND>
%def LN List<&2, Nat>
%def CT List<&2, P.Fr>
%def APP(a, b) SC.append(Nat, a, b)
%def IDS(t) ST.ids(t)
%def TN(i, a, b) ST.TN{i, a, b}
%def TE ST.TE{}
%def TO ~K: Data, ~cmp: K -> K -> Cmp, ~o: O.Order(~K, ~cmp)
%def AO ~K, ~cmp, ~o
%def NDX(nl, j) ST.nd(K, nl, j)
%def WH(c, t) $APP(P.before(c), $APP($IDS(t), P.after(c)))
%def BA(c) $APP(P.before(c), P.after(c))
%def REPN(t, p, x) {ST.rep(~K, t, p, x) == True{} : Bool}
%def COKN(c, z, x) {P.ctxok(~K, c, z, x) == True{} : Bool}
%def NDL(xs) {LST.nodupn(xs) == True{} : Bool}
%def NMEM(y, xs) {HT.memn(y, xs) == False{} : Bool}
%def MEM(y, xs) {HT.memn(y, xs) == True{} : Bool}
%def AGR(xs, a, b) {AG.agr(~K, ~cmp, xs, a, b) == True{} : Bool}
%def LEN(xs) SC.length(Nat, xs)
%def ALLIN(xs, n) {ST.allin(xs, n) == True{} : Bool}
%def INB(x, n) Bool.and(Nat.is_lt(0n, x), Nat.is_le(x, n))
%def MV0 $APP($APP(b, a), Con{x, t})
%def MV1 $APP($APP(b, Con{x, a}), t)

# ---- the ids: the node moves from the tree's ids to the free chain ----

def nd_back(+b: $LN, +a: $LN, +x: Nat, +t: $LN, +h: $NDL($MV1)) -> $NDL($MV0):
  +h1 = L.subst($LN, z => $NDL(z), $MV1, $APP(b, Con{x, $APP(a, t)}), AL.mv_eq(b, a, x, t), h)
  +h2 = L.subst(Bool, w => {w == True{} : Bool}, LST.nodupn($APP(b, Con{x, $APP(a, t)})), Bool.and(LST.nodupn($APP(b, $APP(a, t))), Bool.not(HT.memn(x, $APP(b, $APP(a, t))))), LS.nd_mid(b, x, $APP(a, t)), h1)
  +h3 = L.subst($LN, z => {Bool.and(LST.nodupn(z), Bool.not(HT.memn(x, z))) == True{} : Bool}, $APP(b, $APP(a, t)), $APP($APP(b, a), t), Equal.sym($LN, $APP($APP(b, a), t), $APP(b, $APP(a, t)), LL.append_assoc(Nat, b, a, t)), h2)
  L.subst(Bool, w => {w == True{} : Bool}, Bool.and(LST.nodupn($APP($APP(b, a), t)), Bool.not(HT.memn(x, $APP($APP(b, a), t)))), LST.nodupn($MV0), Equal.sym(Bool, LST.nodupn($MV0), Bool.and(LST.nodupn($APP($APP(b, a), t)), Bool.not(HT.memn(x, $APP($APP(b, a), t)))), LS.nd_mid($APP(b, a), x, t)), h3)

def allin_back(+b: $LN, +a: $LN, +x: Nat, +t: $LN, +n: Nat, +h: $ALLIN($MV1, n)) -> $ALLIN($MV0, n):
  +hbx = AL.allin_l($APP(b, Con{x, a}), t, n, h)
  +ht = AL.allin_r($APP(b, Con{x, a}), t, n, h)
  +hxa = AL.allin_r(b, Con{x, a}, n, hbx)
  +hx = L.and_left($INB(x, n), ST.allin(a, n), hxa)
  AL.allin_app($APP(b, a), Con{x, t}, n, AL.allin_app(b, a, n, AL.allin_l(b, Con{x, a}, n, hbx), L.and_right($INB(x, n), ST.allin(a, n), hxa)), L.and_intro($INB(x, n), ST.allin(t, n), hx, ht))

# ---- reattaching: the child's subtree under the unlinked node's parent ----

%def A3(q, x, dr) RM.attn(K, nl, q, x, dr)
%def N3(q, x, dr) SE.setp(K, $A3(q, x, dr), x, q)

# the child's links: its root now points up to q
def ratt_rep($TO, +nl: $NL, +q: Nat, +dr: Bool, +u: Nat, +ch: ST.Tr, +hr: $REPN(ch, u, nl), +hq: $NMEM(q, $IDS(ch)), +hnd: $NDL($IDS(ch))) -> $REPN(ch, q, $N3(q, ST.rid(ch), dr)):
  match ch:
    case ST.TE{}:
      {==}
    case ST.TN{+x, +cl, +cr}:
      +hqx = Pair.fst({Nat.is_eq(x, q) == False{} : Bool}, {HT.memn(q, $IDS(cl)) == False{} : Bool} & {HT.memn(q, $IDS(cr)) == False{} : Bool}, FRM.nm_node(q, x, cl, cr, hq))
      +hql = Pair.fst({HT.memn(q, $IDS(cl)) == False{} : Bool}, {HT.memn(q, $IDS(cr)) == False{} : Bool}, Pair.snd({Nat.is_eq(x, q) == False{} : Bool}, {HT.memn(q, $IDS(cl)) == False{} : Bool} & {HT.memn(q, $IDS(cr)) == False{} : Bool}, FRM.nm_node(q, x, cl, cr, hq)))
      +hqr = Pair.snd({HT.memn(q, $IDS(cl)) == False{} : Bool}, {HT.memn(q, $IDS(cr)) == False{} : Bool}, Pair.snd({Nat.is_eq(x, q) == False{} : Bool}, {HT.memn(q, $IDS(cl)) == False{} : Bool} & {HT.memn(q, $IDS(cr)) == False{} : Bool}, FRM.nm_node(q, x, cl, cr, hq)))
      +hxl = DJ.dj_l($IDS(cl), Con{x, $IDS(cr)}, hnd, x, DJ.mem_hd(x, $IDS(cr)))
      +hxr = DJ.nd_head(x, $IDS(cr), DJ.ndr($IDS(cl), Con{x, $IDS(cr)}, hnd))
      +e = Equal.trans($ND, $NDX($N3(q, x, dr), x), SE.modp(K, $NDX($A3(q, x, dr), x), q), SE.modp(K, $NDX(nl, x), q), RN.hitp(K, $A3(q, x, dr), x, q), L.subst($ND, z => {SE.modp(K, $NDX($A3(q, x, dr), x), q) == SE.modp(K, z, q) : $ND}, $NDX($A3(q, x, dr), x), $NDX(nl, x), RN.skipa(K, nl, q, x, dr, x, FRM.ne_sym(x, q, hqx)), {==}))
      +isn = L.subst($ND, z => {ST.is_node(K, z, ST.rid(cl), ST.rid(cr), q) == True{} : Bool}, SE.modp(K, $NDX(nl, x), q), $NDX($N3(q, x, dr), x), Equal.sym($ND, $NDX($N3(q, x, dr), x), SE.modp(K, $NDX(nl, x), q), e), RN.isn_p(K, $NDX(nl, x), ST.rid(cl), ST.rid(cr), u, q, TR.rep_node(~K, x, cl, cr, u, nl, hr)))
      +hl = RT.rep_moved($AO, cl, x, nl, $N3(q, x, dr), AG.agr_trans($AO, $IDS(cl), nl, $A3(q, x, dr), $N3(q, x, dr), RN.attn_agr($AO, $IDS(cl), nl, q, x, dr, hql), SE.setp_agr($AO, $IDS(cl), $A3(q, x, dr), x, q, hxl)), TR.rep_l(~K, x, cl, cr, u, nl, hr))
      +hrr = RT.rep_moved($AO, cr, x, nl, $N3(q, x, dr), AG.agr_trans($AO, $IDS(cr), nl, $A3(q, x, dr), $N3(q, x, dr), RN.attn_agr($AO, $IDS(cr), nl, q, x, dr, hqr), SE.setp_agr($AO, $IDS(cr), $A3(q, x, dr), x, q, hxr)), TR.rep_r(~K, x, cl, cr, u, nl, hr))
      RT.rep_intro(~K, $N3(q, x, dr), x, cl, cr, q, L.and_left(Nat.is_lt(0n, x), Bool.and(ST.is_node(K, $NDX(nl, x), ST.rid(cl), ST.rid(cr), u), Bool.and(ST.rep(~K, cl, x, nl), ST.rep(~K, cr, x, nl))), hr), isn, hl, hrr)

%def N3A SE.setp(K, RM.attn(K, nla, P.top(c), x, SP.dir(c)), x, P.top(c))
%def RH +nl: $NL, +nla: $NL, +c: $CT, +x: Nat, +z0: Nat, +hc0: $COKN(c, z0, nl), +hnd: $NDL($BA(c)), +hag: $AGR($BA(c), nl, nla), +hxf: $NMEM(x, $BA(c))
%def FRC(q, lft, s, u) Con{P.FR{q, lft, s}, u}
%def NQ(i, lft) SE.setp(K, RM.attn(K, nla, 1n+i, x, lft), x, 1n+i)
%def CK(i, lft, s, u, z, m) P.cok1(~K, P.FR{1n+i, lft, s}, z, P.top(u), m)
%def NODEQ(i, lft, s, u, z, m) ST.is_node(K, ST.nd(K, m, 1n+i), ST.pk(Nat, lft, z, ST.rid(s)), ST.pk(Nat, lft, ST.rid(s), z), P.top(u))
%def AGS(xs, i, lft, ha, hq, hx) AG.agr_trans($AO, xs, nl, RM.attn(K, nla, 1n+i, x, lft), $NQ(i, lft), AG.agr_trans($AO, xs, nl, nla, RM.attn(K, nla, 1n+i, x, lft), ha, RN.attn_agr($AO, xs, nla, 1n+i, x, lft, hq)), SE.setp_agr($AO, xs, RM.attn(K, nla, 1n+i, x, lft), x, 1n+i, hx))

# the parent's frame after reattaching: x on the path's side where z0 was
def ratt_frame($TO, +nl: $NL, +nla: $NL, +x: Nat, +z0: Nat, +i: Nat, +lft: Bool, +s: ST.Tr, +u: $CT, +hc0: $COKN($FRC(1n+i, lft, s, u), z0, nl), +hnd: $NDL($BA($FRC(1n+i, lft, s, u))), +hags: $AGR($IDS(s), nl, nla), +hagu: $AGR($BA(u), nl, nla), +hagq: {$NDX(nl, 1n+i) == $NDX(nla, 1n+i) : $ND}, +hq: {Nat.is_eq(x, 1n+i) == False{} : Bool}, +hxf: $NMEM(x, $BA($FRC(1n+i, lft, s, u)))) -> $COKN($FRC(1n+i, lft, s, u), x, $NQ(i, lft)):
  +hk = L.and_left($CK(i, lft, s, u, z0, nl), P.ctxok(~K, u, 1n+i, nl), hc0)
  +hu = L.and_right($CK(i, lft, s, u, z0, nl), P.ctxok(~K, u, 1n+i, nl), hc0)
  +h0 = L.and_left(Nat.is_lt(0n, 1n+i), Bool.and($NODEQ(i, lft, s, u, z0, nl), ST.rep(~K, s, 1n+i, nl)), hk)
  +hqn = L.and_left($NODEQ(i, lft, s, u, z0, nl), ST.rep(~K, s, 1n+i, nl), L.and_right(Nat.is_lt(0n, 1n+i), Bool.and($NODEQ(i, lft, s, u, z0, nl), ST.rep(~K, s, 1n+i, nl)), hk))
  +hs = L.and_right($NODEQ(i, lft, s, u, z0, nl), ST.rep(~K, s, 1n+i, nl), L.and_right(Nat.is_lt(0n, 1n+i), Bool.and($NODEQ(i, lft, s, u, z0, nl), ST.rep(~K, s, 1n+i, nl)), hk))
  +qs = Pair.fst($NMEM(1n+i, $IDS(s)), $NMEM(1n+i, $BA(u)), RT.fq_s(1n+i, lft, s, u, hnd))
  +qu = Pair.snd($NMEM(1n+i, $IDS(s)), $NMEM(1n+i, $BA(u)), RT.fq_s(1n+i, lft, s, u, hnd))
  +xs = Pair.fst($NMEM(x, $IDS(s)), $NMEM(x, $BA(u)), RT.fw_s(x, 1n+i, lft, s, u, hxf))
  +xu = Pair.snd($NMEM(x, $IDS(s)), $NMEM(x, $BA(u)), RT.fw_s(x, 1n+i, lft, s, u, hxf))
  +e1 = Equal.trans($ND, $NDX($NQ(i, lft), 1n+i), $NDX(RM.attn(K, nla, 1n+i, x, lft), 1n+i), RN.moda(K, $NDX(nl, 1n+i), x, lft), RN.skipp(K, RM.attn(K, nla, 1n+i, x, lft), x, 1n+i, 1n+i, hq), Equal.trans($ND, $NDX(RM.attn(K, nla, 1n+i, x, lft), 1n+i), RN.moda(K, $NDX(nla, 1n+i), x, lft), RN.moda(K, $NDX(nl, 1n+i), x, lft), RN.hita(K, nla, i, x, lft), L.subst($ND, z => {RN.moda(K, $NDX(nla, 1n+i), x, lft) == RN.moda(K, z, x, lft) : $ND}, $NDX(nla, 1n+i), $NDX(nl, 1n+i), Equal.sym($ND, $NDX(nl, 1n+i), $NDX(nla, 1n+i), hagq), {==})))
  +rq = L.subst($ND, z => {ST.is_node(K, z, ST.pk(Nat, lft, x, ST.rid(s)), ST.pk(Nat, lft, ST.rid(s), x), P.top(u)) == True{} : Bool}, RN.moda(K, $NDX(nl, 1n+i), x, lft), $NDX($NQ(i, lft), 1n+i), Equal.sym($ND, $NDX($NQ(i, lft), 1n+i), RN.moda(K, $NDX(nl, 1n+i), x, lft), e1), RN.isn_a(K, $NDX(nl, 1n+i), lft, z0, ST.rid(s), P.top(u), x, hqn))
  +hs2 = RT.rep_moved($AO, s, 1n+i, nl, $NQ(i, lft), $AGS($IDS(s), i, lft, hags, qs, xs), hs)
  +hu2 = Equal.trans(Bool, P.ctxok(~K, u, 1n+i, $NQ(i, lft)), P.ctxok(~K, u, 1n+i, nl), True{}, AG.ctx_agr($AO, u, 1n+i, nl, $NQ(i, lft), $AGS($BA(u), i, lft, hagu, qu, xu)), hu)
  L.and_intro(P.cok1(~K, P.FR{1n+i, lft, s}, x, P.top(u), $NQ(i, lft)), P.ctxok(~K, u, 1n+i, $NQ(i, lft)), L.and_intro(Nat.is_lt(0n, 1n+i), Bool.and($NODEQ(i, lft, s, u, x, $NQ(i, lft)), ST.rep(~K, s, 1n+i, $NQ(i, lft))), h0, L.and_intro($NODEQ(i, lft, s, u, x, $NQ(i, lft)), ST.rep(~K, s, 1n+i, $NQ(i, lft)), rq, hs2)), hu2)

%def AGHD(j, t, a, b, h) AG.agr_head($AO, j, t, a, b, h)
%def AGTL(j, t, a, b, h) L.and_right(AG.ndeq(~K, ~cmp, $NDX(a, j), $NDX(b, j)), AG.agr(~K, ~cmp, t, a, b), h)
%def IS $IDS(s)
%def BU P.before(u)
%def AU P.after(u)

# the path leads to the reattached child
def ratt_ctx($TO, $RH) -> $COKN(c, x, $N3A):
  match c:
    case Nil{}:
      {==}
    case Con{P.FR{0n, +lft, +s}, +u}:
      Empty.absurd($COKN($FRC(0n, lft, s, u), x, SE.setp(K, RM.attn(K, nla, 0n, x, lft), x, 0n)), L.false_true(L.and_left(Nat.is_lt(0n, 0n), Bool.and($NODEQ(0n, lft, s, u, z0, nl), ST.rep(~K, s, 0n, nl)), L.and_left(P.cok1(~K, P.FR{0n, lft, s}, z0, P.top(u), nl), P.ctxok(~K, u, 0n, nl), hc0))))
    case Con{P.FR{1n+i, True{}, +s}, +u}:
      +h1 = AG.agr_r($AO, $BU, Con{1n+i, $APP($IS, $AU)}, nl, nla, hag)
      +h2 = $AGTL(1n+i, $APP($IS, $AU), nl, nla, h1)
      +hq = N.is_eq_sym_false(x, 1n+i, DJ.ne_nm(x, 1n+i, $BA($FRC(1n+i, True{}, s, u)), hxf, FX.q_in(1n+i, True{}, s, u)))
      ratt_frame($AO, nl, nla, x, z0, i, True{}, s, u, hc0, hnd, AG.agr_l($AO, $IS, $AU, nl, nla, h2), AG.agr_app($AO, $BU, $AU, nl, nla, AG.agr_l($AO, $BU, Con{1n+i, $APP($IS, $AU)}, nl, nla, hag), AG.agr_r($AO, $IS, $AU, nl, nla, h2)), $AGHD(1n+i, $APP($IS, $AU), nl, nla, h1), N.is_eq_sym_false(1n+i, x, hq), hxf)
    case Con{P.FR{1n+i, False{}, +s}, +u}:
      +h1 = AG.agr_l($AO, $APP($BU, $APP($IS, Con{1n+i, Nil{}})), $AU, nl, nla, hag)
      +h2 = AG.agr_r($AO, $BU, $APP($IS, Con{1n+i, Nil{}}), nl, nla, h1)
      +hq = N.is_eq_sym_false(x, 1n+i, DJ.ne_nm(x, 1n+i, $BA($FRC(1n+i, False{}, s, u)), hxf, FX.q_in(1n+i, False{}, s, u)))
      ratt_frame($AO, nl, nla, x, z0, i, False{}, s, u, hc0, hnd, AG.agr_l($AO, $IS, Con{1n+i, Nil{}}, nl, nla, h2), AG.agr_app($AO, $BU, $AU, nl, nla, AG.agr_l($AO, $BU, $APP($IS, Con{1n+i, Nil{}}), nl, nla, h1), AG.agr_r($AO, $APP($BU, $APP($IS, Con{1n+i, Nil{}})), $AU, nl, nla, hag)), $AGHD(1n+i, Nil{}, nl, nla, AG.agr_r($AO, $IS, Con{1n+i, Nil{}}, nl, nla, h2)), N.is_eq_sym_false(1n+i, x, hq), hxf)


# ---- the unlink, the recycling and the fix-up ----

%def TV ~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, ~o: O.Order(~K, ~cmp)
%def AV ~K, ~V, ~cmp, ~o
%def AK ~K, ~V, ~cmp
%def MV Maybe<&2, V>
%def ES List<&2, M.Entry<K, V>>
%def FT +n: Nat, +root: Nat, +lo: Nat, +hi: Nat, +free: Nat, +l: Nat, +d: Nat, +nl: $NL, +pl: List<&2, $MV>, +tg: ST.Tr, +fl: $LN
%def F n, root, lo, hi, free, l, d, nl, pl, tg, fl
%def SH ST.SH{$F}
%def U 1n+ui
%def I0 $WH(c, ch)
%def E0 ST.ents(~K, ~V, $I0, nl, pl)
%def FXU Con{$U, flf}
%def SHU(r, x) ST.SH{Nat.sub(n, 1n), r, lo, hi, $U, l, d, x, pl, tg, fl}
%def INVU(x) {ST.ents(~K, ~V, $I0, x, pl) == $E0 : $ES} & ({EN.oks(~K, ~V, $I0, x, pl) == True{} : Bool} & ({ST.fll(~K, x, $FXU) == True{} : Bool} & {SC.length($ND, x) == SC.length($ND, nl) : Nat}))
%def TPU(r, x, t) $REPN(t, 0n, x) & ({r == ST.rid(t) : Nat} & ({$IDS(t) == $I0 : $LN} & ({ST.root_black(~K, t, x) == True{} : Bool} & $INVU(x))))
%def FPU(res) Sigma<&1, &1, Nat, fr_ => Sigma<&1, &1, $NL, fn_ => Sigma<&1, &1, ST.Tr, ft_ => {res == $SHU(fr_, fn_) : ST.Sh<K, V>} & $TPU(fr_, fn_, ft_)>>>
%def NU ST.nd(K, nl, $U)
%def XP M.pick(Nat, Nat.is_lt(0n, M.node_left(~K, $NU)), M.node_left(~K, $NU), M.node_right(~K, $NU))
%def Q P.top(c)
%def X ST.rid(ch)
%def AT RM.attn(K, nl, $Q, $X, SP.dir(c))
%def NL1 SE.setp(K, $AT, $X, $Q)
%def FREE M.Free{free}
%def NL2 PR.wr_nl(K, $NL1, $U, $FREE)
%def R1 RM.rootq($Q, root, $X)
%def UH +hpar: {M.node_parent(~K, $NU) == $Q : Nat}, +hx: {$XP == $X : Nat}, +hdir: {Nat.is_eq($U, M.node_left(~K, ST.nd(K, nl, $Q))) == SP.dir(c) : Bool}, +hr: $REPN(ch, $U, nl), +hok: $COKN(c, $U, nl), +htu: {ST.rid(tu) == $U : Nat}, +hroot: {root == ST.rid(PG.plug(c, tu)) : Nat}, +m1: $NMEM($Q, $IDS(ch)), +m2: $NDL($IDS(ch)), +m3: $NMEM($X, $BA(c)), +m4: $NDL($BA(c)), +m5: $NMEM($U, $I0), +m6: $NMEM($U, flf), +m7: $NDL($I0), +hk: {EN.oks(~K, ~V, $I0, nl, pl) == True{} : Bool}, +hfl: {ST.fll(~K, nl, flf) == True{} : Bool}, +hfree: {Nat.is_eq(free, ST.fst0(flf)) == True{} : Bool}, +hul: {Nat.is_lt(ui, SC.length($ND, nl)) == True{} : Bool}
%def UA hpar, hx, hdir, hr, hok, htu, hroot, m1, m2, m3, m4, m5, m6, m7, hk, hfl, hfree, hul
%def RPAT(pq, pd, px) MI.delete_repair($AK, MI.recycle($AK, MI.attach($AK, $SH, pq, px, pd), $U), px, pq, M.node_red(~K, $NU))

def unl_core($TV, $FT, +flf: $LN, +c: $CT, +ui: Nat, +tu: ST.Tr, +ch: ST.Tr, $UH) -> $FPU(MI.unlink($AK, $SH, $U)):
  %Equal.sym(Nat, M.node_parent(~K, $NU), $Q, hpar) : $FPU($RPAT(_, Nat.is_eq($U, M.node_left(~K, ST.nd(K, nl, _))), $XP))
  %Equal.sym(Bool, Nat.is_eq($U, M.node_left(~K, ST.nd(K, nl, $Q))), SP.dir(c), hdir) : $FPU($RPAT($Q, _, $XP))
  %Equal.sym(Nat, $XP, $X, hx) : $FPU($RPAT($Q, SP.dir(c), _))
  %Equal.sym(ST.Sh<K, V>, MI.attach($AK, $SH, $Q, $X, SP.dir(c)), ST.SH{n, $R1, lo, hi, free, l, d, $NL1, pl, tg, fl}, RM.attach_m($AK, $F, $Q, $X, SP.dir(c))) : $FPU(MI.delete_repair($AK, MI.recycle($AK, _, $U), $X, $Q, M.node_red(~K, $NU)))
  +m9 = DJ.nm_l($U, $IDS(ch), P.after(c), DJ.nm_r($U, P.before(c), $APP($IDS(ch), P.after(c)), m5))
  +m8 = DJ.nm_app($U, P.before(c), P.after(c), DJ.nm_l($U, P.before(c), $APP($IDS(ch), P.after(c)), m5), DJ.nm_r($U, $IDS(ch), P.after(c), DJ.nm_r($U, P.before(c), $APP($IDS(ch), P.after(c)), m5)))
  +el1 = Equal.trans(Nat, SC.length($ND, $NL1), SC.length($ND, $AT), SC.length($ND, nl), SE.setp_len(K, $AT, $X, $Q), RP.attn_len(~K, nl, $Q, $X, SP.dir(c)))
  +el2 = Equal.trans(Nat, SC.length($ND, $NL2), SC.length($ND, $NL1), SC.length($ND, nl), FRM.len_wr(K, $NL1, $U, $FREE), el1)
  +hul1 = L.subst(Nat, z => {Nat.is_lt(ui, z) == True{} : Bool}, SC.length($ND, nl), SC.length($ND, $NL1), Equal.sym(Nat, SC.length($ND, $NL1), SC.length($ND, nl), el1), hul)
  +hfr = L.subst($ND, z => {ST.is_free(K, z, ST.fst0(flf)) == True{} : Bool}, $FREE, $NDX($NL2, $U), Equal.sym($ND, $NDX($NL2, $U), $FREE, FRM.nd_wr_same(K, $NL1, ui, $FREE, hul1)), hfree)
  +hf2 = Equal.trans(Bool, ST.fll(~K, $NL2, flf), ST.fll(~K, $NL1, flf), True{}, FRM.fll_frame(~K, flf, $NL1, $U, $FREE, m6), Equal.trans(Bool, ST.fll(~K, $NL1, flf), ST.fll(~K, $AT, flf), True{}, SE.fll_setp(~K, flf, $AT, $X, $Q), Equal.trans(Bool, ST.fll(~K, $AT, flf), ST.fll(~K, nl, flf), True{}, RP.attn_fll(~K, flf, nl, $Q, $X, SP.dir(c)), hfl)))
  +h4 = Equal.trans($ES, ST.ents(~K, ~V, $I0, $NL2, pl), ST.ents(~K, ~V, $I0, $NL1, pl), $E0, FRM.ents_frame(~K, ~V, $I0, $NL1, pl, $U, $FREE, m5), Equal.trans($ES, ST.ents(~K, ~V, $I0, $NL1, pl), ST.ents(~K, ~V, $I0, $AT, pl), $E0, SE.ents_setp(~K, ~V, $I0, $AT, pl, $X, $Q), RP.attn_ents(~K, ~V, $I0, pl, nl, $Q, $X, SP.dir(c))))
  +h5 = Equal.trans(Bool, EN.oks(~K, ~V, $I0, $NL2, pl), EN.oks(~K, ~V, $I0, $NL1, pl), True{}, AG.oks_agr($AV, $I0, $NL1, $NL2, pl, AG.agr_wr($AO, $I0, $NL1, $U, $FREE, m5)), Equal.trans(Bool, EN.oks(~K, ~V, $I0, $NL1, pl), EN.oks(~K, ~V, $I0, $AT, pl), True{}, SE.oks_setp(~K, ~V, $I0, $AT, pl, $X, $Q), Equal.trans(Bool, EN.oks(~K, ~V, $I0, $AT, pl), EN.oks(~K, ~V, $I0, nl, pl), True{}, RP.attn_oks(~K, ~V, $I0, pl, nl, $Q, $X, SP.dir(c)), hk)))
  +i1 = Equal.trans(Bool, ST.rep(~K, ch, $Q, $NL2), ST.rep(~K, ch, $Q, $NL1), True{}, FRM.rep_frame(~K, ch, $Q, $NL1, $U, $FREE, m9), ratt_rep($AO, nl, $Q, SP.dir(c), $U, ch, hr, m1, m2))
  +i2 = Equal.trans(Bool, P.ctxok(~K, c, $X, $NL2), P.ctxok(~K, c, $X, $NL1), True{}, AG.ctx_agr($AO, c, $X, $NL1, $NL2, AG.agr_wr($AO, $BA(c), $NL1, $U, $FREE, m8)), ratt_ctx($AO, nl, nl, c, $X, $U, hok, m4, AG.agr_refl($AO, $BA(c), nl), m3))
  DF.dloop($AV, Nat.sub(n, 1n), lo, hi, $U, l, d, pl, tg, fl, $FXU, $I0, $E0, SC.length($ND, nl), 1n+Nat.sub(n, 1n), $R1, $NL2, c, ch, i1, i2, m7, {==}, RP.root_rot(~K, nl, c, $U, $X, tu, ch, root, htu, {==}, hok, hroot), h4, h5, L.and_intro(ST.is_free(K, $NDX($NL2, $U), ST.fst0(flf)), ST.fll(~K, $NL2, flf), hfr, hf2), el2, Bool.not(M.node_red(~K, $NU)))

# ---- the facts the unlink needs, from the tree's ----

def mid_c(+b: $LN, +s: $LN, +a: $LN, +q: Nat, +hnd: $NDL($APP(b, $APP(s, a))), +hm: $MEM(q, $APP(b, a)), +e: Bool, +he: {HT.memn(q, b) == e : Bool}) -> $NMEM(q, s):
  match e:
    case True{}:
      DJ.nm_l(q, s, a, DJ.dj_r(b, $APP(s, a), hnd, q, he))
    case False{}:
      +hor = Equal.trans(Bool, Bool.or(HT.memn(q, b), HT.memn(q, a)), HT.memn(q, $APP(b, a)), True{}, Equal.sym(Bool, HT.memn(q, $APP(b, a)), Bool.or(HT.memn(q, b), HT.memn(q, a)), LS.memn_app(q, b, a)), hm)
      +hqa = L.subst(Bool, w => {Bool.or(w, HT.memn(q, a)) == True{} : Bool}, HT.memn(q, b), False{}, he, hor)
      DJ.dj_l(s, a, DJ.ndr(b, $APP(s, a), hnd), q, hqa)

# a member of the lists around s is not in s
def mid_nm(+b: $LN, +s: $LN, +a: $LN, +q: Nat, +hnd: $NDL($APP(b, $APP(s, a))), +hm: $MEM(q, $APP(b, a))) -> $NMEM(q, s):
  mid_c(b, s, a, q, hnd, hm, HT.memn(q, b), {==})

# the parent is not in the subtree
def top_nm($TO, +nl: $NL, +c: $CT, +t: ST.Tr, +p: Nat, +hr: $REPN(t, p, nl), +hnd: $NDL($WH(c, t))) -> $NMEM(P.top(c), $IDS(t)):
  match c:
    case Nil{}:
      RT.zero_ids(~K, nl, t, p, hr)
    case Con{P.FR{+q, +lft, +s}, +c1}:
      mid_nm(P.before(Con{P.FR{q, lft, s}, c1}), $IDS(t), P.after(Con{P.FR{q, lft, s}, c1}), q, hnd, FX.q_in(q, lft, s, c1))

# the subtree's root is not on the path
def rid_nm($TO, +nl: $NL, +c: $CT, +t: ST.Tr, +z: Nat, +hok: $COKN(c, z, nl), +hnd: $NDL($WH(c, t))) -> $NMEM(ST.rid(t), $BA(c)):
  match t:
    case ST.TE{}:
      RT.zero_ctx(~K, nl, c, z, hok)
    case ST.TN{+j, +tl, +tr}:
      +mj = P.mem_root(j, tl, tr)
      DJ.nm_app(j, P.before(c), P.after(c), DJ.dj_l(P.before(c), $APP($IDS($TN(j, tl, tr)), P.after(c)), hnd, j, DJ.mem_l(j, $IDS($TN(j, tl, tr)), P.after(c), mj)), DJ.dj_r($IDS($TN(j, tl, tr)), P.after(c), DJ.ndr(P.before(c), $APP($IDS($TN(j, tl, tr)), P.after(c)), hnd), j, mj))

def une(+ui: Nat, +s: ST.Tr, +h: $NMEM(1n+ui, $IDS(s))) -> {Bool.not(Nat.is_eq(1n+ui, ST.rid(s))) == True{} : Bool}:
  match s:
    case ST.TE{}:
      {==}
    case ST.TN{+j, +sl, +sr}:
      +e = FRM.ne_sym(j, 1n+ui, Pair.fst({Nat.is_eq(j, 1n+ui) == False{} : Bool}, $NMEM(1n+ui, $IDS(sl)) & $NMEM(1n+ui, $IDS(sr)), FRM.nm_node(1n+ui, j, sl, sr, h)))
      L.subst(Bool, w => {Bool.not(w) == True{} : Bool}, False{}, Nat.is_eq(1n+ui, j), Equal.sym(Bool, Nat.is_eq(1n+ui, j), False{}, e), {==})

# the side the node hangs on is the path's
def udir($TO, +nl: $NL, +c: $CT, +ui: Nat, +hok: $COKN(c, 1n+ui, nl), +hu: $NMEM(1n+ui, $BA(c))) -> {Nat.is_eq(1n+ui, M.node_left(~K, ST.nd(K, nl, P.top(c)))) == SP.dir(c) : Bool}:
  match c:
    case Nil{}:
      {==}
    case Con{P.FR{+q, +lft, +s}, +c1}:
      +hk = L.and_left(P.cok1(~K, P.FR{q, lft, s}, 1n+ui, P.top(c1), nl), P.ctxok(~K, c1, q, nl), hok)
      +isn = L.and_left(ST.is_node(K, ST.nd(K, nl, q), ST.pk(Nat, lft, 1n+ui, ST.rid(s)), ST.pk(Nat, lft, ST.rid(s), 1n+ui), P.top(c1)), ST.rep(~K, s, q, nl), L.and_right(Nat.is_lt(0n, q), Bool.and(ST.is_node(K, ST.nd(K, nl, q), ST.pk(Nat, lft, 1n+ui, ST.rid(s)), ST.pk(Nat, lft, ST.rid(s), 1n+ui), P.top(c1)), ST.rep(~K, s, q, nl)), hk))
      %Equal.sym(Nat, M.node_left(~K, ST.nd(K, nl, q)), ST.pk(Nat, lft, 1n+ui, ST.rid(s)), NB.child_eq(~K, ST.nd(K, nl, q), ST.pk(Nat, lft, 1n+ui, ST.rid(s)), ST.pk(Nat, lft, ST.rid(s), 1n+ui), P.top(c1), False{}, isn)) : {Nat.is_eq(1n+ui, _) == lft : Bool}
      FX.eq_pk(1n+ui, lft, ST.rid(s), une(ui, s, Pair.fst($NMEM(1n+ui, $IDS(s)), $NMEM(1n+ui, $BA(c1)), RT.fw_s(1n+ui, q, lft, s, c1, hu))))

# the child the unlink picks
def hx_a(~K: Data, +nl: $NL, +ui: Nat, +ch: ST.Tr, +q: Nat, +hn: {ST.is_node(K, ST.nd(K, nl, 1n+ui), 0n, ST.rid(ch), q) == True{} : Bool}) -> {M.pick(Nat, Nat.is_lt(0n, M.node_left(~K, ST.nd(K, nl, 1n+ui))), M.node_left(~K, ST.nd(K, nl, 1n+ui)), M.node_right(~K, ST.nd(K, nl, 1n+ui))) == ST.rid(ch) : Nat}:
  %Equal.sym(Nat, M.node_left(~K, ST.nd(K, nl, 1n+ui)), 0n, NB.child_eq(~K, ST.nd(K, nl, 1n+ui), 0n, ST.rid(ch), q, False{}, hn)) : {M.pick(Nat, Nat.is_lt(0n, _), _, M.node_right(~K, ST.nd(K, nl, 1n+ui))) == ST.rid(ch) : Nat}
  %Equal.sym(Nat, M.node_right(~K, ST.nd(K, nl, 1n+ui)), ST.rid(ch), NB.child_eq(~K, ST.nd(K, nl, 1n+ui), 0n, ST.rid(ch), q, True{}, hn)) : {M.pick(Nat, False{}, 0n, _) == ST.rid(ch) : Nat}
  {==}

def hx_b(~K: Data, +nl: $NL, +ui: Nat, +ch: ST.Tr, +q: Nat, +hn: {ST.is_node(K, ST.nd(K, nl, 1n+ui), ST.rid(ch), 0n, q) == True{} : Bool}, +hj: {Nat.is_lt(0n, ST.rid(ch)) == True{} : Bool}) -> {M.pick(Nat, Nat.is_lt(0n, M.node_left(~K, ST.nd(K, nl, 1n+ui))), M.node_left(~K, ST.nd(K, nl, 1n+ui)), M.node_right(~K, ST.nd(K, nl, 1n+ui))) == ST.rid(ch) : Nat}:
  %Equal.sym(Nat, M.node_left(~K, ST.nd(K, nl, 1n+ui)), ST.rid(ch), NB.child_eq(~K, ST.nd(K, nl, 1n+ui), ST.rid(ch), 0n, q, False{}, hn)) : {M.pick(Nat, Nat.is_lt(0n, _), _, M.node_right(~K, ST.nd(K, nl, 1n+ui))) == ST.rid(ch) : Nat}
  %Equal.sym(Nat, M.node_right(~K, ST.nd(K, nl, 1n+ui)), 0n, NB.child_eq(~K, ST.nd(K, nl, 1n+ui), ST.rid(ch), 0n, q, True{}, hn)) : {M.pick(Nat, Nat.is_lt(0n, ST.rid(ch)), ST.rid(ch), _) == ST.rid(ch) : Nat}
  %Equal.sym(Bool, Nat.is_lt(0n, ST.rid(ch)), True{}, hj) : {M.pick(Nat, _, ST.rid(ch), 0n) == ST.rid(ch) : Nat}
  {==}

# ---- the two shapes: no left child, or a left child and no right one ----

%def WA $WH(c, $TN($U, $TE, ch))
%def WB $WH(c, $TN($U, ch, $TE))
%def UW +flf: $LN, +c: $CT, +ui: Nat, +ch: ST.Tr
%def UWH +hok: $COKN(c, $U, nl), +hk: {EN.oks(~K, ~V, $I0, nl, pl) == True{} : Bool}, +hfl: {ST.fll(~K, nl, flf) == True{} : Bool}, +hfree: {Nat.is_eq(free, ST.fst0(flf)) == True{} : Bool}, +hul: {Nat.is_lt(ui, SC.length($ND, nl)) == True{} : Bool}
%def M8(h) DJ.nm_app($U, P.before(c), P.after(c), DJ.nm_l($U, P.before(c), $APP($IDS(ch), P.after(c)), h), DJ.nm_r($U, $IDS(ch), P.after(c), DJ.nm_r($U, P.before(c), $APP($IDS(ch), P.after(c)), h)))
%def NW(h) DJ.ndl($I0, Con{$U, flf}, h), DJ.dj_l($I0, Con{$U, flf}, h, $U, DJ.mem_hd($U, flf)), DJ.nd_head($U, flf, DJ.ndr($I0, Con{$U, flf}, h))

# the free chain gets the node: the ids with it moved
def mv_a($UW, +h: $NDL($APP($WA, flf))) -> $NDL($APP($I0, Con{$U, flf})):
  nd_back(P.before(c), $APP($IDS(ch), P.after(c)), $U, flf, h)

def mv_b($UW, +h: $NDL($APP($WB, flf))) -> $NDL($APP($I0, Con{$U, flf})):
  +e1 = Equal.trans($LN, $WB, $APP(P.before(c), $APP($IDS(ch), Con{$U, P.after(c)})), $APP($APP(P.before(c), $IDS(ch)), Con{$U, P.after(c)}), L.subst($LN, z => {$WB == $APP(P.before(c), z) : $LN}, $APP($APP($IDS(ch), Con{$U, Nil{}}), P.after(c)), $APP($IDS(ch), Con{$U, P.after(c)}), LL.append_assoc(Nat, $IDS(ch), Con{$U, Nil{}}, P.after(c)), {==}), Equal.sym($LN, $APP($APP(P.before(c), $IDS(ch)), Con{$U, P.after(c)}), $APP(P.before(c), $APP($IDS(ch), Con{$U, P.after(c)})), LL.append_assoc(Nat, P.before(c), $IDS(ch), Con{$U, P.after(c)})))
  +h1 = L.subst($LN, z => $NDL($APP(z, flf)), $WB, $APP($APP(P.before(c), $IDS(ch)), Con{$U, P.after(c)}), e1, h)
  +h2 = nd_back($APP(P.before(c), $IDS(ch)), P.after(c), $U, flf, h1)
  L.subst($LN, z => $NDL($APP(z, Con{$U, flf})), $APP($APP(P.before(c), $IDS(ch)), P.after(c)), $I0, LL.append_assoc(Nat, P.before(c), $IDS(ch), P.after(c)), h2)

def unl_a($TV, $FT, $UW, +hr0: $REPN($TN($U, $TE, ch), P.top(c), nl), +hroot: {root == ST.rid(PG.plug(c, $TN($U, $TE, ch))) : Nat}, +hnd0: $NDL($APP($WA, flf)), $UWH) -> $FPU(MI.unlink($AK, $SH, $U)):
  +hn = TR.rep_node(~K, $U, $TE, ch, P.top(c), nl, hr0)
  +hmv = mv_a(flf, c, ui, ch, hnd0)
  +m7 = DJ.ndl($I0, Con{$U, flf}, hmv)
  +m5 = DJ.dj_l($I0, Con{$U, flf}, hmv, $U, DJ.mem_hd($U, flf))
  +hr = TR.rep_r(~K, $U, $TE, ch, P.top(c), nl, hr0)
  unl_core($AV, $F, flf, c, ui, $TN($U, $TE, ch), ch, NB.parent_eq(~K, $NU, 0n, $X, P.top(c), hn), hx_a(~K, nl, ui, ch, P.top(c), hn), udir($AO, nl, c, ui, hok, $M8(m5)), hr, hok, {==}, hroot, top_nm($AO, nl, c, ch, $U, hr, m7), DJ.ndl($IDS(ch), P.after(c), DJ.ndr(P.before(c), $APP($IDS(ch), P.after(c)), m7)), rid_nm($AO, nl, c, ch, $U, hok, m7), RT.nd_drop(P.before(c), $IDS(ch), P.after(c), m7), m5, DJ.nd_head($U, flf, DJ.ndr($I0, Con{$U, flf}, hmv)), m7, hk, hfl, hfree, hul)

def unl_b($TV, $FT, $UW, +hj: {Nat.is_lt(0n, ST.rid(ch)) == True{} : Bool}, +hr0: $REPN($TN($U, ch, $TE), P.top(c), nl), +hroot: {root == ST.rid(PG.plug(c, $TN($U, ch, $TE))) : Nat}, +hnd0: $NDL($APP($WB, flf)), $UWH) -> $FPU(MI.unlink($AK, $SH, $U)):
  +hn = TR.rep_node(~K, $U, ch, $TE, P.top(c), nl, hr0)
  +hmv = mv_b(flf, c, ui, ch, hnd0)
  +m7 = DJ.ndl($I0, Con{$U, flf}, hmv)
  +m5 = DJ.dj_l($I0, Con{$U, flf}, hmv, $U, DJ.mem_hd($U, flf))
  +hr = TR.rep_l(~K, $U, ch, $TE, P.top(c), nl, hr0)
  unl_core($AV, $F, flf, c, ui, $TN($U, ch, $TE), ch, NB.parent_eq(~K, $NU, $X, 0n, P.top(c), hn), hx_b(~K, nl, ui, ch, P.top(c), hn, hj), udir($AO, nl, c, ui, hok, $M8(m5)), hr, hok, {==}, hroot, top_nm($AO, nl, c, ch, $U, hr, m7), DJ.ndl($IDS(ch), P.after(c), DJ.ndr(P.before(c), $APP($IDS(ch), P.after(c)), m7)), rid_nm($AO, nl, c, ch, $U, hok, m7), RT.nd_drop(P.before(c), $IDS(ch), P.after(c), m7), m5, DJ.nd_head($U, flf, DJ.ndr($I0, Con{$U, flf}, hmv)), m7, hk, hfl, hfree, hul)
