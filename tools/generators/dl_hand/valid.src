import Base
import ../lib/logic.bend as L
import ../lib/nat.bend as N
import ../lib/u32.bend as U
import ../lib/u32alg.bend as A
import ../lib/array.bend as AR
import ../lib/list.bend as LL
import ../spec/common.bend as SC
import ../spec/doubly_linked_list.bend as S
import ../math/u32div.bend as UD
import ../../src/containers/doubly_linked_list.bend as D
import ../../src/containers/internal/dlist_storage.bend as R
import ../../src/containers/types/doubly_linked_list.bend as E
import ./state.bend as ST
import ./rel.bend as RL
import ./vals.bend as VA
import ./ok.bend as OK
import ../lib/words32.bend as W32
import ../lib/u32_tree.bend as UT

# Handle validation. The public list checks the owner, the id against its
# capacity and the generation, then the storage checks the id against its
# counter and the value slot; the specification checks the owner, the value
# and the generation. Every combination gives the same verdict.

%def MT Maybe<&2, T>
%def VL AR.slots($MT, vT)
%def GL AR.slots(U32, gT)
%def FV UD.v(fresh)
%def II UD.v(id)
%def TR(x) {x == True{} : Bool}
%def VLF SC.take($MT, $VL, $FV)
%def GLF SC.take(U32, $GL, $FV)
%def SH ST.LS{tag, cap, fresh, free, head, tail, depth, vT, pT, nT, gT, sl, fl}
%def SHA tag, cap, fresh, free, head, tail, depth, vT, pT, nT, gT, sl, fl
%def G(c) ST.g_$c(~T, $SHA, hg)
%def HH E.H{owner, id, g}
%def RS ST.real(~T, $SH)
%def MS ST.model(~T, $SH)
%def OB E.Obs<T>
%def FT E.ForeignHandle{}
%def ST0 E.StaleHandle{}
%def VP +tag: U32, +cap: U32, +fresh: U32, +free: U32, +head: U32, +tail: U32, +depth: Nat, +vT: AR.Tree<$MT>, +pT: AR.Tree<U32>, +nT: AR.Tree<U32>, +gT: AR.Tree<U32>, +sl: List<&2, Nat>, +fl: List<&2, Nat>, +hg: $TR(ST.goodF(~T, $SHA)), +owner: U32, +id: U32, +g: U32
%def VA tag, cap, fresh, free, head, tail, depth, vT, pT, nT, gT, sl, fl, hg, owner, id, g
%def VB(c1, c2) D.valid_bounds(~T, tag, depth, cap, R.DL{tag, fresh, free, SC.length(Nat, sl), head, tail, depth, cap, AR.thaw($MT, vT), AR.thaw(U32, pT), AR.thaw(U32, nT)}, AR.thaw(U32, gT), id, g, c1, c2)
%def VO(c) S.valid_own(T, $VLF, $GLF, $II, g, c)
%def RES D.DList<T> & Maybe<&2, E.Error>

# ---- the public list's verdict ----

def iv_foreign(~T: Data, $VP, +hc: {U32.is_eq(tag, owner) == False{} : Bool}) -> {D.validate(~T, $RS, $HH) == ($RS, Some{$FT}) : $RES}:
  Equal.cong(Bool, $RES, z => $VB(z, U32.is_lt(id, cap)), U32.is_eq(tag, owner), False{}, hc)

def iv_cap(~T: Data, $VP, +hc: {U32.is_eq(tag, owner) == True{} : Bool}, +hcap: {U32.is_lt(id, cap) == False{} : Bool}) -> {D.validate(~T, $RS, $HH) == ($RS, Some{$ST0}) : $RES}:
  Equal.trans($RES, D.validate(~T, $RS, $HH), $VB(True{}, U32.is_lt(id, cap)), ($RS, Some{$ST0}), Equal.cong(Bool, $RES, z => $VB(z, U32.is_lt(id, cap)), U32.is_eq(tag, owner), True{}, hc), Equal.cong(Bool, $RES, z => $VB(True{}, z), U32.is_lt(id, cap), False{}, hcap))

def iv_gen(~T: Data, $VP, +hc: {U32.is_eq(tag, owner) == True{} : Bool}, +hcap: {U32.is_lt(id, cap) == True{} : Bool}) -> {D.validate(~T, $RS, $HH) == ($RS, D.generation_error(U32.is_eq(W32.nth0($GL, $II), g))) : $RES}:
  +hd = $G(cdep)
  +hi = L.subst(Nat, z => {Nat.is_lt($II, z) == True{} : Bool}, UD.v(cap), SC.pow2(depth), N.eq_from_is_eq(UD.v(cap), SC.pow2(depth), $G(ccap)), Equal.trans(Bool, Nat.is_lt($II, UD.v(cap)), U32.is_lt(id, cap), True{}, Equal.sym(Bool, U32.is_lt(id, cap), Nat.is_lt($II, UD.v(cap)), U.is_lt_nat(id, cap)), hcap))
  +e1 = Equal.cong(Bool, $RES, z => $VB(z, U32.is_lt(id, cap)), U32.is_eq(tag, owner), True{}, hc)
  +e2 = Equal.cong(Bool, $RES, z => $VB(True{}, z), U32.is_lt(id, cap), True{}, hcap)
  +e3 = Equal.cong(Array<U32> & U32, $RES, r => D.valid_gen(~T, tag, depth, cap, R.DL{tag, fresh, free, SC.length(Nat, sl), head, tail, depth, cap, AR.thaw($MT, vT), AR.thaw(U32, pT), AR.thaw(U32, nT)}, g, r), Array.get(U32, AR.thaw(U32, gT), id), (AR.thaw(U32, gT), W32.nth0($GL, $II)), UT.uget(depth, RL.hd0(depth, hd), gT, $G(cpg), id, hi))
  Equal.trans($RES, D.validate(~T, $RS, $HH), $VB(True{}, U32.is_lt(id, cap)), ($RS, D.generation_error(U32.is_eq(W32.nth0($GL, $II), g))), e1, Equal.trans($RES, $VB(True{}, U32.is_lt(id, cap)), $VB(True{}, True{}), ($RS, D.generation_error(U32.is_eq(W32.nth0($GL, $II), g))), e2, e3))

# ---- the specification's verdict ----

def len_vlf(~T: Data, $VP) -> {SC.length($MT, $VLF) == $FV : Nat}:
  +e2d = N.eq_from_is_eq(UD.v(cap), SC.pow2(depth), $G(ccap))
  +hfr2 = L.subst(Nat, z => {Nat.is_le($FV, z) == True{} : Bool}, UD.v(cap), SC.pow2(depth), e2d, $G(cfr))
  LL.sc_length_take($MT, $VL, $FV, L.subst(Nat, z => {Nat.is_le($FV, z) == True{} : Bool}, SC.pow2(depth), SC.length($MT, $VL), Equal.sym(Nat, SC.length($MT, $VL), SC.pow2(depth), AR.slots_length($MT, depth, vT, $G(cpv))), hfr2))

def sv_foreign(~T: Data, $VP, +hc: {U32.is_eq(owner, tag) == False{} : Bool}) -> {S.validate(T, $MS, $HH) == Some{$FT} : Maybe<&2, E.Error>}:
  Equal.cong(Bool, Maybe<&2, E.Error>, z => $VO(z), U32.is_eq(owner, tag), False{}, hc)

def sv_hi(~T: Data, $VP, +hc: {U32.is_eq(owner, tag) == True{} : Bool}, +hlt: {Nat.is_lt($II, $FV) == False{} : Bool}) -> {S.validate(T, $MS, $HH) == Some{$ST0} : Maybe<&2, E.Error>}:
  +hle = L.subst(Nat, z => {Nat.is_le(z, $II) == True{} : Bool}, $FV, SC.length($MT, $VLF), Equal.sym(Nat, SC.length($MT, $VLF), $FV, len_vlf(~T, $VA)), N.not_lt_le($II, $FV, hlt))
  +e1 = Equal.cong(Bool, Maybe<&2, E.Error>, z => $VO(z), U32.is_eq(owner, tag), True{}, hc)
  +e2 = Equal.cong($MT, Maybe<&2, E.Error>, m => S.live_gen(T, m, U32.is_eq(S.gen_of($GLF, $II), g)), S.val_of(T, $VLF, $II), None{}, VA.val_hi(T, $VLF, $II, hle))
  Equal.trans(Maybe<&2, E.Error>, S.validate(T, $MS, $HH), $VO(True{}), Some{$ST0}, e1, e2)

def sv_lo(~T: Data, $VP, +hc: {U32.is_eq(owner, tag) == True{} : Bool}, +hlt: {Nat.is_lt($II, $FV) == True{} : Bool}) -> {S.validate(T, $MS, $HH) == S.live_gen(T, S.val_of(T, $VL, $II), U32.is_eq(W32.nth0($GL, $II), g)) : Maybe<&2, E.Error>}:
  +e1 = Equal.cong(Bool, Maybe<&2, E.Error>, z => $VO(z), U32.is_eq(owner, tag), True{}, hc)
  +e2 = Equal.cong($MT, Maybe<&2, E.Error>, m => S.live_gen(T, m, U32.is_eq(S.gen_of($GLF, $II), g)), S.val_of(T, $VLF, $II), S.val_of(T, $VL, $II), VA.val_take(T, $VL, $FV, $II, hlt))
  +e3 = Equal.cong(U32, Maybe<&2, E.Error>, z => S.live_gen(T, S.val_of(T, $VL, $II), U32.is_eq(z, g)), S.gen_of($GLF, $II), W32.nth0($GL, $II), VA.gen_take($GL, $FV, $II, hlt))
  Equal.trans(Maybe<&2, E.Error>, S.validate(T, $MS, $HH), $VO(True{}), S.live_gen(T, S.val_of(T, $VL, $II), U32.is_eq(W32.nth0($GL, $II), g)), e1, Equal.trans(Maybe<&2, E.Error>, $VO(True{}), S.live_gen(T, S.val_of(T, $VL, $II), U32.is_eq(S.gen_of($GLF, $II), g)), S.live_gen(T, S.val_of(T, $VL, $II), U32.is_eq(W32.nth0($GL, $II), g)), e2, e3))

def lg_false(-T: Data, +m: $MT) -> {S.live_gen(T, m, False{}) == Some{$ST0} : Maybe<&2, E.Error>}:
  match m:
    case None{}:
      {==}
    case Some{v}:
      {==}

# ---- the verdicts' results ----

%def SPEC(v) S.checked(T, $MS, op, $HH, v)
%def IMPL(v) D.checked(~T, op, v)
%def GOAL OK.POK(~T, $OB, $SPEC(S.validate(T, $MS, $HH)), $IMPL(D.validate(~T, $RS, $HH)))
%def FP +op: E.Op<T>, +hfF: {D.failed(~T, op, $FT) == S.failed(T, op, $FT) : $OB}, +hfS: {D.failed(~T, op, $ST0) == S.failed(T, op, $ST0) : $OB}
%def FA op, hfF, hfS

# both sides fail with e
def v_close(~T: Data, $VP, $FP, +e: E.Error, +he: {D.failed(~T, op, e) == S.failed(T, op, e) : $OB}, +er: {$IMPL(D.validate(~T, $RS, $HH)) == ($RS, D.failed(~T, op, e)) : D.DList<T> & $OB}, +es: {$SPEC(S.validate(T, $MS, $HH)) == ($MS, S.failed(T, op, e)) : S.DS<T> & $OB}) -> $GOAL:
  +es2 = Equal.trans(S.DS<T> & $OB, $SPEC(S.validate(T, $MS, $HH)), ($MS, S.failed(T, op, e)), ($MS, D.failed(~T, op, e)), es, Equal.cong($OB, S.DS<T> & $OB, o => ($MS, o), S.failed(T, op, e), D.failed(~T, op, e), Equal.sym($OB, D.failed(~T, op, e), S.failed(T, op, e), he)))
  ($SH, (D.failed(~T, op, e), (er, (es2, hg))))

%def DSP D.dispatch(~T, $RS, op)
%def LOP S.live_op(T, $MS, op, $II)
%def HO +ho: {U32.is_eq(owner, tag) == True{} : Bool}
%def KP stale_hi: @+ho: {U32.is_eq(owner, tag) == True{} : Bool} -> @+hlt: {Nat.is_lt($II, $FV) == False{} : Bool} -> {$DSP == ($RS, D.failed(~T, op, $ST0)) : D.DList<T> & $OB}, stale_none: @+ho: {U32.is_eq(owner, tag) == True{} : Bool} -> @+hlt: {Nat.is_lt($II, $FV) == True{} : Bool} -> @+hv: {S.val_of(T, $VL, $II) == None{} : $MT} -> {$DSP == ($RS, D.failed(~T, op, $ST0)) : D.DList<T> & $OB}, live: @+ho: {U32.is_eq(owner, tag) == True{} : Bool} -> @+hlt: {Nat.is_lt($II, $FV) == True{} : Bool} -> @+vv: T -> @+hv: {S.val_of(T, $VL, $II) == Some{vv} : $MT} -> @+hgen: {g == W32.nth0($GL, $II) : U32} -> OK.POK(~T, $OB, $LOP, $DSP)
%def KA stale_hi, stale_none, live
%def IEQ(a, b) Equal.cong($RES, D.DList<T> & $OB, r => $IMPL(r), D.validate(~T, $RS, $HH), a, b)
%def SEQ(a, b) Equal.cong(Maybe<&2, E.Error>, S.DS<T> & $OB, v => $SPEC(v), S.validate(T, $MS, $HH), a, b)

# the value slot, the generation current
def v_val(~T: Data, $VP, $FP, $HO, +hlt: {Nat.is_lt($II, $FV) == True{} : Bool}, +hgt: {U32.is_eq(W32.nth0($GL, $II), g) == True{} : Bool}, +er0: {$IMPL(D.validate(~T, $RS, $HH)) == $DSP : D.DList<T> & $OB}, +es0: {S.validate(T, $MS, $HH) == S.live_gen(T, S.val_of(T, $VL, $II), True{}) : Maybe<&2, E.Error>}, stale_none: @+ho: {U32.is_eq(owner, tag) == True{} : Bool} -> @+hlt: {Nat.is_lt($II, $FV) == True{} : Bool} -> @+hv: {S.val_of(T, $VL, $II) == None{} : $MT} -> {$DSP == ($RS, D.failed(~T, op, $ST0)) : D.DList<T> & $OB}, live: @+ho: {U32.is_eq(owner, tag) == True{} : Bool} -> @+hlt: {Nat.is_lt($II, $FV) == True{} : Bool} -> @+vv: T -> @+hv: {S.val_of(T, $VL, $II) == Some{vv} : $MT} -> @+hgen: {g == W32.nth0($GL, $II) : U32} -> OK.POK(~T, $OB, $LOP, $DSP), +m: $MT, +hm: {S.val_of(T, $VL, $II) == m : $MT}) -> $GOAL:
  match m:
    case None{}:
      +es = $SEQ(Some{$ST0}, Equal.trans(Maybe<&2, E.Error>, S.validate(T, $MS, $HH), S.live_gen(T, S.val_of(T, $VL, $II), True{}), Some{$ST0}, es0, Equal.cong($MT, Maybe<&2, E.Error>, z => S.live_gen(T, z, True{}), S.val_of(T, $VL, $II), None{}, hm)))
      v_close(~T, $VA, $FA, $ST0, hfS, Equal.trans(D.DList<T> & $OB, $IMPL(D.validate(~T, $RS, $HH)), $DSP, ($RS, D.failed(~T, op, $ST0)), er0, stale_none(ho, hlt, hm)), es)
    case Some{+vv}:
      +es = $SEQ(None{}, Equal.trans(Maybe<&2, E.Error>, S.validate(T, $MS, $HH), S.live_gen(T, S.val_of(T, $VL, $II), True{}), None{}, es0, Equal.cong($MT, Maybe<&2, E.Error>, z => S.live_gen(T, z, True{}), S.val_of(T, $VL, $II), Some{vv}, hm)))
      +hgen = Equal.sym(U32, W32.nth0($GL, $II), g, A.eq_of(W32.nth0($GL, $II), g, hgt))
      OK.pok_eq(~T, $OB, $SPEC(S.validate(T, $MS, $HH)), $LOP, $IMPL(D.validate(~T, $RS, $HH)), $DSP, es, er0, live(ho, hlt, vv, hm, hgen))

# the generation current: the storage decides
def v_go(~T: Data, $VP, $FP, $HO, +hgt: {U32.is_eq(W32.nth0($GL, $II), g) == True{} : Bool}, +er0: {$IMPL(D.validate(~T, $RS, $HH)) == $DSP : D.DList<T> & $OB}, $KP, +c: Bool, +hc: {Nat.is_lt($II, $FV) == c : Bool}) -> $GOAL:
  match c:
    case False{}:
      v_close(~T, $VA, $FA, $ST0, hfS, Equal.trans(D.DList<T> & $OB, $IMPL(D.validate(~T, $RS, $HH)), $DSP, ($RS, D.failed(~T, op, $ST0)), er0, stale_hi(ho, hc)), $SEQ(Some{$ST0}, sv_hi(~T, $VA, ho, hc)))
    case True{}:
      +es0 = Equal.trans(Maybe<&2, E.Error>, S.validate(T, $MS, $HH), S.live_gen(T, S.val_of(T, $VL, $II), U32.is_eq(W32.nth0($GL, $II), g)), S.live_gen(T, S.val_of(T, $VL, $II), True{}), sv_lo(~T, $VA, ho, hc), Equal.cong(Bool, Maybe<&2, E.Error>, z => S.live_gen(T, S.val_of(T, $VL, $II), z), U32.is_eq(W32.nth0($GL, $II), g), True{}, hgt))
      v_val(~T, $VA, $FA, ho, hc, hgt, er0, es0, stale_none, live, S.val_of(T, $VL, $II), {==})

# the generation stale: both reject
def v_genf(~T: Data, $VP, $FP, $HO, +hgf: {U32.is_eq(W32.nth0($GL, $II), g) == False{} : Bool}, +er: {$IMPL(D.validate(~T, $RS, $HH)) == ($RS, D.failed(~T, op, $ST0)) : D.DList<T> & $OB}, +c: Bool, +hc: {Nat.is_lt($II, $FV) == c : Bool}) -> $GOAL:
  match c:
    case False{}:
      v_close(~T, $VA, $FA, $ST0, hfS, er, $SEQ(Some{$ST0}, sv_hi(~T, $VA, ho, hc)))
    case True{}:
      +es0 = Equal.trans(Maybe<&2, E.Error>, S.validate(T, $MS, $HH), S.live_gen(T, S.val_of(T, $VL, $II), U32.is_eq(W32.nth0($GL, $II), g)), Some{$ST0}, sv_lo(~T, $VA, ho, hc), Equal.trans(Maybe<&2, E.Error>, S.live_gen(T, S.val_of(T, $VL, $II), U32.is_eq(W32.nth0($GL, $II), g)), S.live_gen(T, S.val_of(T, $VL, $II), False{}), Some{$ST0}, Equal.cong(Bool, Maybe<&2, E.Error>, z => S.live_gen(T, S.val_of(T, $VL, $II), z), U32.is_eq(W32.nth0($GL, $II), g), False{}, hgf), lg_false(T, S.val_of(T, $VL, $II))))
      v_close(~T, $VA, $FA, $ST0, hfS, er, $SEQ(Some{$ST0}, es0))

def v_gen(~T: Data, $VP, $FP, $HO, +hc1: {U32.is_eq(tag, owner) == True{} : Bool}, +hcap: {U32.is_lt(id, cap) == True{} : Bool}, $KP, +c: Bool, +hc: {U32.is_eq(W32.nth0($GL, $II), g) == c : Bool}) -> $GOAL:
  match c:
    case False{}:
      +ev = iv_gen(~T, $VA, hc1, hcap)
      v_genf(~T, $VA, $FA, ho, hc, $IEQ(($RS, Some{$ST0}), Equal.trans($RES, D.validate(~T, $RS, $HH), ($RS, D.generation_error(U32.is_eq(W32.nth0($GL, $II), g))), ($RS, Some{$ST0}), ev, Equal.cong(Bool, $RES, z => ($RS, D.generation_error(z)), U32.is_eq(W32.nth0($GL, $II), g), False{}, hc))), Nat.is_lt($II, $FV), {==})
    case True{}:
      +ev = iv_gen(~T, $VA, hc1, hcap)
      v_go(~T, $VA, $FA, ho, hc, $IEQ(($RS, None{}), Equal.trans($RES, D.validate(~T, $RS, $HH), ($RS, D.generation_error(U32.is_eq(W32.nth0($GL, $II), g))), ($RS, None{}), ev, Equal.cong(Bool, $RES, z => ($RS, D.generation_error(z)), U32.is_eq(W32.nth0($GL, $II), g), True{}, hc))), $KA, Nat.is_lt($II, $FV), {==})

# the id at or above the capacity is above every issued id
def cap_hi(~T: Data, $VP, +hcap: {U32.is_lt(id, cap) == False{} : Bool}) -> {Nat.is_lt($II, $FV) == False{} : Bool}:
  +hle = N.not_lt_le($II, UD.v(cap), Equal.trans(Bool, Nat.is_lt($II, UD.v(cap)), U32.is_lt(id, cap), False{}, Equal.sym(Bool, U32.is_lt(id, cap), Nat.is_lt($II, UD.v(cap)), U.is_lt_nat(id, cap)), hcap))
  N.le_not_lt($II, $FV, N.le_trans($FV, UD.v(cap), $II, $G(cfr), hle))

def v_cap(~T: Data, $VP, $FP, $HO, +hc1: {U32.is_eq(tag, owner) == True{} : Bool}, $KP, +c: Bool, +hc: {U32.is_lt(id, cap) == c : Bool}) -> $GOAL:
  match c:
    case False{}:
      v_close(~T, $VA, $FA, $ST0, hfS, $IEQ(($RS, Some{$ST0}), iv_cap(~T, $VA, hc1, hc)), $SEQ(Some{$ST0}, sv_hi(~T, $VA, ho, cap_hi(~T, $VA, hc))))
    case True{}:
      v_gen(~T, $VA, $FA, ho, hc1, hc, $KA, U32.is_eq(W32.nth0($GL, $II), g), {==})

def v_own(~T: Data, $VP, $FP, $KP, +c: Bool, +hc: {U32.is_eq(tag, owner) == c : Bool}) -> $GOAL:
  match c:
    case False{}:
      +hs = Equal.trans(Bool, U32.is_eq(owner, tag), U32.is_eq(tag, owner), False{}, W32.eq_sym_u32(owner, tag), hc)
      v_close(~T, $VA, $FA, $FT, hfF, $IEQ(($RS, Some{$FT}), iv_foreign(~T, $VA, hc)), $SEQ(Some{$FT}, sv_foreign(~T, $VA, hs)))
    case True{}:
      +hs = Equal.trans(Bool, U32.is_eq(owner, tag), U32.is_eq(tag, owner), True{}, W32.eq_sym_u32(owner, tag), hc)
      v_cap(~T, $VA, $FA, hs, hc, $KA, U32.is_lt(id, cap), {==})

# THEOREM (validation): an operation on a handle refines the specification's
# when its storage part does, on a live element with a current handle, and
# fails as the specification's otherwise
def vstep(~T: Data, $VP, $FP, $KP) -> $GOAL:
  v_own(~T, $VA, $FA, $KA, U32.is_eq(tag, owner), {==})
