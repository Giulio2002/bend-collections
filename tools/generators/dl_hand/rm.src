# Removal of a live element: unlinked from between its neighbours, its value
# dropped, and its id either retired (generation exhausted) or pushed on the
# free stack at the next generation.

%def APN(a, b) SC.append(Nat, a, b)
%def MT Maybe<&2, T>
%def PP LST.last_or(a, 0)
%def QQ LST.fst_or(b, 0)
%def VL AR.slots($MT, vT)
%def PL AR.slots(U32, pT)
%def NL AR.slots(U32, nT)
%def GL AR.slots(U32, gT)
%def FV UD.v(fresh)
%def TR(x) {x == True{} : Bool}
%def SS UD.v(id)
%def SL $APN(a, Con{$SS, b})
%def SL2 $APN(a, b)
%def VLF SC.take($MT, $VL, $FV)
%def GLF SC.take(U32, $GL, $FV)
%def VR AR.upd($MT, depth, vT, $SS, None{})
%def PR RL.tu_first(depth, pT, b, $PP)
%def NR RL.tu_last(depth, nT, a, $QQ)
%def VL2 SC.update($MT, $VL, $SS, None{})
%def PL2 RL.upd_first($PL, b, $PP)
%def NL2 RL.upd_last($NL, a, $QQ)
%def SH0 tag, cap, fresh, free, head, tail, depth, vT, pT, nT, gT, $SL, fl
%def G(c) ST.g_$c(~T, $SH0, hg)
%def RP +one: Nat, +h1: {one == 1n : Nat}, +tag: U32, +cap: U32, +fresh: U32, +free: U32, +head: U32, +tail: U32, +depth: Nat, +vT: AR.Tree<$MT>, +pT: AR.Tree<U32>, +nT: AR.Tree<U32>, +gT: AR.Tree<U32>, +a: List<&2, Nat>, +id: U32, +b: List<&2, Nat>, +fl: List<&2, Nat>, +hg: $TR(ST.goodF(~T, $SH0))
%def RA one, h1, tag, cap, fresh, free, head, tail, depth, vT, pT, nT, gT, a, id, b, fl, hg

# ---- the specification's delete ----

def del_mid(+a: List<&2, Nat>, +s: Nat, +b: List<&2, Nat>, +h: {HT.memn(s, a) == False{} : Bool}) -> {S.delete($APN(a, Con{s, b}), s) == $APN(a, b) : List<&2, Nat>}:
  match a:
    case Nil{}:
      Equal.cong(Bool, List<&2, Nat>, z => S.pick_list(z, b, Con{s, S.delete(b, s)}), Nat.is_eq(s, s), True{}, N.is_eq_refl(s))
    case Con{+x, +t}:
      +e0 = Equal.cong(Bool, List<&2, Nat>, z => S.pick_list(z, $APN(t, Con{s, b}), Con{x, S.delete($APN(t, Con{s, b}), s)}), Nat.is_eq(x, s), False{}, DL.or_ff_l(Nat.is_eq(x, s), HT.memn(s, t), h))
      Equal.trans(List<&2, Nat>, S.delete($APN(Con{x, t}, Con{s, b}), s), Con{x, S.delete($APN(t, Con{s, b}), s)}, Con{x, $APN(t, b)}, e0, LL.cons_cong(Nat, x, S.delete($APN(t, Con{s, b}), s), $APN(t, b), del_mid(t, s, b, DL.or_ff_r(Nat.is_eq(x, s), HT.memn(s, t), h))))

# ---- facts of the removed state ----

def s_in(+a: List<&2, Nat>, +s: Nat, +b: List<&2, Nat>) -> $TR(HT.memn(s, $APN(a, Con{s, b}))):
  LS.mem_app_r(s, a, Con{s, b}, RL.self_in(s, b))

def s_off(+a: List<&2, Nat>, +s: Nat, +b: List<&2, Nat>, +hn: $TR(LST.nodupn($APN(a, Con{s, b})))) -> {HT.memn(s, $APN(a, b)) == False{} : Bool}:
  +h = RL.to_eq(LST.nodupn($APN(a, Con{s, b})), Bool.and(LST.nodupn($APN(a, b)), Bool.not(HT.memn(s, $APN(a, b)))), LS.nd_mid(a, s, b), hn)
  LS.not_t_f(HT.memn(s, $APN(a, b)), L.and_right(LST.nodupn($APN(a, b)), Bool.not(HT.memn(s, $APN(a, b))), h))

def nd_rm(+a: List<&2, Nat>, +s: Nat, +b: List<&2, Nat>, +hn: $TR(LST.nodupn($APN(a, Con{s, b})))) -> $TR(LST.nodupn($APN(a, b))):
  +h = RL.to_eq(LST.nodupn($APN(a, Con{s, b})), Bool.and(LST.nodupn($APN(a, b)), Bool.not(HT.memn(s, $APN(a, b)))), LS.nd_mid(a, s, b), hn)
  L.and_left(LST.nodupn($APN(a, b)), Bool.not(HT.memn(s, $APN(a, b))), h)

def s_live(~T: Data, $RP) -> $TR(Bool.and(Nat.is_lt($SS, $FV), ST.live(T, $VL, $SS))):
  RL.slok_mem(~T, $SS, $SL, $FV, $VL, $G(csl), s_in(a, $SS, b))

def s_lt(~T: Data, $RP) -> $TR(Nat.is_lt($SS, SC.pow2(depth))):
  +e2d = N.eq_from_is_eq(UD.v(cap), SC.pow2(depth), $G(ccap))
  +hfr2 = L.subst(Nat, z => {Nat.is_le($FV, z) == True{} : Bool}, UD.v(cap), SC.pow2(depth), e2d, $G(cfr))
  N.lt_le_trans($SS, $FV, SC.pow2(depth), L.and_left(Nat.is_lt($SS, $FV), ST.live(T, $VL, $SS), s_live(~T, $RA)), hfr2)

def fr2d(~T: Data, $RP) -> $TR(Nat.is_le($FV, SC.pow2(depth))):
  +e2d = N.eq_from_is_eq(UD.v(cap), SC.pow2(depth), $G(ccap))
  L.subst(Nat, z => {Nat.is_le($FV, z) == True{} : Bool}, UD.v(cap), SC.pow2(depth), e2d, $G(cfr))

def a_ok(~T: Data, $RP) -> $TR(ST.slok(~T, a, $FV, $VL)):
  L.and_left(ST.slok(~T, a, $FV, $VL), ST.slok(~T, Con{$SS, b}, $FV, $VL), RL.to_eq(ST.slok(~T, $SL, $FV, $VL), Bool.and(ST.slok(~T, a, $FV, $VL), ST.slok(~T, Con{$SS, b}, $FV, $VL)), RL.slok_app(~T, a, Con{$SS, b}, $FV, $VL), $G(csl)))

def b_ok(~T: Data, $RP) -> $TR(ST.slok(~T, b, $FV, $VL)):
  +h = L.and_right(ST.slok(~T, a, $FV, $VL), ST.slok(~T, Con{$SS, b}, $FV, $VL), RL.to_eq(ST.slok(~T, $SL, $FV, $VL), Bool.and(ST.slok(~T, a, $FV, $VL), ST.slok(~T, Con{$SS, b}, $FV, $VL)), RL.slok_app(~T, a, Con{$SS, b}, $FV, $VL), $G(csl)))
  L.and_right(Bool.and(Nat.is_lt($SS, $FV), ST.live(T, $VL, $SS)), ST.slok(~T, b, $FV, $VL), h)

def slots_pr(~T: Data, $RP) -> {AR.slots(U32, $PR) == $PL2 : List<&2, U32>}:
  RL.tf_s(depth, pT, $G(cpp), b, RL.fstlt_of(~T, b, $FV, $VL, SC.pow2(depth), fr2d(~T, $RA), b_ok(~T, $RA)), $PP)

def slots_nr(~T: Data, $RP) -> {AR.slots(U32, $NR) == $NL2 : List<&2, U32>}:
  RL.tl_s(depth, nT, $G(cpn), a, RL.lastlt_of(~T, a, $FV, $VL, SC.pow2(depth), fr2d(~T, $RA), a_ok(~T, $RA)), $QQ)

# the unlinked list's links
def rg_seg(~T: Data, $RP) -> $TR(ST.seg(AR.slots(U32, $PR), AR.slots(U32, $NR), $SL2, 0, 0)):
  +lp = AR.slots_length(U32, depth, pT, $G(cpp))
  +ln = AR.slots_length(U32, depth, nT, $G(cpn))
  +hfb = IG.fst_len(b, $PL, SC.pow2(depth), lp, RL.fstlt_of(~T, b, $FV, $VL, SC.pow2(depth), fr2d(~T, $RA), b_ok(~T, $RA)))
  +hla = IG.last_len(a, $NL, SC.pow2(depth), ln, RL.lastlt_of(~T, a, $FV, $VL, SC.pow2(depth), fr2d(~T, $RA), a_ok(~T, $RA)))
  +h0 = RL.unl_seg($PL, $NL, a, $SS, b, $G(cseg), $G(cnd), hfb, hla)
  +k1 = L.subst(List<&2, U32>, z => {ST.seg(z, $NL2, $SL2, 0, 0) == True{} : Bool}, $PL2, AR.slots(U32, $PR), Equal.sym(List<&2, U32>, AR.slots(U32, $PR), $PL2, slots_pr(~T, $RA)), h0)
  L.subst(List<&2, U32>, z => {ST.seg(AR.slots(U32, $PR), z, $SL2, 0, 0) == True{} : Bool}, $NL2, AR.slots(U32, $NR), Equal.sym(List<&2, U32>, AR.slots(U32, $NR), $NL2, slots_nr(~T, $RA)), k1)

def rg_fll(~T: Data, $RP) -> $TR(ST.fll(AR.slots(U32, $NR), fl)):
  +h0 = RL.by_eq(ST.fll($NL2, fl), ST.fll($NL, fl), RL.fll_lfn($NL, a, $QQ, fl, LV.lin_vac(~T, a, Con{$SS, b}, $FV, $VL, fl, $G(csl), $G(cfl))), $G(cfll))
  L.subst(List<&2, U32>, z => {ST.fll(z, fl) == True{} : Bool}, $NL2, AR.slots(U32, $NR), Equal.sym(List<&2, U32>, AR.slots(U32, $NR), $NL2, slots_nr(~T, $RA)), h0)

def s_nf(~T: Data, $RP) -> {HT.memn($SS, fl) == False{} : Bool}:
  RL.live_nf(~T, $SS, fl, $FV, $VL, L.and_right(Nat.is_lt($SS, $FV), ST.live(T, $VL, $SS), s_live(~T, $RA)), $G(cfl))

def vslots(~T: Data, $RP) -> {AR.slots($MT, $VR) == $VL2 : List<&2, $MT>}:
  AR.upd_slots($MT, depth, vT, $SS, None{}, s_lt(~T, $RA), $G(cpv))

def rg_sl(~T: Data, $RP) -> $TR(ST.slok(~T, $SL2, $FV, AR.slots($MT, $VR))):
  +h0 = RL.by_eq(ST.slok(~T, $SL2, $FV, $VL), Bool.and(ST.slok(~T, a, $FV, $VL), ST.slok(~T, b, $FV, $VL)), RL.slok_app(~T, a, b, $FV, $VL), L.and_intro(ST.slok(~T, a, $FV, $VL), ST.slok(~T, b, $FV, $VL), a_ok(~T, $RA), b_ok(~T, $RA)))
  +k1 = LV.slok_off(~T, $SL2, $FV, $VL, $SS, None{}, s_off(a, $SS, b, $G(cnd)), h0)
  L.subst(List<&2, $MT>, z => {ST.slok(~T, $SL2, $FV, z) == True{} : Bool}, $VL2, AR.slots($MT, $VR), Equal.sym(List<&2, $MT>, AR.slots($MT, $VR), $VL2, vslots(~T, $RA)), k1)

def rg_lv(~T: Data, $RP) -> $TR(ST.lvin(~T, AR.slots($MT, $VR), 0n, $SL2)):
  +h0 = VA.lvin_none(~T, $VL, 0n, $SL, $SS, $G(clv))
  +k1 = VA.lvin_sub(~T, $VL2, 0n, $SL, Con{$SS, $SL2}, h0, VA.subn_rm(a, $SS, b))
  +hv = Equal.cong($MT, Bool, m => ST.some_b(T, m), S.val_of(T, $VL2, $SS), None{}, VA.val_upd_same(T, $VL, $SS, None{}, IG.len_is($MT, $VL, SC.pow2(depth), AR.slots_length($MT, depth, vT, $G(cpv)), $SS, s_lt(~T, $RA))))
  +h2 = VA.lvin_skip(~T, $VL2, 0n, $SS, $SL2, k1, hv)
  L.subst(List<&2, $MT>, z => {ST.lvin(~T, z, 0n, $SL2) == True{} : Bool}, $VL2, AR.slots($MT, $VR), Equal.sym(List<&2, $MT>, AR.slots($MT, $VR), $VL2, vslots(~T, $RA)), h2)

def rg_fl(~T: Data, $RP) -> $TR(ST.flok(~T, fl, $FV, AR.slots($MT, $VR))):
  +k1 = LV.flok_off(~T, fl, $FV, $VL, $SS, None{}, s_nf(~T, $RA), $G(cfl))
  L.subst(List<&2, $MT>, z => {ST.flok(~T, fl, $FV, z) == True{} : Bool}, $VL2, AR.slots($MT, $VR), Equal.sym(List<&2, $MT>, AR.slots($MT, $VR), $VL2, vslots(~T, $RA)), k1)

# ---- the storage's remove ----

%def RAW0 R.DL{tag, fresh, free, SC.length(Nat, $SL), head, tail, depth, cap, AR.thaw($MT, vT), AR.thaw(U32, pT), AR.thaw(U32, nT)}
%def RAWR R.DL{tag, fresh, free, SC.length(Nat, $SL2), LST.fst_or($SL2, 0), LST.last_or($SL2, 0), depth, cap, AR.thaw($MT, $VR), AR.thaw(U32, $PR), AR.thaw(U32, $NR)}
%def RC(c1, c2) R.remove_checked(~T, c1, tag, fresh, free, SC.length(Nat, $SL), head, tail, depth, cap, AR.thaw($MT, vT), AR.thaw(U32, pT), AR.thaw(U32, nT), id, c2)
%def RF(r) R.rm_found(~T, tag, fresh, free, SC.length(Nat, $SL), head, tail, depth, cap, AR.thaw(U32, pT), AR.thaw(U32, nT), id, r)
%def RLK(p, n) R.rm_links(~T, tag, fresh, free, SC.length(Nat, $SL), head, tail, depth, cap, Array.set($MT, AR.thaw($MT, vT), id, None{}), vv, p, n)
%def DV Result<&2, &2, I.Error, T>
%def RR R.DList<T> & $DV

def sub1(+x: Nat) -> {Nat.sub(1n+x, 1n) == x : Nat}:
  N.sub_zero(x)

def rm_raw(~T: Data, $RP, +owner: U32, +ho: {U32.is_eq(owner, tag) == True{} : Bool}, +vv: T, +hv: {S.val_of(T, $VL, $SS) == Some{vv} : $MT}) -> {R.remove(~T, $RAW0, I.H{owner, id}) == ($RAWR, Done{vv}) : $RR}:
  +hd = $G(cdep)
  +hsl = s_live(~T, $RA)
  +hs = s_lt(~T, $RA)
  +c1 = Equal.cong(Bool, $RR, z => $RC(z, U32.is_eq(owner, tag)), U32.is_lt(id, fresh), True{}, Equal.trans(Bool, U32.is_lt(id, fresh), Nat.is_lt($SS, $FV), True{}, U.is_lt_nat(id, fresh), L.and_left(Nat.is_lt($SS, $FV), ST.live(T, $VL, $SS), hsl)))
  +c2 = Equal.cong(Bool, $RR, z => $RC(True{}, z), U32.is_eq(owner, tag), True{}, ho)
  +c3 = Equal.cong(Array<$MT> & $MT, $RR, z => $RF(z), Array.get($MT, AR.thaw($MT, vT), id), (AR.thaw($MT, vT), S.val_of(T, $VL, $SS)), LN.vget(T, depth, hd, vT, $G(cpv), id, hs))
  +c4 = Equal.cong($MT, $RR, z => $RF((AR.thaw($MT, vT), z)), S.val_of(T, $VL, $SS), Some{vv}, hv)
  +ep = RL.unl_p($PL, $NL, a, $SS, b, $G(cseg))
  +en = RL.unl_n($PL, $NL, a, $SS, b, $G(cseg))
  +c5 = Equal.cong(Array<U32> & U32, $RR, z => $RLK(z, Array.get(U32, AR.thaw(U32, nT), id)), Array.get(U32, AR.thaw(U32, pT), id), (AR.thaw(U32, pT), $PP), Equal.trans(Array<U32> & U32, Array.get(U32, AR.thaw(U32, pT), id), (AR.thaw(U32, pT), TB.nth0($PL, $SS)), (AR.thaw(U32, pT), $PP), MT.uget(depth, RL.hd0(depth, hd), pT, $G(cpp), id, hs), Equal.cong(U32, Array<U32> & U32, z => (AR.thaw(U32, pT), z), TB.nth0($PL, $SS), $PP, ep)))
  +c6 = Equal.cong(Array<U32> & U32, $RR, z => $RLK((AR.thaw(U32, pT), $PP), z), Array.get(U32, AR.thaw(U32, nT), id), (AR.thaw(U32, nT), $QQ), Equal.trans(Array<U32> & U32, Array.get(U32, AR.thaw(U32, nT), id), (AR.thaw(U32, nT), TB.nth0($NL, $SS)), (AR.thaw(U32, nT), $QQ), MT.uget(depth, RL.hd0(depth, hd), nT, $G(cpn), id, hs), Equal.cong(U32, Array<U32> & U32, z => (AR.thaw(U32, nT), z), TB.nth0($NL, $SS), $QQ, en)))
  +hfb = RL.fstlt_of(~T, b, $FV, $VL, SC.pow2(depth), fr2d(~T, $RA), b_ok(~T, $RA))
  +hla = RL.lastlt_of(~T, a, $FV, $VL, SC.pow2(depth), fr2d(~T, $RA), a_ok(~T, $RA))
  +ec = Equal.trans(Nat, Nat.sub(SC.length(Nat, $SL), 1n), Nat.sub(1n+SC.length(Nat, $SL2), 1n), SC.length(Nat, $SL2), Equal.cong(Nat, Nat, z => Nat.sub(z, 1n), SC.length(Nat, $SL), 1n+SC.length(Nat, $SL2), LN.len_mid(a, $SS, b)), sub1(SC.length(Nat, $SL2)))
  +e7 = LN.dl_eq(T, tag, fresh, free, Nat.sub(SC.length(Nat, $SL), 1n), SC.length(Nat, $SL2), R.pick_end(U32.is_eq($PP, 0), $QQ, head), LST.fst_or($SL2, 0), R.pick_end(U32.is_eq($QQ, 0), $PP, tail), LST.last_or($SL2, 0), depth, cap, Array.set($MT, AR.thaw($MT, vT), id, None{}), $VR, R.set_next(AR.thaw(U32, pT), $QQ, $PP), $PR, R.set_next(AR.thaw(U32, nT), $PP, $QQ), $NR, ec, LN.hd_rm(one, h1, depth, hd, a, $SS, b, head, $G(chead), hla), LN.tl_rm(one, h1, depth, hd, a, $SS, b, tail, $G(ctail), hfb), LN.vset(T, depth, hd, vT, $G(cpv), id, hs, None{}), RL.sn_first(one, h1, depth, hd, pT, $G(cpp), b, hfb, $PP), RL.sn_last(one, h1, depth, hd, nT, $G(cpn), a, hla, $QQ))
  +c7 = Equal.cong(R.DList<T>, $RR, r => (r, Done{vv}), R.DL{tag, fresh, free, Nat.sub(SC.length(Nat, $SL), 1n), R.pick_end(U32.is_eq($PP, 0), $QQ, head), R.pick_end(U32.is_eq($QQ, 0), $PP, tail), depth, cap, Array.set($MT, AR.thaw($MT, vT), id, None{}), R.set_next(AR.thaw(U32, pT), $QQ, $PP), R.set_next(AR.thaw(U32, nT), $PP, $QQ)}, $RAWR, e7)
  Equal.trans($RR, R.remove(~T, $RAW0, I.H{owner, id}), $RC(True{}, U32.is_eq(owner, tag)), ($RAWR, Done{vv}), c1, Equal.trans($RR, $RC(True{}, U32.is_eq(owner, tag)), $RF(Array.get($MT, AR.thaw($MT, vT), id)), ($RAWR, Done{vv}), c2, Equal.trans($RR, $RF(Array.get($MT, AR.thaw($MT, vT), id)), $RF((AR.thaw($MT, vT), S.val_of(T, $VL, $SS))), ($RAWR, Done{vv}), c3, Equal.trans($RR, $RF((AR.thaw($MT, vT), S.val_of(T, $VL, $SS))), $RLK(Array.get(U32, AR.thaw(U32, pT), id), Array.get(U32, AR.thaw(U32, nT), id)), ($RAWR, Done{vv}), c4, Equal.trans($RR, $RLK(Array.get(U32, AR.thaw(U32, pT), id), Array.get(U32, AR.thaw(U32, nT), id)), $RLK((AR.thaw(U32, pT), $PP), Array.get(U32, AR.thaw(U32, nT), id)), ($RAWR, Done{vv}), c5, Equal.trans($RR, $RLK((AR.thaw(U32, pT), $PP), Array.get(U32, AR.thaw(U32, nT), id)), $RLK((AR.thaw(U32, pT), $PP), (AR.thaw(U32, nT), $QQ)), ($RAWR, Done{vv}), c6, c7))))))

# ---- the public removal ----

%def OB E.Obs<T>
%def MAX 4294967295
%def OV E.OVal{Done{vv}}
%def SPR(g) S.removed(T, tag, $SL, $VLF, $SS, vv, S.retire($GLF, $SS, fl, g, U32.is_eq(g, $MAX)))
%def IMR(c) D.retire(~T, tag, depth, cap, $RAWR, AR.thaw(U32, gT), id, generation, vv, c)
%def SHX ST.LS{tag, cap, fresh, free, LST.fst_or($SL2, 0), LST.last_or($SL2, 0), depth, $VR, $PR, $NR, gT, $SL2, fl}
%def NR3 AR.upd(U32, depth, $NR, $SS, free)
%def GR3 AR.upd(U32, depth, gT, $SS, U32.inc(generation))
%def SHR ST.LS{tag, cap, fresh, LST.lnk($SS), LST.fst_or($SL2, 0), LST.last_or($SL2, 0), depth, $VR, $PR, $NR3, $GR3, $SL2, Con{$SS, fl}}
%def XP +owner: U32, +ho: {U32.is_eq(owner, tag) == True{} : Bool}, +generation: U32, +hgen: {generation == TB.nth0($GL, $SS) : U32}, +vv: T, +hv: {S.val_of(T, $VL, $SS) == Some{vv} : $MT}
%def XA owner, ho, generation, hgen, vv, hv

def del_eq(~T: Data, $RP) -> {S.delete($SL, $SS) == $SL2 : List<&2, Nat>}:
  del_mid(a, $SS, b, LS.nd_dj(a, Con{$SS, b}, $G(cnd), $SS, RL.self_in($SS, b)))

def vals_eq(~T: Data, $RP) -> {SC.update($MT, $VLF, $SS, None{}) == SC.take($MT, AR.slots($MT, $VR), $FV) : List<&2, $MT>}:
