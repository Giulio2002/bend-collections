      and_comm(Bool.not(HT.memn(s, b)), ST.nodupn(b))
    case Con{+h, +t}:
      +X = HT.memn(h, $APN(t, b))
      +Z = ST.nodupn($APN(t, b))
      +Wm = HT.memn(s, $APN(t, b))
      +e1 = Equal.cong(Bool, Bool, z => Bool.and(Bool.not(z), ST.nodupn($APN(t, Con{s, b}))), HT.memn(h, $APN(t, Con{s, b})), Bool.or(X, Nat.is_eq(s, h)), memn_mid(h, t, s, b))
      +e2 = Equal.cong(Bool, Bool, z => Bool.and(Bool.not(Bool.or(X, Nat.is_eq(s, h))), z), ST.nodupn($APN(t, Con{s, b})), Bool.and(Z, Bool.not(Wm)), nd_mid(t, s, b))
      +e3 = bt_mid(X, Nat.is_eq(s, h), Z, Wm)
      +e4 = Equal.cong(Bool, Bool, z => Bool.and(Bool.and(Bool.not(X), Z), Bool.not(Bool.or(z, Wm))), Nat.is_eq(s, h), Nat.is_eq(h, s), is_eq_sym(s, h))
      Equal.trans(Bool, ST.nodupn($APN(Con{h, t}, Con{s, b})), Bool.and(Bool.not(Bool.or(X, Nat.is_eq(s, h))), ST.nodupn($APN(t, Con{s, b}))), Bool.and(Bool.and(Bool.not(X), Z), Bool.not(Bool.or(Nat.is_eq(h, s), Wm))), e1, Equal.trans(Bool, Bool.and(Bool.not(Bool.or(X, Nat.is_eq(s, h))), ST.nodupn($APN(t, Con{s, b}))), Bool.and(Bool.not(Bool.or(X, Nat.is_eq(s, h))), Bool.and(Z, Bool.not(Wm))), Bool.and(Bool.and(Bool.not(X), Z), Bool.not(Bool.or(Nat.is_eq(h, s), Wm))), e2, Equal.trans(Bool, Bool.and(Bool.not(Bool.or(X, Nat.is_eq(s, h))), Bool.and(Z, Bool.not(Wm))), Bool.and(Bool.and(Bool.not(X), Z), Bool.not(Bool.or(Nat.is_eq(s, h), Wm))), Bool.and(Bool.and(Bool.not(X), Z), Bool.not(Bool.or(Nat.is_eq(h, s), Wm))), e3, e4)))

# ---- key lists ----

%def APS(a, b) SC.append(String, a, b)

def mem_app_s(+x: String, +a: List<&2, String>, +b: List<&2, String>) -> {S.mem(x, $APS(a, b)) == Bool.or(S.mem(x, a), S.mem(x, b)) : Bool}:
