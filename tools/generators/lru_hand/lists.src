      Equal.trans(Bool, Bool.or(S.str_eq(h, x), S.mem(x, $APS(t, Con{s, b}))), Bool.or(S.str_eq(h, x), Bool.or(S.mem(x, $APS(t, b)), S.str_eq(s, x))), Bool.or(Bool.or(S.str_eq(h, x), S.mem(x, $APS(t, b))), S.str_eq(s, x)), Equal.cong(Bool, Bool, z => Bool.or(S.str_eq(h, x), z), S.mem(x, $APS(t, Con{s, b})), Bool.or(S.mem(x, $APS(t, b)), S.str_eq(s, x)), mem_mid_s(x, t, s, b)), or_assoc(S.str_eq(h, x), S.mem(x, $APS(t, b)), S.str_eq(s, x)))

def nd_mid_s(+a: List<&2, String>, +s: String, +b: List<&2, String>) -> {S.nodup($APS(a, Con{s, b})) == Bool.and(S.nodup($APS(a, b)), Bool.not(S.mem(s, $APS(a, b)))) : Bool}:
