# List algebra for the recency list and the model's keys: membership,
# duplicate-freedom and the per-slot predicates over appends.

%def APN(a, b) SC.append(Nat, a, b)

# ---- Bool algebra ----

def or_assoc(+a: Bool, +b: Bool, +c: Bool) -> {Bool.or(a, Bool.or(b, c)) == Bool.or(Bool.or(a, b), c) : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      {==}

def or_comm(+a: Bool, +b: Bool) -> {Bool.or(a, b) == Bool.or(b, a) : Bool}:
  match a b:
    case True{} True{}:
      {==}
    case True{} False{}:
      {==}
    case False{} True{}:
      {==}
    case False{} False{}:
      {==}

def and_assoc(+a: Bool, +b: Bool, +c: Bool) -> {Bool.and(a, Bool.and(b, c)) == Bool.and(Bool.and(a, b), c) : Bool}:
  match a:
    case True{}:
      {==}
    case False{}:
      {==}

def and_comm(+a: Bool, +b: Bool) -> {Bool.and(a, b) == Bool.and(b, a) : Bool}:
  match a b:
    case True{} True{}:
      {==}
    case True{} False{}:
      {==}
    case False{} True{}:
      {==}
    case False{} False{}:
      {==}

# not (x or y) and (z and not w)  ==  (not x and z) and not (y or w)
def bt_mid(+x: Bool, +y: Bool, +z: Bool, +w: Bool) -> {Bool.and(Bool.not(Bool.or(x, y)), Bool.and(z, Bool.not(w))) == Bool.and(Bool.and(Bool.not(x), z), Bool.not(Bool.or(y, w))) : Bool}:
  match x y z w:
    case True{} y2 z2 w2:
      {==}
    case False{} True{} z2 w2:
      +e = and_comm(z2, False{})
      Equal.trans(Bool, Bool.and(False{}, Bool.and(z2, Bool.not(w2))), False{}, Bool.and(z2, False{}), {==}, Equal.sym(Bool, Bool.and(z2, False{}), False{}, Equal.trans(Bool, Bool.and(z2, False{}), Bool.and(False{}, z2), False{}, e, {==})))
    case False{} False{} True{} w2:
      {==}
    case False{} False{} False{} w2:
      {==}

def is_eq_sym(+a: Nat, +b: Nat) -> {Nat.is_eq(a, b) == Nat.is_eq(b, a) : Bool}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      is_eq_sym(p, q)

# ---- slot lists ----

def memn_app(+x: Nat, +a: List<&2, Nat>, +b: List<&2, Nat>) -> {HT.memn(x, $APN(a, b)) == Bool.or(HT.memn(x, a), HT.memn(x, b)) : Bool}:
  match a:
    case Nil{}:
      {==}
    case Con{+h, +t}:
      Equal.trans(Bool, Bool.or(Nat.is_eq(h, x), HT.memn(x, $APN(t, b))), Bool.or(Nat.is_eq(h, x), Bool.or(HT.memn(x, t), HT.memn(x, b))), Bool.or(Bool.or(Nat.is_eq(h, x), HT.memn(x, t)), HT.memn(x, b)), Equal.cong(Bool, Bool, z => Bool.or(Nat.is_eq(h, x), z), HT.memn(x, $APN(t, b)), Bool.or(HT.memn(x, t), HT.memn(x, b)), memn_app(x, t, b)), or_assoc(Nat.is_eq(h, x), HT.memn(x, t), HT.memn(x, b)))

def memn_mid(+x: Nat, +a: List<&2, Nat>, +s: Nat, +b: List<&2, Nat>) -> {HT.memn(x, $APN(a, Con{s, b})) == Bool.or(HT.memn(x, $APN(a, b)), Nat.is_eq(s, x)) : Bool}:
  match a:
    case Nil{}:
      or_comm(Nat.is_eq(s, x), HT.memn(x, b))
    case Con{+h, +t}:
      Equal.trans(Bool, Bool.or(Nat.is_eq(h, x), HT.memn(x, $APN(t, Con{s, b}))), Bool.or(Nat.is_eq(h, x), Bool.or(HT.memn(x, $APN(t, b)), Nat.is_eq(s, x))), Bool.or(Bool.or(Nat.is_eq(h, x), HT.memn(x, $APN(t, b))), Nat.is_eq(s, x)), Equal.cong(Bool, Bool, z => Bool.or(Nat.is_eq(h, x), z), HT.memn(x, $APN(t, Con{s, b})), Bool.or(HT.memn(x, $APN(t, b)), Nat.is_eq(s, x)), memn_mid(x, t, s, b)), or_assoc(Nat.is_eq(h, x), HT.memn(x, $APN(t, b)), Nat.is_eq(s, x)))

def nd_mid(+a: List<&2, Nat>, +s: Nat, +b: List<&2, Nat>) -> {ST.nodupn($APN(a, Con{s, b})) == Bool.and(ST.nodupn($APN(a, b)), Bool.not(HT.memn(s, $APN(a, b)))) : Bool}:
