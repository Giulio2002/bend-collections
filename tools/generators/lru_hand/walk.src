import Base
import ../lib/logic.bend as L
import ../lib/nat.bend as N
import ../lib/u32alg.bend as A
import ../lib/array.bend as AR
import ../lib/list.bend as LI
import ../spec/common.bend as SC
import ../spec/lru.bend as SP
import ../math/u32div.bend as UD
import ../../src/math/u64.bend as W
import ../../src/containers/hash_table.bend as H
import ../../src/containers/lru.bend as LR
import ../hash_table/table.bend as TB
import ../hash_table/state.bend as HT
import ../hash_table/keysw.bend as KW
import ../hash_table/strings.bend as STR
import ../hash_table/arena.bend as AN
import ./state.bend as ST
import ./unlink.bend as UL
import ./gone.bend as GO
import ./idx.bend as ID
import ./touch.bend as TO

# The key walk of keys: from the tail back along prev links, prepending each
# slot's key (a one-character key read from its tagged word, a longer one
# copied out of ks and put back).

# ---- lists ----

%def SVT Sigma<&1, &1, V, v => {HT.nthm(~V, el, s) == Some{v} : Maybe<&2, V>}>

# the value of a live slot
def some_v(~V: Data, +el: List<&2, Maybe<&2, V>>, +s: Nat, +m: Maybe<&2, V>, +hmm: {HT.nthm(~V, el, s) == m : Maybe<&2, V>}, +hsm: {HT.some_b(~V, m) == True{} : Bool}) -> $SVT:
  match m:
    case None{}:
      Empty.absurd($SVT, L.false_true(hsm))
    case Some{+v}:
      (v, hmm)

# l reversed onto b
def rapp(l: List<&2, Nat>, b: List<&2, Nat>) -> List<&2, Nat>:
  match l:
    case Nil{}:
      b
    case Con{+x, r}:
      rapp(r, Con{x, b})

# the keys of the slots of l
def mapk(+ll: List<&2, U32>, +kl: List<&2, String>, l: List<&2, Nat>) -> List<&2, String>:
  match l:
    case Nil{}:
      Nil{}
    case Con{+x, r}:
      Con{ST.skey(ll, kl, x), mapk(ll, kl, r)}

# the keys of the slots of back prepended to acc, one by one
def racc(+ll: List<&2, U32>, +kl: List<&2, String>, back: List<&2, Nat>, acc: List<&2, String>) -> List<&2, String>:
  match back:
    case Nil{}:
      acc
    case Con{+x, r}:
      racc(ll, kl, r, Con{ST.skey(ll, kl, x), acc})

# every slot of back is below fr and its prev is the next slot of back
def rok(+ll: List<&2, U32>, back: List<&2, Nat>, +fr: Nat) -> Bool:
  match back:
    case Nil{}:
      True{}
    case Con{+x, +r}:
      Bool.and(Nat.is_lt(x, fr), Bool.and(U32.is_eq(ST.lw(ll, x, 0n), ST.fst_or(r, 0)), rok(ll, r, fr)))

def ra_rapp(+ll: List<&2, U32>, +kl: List<&2, String>, +l: List<&2, Nat>, +b: List<&2, Nat>, +acc: List<&2, String>) -> {racc(ll, kl, rapp(l, b), acc) == racc(ll, kl, b, SC.append(String, mapk(ll, kl, l), acc)) : List<&2, String>}:
  match l:
    case Nil{}:
      {==}
    case Con{+x, +r}:
      ra_rapp(ll, kl, r, Con{x, b}, acc)

def len_rapp(+l: List<&2, Nat>, +b: List<&2, Nat>) -> {SC.length(Nat, rapp(l, b)) == Nat.add(SC.length(Nat, l), SC.length(Nat, b)) : Nat}:
  match l:
    case Nil{}:
      {==}
    case Con{+x, +r}:
      Equal.trans(Nat, SC.length(Nat, rapp(r, Con{x, b})), Nat.add(SC.length(Nat, r), 1n+SC.length(Nat, b)), 1n+Nat.add(SC.length(Nat, r), SC.length(Nat, b)), len_rapp(r, Con{x, b}), N.add_succ(SC.length(Nat, r), SC.length(Nat, b)))

def fo_rapp(+l: List<&2, Nat>, +b: List<&2, Nat>, +d: U32) -> {ST.fst_or(rapp(l, b), d) == ST.last_or(l, ST.fst_or(b, d)) : U32}:
  match l:
    case Nil{}:
      {==}
    case Con{+x, +r}:
      fo_rapp(r, Con{x, b}, d)

def lo_idem(+l: List<&2, Nat>, +p: U32) -> {ST.last_or(l, ST.last_or(l, p)) == ST.last_or(l, p) : U32}:
  match l:
    case Nil{}:
      {==}
    case Con{+x, +r}:
      {==}

def fo_of(+r: List<&2, Nat>, +a: U32, +h: {U32.is_eq(a, ST.fst_or(r, 0)) == True{} : Bool}) -> {ST.fst_or(r, a) == a : U32}:
  match r:
    case Nil{}:
      {==}
    case Con{+y, +t}:
      Equal.sym(U32, a, ST.lnk(y), A.eq_of(a, ST.lnk(y), h))

# the list sl, reversed, keeps its links backwards
def rok_app(~V: Data, +ll: List<&2, U32>, +el: List<&2, Maybe<&2, V>>, +l: List<&2, Nat>, +b: List<&2, Nat>, +fr: Nat, +p: U32, +q: U32, +hs: {ST.seg(ll, l, p, q) == True{} : Bool}, +hl: {ST.slok(~V, l, fr, el) == True{} : Bool}, +hb: {rok(ll, b, fr) == True{} : Bool}, +hp: {U32.is_eq(p, ST.fst_or(b, 0)) == True{} : Bool}) -> {rok(ll, rapp(l, b), fr) == True{} : Bool}:
  match l:
    case Nil{}:
      hb
    case Con{+x, +r}:
      +ha = L.and_left(U32.is_eq(ST.lw(ll, x, 0n), p), Bool.and(U32.is_eq(ST.lw(ll, x, 1n), ST.fst_or(r, q)), ST.seg(ll, r, ST.lnk(x), q)), hs)
      +hc = L.and_right(U32.is_eq(ST.lw(ll, x, 1n), ST.fst_or(r, q)), ST.seg(ll, r, ST.lnk(x), q), L.and_right(U32.is_eq(ST.lw(ll, x, 0n), p), Bool.and(U32.is_eq(ST.lw(ll, x, 1n), ST.fst_or(r, q)), ST.seg(ll, r, ST.lnk(x), q)), hs))
      +hx = L.and_left(Nat.is_lt(x, fr), ST.live(~V, el, x), L.and_left(Bool.and(Nat.is_lt(x, fr), ST.live(~V, el, x)), ST.slok(~V, r, fr, el), hl))
      +hlr = L.and_right(Bool.and(Nat.is_lt(x, fr), ST.live(~V, el, x)), ST.slok(~V, r, fr, el), hl)
      +el0 = A.eq_of(ST.lw(ll, x, 0n), p, ha)
      +hq = L.subst(U32, z => {U32.is_eq(z, ST.fst_or(b, 0)) == True{} : Bool}, p, ST.lw(ll, x, 0n), Equal.sym(U32, ST.lw(ll, x, 0n), p, el0), hp)
      +hb2 = L.and_intro(Nat.is_lt(x, fr), Bool.and(U32.is_eq(ST.lw(ll, x, 0n), ST.fst_or(b, 0)), rok(ll, b, fr)), hx, L.and_intro(U32.is_eq(ST.lw(ll, x, 0n), ST.fst_or(b, 0)), rok(ll, b, fr), hq, hb))
      rok_app(~V, ll, el, r, Con{x, b}, fr, ST.lnk(x), q, hc, hlr, hb2, A.eq_refl(ST.lnk(x)))

%def LE1 SP.LE{ST.skey(ll, kl, s), v, ST.lw(ll, s, 3n), W.U64{ST.lw(ll, s, 4n), ST.lw(ll, s, 5n)}}
%def EST ST.es(~V, ll, kl, el, t)

def km_v(~V: Data, +ll: List<&2, U32>, +kl: List<&2, String>, +el: List<&2, Maybe<&2, V>>, +s: Nat, +t: List<&2, Nat>, pv: $SVT, +ih: {SP.keys_of(~V, $EST) == mapk(ll, kl, t) : List<&2, String>}) -> {SP.keys_of(~V, ST.es(~V, ll, kl, el, Con{s, t})) == Con{ST.skey(ll, kl, s), mapk(ll, kl, t)} : List<&2, String>}:
  match pv:
    case Tuple{+v, hm}:
      +e = TO.es_cons(~V, ll, kl, el, s, v, hm, t)
      +e1 = Equal.cong(List<&2, SP.Ent<V>>, List<&2, String>, z => SP.keys_of(~V, z), ST.es(~V, ll, kl, el, Con{s, t}), Con{$LE1, $EST}, e)
      +e2 = Equal.cong(List<&2, String>, List<&2, String>, z => Con{ST.skey(ll, kl, s), z}, SP.keys_of(~V, $EST), mapk(ll, kl, t), ih)
      Equal.trans(List<&2, String>, SP.keys_of(~V, ST.es(~V, ll, kl, el, Con{s, t})), Con{ST.skey(ll, kl, s), SP.keys_of(~V, $EST)}, Con{ST.skey(ll, kl, s), mapk(ll, kl, t)}, e1, e2)

# the keys of live slots are the model's keys
def km(~V: Data, +ll: List<&2, U32>, +kl: List<&2, String>, +el: List<&2, Maybe<&2, V>>, +fr: Nat, +sl: List<&2, Nat>, +h: {ST.slok(~V, sl, fr, el) == True{} : Bool}) -> {SP.keys_of(~V, ST.es(~V, ll, kl, el, sl)) == mapk(ll, kl, sl) : List<&2, String>}:
  match sl:
    case Nil{}:
      {==}
    case Con{+s, +t}:
      +hls = L.and_left(Bool.and(Nat.is_lt(s, fr), ST.live(~V, el, s)), ST.slok(~V, t, fr, el), h)
      +ih = km(~V, ll, kl, el, fr, t, L.and_right(Bool.and(Nat.is_lt(s, fr), ST.live(~V, el, s)), ST.slok(~V, t, fr, el), h))
      km_v(~V, ll, kl, el, s, t, some_v(~V, el, s, HT.nthm(~V, el, s), {==}, L.and_right(Nat.is_lt(s, fr), ST.live(~V, el, s), hls)), ih)

# ---- one step ----

%def WP +one: Nat, +h1: {one == 1n : Nat}, +lkT: AR.Tree<U32>, +sd: Nat, +hsd: {Nat.is_lt(3n+sd, 32n) == True{} : Bool}, +hpl: {AR.perfect(U32, 3n+sd, lkT) == True{} : Bool}, +kl: List<&2, String>
%def WPA one, h1, lkT, sd, hsd, hpl, kl
%def LLw AR.slots(U32, lkT)
%def KTP +KT: AR.Tree<String>, +hsl: {AR.slots(String, KT) == kl : List<&2, String>}, +pk: {AR.perfect(String, sd, KT) == True{} : Bool}
%def XP +x: Nat, +acc: List<&2, String>, $KTP, +hs0: {Nat.is_lt(x, SC.pow2(sd)) == True{} : Bool}
%def XPA x, acc, KT, hsl, pk, hs0
%def SUx H.slot(ST.lnk(x))
%def Ix UD.v($SUx)
%def W2x ST.lw($LLw, x, 2n)
%def W0x ST.lw($LLw, x, 0n)
%def TK AR.thaw(String, KT)
%def TL AR.thaw(U32, lkT)
%def WKa LR.WK{$TK, $TL, acc, ST.lnk(x)}
%def WW(b) LR.wk_word($TK, acc, ST.lnk(x), $W2x, $TL, b)
%def SKx ST.skey($LLw, kl, x)
%def HSV UL.ix_o(one, h1, x, sd, hsd, hs0)
%def HSU GO.su_lt($SUx, x, sd, $HSV, hs0)

def WSt(+lkT: AR.Tree<U32>, +kl: List<&2, String>, +sd: Nat, +x: Nat, +acc: List<&2, String>, +KT: AR.Tree<String>) -> Type:
  Sigma<&1, &1, AR.Tree<String>, K2 => {LR.wk_step($WKa) == LR.WK{AR.thaw(String, K2), $TL, Con{$SKx, acc}, $W0x} : LR.Walk} & ({AR.slots(String, K2) == kl : List<&2, String>} & {AR.perfect(String, sd, K2) == True{} : Bool})>

def ws_e1($WP, $XP) -> {LR.wk_step($WKa) == $WW(H.is_short($W2x)) : LR.Walk}:
  +i2 = Equal.trans(Nat, UD.v(LR.hidx($SUx)), ST.off($Ix, 2n), ST.off(x, 2n), ID.w2(one, h1, $SUx, sd, UL.sd3(sd, hsd), $HSU), Equal.cong(Nat, Nat, z => ST.off(z, 2n), $Ix, x, $HSV))
  Equal.cong(Array<U32> & U32, LR.Walk, r => LR.wk_w($TK, acc, ST.lnk(x), r), Array.get(U32, $TL, LR.hidx($SUx)), ($TL, $W2x), GO.rd(one, h1, lkT, sd, hsd, hpl, LR.hidx($SUx), x, 2n, {==}, hs0, i2))

def ws_r0($WP, +x: Nat, +hs0: {Nat.is_lt(x, SC.pow2(sd)) == True{} : Bool}) -> {Array.get(U32, $TL, LR.pidx($SUx)) == ($TL, $W0x) : Array<U32> & U32}:
  +i0 = Equal.trans(Nat, UD.v(LR.pidx($SUx)), ST.off($Ix, 0n), ST.off(x, 0n), ID.w0(one, h1, $SUx, sd, UL.sd3(sd, hsd), $HSU), Equal.cong(Nat, Nat, z => ST.off(z, 0n), $Ix, x, $HSV))
  GO.rd(one, h1, lkT, sd, hsd, hpl, LR.pidx($SUx), x, 0n, {==}, hs0, i0)

%def SK SCon{Chr{U32.and($W2x, 2147483647)}, SNil{}}
%def GP0 Array.get(U32, $TL, LR.pidx($SUx))

def ws_sh($WP, $XP, +hd: {H.is_short($W2x) == True{} : Bool}) -> WSt(lkT, kl, sd, x, acc, KT):
  +e1 = ws_e1($WPA, $XPA)
  +e2 = Equal.cong(Bool, LR.Walk, b => $WW(b), H.is_short($W2x), True{}, hd)
  +e3 = Equal.cong(Array<U32> & U32, LR.Walk, r => LR.wk_p($TK, Con{$SK, acc}, r), $GP0, ($TL, $W0x), ws_r0($WPA, x, hs0))
  +ek = Equal.cong(Bool, String, b => TB.keyof_c($W2x, TB.nths(kl, x), b), H.is_short($W2x), True{}, hd)
  +e4 = Equal.cong(String, LR.Walk, z => LR.WK{$TK, $TL, Con{z, acc}, $W0x}, $SK, $SKx, Equal.sym(String, $SKx, $SK, ek))
  +eq = Equal.trans(LR.Walk, LR.wk_step($WKa), $WW(H.is_short($W2x)), LR.WK{$TK, $TL, Con{$SKx, acc}, $W0x}, e1, Equal.trans(LR.Walk, $WW(H.is_short($W2x)), $WW(True{}), LR.WK{$TK, $TL, Con{$SKx, acc}, $W0x}, e2, Equal.trans(LR.Walk, $WW(True{}), LR.WK{$TK, $TL, Con{$SK, acc}, $W0x}, LR.WK{$TK, $TL, Con{$SKx, acc}, $W0x}, e3, e4)))
  (KT, (eq, (hsl, pk)))

%def SLK AR.slots(String, KT)
%def X0 TB.nths($SLK, $Ix)
%def K1 AR.upd(String, sd, KT, $Ix, SNil{})
%def K2 AR.upd(String, sd, $K1, $Ix, $X0)
%def TK1 AR.thaw(String, $K1)
%def TK2 AR.thaw(String, $K2)
%def HLT AN.len_eq_lt(String, $SLK, sd, AR.slots_length(String, sd, KT, pk), $Ix, $HSU)

def ws_lg($WP, $XP, +hd: {H.is_short($W2x) == False{} : Bool}) -> WSt(lkT, kl, sd, x, acc, KT):
  +hsd32 = N.lt_trans(sd, 1n+sd, 32n, N.lt_succ(sd), UL.sd1(sd, hsd))
  +hx = TB.nths_some($SLK, $Ix, $HLT)
  +esw = AR.swap(String, sd, KT, $SUx, SNil{}, $X0, hsd32, $HSU, hx, pk)
  +p1 = AR.upd_perfect(String, sd, KT, $Ix, SNil{}, pk)
  +es1 = AR.upd_slots(String, sd, KT, $Ix, SNil{}, $HSU, pk)
  +hx1 = L.subst(List<&2, String>, z => {SC.nth(String, z, $Ix) == Some{SNil{}} : Maybe<&2, String>}, SC.update(String, $SLK, $Ix, SNil{}), AR.slots(String, $K1), Equal.sym(List<&2, String>, AR.slots(String, $K1), SC.update(String, $SLK, $Ix, SNil{}), es1), KW.nth_upd_same($SLK, $Ix, SNil{}, $HLT))
  +est = AR.set(String, sd, $K1, $SUx, $X0, SNil{}, hsd32, $HSU, hx1, p1)
  +e1 = ws_e1($WPA, $XPA)
  +e2 = Equal.cong(Bool, LR.Walk, b => $WW(b), H.is_short($W2x), False{}, hd)
  +e3 = Equal.cong(Array<String> & String, LR.Walk, r => LR.wk_k($TL, acc, ST.lnk(x), r), Array.swap(String, $TK, $SUx, SNil{}), ($TK1, $X0), esw)
  +e4 = Equal.cong(String & String, LR.Walk, r => LR.wk_c($TK1, $TL, acc, ST.lnk(x), r), H.str_copy($X0), ($X0, $X0), STR.str_copy($X0))
  +e5 = Equal.cong(Array<String>, LR.Walk, a => LR.wk_p(a, Con{$X0, acc}, $GP0), Array.set(String, $TK1, $SUx, $X0), $TK2, est)
  +e6 = Equal.cong(Array<U32> & U32, LR.Walk, r => LR.wk_p($TK2, Con{$X0, acc}, r), $GP0, ($TL, $W0x), ws_r0($WPA, x, hs0))
  +ek1 = Equal.cong(List<&2, String>, String, z => TB.nths(z, $Ix), $SLK, kl, hsl)
  +ek2 = Equal.cong(Nat, String, z => TB.nths(kl, z), $Ix, x, $HSV)
  +ek3 = Equal.sym(String, $SKx, TB.nths(kl, x), Equal.cong(Bool, String, b => TB.keyof_c($W2x, TB.nths(kl, x), b), H.is_short($W2x), False{}, hd))
  +ek = Equal.trans(String, $X0, TB.nths(kl, $Ix), $SKx, ek1, Equal.trans(String, TB.nths(kl, $Ix), TB.nths(kl, x), $SKx, ek2, ek3))
  +e7 = Equal.cong(String, LR.Walk, z => LR.WK{$TK2, $TL, Con{z, acc}, $W0x}, $X0, $SKx, ek)
  +eq = Equal.trans(LR.Walk, LR.wk_step($WKa), $WW(H.is_short($W2x)), LR.WK{$TK2, $TL, Con{$SKx, acc}, $W0x}, e1, Equal.trans(LR.Walk, $WW(H.is_short($W2x)), $WW(False{}), LR.WK{$TK2, $TL, Con{$SKx, acc}, $W0x}, e2, Equal.trans(LR.Walk, $WW(False{}), LR.wk_k($TL, acc, ST.lnk(x), ($TK1, $X0)), LR.WK{$TK2, $TL, Con{$SKx, acc}, $W0x}, e3, Equal.trans(LR.Walk, LR.wk_k($TL, acc, ST.lnk(x), ($TK1, $X0)), LR.wk_c($TK1, $TL, acc, ST.lnk(x), ($X0, $X0)), LR.WK{$TK2, $TL, Con{$SKx, acc}, $W0x}, e4, Equal.trans(LR.Walk, LR.wk_c($TK1, $TL, acc, ST.lnk(x), ($X0, $X0)), LR.wk_p($TK2, Con{$X0, acc}, $GP0), LR.WK{$TK2, $TL, Con{$SKx, acc}, $W0x}, e5, Equal.trans(LR.Walk, LR.wk_p($TK2, Con{$X0, acc}, $GP0), LR.WK{$TK2, $TL, Con{$X0, acc}, $W0x}, LR.WK{$TK2, $TL, Con{$SKx, acc}, $W0x}, e6, e7))))))
  +es2 = AR.upd_slots(String, sd, $K1, $Ix, $X0, $HSU, p1)
  +ec = Equal.cong(List<&2, String>, List<&2, String>, z => SC.update(String, z, $Ix, $X0), AR.slots(String, $K1), SC.update(String, $SLK, $Ix, SNil{}), es1)
  +euu = TB.upd_upd($SLK, $Ix, SNil{}, $X0)
  +eus = TB.upd_self($SLK, $Ix)
  +esl = Equal.trans(List<&2, String>, AR.slots(String, $K2), SC.update(String, AR.slots(String, $K1), $Ix, $X0), kl, es2, Equal.trans(List<&2, String>, SC.update(String, AR.slots(String, $K1), $Ix, $X0), SC.update(String, SC.update(String, $SLK, $Ix, SNil{}), $Ix, $X0), kl, ec, Equal.trans(List<&2, String>, SC.update(String, SC.update(String, $SLK, $Ix, SNil{}), $Ix, $X0), SC.update(String, $SLK, $Ix, $X0), kl, euu, Equal.trans(List<&2, String>, SC.update(String, $SLK, $Ix, $X0), $SLK, kl, eus, hsl))))
  ($K2, (eq, (esl, AR.upd_perfect(String, sd, $K1, $Ix, $X0, p1))))

def ws_d($WP, $XP, +d: Bool, +hd: {H.is_short($W2x) == d : Bool}) -> WSt(lkT, kl, sd, x, acc, KT):
  match d:
    case True{}:
      ws_sh($WPA, $XPA, hd)
    case False{}:
      ws_lg($WPA, $XPA, hd)

# THEOREM: one step of the walk prepends the slot's key and moves to its prev
def wstep($WP, $XP) -> WSt(lkT, kl, sd, x, acc, KT):
  ws_d($WPA, $XPA, H.is_short($W2x), {==})

# ---- the walk ----

def WOK(+lkT: AR.Tree<U32>, +kl: List<&2, String>, +sd: Nat, +back: List<&2, Nat>, +acc: List<&2, String>, +at: U32, +KT: AR.Tree<String>) -> Type:
  Sigma<&1, &1, AR.Tree<String>, K2 => Sigma<&1, &1, U32, a2 => {LR.wk_loop(SC.length(Nat, back), LR.WK{$TK, $TL, acc, at}) == LR.WK{AR.thaw(String, K2), $TL, racc($LLw, kl, back, acc), a2} : LR.Walk} & ({AR.slots(String, K2) == kl : List<&2, String>} & {AR.perfect(String, sd, K2) == True{} : Bool})>>

def wl_2(+lkT: AR.Tree<U32>, +kl: List<&2, String>, +sd: Nat, +x: Nat, +r: List<&2, Nat>, +acc: List<&2, String>, +KT: AR.Tree<String>, +K2: AR.Tree<String>, +es: {LR.wk_step($WKa) == LR.WK{AR.thaw(String, K2), $TL, Con{$SKx, acc}, $W0x} : LR.Walk}, wo: WOK(lkT, kl, sd, r, Con{$SKx, acc}, $W0x, K2)) -> WOK(lkT, kl, sd, Con{x, r}, acc, ST.lnk(x), KT):
  match wo:
    case Tuple{+K3, Tuple{+a3, Tuple{+e3, Tuple{+hs3, pk3}}}}:
      +e = Equal.trans(LR.Walk, LR.wk_loop(SC.length(Nat, r), LR.wk_step($WKa)), LR.wk_loop(SC.length(Nat, r), LR.WK{AR.thaw(String, K2), $TL, Con{$SKx, acc}, $W0x}), LR.WK{AR.thaw(String, K3), $TL, racc($LLw, kl, r, Con{$SKx, acc}), a3}, Equal.cong(LR.Walk, LR.Walk, w => LR.wk_loop(SC.length(Nat, r), w), LR.wk_step($WKa), LR.WK{AR.thaw(String, K2), $TL, Con{$SKx, acc}, $W0x}, es), e3)
      (K3, (a3, (e, (hs3, pk3))))

%def WREC @+K2: AR.Tree<String> -> @+hs2: {AR.slots(String, K2) == kl : List<&2, String>} -> @+pk2: {AR.perfect(String, sd, K2) == True{} : Bool} -> WOK(lkT, kl, sd, r, Con{$SKx, acc}, $W0x, K2)

def wl_1(+lkT: AR.Tree<U32>, +kl: List<&2, String>, +sd: Nat, +x: Nat, +r: List<&2, Nat>, +acc: List<&2, String>, +KT: AR.Tree<String>, st: WSt(lkT, kl, sd, x, acc, KT), rec: $WREC) -> WOK(lkT, kl, sd, Con{x, r}, acc, ST.lnk(x), KT):
  match st:
    case Tuple{+K2, Tuple{+es, Tuple{+hs2, pk2}}}:
      wl_2(lkT, kl, sd, x, r, acc, KT, K2, es, rec(K2, hs2, pk2))

# THEOREM: the walk from the first slot of back, for its length, prepends the
# keys of back one by one and keeps ks
def walk($WP, +fr: Nat, +hfr: {Nat.is_le(fr, SC.pow2(sd)) == True{} : Bool}, +back: List<&2, Nat>, +acc: List<&2, String>, +at: U32, $KTP, +hr: {rok($LLw, back, fr) == True{} : Bool}, +hat: {ST.fst_or(back, at) == at : U32}) -> WOK(lkT, kl, sd, back, acc, at, KT):
  match back:
    case Nil{}:
      (KT, (at, ({==}, (hsl, pk))))
    case Con{+x, +r}:
      +hx = L.and_left(Nat.is_lt(x, fr), Bool.and(U32.is_eq($W0x, ST.fst_or(r, 0)), rok($LLw, r, fr)), hr)
      +hre = L.and_right(Nat.is_lt(x, fr), Bool.and(U32.is_eq($W0x, ST.fst_or(r, 0)), rok($LLw, r, fr)), hr)
      +hp = L.and_left(U32.is_eq($W0x, ST.fst_or(r, 0)), rok($LLw, r, fr), hre)
      +hr2 = L.and_right(U32.is_eq($W0x, ST.fst_or(r, 0)), rok($LLw, r, fr), hre)
      +hs0 = N.lt_le_trans(x, fr, SC.pow2(sd), hx, hfr)
      ok = wl_1(lkT, kl, sd, x, r, acc, KT, wstep($WPA, x, acc, KT, hsl, pk, hs0), K2 => hs2 => pk2 => walk($WPA, fr, hfr, r, Con{$SKx, acc}, $W0x, K2, hs2, pk2, hr2, fo_of(r, $W0x, hp)))
      L.subst(U32, z => WOK(lkT, kl, sd, Con{x, r}, acc, z, KT), ST.lnk(x), at, hat, ok)
