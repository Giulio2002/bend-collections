# add, a new key: the slot, from the free list's head or the next fresh one.

%include read.src

%def KW K.kword(key)
%def KS PA.stored(key)
%def FE U32.from_nat(e)
%def T2(l) AR.upd(U32, 1n+k, AR.upd(U32, 1n+k, tabT, UD.v(U32.shl($FE)), $KW), UD.v(U32.inc(U32.shl($FE))), l)
%def EN SP.LE{key, v, t, W.U64{lo, hi}}
%def SPEC SP.L{cap, $M3, $W4, SP.snoc(~V, $ES, $EN), SP.c_ins($CTR)}
%def E LR.E{v, t, lo, hi}
%def M0 TB.nth0($ML, 0n)
%def M1 TB.nth0($ML, 1n)
%def BASE $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +key: String, +hno: {B.all_lt(B.PNo{$BS, key}, $NN) == True{} : Bool}, +e: Nat, +he: {Nat.is_lt(e, $NN) == True{} : Bool}, +hz: {B.at($BS, e) == B.BE{} : B.Bk}, +hp: {B.occpath($BS, $NN, $HOME, M.dist($NN, $HOME, e)) == True{} : Bool}, +hroom: {Nat.is_le(Nat.double(1n+UD.v(n)), $NN) == True{} : Bool}, +v: V, +t: U32, +lo: U32, +hi: U32
%def BASA $SHA, hg, one, h1, key, hno, e, he, hz, hp, hroom, v, t, lo, hi
%def SHN ST.LS{cap, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, sl, Nil{}}
%def SHC ST.LS{cap, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, sl, Con{s0, tl}}
%def SHFn +cap: U32, +n: U32, +head: U32, +tail: U32, +free: U32, +mT: AR.Tree<U32>, +k: Nat, +sd: Nat, +tabT: AR.Tree<U32>, +ksT: AR.Tree<String>, +eT: AR.Tree<Maybe<&2, V>>, +lkT: AR.Tree<U32>, +sl: List<&2, Nat>
%def SHAn cap, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, sl
%def GN(c) ST.g_$c(~V, cap, n, head, tail, free, TB.nth0($ML, 0n), TB.nth0($ML, 1n), TB.nth0($ML, 2n), TB.nth0($ML, 6n), TB.nth0($ML, 7n), AR.perfect(U32, 5n, mT), k, sd, tabT, $KL, AR.perfect(String, sd, ksT), eT, lkT, sl, Nil{}, hg)
%def GC(c) ST.g_$c(~V, cap, n, head, tail, free, TB.nth0($ML, 0n), TB.nth0($ML, 1n), TB.nth0($ML, 2n), TB.nth0($ML, 6n), TB.nth0($ML, 7n), AR.perfect(U32, 5n, mT), k, sd, tabT, $KL, AR.perfect(String, sd, ksT), eT, lkT, sl, Con{s0, tl}, hg)
%def BASEn $SHFn, +hg: {ST.good(~V, $SHN) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +key: String, +hno: {B.all_lt(B.PNo{$BS, key}, $NN) == True{} : Bool}, +e: Nat, +he: {Nat.is_lt(e, $NN) == True{} : Bool}, +hz: {B.at($BS, e) == B.BE{} : B.Bk}, +hp: {B.occpath($BS, $NN, $HOME, M.dist($NN, $HOME, e)) == True{} : Bool}, +hroom: {Nat.is_le(Nat.double(1n+UD.v(n)), $NN) == True{} : Bool}, +v: V, +t: U32, +lo: U32, +hi: U32
%def BASnA $SHAn, hg, one, h1, key, hno, e, he, hz, hp, hroom, v, t, lo, hi
%def BASEc $SHFn, +s0: Nat, +tl: List<&2, Nat>, +hg: {ST.good(~V, $SHC) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +key: String, +hno: {B.all_lt(B.PNo{$BS, key}, $NN) == True{} : Bool}, +e: Nat, +he: {Nat.is_lt(e, $NN) == True{} : Bool}, +hz: {B.at($BS, e) == B.BE{} : B.Bk}, +hp: {B.occpath($BS, $NN, $HOME, M.dist($NN, $HOME, e)) == True{} : Bool}, +hroom: {Nat.is_le(Nat.double(1n+UD.v(n)), $NN) == True{} : Bool}, +v: V, +t: U32, +lo: U32, +hi: U32
%def BAScA $SHAn, s0, tl, hg, one, h1, key, hno, e, he, hz, hp, hroom, v, t, lo, hi

# ---- lists ----

def nm_lt(~V: Data, +xs: List<&2, Nat>, +fr: Nat, +el: List<&2, Maybe<&2, V>>, +h: {ST.slok(~V, xs, fr, el) == True{} : Bool}) -> {HT.memn(fr, xs) == False{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      +hx = L.and_left(Nat.is_lt(x, fr), ST.live(~V, el, x), L.and_left(Bool.and(Nat.is_lt(x, fr), ST.live(~V, el, x)), ST.slok(~V, t, fr, el), h))
      +ne = N.is_eq_lt(x, fr, hx)
      +ih = nm_lt(~V, t, fr, el, L.and_right(Bool.and(Nat.is_lt(x, fr), ST.live(~V, el, x)), ST.slok(~V, t, fr, el), h))
      L.subst(Bool, z => {Bool.or(z, HT.memn(fr, t)) == False{} : Bool}, False{}, Nat.is_eq(x, fr), Equal.sym(Bool, Nat.is_eq(x, fr), False{}, ne), L.subst(Bool, z => {Bool.or(False{}, z) == False{} : Bool}, False{}, HT.memn(fr, t), Equal.sym(Bool, HT.memn(fr, t), False{}, ih), {==}))

def nv_c(~V: Data, +el: List<&2, Maybe<&2, V>>, +x: Nat, +y: Nat, +hx: {ST.live(~V, el, x) == True{} : Bool}, +hy: {ST.live(~V, el, y) == False{} : Bool}, +c: Bool, +hc: {Nat.is_eq(x, y) == c : Bool}) -> {c == False{} : Bool}:
  match c:
    case True{}:
      +exy = N.eq_from_is_eq(x, y, hc)
      Empty.absurd({True{} == False{} : Bool}, L.true_false(Equal.trans(Bool, True{}, ST.live(~V, el, y), False{}, L.subst(Nat, z => {True{} == ST.live(~V, el, z) : Bool}, x, y, exy, Equal.sym(Bool, ST.live(~V, el, x), True{}, hx)), hy)))
    case False{}:
      {==}

# a vacant slot is off the list of live slots
def nm_vac(~V: Data, +xs: List<&2, Nat>, +fr: Nat, +el: List<&2, Maybe<&2, V>>, +h: {ST.slok(~V, xs, fr, el) == True{} : Bool}, +y: Nat, +hy: {ST.live(~V, el, y) == False{} : Bool}) -> {HT.memn(y, xs) == False{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      +hx = L.and_right(Nat.is_lt(x, fr), ST.live(~V, el, x), L.and_left(Bool.and(Nat.is_lt(x, fr), ST.live(~V, el, x)), ST.slok(~V, t, fr, el), h))
      +ne = nv_c(~V, el, x, y, hx, hy, Nat.is_eq(x, y), {==})
      +ih = nm_vac(~V, t, fr, el, L.and_right(Bool.and(Nat.is_lt(x, fr), ST.live(~V, el, x)), ST.slok(~V, t, fr, el), h), y, hy)
      L.subst(Bool, z => {Bool.or(z, HT.memn(y, t)) == False{} : Bool}, False{}, Nat.is_eq(x, y), Equal.sym(Bool, Nat.is_eq(x, y), False{}, ne), L.subst(Bool, z => {Bool.or(False{}, z) == False{} : Bool}, False{}, HT.memn(y, t), Equal.sym(Bool, HT.memn(y, t), False{}, ih), {==}))

# ---- the next fresh slot, when the arena has room ----

%def MF AR.upd(U32, 5n, mT, 0n, U32.inc($M0))
%def FRM(r, b) LR.fresh_room(&2, V, cap, n, head, tail, free2, r, AR.thaw(U32, $T2(H.link($M0))), AR.thaw(String, ksT), AR.thaw(Maybe<&2, V>, eT), AR.thaw(U32, lkT), $KS, $KW, $E, $M0, $M1, b)
%def PSF LR.put_slot(&2, V, cap, n, head, tail, free2, AR.thaw(U32, $MF), AR.thaw(U32, $T2(H.link($M0))), AR.thaw(String, ksT), AR.thaw(Maybe<&2, V>, eT), AR.thaw(U32, lkT), $M0, $KS, $KW, $E)

def ipf_n(~V: Data, $BASEn, +free2: U32, +hf2: {U32.is_eq(free2, 0) == True{} : Bool}, +hr: {U32.is_lt($M0, $M1) == True{} : Bool}) -> BS.CountOK(~V, $SPEC, $FRM(AR.thaw(U32, mT), True{})):
  +hsd = RD.f_hsd(~V, $SHAn, Nil{}, hg)
  +hsd1 = UL.sd1(sd, hsd)
  +pm = $GN(cpm)
  +ehs = N.eq_from_is_eq(UD.v($M1), SC.pow2(sd), $GN(csize))
  +hs0 = L.subst(Nat, z => {Nat.is_lt($FR, z) == True{} : Bool}, UD.v($M1), SC.pow2(sd), ehs, Equal.trans(Bool, Nat.is_lt($FR, UD.v($M1)), U32.is_lt($M0, $M1), True{}, Equal.sym(Bool, U32.is_lt($M0, $M1), Nat.is_lt($FR, UD.v($M1)), U.is_lt_nat($M0, $M1)), hr))
  +hsn = nm_lt(~V, sl, $FR, $EL, $GN(csl))
  +ei = CY.inc_val(one, h1, $M0, IU.bound32(one, h1, $FR, sd, hsd1, hs0))
  +eln = N.eq_from_is_eq(Nat.add(SC.length(Nat, sl), 0n), $FR, $GN(cfcnt))
  +ecnt = Equal.trans(Nat, Nat.add(SC.length(Nat, SC.append(Nat, sl, Con{$FR, Nil{}})), 0n), SC.length(Nat, SC.append(Nat, sl, Con{$FR, Nil{}})), UD.v(U32.inc($M0)), N.add_zero(SC.length(Nat, SC.append(Nat, sl, Con{$FR, Nil{}}))), Equal.trans(Nat, SC.length(Nat, SC.append(Nat, sl, Con{$FR, Nil{}})), 1n+SC.length(Nat, sl), UD.v(U32.inc($M0)), I1.len_snoc(sl, $FR), Equal.trans(Nat, 1n+SC.length(Nat, sl), 1n+$FR, UD.v(U32.inc($M0)), Equal.cong(Nat, Nat, z => 1n+z, SC.length(Nat, sl), $FR, Equal.trans(Nat, SC.length(Nat, sl), Nat.add(SC.length(Nat, sl), 0n), $FR, Equal.sym(Nat, Nat.add(SC.length(Nat, sl), 0n), SC.length(Nat, sl), N.add_zero(SC.length(Nat, sl))), eln)), Equal.sym(Nat, UD.v(U32.inc($M0)), 1n+$FR, ei))))
  +hsfr = L.subst(Nat, z => {Nat.is_lt($FR, z) == True{} : Bool}, 1n+$FR, UD.v(U32.inc($M0)), Equal.sym(Nat, UD.v(U32.inc($M0)), 1n+$FR, ei), N.lt_succ($FR))
  +hfr2 = L.subst(Nat, z => {Nat.is_le(z, SC.pow2(sd)) == True{} : Bool}, 1n+$FR, UD.v(U32.inc($M0)), Equal.sym(Nat, UD.v(U32.inc($M0)), 1n+$FR, ei), N.lt_succ_le_succ($FR, SC.pow2(sd), hs0))
  ok = IC.ins_core(~V, $SHAn, Nil{}, hg, one, h1, key, hno, e, he, hz, hp, hroom, $FR, $M0, {==}, hs0, hsn, Nil{}, free2, U32.inc($M0), hf2, {==}, {==}, {==}, IS.eq_is_eq(Nat.add(SC.length(Nat, SC.append(Nat, sl, Con{$FR, Nil{}})), 0n), UD.v(U32.inc($M0)), ecnt), {==}, hsfr, N.lt_le($FR, UD.v(U32.inc($M0)), hsfr), hfr2, $MF, MT.uset_p(5n, mT, pm, 0n, U32.inc($M0)), MT.uset_s(5n, mT, pm, 0n, {==}, U32.inc($M0)), v, t, lo, hi)
  +ea = MT.uset_a(5n, {==}, mT, pm, 0, {==}, U32.inc($M0))
  L.subst(Array<U32>, z => BS.CountOK(~V, $SPEC, LR.put_slot(&2, V, cap, n, head, tail, free2, z, AR.thaw(U32, $T2(H.link($M0))), AR.thaw(String, ksT), AR.thaw(Maybe<&2, V>, eT), AR.thaw(U32, lkT), $M0, $KS, $KW, $E)), AR.thaw(U32, $MF), Array.set(U32, AR.thaw(U32, mT), 0, U32.inc($M0)), Equal.sym(Array<U32>, Array.set(U32, AR.thaw(U32, mT), 0, U32.inc($M0)), AR.thaw(U32, $MF), ea), ok)

# THEOREM (add, a fresh slot with room)
def ip_fresh(~V: Data, $BASE, +free2: U32, +hf2: {U32.is_eq(free2, 0) == True{} : Bool}, +hfz: {U32.is_eq(free, 0) == True{} : Bool}, +hr: {U32.is_lt($M0, $M1) == True{} : Bool}) -> BS.CountOK(~V, $SPEC, $FRM(AR.thaw(U32, mT), True{})):
  match fl:
    case Nil{}:
      ipf_n(~V, $BASnA, free2, hf2, hr)
    case Con{+s0, +tl}:
      +hsd = RD.f_hsd(~V, $SHAn, Con{s0, tl}, hg)
      +hf0 = L.and_left(Bool.and(Nat.is_lt(s0, $FR), Bool.not(ST.live(~V, $EL, s0))), ST.flok(~V, tl, $FR, $EL), $GC(cfl))
      +hs0 = N.lt_le_trans(s0, $FR, SC.pow2(sd), L.and_left(Nat.is_lt(s0, $FR), Bool.not(ST.live(~V, $EL, s0)), hf0), $GC(cfresh))
      +ef = A.eq_of(free, ST.lnk(s0), $GC(cfree))
      +hz0 = L.subst(U32, z => {U32.is_eq(z, 0) == True{} : Bool}, free, ST.lnk(s0), ef, hfz)
      Empty.absurd(BS.CountOK(~V, $SPEC, $FRM(AR.thaw(U32, mT), True{})), L.false_true(Equal.trans(Bool, False{}, U32.is_eq(ST.lnk(s0), 0), True{}, Equal.sym(Bool, U32.is_eq(ST.lnk(s0), 0), False{}, UL.lnk_nz(one, h1, s0, sd, hsd, hs0)), hz0)))

# ---- the free list's head ----

%def SUF H.slot(free)
%def LW1 ST.lw($LLo, s0, 1n)
%def FNX(r) LR.free_next(&2, V, cap, n, head, tail, $SUF, AR.thaw(U32, mT), AR.thaw(U32, $T2(H.link($SUF))), AR.thaw(String, ksT), AR.thaw(Maybe<&2, V>, eT), $KS, $KW, $E, r)
%def FLC Con{s0, tl}

def ipl_c(~V: Data, $BASEc) -> BS.CountOK(~V, $SPEC, $FNX(Array.get(U32, AR.thaw(U32, lkT), LR.nidx($SUF)))):
  +hsd = RD.f_hsd(~V, $SHAn, $FLC, hg)
  +hf0 = L.and_left(Bool.and(Nat.is_lt(s0, $FR), Bool.not(ST.live(~V, $EL, s0))), ST.flok(~V, tl, $FR, $EL), $GC(cfl))
  +hsfr = L.and_left(Nat.is_lt(s0, $FR), Bool.not(ST.live(~V, $EL, s0)), hf0)
  +hvac = LS.not_t_f(ST.live(~V, $EL, s0), L.and_right(Nat.is_lt(s0, $FR), Bool.not(ST.live(~V, $EL, s0)), hf0))
  +hs0 = N.lt_le_trans(s0, $FR, SC.pow2(sd), hsfr, $GC(cfresh))
  +ef = A.eq_of(free, ST.lnk(s0), $GC(cfree))
  +hsv = Equal.trans(Nat, UD.v($SUF), UD.v(H.slot(ST.lnk(s0))), s0, Equal.cong(U32, Nat, z => UD.v(H.slot(z)), free, ST.lnk(s0), ef), UL.ix_o(one, h1, s0, sd, hsd, hs0))
  +hsn = nm_vac(~V, sl, $FR, $EL, $GC(csl), s0, hvac)
  +hfll0 = $GC(cfll)
  +hfree = L.and_left(U32.is_eq($LW1, ST.fst_or(tl, 0)), ST.fll($LLo, tl), hfll0)
  +hfll = L.and_right(U32.is_eq($LW1, ST.fst_or(tl, 0)), ST.fll($LLo, tl), hfll0)
  +hfl = L.and_right(Bool.and(Nat.is_lt(s0, $FR), Bool.not(ST.live(~V, $EL, s0))), ST.flok(~V, tl, $FR, $EL), $GC(cfl))
  +hnd0 = $GC(cfnd)
  +hsfl = LS.not_t_f(HT.memn(s0, tl), L.and_left(Bool.not(HT.memn(s0, tl)), ST.nodupn(tl), hnd0))
  +hfnd = L.and_right(Bool.not(HT.memn(s0, tl)), ST.nodupn(tl), hnd0)
  +ecf = N.eq_from_is_eq(Nat.add(SC.length(Nat, sl), 1n+SC.length(Nat, tl)), $FR, $GC(cfcnt))
  +ecnt = Equal.trans(Nat, Nat.add(SC.length(Nat, SC.append(Nat, sl, Con{s0, Nil{}})), SC.length(Nat, tl)), Nat.add(1n+SC.length(Nat, sl), SC.length(Nat, tl)), $FR, Equal.cong(Nat, Nat, z => Nat.add(z, SC.length(Nat, tl)), SC.length(Nat, SC.append(Nat, sl, Con{s0, Nil{}})), 1n+SC.length(Nat, sl), I1.len_snoc(sl, s0)), Equal.trans(Nat, 1n+Nat.add(SC.length(Nat, sl), SC.length(Nat, tl)), Nat.add(SC.length(Nat, sl), 1n+SC.length(Nat, tl)), $FR, Equal.sym(Nat, Nat.add(SC.length(Nat, sl), 1n+SC.length(Nat, tl)), 1n+Nat.add(SC.length(Nat, sl), SC.length(Nat, tl)), N.add_succ(SC.length(Nat, sl), SC.length(Nat, tl))), ecf))
  ok = IC.ins_core(~V, $SHAn, $FLC, hg, one, h1, key, hno, e, he, hz, hp, hroom, s0, $SUF, hsv, hs0, hsn, tl, $LW1, $M0, hfree, hfll, hfl, hfnd, IS.eq_is_eq(Nat.add(SC.length(Nat, SC.append(Nat, sl, Con{s0, Nil{}})), SC.length(Nat, tl)), $FR, ecnt), hsfl, hsfr, N.le_refl($FR), $GC(cfresh), mT, $GC(cpm), Equal.sym(List<&2, U32>, SC.update(U32, $ML, 0n, $M0), $ML, BU.upd_id($ML, 0n)), v, t, lo, hi)
  +hsu = L.subst(Nat, z => {Nat.is_lt(z, SC.pow2(sd)) == True{} : Bool}, s0, UD.v($SUF), Equal.sym(Nat, UD.v($SUF), s0, hsv), hs0)
  +i1 = Equal.trans(Nat, UD.v(LR.nidx($SUF)), ST.off(UD.v($SUF), 1n), ST.off(s0, 1n), ID.w1(one, h1, $SUF, sd, UL.sd3(sd, hsd), hsu), Equal.cong(Nat, Nat, z => ST.off(z, 1n), UD.v($SUF), s0, hsv))
  +er = GO.rd(one, h1, lkT, sd, hsd, $GC(cpl), LR.nidx($SUF), s0, 1n, {==}, hs0, i1)
  L.subst(Array<U32> & U32, z => BS.CountOK(~V, $SPEC, $FNX(z)), (AR.thaw(U32, lkT), $LW1), Array.get(U32, AR.thaw(U32, lkT), LR.nidx($SUF)), Equal.sym(Array<U32> & U32, Array.get(U32, AR.thaw(U32, lkT), LR.nidx($SUF)), (AR.thaw(U32, lkT), $LW1), er), ok)

# THEOREM (add, the free list's head)
def ip_free(~V: Data, $BASE, +hfz: {U32.is_eq(free, 0) == False{} : Bool}) -> BS.CountOK(~V, $SPEC, $FNX(Array.get(U32, AR.thaw(U32, lkT), LR.nidx($SUF)))):
  match fl:
    case Nil{}:
      Empty.absurd(BS.CountOK(~V, $SPEC, $FNX(Array.get(U32, AR.thaw(U32, lkT), LR.nidx($SUF)))), L.true_false(Equal.trans(Bool, True{}, U32.is_eq(free, 0), False{}, Equal.sym(Bool, U32.is_eq(free, 0), True{}, $GN(cfree)), hfz)))
    case Con{+s0, +tl}:
      ipl_c(~V, $SHAn, s0, tl, hg, one, h1, key, hno, e, he, hz, hp, hroom, v, t, lo, hi)
