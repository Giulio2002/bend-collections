      (t3, (tr, (ef, (hp3, (hs, (TR.lo_cat(tr3, tr0, hl3, {==}), (hin, hg)))))))

%def G(t, l) LR.F{cap, n, LR.pick(U32.is_eq(t, 0), l, head), l, free, $AR4, LR.set_if(Array.set(U32, Array.set(U32, AR.thaw(U32, lkT), LR.pidx(su), t), LR.nidx(su), 0), LR.nidx(H.slot(t)), l, U32.is_eq(t, 0))}

# a slot's U32 is the U32 of its number
def lnk_su(+su: U32, +s: Nat, +sd: Nat, +hsd: {Nat.is_lt(3n+sd, 32n) == True{} : Bool}, +hsv: {UD.v(su) == s : Nat}, +hs0: {Nat.is_lt(s, SC.pow2(sd)) == True{} : Bool}) -> {H.link(su) == ST.lnk(s) : U32}:
  +hk = N.lt_le(sd, 32n, N.lt_trans(sd, 1n+sd, 32n, N.lt_succ(sd), UL.sd1(sd, hsd)))
  +hsu = L.subst(Nat, z => {Nat.is_lt(z, SC.pow2(sd)) == True{} : Bool}, s, UD.v(su), Equal.sym(Nat, UD.v(su), s, hsv), hs0)
  +e = Equal.trans(U32, su, U32.from_nat(UD.v(su)), U32.from_nat(s), Equal.sym(U32, U32.from_nat(UD.v(su)), su, PI.from_v(su, sd, hk, hsu)), Equal.cong(Nat, U32, z => U32.from_nat(z), UD.v(su), s, hsv))
  Equal.cong(U32, U32, z => H.link(z), su, U32.from_nat(s), e)

# THEOREM (link_tail): a slot s off the recency list sl becomes its newest:
# the list sl ++ [s] is linked, with its head and tail.
def link_tail_ok(~V: Data, $UP, $TP, +fr: Nat, +el: List<&2, Maybe<&2, V>>, +hfr: {Nat.is_le(fr, SC.pow2(sd)) == True{} : Bool}, +head: U32, +tail: U32, +su: U32, +s: Nat, +sl: List<&2, Nat>, +hsv: {UD.v(su) == s : Nat}, +hs0: {Nat.is_lt(s, SC.pow2(sd)) == True{} : Bool}, +hsn: {HT.memn(s, sl) == False{} : Bool}, +hseg: {ST.seg($LLS, sl, 0, 0) == True{} : Bool}, +hnd: {ST.nodupn(sl) == True{} : Bool}, +hb: {ST.sall(~V, ST.PLive{fr, el}, sl) == True{} : Bool}, +hh: {U32.is_eq(head, ST.fst_or(sl, 0)) == True{} : Bool}, +ht: {U32.is_eq(tail, $TT) == True{} : Bool}) -> LtOK(~V, $TPA, lkT, sd, sl, s, LR.link_tail(&2, V, LR.F{cap, n, head, tail, free, $AR4, AR.thaw(U32, lkT)}, su)):
  +hsu = L.subst(Nat, z => {Nat.is_lt(z, SC.pow2(sd)) == True{} : Bool}, s, UD.v(su), Equal.sym(Nat, UD.v(su), s, hsv), hs0)
  +iP = Equal.trans(Nat, UD.v(LR.pidx(su)), ST.off(UD.v(su), 0n), ST.off(s, 0n), ID.w0(one, h1, su, sd, UL.sd3(sd, hsd), hsu), Equal.cong(Nat, Nat, z => ST.off(z, 0n), UD.v(su), s, hsv))
  +iN = Equal.trans(Nat, UD.v(LR.nidx(su)), ST.off(UD.v(su), 1n), ST.off(s, 1n), ID.w1(one, h1, su, sd, UL.sd3(sd, hsd), hsu), Equal.cong(Nat, Nat, z => ST.off(z, 1n), UD.v(su), s, hsv))
  +eL = lnk_su(su, s, sd, hsd, hsv, hs0)
  +etl = A.eq_of(tail, $TT, ht)
  +p1 = MT.uset_p(3n+sd, lkT, hpl, UD.v(LR.pidx(su)), $TT)
  +p2 = MT.uset_p(3n+sd, $T1, p1, UD.v(LR.nidx(su)), 0)
  +a1 = UL.wr($UA, LR.pidx(su), s, 0n, {==}, hs0, iP, $TT)
  +a2 = UL.wr(one, h1, $T1, sd, hsd, p1, LR.nidx(su), s, 1n, {==}, hs0, iN, 0)
  +ea = Equal.trans(Array<U32>, Array.set(U32, Array.set(U32, AR.thaw(U32, lkT), LR.pidx(su), $TT), LR.nidx(su), 0), Array.set(U32, AR.thaw(U32, $T1), LR.nidx(su), 0), AR.thaw(U32, $T2), Equal.cong(Array<U32>, Array<U32>, z => Array.set(U32, z, LR.nidx(su), 0), Array.set(U32, AR.thaw(U32, lkT), LR.pidx(su), $TT), AR.thaw(U32, $T1), a1), a2)
  +s1 = UL.wr_s(lkT, sd, hpl, LR.pidx(su), s, 0n, {==}, hs0, iP, $TT)
  +s2 = UL.wr_s($T1, sd, p1, LR.nidx(su), s, 1n, {==}, hs0, iN, 0)
  +hs2 = Equal.trans(List<&2, U32>, AR.slots(U32, $T2), SC.update(U32, AR.slots(U32, $T1), ST.off(s, 1n), 0), SC.update(U32, SC.update(U32, $LLS, ST.off(s, 0n), $TT), ST.off(s, 1n), 0), s2, Equal.cong(List<&2, U32>, List<&2, U32>, z => SC.update(U32, z, ST.off(s, 1n), 0), AR.slots(U32, $T1), SC.update(U32, $LLS, ST.off(s, 0n), $TT), s1))
  +g1 = Equal.trans(Bool, ST.seg(SC.update(U32, SC.update(U32, $LLS, ST.off(s, 0n), $TT), ST.off(s, 1n), 0), sl, 0, 0), ST.seg(SC.update(U32, $LLS, ST.off(s, 0n), $TT), sl, 0, 0), ST.seg($LLS, sl, 0, 0), DL.seg_fs(SC.update(U32, $LLS, ST.off(s, 0n), $TT), s, 1n, 0, {==}, sl, 0, 0, hsn), DL.seg_fs($LLS, s, 0n, $TT, {==}, sl, 0, 0, hsn))
  +hg2 = L.subst(List<&2, U32>, z => {ST.seg(z, sl, 0, 0) == True{} : Bool}, SC.update(U32, SC.update(U32, $LLS, ST.off(s, 0n), $TT), ST.off(s, 1n), 0), AR.slots(U32, $T2), Equal.sym(List<&2, U32>, AR.slots(U32, $T2), SC.update(U32, SC.update(U32, $LLS, ST.off(s, 0n), $TT), ST.off(s, 1n), 0), hs2), Equal.trans(Bool, ST.seg(SC.update(U32, SC.update(U32, $LLS, ST.off(s, 0n), $TT), ST.off(s, 1n), 0), sl, 0, 0), ST.seg($LLS, sl, 0, 0), True{}, g1, hseg))
  ok = lt_fin(~V, $UA, $TPA, fr, el, hfr, head, su, s, sl, hsv, hs0, hsn, hnd, hb, hh, p2, hs2, hg2, UL.ul_p(~V, one, h1, $T2, sd, hsd, p2, fr, el, hfr, ST.lnk(s), 0, sl, hg2, hnd, hb))
  +E1 = Equal.cong(U32, LR.LRU<&2, V>, z => $G(z, H.link(su)), tail, $TT, etl)
  +E2 = Equal.cong(U32, LR.LRU<&2, V>, z => $G($TT, z), H.link(su), ST.lnk(s), eL)
  +E3 = Equal.cong(Array<U32>, LR.LRU<&2, V>, z => $LT(head, $TT, z), Array.set(U32, Array.set(U32, AR.thaw(U32, lkT), LR.pidx(su), $TT), LR.nidx(su), 0), AR.thaw(U32, $T2), ea)
  +E = Equal.trans(LR.LRU<&2, V>, $G(tail, H.link(su)), $G($TT, H.link(su)), $LT(head, $TT, AR.thaw(U32, $T2)), E1, Equal.trans(LR.LRU<&2, V>, $G($TT, H.link(su)), $G($TT, ST.lnk(s)), $LT(head, $TT, AR.thaw(U32, $T2)), E2, E3))
  L.subst(LR.LRU<&2, V>, r => LtOK(~V, $TPA, lkT, sd, sl, s, r), $LT(head, $TT, AR.thaw(U32, $T2)), $G(tail, H.link(su)), Equal.sym(LR.LRU<&2, V>, $G(tail, H.link(su)), $LT(head, $TT, AR.thaw(U32, $T2)), E), ok)
