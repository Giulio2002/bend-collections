  match st:
    case Tuple{+t3, Tuple{+tr3, Tuple{+ea3, Tuple{+hp3, Tuple{+hs3, Tuple{+hl3, Tuple{+hi3, hg3}}}}}}}:
      +tr0 = {TR.TW{s, 1n, 0, TR.TW{s, 0n, $TT, TR.TNil{}}} : TR.Tr}
