# link_tail: attaching a slot as the newest.

%def LLS AR.slots(U32, lkT)
%def UP +one: Nat, +h1: {one == 1n : Nat}, +lkT: AR.Tree<U32>, +sd: Nat, +hsd: {Nat.is_lt(3n+sd, 32n) == True{} : Bool}, +hpl: {AR.perfect(U32, 3n+sd, lkT) == True{} : Bool}
%def UA one, h1, lkT, sd, hsd, hpl
%def APN(a, b) SC.append(Nat, a, b)
%def AR4 AR.thaw(U32, mT), AR.thaw(U32, tabT), AR.thaw(String, ksT), AR.thaw(Maybe<&2, V>, eT)
%def TP +cap: U32, +n: U32, +free: U32, +mT: AR.Tree<U32>, +tabT: AR.Tree<U32>, +ksT: AR.Tree<String>, +eT: AR.Tree<Maybe<&2, V>>
%def TPA cap, n, free, mT, tabT, ksT, eT
%def S1 $APN(sl, Con{s, Nil{}})
%def TT ST.last_or(sl, 0)

def LtOK(~V: Data, $TP, +lkT: AR.Tree<U32>, +sd: Nat, +sl: List<&2, Nat>, +s: Nat, r: LR.LRU<&2, V>) -> Type:
  Sigma<&1, &1, AR.Tree<U32>, t3 => Sigma<&1, &1, TR.Tr, tr => {r == LR.F{cap, n, ST.fst_or($S1, 0), ST.lnk(s), free, $AR4, AR.thaw(U32, t3)} : LR.LRU<&2, V>} & ({AR.perfect(U32, 3n+sd, t3) == True{} : Bool} & ({AR.slots(U32, t3) == TR.app($LLS, tr) : List<&2, U32>} & ({TR.trlo(tr) == True{} : Bool} & ({TR.trin(tr, $S1) == True{} : Bool} & {ST.seg(AR.slots(U32, t3), $S1, 0, 0) == True{} : Bool}))))>>

# the written slots are all in xs, s is not: s is not written
def tr_single(+tr: TR.Tr, +xs: List<&2, Nat>, +s: Nat, +hin: {TR.trin(tr, xs) == True{} : Bool}, +hs: {HT.memn(s, xs) == False{} : Bool}) -> {TR.trout(tr, Con{s, Nil{}}) == True{} : Bool}:
  match tr:
    case TR.TNil{}:
      {==}
    case TR.TW{+y, +o, +v, +t}:
      +hy = L.and_left(HT.memn(y, xs), TR.trin(t, xs), hin)
      +ne = DL.ne_mem(s, y, xs, DL.not_f(HT.memn(s, xs), hs), hy)
      +e = L.subst(Bool, z => {Bool.or(z, False{}) == False{} : Bool}, False{}, Nat.is_eq(s, y), Equal.sym(Bool, Nat.is_eq(s, y), False{}, DL.ne_sym(y, s, ne)), {==})
      L.and_intro(Bool.not(HT.memn(y, Con{s, Nil{}})), TR.trout(t, Con{s, Nil{}}), DL.not_f(HT.memn(y, Con{s, Nil{}}), e), tr_single(t, xs, s, L.and_right(HT.memn(y, xs), TR.trin(t, xs), hin), hs))

def hd2(~V: Data, +one: Nat, +h1: {one == 1n : Nat}, +sd: Nat, +hsd: {Nat.is_lt(3n+sd, 32n) == True{} : Bool}, +fr: Nat, +el: List<&2, Maybe<&2, V>>, +hfr: {Nat.is_le(fr, SC.pow2(sd)) == True{} : Bool}, +sl: List<&2, Nat>, +s: Nat, +head: U32, +hh: {U32.is_eq(head, ST.fst_or(sl, 0)) == True{} : Bool}, +hb: {ST.sall(~V, ST.PLive{fr, el}, sl) == True{} : Bool}) -> {LR.pick(U32.is_eq($TT, 0), ST.lnk(s), head) == ST.fst_or($S1, 0) : U32}:
  match sl:
    case Nil{}:
      {==}
    case Con{+a0, +a2}:
      +z = DL.lastn(a2, a0)
      +hz = UL.bnd_of(~V, z, Con{a0, a2}, fr, el, sd, hfr, hb, DL.lastn_mem(a2, a0))
      +hc = Equal.trans(Bool, U32.is_eq(ST.last_or(a2, ST.lnk(a0)), 0), U32.is_eq(ST.lnk(z), 0), False{}, Equal.cong(U32, Bool, w => U32.is_eq(w, 0), ST.last_or(a2, ST.lnk(a0)), ST.lnk(z), DL.last_lnk(a2, a0)), UL.lnk_nz(one, h1, z, sd, hsd, hz))
      Equal.trans(U32, LR.pick(U32.is_eq(ST.last_or(a2, ST.lnk(a0)), 0), ST.lnk(s), head), head, ST.lnk(a0), UL.pick_f(U32.is_eq(ST.last_or(a2, ST.lnk(a0)), 0), hc, ST.lnk(s), head), A.eq_of(head, ST.lnk(a0), hh))

%def T1 AR.upd(U32, 3n+sd, lkT, UD.v(LR.pidx(su)), $TT)
%def T2 AR.upd(U32, 3n+sd, $T1, UD.v(LR.nidx(su)), 0)
%def LT(h, t, x) LR.F{cap, n, LR.pick(U32.is_eq(t, 0), ST.lnk(s), h), ST.lnk(s), free, $AR4, LR.set_if(x, LR.nidx(H.slot(t)), ST.lnk(s), U32.is_eq(t, 0))}

