import Base
import ../lib/logic.bend as L
import ../lib/nat.bend as N
import ../lib/u32alg.bend as A
import ../lib/array.bend as AR
import ../spec/common.bend as SC
import ../spec/lru.bend as SP
import ../math/u32div.bend as UD
import ../../src/math/u64.bend as W
import ../../src/containers/hash_table.bend as H
import ../../src/containers/lru.bend as LR
import ../hash_table/state.bend as HT
import ./state.bend as ST
import ./basic.bend as BA
import ./bumpsh.bend as BS
import ./touch.bend as TO
import ./rmat.bend as RM
import ./gone.bend as GO
import ./unlink.bend as UL

import ./read.bend as RD
import ./evict.bend as EV
import ./walk.bend as WL
import ../lib/list.bend as LI
import ../lib/nat_list.bend as NL
import ../lib/links.bend as LK
import ../lib/words32.bend as W32

# keys: the expired oldest prefix removed (each a removal), then the keys
# oldest first.

%include read.src

%def S0L Con{s0, t}
%def SH0 ST.LS{cap, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, $S0L, fl}
%def SHF0 +cap: U32, +n: U32, +head: U32, +tail: U32, +free: U32, +mT: AR.Tree<U32>, +k: Nat, +sd: Nat, +tabT: AR.Tree<U32>, +ksT: AR.Tree<String>, +eT: AR.Tree<Maybe<&2, V>>, +lkT: AR.Tree<U32>, +s0: Nat, +t: List<&2, Nat>, +fl: List<&2, Nat>
%def SHA0 cap, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, $S0L, fl
%def SHA0x cap, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, s0, t, fl
%def GA1 cap, n, head, tail, free, W32.nth0($ML, 0n), W32.nth0($ML, 1n), W32.nth0($ML, 2n), W32.nth0($ML, 6n), W32.nth0($ML, 7n), AR.perfect(U32, 5n, mT), k, sd, tabT, $KL, AR.perfect(String, sd, ksT), eT, lkT, $S0L, fl
%def G1(c) ST.g_$c(~V, $GA1, hg)
%def F1 ST.real(~V, $SH0)
%def SU H.slot(head)
%def ES1 ST.es(~V, $LLo, $KL, $EL, $S0L)
%def EV1 TO.ev(~V, $LLo, $KL, s0, v)
%def GN SP.gone(~V, $EV1, now)
%def L1(x) SP.L{cap, $M3, $W4, x, $CTR}
%def SPR SP.L{cap, $M3, $W4, SP.tail(~V, $ES1), SP.c_rm($CTR)}
%def KX LR.Kx<&2, V>
%def KC(f) LR.kx_go(&2, V, f, now, LR.kx_check(&2, V, $F1, now))
%def KP(f, g) LR.kx_go(&2, V, f, now, LR.kx_pick(&2, V, $F1, g))
%def KREC(p) @sh1: ST.Sh<V> -> @g1: {ST.good(~V, sh1) == True{} : Bool} -> BS.CountOK(~V, SP.expire(~V, p, ST.model(~V, sh1), now), LR.kx_go(&2, V, p, now, LR.kx_check(&2, V, ST.real(~V, sh1), now)))
%def SHFn +cap: U32, +n: U32, +head: U32, +tail: U32, +free: U32, +mT: AR.Tree<U32>, +k: Nat, +sd: Nat, +tabT: AR.Tree<U32>, +ksT: AR.Tree<String>, +eT: AR.Tree<Maybe<&2, V>>, +lkT: AR.Tree<U32>, +fl: List<&2, Nat>
%def SHAn cap, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, fl
%def SHn ST.LS{cap, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, Nil{}, fl}
%def Fn ST.real(~V, $SHn)
%def GAn cap, n, head, tail, free, W32.nth0($ML, 0n), W32.nth0($ML, 1n), W32.nth0($ML, 2n), W32.nth0($ML, 6n), W32.nth0($ML, 7n), AR.perfect(U32, 5n, mT), k, sd, tabT, $KL, AR.perfect(String, sd, ksT), eT, lkT, Nil{}, fl
%def SVT Sigma<&1, &1, V, v => {HT.nthm(~V, el, s) == Some{v} : Maybe<&2, V>}>

# the value of a live slot
def some_v(~V: Data, +el: List<&2, Maybe<&2, V>>, +s: Nat, +m: Maybe<&2, V>, +hmm: {HT.nthm(~V, el, s) == m : Maybe<&2, V>}, +hsm: {HT.some_b(~V, m) == True{} : Bool}) -> $SVT:
  match m:
    case None{}:
      Empty.absurd($SVT, L.false_true(hsm))
    case Some{+v}:
      (v, hmm)

# an empty cache: nothing to expire
def kx_nf(~V: Data, $SHFn, +hg: {ST.good(~V, $SHn) == True{} : Bool}, +now: W.U64, +f: Nat) -> BS.CountOK(~V, SP.expire(~V, f, $L1(Nil{}), now), LR.kx_go(&2, V, f, now, LR.KDone{$Fn})):
  match f:
    case 0n:
      ($SHn, ({==}, ({==}, hg)))
    case 1n+p:
      ($SHn, ({==}, ({==}, hg)))

def kx_nil(~V: Data, $SHFn, +hg: {ST.good(~V, $SHn) == True{} : Bool}, +now: W.U64, +f: Nat) -> BS.CountOK(~V, SP.expire(~V, f, $L1(Nil{}), now), LR.kx_go(&2, V, f, now, LR.kx_check(&2, V, $Fn, now))):
  +hz = ST.g_chead(~V, $GAn, hg)
  L.subst(Bool, z => BS.CountOK(~V, SP.expire(~V, f, $L1(Nil{}), now), LR.kx_go(&2, V, f, now, LR.kx_if(&2, V, $Fn, now, z))), True{}, U32.is_eq(head, 0), Equal.sym(Bool, U32.is_eq(head, 0), True{}, hz), kx_nf(~V, $SHAn, hg, now, f))

# a nonempty cache: the check is whether the oldest entry is gone
def kx_ce(~V: Data, $SHF0, +hg: {ST.good(~V, $SH0) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +now: W.U64, +v: V) -> {LR.kx_check(&2, V, $F1, now) == LR.kx_pick(&2, V, $F1, $GN) : $KX}:
  +hsd = RD.f_hsd(~V, $SHA0, hg)
  +hs0 = RD.f_s0(~V, $SHA0, hg, s0, UL.self_in(s0, t))
  +eh = A.eq_of(head, LK.lnk(s0), $G1(chead))
  +hsv = Equal.trans(Nat, UD.v($SU), UD.v(H.slot(LK.lnk(s0))), s0, Equal.cong(U32, Nat, z => UD.v(H.slot(z)), head, LK.lnk(s0), eh), UL.ix_o(one, h1, s0, sd, hsd, hs0))
  +hz = L.subst(U32, z => {U32.is_eq(z, 0) == False{} : Bool}, LK.lnk(s0), head, Equal.sym(U32, head, LK.lnk(s0), eh), UL.lnk_nz(one, h1, s0, sd, hsd, hs0))
  +e1 = Equal.cong(Bool, $KX, b => LR.kx_if(&2, V, $F1, now, b), U32.is_eq(head, 0), False{}, hz)
  +e2 = Equal.cong(Array<U32> & Bool, $KX, r => LR.kx_g(&2, V, cap, n, head, tail, free, AR.thaw(U32, mT), AR.thaw(U32, tabT), AR.thaw(String, ksT), AR.thaw(Maybe<&2, V>, eT), r), LR.gone(AR.thaw(U32, lkT), $SU, now), (AR.thaw(U32, lkT), $GN), GO.gone_ok(~V, one, h1, lkT, sd, hsd, $G1(cpl), $SU, s0, hsv, hs0, now, ST.skey($LLo, $KL, s0), v))
  Equal.trans($KX, LR.kx_check(&2, V, $F1, now), LR.kx_if(&2, V, $F1, now, False{}), LR.kx_pick(&2, V, $F1, $GN), e1, e2)

def kx_g0(~V: Data, $SHF0, +hg: {ST.good(~V, $SH0) == True{} : Bool}, +now: W.U64, +g: Bool) -> BS.CountOK(~V, $L1($ES1), $KP(0n, g)):
  match g:
    case True{}:
      ($SH0, ({==}, ({==}, hg)))
    case False{}:
      ($SH0, ({==}, ({==}, hg)))

# the oldest entry gone: removed, and the loop goes on
def kx_rm(~V: Data, +now: W.U64, +p: Nat, -r: LR.LRU<&2, V>, +spec: SP.Lru<V>, co: BS.CountOK(~V, spec, r), rec: $KREC(p)) -> BS.CountOK(~V, SP.expire(~V, p, spec, now), LR.kx_go(&2, V, p, now, LR.kx_check(&2, V, r, now))):
  match co:
    case Tuple{+sh1, Tuple{+e1, Tuple{+em1, g1}}}:
      ok = rec(sh1, g1)
      ok2 = L.subst(SP.Lru<V>, z => BS.CountOK(~V, SP.expire(~V, p, z, now), LR.kx_go(&2, V, p, now, LR.kx_check(&2, V, ST.real(~V, sh1), now))), ST.model(~V, sh1), spec, em1, ok)
      L.subst(LR.LRU<&2, V>, z => BS.CountOK(~V, SP.expire(~V, p, spec, now), LR.kx_go(&2, V, p, now, LR.kx_check(&2, V, z, now))), ST.real(~V, sh1), r, Equal.sym(LR.LRU<&2, V>, r, ST.real(~V, sh1), e1), ok2)

def kx_g1(~V: Data, $SHF0, +hg: {ST.good(~V, $SH0) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +now: W.U64, +p: Nat, +g: Bool, rec: $KREC(p)) -> BS.CountOK(~V, Bool.pick(SP.Lru<V>, g, SP.expire(~V, p, $SPR, now), $L1($ES1)), $KP(1n+p, g)):
  match g:
    case True{}:
      kx_rm(~V, now, p, LR.drop_head(&2, V, $F1), $SPR, EV.old_rm(~V, $SHA0x, hg, one, h1), rec)
    case False{}:
      ($SH0, ({==}, ({==}, hg)))

def kx_c0(~V: Data, $SHF0, +hg: {ST.good(~V, $SH0) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +now: W.U64, +v: V) -> BS.CountOK(~V, SP.expire(~V, 0n, $L1($ES1), now), $KC(0n)):
  L.subst($KX, z => BS.CountOK(~V, $L1($ES1), LR.kx_go(&2, V, 0n, now, z)), LR.kx_pick(&2, V, $F1, $GN), LR.kx_check(&2, V, $F1, now), Equal.sym($KX, LR.kx_check(&2, V, $F1, now), LR.kx_pick(&2, V, $F1, $GN), kx_ce(~V, $SHA0x, hg, one, h1, now, v)), kx_g0(~V, $SHA0x, hg, now, $GN))

%def ESt ST.es(~V, $LLo, $KL, $EL, t)
%def MOT(z) BS.CountOK(~V, Bool.pick(SP.Lru<V>, $GN, SP.expire(~V, p, SP.L{cap, $M3, $W4, SP.tail(~V, z), SP.c_rm($CTR)}, now), $L1(z)), $KC(1n+p))

def kx_c1(~V: Data, $SHF0, +hg: {ST.good(~V, $SH0) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +now: W.U64, +p: Nat, +v: V, +hm: {HT.nthm(~V, $EL, s0) == Some{v} : Maybe<&2, V>}, rec: $KREC(p)) -> BS.CountOK(~V, SP.expire(~V, 1n+p, $L1($ES1), now), $KC(1n+p)):
  ok = kx_g1(~V, $SHA0x, hg, one, h1, now, p, $GN, rec)
  ok2 = L.subst($KX, z => BS.CountOK(~V, Bool.pick(SP.Lru<V>, $GN, SP.expire(~V, p, $SPR, now), $L1($ES1)), LR.kx_go(&2, V, 1n+p, now, z)), LR.kx_pick(&2, V, $F1, $GN), LR.kx_check(&2, V, $F1, now), Equal.sym($KX, LR.kx_check(&2, V, $F1, now), LR.kx_pick(&2, V, $F1, $GN), kx_ce(~V, $SHA0x, hg, one, h1, now, v)), ok)
  +e = TO.es_cons(~V, $LLo, $KL, $EL, s0, v, hm, t)
  ok3 = L.subst(List<&2, SP.Ent<V>>, z => $MOT(z), $ES1, Con{$EV1, $ESt}, e, ok2)
  L.subst(List<&2, SP.Ent<V>>, z => BS.CountOK(~V, SP.expire(~V, 1n+p, $L1(z), now), $KC(1n+p)), Con{$EV1, $ESt}, $ES1, Equal.sym(List<&2, SP.Ent<V>>, $ES1, Con{$EV1, $ESt}, e), ok3)

%def HLS L.and_left(Bool.and(Nat.is_lt(s0, $FR), ST.live(~V, $EL, s0)), ST.slok(~V, t, $FR, $EL), $G1(csl))
%def PV some_v(~V, $EL, s0, HT.nthm(~V, $EL, s0), {==}, L.and_right(Nat.is_lt(s0, $FR), ST.live(~V, $EL, s0), $HLS))
%def SVS Sigma<&1, &1, V, v => {HT.nthm(~V, $EL, s0) == Some{v} : Maybe<&2, V>}>

def kx_w0(~V: Data, $SHF0, +hg: {ST.good(~V, $SH0) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +now: W.U64, pv: $SVS) -> BS.CountOK(~V, SP.expire(~V, 0n, $L1($ES1), now), $KC(0n)):
  match pv:
    case Tuple{+v, hm}:
      kx_c0(~V, $SHA0x, hg, one, h1, now, v)

def kx_w1(~V: Data, $SHF0, +hg: {ST.good(~V, $SH0) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +now: W.U64, +p: Nat, pv: $SVS, rec: $KREC(p)) -> BS.CountOK(~V, SP.expire(~V, 1n+p, $L1($ES1), now), $KC(1n+p)):
  match pv:
    case Tuple{+v, hm}:
      kx_c1(~V, $SHA0x, hg, one, h1, now, p, v, hm, rec)

%def KCs(f) LR.kx_go(&2, V, f, now, LR.kx_check(&2, V, $F, now))

def kx_z(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +now: W.U64) -> BS.CountOK(~V, SP.expire(~V, 0n, $L1($ES), now), $KCs(0n)):
  match sl:
    case Nil{}:
      kx_nil(~V, $SHAn, hg, now, 0n)
    case Con{+s0, +t}:
      kx_w0(~V, $SHA0x, hg, one, h1, now, $PV)

def kx_s(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +now: W.U64, +p: Nat, rec: $KREC(p)) -> BS.CountOK(~V, SP.expire(~V, 1n+p, $L1($ES), now), $KCs(1n+p)):
  match sl:
    case Nil{}:
      kx_nil(~V, $SHAn, hg, now, 1n+p)
    case Con{+s0, +t}:
      kx_w1(~V, $SHA0x, hg, one, h1, now, p, $PV, rec)

# THEOREM: the expiry loop is the specification's expire
def kx_ok(~V: Data, +one: Nat, +h1: {one == 1n : Nat}, +now: W.U64, +f: Nat, +sh: ST.Sh<V>, +hg: {ST.good(~V, sh) == True{} : Bool}) -> BS.CountOK(~V, SP.expire(~V, f, ST.model(~V, sh), now), LR.kx_go(&2, V, f, now, LR.kx_check(&2, V, ST.real(~V, sh), now))):
  match f sh:
    case 0n ST.LS{$SHA}:
      kx_z(~V, $SHA, hg, one, h1, now)
    case 1n+p ST.LS{$SHA}:
      kx_s(~V, $SHA, hg, one, h1, now, p, sh1 => g1 => kx_ok(~V, one, h1, now, p, sh1, g1))

def kn_ok(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +now: W.U64) -> BS.CountOK(~V, SP.expire(~V, SP.length(~V, $ES), $L1($ES), now), LR.keys_n(&2, V, now, $F)):
  L.subst(Nat, z => BS.CountOK(~V, SP.expire(~V, z, $L1($ES), now), LR.keys_n(&2, V, now, $F)), UD.v(n), SP.length(~V, $ES), Equal.sym(Nat, SP.length(~V, $ES), UD.v(n), BA.len_model(~V, $SHA, hg)), kx_ok(~V, one, h1, now, UD.v(n), $SH, hg))

# ---- the key walk ----

%def BK NL.rapp(sl, Nil{})
%def LLn SC.length(Nat, sl)
%def GAk(kl, pk) cap, n, head, tail, free, W32.nth0($ML, 0n), W32.nth0($ML, 1n), W32.nth0($ML, 2n), W32.nth0($ML, 6n), W32.nth0($ML, 7n), AR.perfect(U32, 5n, mT), k, sd, tabT, kl, pk, eT, lkT, sl, fl
%def SH3 ST.LS{cap, n, head, tail, free, mT, k, sd, tabT, K2, eT, lkT, sl, fl}
%def RA WL.racc($LLo, $KL, $BK, Nil{})
%def KO SP.keys_of(~V, $ES)
%def WL0 LR.wk_loop(UD.v(n), LR.WK{AR.thaw(String, ksT), AR.thaw(U32, lkT), Nil{}, tail})
%def KF(w) LR.keys_fin(&2, V, cap, n, head, tail, free, AR.thaw(U32, mT), AR.thaw(U32, tabT), AR.thaw(Maybe<&2, V>, eT), w)
%def WKE(a) LR.WK{AR.thaw(String, K2), AR.thaw(U32, lkT), a, a2}
%def ES3 ST.es(~V, $LLo, AR.slots(String, K2), $EL, sl)
%def LT RM.POK(~V, List<&2, String>, SP.keys_fin(~V, $L1($ES)), LR.keys_list(&2, V, $F))

# the walk starts at the tail, the first slot of sl reversed
def hat_of(+sl: List<&2, Nat>, +tail: U32, +et: {tail == LK.last_or(sl, 0) : U32}) -> {LK.fst_or(NL.rapp(sl, Nil{}), tail) == tail : U32}:
  +h = Equal.trans(U32, LK.fst_or(NL.rapp(sl, Nil{}), LK.last_or(sl, 0)), LK.last_or(sl, LK.last_or(sl, 0)), LK.last_or(sl, 0), LK.fo_rapp(sl, Nil{}, LK.last_or(sl, 0)), WL.lo_idem(sl, 0))
  L.subst(U32, z => {LK.fst_or(NL.rapp(sl, Nil{}), z) == z : U32}, LK.last_or(sl, 0), tail, Equal.sym(U32, tail, LK.last_or(sl, 0), et), h)

def kl_w(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, wo: WL.WOK(lkT, $KL, sd, $BK, Nil{}, tail, ksT)) -> $LT:
  match wo:
    case Tuple{+K2, Tuple{+a2, Tuple{+ew, Tuple{+hs2, pk2}}}}:
      +efu = Equal.trans(Nat, SC.length(Nat, $BK), Nat.add($LLn, 0n), UD.v(n), NL.len_rapp(sl, Nil{}), Equal.trans(Nat, Nat.add($LLn, 0n), $LLn, UD.v(n), N.add_zero($LLn), N.eq_from_is_eq($LLn, UD.v(n), $G(clen))))
      +ew2 = L.subst(Nat, z => {LR.wk_loop(z, LR.WK{AR.thaw(String, ksT), AR.thaw(U32, lkT), Nil{}, tail}) == $WKE($RA) : LR.Walk}, SC.length(Nat, $BK), UD.v(n), efu, ew)
      +eac = Equal.trans(List<&2, String>, $RA, SC.append(String, WL.mapk($LLo, $KL, sl), Nil{}), $KO, WL.ra_rapp($LLo, $KL, sl, Nil{}, Nil{}), Equal.trans(List<&2, String>, SC.append(String, WL.mapk($LLo, $KL, sl), Nil{}), WL.mapk($LLo, $KL, sl), $KO, LI.append_nil(String, WL.mapk($LLo, $KL, sl)), Equal.sym(List<&2, String>, $KO, WL.mapk($LLo, $KL, sl), WL.km(~V, $LLo, $KL, $EL, $FR, sl, $G(csl)))))
      +er1 = Equal.cong(LR.Walk, LR.LRU<&2, V> & List<&2, String>, w => $KF(w), $WL0, $WKE($RA), ew2)
      +er2 = Equal.cong(List<&2, String>, LR.LRU<&2, V> & List<&2, String>, z => (ST.real(~V, $SH3), z), $RA, $KO, eac)
      +er = Equal.trans(LR.LRU<&2, V> & List<&2, String>, $KF($WL0), (ST.real(~V, $SH3), $RA), (ST.real(~V, $SH3), $KO), er1, er2)
      +em = Equal.cong(List<&2, String>, SP.Lru<V> & List<&2, String>, z => (SP.L{cap, $M3, $W4, ST.es(~V, $LLo, z, $EL, sl), $CTR}, $KO), $KL, AR.slots(String, K2), Equal.sym(List<&2, String>, AR.slots(String, K2), $KL, hs2))
      +hg1 = L.subst(Bool, z => {ST.goodF(~V, $GAk($KL, z)) == True{} : Bool}, AR.perfect(String, sd, ksT), True{}, $G(cpk), hg)
      +hg2 = L.subst(Bool, z => {ST.goodF(~V, $GAk($KL, z)) == True{} : Bool}, True{}, AR.perfect(String, sd, K2), Equal.sym(Bool, AR.perfect(String, sd, K2), True{}, pk2), hg1)
      +hg3 = L.subst(List<&2, String>, z => {ST.goodF(~V, $GAk(z, AR.perfect(String, sd, K2))) == True{} : Bool}, $KL, AR.slots(String, K2), Equal.sym(List<&2, String>, AR.slots(String, K2), $KL, hs2), hg2)
      ($SH3, ($KO, (er, (em, hg3))))

def kl_ok(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}) -> $LT:
  +hsd = RD.f_hsd(~V, $SHA, hg)
  +hr = WL.rok_app(~V, $LLo, $EL, sl, Nil{}, $FR, 0, 0, $G(cdll), $G(csl), {==}, {==})
  +hat = hat_of(sl, tail, A.eq_of(tail, LK.last_or(sl, 0), $G(ctail)))
  kl_w(~V, $SHA, hg, WL.walk(one, h1, lkT, sd, hsd, $G(cpl), $KL, $FR, $G(cfresh), $BK, Nil{}, tail, ksT, {==}, $G(cpk), hr, hat))

def kl_sh(~V: Data, +one: Nat, +h1: {one == 1n : Nat}, +sh: ST.Sh<V>, +hg: {ST.good(~V, sh) == True{} : Bool}) -> RM.POK(~V, List<&2, String>, SP.keys_fin(~V, ST.model(~V, sh)), LR.keys_list(&2, V, ST.real(~V, sh))):
  match sh:
    case ST.LS{$SHA}:
      kl_ok(~V, $SHA, hg, one, h1)

%def XS SP.expire(~V, SP.length(~V, $ES), $L1($ES), now)
%def KN LR.keys_n(&2, V, now, $F)

def ky(~V: Data, $SHF, +one: Nat, +h1: {one == 1n : Nat}, +now: W.U64, co: BS.CountOK(~V, $XS, $KN)) -> RM.POK(~V, List<&2, String>, SP.keys_fin(~V, $XS), LR.keys_list(&2, V, $KN)):
  match co:
    case Tuple{+sh2, Tuple{+e1, Tuple{+em1, g2}}}:
      ok = kl_sh(~V, one, h1, sh2, g2)
      ok2 = L.subst(SP.Lru<V>, z => RM.POK(~V, List<&2, String>, SP.keys_fin(~V, z), LR.keys_list(&2, V, ST.real(~V, sh2))), ST.model(~V, sh2), $XS, em1, ok)
      L.subst(LR.LRU<&2, V>, z => RM.POK(~V, List<&2, String>, SP.keys_fin(~V, $XS), LR.keys_list(&2, V, z)), ST.real(~V, sh2), $KN, Equal.sym(LR.LRU<&2, V>, $KN, ST.real(~V, sh2), e1), ok2)

# THEOREM: keys refines the specification
def keys_ok(~V: Data, +one: Nat, +h1: {one == 1n : Nat}, +now: W.U64, +sh: ST.Sh<V>, +hg: {ST.good(~V, sh) == True{} : Bool}) -> RM.POK(~V, List<&2, String>, SP.keys(~V, ST.model(~V, sh), now), LR.keys(&2, V, ST.real(~V, sh), now)):
  match sh:
    case ST.LS{$SHA}:
      ky(~V, $SHA, one, h1, now, kn_ok(~V, $SHA, hg, one, h1, now))
