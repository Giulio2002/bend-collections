%def RPA $SHA, hg, one, h1, s, hmem, su, hsv, v0, hm, key, hk, v, t, lo, hi
%def EN SP.LE{key, v, t, W.U64{lo, hi}}
%def EV3 TO.ev(~V, $L3, $KL, s, v)
%def GAP cap, n, head, tail, free, W32.nth0($ML, 0n), W32.nth0($ML, 1n), W32.nth0($ML, 2n), W32.nth0($ML, 6n), W32.nth0($ML, 7n), AR.perfect(U32, 5n, mT), k, sd, tabT, $KL, AR.perfect(String, sd, ksT), $EU, $LK3, sl, fl

