  +a2 = UL.wr(one, h1, $LK1, sd, hsd, p1, LR.dlo_idx(su), s, 4n, {==}, hs0, i4, lo)
  +a3 = UL.wr(one, h1, $LK2, sd, hsd, p2, LR.dhi_idx(su), s, 5n, {==}, hs0, i5, hi)
  +eL = Equal.trans(Array<U32>, $SET3(AR.thaw(U32, lkT)), Array.set(U32, Array.set(U32, AR.thaw(U32, $LK1), LR.dlo_idx(su), lo), LR.dhi_idx(su), hi), AR.thaw(U32, $LK3), Equal.cong(Array<U32>, Array<U32>, z => Array.set(U32, Array.set(U32, z, LR.dlo_idx(su), lo), LR.dhi_idx(su), hi), Array.set(U32, AR.thaw(U32, lkT), LR.tidx(su), t), AR.thaw(U32, $LK1), a1), Equal.trans(Array<U32>, Array.set(U32, Array.set(U32, AR.thaw(U32, $LK1), LR.dlo_idx(su), lo), LR.dhi_idx(su), hi), Array.set(U32, AR.thaw(U32, $LK2), LR.dhi_idx(su), hi), AR.thaw(U32, $LK3), Equal.cong(Array<U32>, Array<U32>, z => Array.set(U32, z, LR.dhi_idx(su), hi), Array.set(U32, AR.thaw(U32, $LK1), LR.dlo_idx(su), lo), AR.thaw(U32, $LK2), a2), a3))
  +e1 = Equal.cong(Array<Maybe<&2, V>>, $RL, x => $RF(x, $SET3(AR.thaw(U32, lkT))), $EZ, AR.thaw(Maybe<&2, V>, $EU), eE)
  +e2 = Equal.cong(Array<U32>, $RL, y => $RF(AR.thaw(Maybe<&2, V>, $EU), y), $SET3(AR.thaw(U32, lkT)), AR.thaw(U32, $LK3), eL)
  Equal.trans($RL, $RF($EZ, $SET3(AR.thaw(U32, lkT))), $RF(AR.thaw(Maybe<&2, V>, $EU), $SET3(AR.thaw(U32, lkT))), $RF(AR.thaw(Maybe<&2, V>, $EU), AR.thaw(U32, $LK3)), e1, e2)

def rp_spl(~V: Data, $RPF, sp: NL.Split(s, sl)) -> {$SNP(sl) == $SN0(sl) : List<&2, SP.Ent<V>>}:
  match sp:
    case Tuple{+a, Tuple{+b, +e}}:
      rp_sp(~V, $RPA, a, b, e)

%def SHAP cap, n, head, tail, free, mT, k, sd, tabT, ksT, $EU, $LK3, sl, fl
%def SHM2 ST.LS{cap, n, head, tail, free, m2, k, sd, tabT, ksT, $EU, $LK3, sl, fl}
%def ML2 AR.slots(U32, m2)
%def SPT SP.L{cap, W32.nth0($ML2, 3n), ST.w64($ML2, 4n), SP.snoc(~V, SP.drop(~V, $ESP, key), $EV3), ST.ctr($ML2)}
%def SPX SP.L{cap, $M3, $W4, $SN0(sl), SP.c_ins($CTR)}
%def PX ($SPX, False{})
%def EMS SP.L{cap, $M3, $W4, $ESP, SP.c_ins($CTR)}

def rp_t(~V: Data, $RPF, +m2: AR.Tree<U32>, +em: {ST.model(~V, $SHM2) == $EMS : SP.Lru<V>}, -r: $RL, to: TSH.TouchOK(~V, $SPT, r)) -> RM.POK(~V, Bool, $PX, (r, False{})):
  match to:
    case Tuple{+sh3, Tuple{+e3, Tuple{+em3, g3}}}:
      +eo = Equal.cong(SP.Lru<V>, U32, w => RD.l_on(~V, w), ST.model(~V, $SHM2), $EMS, em)
      +el = Equal.cong(SP.Lru<V>, W.U64, w => RD.l_life(~V, w), ST.model(~V, $SHM2), $EMS, em)
      +ec = Equal.cong(SP.Lru<V>, SP.Ctr, w => RD.l_c(~V, w), ST.model(~V, $SHM2), $EMS, em)
      +es1 = BA.lru_eq(~V, cap, W32.nth0($ML2, 3n), $M3, ST.w64($ML2, 4n), $W4, SP.snoc(~V, SP.drop(~V, $ESP, key), $EV3), $SN0(sl), ST.ctr($ML2), SP.c_ins($CTR), eo, el, rp_spl(~V, $RPA, NL.split_mem(s, sl, hmem)), ec)
      +esp = Equal.trans(SP.Lru<V>, ST.model(~V, sh3), $SPT, $SPX, em3, es1)
      (sh3, (False{}, (Equal.cong($RL, $RL & Bool, z => (z, False{}), r, ST.real(~V, sh3), e3), (Equal.cong(SP.Lru<V>, SP.Lru<V> & Bool, z => (z, False{}), $SPX, ST.model(~V, sh3), Equal.sym(SP.Lru<V>, ST.model(~V, sh3), $SPX, esp)), g3))))

%def FBP LR.fbump(&2, V, 0, ST.real(~V, $SHP))

def rp_c(~V: Data, $RPF, cm: BS.CntM(~V, $SHAP, $EMS, $FBP)) -> RM.POK(~V, Bool, $PX, (LR.touch(&2, V, $FBP, su), False{})):
  match cm:
    case Tuple{+m2, Tuple{+e1, Tuple{+em, g1}}}:
      +E = Equal.cong($RL, $RL, z => LR.touch(&2, V, z, su), $FBP, ST.real(~V, $SHM2), e1)
      ok = rp_t(~V, $RPA, m2, em, LR.touch(&2, V, ST.real(~V, $SHM2), su), TSH.touch_sh(~V, one, h1, cap, n, head, tail, free, m2, k, sd, tabT, ksT, $EU, $LK3, sl, fl, g1, s, hmem, su, hsv, key, rp_hk(~V, $RPA), v, rp_hm(~V, $RPA)))
      L.subst($RL, z => RM.POK(~V, Bool, $PX, (z, False{})), LR.touch(&2, V, ST.real(~V, $SHM2), su), LR.touch(&2, V, $FBP, su), Equal.sym($RL, LR.touch(&2, V, $FBP, su), LR.touch(&2, V, ST.real(~V, $SHM2), su), E), ok)

# THEOREM (add, a present key): the entry is replaced and becomes the newest,
# counted as an insertion; nothing is evicted
def repl_ok(~V: Data, $RPF) -> RM.POK(~V, Bool, $PX, (LR.replace(&2, V, $F, su, LR.E{v, t, lo, hi}), False{})):
  +gp = rp_good(~V, $RPA)
  ok = rp_c(~V, $RPA, BS.cntm_ins(~V, $SHAP, gp, BU.bump_ok(mT, $G(cpm), 0, 16n, {==}, {==}, {==})))
  +E = rp_impl(~V, $RPA)
  L.subst($RL, z => RM.POK(~V, Bool, $PX, (z, False{})), LR.touch(&2, V, $FBP, su), LR.replace(&2, V, $F, su, LR.E{v, t, lo, hi}), Equal.sym($RL, LR.replace(&2, V, $F, su, LR.E{v, t, lo, hi}), LR.touch(&2, V, $FBP, su), E), ok)
