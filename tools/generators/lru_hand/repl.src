# add, a present key: the entry is rewritten in place (value, lifetime,
# deadline), counted as an insertion and touched.

%include read.src

%def LK1 AR.upd(U32, 3n+sd, lkT, UD.v(LR.tidx(su)), t)
%def LK2 AR.upd(U32, 3n+sd, $LK1, UD.v(LR.dlo_idx(su)), lo)
