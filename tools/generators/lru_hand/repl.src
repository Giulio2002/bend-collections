  +i5 = Equal.trans(Nat, UD.v(LR.dhi_idx(su)), ST.off(UD.v(su), 5n), ST.off(s, 5n), ID.w5(one, h1, su, sd, UL.sd3(sd, hsd), hsu), Equal.cong(Nat, Nat, z => ST.off(z, 5n), UD.v(su), s, hsv))
  +hpl = $G(cpl)
  +hpe = $G(cpe)
  +p1 = UT.uset_p(3n+sd, lkT, hpl, UD.v(LR.tidx(su)), t)
  +p2 = UT.uset_p(3n+sd, $LK1, p1, UD.v(LR.dlo_idx(su)), lo)
  +p3 = UT.uset_p(3n+sd, $LK2, p2, UD.v(LR.dhi_idx(su)), hi)
  +s1 = UL.wr_s(lkT, sd, hpl, LR.tidx(su), s, 3n, {==}, hs0, i3, t)
  +s2 = UL.wr_s($LK1, sd, p1, LR.dlo_idx(su), s, 4n, {==}, hs0, i4, lo)
  +s3 = UL.wr_s($LK2, sd, p2, LR.dhi_idx(su), s, 5n, {==}, hs0, i5, hi)
  +pe = AR.upd_perfect(Maybe<&2, V>, sd, eT, UD.v(su), Some{v}, hpe)
  +se = Equal.trans(List<&2, Maybe<&2, V>>, $ELP, SC.update(Maybe<&2, V>, $EL, UD.v(su), Some{v}), $UEL, AR.upd_slots(Maybe<&2, V>, sd, eT, UD.v(su), Some{v}, hsu, hpe), Equal.cong(Nat, List<&2, Maybe<&2, V>>, z => SC.update(Maybe<&2, V>, $EL, z, Some{v}), UD.v(su), s, hsv))
  +hle = UT.len_of(Maybe<&2, V>, sd, eT, hpe, s, hs0)
  +hlv = Equal.cong(Maybe<&2, V>, Bool, z => HT.some_b(~V, z), HT.nthm(~V, $EL, s), Some{v0}, hm)
  +hsl = L.subst(List<&2, Maybe<&2, V>>, z => {ST.slok(~V, sl, $FR, z) == True{} : Bool}, $UEL, $ELP, Equal.sym(List<&2, Maybe<&2, V>>, $ELP, $UEL, se), HW.slok_live(~V, $EL, s, v, $FR, sl, hle, $G(csl)))
  L.subst(String, z => {S.str_eq(z, key) == True{} : Bool}, ST.skey($L0, $KL, s), ST.skey($L3, $KL, s), Equal.sym(String, ST.skey($L3, $KL, s), ST.skey($L0, $KL, s), Equal.trans(String, ST.skey($L3, $KL, s), ST.skey($L2, $KL, s), ST.skey($L0, $KL, s), Equal.trans(String, ST.skey($L3, $KL, s), ST.skey(SC.update(U32, $L2, ST.off(s, 5n), hi), $KL, s), ST.skey($L2, $KL, s), Equal.cong(List<&2, U32>, String, z => ST.skey(z, $KL, s), $L3, SC.update(U32, $L2, ST.off(s, 5n), hi), s3), HW.skey_hw($L2, s, 5n, hi, {==}, {==}, $KL, s)), Equal.trans(String, ST.skey($L2, $KL, s), ST.skey($L1, $KL, s), ST.skey($L0, $KL, s), Equal.trans(String, ST.skey($L2, $KL, s), ST.skey(SC.update(U32, $L1, ST.off(s, 4n), lo), $KL, s), ST.skey($L1, $KL, s), Equal.cong(List<&2, U32>, String, z => ST.skey(z, $KL, s), $L2, SC.update(U32, $L1, ST.off(s, 4n), lo), s2), HW.skey_hw($L1, s, 4n, lo, {==}, {==}, $KL, s)), Equal.trans(String, ST.skey($L1, $KL, s), ST.skey(SC.update(U32, $L0, ST.off(s, 3n), t), $KL, s), ST.skey($L0, $KL, s), Equal.cong(List<&2, U32>, String, z => ST.skey(z, $KL, s), $L1, SC.update(U32, $L0, ST.off(s, 3n), t), s1), HW.skey_hw($L0, s, 3n, t, {==}, {==}, $KL, s))))), hk)

def rp_hm(~V: Data, $RPF) -> {HT.nthm(~V, $ELP, s) == Some{v} : Maybe<&2, V>}:
  +hsd = RD.f_hsd(~V, $SHA, hg)
  +hs0 = RD.f_s0(~V, $SHA, hg, s, hmem)
  +hsu = GO.su_lt(su, s, sd, hsv, hs0)
