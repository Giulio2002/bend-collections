# the rewritten slot still holds key and now holds v
def rp_hk(~V: Data, $RPF) -> {S.str_eq(ST.skey($L3, $KL, s), key) == True{} : Bool}:
  +hsd = RD.f_hsd(~V, $SHA, hg)
  +hs0 = RD.f_s0(~V, $SHA, hg, s, hmem)
  +hsu = GO.su_lt(su, s, sd, hsv, hs0)
  +i3 = Equal.trans(Nat, UD.v(LR.tidx(su)), ST.off(UD.v(su), 3n), ST.off(s, 3n), ID.w3(one, h1, su, sd, UL.sd3(sd, hsd), hsu), Equal.cong(Nat, Nat, z => ST.off(z, 3n), UD.v(su), s, hsv))
