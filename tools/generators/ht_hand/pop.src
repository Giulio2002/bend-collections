# ---- the key cell ----

def DropOK(+K2: AR.Tree<String>, +sd: Nat, +l: U32, +key: String, +bsf: List<&2, B.Bk>, +tbf: List<&2, U32>, +nn: Nat) -> Type:
  Sigma<&1, &1, AR.Tree<String>, KS3 => {H.drop_key(AR.thaw(String, K2), $SU, H.is_short($W)) == AR.thaw(String, KS3) : Array<String>} & ({AR.perfect(String, sd, KS3) $TT & {TB.buckets(tbf, AR.slots(String, KS3), nn) == bsf : List<&2, B.Bk>})>

def drop_c($DP, +c: Bool, +hc: {H.is_short($W) == c : Bool}) -> DropOK(K2, sd, l, key, $VF, AR.slots(U32, Tf), $NN):
  match c:
    case True{}:
      (K2, (Equal.cong(Bool, Array<String>, b => H.drop_key(AR.thaw(String, K2), $SU, b), H.is_short($W), True{}, hc), (pk2, Equal.cong(List<&2, String>, List<&2, B.Bk>, z => TB.buckets(AR.slots(U32, Tf), z, $NN), AR.slots(String, K2), $KL, hsl2))))
    case False{}:
      +hr = p_hr($HA)
      +est = AR.set(String, sd, K2, $SU, "", TB.nths(AR.slots(String, K2), $SV), ST.g_csd($GF), hr, AX.nths_of(sd, K2, $SV, hr, pk2), pk2)
      +esl = Equal.trans(List<&2, String>, AR.slots(String, AR.upd(String, sd, K2, $SV, "")), SC.update(String, AR.slots(String, K2), $SV, ""), SC.update(String, $KL, $SV, ""), AR.upd_slots(String, sd, K2, $SV, "", hr, pk2), Equal.cong(List<&2, String>, List<&2, String>, z => SC.update(String, z, $SV, ""), AR.slots(String, K2), $KL, hsl2))
      (AR.upd(String, sd, K2, $SV, ""), (Equal.trans(Array<String>, H.drop_key(AR.thaw(String, K2), $SU, H.is_short($W)), Array.set(String, AR.thaw(String, K2), $SU, ""), AR.thaw(String, AR.upd(String, sd, K2, $SV, "")), Equal.cong(Bool, Array<String>, b => H.drop_key(AR.thaw(String, K2), $SU, b), H.is_short($W), False{}, hc), est), (AR.upd_perfect(String, sd, K2, $SV, "", pk2), Equal.trans(List<&2, B.Bk>, TB.buckets(AR.slots(U32, Tf), AR.slots(String, AR.upd(String, sd, K2, $SV, "")), $NN), TB.buckets(AR.slots(U32, Tf), SC.update(String, $KL, $SV, ""), $NN), $VF, Equal.cong(List<&2, String>, List<&2, B.Bk>, z => TB.buckets(AR.slots(U32, Tf), z, $NN), AR.slots(String, AR.upd(String, sd, K2, $SV, "")), SC.update(String, $KL, $SV, ""), esl), PL.bs_key(AR.slots(U32, Tf), $KL, $SV, "", $NN, p_nsf($DA))))))

%def BND TB.buckets(AR.slots(U32, Tf), AR.slots(String, KS3), $NN)
