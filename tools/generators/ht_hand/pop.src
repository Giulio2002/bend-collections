# pop of a present key: the implementation's result is the specification's
# lookup and remove.

%def TT == True{} : Bool}
%def FF == False{} : Bool}
%def FP +n: U32, +k: Nat, +td: U32, +fresh: U32, +sz: U32, +sd: Nat, +sdU: U32, +free: U32, +tabT: AR.Tree<U32>, +ksT: AR.Tree<String>, +vsT: AR.Tree<Maybe<&2, V>>, +nxT: AR.Tree<U32>
%def FLD n, k, td, fresh, sz, sd, sdU, free, tabT, ksT, vsT, nxT
%def SH ST.HS{$FLD}
%def KL AR.slots(String, ksT)
%def TBL AR.slots(U32, tabT)
%def VSL AR.slots(Maybe<&2, V>, vsT)
%def NXL AR.slots(U32, nxT)
%def NN SC.pow2(k)
%def O TB.buckets($TBL, $KL, $NN)
%def M0 ST.absm(~V, $O, $VSL, $NN, 0n)
%def GF ~V, n, k, td, fresh, sz, sd, sdU, free, tabT, $KL, AR.perfect(String, sd, ksT), vsT, nxT, hg
%def MK CY.msk(k)
%def SU H.slot(l)
%def SV UD.v(H.slot(l))
%def SVO UD.v(H.slot(B.lnk(B.at($O, i))))
%def V0 IM.bupd($O, i, B.BE{})
%def VF TB.buckets(AR.slots(U32, Tf), $KL, $NN)
%def VS2 AR.upd(Maybe<&2, V>, sd, vsT, $SV, None{})
%def VSL2 SC.update(Maybe<&2, V>, $VSL, $SV, None{})
%def NX2 AR.upd(U32, sd, nxT, $SV, free)
%def W K.kword(key)
%def HK31 L.and_left(Nat.is_lt(k, 31n), Nat.is_lt(0n, k), ST.g_ck($GF))
%def HK0 L.and_right(Nat.is_lt(k, 31n), Nat.is_lt(0n, k), ST.g_ck($GF))

def PopOK(~V: Data, +sh: ST.Sh<V>, +key: String, r: H.HashMap<&2, V> & Maybe<&2, V>) -> Type:
  Sigma<&1, &1, ST.Sh<V>, sh2 => {r == (ST.real(~V, sh2), S.lookup(~V, ST.model(~V, sh), key)) : H.HashMap<&2, V> & Maybe<&2, V>} & ({ST.good(~V, sh2) $TT & ((@+q: String -> {S.lookup(~V, ST.model(~V, sh2), q) == S.lookup(~V, S.remove(~V, ST.model(~V, sh), key), q) : Maybe<&2, V>}) & {S.size(~V, ST.model(~V, sh2)) == S.size(~V, S.remove(~V, ST.model(~V, sh), key)) : Nat}))>

%def HP ~V: Data, +one: Nat, +h1: {one == 1n : Nat}, $FP, +hg: {ST.good(~V, $SH) $TT, +key: String, +K2: AR.Tree<String>, +hsl2: {AR.slots(String, K2) == $KL : List<&2, String>}, +pk2: {AR.perfect(String, sd, K2) $TT, +i: Nat, +l: U32, +hi: {Nat.is_lt(i, $NN) $TT, +hk: {B.hold(key, B.at($O, i)) $TT, +hl: {B.lnk(B.at($O, i)) == l : U32}
%def HA ~V, one, h1, $FLD, hg, key, K2, hsl2, pk2, i, l, hi, hk, hl

# ---- the slot of the removed entry ----

def p_hoi($HP) -> {B.occ(B.at($O, i)) $TT:
  B.hold_occ(key, B.at($O, i), hk)

def p_esl($HP) -> {$SVO == $SV : Nat}:
  Equal.cong(U32, Nat, z => UD.v(H.slot(z)), B.lnk(B.at($O, i)), l, hl)

def p_bf($HP) -> {Bool.not(U32.is_eq(B.lnk(B.at($O, i)), 0)) $TT & ({Nat.is_lt($SVO, SC.pow2(sd)) $TT & {B.nthb(ST.lvs(~V, $VSL), $SVO) $TT):
  G.bf_ok(sd, ST.lvs(~V, $VSL), UD.v(fresh), key, B.at($O, i), B.all_inst(B.PWell{$O, sd}, $NN, ST.g_cwell($GF), i, hi), B.all_inst(B.PLive{$O, ST.lvs(~V, $VSL), UD.v(fresh)}, $NN, ST.g_clive($GF), i, hi), hk)

def live_lt(+lv: List<&2, Bool>, +fr: Nat, +b: B.Bk, +h: {B.live_b(lv, fr, b) $TT, +ho: {B.occ(b) $TT) -> {Nat.is_lt(UD.v(H.slot(B.lnk(b))), fr) $TT:
  match b:
    case B.BE{}:
      Empty.absurd({Nat.is_lt(UD.v(H.slot(B.lnk(B.BE{}))), fr) $TT, L.false_true(ho))
    case B.BF{w, +l2, k2}:
      L.and_right(B.nthb(lv, UD.v(H.slot(l2))), Nat.is_lt(UD.v(H.slot(l2)), fr), h)

def p_sf($HP) -> {Nat.is_lt($SV, UD.v(fresh)) $TT:
  L.subst(Nat, z => {Nat.is_lt(z, UD.v(fresh)) $TT, $SVO, $SV, p_esl($HA), live_lt(ST.lvs(~V, $VSL), UD.v(fresh), B.at($O, i), B.all_inst(B.PLive{$O, ST.lvs(~V, $VSL), UD.v(fresh)}, $NN, ST.g_clive($GF), i, hi), p_hoi($HA)))

def p_hr_c($HP, bf: {Bool.not(U32.is_eq(B.lnk(B.at($O, i)), 0)) $TT & ({Nat.is_lt($SVO, SC.pow2(sd)) $TT & {B.nthb(ST.lvs(~V, $VSL), $SVO) $TT)) -> {Nat.is_lt($SV, SC.pow2(sd)) $TT & ({B.nthb(ST.lvs(~V, $VSL), $SV) $TT & {U32.is_eq(l, 0) $FF):
  match bf:
    case Tuple{nz, Tuple{hr0, hlv0}}:
      +hr = L.subst(Nat, z => {Nat.is_lt(z, SC.pow2(sd)) $TT, $SVO, $SV, p_esl($HA), hr0)
      +hlv = L.subst(Nat, z => {B.nthb(ST.lvs(~V, $VSL), z) $TT, $SVO, $SV, p_esl($HA), hlv0)
      +nz2 = L.subst(U32, z => {Bool.not(U32.is_eq(z, 0)) $TT, B.lnk(B.at($O, i)), l, hl, nz)
      (hr, (hlv, K.not_true_eq(U32.is_eq(l, 0), nz2)))

%def TRI {Nat.is_lt($SV, SC.pow2(sd)) $TT & ({B.nthb(ST.lvs(~V, $VSL), $SV) $TT & {U32.is_eq(l, 0) $FF)
def p_hr($HP) -> {Nat.is_lt($SV, SC.pow2(sd)) $TT:
  Pair.fst({Nat.is_lt($SV, SC.pow2(sd)) $TT, {B.nthb(ST.lvs(~V, $VSL), $SV) $TT & {U32.is_eq(l, 0) $FF, p_hr_c($HA, p_bf($HA)))

def p_hlv($HP) -> {B.nthb(ST.lvs(~V, $VSL), $SV) $TT:
  Pair.fst({B.nthb(ST.lvs(~V, $VSL), $SV) $TT, {U32.is_eq(l, 0) $FF, Pair.snd({Nat.is_lt($SV, SC.pow2(sd)) $TT, {B.nthb(ST.lvs(~V, $VSL), $SV) $TT & {U32.is_eq(l, 0) $FF, p_hr_c($HA, p_bf($HA))))

def p_nz($HP) -> {U32.is_eq(l, 0) $FF:
  Pair.snd({B.nthb(ST.lvs(~V, $VSL), $SV) $TT, {U32.is_eq(l, 0) $FF, Pair.snd({Nat.is_lt($SV, SC.pow2(sd)) $TT, {B.nthb(ST.lvs(~V, $VSL), $SV) $TT & {U32.is_eq(l, 0) $FF, p_hr_c($HA, p_bf($HA))))

def p_hlen($HP) -> {Nat.is_lt(i, SC.length(B.Bk, $O)) $TT:
  L.subst(Nat, z => {Nat.is_lt(i, z) $TT, $NN, SC.length(B.Bk, $O), Equal.sym(Nat, SC.length(B.Bk, $O), $NN, IA.len_dlist($TBL, $KL, $NN, 0n)), hi)

# no bucket but i used the removed slot
def ns0_b($HP, +b: B.Bk, +hb: {B.at($O, i) == b : B.Bk}) -> {ST.noslot($V0, $SV, $NN) $TT:
  match b:
    case B.BE{}:
      Empty.absurd({ST.noslot($V0, $SV, $NN) $TT, L.false_true(L.subst(B.Bk, y => {B.occ(y) $TT, B.at($O, i), B.BE{}, hb, p_hoi($HA))))
    case B.BF{+x, +l2, +kb}:
      +el = Equal.trans(U32, l2, B.lnk(B.at($O, i)), l, Equal.cong(B.Bk, U32, y => B.lnk(y), B.BF{x, l2, kb}, B.at($O, i), Equal.sym(B.Bk, B.at($O, i), B.BF{x, l2, kb}, hb)), hl)
      L.subst(U32, z => {ST.noslot($V0, UD.v(H.slot(z)), $NN) $TT, l2, l, el, DM.ns_rm($O, $NN, i, hi, p_hlen($HA), ST.g_cuniq($GF), x, l2, kb, hb, $NN, N.le_refl($NN)))

def p_ns0($HP) -> {ST.noslot($V0, $SV, $NN) $TT:
  ns0_b($HA, B.at($O, i), {==})

def p_hem($HP) -> {Nat.is_lt(IV.occn($O, $NN), $NN) $TT:
  L.subst(Nat, z => {Nat.is_lt(z, $NN) $TT, UD.v(n), IV.occn($O, $NN), N.eq_from_is_eq(UD.v(n), IV.occn($O, $NN), ST.g_cn($GF)), G.load_lt(UD.v(n), $NN, N.succ_le_lt(0n, $NN, N.pow2_pos(k)), ST.g_cload($GF)))

# v n = occn(V0) + 1
def p_en($HP) -> {UD.v(n) == 1n+IV.occn($V0, $NN) : Nat}:
  Equal.trans(Nat, UD.v(n), IV.occn($O, $NN), 1n+IV.occn($V0, $NN), N.eq_from_is_eq(UD.v(n), IV.occn($O, $NN), ST.g_cn($GF)), DM.occn_rm($O, $NN, i, hi, p_hlen($HA), p_hoi($HA)))

def p_en1($HP) -> {UD.v(U32.sub(n, 1)) == IV.occn($V0, $NN) : Nat}:
  +hle = L.subst(Nat, z => {Nat.is_le(1n, z) $TT, 1n+IV.occn($V0, $NN), UD.v(n), Equal.sym(Nat, UD.v(n), 1n+IV.occn($V0, $NN), p_en($HA)), N.zero_le(IV.occn($V0, $NN)))
  Equal.trans(Nat, UD.v(U32.sub(n, 1)), Nat.sub(UD.v(n), 1n), IV.occn($V0, $NN), U.sub_nat(n, 1, hle), Equal.trans(Nat, Nat.sub(UD.v(n), 1n), Nat.sub(1n+IV.occn($V0, $NN), 1n), IV.occn($V0, $NN), Equal.cong(Nat, Nat, z => Nat.sub(z, 1n), UD.v(n), 1n+IV.occn($V0, $NN), p_en($HA)), N.sub_zero(IV.occn($V0, $NN))))

