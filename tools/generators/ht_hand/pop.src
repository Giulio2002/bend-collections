def ph_drop($DP, +edt: {H.del_at(AR.thaw(U32, tabT), $MK, U32.from_nat(i)) == AR.thaw(U32, Tf) : Array<U32>}, dr: DropOK(K2, sd, l, key, $VF, AR.slots(U32, Tf), $NN)) -> PopOK(~V, $SH, key, $PH):
  match dr:
    case Tuple{+KS3, Tuple{+edk, rest}}:
      (+pk3, ebs0) = rest
      +ebs = {ebs0 : {$BND == $VF : List<&2, B.Bk>}}
      ($SH2, (p_eq($XA, edt, edk), (p_good($XA), (q => p_lk($XA, q), p_sz($XA)))))

def ph_del($HP, d: DW.DelAt2($KL, k, tabT, i)) -> PopOK(~V, $SH, key, $PH):
  match d:
    case Tuple{+Tf, Tuple{+edt, +hd}}:
      ph_drop($HA, Tf, hd, edt, drop_c($HA, Tf, hd, H.is_short($W), {==}))

# THEOREM: popping a key held by bucket i returns its value and removes it
def pop_hit_ok($HP) -> PopOK(~V, $SH, key, $PH):
  ph_del($HA, DW.del_ok2(k, $HK31, $KL, tabT, ST.g_cpt($GF), i, hi, ST.g_cclus($GF), ST.g_cuniq($GF), p_hoi($HA), p_hem($HA)))

# ---- pop of an absent key ----

%def BS2 TB.buckets($TBL, AR.slots(String, K2), $NN)
%def AP ~V: Data, $FP, +hg: {ST.good(~V, $SH) $TT, +key: String, +K2: AR.Tree<String>, +hsl2: {AR.slots(String, K2) == $KL : List<&2, String>}, +pk2: {AR.perfect(String, sd, K2) $TT, +e: Nat, +hno: {B.all_lt(B.PNo{$O, key}, $NN) $TT
%def SHK ST.HS{n, k, td, fresh, sz, sd, sdU, free, tabT, K2, vsT, nxT}

def pop_absent_ok($AP) -> PopOK(~V, $SH, key, H.pop_hit(&2, V, n, $MK, td, fresh, sz, sdU, free, AR.thaw(U32, tabT), AR.thaw(String, K2), AR.thaw(Maybe<&2, V>, vsT), AR.thaw(U32, nxT), U32.from_nat(e), 0, $W, U32.is_eq(0, 0))):
  +kl = $KL
  +pkT = ST.g_cpk($GF)
  +hgT = L.subst(Bool, b => {ST.goodF(~V, n, k, td, fresh, sz, sd, sdU, free, tabT, kl, b, vsT, nxT) $TT, AR.perfect(String, sd, ksT), True{}, pkT, hg)
  +g2 = L.subst(List<&2, String>, z => {ST.goodF(~V, n, k, td, fresh, sz, sd, sdU, free, tabT, z, AR.perfect(String, sd, K2), vsT, nxT) $TT, kl, AR.slots(String, K2), Equal.sym(List<&2, String>, AR.slots(String, K2), kl, hsl2), L.subst(Bool, b => {ST.goodF(~V, n, k, td, fresh, sz, sd, sdU, free, tabT, kl, b, vsT, nxT) $TT, True{}, AR.perfect(String, sd, K2), Equal.sym(Bool, AR.perfect(String, sd, K2), True{}, pk2), hgT))
  +m2 = Equal.cong(List<&2, String>, List<&2, S.Entry<V>>, z => ST.absm(~V, TB.buckets($TBL, z, $NN), $VSL, $NN, 0n), AR.slots(String, K2), kl, hsl2)
  +enone = LK.lookup_none(~V, $O, $VSL, key, $NN, hno)
  +erm = SL.remove_none(~V, $M0, key, enone)
  +mr = Equal.trans(List<&2, S.Entry<V>>, ST.model(~V, $SHK), $M0, S.remove(~V, $M0, key), m2, Equal.sym(List<&2, S.Entry<V>>, S.remove(~V, $M0, key), $M0, erm))
  ($SHK, (Equal.cong(Maybe<&2, V>, $PT, x => (ST.real(~V, $SHK), x), None{}, S.lookup(~V, $M0, key), Equal.sym(Maybe<&2, V>, S.lookup(~V, $M0, key), None{}, enone)), (g2, (q => Equal.cong(List<&2, S.Entry<V>>, Maybe<&2, V>, z => S.lookup(~V, z, q), ST.model(~V, $SHK), S.remove(~V, $M0, key), mr), Equal.cong(List<&2, S.Entry<V>>, Nat, z => S.size(~V, z), ST.model(~V, $SHK), S.remove(~V, $M0, key), mr)))))

# ---- pop and del ----

%def POPF H.pop_f(&2, V, n, $MK, td, fresh, sz, sdU, free, AR.thaw(Maybe<&2, V>, vsT), AR.thaw(U32, nxT), (PI.fd_of(r, AR.thaw(U32, tabT), AR.thaw(String, K2), PA.stored(key)), $W))
%def HOME UD.v(HS.bucket($W, $MK))

def pop_r(~V: Data, +one: Nat, +h1: {one == 1n : Nat}, $FP, +hg: {ST.good(~V, $SH) $TT, +key: String, +K2: AR.Tree<String>, +hsl2: {AR.slots(String, K2) == $KL : List<&2, String>}, +pk2: {AR.perfect(String, sd, K2) $TT, +r: B.Res, hres: B.ResOK($O, $NN, $HOME, key, r)) -> PopOK(~V, $SH, key, $POPF):
  match r:
    case B.RHit{+i, +l}:
      (+hi, rest) = hres
      (+hk, hl) = rest
      pop_hit_ok(~V, one, h1, $FLD, hg, key, K2, hsl2, pk2, i, l, hi, hk, hl)
    case B.REnd{+e}:
      (he, rest) = hres
      (hz, rest2) = rest
      (hp, hno) = rest2
      pop_absent_ok(~V, $FLD, hg, key, K2, hsl2, pk2, e, hno)

def pop_po(~V: Data, +one: Nat, +h1: {one == 1n : Nat}, $FP, +hg: {ST.good(~V, $SH) $TT, +key: String, +r: B.Res, hres: B.ResOK($O, $NN, $HOME, key, r), po: PA.ProbeOK(tabT, sd, $KL, PA.stored(key), $W, r, H.probe(AR.thaw(U32, tabT), AR.thaw(String, ksT), $MK, key))) -> PopOK(~V, $SH, key, H.pop(&2, V, ST.real(~V, $SH), key)):
  match po:
    case Tuple{+K2, Tuple{+e, rest}}:
      (+hsl2, pk2) = rest
      +eq = Equal.cong(H.Found & U32, $PT, pr => H.pop_f(&2, V, n, $MK, td, fresh, sz, sdU, free, AR.thaw(Maybe<&2, V>, vsT), AR.thaw(U32, nxT), pr), H.probe(AR.thaw(U32, tabT), AR.thaw(String, ksT), $MK, key), (PI.fd_of(r, AR.thaw(U32, tabT), AR.thaw(String, K2), PA.stored(key)), $W), e)
      L.subst($PT, rr => PopOK(~V, $SH, key, rr), $POPF, H.pop(&2, V, ST.real(~V, $SH), key), Equal.sym($PT, H.pop(&2, V, ST.real(~V, $SH), key), $POPF, eq), pop_r(~V, one, h1, $FLD, hg, key, K2, hsl2, pk2, r, hres))

%def RR B.pf(key, $O, $NN, $NN, B.mstep(key, B.at($O, $HOME)), $HOME)

# THEOREM: pop returns the specification's lookup and leaves its remove
def pop_ok(~V: Data, +sh: ST.Sh<V>, +hg: {ST.good(~V, sh) $TT, +key: String) -> PopOK(~V, sh, key, H.pop(&2, V, ST.real(~V, sh), key)):
  match sh:
    case ST.HS{+n, +k, +td, +fresh, +sz, +sd, +sdU, +free, +tabT, +ksT, +vsT, +nxT}:
      +kl = $KL
      +pk = AR.perfect(String, sd, ksT)
      pop_po(~V, 1n, {==}, $FLD, hg, key, $RR, G.res_of(~V, n, k, td, fresh, sz, sd, sdU, free, tabT, kl, pk, vsT, nxT, hg, key), PA.probe_ok(1n, {==}, k, $HK31, tabT, ST.g_cpt($GF), sd, ST.g_csd($GF), kl, ksT, {==}, ST.g_cpk($GF), ST.g_cwell($GF), key))

def DelOK(~V: Data, +sh: ST.Sh<V>, +key: String, r: H.HashMap<&2, V>) -> Type:
  Sigma<&1, &1, ST.Sh<V>, sh2 => {r == ST.real(~V, sh2) : H.HashMap<&2, V>} & ({ST.good(~V, sh2) $TT & ((@+q: String -> {S.lookup(~V, ST.model(~V, sh2), q) == S.lookup(~V, S.remove(~V, ST.model(~V, sh), key), q) : Maybe<&2, V>}) & {S.size(~V, ST.model(~V, sh2)) == S.size(~V, S.remove(~V, ST.model(~V, sh), key)) : Nat}))>

def del_p(~V: Data, +sh: ST.Sh<V>, +key: String, po: PopOK(~V, sh, key, H.pop(&2, V, ST.real(~V, sh), key))) -> DelOK(~V, sh, key, H.del(&2, V, ST.real(~V, sh), key)):
  match po:
    case Tuple{+sh2, Tuple{+e, rest}}:
      (sh2, (Equal.cong($PT, H.HashMap<&2, V>, r => H.del_drop(&2, V, r), H.pop(&2, V, ST.real(~V, sh), key), (ST.real(~V, sh2), S.lookup(~V, ST.model(~V, sh), key)), e), rest))

# THEOREM: del leaves the specification's remove
def del_ok(~V: Data, +sh: ST.Sh<V>, +hg: {ST.good(~V, sh) $TT, +key: String) -> DelOK(~V, sh, key, H.del(&2, V, ST.real(~V, sh), key)):
  del_p(~V, sh, key, pop_ok(~V, sh, hg, key))
