%def W K.kword(key)
%def SK PA.stored(key)
%def AT U32.from_nat(e)
%def HOME UD.v(HS.bucket($W, CY.msk(k)))
%def M0 ST.absm(~V, $BS, $VSL, $NN, 0n)
%def OP ~V: Data, $O, +n: U32, +k: Nat, +td: U32, +fresh: U32, +sz: U32, +sd: Nat, +sdU: U32, +free: U32, +tabT: AR.Tree<U32>, +ksT: AR.Tree<String>, +vsT: AR.Tree<Maybe<&2, V>>, +nxT: AR.Tree<U32>, +hg: {ST.goodF(~V, n, k, td, fresh, sz, sd, sdU, free, tabT, $KL, AR.perfect(String, sd, ksT), vsT, nxT) $TT, +key: String, +x: V, +e: Nat, +he: {Nat.is_lt(e, $NN) $TT, +hz: {B.at($BS, e) == B.BE{} : B.Bk}, +hp: {B.occpath($BS, $NN, $HOME, M.dist($NN, $HOME, e)) $TT, +hno: {B.all_lt(B.PNo{$BS, key}, $NN) $TT
%def OA ~V, one, h1, n, k, td, fresh, sz, sd, sdU, free, tabT, ksT, vsT, nxT, hg, key, x, e, he, hz, hp, hno
%def GF ~V, n, k, td, fresh, sz, sd, sdU, free, tabT, $KL, AR.perfect(String, sd, ksT), vsT, nxT, hg
%def OVER U32.is_gt(U32.shl(U32.inc(n)), U32.inc(CY.msk(k)))
%def CAP +cap: Nat, +hc30: {Nat.is_le(cap, 30n) $TT, +hcap: {Nat.is_le(Nat.double(1n+UD.v(n)), SC.pow2(cap)) $TT
%def CA cap, hc30, hcap
%def SDK2 L.subst(Bool, b => {Bool.or(b, $OVER) $TT, True{}, Nat.is_lt(sd, k), Equal.sym(Bool, Nat.is_lt(sd, k), True{}, ST.g_csdk($GF)), {==})
%def GC1 ST.g_csd($GF), N.lt_le(sd, k, ST.g_csdk($GF)), ST.g_cpt($GF), ST.g_cpk($GF), ST.g_cpv($GF), ST.g_cpn($GF), ST.g_ctd($GF), ST.g_csz($GF), ST.g_csdu($GF), ST.g_cwell($GF), ST.g_cuniq($GF), ST.g_cn($GF), ST.g_cload($GF)
%def OVI +hovi: {U32.is_gt(U32.shl(U32.inc(n)), U32.inc(CY.msk(k))) $FF
%def NEW H.ins_new(&2, V, n, CY.msk(k), td, fresh, sz, sdU, free, AR.thaw(U32, tabT), AR.thaw(String, ksT), AR.thaw(Maybe<&2, V>, vsT), AR.thaw(U32, nxT), $AT, $W, $SK, x
%def HK31 L.and_left(Nat.is_lt(k, 31n), Nat.is_lt(0n, k), ST.g_ck($GF))
%def HK0 L.and_right(Nat.is_lt(k, 31n), Nat.is_lt(0n, k), ST.g_ck($GF))
%def CMN ST.g_csd($GF), ST.g_csdk($GF), ST.g_cpt($GF), ST.g_cpk($GF), ST.g_cpv($GF), ST.g_cpn($GF), ST.g_ctd($GF), ST.g_csz($GF), ST.g_csdu($GF), ST.g_cwell($GF), ST.g_cclus($GF), ST.g_cuniq($GF), ST.g_cn($GF), ST.g_cload($GF)

def sz_pow($OP) -> {UD.v(sz) == SC.pow2(sd) : Nat}:
  N.eq_from_is_eq(UD.v(sz), SC.pow2(sd), ST.g_csz($GF))

def below_sd($OP, +t: Nat, +ht: {Nat.is_lt(t, UD.v(fresh)) $TT) -> {Nat.is_lt(t, SC.pow2(sd)) $TT:
  N.lt_le_trans(t, UD.v(fresh), SC.pow2(sd), ht, N.le_trans(UD.v(fresh), UD.v(sz), SC.pow2(sd), ST.g_cfresh($GF), N.eq_le(UD.v(sz), SC.pow2(sd), sz_pow($OA))))

# ---- the free list's head ----

%def SF UD.v(H.slot(f))

def fl_pop(+bs: List<&2, B.Bk>, +nb: Nat, +nxl: List<&2, U32>, +fr: Nat, +n: Nat, +f: U32, +hle: {Nat.is_le(n, fr) $TT, +hfl: {ST.fl_ok(bs, nb, nxl, Nat.sub(fr, n), f, fr, Nil{}) $TT, +hf: {U32.is_eq(f, 0) $FF) -> {Nat.is_le(1n+n, fr) $TT & ({ST.fl_ok(bs, nb, nxl, Nat.sub(fr, 1n+n), TB.nth0(nxl, $SF), fr, Con{$SF, Nil{}}) $TT & ({Nat.is_lt($SF, fr) $TT & {ST.noslot(bs, $SF, nb) $TT)):
  +p = L.sfst(Nat, q => {Nat.sub(fr, n) == 1n+q : Nat}, IF.cnt_pos(bs, nb, nxl, Nat.sub(fr, n), f, fr, Nil{}, hf, hfl))
  +hp = L.ssnd(Nat, q => {Nat.sub(fr, n) == 1n+q : Nat}, IF.cnt_pos(bs, nb, nxl, Nat.sub(fr, n), f, fr, Nil{}, hf, hfl))
  +h2 = L.subst(Nat, c => {ST.fl_ok(bs, nb, nxl, c, f, fr, Nil{}) $TT, Nat.sub(fr, n), 1n+p, hp, hfl)
  +x1 = Bool.not(U32.is_eq(f, 0))
  +y = Bool.and(Nat.is_lt($SF, fr), Bool.and(ST.noslot(bs, $SF, nb), Bool.not(ST.memn($SF, Nil{}))))
  +tl = ST.fl_ok(bs, nb, nxl, p, TB.nth0(nxl, $SF), fr, Con{$SF, Nil{}})
  +a2 = L.and_left(y, tl, L.and_right(x1, Bool.and(y, tl), h2))
  +a5 = L.and_right(y, tl, L.and_right(x1, Bool.and(y, tl), h2))
  +es = Pair.fst({Nat.sub(fr, 1n+n) == p : Nat}, {Nat.is_le(1n+n, fr) $TT, IF.sub_step(fr, n, p, hle, hp))
  +el = Pair.snd({Nat.sub(fr, 1n+n) == p : Nat}, {Nat.is_le(1n+n, fr) $TT, IF.sub_step(fr, n, p, hle, hp))
  +t2 = L.subst(Nat, c => {ST.fl_ok(bs, nb, nxl, c, TB.nth0(nxl, $SF), fr, Con{$SF, Nil{}}) $TT, p, Nat.sub(fr, 1n+n), Equal.sym(Nat, Nat.sub(fr, 1n+n), p, es), a5)
  +z = Bool.and(ST.noslot(bs, $SF, nb), Bool.not(ST.memn($SF, Nil{})))
  (el, (t2, (L.and_left(Nat.is_lt($SF, fr), z, a2), L.and_left(ST.noslot(bs, $SF, nb), Bool.not(ST.memn($SF, Nil{})), L.and_right(Nat.is_lt($SF, fr), z, a2)))))

%def FSL UD.v(H.slot(free))
%def P1 {Nat.is_le(1n+UD.v(n), UD.v(fresh)) $TT
%def P2 {ST.fl_ok($BS, $NN, $NXL, Nat.sub(UD.v(fresh), 1n+UD.v(n)), TB.nth0($NXL, $FSL), UD.v(fresh), Con{$FSL, Nil{}}) $TT
%def P3 {Nat.is_lt($FSL, UD.v(fresh)) $TT
%def P4 {ST.noslot($BS, $FSL, $NN) $TT
%def POPT fl_pop($BS, $NN, $NXL, UD.v(fresh), UD.v(n), free, hle, hfl0, hf)
%def INSF H.ins_slot(&2, V, n, CY.msk(k), td, fresh, sz, sdU, TB.nth0($NXL, $FSL), AR.thaw(U32, tabT), AR.thaw(String, ksT), AR.thaw(Maybe<&2, V>, vsT), AR.thaw(U32, nxT), H.slot(free), $AT, $W, $SK, x, U32.is_gt(U32.shl(U32.inc(n)), U32.inc(CY.msk(k))))

# THEOREM: taking the free list's head for the new entry refines set
def set_free($OP, +hf: {U32.is_eq(free, 0) $FF, $CAP) -> IS.SetM(~V, $M0, key, x, $NEW, False{})):
  +cf = ST.g_cfree($GF)
  +hle = L.and_left(Nat.is_le(UD.v(n), UD.v(fresh)), ST.fl_ok($BS, $NN, $NXL, Nat.sub(UD.v(fresh), UD.v(n)), free, UD.v(fresh), Nil{}), cf)
  +hfl0 = L.and_right(Nat.is_le(UD.v(n), UD.v(fresh)), ST.fl_ok($BS, $NN, $NXL, Nat.sub(UD.v(fresh), UD.v(n)), free, UD.v(fresh), Nil{}), cf)
  +hnf = Pair.fst($P1, $P2 & ($P3 & $P4), $POPT)
  +hfl = Pair.fst($P2, $P3 & $P4, Pair.snd($P1, $P2 & ($P3 & $P4), $POPT))
  +hs = Pair.fst($P3, $P4, Pair.snd($P2, $P3 & $P4, Pair.snd($P1, $P2 & ($P3 & $P4), $POPT)))
  +hns = Pair.snd($P3, $P4, Pair.snd($P2, $P3 & $P4, Pair.snd($P1, $P2 & ($P3 & $P4), $POPT)))
  +hsp = below_sd($OA, $FSL, hs)
  +gw = AX.getw(sd, nxT, H.slot(free), ST.g_csd($GF), hsp, ST.g_cpn($GF))
  +eq = Equal.cong(Array<U32> & U32, H.HashMap<&2, V>, r => H.ins_free(&2, V, n, CY.msk(k), td, fresh, sz, sdU, AR.thaw(U32, tabT), AR.thaw(String, ksT), AR.thaw(Maybe<&2, V>, vsT), H.slot(free), $AT, $W, $SK, x, r), Array.get(U32, AR.thaw(U32, nxT), H.slot(free)), (AR.thaw(U32, nxT), TB.nth0($NXL, $FSL)), gw)
  res = IG.ins_any(~V, one, h1, n, k, td, fresh, sz, sd, sdU, TB.nth0($NXL, $FSL), tabT, ksT, vsT, nxT, H.slot(free), e, key, x, $HK31, $HK0, $GC1, ST.g_clive($GF), ST.g_cfresh($GF), hnf, hfl, hs, hns, hno, ST.g_cclus($GF), $SDK2, he, hz, hp, $CA)
  L.subst(H.HashMap<&2, V>, r => IS.SetM(~V, $M0, key, x, r), $INSF, $NEW, False{}), Equal.sym(H.HashMap<&2, V>, $NEW, False{}), $INSF, eq), res)

# ---- a fresh slot ----

def live_all(+bs: List<&2, B.Bk>, +lv: List<&2, Bool>, +f: Nat, +f2: Nat, +hle: {Nat.is_le(f, f2) $TT, +n: Nat, +h: {B.all_lt(B.PLive{bs, lv, f}, n) $TT, +m: Nat, +hm: {Nat.is_le(m, n) $TT) -> {B.all_lt(B.PLive{bs, lv, f2}, m) $TT:
  match m:
    case 0n:
      {==}
    case 1n+q:
      +hq = N.succ_le_lt(q, n, hm)
      L.and_intro(B.live_b(lv, f2, B.at(bs, q)), B.all_lt(B.PLive{bs, lv, f2}, q), IM.live_mono(lv, f, f2, hle, B.at(bs, q), B.all_inst(B.PLive{bs, lv, f}, n, h, q, hq)), live_all(bs, lv, f, f2, hle, n, h, q, N.lt_le(q, n, hq)))

%def INSR H.ins_slot(&2, V, n, CY.msk(k), td, U32.inc(fresh), sz, sdU, 0, AR.thaw(U32, tabT), AR.thaw(String, ksT), AR.thaw(Maybe<&2, V>, vsT), AR.thaw(U32, nxT), fresh, $AT, $W, $SK, x, U32.is_gt(U32.shl(U32.inc(n)), U32.inc(CY.msk(k))))
%def VF UD.v(fresh)
%def VN UD.v(n)
%def VIF UD.v(U32.inc(fresh))

# with the free list empty, every slot below fresh is in use: fresh = n
def fresh_n($OP, +hf: {U32.is_eq(free, 0) $TT) -> {$VF == $VN : Nat}:
  +cf = ST.g_cfree($GF)
  +hle = L.and_left(Nat.is_le($VN, $VF), ST.fl_ok($BS, $NN, $NXL, Nat.sub($VF, $VN), free, $VF, Nil{}), cf)
  +hfl0 = L.subst(U32, f => {ST.fl_ok($BS, $NN, $NXL, Nat.sub($VF, $VN), f, $VF, Nil{}) $TT, free, 0, A.eq_of(free, 0, hf), L.and_right(Nat.is_le($VN, $VF), ST.fl_ok($BS, $NN, $NXL, Nat.sub($VF, $VN), free, $VF, Nil{}), cf))
  IF.sub_zero_eq($VF, $VN, hle, IF.cnt_zero($BS, $NN, $NXL, Nat.sub($VF, $VN), $VF, Nil{}, hfl0))

def inc_fresh($OP, +hsp: {Nat.is_lt($VF, SC.pow2(sd)) $TT) -> {$VIF == 1n+$VF : Nat}:
  CY.inc_val(one, h1, fresh, IU.bound32(one, h1, $VF, sd, N.lt_trans(sd, k, 31n, ST.g_csdk($GF), $HK31), hsp))

# THEOREM: taking the next fresh slot, when the arena has room, refines set
def set_room($OP, +hf: {U32.is_eq(free, 0) $TT, +hr: {U32.is_lt(fresh, sz) $TT, $CAP) -> IS.SetM(~V, $M0, key, x, $NEW, True{})):
  +efn = fresh_n($OA, hf)
  +hlt = Equal.trans(Bool, Nat.is_lt($VF, UD.v(sz)), U32.is_lt(fresh, sz), True{}, Equal.sym(Bool, U32.is_lt(fresh, sz), Nat.is_lt($VF, UD.v(sz)), U.is_lt_nat(fresh, sz)), hr)
  +hsp = N.lt_le_trans($VF, UD.v(sz), SC.pow2(sd), hlt, N.eq_le(UD.v(sz), SC.pow2(sd), sz_pow($OA)))
  +ei = inc_fresh($OA, hsp)
  +hfr = L.subst(Nat, z => {Nat.is_le(z, UD.v(sz)) $TT, 1n+$VF, $VIF, Equal.sym(Nat, $VIF, 1n+$VF, ei), N.lt_succ_le_succ($VF, UD.v(sz), hlt))
  +e1n = Equal.trans(Nat, $VIF, 1n+$VF, 1n+$VN, ei, Equal.cong(Nat, Nat, z => 1n+z, $VF, $VN, efn))
  +hnf = L.subst(Nat, z => {Nat.is_le(1n+$VN, z) $TT, 1n+$VN, $VIF, Equal.sym(Nat, $VIF, 1n+$VN, e1n), N.le_refl(1n+$VN))
  +hcnt = Equal.sym(Nat, Nat.sub($VIF, 1n+$VN), 0n, Equal.trans(Nat, Nat.sub($VIF, 1n+$VN), Nat.sub(1n+$VN, 1n+$VN), 0n, Equal.cong(Nat, Nat, z => Nat.sub(z, 1n+$VN), $VIF, 1n+$VN, e1n), N.sub_self($VN)))
  +hfl = L.subst(Nat, c => {ST.fl_ok($BS, $NN, $NXL, c, 0, $VIF, Con{$VF, Nil{}}) $TT, 0n, Nat.sub($VIF, 1n+$VN), hcnt, {==})
  +hs = L.subst(Nat, z => {Nat.is_lt($VF, z) $TT, 1n+$VF, $VIF, Equal.sym(Nat, $VIF, 1n+$VF, ei), N.lt_succ($VF))
  +hns = IF.noslot_live($BS, ST.lvs(~V, $VSL), $VF, $NN, ST.g_clive($GF), $NN, N.le_refl($NN))
  +hl = live_all($BS, ST.lvs(~V, $VSL), $VF, $VIF, N.lt_le($VF, $VIF, hs), $NN, ST.g_clive($GF), $NN, N.le_refl($NN))
  +eq = Equal.cong(Bool, H.HashMap<&2, V>, b => H.ins_fresh(&2, V, n, CY.msk(k), td, fresh, sz, sdU, AR.thaw(U32, tabT), AR.thaw(String, ksT), AR.thaw(Maybe<&2, V>, vsT), AR.thaw(U32, nxT), $AT, $W, $SK, x, b), U32.is_lt(fresh, sz), True{}, hr)
  res = IG.ins_any(~V, one, h1, n, k, td, U32.inc(fresh), sz, sd, sdU, 0, tabT, ksT, vsT, nxT, fresh, e, key, x, $HK31, $HK0, $GC1, hl, hfr, hnf, hfl, hs, hns, hno, ST.g_cclus($GF), $SDK2, he, hz, hp, $CA)
  L.subst(H.HashMap<&2, V>, r => IS.SetM(~V, $M0, key, x, r), $INSR, $NEW, True{}), Equal.sym(H.HashMap<&2, V>, $NEW, True{}), $INSR, eq), res)

# ---- growing the arena ----

%def RK AR.slots(String, AR.trep(String, sd, ""))
%def RV AR.slots(Maybe<&2, V>, AR.trep(Maybe<&2, V>, sd, None{}))
%def KST2 AR.TNode{ksT, AR.trep(String, sd, "")}
%def VST2 AR.TNode{vsT, AR.trep(Maybe<&2, V>, sd, None{})}
