# Choosing the new entry's slot: the head of the free list, or the next
# fresh slot when the arena has room.

%def TT == True{} : Bool}
%def FF == False{} : Bool}
%def O +one: Nat, +h1: {one == 1n : Nat}
%def KL AR.slots(String, ksT)
%def TBL AR.slots(U32, tabT)
%def VSL AR.slots(Maybe<&2, V>, vsT)
%def NXL AR.slots(U32, nxT)
%def NN SC.pow2(k)
