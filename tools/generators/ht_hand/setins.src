%def RAW H.ins_slot(&2, V, n, CY.msk(k), td, U32.inc(fresh), U32.shl(sz), U32.inc(sdU), 0, AR.thaw(U32, tabT), ANode{AR.thaw(String, ksT), Array.new(String, $SDU, "")}, ANode{AR.thaw(Maybe<&2, V>, vsT), H.vac(&2, V, $SDU)}, ANode{AR.thaw(U32, nxT), Array.new(U32, $SDU, 0)}, fresh, $AT, $W, $SK, x, U32.is_gt(U32.shl(U32.inc(n)), U32.inc(CY.msk(k))))
%def RAW1 H.ins_slot(&2, V, n, CY.msk(k), td, U32.inc(fresh), U32.shl(sz), U32.inc(sdU), 0, AR.thaw(U32, tabT), AR.thaw(String, $KST2), ANode{AR.thaw(Maybe<&2, V>, vsT), H.vac(&2, V, $SDU)}, ANode{AR.thaw(U32, nxT), Array.new(U32, $SDU, 0)}, fresh, $AT, $W, $SK, x, U32.is_gt(U32.shl(U32.inc(n)), U32.inc(CY.msk(k))))
%def RAW2 H.ins_slot(&2, V, n, CY.msk(k), td, U32.inc(fresh), U32.shl(sz), U32.inc(sdU), 0, AR.thaw(U32, tabT), AR.thaw(String, $KST2), AR.thaw(Maybe<&2, V>, $VST2), ANode{AR.thaw(U32, nxT), Array.new(U32, $SDU, 0)}, fresh, $AT, $W, $SK, x, U32.is_gt(U32.shl(U32.inc(n)), U32.inc(CY.msk(k))))
%def TO L.subst(List<&2, B.Bk>, z =>
%def FROM , $BS, $BS2, Equal.sym(List<&2, B.Bk>, $BS2, $BS, ebs($OA)),

def esdu($OP) -> {$SDU == sd : Nat}:
  N.eq_from_is_eq($SDU, sd, ST.g_csdu($GF))

def ebs($OP) -> {$BS2 == $BS : List<&2, B.Bk>}:
  AN.bs_app($TBL, $KL, $RK, sd, AR.slots_length(String, sd, ksT, ST.g_cpk($GF)), $NN, ST.g_cwell($GF))

