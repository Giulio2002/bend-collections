  +ev = Equal.cong(Array<Maybe<&2, V>>, Array<Maybe<&2, V>>, a => ANode{AR.thaw(Maybe<&2, V>, vsT), a}, H.vac(&2, V, $SDU), AR.thaw(Maybe<&2, V>, AR.trep(Maybe<&2, V>, sd, None{})), Equal.trans(Array<Maybe<&2, V>>, H.vac(&2, V, $SDU), H.vac(&2, V, sd), AR.thaw(Maybe<&2, V>, AR.trep(Maybe<&2, V>, sd, None{})), Equal.cong(Nat, Array<Maybe<&2, V>>, d => H.vac(&2, V, d), $SDU, sd, esdu($OA)), AN.vac_eq(~V, sd)))
