# the rehash loop invariant after moving old buckets 0 .. j - 1
def rinv(+OT: AR.Tree<U32>, +kl: List<&2, String>, +k: Nat, +sd: Nat, +NT: AR.Tree<U32>, +j: Nat) -> Bool:
  Bool.and(AR.perfect(U32, 2n+k, NT), Bool.and(B.cluster($NBS, $N2, CY.msk(1n+k)), Bool.and(B.all_lt(B.PWell{$NBS, sd}, $N2), Bool.and(B.all_lt(B.PUniq{$NBS}, $N2), Bool.and(Nat.is_eq(IV.occn($NBS, $N2), IV.occn($OBS, j)), Bool.and(B.all_lt(B.PFrom{$NBS, $OBS, j}, $N2), B.all_lt(B.PTo{$OBS, $NBS, $N2}, j)))))))

def r_1(+OT: AR.Tree<U32>, +kl: List<&2, String>, +k: Nat, +sd: Nat, +NT: AR.Tree<U32>, +j: Nat, +h: {rinv($RA) $TT) -> {AR.perfect(U32, 2n+k, NT) $TT:
  L.and_left(AR.perfect(U32, 2n+k, NT), Bool.and(B.cluster($NBS, $N2, CY.msk(1n+k)), Bool.and(B.all_lt(B.PWell{$NBS, sd}, $N2), Bool.and(B.all_lt(B.PUniq{$NBS}, $N2), Bool.and(Nat.is_eq(IV.occn($NBS, $N2), IV.occn($OBS, j)), Bool.and(B.all_lt(B.PFrom{$NBS, $OBS, j}, $N2), B.all_lt(B.PTo{$OBS, $NBS, $N2}, j)))))), h)

