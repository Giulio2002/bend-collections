def s_el($OH, $SP) -> {UD.v(U32.inc(U32.shl(kk))) == 1n+Nat.double(j) : Nat}:
  Equal.trans(Nat, UD.v(U32.inc(U32.shl(kk))), 1n+Nat.double(UD.v(kk)), 1n+Nat.double(j), AX.ix_l(kk, 1n+k, hk31, s_hh($OA, $SA)), Equal.cong(Nat, Nat, z => 1n+Nat.double(z), UD.v(kk), j, hkk))

def eqA($OH, $SP) -> {H.mv_step(kk, $MSK, $MVS) == H.mv_if(kk, AR.thaw(U32, OT), AR.thaw(U32, NT), $MSK, $OW, U32.is_eq($OW, 0)) : H.Mv}:
  +hi = L.subst(Nat, z => {Nat.is_lt(z, SC.pow2(1n+k)) $TT, Nat.double(j), UD.v(U32.shl(kk)), Equal.sym(Nat, UD.v(U32.shl(kk)), Nat.double(j), s_ew($OA, $SA)), N.lt_trans(Nat.double(j), 1n+Nat.double(j), SC.pow2(1n+k), N.lt_succ(Nat.double(j)), N.double_lt_bit(True{}, j, $N, hj)))
  +ga = AX.getw(1n+k, OT, U32.shl(kk), hk31, hi, pot)
  Equal.trans(H.Mv, H.mv_step(kk, $MSK, $MVS), H.mv_w(kk, AR.thaw(U32, NT), $MSK, (AR.thaw(U32, OT), W32.nth0($OTB, UD.v(U32.shl(kk))))), H.mv_if(kk, AR.thaw(U32, OT), AR.thaw(U32, NT), $MSK, $OW, U32.is_eq($OW, 0)), Equal.cong(Array<U32> & U32, H.Mv, r => H.mv_w(kk, AR.thaw(U32, NT), $MSK, r), Array.get(U32, AR.thaw(U32, OT), U32.shl(kk)), (AR.thaw(U32, OT), W32.nth0($OTB, UD.v(U32.shl(kk)))), ga), Equal.cong(Nat, H.Mv, z => H.mv_if(kk, AR.thaw(U32, OT), AR.thaw(U32, NT), $MSK, W32.nth0($OTB, z), U32.is_eq(W32.nth0($OTB, z), 0)), UD.v(U32.shl(kk)), Nat.double(j), s_ew($OA, $SA)))

def eqB($OH, $SP) -> {H.mv_if(kk, AR.thaw(U32, OT), AR.thaw(U32, NT), $MSK, $OW, False{}) == H.MV{AR.thaw(U32, OT), H.ins_raw(AR.thaw(U32, NT), $MSK, $OW, $OL)} : H.Mv}:
  +hi = L.subst(Nat, z => {Nat.is_lt(z, SC.pow2(1n+k)) $TT, 1n+Nat.double(j), UD.v(U32.inc(U32.shl(kk))), Equal.sym(Nat, UD.v(U32.inc(U32.shl(kk))), 1n+Nat.double(j), s_el($OA, $SA)), N.double_lt_bit(True{}, j, $N, hj))
  +gb = AX.getw(1n+k, OT, U32.inc(U32.shl(kk)), hk31, hi, pot)
  Equal.trans(H.Mv, H.mv_l($OW, AR.thaw(U32, NT), $MSK, Array.get(U32, AR.thaw(U32, OT), U32.inc(U32.shl(kk)))), H.mv_l($OW, AR.thaw(U32, NT), $MSK, (AR.thaw(U32, OT), W32.nth0($OTB, UD.v(U32.inc(U32.shl(kk)))))), H.MV{AR.thaw(U32, OT), H.ins_raw(AR.thaw(U32, NT), $MSK, $OW, $OL)}, Equal.cong(Array<U32> & U32, H.Mv, r => H.mv_l($OW, AR.thaw(U32, NT), $MSK, r), Array.get(U32, AR.thaw(U32, OT), U32.inc(U32.shl(kk))), (AR.thaw(U32, OT), W32.nth0($OTB, UD.v(U32.inc(U32.shl(kk))))), gb), Equal.cong(Nat, H.Mv, z => H.MV{AR.thaw(U32, OT), H.ins_raw(AR.thaw(U32, NT), $MSK, $OW, W32.nth0($OTB, z))}, UD.v(U32.inc(U32.shl(kk))), 1n+Nat.double(j), s_el($OA, $SA)))

def s_occ($OH, $SP) -> {B.occ(B.at($OBS, j)) == Bool.not(U32.is_eq($OW, 0)) : Bool}:
  RI.occ_flag($OTB, kl, $N, j, hj)

# an empty old bucket: nothing moves
def step_skip($OH, $SP, +hc: {U32.is_eq($OW, 0) $TT) -> StepOK(OT, kl, k, sd, j, kk, NT):
  +ho = Equal.trans(Bool, B.occ(B.at($OBS, j)), Bool.not(U32.is_eq($OW, 0)), False{}, s_occ($OA, $SA), Equal.cong(Bool, Bool, b => Bool.not(b), U32.is_eq($OW, 0), True{}, hc))
  +e5 = Equal.trans(Nat, IV.occn($NBS, $N2), IV.occn($OBS, j), IV.occn($OBS, 1n+j), N.eq_from_is_eq(IV.occn($NBS, $N2), IV.occn($OBS, j), r_5($RA, hr)), Equal.cong(Bool, Nat, o => Nat.add(IV.bitv(o), IV.occn($OBS, j)), False{}, B.occ(B.at($OBS, j)), Equal.sym(Bool, B.occ(B.at($OBS, j)), False{}, ho)))
  +eq = Equal.trans(H.Mv, H.mv_step(kk, $MSK, $MVS), H.mv_if(kk, AR.thaw(U32, OT), AR.thaw(U32, NT), $MSK, $OW, U32.is_eq($OW, 0)), $MVS, eqA($OA, $SA), Equal.cong(Bool, H.Mv, c => H.mv_if(kk, AR.thaw(U32, OT), AR.thaw(U32, NT), $MSK, $OW, c), U32.is_eq($OW, 0), True{}, hc))
  (NT, (eq, r_mk(OT, kl, k, sd, NT, 1n+j, r_1($RA, hr), r_2($RA, hr), r_3($RA, hr), r_4($RA, hr), IS.eq_is_eq(IV.occn($NBS, $N2), IV.occn($OBS, 1n+j), e5), RH.from_skip($NBS, $OBS, j, $N2, r_6($RA, hr), $N2, N.le_refl($N2)), RH.to_skip($OBS, $NBS, j, $N2, ho, r_7($RA, hr)))))

%def HM UD.v(HS.bucket($OW, $MSK))
%def TPX AR.upd(U32, 2n+k, AR.upd(U32, 2n+k, NT, UD.v(U32.shl(U32.from_nat(e))), $OW), UD.v(U32.inc(U32.shl(U32.from_nat(e)))), $OL)
%def BUx IM.bupd($NBS, e, $NBO)
%def NB2 TB.buckets(AR.slots(U32, $TPX), kl, $N2)
%def HC +hc: {U32.is_eq($OW, 0) $FF
%def PNO +pno: {B.all_lt(B.PNo{$NBS, $KB}, $N2) $TT, +nsl: {ST.noslot($NBS, UD.v(H.slot($OL)), $N2) $TT
%def TOB L.subst(List<&2, B.Bk>, z =>
%def FRB , $BUx, $NB2, Equal.sym(List<&2, B.Bk>, $NB2, $BUx, bse),

def s_hb($OH, $SP, $HC) -> {B.at($OBS, j) == $NBO : B.Bk}:
  Equal.trans(B.Bk, B.at($OBS, j), TB.dec($OTB, kl, j), $NBO, TB.at_buckets($OTB, kl, $N, j, hj), Equal.cong(Bool, B.Bk, c => TB.dec_c($OW, $OL, kl, c), U32.is_eq($OW, 0), False{}, hc))

def step_e($OH, $SP, $HC, $PNO, fe: RI.FirstE($NBS, $N2, $HM)) -> StepOK(OT, kl, k, sd, j, kk, NT):
  match fe:
    case Tuple{+e, Tuple{+he, Tuple{+hz, hp0}}}:
      +hp = {hp0 : {B.occpath($NBS, $N2, $HM, M.dist($N2, $HM, e)) $TT}
      +hb = s_hb($OA, $SA, hc)
      +hwb = L.subst(B.Bk, y => {B.wb(sd, y) $TT, B.at($OBS, j), $NBO, hb, B.all_inst(B.PWell{$OBS, sd}, $N, hwo, j, hj))
      +hkl = L.subst(Nat, z => {Nat.is_lt(UD.v(H.slot($OL)), z) $TT, SC.pow2(sd), SC.length(String, kl), Equal.sym(Nat, SC.length(String, kl), SC.pow2(sd), hlen), L.and_left(Nat.is_lt(UD.v(H.slot($OL)), SC.pow2(sd)), Bool.and(U32.is_eq($OW, K.kword($KB)), Bool.not(U32.is_eq($OL, 0))), hwb))
      +rw = RI.raw_ok(one, h1, 1n+k, hk30, NT, r_1($RA, hr), kl, $OW, $OL, e, he, hz, hp)
      +pe = put_eq(1n+k, hk30, NT, r_1($RA, hr), e, he, $OW, $OL)
      +eq = Equal.trans(H.Mv, H.mv_step(kk, $MSK, $MVS), H.mv_if(kk, AR.thaw(U32, OT), AR.thaw(U32, NT), $MSK, $OW, U32.is_eq($OW, 0)), H.MV{AR.thaw(U32, OT), AR.thaw(U32, $TPX)}, eqA($OA, $SA), Equal.trans(H.Mv, H.mv_if(kk, AR.thaw(U32, OT), AR.thaw(U32, NT), $MSK, $OW, U32.is_eq($OW, 0)), H.mv_if(kk, AR.thaw(U32, OT), AR.thaw(U32, NT), $MSK, $OW, False{}), H.MV{AR.thaw(U32, OT), AR.thaw(U32, $TPX)}, Equal.cong(Bool, H.Mv, c => H.mv_if(kk, AR.thaw(U32, OT), AR.thaw(U32, NT), $MSK, $OW, c), U32.is_eq($OW, 0), False{}, hc), Equal.trans(H.Mv, H.mv_if(kk, AR.thaw(U32, OT), AR.thaw(U32, NT), $MSK, $OW, False{}), H.MV{AR.thaw(U32, OT), H.ins_raw(AR.thaw(U32, NT), $MSK, $OW, $OL)}, H.MV{AR.thaw(U32, OT), AR.thaw(U32, $TPX)}, eqB($OA, $SA), Equal.cong(Array<U32>, H.Mv, a => H.MV{AR.thaw(U32, OT), a}, H.ins_raw(AR.thaw(U32, NT), $MSK, $OW, $OL), AR.thaw(U32, $TPX), Equal.trans(Array<U32>, H.ins_raw(AR.thaw(U32, NT), $MSK, $OW, $OL), H.put_bucket(AR.thaw(U32, NT), U32.from_nat(e), $OW, $OL), AR.thaw(U32, $TPX), rw, pe)))))
      +bse = put_bs(1n+k, hk30, NT, r_1($RA, hr), e, he, $OW, $OL, kl, $N2, nsl, hc, hkl)
      +hel = L.subst(Nat, z => {Nat.is_lt(e, z) $TT, $N2, SC.length(B.Bk, $NBS), Equal.sym(Nat, SC.length(B.Bk, $NBS), $N2, IA.len_dlist(AR.slots(U32, NT), kl, $N2, 0n)), he)
      +e5 = Equal.trans(Nat, IV.occn($BUx, $N2), 1n+IV.occn($NBS, $N2), IV.occn($OBS, 1n+j), IM.occn_up($NBS, e, $NBO, {==}, hel, hz, $N2, he), Equal.trans(Nat, 1n+IV.occn($NBS, $N2), 1n+IV.occn($OBS, j), IV.occn($OBS, 1n+j), Equal.cong(Nat, Nat, z => 1n+z, IV.occn($NBS, $N2), IV.occn($OBS, j), N.eq_from_is_eq(IV.occn($NBS, $N2), IV.occn($OBS, j), r_5($RA, hr))), Equal.sym(Nat, IV.occn($OBS, 1n+j), 1n+IV.occn($OBS, j), Equal.cong(B.Bk, Nat, y => Nat.add(IV.bitv(B.occ(y)), IV.occn($OBS, j)), B.at($OBS, j), $NBO, hb))))
