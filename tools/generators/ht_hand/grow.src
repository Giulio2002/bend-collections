      ($TPX, (eq, r_mk(OT, kl, k, sd, $TPX, 1n+j, put_perf(1n+k, hk30, NT, r_1($RA, hr), e, he, $OW, $OL), c2, c3, c4, c5, c6, c7)))

# a full old bucket: it moves to the first empty bucket of its path
def step_mv($OH, $SP, $HC) -> StepOK(OT, kl, k, sd, j, kk, NT):
  +hb = s_hb($OA, $SA, hc)
  +hu = L.subst(B.Bk, y => {B.uq_b($OBS, j, y) $TT, B.at($OBS, j), $NBO, hb, B.all_inst(B.PUniq{$OBS}, $N, huo, j, hj))
  +nohb = L.and_left(B.nohb($OBS, $KB, j), B.nolb($OBS, $OL, j), hu)
  +nolb = L.and_right(B.nohb($OBS, $KB, j), B.nolb($OBS, $OL, j), hu)
  +pno = RH.pno_from($NBS, $OBS, j, $N2, r_6($RA, hr), $KB, nohb, $N2, N.le_refl($N2))
  +nsl = RH.ns_from($NBS, $OBS, j, $N2, r_6($RA, hr), UD.v(H.slot($OL)), RH.noslot_nolb($OBS, $OL, j, nolb), $N2, N.le_refl($N2))
  +ol = N.le_trans(IV.occn($OBS, j), IV.occn($OBS, $N), $N, hoc, N.le_trans(IV.occn($OBS, $N), Nat.double(IV.occn($OBS, $N)), $N, N.double_self_le(IV.occn($OBS, $N)), hld))
  +hem = L.subst(Nat, z => {Nat.is_lt(z, $N2) $TT, IV.occn($OBS, j), IV.occn($NBS, $N2), Equal.sym(Nat, IV.occn($NBS, $N2), IV.occn($OBS, j), N.eq_from_is_eq(IV.occn($NBS, $N2), IV.occn($OBS, j), r_5($RA, hr))), N.le_lt_trans(IV.occn($OBS, j), $N, $N2, ol, N.pow2_lt_succ(k)))
  step_e($OA, $SA, hc, pno, nsl, RI.find_e($NBS, $N2, N.succ_le_lt(0n, $N2, N.pow2_pos(1n+k)), $MSK, $KB, $HM, PA.home_lt($OW, 1n+k), r_2($RA, hr), pno, hem))

def step_c($OH, $SP, +c: Bool, +hc: {U32.is_eq($OW, 0) == c : Bool}) -> StepOK(OT, kl, k, sd, j, kk, NT):
  match c:
    case True{}:
      step_skip($OA, $SA, hc)
    case False{}:
      step_mv($OA, $SA, hc)

# THEOREM: one step of the move loop keeps the loop invariant
def step($OH, $SP) -> StepOK(OT, kl, k, sd, j, kk, NT):
  step_c($OA, $SA, U32.is_eq($OW, 0), {==})

# ---- the loop ----

def occn_le(+bs: List<&2, B.Bk>, +j: Nat, +d: Nat) -> {Nat.is_le(IV.occn(bs, j), IV.occn(bs, Nat.add(j, d))) $TT:
  match d:
    case 0n:
      L.subst(Nat, z => {Nat.is_le(IV.occn(bs, j), IV.occn(bs, z)) $TT, j, Nat.add(j, 0n), Equal.sym(Nat, Nat.add(j, 0n), j, N.add_zero(j)), N.le_refl(IV.occn(bs, j)))
    case 1n+q:
      +x = IV.occn(bs, Nat.add(j, q))
      +b = IV.bitv(B.occ(B.at(bs, Nat.add(j, q))))
      +h1 = N.le_trans(IV.occn(bs, j), x, Nat.add(b, x), occn_le(bs, j, q), L.subst(Nat, z => {Nat.is_le(x, z) $TT, Nat.add(x, b), Nat.add(b, x), N.add_comm(x, b), N.le_add_right(x, b)))
      L.subst(Nat, z => {Nat.is_le(IV.occn(bs, j), IV.occn(bs, z)) $TT, 1n+Nat.add(j, q), Nat.add(j, 1n+q), Equal.sym(Nat, Nat.add(j, 1n+q), 1n+Nat.add(j, q), N.add_succ(j, q)), h1)

def LoopOK(+OT: AR.Tree<U32>, +kl: List<&2, String>, +k: Nat, +sd: Nat, +f: Nat, +kk: U32, +NT: AR.Tree<U32>) -> Type:
  Sigma<&1, &1, AR.Tree<U32>, T2 => {H.mv_go(f, kk, $MSK, $MVS) == H.MV{AR.thaw(U32, OT), AR.thaw(U32, T2)} : H.Mv} & {rinv(OT, kl, k, sd, T2, $N) $TT>

def loop_s2($OH, +p: Nat, +kk: U32, +NT: AR.Tree<U32>, +T2: AR.Tree<U32>, +e1: {H.mv_step(kk, $MSK, $MVS) == H.MV{AR.thaw(U32, OT), AR.thaw(U32, T2)} : H.Mv}, lo: LoopOK(OT, kl, k, sd, p, U32.inc(kk), T2)) -> LoopOK(OT, kl, k, sd, 1n+p, kk, NT):
  match lo:
    case Tuple{+T3, Tuple{+e2, +hr3}}:
      (T3, (Equal.trans(H.Mv, H.mv_go(1n+p, kk, $MSK, $MVS), H.mv_go(p, U32.inc(kk), $MSK, H.MV{AR.thaw(U32, OT), AR.thaw(U32, T2)}), H.MV{AR.thaw(U32, OT), AR.thaw(U32, T3)}, Equal.cong(H.Mv, H.Mv, m => H.mv_go(p, U32.inc(kk), $MSK, m), H.mv_step(kk, $MSK, $MVS), H.MV{AR.thaw(U32, OT), AR.thaw(U32, T2)}, e1), e2), hr3))

def loop_s($OH, +p: Nat, +j: Nat, +kk: U32, +NT: AR.Tree<U32>, st: StepOK(OT, kl, k, sd, j, kk, NT), rec: @+T2: AR.Tree<U32> -> @+hr2: {rinv(OT, kl, k, sd, T2, 1n+j) $TT -> LoopOK(OT, kl, k, sd, p, U32.inc(kk), T2)) -> LoopOK(OT, kl, k, sd, 1n+p, kk, NT):
  match st:
    case Tuple{+T2, Tuple{+e1, +hr2}}:
      loop_s2($OA, p, kk, NT, T2, e1, rec(T2, hr2))

# THEOREM: the loop moves the remaining old buckets keeping the invariant
def loop($OH, +f: Nat, +j: Nat, +hjf: {Nat.add(j, f) == $N : Nat}, +kk: U32, +hkk: {UD.v(kk) == j : Nat}, +NT: AR.Tree<U32>, +hr: {rinv($RA) $TT) -> LoopOK(OT, kl, k, sd, f, kk, NT):
  match f:
    case 0n:
      +ej = Equal.trans(Nat, j, Nat.add(j, 0n), $N, Equal.sym(Nat, Nat.add(j, 0n), j, N.add_zero(j)), hjf)
      (NT, ({==}, L.subst(Nat, z => {rinv(OT, kl, k, sd, NT, z) $TT, j, $N, ej, hr)))
    case 1n+p:
      +hN = Equal.trans(Nat, 1n+Nat.add(j, p), Nat.add(j, 1n+p), $N, Equal.sym(Nat, Nat.add(j, 1n+p), 1n+Nat.add(j, p), N.add_succ(j, p)), hjf)
      +hj = L.subst(Nat, z => {Nat.is_lt(j, z) $TT, 1n+Nat.add(j, p), $N, hN, N.le_lt_succ(j, Nat.add(j, p), N.le_add_right(j, p)))
      +hoc = L.subst(Nat, z => {Nat.is_le(IV.occn($OBS, j), IV.occn($OBS, z)) $TT, Nat.add(j, 1n+p), $N, hjf, occn_le($OBS, j, 1n+p))
      +hb = L.subst(Nat, z => {Nat.is_lt(z, $N) $TT, j, UD.v(kk), Equal.sym(Nat, UD.v(kk), j, hkk), hj)
      +hk2 = Equal.trans(Nat, UD.v(U32.inc(kk)), 1n+UD.v(kk), 1n+j, W32.inc_val(one, h1, kk, W32.bound32(one, h1, UD.v(kk), k, hk31, hb)), Equal.cong(Nat, Nat, z => 1n+z, UD.v(kk), j, hkk))
      +hjf2 = Equal.trans(Nat, Nat.add(1n+j, p), 1n+Nat.add(j, p), $N, {==}, hN)
      loop_s($OA, p, j, kk, NT, step($OA, j, hj, hoc, kk, hkk, NT, hr), T2 => hr2 => loop($OA, p, 1n+j, hjf2, U32.inc(kk), hk2, T2, hr2))

%def Z AR.trep(U32, 2n+k, 0)
%def ZB2 TB.buckets(AR.slots(U32, $Z), kl, $N2)

def GrowOK(+OT: AR.Tree<U32>, +kl: List<&2, String>, +k: Nat, +sd: Nat, +td: U32) -> Type:
  Sigma<&1, &1, AR.Tree<U32>, T2 => {H.grow_tab(CY.msk(k), td, AR.thaw(U32, OT)) == AR.thaw(U32, T2) : Array<U32>} & {rinv(OT, kl, k, sd, T2, $N) $TT>

def grow_fin(+OT: AR.Tree<U32>, +kl: List<&2, String>, +k: Nat, +sd: Nat, +td: U32, +e0: {H.grow_tab(CY.msk(k), td, AR.thaw(U32, OT)) == H.mv_fin(H.mv_go($N, 0, $MSK, H.MV{AR.thaw(U32, OT), AR.thaw(U32, $Z)})) : Array<U32>}, lo: LoopOK(OT, kl, k, sd, $N, 0, $Z)) -> GrowOK(OT, kl, k, sd, td):
  match lo:
    case Tuple{+T2, Tuple{+e1, +hr}}:
      (T2, (Equal.trans(Array<U32>, H.grow_tab(CY.msk(k), td, AR.thaw(U32, OT)), H.mv_fin(H.mv_go($N, 0, $MSK, H.MV{AR.thaw(U32, OT), AR.thaw(U32, $Z)})), AR.thaw(U32, T2), e0, Equal.cong(H.Mv, Array<U32>, m => H.mv_fin(m), H.mv_go($N, 0, $MSK, H.MV{AR.thaw(U32, OT), AR.thaw(U32, $Z)}), H.MV{AR.thaw(U32, OT), AR.thaw(U32, T2)}, e1)), hr))

# THEOREM: growing the table yields a table of twice the buckets holding a
# copy of every full old bucket and nothing else, with the table invariants
def grow_ok($OH, +td: U32, +htd: {UD.v(td) == 1n+k : Nat}) -> GrowOK(OT, kl, k, sd, td):
  +htd5 = L.subst(Nat, z => {Nat.is_lt(z, SC.pow2(5n)) $TT, 1n+k, UD.v(td), Equal.sym(Nat, UD.v(td), 1n+k, htd), N.lt_trans(1n+k, 31n, 32n, hk30, {==}))
  +etd = Equal.trans(Nat, UD.v(U32.inc(td)), 1n+UD.v(td), 2n+k, W32.inc_val(one, h1, td, W32.bound32(one, h1, UD.v(td), 5n, {==}, htd5)), Equal.cong(Nat, Nat, z => 1n+z, UD.v(td), 1n+k, htd))
  +ea = Equal.trans(Array<U32>, Array.new(U32, UD.v(U32.inc(td)), 0), Array.new(U32, 2n+k, 0), AR.thaw(U32, $Z), Equal.cong(Nat, Array<U32>, d => Array.new(U32, d, 0), UD.v(U32.inc(td)), 2n+k, etd), AR.new(U32, 2n+k, 0))
  +e0 = Equal.trans(Array<U32>, H.grow_tab(CY.msk(k), td, AR.thaw(U32, OT)), H.mv_fin(H.mv_go($N, 0, U32.inc(U32.shl(CY.msk(k))), H.MV{AR.thaw(U32, OT), Array.new(U32, UD.v(U32.inc(td)), 0)})), H.mv_fin(H.mv_go($N, 0, $MSK, H.MV{AR.thaw(U32, OT), AR.thaw(U32, $Z)})), Equal.cong(Nat, Array<U32>, f => H.mv_fin(H.mv_go(f, 0, U32.inc(U32.shl(CY.msk(k))), H.MV{AR.thaw(U32, OT), Array.new(U32, UD.v(U32.inc(td)), 0)})), UD.v(U32.inc(CY.msk(k))), $N, PA.fuel_eq(one, h1, k, hk31)), Equal.trans(Array<U32>, H.mv_fin(H.mv_go($N, 0, U32.inc(U32.shl(CY.msk(k))), H.MV{AR.thaw(U32, OT), Array.new(U32, UD.v(U32.inc(td)), 0)})), H.mv_fin(H.mv_go($N, 0, $MSK, H.MV{AR.thaw(U32, OT), Array.new(U32, UD.v(U32.inc(td)), 0)})), H.mv_fin(H.mv_go($N, 0, $MSK, H.MV{AR.thaw(U32, OT), AR.thaw(U32, $Z)})), Equal.cong(U32, Array<U32>, m => H.mv_fin(H.mv_go($N, 0, m, H.MV{AR.thaw(U32, OT), Array.new(U32, UD.v(U32.inc(td)), 0)})), U32.inc(U32.shl(CY.msk(k))), $MSK, msk_up(one, h1, k, hk31)), Equal.cong(Array<U32>, Array<U32>, a => H.mv_fin(H.mv_go($N, 0, $MSK, H.MV{AR.thaw(U32, OT), a})), Array.new(U32, UD.v(U32.inc(td)), 0), AR.thaw(U32, $Z), ea)))
  +h0 = r_mk(OT, kl, k, sd, $Z, 0n, AR.trep_perfect(U32, 2n+k, 0), z_clus(2n+k, kl, $N2, $MSK, $N2, N.le_refl($N2)), z_well(2n+k, kl, $N2, sd, $N2, N.le_refl($N2)), z_uniq(2n+k, kl, $N2, $N2, N.le_refl($N2)), IS.eq_is_eq(IV.occn($ZB2, $N2), 0n, z_occn(2n+k, kl, $N2, $N2, N.le_refl($N2))), z_from(2n+k, kl, $N2, $OBS, 0n, $N2, N.le_refl($N2)), {==})
  grow_fin(OT, kl, k, sd, td, e0, loop($OA, $N, 0n, {==}, 0, {==}, $Z, h0))
