  L.and_left(B.cluster($NBS, $N2, CY.msk(1n+k)), Bool.and(B.all_lt(B.PWell{$NBS, sd}, $N2), Bool.and(B.all_lt(B.PUniq{$NBS}, $N2), Bool.and(Nat.is_eq(IV.occn($NBS, $N2), IV.occn($OBS, j)), Bool.and(B.all_lt(B.PFrom{$NBS, $OBS, j}, $N2), B.all_lt(B.PTo{$OBS, $NBS, $N2}, j))))), L.and_right(AR.perfect(U32, 2n+k, NT), Bool.and(B.cluster($NBS, $N2, CY.msk(1n+k)), Bool.and(B.all_lt(B.PWell{$NBS, sd}, $N2), Bool.and(B.all_lt(B.PUniq{$NBS}, $N2), Bool.and(Nat.is_eq(IV.occn($NBS, $N2), IV.occn($OBS, j)), Bool.and(B.all_lt(B.PFrom{$NBS, $OBS, j}, $N2), B.all_lt(B.PTo{$OBS, $NBS, $N2}, j)))))), h))

