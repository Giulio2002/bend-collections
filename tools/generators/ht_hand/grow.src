    case 1n+q:
      +hq = N.succ_le_lt(q, n, hm)
      L.and_intro(B.eval(B.PClus{$ZB, n, mask}, q), B.all_lt(B.PClus{$ZB, n, mask}, q), L.subst(B.Bk, x => {B.implies(B.occ(x), B.occpath($ZB, n, B.hb(mask, x), M.dist(n, B.hb(mask, x), q))) $TT, B.BE{}, B.at($ZB, q), Equal.sym(B.Bk, B.at($ZB, q), B.BE{}, at_z(d, kl, n, q, hq)), {==}), z_clus(d, kl, n, mask, q, N.lt_le(q, n, hq)))

def z_well(+d: Nat, +kl: List<&2, String>, +n: Nat, +sd: Nat, +m: Nat, +hm: {Nat.is_le(m, n) $TT) -> {B.all_lt(B.PWell{$ZB, sd}, m) $TT:
