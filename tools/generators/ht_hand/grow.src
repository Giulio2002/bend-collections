# Growing the table: grow_tab moves every full old bucket into a table of
# twice the buckets; the result holds copies of exactly the old buckets and
# keeps the table invariants.

%def TT == True{} : Bool}
%def FF == False{} : Bool}
%def O +one: Nat, +h1: {one == 1n : Nat}
%def S32 WD.sc(32n, one)

def mskv(+k: Nat, +hk: {Nat.is_le(k, 32n) $TT) -> {Nat.add(UD.v(CY.msk(k)), 1n) == SC.pow2(k) : Nat}:
  Equal.trans(Nat, Nat.add(UD.v(CY.msk(k)), 1n), Nat.add(WD.uw(32n, WD.mask(32n, k)), 1n), SC.pow2(k), Equal.cong(Nat, Nat, z => Nat.add(z, 1n), UD.v(CY.msk(k)), WD.uw(32n, WD.mask(32n, k)), UD.vw(WD.mask(32n, k))), PA.mask_val(32n, k, hk))

%def V0 UD.v(CY.msk(k))
%def SH U32.shl(CY.msk(k))

# THEOREM: the grown mask is the mask of twice the buckets
def msk_up($O, +k: Nat, +hk: {Nat.is_lt(k, 31n) $TT) -> {U32.inc($SH) == CY.msk(1n+k) : U32}:
  +hk32 = N.lt_le(k, 32n, N.lt_trans(k, 31n, 32n, hk, {==}))
  +a0 = mskv(k, hk32)
  +v0lt = L.subst(Nat, z => {Nat.is_lt($V0, z) $TT, Nat.add($V0, 1n), SC.pow2(k), a0, L.subst(Nat, z => {Nat.is_lt($V0, z) $TT, 1n+$V0, Nat.add($V0, 1n), Equal.sym(Nat, Nat.add($V0, 1n), 1n+$V0, N.add_comm($V0, 1n)), N.lt_succ($V0)))
  +es = U.shl_value(CY.msk(k), 1n+k, N.lt_le(1n+k, 32n, hk), N.double_lt($V0, SC.pow2(k), v0lt))
  +hb = L.subst(Nat, z => {Nat.is_lt(1n+z, $S32) $TT, Nat.double($V0), UD.v($SH), Equal.sym(Nat, UD.v($SH), Nat.double($V0), es), N.lt_le_trans(1n+Nat.double($V0), SC.pow2(1n+k), $S32, N.double_lt_bit(True{}, $V0, SC.pow2(k), v0lt), W32.pow_le32(one, h1, 1n+k, hk)))
  +ei = Equal.trans(Nat, UD.v(U32.inc($SH)), 1n+UD.v($SH), 1n+Nat.double($V0), W32.inc_val(one, h1, $SH, hb), Equal.cong(Nat, Nat, z => 1n+z, UD.v($SH), Nat.double($V0), es))
  +a1 = mskv(1n+k, N.lt_le(1n+k, 32n, hk))
  +e2 = Equal.trans(Nat, Nat.add(UD.v(CY.msk(1n+k)), 1n), SC.pow2(1n+k), Nat.add(1n+Nat.double($V0), 1n), a1, Equal.trans(Nat, Nat.double(SC.pow2(k)), Nat.double(Nat.add($V0, 1n)), Nat.add(1n+Nat.double($V0), 1n), Equal.cong(Nat, Nat, z => Nat.double(z), SC.pow2(k), Nat.add($V0, 1n), Equal.sym(Nat, Nat.add($V0, 1n), SC.pow2(k), a0)), Equal.sym(Nat, Nat.add(1n+Nat.double($V0), 1n), Nat.double(Nat.add($V0, 1n)), PA.dbl_step($V0))))
  +e3 = A.add_cancel_r(UD.v(CY.msk(1n+k)), 1n+Nat.double($V0), 1n, e2)
  U.injective(U32.inc($SH), CY.msk(1n+k), Equal.trans(Nat, UD.v(U32.inc($SH)), 1n+Nat.double($V0), UD.v(CY.msk(1n+k)), ei, Equal.sym(Nat, UD.v(CY.msk(1n+k)), 1n+Nat.double($V0), e3)))

# ---- writing one bucket of a tree ----

%def AT U32.from_nat(e)
%def I1 UD.v(U32.shl($AT))
%def I2 UD.v(U32.inc(U32.shl($AT)))
%def T1 AR.upd(U32, 1n+K, T, $I1, w)
%def TP AR.upd(U32, 1n+K, $T1, $I2, l)
%def TBL AR.slots(U32, T)
%def PP +K: Nat, +hK: {Nat.is_lt(K, 31n) $TT, +T: AR.Tree<U32>, +pt: {AR.perfect(U32, 1n+K, T) $TT, +e: Nat, +he: {Nat.is_lt(e, SC.pow2(K)) $TT, +w: U32, +l: U32
%def PA K, hK, T, pt, e, he, w, l

def p_ev($PP) -> {UD.v($AT) == e : Nat}:
  U.to_nat_from_nat(e, K, N.lt_le(K, 32n, N.lt_trans(K, 31n, 32n, hK, {==})), he)

def p_h($PP) -> {Nat.is_lt(1n+Nat.double(UD.v($AT)), SC.pow2(1n+K)) $TT:
  L.subst(Nat, z => {Nat.is_lt(1n+Nat.double(z), SC.pow2(1n+K)) $TT, e, UD.v($AT), Equal.sym(Nat, UD.v($AT), e, p_ev($PA)), N.double_lt_bit(True{}, e, SC.pow2(K), he))

def p_i1($PP) -> {$I1 == Nat.double(e) : Nat}:
  Equal.trans(Nat, $I1, Nat.double(UD.v($AT)), Nat.double(e), AX.ix_w($AT, 1n+K, hK, p_h($PA)), Equal.cong(Nat, Nat, z => Nat.double(z), UD.v($AT), e, p_ev($PA)))

def p_i2($PP) -> {$I2 == 1n+Nat.double(e) : Nat}:
  Equal.trans(Nat, $I2, 1n+Nat.double(UD.v($AT)), 1n+Nat.double(e), AX.ix_l($AT, 1n+K, hK, p_h($PA)), Equal.cong(Nat, Nat, z => 1n+Nat.double(z), UD.v($AT), e, p_ev($PA)))

def p_h1($PP) -> {Nat.is_lt($I1, SC.pow2(1n+K)) $TT:
  L.subst(Nat, z => {Nat.is_lt(z, SC.pow2(1n+K)) $TT, Nat.double(e), $I1, Equal.sym(Nat, $I1, Nat.double(e), p_i1($PA)), N.lt_trans(Nat.double(e), 1n+Nat.double(e), SC.pow2(1n+K), N.lt_succ(Nat.double(e)), N.double_lt_bit(True{}, e, SC.pow2(K), he)))

def p_h2($PP) -> {Nat.is_lt($I2, SC.pow2(1n+K)) $TT:
  L.subst(Nat, z => {Nat.is_lt(z, SC.pow2(1n+K)) $TT, 1n+Nat.double(e), $I2, Equal.sym(Nat, $I2, 1n+Nat.double(e), p_i2($PA)), N.double_lt_bit(True{}, e, SC.pow2(K), he))

def put_perf($PP) -> {AR.perfect(U32, 1n+K, $TP) $TT:
  AR.upd_perfect(U32, 1n+K, $T1, $I2, l, AR.upd_perfect(U32, 1n+K, T, $I1, w, pt))

# THEOREM: writing bucket e is the tree update at 2e and 2e + 1
def put_eq($PP) -> {H.put_bucket(AR.thaw(U32, T), $AT, w, l) == AR.thaw(U32, $TP) : Array<U32>}:
  +p1 = AR.upd_perfect(U32, 1n+K, T, $I1, w, pt)
  +s1 = AR.set(U32, 1n+K, T, U32.shl($AT), w, W32.nth0($TBL, $I1), hK, p_h1($PA), W32.nth_some($TBL, $I1, IS.len_lt(U32, 1n+K, T, pt, $I1, p_h1($PA))), pt)
  +s2 = AR.set(U32, 1n+K, $T1, U32.inc(U32.shl($AT)), l, W32.nth0(AR.slots(U32, $T1), $I2), hK, p_h2($PA), W32.nth_some(AR.slots(U32, $T1), $I2, IS.len_lt(U32, 1n+K, $T1, p1, $I2, p_h2($PA))), p1)
  Equal.trans(Array<U32>, H.put_bucket(AR.thaw(U32, T), $AT, w, l), Array.set(U32, AR.thaw(U32, $T1), U32.inc(U32.shl($AT)), l), AR.thaw(U32, $TP), Equal.cong(Array<U32>, Array<U32>, a => Array.set(U32, a, U32.inc(U32.shl($AT)), l), Array.set(U32, AR.thaw(U32, T), U32.shl($AT), w), AR.thaw(U32, $T1), s1), s2)

%def TBU SC.update(U32, SC.update(U32, $TBL, Nat.double(e), w), 1n+Nat.double(e), l)

def put_slots($PP) -> {AR.slots(U32, $TP) == $TBU : List<&2, U32>}:
  +p1 = AR.upd_perfect(U32, 1n+K, T, $I1, w, pt)
  +e1 = AR.upd_slots(U32, 1n+K, $T1, $I2, l, p_h2($PA), p1)
  +e2 = Equal.cong(List<&2, U32>, List<&2, U32>, z => SC.update(U32, z, $I2, l), AR.slots(U32, $T1), SC.update(U32, $TBL, $I1, w), AR.upd_slots(U32, 1n+K, T, $I1, w, p_h1($PA), pt))
  +e3 = Equal.cong(Nat, List<&2, U32>, z => SC.update(U32, SC.update(U32, $TBL, z, w), $I2, l), $I1, Nat.double(e), p_i1($PA))
  +e4 = Equal.cong(Nat, List<&2, U32>, z => SC.update(U32, SC.update(U32, $TBL, Nat.double(e), w), z, l), $I2, 1n+Nat.double(e), p_i2($PA))
  Equal.trans(List<&2, U32>, AR.slots(U32, $TP), SC.update(U32, AR.slots(U32, $T1), $I2, l), $TBU, e1, Equal.trans(List<&2, U32>, SC.update(U32, AR.slots(U32, $T1), $I2, l), SC.update(U32, SC.update(U32, $TBL, $I1, w), $I2, l), $TBU, e2, Equal.trans(List<&2, U32>, SC.update(U32, SC.update(U32, $TBL, $I1, w), $I2, l), SC.update(U32, SC.update(U32, $TBL, Nat.double(e), w), $I2, l), $TBU, e3, e4)))

%def SLl UD.v(H.slot(l))
%def NBk B.BF{w, l, TB.keyof(w, TB.nths(kl, $SLl))}

# THEOREM: the written tree decodes to the buckets with bucket e filled, the
# key read from the unchanged arena
def put_bs($PP, +kl: List<&2, String>, +n: Nat, +hns: {ST.noslot(TB.buckets($TBL, kl, n), $SLl, n) $TT, +hw0: {U32.is_eq(w, 0) $FF, +hkl: {Nat.is_lt($SLl, SC.length(String, kl)) $TT) -> {TB.buckets(AR.slots(U32, $TP), kl, n) == IM.bupd(TB.buckets($TBL, kl, n), e, $NBk) : List<&2, B.Bk>}:
  +htb = IS.len_lt(U32, 1n+K, T, pt, 1n+Nat.double(e), N.double_lt_bit(True{}, e, SC.pow2(K), he))
  +bp = IA.buckets_put($TBL, kl, e, w, l, TB.nths(kl, $SLl), n, hns, hw0, htb, hkl)
  +ek = TB.upd_self(kl, $SLl)
  Equal.trans(List<&2, B.Bk>, TB.buckets(AR.slots(U32, $TP), kl, n), TB.buckets($TBU, kl, n), IM.bupd(TB.buckets($TBL, kl, n), e, $NBk), Equal.cong(List<&2, U32>, List<&2, B.Bk>, z => TB.buckets(z, kl, n), AR.slots(U32, $TP), $TBU, put_slots($PA)), Equal.trans(List<&2, B.Bk>, TB.buckets($TBU, kl, n), TB.buckets($TBU, SC.update(String, kl, $SLl, TB.nths(kl, $SLl)), n), IM.bupd(TB.buckets($TBL, kl, n), e, $NBk), Equal.cong(List<&2, String>, List<&2, B.Bk>, z => TB.buckets($TBU, z, n), kl, SC.update(String, kl, $SLl, TB.nths(kl, $SLl)), Equal.sym(List<&2, String>, SC.update(String, kl, $SLl, TB.nths(kl, $SLl)), kl, ek)), bp))

# ---- the empty table ----

def nth0_rep(+m: Nat, +x: Nat) -> {W32.nth0(SC.replicate(U32, m, 0), x) == 0 : U32}:
  match m x:
    case 0n _:
      {==}
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      nth0_rep(p, q)

%def ZB TB.buckets(AR.slots(U32, AR.trep(U32, d, 0)), kl, n)
%def ZL AR.slots(U32, AR.trep(U32, d, 0))

def nth0_z(+d: Nat, +x: Nat) -> {W32.nth0($ZL, x) == 0 : U32}:
  Equal.trans(U32, W32.nth0($ZL, x), W32.nth0(SC.replicate(U32, SC.pow2(d), 0), x), 0, Equal.cong(List<&2, U32>, U32, z => W32.nth0(z, x), $ZL, SC.replicate(U32, SC.pow2(d), 0), AR.trep_slots(U32, d, 0)), nth0_rep(SC.pow2(d), x))

def at_z(+d: Nat, +kl: List<&2, String>, +n: Nat, +i: Nat, +hi: {Nat.is_lt(i, n) $TT) -> {B.at($ZB, i) == B.BE{} : B.Bk}:
