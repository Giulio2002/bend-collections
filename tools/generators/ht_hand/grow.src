def StepOK(+OT: AR.Tree<U32>, +kl: List<&2, String>, +k: Nat, +sd: Nat, +j: Nat, +kk: U32, +NT: AR.Tree<U32>) -> Type:
  Sigma<&1, &1, AR.Tree<U32>, T2 => {H.mv_step(kk, $MSK, $MVS) == H.MV{AR.thaw(U32, OT), AR.thaw(U32, T2)} : H.Mv} & {rinv(OT, kl, k, sd, T2, 1n+j) $TT>

def s_hh($OH, $SP) -> {Nat.is_lt(1n+Nat.double(UD.v(kk)), SC.pow2(1n+k)) $TT:
  L.subst(Nat, z => {Nat.is_lt(1n+Nat.double(z), SC.pow2(1n+k)) $TT, j, UD.v(kk), Equal.sym(Nat, UD.v(kk), j, hkk), N.double_lt_bit(True{}, j, $N, hj))

def s_ew($OH, $SP) -> {UD.v(U32.shl(kk)) == Nat.double(j) : Nat}:
