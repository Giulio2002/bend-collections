      +c5 = $TOB {Nat.is_eq(IV.occn(z, $N2), IV.occn($OBS, 1n+j)) $TT $FRB IS.eq_is_eq(IV.occn($BUx, $N2), IV.occn($OBS, 1n+j), e5))
