def z_clus(+d: Nat, +kl: List<&2, String>, +n: Nat, +mask: U32, +m: Nat, +hm: {Nat.is_le(m, n) $TT) -> {B.all_lt(B.PClus{$ZB, n, mask}, m) $TT:
