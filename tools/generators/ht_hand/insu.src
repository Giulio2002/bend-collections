import Base
import ../lib/logic.bend as L
import ../lib/nat.bend as N
import ../lib/u32.bend as U
import ../lib/u32alg.bend as A
import ../spec/common.bend as SC
import ../math/word.bend as WD
import ../math/u32div.bend as UD
import ../../src/containers/hash_table.bend as H
import ./cyc.bend as CY
import ./arr.bend as AX
import ./probe_all.bend as PA

# U32 facts for insertion: links and slots, the load test, counters.

%def TT == True{} : Bool}
%def FF == False{} : Bool}
%def O +one: Nat, +h1: {one == 1n : Nat}
%def S32 WD.sc(32n, one)

# x < 2^d with d + 1 < 32 leaves room for one more
def bound32($O, +x: Nat, +d: Nat, +hd: {Nat.is_lt(1n+d, 32n) $TT, +hx: {Nat.is_lt(x, SC.pow2(d)) $TT) -> {Nat.is_lt(1n+x, $S32) $TT:
  N.le_lt_trans(1n+x, SC.pow2(d), $S32, N.lt_succ_le_succ(x, SC.pow2(d), hx), N.lt_le_trans(SC.pow2(d), SC.pow2(1n+d), $S32, N.pow2_lt_succ(d), AX.pow_le32(one, h1, 1n+d, hd)))

def link_val($O, +s: U32, +hs: {Nat.is_lt(1n+UD.v(s), $S32) $TT) -> {UD.v(H.link(s)) == 1n+UD.v(s) : Nat}:
  CY.inc_val(one, h1, s, hs)

# THEOREM: the slot of the link of s is s
def slot_link($O, +s: U32, +hs: {Nat.is_lt(1n+UD.v(s), $S32) $TT) -> {UD.v(H.slot(H.link(s))) == UD.v(s) : Nat}:
  +lv = link_val(one, h1, s, hs)
  +hle = L.subst(Nat, z => {Nat.is_le(1n, z) $TT, 1n+UD.v(s), UD.v(H.link(s)), Equal.sym(Nat, UD.v(H.link(s)), 1n+UD.v(s), lv), N.zero_le(UD.v(s)))
  Equal.trans(Nat, UD.v(H.slot(H.link(s))), Nat.sub(UD.v(H.link(s)), 1n), UD.v(s), U.sub_nat(H.link(s), 1, hle), Equal.trans(Nat, Nat.sub(UD.v(H.link(s)), 1n), Nat.sub(1n+UD.v(s), 1n), UD.v(s), Equal.cong(Nat, Nat, z => Nat.sub(z, 1n), UD.v(H.link(s)), 1n+UD.v(s), lv), N.sub_zero(UD.v(s))))

def link_nz_c($O, +s: U32, +hs: {Nat.is_lt(1n+UD.v(s), $S32) $TT, +c: Bool, +hc: {U32.is_eq(H.link(s), 0) == c : Bool}) -> {c $FF:
  match c:
    case False{}:
      {==}
    case True{}:
      +e0 = Equal.cong(U32, Nat, z => UD.v(z), H.link(s), 0, A.eq_of(H.link(s), 0, hc))
      Empty.absurd({True{} $FF, N.succ_zero(UD.v(s), Equal.trans(Nat, 1n+UD.v(s), UD.v(H.link(s)), 0n, Equal.sym(Nat, UD.v(H.link(s)), 1n+UD.v(s), link_val(one, h1, s, hs)), e0)))

# THEOREM: a link is never 0
def link_nz($O, +s: U32, +hs: {Nat.is_lt(1n+UD.v(s), $S32) $TT) -> {U32.is_eq(H.link(s), 0) $FF:
  link_nz_c(one, h1, s, hs, U32.is_eq(H.link(s), 0), {==})

# ---- comparisons ----

def is_gt_nat(+a: U32, +b: U32) -> {U32.is_gt(a, b) == Nat.is_gt(UD.v(a), UD.v(b)) : Bool}:
  Equal.cong(Cmp, Bool, c => Cmp.is_gt(c), U32.cmp(a, b), Nat.cmp(UD.v(a), UD.v(b)), U.u32_cmp(a, b))

def gt_le_c(+a: Nat, +b: Nat, +c: Cmp, +hc: {Nat.cmp(a, b) == c : Cmp}, +h: {Cmp.is_gt(c) $FF) -> {Cmp.is_le(c) $TT:
  match c:
    case LT{}:
      {==}
    case EQ{}:
      {==}
    case GT{}:
      Empty.absurd({Cmp.is_le(GT{}) $TT, L.true_false(h))

def gt_false_le(+a: Nat, +b: Nat, +h: {Nat.is_gt(a, b) $FF) -> {Nat.is_le(a, b) $TT:
  gt_le_c(a, b, Nat.cmp(a, b), {==}, h)

def gt_le_t(+a: Nat, +b: Nat, +c: Cmp, +h: {Cmp.is_gt(c) $TT) -> {Cmp.is_le(c) $FF:
  match c:
    case LT{}:
      Empty.absurd({Cmp.is_le(LT{}) $FF, L.false_true(h))
    case EQ{}:
      Empty.absurd({Cmp.is_le(EQ{}) $FF, L.false_true(h))
    case GT{}:
      {==}

# a > b: not a <= b
def gt_true_nle(+a: Nat, +b: Nat, +h: {Nat.is_gt(a, b) $TT) -> {Nat.is_le(a, b) $FF:
  gt_le_t(a, b, Nat.cmp(a, b), h)

# ---- the load test ----

def dle_c(+x: Nat, +y: Nat, +h: {Nat.is_le(Nat.double(x), Nat.double(y)) $TT, +c: Bool, +hc: {Nat.is_le(x, y) == c : Bool}) -> {c $TT:
  match c:
    case True{}:
      {==}
    case False{}:
      Empty.absurd({False{} $TT, L.true_false(Equal.trans(Bool, True{}, Nat.is_le(Nat.double(x), Nat.double(y)), False{}, Equal.sym(Bool, Nat.is_le(Nat.double(x), Nat.double(y)), True{}, h), N.lt_not_le(Nat.double(y), Nat.double(x), N.double_lt(y, x, N.not_le_lt(x, y, hc))))))

def dbl_le_inv(+x: Nat, +y: Nat, +h: {Nat.is_le(Nat.double(x), Nat.double(y)) $TT) -> {Nat.is_le(x, y) $TT:
  dle_c(x, y, h, Nat.is_le(x, y), {==})

# 2x <= 2^(p+1): x + 1 <= 2^(p+1)
def succ_le_pow(+x: Nat, +p: Nat, +h: {Nat.is_le(Nat.double(x), SC.pow2(1n+p)) $TT) -> {Nat.is_le(1n+x, SC.pow2(1n+p)) $TT:
  N.le_trans(1n+x, 1n+SC.pow2(p), SC.pow2(1n+p), dbl_le_inv(x, SC.pow2(p), h), N.double_succ_le(SC.pow2(p), N.pow2_pos(p)))

def over_c($O, +k: Nat, +hk31: {Nat.is_lt(k, 31n) $TT, +hk0: {Nat.is_lt(0n, k) $TT, +x: Nat, +h: {Nat.is_le(Nat.double(x), SC.pow2(k)) $TT) -> {Nat.is_le(1n+x, SC.pow2(k)) $TT:
  match k:
    case 0n:
      Empty.absurd({Nat.is_le(1n+x, SC.pow2(0n)) $TT, L.false_true(hk0))
    case 1n+p:
      succ_le_pow(x, p, h)

# THEOREM: with at most half the buckets full, one more entry is n + 1 and
# the load test compares 2(n + 1) with the bucket count
def inc_n($O, +k: Nat, +hk31: {Nat.is_lt(k, 31n) $TT, +hk0: {Nat.is_lt(0n, k) $TT, +n: U32, +hl: {Nat.is_le(Nat.double(UD.v(n)), SC.pow2(k)) $TT) -> {UD.v(U32.inc(n)) == 1n+UD.v(n) : Nat}:
  CY.inc_val(one, h1, n, N.le_lt_trans(1n+UD.v(n), SC.pow2(k), $S32, over_c(one, h1, k, hk31, hk0, UD.v(n), hl), N.lt_le_trans(SC.pow2(k), SC.pow2(1n+k), $S32, N.pow2_lt_succ(k), AX.pow_le32(one, h1, 1n+k, hk31))))

def over_val($O, +k: Nat, +hk31: {Nat.is_lt(k, 31n) $TT, +hk0: {Nat.is_lt(0n, k) $TT, +n: U32, +hl: {Nat.is_le(Nat.double(UD.v(n)), SC.pow2(k)) $TT) -> {U32.is_gt(U32.shl(U32.inc(n)), U32.inc(CY.msk(k))) == Nat.is_gt(Nat.double(1n+UD.v(n)), SC.pow2(k)) : Bool}:
  +ei = inc_n(one, h1, k, hk31, hk0, n, hl)
  +d1 = N.double_le(1n+UD.v(n), SC.pow2(k), over_c(one, h1, k, hk31, hk0, UD.v(n), hl))
  +d2 = L.subst(Nat, z => {Nat.is_lt(Nat.double(z), SC.pow2(2n+k)) $TT, 1n+UD.v(n), UD.v(U32.inc(n)), Equal.sym(Nat, UD.v(U32.inc(n)), 1n+UD.v(n), ei), N.le_lt_trans(Nat.double(1n+UD.v(n)), SC.pow2(1n+k), SC.pow2(2n+k), d1, N.pow2_lt_succ(1n+k)))
  +es = Equal.trans(Nat, UD.v(U32.shl(U32.inc(n))), Nat.double(UD.v(U32.inc(n))), Nat.double(1n+UD.v(n)), U.shl_value(U32.inc(n), 2n+k, N.lt_succ_le(k, 30n, hk31), d2), Equal.cong(Nat, Nat, z => Nat.double(z), UD.v(U32.inc(n)), 1n+UD.v(n), ei))
  Equal.trans(Bool, U32.is_gt(U32.shl(U32.inc(n)), U32.inc(CY.msk(k))), Nat.is_gt(UD.v(U32.shl(U32.inc(n))), UD.v(U32.inc(CY.msk(k)))), Nat.is_gt(Nat.double(1n+UD.v(n)), SC.pow2(k)), is_gt_nat(U32.shl(U32.inc(n)), U32.inc(CY.msk(k))),
    Equal.trans(Bool, Nat.is_gt(UD.v(U32.shl(U32.inc(n))), UD.v(U32.inc(CY.msk(k)))), Nat.is_gt(Nat.double(1n+UD.v(n)), UD.v(U32.inc(CY.msk(k)))), Nat.is_gt(Nat.double(1n+UD.v(n)), SC.pow2(k)), Equal.cong(Nat, Bool, z => Nat.is_gt(z, UD.v(U32.inc(CY.msk(k)))), UD.v(U32.shl(U32.inc(n))), Nat.double(1n+UD.v(n)), es), Equal.cong(Nat, Bool, z => Nat.is_gt(Nat.double(1n+UD.v(n)), z), UD.v(U32.inc(CY.msk(k))), SC.pow2(k), PA.fuel_eq(one, h1, k, hk31))))
