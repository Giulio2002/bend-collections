FS.limbs16(one, 5n, [21920n, 48044n, 63964n, 26238n, 31166n]), lit16(one, h1, 149n, 98n, {==}, {==}), Lg.and_intro(Nat.is_lt(21920n, C.shift(16n, one)), FS.limbs16(one, 4n, [48044n, 63964n, 26238n, 31166n]), lit16(one, h1, 160n, 85n, {==}, {==}), Lg.and_intro(Nat.is_lt(48044n, C.shift(16n, one)), FS.limbs16(one, 3n, [63964n, 26238n, 31166n]), lit16(one, h1, 172n, 187n, {==}, {==}), Lg.and_intro(Nat.is_lt(63964n, C.shift(16n, one)), FS.limbs16(one, 2n, [26238n, 31166n]), lit16(one, h1, 220n, 249n, {==}, {==}), Lg.and_intro(Nat.is_lt(26238n, C.shift(16n, one)), FS.limbs16(one, 1n, [31166n]), lit16(one, h1, 126n, 102n, {==}, {==}), Lg.and_intro(Nat.is_lt(31166n, C.shift(16n, one)), FS.limbs16(one, 0n, []), lit16(one, h1, 190n, 121n, {==}, {==}), {==}))))))))))))))))

def gy_l(+one: Nat, +h1: {one == 1n : Nat}) -> {FS.limbs16(one, 16n, P.gy()) == True{} : Bool}:
  Lg.and_intro(Nat.is_lt(54456n, C.shift(16n, one)), FS.limbs16(one, 15n, [64272n, 53391n, 40007n, 21529n, 42629n, 46152n, 64791n, 2216n, 3601n, 64508n, 23972n, 50277n, 9891n, 55927n, 18490n]), lit16(one, h1, 184n, 212n, {==}, {==}), Lg.and_intro(Nat.is_lt(64272n, C.shift(16n, one)), FS.limbs16(one, 14n, [53391n, 40007n, 21529n, 42629n, 46152n, 64791n, 2216n, 3601n, 64508n, 23972n, 50277n, 9891n, 55927n, 18490n]), lit16(one, h1, 16n, 251n, {==}, {==}), Lg.and_intro(Nat.is_lt(53391n, C.shift(16n, one)), FS.limbs16(one, 13n, [40007n, 21529n, 42629n, 46152n, 64791n, 2216n, 3601n, 64508n, 23972n, 50277n, 9891n, 55927n, 18490n]), lit16(one, h1, 143n, 208n, {==}, {==}), Lg.and_intro(Nat.is_lt(40007n, C.shift(16n, one)), FS.limbs16(one, 12n, [21529n, 42629n, 46152n, 64791n, 2216n, 3601n, 64508n, 23972n, 50277n, 9891n, 55927n, 18490n]), lit16(one, h1, 71n, 156n, {==}, {==}), Lg.and_intro(Nat.is_lt(21529n, C.shift(16n, one)), FS.limbs16(one, 11n, [42629n, 46152n, 64791n, 2216n, 3601n, 64508n, 23972n, 50277n, 9891n, 55927n, 18490n]), lit16(one, h1, 25n, 84n, {==}, {==}), Lg.and_intro(Nat.is_lt(42629n, C.shift(16n, one)), FS.limbs16(one, 10n, [46152n, 64791n, 2216n, 3601n, 64508n, 23972n, 50277n, 9891n, 55927n, 18490n]), lit16(one, h1, 133n, 166n, {==}, {==}), Lg.and_intro(Nat.is_lt(46152n, C.shift(16n, one)), FS.limbs16(one, 9n, [64791n, 2216n, 3601n, 64508n, 23972n, 50277n, 9891n, 55927n, 18490n]), lit16(one, h1, 72n, 180n, {==}, {==}), Lg.and_intro(Nat.is_lt(64791n, C.shift(16n, one)), FS.limbs16(one, 8n, [2216n, 3601n, 64508n, 23972n, 50277n, 9891n, 55927n, 18490n]), lit16(one, h1, 23n, 253n, {==}, {==}), Lg.and_intro(Nat.is_lt(2216n, C.shift(16n, one)), FS.limbs16(one, 7n, [3601n, 64508n, 23972n, 50277n, 9891n, 55927n, 18490n]), lit16(one, h1, 168n, 8n, {==}, {==}), Lg.and_intro(Nat.is_lt(3601n, C.shift(16n, one)), FS.limbs16(one, 6n, [64508n, 23972n, 50277n, 9891n, 55927n, 18490n]), lit16(one, h1, 17n, 14n, {==}, {==}), Lg.and_intro(Nat.is_lt(64508n, C.shift(16n, one)), 