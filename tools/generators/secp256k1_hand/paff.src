# Affine coordinates, the point-at-infinity test and the generator of
# src/crypto/secp256k1/point.bend against spec/crypto/secp256k1/curve.bend.

def av(+one: Nat, a: P.Affine) -> CV.SAffine:
  match a:
    case P.Affine{x, y}: CV.SAffine{FS.value(one, x), FS.value(one, y)}

def ared(+one: Nat, a: P.Affine) -> Bool:
  match a:
    case P.Affine{x, y}: Bool.and(PT.red(one, x), PT.red(one, y))

def red3(+one: Nat, +x: List<&2, Nat>, +y: List<&2, Nat>, +z: List<&2, Nat>, +h: {PT.pred(one, P.Point{x, y, z}) == True{} : Bool}) -> {Bool.and(PT.red(one, x), Bool.and(PT.red(one, y), PT.red(one, z))) == True{} : Bool}:
  h

def rx(+one: Nat, +x: List<&2, Nat>, +y: List<&2, Nat>, +z: List<&2, Nat>, +h: {PT.pred(one, P.Point{x, y, z}) == True{} : Bool}) -> {PT.red(one, x) == True{} : Bool}:
  Lg.and_left(PT.red(one, x), Bool.and(PT.red(one, y), PT.red(one, z)), h)

def ry(+one: Nat, +x: List<&2, Nat>, +y: List<&2, Nat>, +z: List<&2, Nat>, +h: {PT.pred(one, P.Point{x, y, z}) == True{} : Bool}) -> {PT.red(one, y) == True{} : Bool}:
  Lg.and_left(PT.red(one, y), PT.red(one, z), Lg.and_right(PT.red(one, x), Bool.and(PT.red(one, y), PT.red(one, z)), h))

def rz(+one: Nat, +x: List<&2, Nat>, +y: List<&2, Nat>, +z: List<&2, Nat>, +h: {PT.pred(one, P.Point{x, y, z}) == True{} : Bool}) -> {PT.red(one, z) == True{} : Bool}:
  Lg.and_right(PT.red(one, y), PT.red(one, z), Lg.and_right(PT.red(one, x), Bool.and(PT.red(one, y), PT.red(one, z)), h))

# (X / Z, Y / Z)
def aff_v(+one: Nat, +h1: {one == 1n : Nat}, a: P.Point, +ha: {PT.pred(one, a) == True{} : Bool}) -> {av(one, P.to_affine(a)) == CV.to_affine(FS.prime(one), PT.pv(one, a)) : CV.SAffine}:
  match a:
    case P.Point{+x, +y, +z}:
      +hx = rx(one, x, y, z, ha)
      +hy = ry(one, x, y, z, ha)
      +hz = rz(one, x, y, z, ha)
      %goal {CV.SAffine{FS.value(one, F.mul(x, F.inv(z))), FS.value(one, F.mul(y, F.inv(z)))} == CV.SAffine{FS.mmul(FS.prime(one), FS.value(one, x), FS.minv(FS.prime(one), FS.value(one, z))), FS.mmul(FS.prime(one), FS.value(one, y), FS.minv(FS.prime(one), FS.value(one, z)))} : CV.SAffine}
      %rw FO.mul_v(one, h1, x, F.inv(z), hx, FP.inv_r(one, h1, z, hz))
      %rw FO.mul_v(one, h1, y, F.inv(z), hy, FP.inv_r(one, h1, z, hz))
      %rw FP.inv_v(one, h1, z, hz)
      %rw FP.inv_v(one, h1, z, hz)
      %close

def aff_r(+one: Nat, +h1: {one == 1n : Nat}, a: P.Point, +ha: {PT.pred(one, a) == True{} : Bool}) -> {ared(one, P.to_affine(a)) == True{} : Bool}:
  match a:
    case P.Point{+x, +y, +z}:
      +hx = rx(one, x, y, z, ha)
      +hy = ry(one, x, y, z, ha)
      +hz = rz(one, x, y, z, ha)
      +hi = FP.inv_r(one, h1, z, hz)
      Lg.and_intro(PT.red(one, F.mul(x, F.inv(z))), PT.red(one, F.mul(y, F.inv(z))), FO.mul_r(one, h1, x, F.inv(z), hx, hi), FO.mul_r(one, h1, y, F.inv(z), hy, hi))

def is_inf_v(+one: Nat, +h1: {one == 1n : Nat}, a: P.Point) -> {P.is_inf(a) == CV.is_inf(PT.pv(one, a)) : Bool}:
  match a:
    case P.Point{+x, +y, +z}:
      FW.is_zero_f(one, h1, z)

# ---- the generator ----

