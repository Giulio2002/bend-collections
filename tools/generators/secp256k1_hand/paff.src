ne)), FS.limbs16(one, 6n, [25237n, 21920n, 48044n, 63964n, 26238n, 31166n]), PM.lt16(one, h1, 52871n, 16384n, PM.sh14(one, h1), {==}), Lg.and_intro(Nat.is_lt(25237n, C.shift(16n, one)), FS.limbs16(one, 5n, [21920n, 48044n, 63964n, 26238n, 31166n]), PM.lt16(one, h1, 25237n, 16384n, PM.sh14(one, h1), {==}), Lg.and_intro(Nat.is_lt(21920n, C.shift(16n, one)), FS.limbs16(one, 4n, [48044n, 63964n, 26238n, 31166n]), PM.lt16(one, h1, 21920n, 16384n, PM.sh14(one, h1), {==}), Lg.and_intro(Nat.is_lt(48044n, C.shift(16n, one)), FS.limbs16(one, 3n, [63964n, 26238n, 31166n]), PM.lt16(one, h1, 48044n, 16384n, PM.sh14(one, h1), {==}), Lg.and_intro(Nat.is_lt(63964n, C.shift(16n, one)), FS.limbs16(one, 2n, [26238n, 31166n]), PM.lt16(one, h1, 63964n, 16384n, PM.sh14(one, h1), {==}), Lg.and_intro(Nat.is_lt(26238n, C.shift(16n, one)), FS.limbs16(one, 1n, [31166n]), PM.lt16(one, h1, 26238n, 16384n, PM.sh14(one, h1), {==}), Lg.and_intro(Nat.is_lt(31166n, C.shift(16n, one)), FS.limbs16(one, 0n, []), PM.lt16(one, h1, 31166n, 16384n, PM.sh14(one, h1), {==}), {==}))))))))))))))))

def gy_l(+one: Nat, +h1: {one == 1n : Nat}) -> {FS.limbs16(one, 16n, P.gy()) == True{} : Bool}:
  Lg.and_intro(Nat.is_lt(54456n, C.shift(16n, one)), FS.limbs16(one, 15n, [64272n, 53391n, 40007n, 21529n, 42629n, 46152n, 64791n, 2216n, 3601n, 64508n, 23972n, 50277n, 9891n, 55927n, 18490n]), PM.lt16(one, h1, 54456n, 16384n, PM.sh14(one, h1), {==}), Lg.and_intro(Nat.is_lt(64272n, C.shift(16n, one)), FS.limbs16(one, 14n, [53391n, 40007n, 21529n, 42629n, 46152n, 64791n, 2216n, 3601n, 64508n, 23972n, 50277n, 9891n, 55927n, 18490n]), PM.lt16(one, h1, 64272n, 16384n, PM.sh14(one, h1), {==}), Lg.and_intro(Nat.is_lt(53391n, C.shift(16n, one)), FS.limbs16(one, 13n, [40007n, 21529n, 42629n, 46152n, 64791n, 2216n, 3601n, 64508n, 23972n, 50277n, 9891n, 55927n, 18490n]), PM.lt16(one, h1, 53391n, 16384n, PM.sh14(one, h1), {==}), Lg.and_intro(Nat.is_lt(40007n, C.shift(16n, one)), FS.limbs16(one, 12n, [21529n, 42629n, 46152n, 64791n, 2216n, 3601n, 64508n, 23972n, 50277n, 9891n, 55927n, 18490n]), PM.lt16(one, h1, 40007n, 16384n, PM.sh14(one, h1), {==}), Lg.and_intro(Nat.is_lt(21529n, C.shift(16n, one)), FS.limbs16(one, 11n, [42629n, 46152n, 64791n, 2216n, 3601n, 64508n, 23972n, 50277n, 9891n, 55927n, 18490n]), PM.lt16(one, h1, 21529n, 16384n, PM.sh14(one, h1), {==}), Lg.and_intro(Nat.is_lt(42629n, C.shift(16n, one)), FS.limbs16(one, 10n, [46152n, 64791n, 2216n, 3601n, 64508n, 23972n, 50277n, 9891n, 55927n, 18490n]), PM.lt16(one, h1, 42629n, 16384n, PM.sh14(one, h1), {==}), Lg.and_intro(Nat.is_lt(46152n, C.shift(16n, one)), FS.limbs16(one, 9n, [64791n, 2216n, 3601n, 64508n, 23972n, 50277n, 9891n, 55927n, 18490n]), PM.lt16(one, h1, 46152n, 16384n, PM.sh14(one, h1), {==}), Lg.and_intro(Nat.is_lt(64791n, C.shift(16n, one)), FS.limbs16(one, 8n, [2216n, 3601n, 64508n, 23972n, 50277n, 9891n, 55927n, 18490n]), PM.lt16(one, h1, 64791n, 16384n, PM.sh14(one, h1), {==}), Lg.and_intro(Nat.is_lt(2216n, C.shift(16n, one)), FS.limbs16(one, 7n, [3601n, 64508n, 23972n, 50277n, 9891n, 55927n, 18490n]), PM.lt16(one, h1, 2216n, 16384n, PM.sh14(one, h1), {==}), Lg.and_intro(Nat.is_lt(3601n, C.shift(16n, one)), FS.limbs16(one, 6n, [64508n, 23972n, 50277n, 9891n, 55927n, 18490n]), PM.lt16(one, h1, 3601n, 16384n, PM.sh14(one, h1), {==}), Lg.and_intro(Nat.is_lt(64508n, C.shift(16n, one)), FS.limbs16(one, 5n, [23972n, 50277n, 9891n, 55927n, 18490n]), PM.lt16(one, h1, 64508n, 16384n, PM.sh14(one, h1), {==}), Lg.and_intro(Nat.is_lt(23972n, C.shift(16n, one)), FS.limbs16(one, 4n, [50277n, 9891n, 55927n, 18490n]), PM.lt16(one, h1, 23972n, 16384n, PM.sh14(one, h1), {==}), Lg.and_intro(Nat.is_lt(50277n, C.shift(16n, one)), FS.limbs16(one, 3n, [9891n, 55927n, 18490n]), PM.lt16(one, h1, 50277n, 16384n, PM.sh14(one, h1), {==}), Lg.and_intro(Nat.is_lt(9891n, C.shift(16n, one)), FS.limbs16(one, 2n, [55927n, 18490n]), PM.lt16(one, h1, 9891n, 16384n, PM.sh14(one, h1), {==}), Lg.and_intro(Nat.is_lt(55927n, C.shift(16n, one)), FS.limbs16(one, 1n, [18490n]), PM.lt16(one, h1, 55927n, 16384n, PM.sh14(one, h1), {==}), Lg.and_intro(Nat.is_lt(18490n, C.shift(16n, one)), FS.limbs16(one, 0n, []), PM.lt16(one, h1, 18490n, 16384n, PM.sh14(one, h1), {==}), {==}))))))))))))))))

def lt_p_red(+one: Nat, +h1: {one == 1n : Nat}, +x: List<&2, Nat>, +hl: {FS.limbs16(one, 16n, x) == True{} : Bool}, +h: {F.lt_p(x) == True{} : Bool}) -> {PT.red(one, x) == True{} : Bool}:
  +hv = Equal.trans(Bool, Nat.is_lt(FS.value(one, x), FS.prime(one)), F.lt_p(x), True{}, Equal.sym(Bool, F.lt_p(x), Nat.is_lt(FS.value(one, x), FS.prime(one)), FW.lt_p_f(one, h1, x)), h)
  Lg.and_intro(FS.limbs16(one, 16n, x), Nat.is_lt(FS.value(one, x), FS.prime(one)), hl, hv)

def g_r(+one: Nat, +h1: {one == 1n : Nat}) -> {PT.pred(one, P.g()) == True{} : Bool}:
  PT.pr3(one, P.gx(), P.gy(), F.one(), lt_p_red(one, h1, P.gx(), gx_l(one, h1), {==}), lt_p_red(one, h1, P.gy(), gy_l(one, h1), {==}), FO.small_r(one, h1, 1n, PM.one_lt(one, h1)))

def g_v(+one: Nat, +h1: {one == 1n : Nat}) -> {PT.pv(one, P.g()) == CV.g(one) : CV.SPoint}:
  %goal {CV.SPoint{FS.value(one, P.gx()), FS.value(one, P.gy()), FS.value(one, F.small(1n))} == CV.g(one) : CV.SPoint}
  %rw FO.small_val(one, h1, 1n, PM.one_lt(one, h1))
  Equal.cong(Nat, CV.SPoint, z => CV.SPoint{FS.value(one, P.gx()), FS.value(one, P.gy()), z}, 1n, one, Equal.sym(Nat, one, 1n, h1))
