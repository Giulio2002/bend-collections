import Base
import ../../../spec/lib/common.bend as C
import ../../../spec/crypto/secp256k1/field.bend as FS
import ../../../src/crypto/secp256k1/limbs.bend as L
import ../../lib/logic.bend as Lg
import ./lite/math/natural/arith.bend as NR
import ./lite/math/typed/width.bend as WW
import ./semiring.bend as SR
import ./limbs.bend as LV
import ./ineq.bend as I

# Limb bounds: a carry pass leaves limbs below 2^16 = C.shift(16n, one);
# n such limbs have a value below 2^(16 n) = LV.pos(n, one).

def lt_one(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.is_lt(0n, one) == True{} : Bool}:
  %goal {Nat.is_lt(0n, one) == True{} : Bool}
  %rwh h1 : {one == 1n : Nat}
  %close

def pos_pos(+one: Nat, +h1: {one == 1n : Nat}, k: Nat) -> {Nat.is_lt(0n, LV.pos(k, one)) == True{} : Bool}:
  match k:
    case 0n:
      lt_one(one, h1)
    case 1n+ +j:
      %goal {Nat.is_lt(0n, C.shift(16n, LV.pos(j, one))) == True{} : Bool}
      %rw <- WW.shift_zero(16n)
      I.shift_lt(16n, 0n, LV.pos(j, one), pos_pos(one, h1, j))

# 2^(16 n) y
def pos_shift(n: Nat, +y: Nat) -> {LV.pos(n, y) == C.shift(Nat.mul(n, 16n), y) : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+ +k:
      %goal {C.shift(16n, LV.pos(k, y)) == C.shift(Nat.add(16n, Nat.mul(k, 16n)), y) : Nat}
      %rw pos_shift(k, y)
      %rw <- SR.shift_shift(16n, Nat.mul(k, 16n), y)
      %close

# 2^256 y
def pos16(+y: Nat) -> {LV.pos(16n, y) == C.shift(256n, y) : Nat}:
  pos_shift(16n, y)

# s mod 256 < 2^8, and the low 16 bits of s below 2^16
def mod256_lt(+one: Nat, +h1: {one == 1n : Nat}, +s: Nat) -> {Nat.is_lt(Nat.mod(s, 256n), C.shift(8n, one)) == True{} : Bool}:
  %goal {Nat.is_lt(Nat.mod(s, 256n), C.shift(8n, one)) == True{} : Bool}
  %rw LV.b8(one, h1)
  NR.dm_lt(255n, s)

def lo16_lt(+one: Nat, +h1: {one == 1n : Nat}, +s: Nat) -> {Nat.is_lt(L.lo16(s), C.shift(16n, one)) == True{} : Bool}:
  %goal {Nat.is_lt(Nat.add(Nat.mod(s, 256n), Nat.mul(Nat.mod(Nat.div(s, 256n), 256n), 256n)), C.shift(16n, one)) == True{} : Bool}
  %rw LV.m256(Nat.mod(Nat.div(s, 256n), 256n))
  %rw <- SR.shift_shift(8n, 8n, one)
  I.digit_lt(8n, one, h1, Nat.mod(s, 256n), Nat.mod(Nat.div(s, 256n), 256n), C.shift(8n, one), mod256_lt(one, h1, s), mod256_lt(one, h1, Nat.div(s, 256n)))

# the first j <= n limbs of a carry pass: exactly j limbs below 2^16
def carry_limbs(+one: Nat, +h1: {one == 1n : Nat}, n: Nat, j: Nat, xs: List<&2, Nat>, +u: Nat, +hj: {Nat.is_le(j, n) == True{} : Bool}) -> {FS.limbs16(one, j, L.take(j, L.carry(n, xs, u))) == True{} : Bool}:
  match n j xs:
    case 0n 0n Nil{}:
      {==}
    case 0n 0n x <> t:
      {==}
    case 0n 1n+i _:
      Empty.absurd({FS.limbs16(one, 1n+i, L.take(1n+i, L.carry(0n, xs, u))) == True{} : Bool}, Lg.false_true(hj))
    case 1n+k 0n Nil{}:
      {==}
    case 1n+k 0n x <> t:
      {==}
    case 1n+ +k 1n+ +i Nil{}:
      +s = Nat.add(u, 0n)
      Lg.and_intro(Nat.is_lt(L.lo16(s), C.shift(16n, one)), FS.limbs16(one, i, L.take(i, L.carry(k, [], L.hi16(s)))), lo16_lt(one, h1, s), carry_limbs(one, h1, k, i, [], L.hi16(s), hj))
    case 1n+ +k 1n+ +i +x <> +t:
      +s = Nat.add(u, x)
      Lg.and_intro(Nat.is_lt(L.lo16(s), C.shift(16n, one)), FS.limbs16(one, i, L.take(i, L.carry(k, t, L.hi16(s)))), lo16_lt(one, h1, s), carry_limbs(one, h1, k, i, t, L.hi16(s), hj))

# k limbs below 2^16 have a value below 2^(16 k)
def limbs_lt(+one: Nat, +h1: {one == 1n : Nat}, k: Nat, ys: List<&2, Nat>, +h: {FS.limbs16(one, k, ys) == True{} : Bool}) -> {Nat.is_lt(LV.ev(ys), LV.pos(k, one)) == True{} : Bool}:
  match k ys:
    case 0n Nil{}:
      lt_one(one, h1)
    case 0n y <> t:
      Empty.absurd({Nat.is_lt(LV.ev(y <> t), LV.pos(0n, one)) == True{} : Bool}, Lg.false_true(h))
    case 1n+i Nil{}:
      Empty.absurd({Nat.is_lt(LV.ev([]), LV.pos(1n+i, one)) == True{} : Bool}, Lg.false_true(h))
    case 1n+ +i +y <> +t:
      +hy = Lg.and_left(Nat.is_lt(y, C.shift(16n, one)), FS.limbs16(one, i, t), h)
      +ht = Lg.and_right(Nat.is_lt(y, C.shift(16n, one)), FS.limbs16(one, i, t), h)
      I.digit_lt(16n, one, h1, y, LV.ev(t), LV.pos(i, one), hy, limbs_lt(one, h1, i, t, ht))

# the first j limbs of a list whose first n >= j limbs are fine
def limbs_take(+one: Nat, n: Nat, j: Nat, +xs: List<&2, Nat>, +hj: {Nat.is_le(j, n) == True{} : Bool}, +h: {FS.limbs16(one, n, L.take(n, xs)) == True{} : Bool}) -> {FS.limbs16(one, j, L.take(j, xs)) == True{} : Bool}:
  match n j xs:
    case 0n 0n _:
      {==}
    case 0n 1n+i _:
      Empty.absurd({FS.limbs16(one, 1n+i, L.take(1n+i, xs)) == True{} : Bool}, Lg.false_true(hj))
    case 1n+k 0n _:
      {==}
    case 1n+k 1n+i Nil{}:
      Empty.absurd({FS.limbs16(one, 1n+i, L.take(1n+i, [])) == True{} : Bool}, Lg.false_true(h))
    case 1n+ +k 1n+ +i +x <> +t:
      +hx = Lg.and_left(Nat.is_lt(x, C.shift(16n, one)), FS.limbs16(one, k, L.take(k, t)), h)
      +ht = Lg.and_right(Nat.is_lt(x, C.shift(16n, one)), FS.limbs16(one, k, L.take(k, t)), h)
      Lg.and_intro(Nat.is_lt(x, C.shift(16n, one)), FS.limbs16(one, i, L.take(i, t)), hx, limbs_take(one, k, i, t, hj, ht))
