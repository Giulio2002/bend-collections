# Exponentiation modulo n (src/crypto/secp256k1/scalar.bend pow, inv):
# square-and-multiply over the exponent's bits computes x^e mod n, and the
# bits of inv spell n - 2.

def m(+one: Nat) -> Nat:
  1n+K.np(one)

# one square-and-multiply step (on records, src/crypto/secp256k1/se.bend)
def step_e(+one: Nat, +h1: {one == 1n : Nat}, +x: R.FE, +hx: {SQ.sred(one, x) == True{} : Bool}, +acc: R.FE, +ha: {SQ.sred(one, acc) == True{} : Bool}, +e: Nat, +he: {LV.ev(R.to_list(acc)) == Nat.mod(Nat.pow(LV.ev(R.to_list(x)), e), 1n+K.np(one)) : Nat}, b: Nat, +hb: {Nat.is_lt(b, 2n) == True{} : Bool}) -> {LV.ev(R.to_list(SE.pow_step(b, x, SE.sq(acc)))) == Nat.mod(Nat.pow(LV.ev(R.to_list(x)), Nat.add(Nat.mul(b, one), Nat.double(e))), 1n+K.np(one)) : Nat}:
  match b:
    case 0n:
      %goal {LV.ev(R.to_list(SE.sq(acc))) == Nat.mod(Nat.pow(LV.ev(R.to_list(x)), Nat.double(e)), 1n+K.np(one)) : Nat}
      %rw SQ.sq_e(one, h1, acc, ha)
      ME.sq_step(K.np(one), LV.ev(R.to_list(x)), e, LV.ev(R.to_list(acc)), he)
    case 1n:
      +es = Equal.trans(Nat, LV.ev(R.to_list(SE.sq(acc))), Nat.mod(Nat.mul(LV.ev(R.to_list(acc)), LV.ev(R.to_list(acc))), 1n+K.np(one)), Nat.mod(Nat.pow(LV.ev(R.to_list(x)), Nat.double(e)), 1n+K.np(one)), SQ.sq_e(one, h1, acc, ha), ME.sq_step(K.np(one), LV.ev(R.to_list(x)), e, LV.ev(R.to_list(acc)), he))
      %goal {LV.ev(R.to_list(SE.mul(SE.sq(acc), x))) == Nat.mod(Nat.pow(LV.ev(R.to_list(x)), Nat.add(Nat.mul(1n, one), Nat.double(e))), 1n+K.np(one)) : Nat}
      %rw SR.one_mul(one)
      %rwh h1 : {one == 1n : Nat}
      %rw NA.add_comm(1n, Nat.double(e))
      %rw SQ.mul_e(one, h1, SE.sq(acc), x, SQ.sq_r(one, h1, acc, ha), hx)
      ME.mul_step(K.np(one), LV.ev(R.to_list(x)), Nat.double(e), LV.ev(R.to_list(SE.sq(acc))), es)
    case 2n+ +k:
      Empty.absurd({LV.ev(R.to_list(SE.pow_step(2n+k, x, SE.sq(acc)))) == Nat.mod(Nat.pow(LV.ev(R.to_list(x)), Nat.add(Nat.mul(2n+k, one), Nat.double(e))), 1n+K.np(one)) : Nat}, N.lt_zero_absurd(k, hb))

def step_r(+one: Nat, +h1: {one == 1n : Nat}, +x: R.FE, +hx: {SQ.sred(one, x) == True{} : Bool}, +acc: R.FE, +ha: {SQ.sred(one, acc) == True{} : Bool}, b: Nat, +hb: {Nat.is_lt(b, 2n) == True{} : Bool}) -> {SQ.sred(one, SE.pow_step(b, x, SE.sq(acc))) == True{} : Bool}:
  match b:
    case 0n:
      SQ.sq_r(one, h1, acc, ha)
    case 1n:
      SQ.mul_r(one, h1, SE.sq(acc), x, SQ.sq_r(one, h1, acc, ha), hx)
    case 2n+ +k:
      Empty.absurd({SQ.sred(one, SE.pow_step(2n+k, x, SE.sq(acc))) == True{} : Bool}, N.lt_zero_absurd(k, hb))

def pow_r(+one: Nat, +h1: {one == 1n : Nat}, +x: R.FE, +hx: {SQ.sred(one, x) == True{} : Bool}, bs: List<&2, Nat>, +acc: R.FE, +ha: {SQ.sred(one, acc) == True{} : Bool}, +hb: {BV.all01(bs) == True{} : Bool}) -> {SQ.sred(one, SE.pow_go(x, bs, acc)) == True{} : Bool}:
  match bs:
    case Nil{}:
      ha
    case +b <> +t:
      +h0 = Lg.and_left(Nat.is_lt(b, 2n), BV.all01(t), hb)
      pow_r(one, h1, x, hx, t, SE.pow_step(b, x, SE.sq(acc)), step_r(one, h1, x, hx, acc, ha, b, h0), Lg.and_right(Nat.is_lt(b, 2n), BV.all01(t), hb))

# x^e for the exponent spelled by the bits, from acc = x^e0
def pow_e(+one: Nat, +h1: {one == 1n : Nat}, +x: R.FE, +hx: {SQ.sred(one, x) == True{} : Bool}, bs: List<&2, Nat>, +acc: R.FE, +ha: {SQ.sred(one, acc) == True{} : Bool}, +e: Nat, +he: {LV.ev(R.to_list(acc)) == Nat.mod(Nat.pow(LV.ev(R.to_list(x)), e), 1n+K.np(one)) : Nat}, +hb: {BV.all01(bs) == True{} : Bool}) -> {LV.ev(R.to_list(SE.pow_go(x, bs, acc))) == Nat.mod(Nat.pow(LV.ev(R.to_list(x)), BV.hv(bs, one, e)), 1n+K.np(one)) : Nat}:
  match bs:
    case Nil{}:
      he
    case +b <> +t:
      +h0 = Lg.and_left(Nat.is_lt(b, 2n), BV.all01(t), hb)
      pow_e(one, h1, x, hx, t, SE.pow_step(b, x, SE.sq(acc)), step_r(one, h1, x, hx, acc, ha, b, h0), Nat.add(Nat.mul(b, one), Nat.double(e)), step_e(one, h1, x, hx, acc, ha, e, he, b, h0), Lg.and_right(Nat.is_lt(b, 2n), BV.all01(t), hb))

def powl_is(a: List<&2, Nat>, +bs: List<&2, Nat>) -> {S.powl(a, bs) == S.powl_u(a, bs) : List<&2, Nat>}:
  match a:
    case Nil{}:
      {==}
    case x <> t:
      {==}

# SE.pow looks at x first
def pow_is(x: R.FE, +bs: List<&2, Nat>, +acc: R.FE) -> {SE.pow(x, bs, acc) == SE.pow_go(x, bs, acc) : R.FE}:
  match x:
    case R.FE{a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15}:
      {==}

# the same through the wrapper that looks at x first (the bits kept
# abstract, so that the checker never runs the loop on constant bits)
def pow_ev(+one: Nat, +h1: {one == 1n : Nat}, +x: R.FE, +hx: {SQ.sred(one, x) == True{} : Bool}, +bs: List<&2, Nat>, +acc: R.FE, +ha: {SQ.sred(one, acc) == True{} : Bool}, +e: Nat, +he: {LV.ev(R.to_list(acc)) == Nat.mod(Nat.pow(LV.ev(R.to_list(x)), e), 1n+K.np(one)) : Nat}, +hb: {BV.all01(bs) == True{} : Bool}) -> {LV.ev(R.to_list(SE.pow(x, bs, acc))) == Nat.mod(Nat.pow(LV.ev(R.to_list(x)), BV.hv(bs, one, e)), 1n+K.np(one)) : Nat}:
  %rw pow_is(x, bs, acc)
  pow_e(one, h1, x, hx, bs, acc, ha, e, he, hb)

def pow_rv(+one: Nat, +h1: {one == 1n : Nat}, +x: R.FE, +hx: {SQ.sred(one, x) == True{} : Bool}, +bs: List<&2, Nat>, +acc: R.FE, +ha: {SQ.sred(one, acc) == True{} : Bool}, +hb: {BV.all01(bs) == True{} : Bool}) -> {SQ.sred(one, SE.pow(x, bs, acc)) == True{} : Bool}:
  %rw pow_is(x, bs, acc)
  pow_r(one, h1, x, hx, bs, acc, ha, hb)

# ---- one ----

def one_lt(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.is_lt(1n, FS.order(one)) == True{} : Bool}:
  SO.small_lt_n(one, h1, 1n, {==})

def one_l() -> {R.to_list(SE.one()) == S.one() : List<&2, Nat>}:
  {==}

def one_r(+one: Nat, +h1: {one == 1n : Nat}) -> {SQ.sred(one, SE.one()) == True{} : Bool}:
  %goal {FS.reduced(one, FS.order(one), R.to_list(SE.one())) == True{} : Bool}
  %rw one_l()
  SO.small_r(one, h1, 1n, one_lt(one, h1))

def one_e(+one: Nat, +h1: {one == 1n : Nat}, +x: Nat) -> {LV.ev(R.to_list(SE.one())) == Nat.mod(Nat.pow(x, 0n), 1n+K.np(one)) : Nat}:
  %rw one_l()
  +ev = Equal.trans(Nat, LV.ev(S.one()), FS.value(one, S.one()), 1n, Equal.sym(Nat, FS.value(one, S.one()), LV.ev(S.one()), LV.ev_value(one, h1, S.one())), SO.small_val(one, h1, 1n, one_lt(one, h1)))
  Equal.trans(Nat, LV.ev(S.one()), 1n, Nat.mod(Nat.pow(x, 0n), 1n+K.np(one)), ev, ME.pow0(K.np(one), x, I.lt_subst_r(1n, FS.order(one), 1n+K.np(one), K.order_eq(one, h1), one_lt(one, h1))))


def xn() -> List<&2, Nat>:
  [48832n, 12233n, 41331n, 16429n, 24516n, 20663n, 8985n, 17745n, 1n, 0n, 0n, 0n, 0n, 0n, 0n, 0n]

def zeros7(+one: Nat) -> {FS.digits(one, [0n, 0n, 0n, 0n, 0n, 0n, 0n]) == 0n : Nat}:
  %goal {Nat.add(Nat.mul(one, 0n), C.shift(16n, Nat.add(Nat.mul(one, 0n), C.shift(16n, Nat.add(Nat.mul(one, 0n), C.shift(16n, Nat.add(Nat.mul(one, 0n), C.shift(16n, Nat.add(Nat.mul(one, 0n), C.shift(16n, Nat.add(Nat.mul(one, 0n), C.shift(16n, Nat.add(Nat.mul(one, 0n), C.shift(16n, 0n)))))))))))))) == 0n : Nat}
  %norm

# the trailing zero limbs add nothing
def zeros_tail(+one: Nat) -> {FS.digits(one, [12233n, 41331n, 16429n, 24516n, 20663n, 8985n, 17745n, 1n, 0n, 0n, 0n, 0n, 0n, 0n, 0n]) == FS.digits(one, [12233n, 41331n, 16429n, 24516n, 20663n, 8985n, 17745n, 1n]) : Nat}:
  %goal {FS.digits(one, [12233n, 41331n, 16429n, 24516n, 20663n, 8985n, 17745n, 1n, 0n, 0n, 0n, 0n, 0n, 0n, 0n]) == FS.digits(one, [12233n, 41331n, 16429n, 24516n, 20663n, 8985n, 17745n, 1n]) : Nat}
  %rw K.digits_split(one, 8n, [12233n, 41331n, 16429n, 24516n, 20663n, 8985n, 17745n, 1n, 0n, 0n, 0n, 0n, 0n, 0n, 0n])
  %rwh@r K.digits_split(one, 8n, [12233n, 41331n, 16429n, 24516n, 20663n, 8985n, 17745n, 1n]) : {FS.digits(one, [12233n, 41331n, 16429n, 24516n, 20663n, 8985n, 17745n, 1n]) == Nat.add(FS.digits(one, L.take(8n, [12233n, 41331n, 16429n, 24516n, 20663n, 8985n, 17745n, 1n])), LV.pos(8n, FS.digits(one, L.drop(8n, [12233n, 41331n, 16429n, 24516n, 20663n, 8985n, 17745n, 1n])))) : Nat}
  %goal {Nat.add(FS.digits(one, [12233n, 41331n, 16429n, 24516n, 20663n, 8985n, 17745n, 1n]), LV.pos(8n, FS.digits(one, [0n, 0n, 0n, 0n, 0n, 0n, 0n]))) == Nat.add(FS.digits(one, [12233n, 41331n, 16429n, 24516n, 20663n, 8985n, 17745n, 1n]), LV.pos(8n, 0n)) : Nat}
  %rw zeros7(one)
  %close

# c_n + 1
def xn_digits(+one: Nat, +h1: {one == 1n : Nat}) -> {FS.digits(one, xn()) == Nat.add(FS.cn(one), one) : Nat}:
  %goal {FS.digits(one, [48832n, 12233n, 41331n, 16429n, 24516n, 20663n, 8985n, 17745n, 1n, 0n, 0n, 0n, 0n, 0n, 0n, 0n]) == Nat.add(FS.digits(one, [48831n, 12233n, 41331n, 16429n, 24516n, 20663n, 8985n, 17745n, 1n]), one) : Nat}
  %goal {Nat.add(Nat.mul(one, 48832n), C.shift(16n, FS.digits(one, [12233n, 41331n, 16429n, 24516n, 20663n, 8985n, 17745n, 1n, 0n, 0n, 0n, 0n, 0n, 0n, 0n]))) == Nat.add(Nat.add(Nat.mul(one, 48831n), C.shift(16n, FS.digits(one, [12233n, 41331n, 16429n, 24516n, 20663n, 8985n, 17745n, 1n]))), one) : Nat}
  %rw NA.mul_succ(one, 48831n)
  %rw zeros_tail(one)
  %norm

def xn_limbs(+one: Nat, +h1: {one == 1n : Nat}) -> {FS.limbs16(one, 16n, xn()) == True{} : Bool}:
  LT.lits16(one, h1, 16n, xn(), {==})

# the bits of c_n + 1, most significant first
def xb() -> List<&2, Nat>:
  [0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n,
   0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n,
   0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n,
   0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 1n,
   0n, 1n, 0n, 0n, 0n, 1n, 0n, 1n, 0n, 1n, 0n, 1n, 0n, 0n, 0n, 1n, 0n, 0n, 1n, 0n, 0n, 0n, 1n, 1n, 0n, 0n, 0n, 1n, 1n, 0n, 0n, 1n,
   0n, 1n, 0n, 1n, 0n, 0n, 0n, 0n, 1n, 0n, 1n, 1n, 0n, 1n, 1n, 1n, 0n, 1n, 0n, 1n, 1n, 1n, 1n, 1n, 1n, 1n, 0n, 0n, 0n, 1n, 0n, 0n,
   0n, 1n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 0n, 1n, 0n, 1n, 1n, 0n, 1n, 1n, 0n, 1n, 0n, 0n, 0n, 0n, 1n, 0n, 1n, 1n, 1n, 0n, 0n, 1n, 1n,
   0n, 0n, 1n, 0n, 1n, 1n, 1n, 1n, 1n, 1n, 0n, 0n, 1n, 0n, 0n, 1n, 1n, 0n, 1n, 1n, 1n, 1n, 1n, 0n, 1n, 1n, 0n, 0n, 0n, 0n, 0n, 0n]

def bits_xb() -> {L.bits(xn()) == xb() : List<&2, Nat>}:
  {==}

def ib_lit() -> {S.inv_bits() == L.cbits(xb()) : List<&2, Nat>}:
  {==}

def xb01() -> {BV.all01(xb()) == True{} : Bool}:
  {==}

def xb_len() -> {List.length(&2, Nat, xb()) == 256n : Nat}:
  {==}

# hv(xb) = c_n + 1
def xb_v(+one: Nat, +h1: {one == 1n : Nat}) -> {BV.hv(xb(), one, 0n) == Nat.add(FS.cn(one), one) : Nat}:
  %rw <- bits_xb()
  %rw BV.bits_v(one, h1, 16n, xn(), 0n, xn_limbs(one, h1))
  %rw LV.pos_zero(16n)
  %rw xn_digits(one, h1)
  %norm

def inv_h2(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.add(FS.cn(one), Nat.add(BV.hv(S.inv_bits(), one, 0n), 2n)) == Nat.add(FS.cn(one), 1n+K.np(one)) : Nat}:
  +hcb = BV.cb(one, xb(), 0n, 0n, xb01())
  %rw ib_lit()
  %rw@r NA.add_comm(FS.cn(one), 1n+K.np(one))
  %rw K.hm_n(one, h1)
  %rwh <- hcb : {Nat.add(Nat.add(BV.hv(L.cbits(xb()), one, 0n), BV.hv(xb(), one, 0n)), one) == C.shift(256n, one) : Nat}
  %rw xb_v(one, h1)
  %rwh@5 h1 : {one == 1n : Nat}
  %rwh@5 h1 : {one == 1n : Nat}
  %norm

def exp_inv(+one: Nat, +h1: {one == 1n : Nat}) -> {BV.hv(S.inv_bits(), one, 0n) == Nat.sub(1n+K.np(one), 2n) : Nat}:
  +h = BV.hv(S.inv_bits(), one, 0n)
  +e = NR.add_cancel(FS.cn(one), Nat.add(h, 2n), 1n+K.np(one), inv_h2(one, h1))
  %rwh <- e : {Nat.add(BV.hv(S.inv_bits(), one, 0n), 2n) == 1n+K.np(one) : Nat}
  %rw NA.add_comm(BV.hv(S.inv_bits(), one, 0n), 2n)
  %rw N.add_sub_cancel(2n, BV.hv(S.inv_bits(), one, 0n))
  %close

def inv_bits01(+one: Nat) -> {BV.all01(S.inv_bits()) == True{} : Bool}:
  {==}

def inv_v(+one: Nat, +h1: {one == 1n : Nat}, +a: List<&2, Nat>, +ha: {FS.reduced(one, FS.order(one), a) == True{} : Bool}) -> {FS.value(one, S.inv(a)) == FS.minv(FS.order(one), FS.value(one, a)) : Nat}:
  %goal {FS.value(one, S.powl(a, S.inv_bits())) == FS.minv(FS.order(one), FS.value(one, a)) : Nat}
  %rw powl_is(a, S.inv_bits())
  %goal {FS.value(one, R.to_list(SE.pow(R.of_list(a), S.inv_bits(), SE.one()))) == FS.minv(FS.order(one), FS.value(one, a)) : Nat}
  %goal {FS.value(one, R.to_list(SE.pow(R.of_list(a), S.inv_bits(), SE.one()))) == Nat.mod(Nat.pow(FS.value(one, a), Nat.sub(FS.order(one), 2n)), FS.order(one)) : Nat}
  %rw LV.ev_value(one, h1, R.to_list(SE.pow(R.of_list(a), S.inv_bits(), SE.one())))
  %rw pow_ev(one, h1, R.of_list(a), SQ.rec_r(one, a, ha), S.inv_bits(), SE.one(), one_r(one, h1), 0n, one_e(one, h1, LV.ev(R.to_list(R.of_list(a)))), inv_bits01(one))
  %rw SQ.rec_l(one, a, ha)
  %rw exp_inv(one, h1)
  %rw LV.ev_value(one, h1, a)
  %rw K.order_eq(one, h1)
  %rw K.order_eq(one, h1)
  %close

def inv_r(+one: Nat, +h1: {one == 1n : Nat}, +a: List<&2, Nat>, +ha: {FS.reduced(one, FS.order(one), a) == True{} : Bool}) -> {FS.reduced(one, FS.order(one), S.inv(a)) == True{} : Bool}:
  %goal {FS.reduced(one, FS.order(one), S.powl(a, S.inv_bits())) == True{} : Bool}
  %rw powl_is(a, S.inv_bits())
  %goal {FS.reduced(one, FS.order(one), R.to_list(SE.pow(R.of_list(a), S.inv_bits(), SE.one()))) == True{} : Bool}
  pow_rv(one, h1, R.of_list(a), SQ.rec_r(one, a, ha), S.inv_bits(), SE.one(), one_r(one, h1), inv_bits01(one))
