import Base
import ../../../spec/lib/common.bend as C
import ../../../spec/crypto/secp256k1/field.bend as FS
import ../../../spec/crypto/secp256k1/curve.bend as CV
import ../../../spec/crypto/secp256k1/ecdsa.bend as ES
import ../../../src/crypto/secp256k1/scalar.bend as S
import ../../../src/crypto/secp256k1/bytes.bend as B
import ../../../src/crypto/secp256k1/point.bend as P
import ../../../src/crypto/secp256k1/ecdsa.bend as E
import ../../lib/nat.bend as N
import ./limbs.bend as LV
import ./fprot.bend as FR
import ./scalarops.bend as SO
import ./fwrap.bend as FW
import ./bytes.bend as BY
import ./point.bend as PT
import ./pmul.bend as PM
import ./paff.bend as PA
import ./penc.bend as PE
import ./pdec.bend as PD

# Scalars from bytes and public keys of src/crypto/secp256k1/ecdsa.bend
# against spec/crypto/secp256k1/ecdsa.bend.

# ---- scalars ----

def scalar_ok_v(+one: Nat, +h1: {one == 1n : Nat}, +x: List<&2, Nat>) -> {E.scalar_ok(x) == ES.scalar_ok(one, FS.value(one, x)) : Bool}:
  %goal {Bool.and(Bool.not(S.is_zero(x)), S.lt_n(x)) == Bool.and(Bool.not(Nat.is_eq(FS.value(one, x), 0n)), Nat.is_lt(FS.value(one, x), FS.order(one))) : Bool}
  %rw FW.is_zero_s(one, h1, x)
  %rw FW.lt_n_s(one, h1, x)
  %close

# a 16-limb value is below 2^512
def ev512(+one: Nat, +h1: {one == 1n : Nat}, +x: List<&2, Nat>, +hx: {FS.limbs16(one, 16n, x) == True{} : Bool}) -> {Nat.is_lt(LV.ev(x), Nat.mul(C.shift(256n, one), C.shift(256n, one))) == True{} : Bool}:
  +t = C.shift(256n, one)
  SO.lt3(one, h1, LV.ev(x), N.lt_le_trans(LV.ev(x), t, Nat.add(t, Nat.add(t, t)), SO.tt_lt(one, h1, x, hx), N.le_add_right(t, Nat.add(t, t))))

# x mod n for a 16-limb x
def sred_v(+one: Nat, +h1: {one == 1n : Nat}, +x: List<&2, Nat>, +hx: {FS.limbs16(one, 16n, x) == True{} : Bool}) -> {FS.value(one, S.reduce(x)) == Nat.mod(FS.value(one, x), FS.order(one)) : Nat}:
  %rw FR.s_reduce(x)
  %rw SO.red_v(one, h1, x, ev512(one, h1, x, hx))
  %rw LV.ev_value(one, h1, x)
  %close

def sred_r(+one: Nat, +h1: {one == 1n : Nat}, +x: List<&2, Nat>, +hx: {FS.limbs16(one, 16n, x) == True{} : Bool}) -> {FS.reduced(one, FS.order(one), S.reduce(x)) == True{} : Bool}:
  %rw FR.s_reduce(x)
  SO.red_r(one, h1, x, ev512(one, h1, x, hx))

def hash_v(+one: Nat, +h1: {one == 1n : Nat}, +h: List<&2, U32>, +hl: {B.has_len(32n, h) == True{} : Bool}) -> {FS.value(one, E.hash_scalar(h)) == ES.hash_scalar(one, h) : Nat}:
  %goal {FS.value(one, S.reduce(B.of_be(h))) == Nat.mod(CV.os2ip(h), FS.order(one)) : Nat}
  %rw sred_v(one, h1, B.of_be(h), BY.of_be_limbs(one, h1, h, hl))
  %rw BY.of_be_value(one, h1, h)
  %close

def hash_r(+one: Nat, +h1: {one == 1n : Nat}, +h: List<&2, U32>, +hl: {B.has_len(32n, h) == True{} : Bool}) -> {FS.reduced(one, FS.order(one), E.hash_scalar(h)) == True{} : Bool}:
  sred_r(one, h1, B.of_be(h), BY.of_be_limbs(one, h1, h, hl))

# ---- public keys ----

def pk_v(+one: Nat, +h1: {one == 1n : Nat}, c: Bool, +q: P.Point, +hq: {PT.pred(one, q) == True{} : Bool}) -> {E.pk_of(c, q) == ES.pk_of(one, c, PT.pv(one, q)) : List<&2, U32>}:
  match c:
    case True{}:
      PE.encode_compressed_v(one, h1, q, hq)
    case False{}:
      PE.encode_uncompressed_v(one, h1, q, hq)

# [d] G
def pubpt_v(+one: Nat, +h1: {one == 1n : Nat}, +d: List<&2, Nat>, +hd: {FS.limbs16(one, 16n, d) == True{} : Bool}) -> {PT.pv(one, E.public_point(d)) == CV.pmul(FS.prime(one), FS.value(one, d), CV.g(one)) : CV.SPoint}:
  %goal {PT.pv(one, P.mul(d, P.g())) == CV.pmul(FS.prime(one), FS.value(one, d), CV.g(one)) : CV.SPoint}
  %rw PM.mul_v(one, h1, d, P.g(), hd, PA.g_r(one, h1))
  %rw PA.g_v(one, h1)
  %close

def pubpt_r(+one: Nat, +h1: {one == 1n : Nat}, +d: List<&2, Nat>, +hd: {FS.limbs16(one, 16n, d) == True{} : Bool}) -> {PT.pred(one, E.public_point(d)) == True{} : Bool}:
  PM.mul_r(one, h1, d, P.g(), hd, PA.g_r(one, h1))

def pub_ok(+one: Nat, +h1: {one == 1n : Nat}, c: Bool, +d: List<&2, Nat>, +hd: {FS.limbs16(one, 16n, d) == True{} : Bool}, b: Bool) -> {E.public_key_d(c, E.secret_if(d, b)) == ES.public_d(one, c, FS.value(one, d), b) : Maybe<&2, List<&2, U32>>}:
  match b:
    case True{}:
      %goal {Some{E.pk_of(c, E.public_point(d))} == Some{ES.pk_of(one, c, CV.pmul(FS.prime(one), FS.value(one, d), CV.g(one)))} : Maybe<&2, List<&2, U32>>}
      %rw pk_v(one, h1, c, E.public_point(d), pubpt_r(one, h1, d, hd))
      %rw pubpt_v(one, h1, d, hd)
      %close
    case False{}:
      {==}

def pub_len(+one: Nat, +h1: {one == 1n : Nat}, c: Bool, +sk: List<&2, U32>, a: Bool, +ha: {B.has_len(32n, sk) == a : Bool}) -> {E.public_key_d(c, E.secret_if(B.of_be(sk), Bool.and(a, E.scalar_ok(B.of_be(sk))))) == ES.public_d(one, c, CV.os2ip(sk), Bool.and(a, ES.scalar_ok(one, CV.os2ip(sk)))) : Maybe<&2, List<&2, U32>>}:
  match a:
    case True{}:
      +hd = BY.of_be_limbs(one, h1, sk, ha)
      %rw scalar_ok_v(one, h1, B.of_be(sk))
      %rw <- BY.of_be_value(one, h1, sk)
      %rw <- BY.of_be_value(one, h1, sk)
      pub_ok(one, h1, c, B.of_be(sk), hd, ES.scalar_ok(one, FS.value(one, B.of_be(sk))))
    case False{}:
      {==}

# the SEC 1 public key of a secret key
def public_key_v(+one: Nat, +h1: {one == 1n : Nat}, +sk: List<&2, U32>, c: Bool) -> {E.public_key(sk, c) == ES.public_key(one, sk, c) : Maybe<&2, List<&2, U32>>}:
  %goal {E.public_key_d(c, E.secret_if(B.of_be(sk), Bool.and(B.has_len(32n, sk), E.scalar_ok(B.of_be(sk))))) == ES.public_d(one, c, CV.os2ip(sk), Bool.and(CV.length_is(32n, sk), ES.scalar_ok(one, CV.os2ip(sk)))) : Maybe<&2, List<&2, U32>>}
  %rw PD.hl_is(32n, sk)
  pub_len(one, h1, c, sk, CV.length_is(32n, sk), PD.hl_is(32n, sk))
