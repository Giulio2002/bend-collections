# Scalar multiplication (src/crypto/secp256k1/point.bend mul: masked
# double-and-add over the 256 bits of the scalar, most significant first;
# mul_pub: the addition only for a set bit) computes the specification's
# pmul (spec/crypto/secp256k1/curve.bend) on the values of the coordinates
# (the loops on records: ptm.bend).
# ---- the specification's loop over a list of bits ----

def go_sb(i: Nat, +k: Nat) -> {CV.bits_go(i, k) == BR.sb(i, 0n, k) : List<&2, Nat>}:
  match i:
    case 0n:
      {==}
    case 1n+ +j:
      Equal.cong(List<&2, Nat>, List<&2, Nat>, l => CV.bit(j, k) <> l, CV.bits_go(j, k), BR.sb(j, 0n, k), go_sb(j, k))

def bits_is(+i: Nat, k: Nat) -> {CV.bits(i, k) == CV.bits_go(i, k) : List<&2, Nat>}:
  match k:
    case 0n:
      {==}
    case 1n+j:
      {==}

# ---- the linear-time bit list ----

def app_assoc(+xs: List<&2, Nat>, +ys: List<&2, Nat>, +zs: List<&2, Nat>) -> {List.append(&2, Nat, List.append(&2, Nat, xs, ys), zs) == List.append(&2, Nat, xs, List.append(&2, Nat, ys, zs)) : List<&2, Nat>}:
  match xs:
    case Nil{}:
      {==}
    case +h <> +t:
      Equal.cong(List<&2, Nat>, List<&2, Nat>, l => h <> l, List.append(&2, Nat, List.append(&2, Nat, t, ys), zs), List.append(&2, Nat, t, List.append(&2, Nat, ys, zs)), app_assoc(t, ys, zs))

def app_nil(+xs: List<&2, Nat>) -> {List.append(&2, Nat, xs, Nil{}) == xs : List<&2, Nat>}:
  match xs:
    case Nil{}:
      {==}
    case +h <> +t:
      Equal.cong(List<&2, Nat>, List<&2, Nat>, l => h <> l, List.append(&2, Nat, t, Nil{}), t, app_nil(t))

def acc_is(k: Nat, +x: Nat, +acc: List<&2, Nat>) -> {L.bits_acc(k, x, acc) == List.append(&2, Nat, L.bits_of(k, x), acc) : List<&2, Nat>}:
  match k:
    case 0n:
      {==}
    case 1n+ +j:
      %goal {L.bits_acc(j, Nat.div(x, 2n), Nat.mod(x, 2n) <> acc) == List.append(&2, Nat, List.append(&2, Nat, L.bits_of(j, Nat.div(x, 2n)), [Nat.mod(x, 2n)]), acc) : List<&2, Nat>}
      %rw acc_is(j, Nat.div(x, 2n), Nat.mod(x, 2n) <> acc)
      %rw app_assoc(L.bits_of(j, Nat.div(x, 2n)), [Nat.mod(x, 2n)], acc)
      %close

def go_is(xs: List<&2, Nat>, +acc: List<&2, Nat>) -> {L.bits_go(xs, acc) == List.append(&2, Nat, L.bits(xs), acc) : List<&2, Nat>}:
  match xs:
    case Nil{}:
      {==}
    case +x <> +t:
      %goal {L.bits_go(t, L.bits_acc(16n, x, acc)) == List.append(&2, Nat, List.append(&2, Nat, L.bits(t), L.bits_of(16n, x)), acc) : List<&2, Nat>}
      %rw go_is(t, L.bits_acc(16n, x, acc))
      %rw acc_is(16n, x, acc)
      %rw app_assoc(L.bits(t), L.bits_of(16n, x), acc)
      %close

def bitsf_is(+xs: List<&2, Nat>) -> {L.bitsf(xs) == L.bits(xs) : List<&2, Nat>}:
  %goal {L.bits_go(xs, Nil{}) == L.bits(xs) : List<&2, Nat>}
  %rw go_is(xs, Nil{})
  %rw app_nil(L.bits(xs))
  %close

# the bits of a scalar's limbs are the specification's bits of its value
def lbits(+one: Nat, +h1: {one == 1n : Nat}, +ks: List<&2, Nat>, +hk: {FS.limbs16(one, 16n, ks) == True{} : Bool}) -> {L.bitsf(ks) == CV.bits(256n, FS.value(one, ks)) : List<&2, Nat>}:
  %rw bitsf_is(ks)
  %rw BR.bits_sb(one, h1, 16n, ks, hk)
  %rw bits_is(256n, FS.value(one, ks))
  %rw go_sb(256n, FS.value(one, ks))
  %rw LV.ev_value(one, h1, ks)
  %close

# ---- [k] P ----

# the bits of a scalar are bits
def lbits01(+one: Nat, +h1: {one == 1n : Nat}, +ks: List<&2, Nat>, +hk: {FS.limbs16(one, 16n, ks) == True{} : Bool}) -> {BV.all01(L.bitsf(ks)) == True{} : Bool}:
  %rw bitsf_is(ks)
  %rw BR.bits_sb(one, h1, 16n, ks, hk)
  SL.sb01(256n, 0n, LV.ev(ks))

# ---- the window multiplication (pt.bend wmul, proofs pwin.bend) ----

# 16 more bits keep a multiple of 4
def ok4_app(u: List<&2, Nat>, +c1: Nat, +c2: Nat, +c3: Nat, +c4: Nat, +c5: Nat, +c6: Nat, +c7: Nat, +c8: Nat, +c9: Nat, +c10: Nat, +c11: Nat, +c12: Nat, +c13: Nat, +c14: Nat, +c15: Nat, +c16: Nat) -> {WR.ok4(List.append(&2, Nat, u, [c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15, c16])) == WR.ok4(u) : Bool}:
  match u:
    case Nil{}:
      {==}
    case +x1 <> Nil{}:
      {==}
    case +x1 <> +x2 <> Nil{}:
      {==}
    case +x1 <> +x2 <> +x3 <> Nil{}:
      {==}
    case +x1 <> +x2 <> +x3 <> +x4 <> +t:
      ok4_app(t, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15, c16)

def ok4_bits(xs: List<&2, Nat>) -> {WR.ok4(L.bits(xs)) == True{} : Bool}:
  match xs:
    case Nil{}:
      {==}
    case +x <> +t:
      %goal {WR.ok4(List.append(&2, Nat, L.bits(t), [Nat.mod(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(x, 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), Nat.mod(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(x, 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), Nat.mod(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(x, 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), Nat.mod(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(x, 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), Nat.mod(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(x, 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), Nat.mod(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(x, 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), Nat.mod(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(x, 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), Nat.mod(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(x, 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), Nat.mod(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(x, 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), Nat.mod(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(x, 2n), 2n), 2n), 2n), 2n), 2n), 2n), Nat.mod(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(x, 2n), 2n), 2n), 2n), 2n), 2n), Nat.mod(Nat.div(Nat.div(Nat.div(Nat.div(x, 2n), 2n), 2n), 2n), 2n), Nat.mod(Nat.div(Nat.div(Nat.div(x, 2n), 2n), 2n), 2n), Nat.mod(Nat.div(Nat.div(x, 2n), 2n), 2n), Nat.mod(Nat.div(x, 2n), 2n), Nat.mod(x, 2n)])) == True{} : Bool}
      %rw ok4_app(L.bits(t), Nat.mod(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(x, 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), Nat.mod(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(x, 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), Nat.mod(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(x, 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), Nat.mod(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(x, 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), Nat.mod(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(x, 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), Nat.mod(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(x, 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), Nat.mod(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(x, 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), Nat.mod(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(x, 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), Nat.mod(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(x, 2n), 2n), 2n), 2n), 2n), 2n), 2n), 2n), Nat.mod(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(x, 2n), 2n), 2n), 2n), 2n), 2n), 2n), Nat.mod(Nat.div(Nat.div(Nat.div(Nat.div(Nat.div(x, 2n), 2n), 2n), 2n), 2n), 2n), Nat.mod(Nat.div(Nat.div(Nat.div(Nat.div(x, 2n), 2n), 2n), 2n), 2n), Nat.mod(Nat.div(Nat.div(Nat.div(x, 2n), 2n), 2n), 2n), Nat.mod(Nat.div(Nat.div(x, 2n), 2n), 2n), Nat.mod(Nat.div(x, 2n), 2n), Nat.mod(x, 2n))
      ok4_bits(t)

def ok4_f(+ks: List<&2, Nat>) -> {WR.ok4(L.bitsf(ks)) == True{} : Bool}:
  %rw bitsf_is(ks)
  ok4_bits(ks)

def mul_r(+one: Nat, +h1: {one == 1n : Nat}, +ks: List<&2, Nat>, +pp: P.Point, +hk: {FS.limbs16(one, 16n, ks) == True{} : Bool}, +hp: {PT.pred(one, pp) == True{} : Bool}) -> {PT.pred(one, P.mul(ks, pp)) == True{} : Bool}:
  PT.op_r(one, PX.wmul(L.bitsf(ks), P.to_pt(pp)), WR.wmul_r(one, h1, L.bitsf(ks), P.to_pt(pp), PT.tp_r(one, pp, hp), lbits01(one, h1, ks, hk), ok4_f(ks)))

def mul_pub_r(+one: Nat, +h1: {one == 1n : Nat}, +ks: List<&2, Nat>, +pp: P.Point, +hk: {FS.limbs16(one, 16n, ks) == True{} : Bool}, +hp: {PT.pred(one, pp) == True{} : Bool}) -> {PT.pred(one, P.mul_pub(ks, pp)) == True{} : Bool}:
  PT.op_r(one, PX.vmul_go(L.bitsf(ks), P.to_pt(pp), PX.infinity()), PM.vmul_go_r(one, h1, L.bitsf(ks), P.to_pt(pp), PX.infinity(), lbits01(one, h1, ks, hk), PT.tp_r(one, pp, hp), PM.pinf_r(one, h1)))

def mul_pub_v(+one: Nat, +h1: {one == 1n : Nat}, +ks: List<&2, Nat>, +pp: P.Point, +hk: {FS.limbs16(one, 16n, ks) == True{} : Bool}, +hp: {PT.pred(one, pp) == True{} : Bool}) -> {PT.pv(one, P.mul_pub(ks, pp)) == CV.pmul(FS.prime(one), FS.value(one, ks), PT.pv(one, pp)) : CV.SPoint}:
  %goal {PT.pv(one, P.of_pt(PX.vmul_go(L.bitsf(ks), P.to_pt(pp), PX.infinity()))) == CV.lmul(FS.prime(one), CV.bits(256n, FS.value(one, ks)), PT.pv(one, pp), CV.infinity()) : CV.SPoint}
  %rw PT.op_v(one, PX.vmul_go(L.bitsf(ks), P.to_pt(pp), PX.infinity()))
  %rw PM.vmul_go_v(one, h1, L.bitsf(ks), P.to_pt(pp), PX.infinity(), lbits01(one, h1, ks, hk), PT.tp_r(one, pp, hp), PM.pinf_r(one, h1))
  %rw PM.pinf_v(one, h1)
  %rw PT.tp_v(one, pp, hp)
  %rw lbits(one, h1, ks, hk)
  %close
