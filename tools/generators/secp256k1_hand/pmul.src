import Base
import ../../../spec/crypto/secp256k1/field.bend as FS
import ../../../spec/crypto/secp256k1/curve.bend as CV
import ../../../src/crypto/secp256k1/limbs.bend as L
import ../../../src/crypto/secp256k1/field.bend as F
import ../../../src/crypto/secp256k1/point.bend as P
import ../../lib/logic.bend as Lg
import ./limbs.bend as LV
import ./fieldops.bend as FO
import ./bitsv.bend as BV
import ./bitsrel.bend as BR
import ./point.bend as PT
import ./sel.bend as SL
import ./ptm.bend as PM
import ./ptp.bend as PP
import ../../../src/crypto/secp256k1/pt.bend as PX

# Scalar multiplication (src/crypto/secp256k1/point.bend mul: masked
# double-and-add over the 256 bits of the scalar, most significant first;
# mul_pub: the addition only for a set bit) computes the specification's
# pmul (spec/crypto/secp256k1/curve.bend) on the values of the coordinates
# (the loops on records: ptm.bend).
# ---- the specification's loop over a list of bits ----

def go_sb(i: Nat, +k: Nat) -> {CV.bits_go(i, k) == BR.sb(i, 0n, k) : List<&2, Nat>}:
  match i:
    case 0n:
      {==}
    case 1n+ +j:
      Equal.cong(List<&2, Nat>, List<&2, Nat>, l => CV.bit(j, k) <> l, CV.bits_go(j, k), BR.sb(j, 0n, k), go_sb(j, k))

def bits_is(+i: Nat, k: Nat) -> {CV.bits(i, k) == CV.bits_go(i, k) : List<&2, Nat>}:
  match k:
    case 0n:
      {==}
    case 1n+j:
      {==}

# the bits of a scalar's limbs are the specification's bits of its value
def lbits(+one: Nat, +h1: {one == 1n : Nat}, +ks: List<&2, Nat>, +hk: {FS.limbs16(one, 16n, ks) == True{} : Bool}) -> {L.bits(ks) == CV.bits(256n, FS.value(one, ks)) : List<&2, Nat>}:
  %rw BR.bits_sb(one, h1, 16n, ks, hk)
  %rw bits_is(256n, FS.value(one, ks))
  %rw go_sb(256n, FS.value(one, ks))
  %rw LV.ev_value(one, h1, ks)
  %close

# ---- [k] P ----

# the bits of a scalar are bits
def lbits01(+one: Nat, +h1: {one == 1n : Nat}, +ks: List<&2, Nat>, +hk: {FS.limbs16(one, 16n, ks) == True{} : Bool}) -> {BV.all01(L.bits(ks)) == True{} : Bool}:
  %rw BR.bits_sb(one, h1, 16n, ks, hk)
  SL.sb01(256n, 0n, LV.ev(ks))

def mul_r(+one: Nat, +h1: {one == 1n : Nat}, +ks: List<&2, Nat>, +pp: P.Point, +hk: {FS.limbs16(one, 16n, ks) == True{} : Bool}, +hp: {PT.pred(one, pp) == True{} : Bool}) -> {PT.pred(one, P.mul(ks, pp)) == True{} : Bool}:
  PT.op_r(one, PX.mul_go(L.bits(ks), P.to_pt(pp), PX.infinity()), PM.mul_go_r(one, h1, L.bits(ks), P.to_pt(pp), PX.infinity(), lbits01(one, h1, ks, hk), PT.tp_r(one, pp, hp), PM.pinf_r(one, h1)))

def mul_v(+one: Nat, +h1: {one == 1n : Nat}, +ks: List<&2, Nat>, +pp: P.Point, +hk: {FS.limbs16(one, 16n, ks) == True{} : Bool}, +hp: {PT.pred(one, pp) == True{} : Bool}) -> {PT.pv(one, P.mul(ks, pp)) == CV.pmul(FS.prime(one), FS.value(one, ks), PT.pv(one, pp)) : CV.SPoint}:
  %goal {PT.pv(one, P.of_pt(PX.mul_go(L.bits(ks), P.to_pt(pp), PX.infinity()))) == CV.lmul(FS.prime(one), CV.bits(256n, FS.value(one, ks)), PT.pv(one, pp), CV.infinity()) : CV.SPoint}
  %rw PT.op_v(one, PX.mul_go(L.bits(ks), P.to_pt(pp), PX.infinity()))
  %rw PM.mul_go_v(one, h1, L.bits(ks), P.to_pt(pp), PX.infinity(), lbits01(one, h1, ks, hk), PT.tp_r(one, pp, hp), PM.pinf_r(one, h1))
  %rw PM.pinf_v(one, h1)
  %rw PT.tp_v(one, pp, hp)
  %rw lbits(one, h1, ks, hk)
  %close

def mul_pub_r(+one: Nat, +h1: {one == 1n : Nat}, +ks: List<&2, Nat>, +pp: P.Point, +hk: {FS.limbs16(one, 16n, ks) == True{} : Bool}, +hp: {PT.pred(one, pp) == True{} : Bool}) -> {PT.pred(one, P.mul_pub(ks, pp)) == True{} : Bool}:
  PT.op_r(one, PX.vmul_go(L.bits(ks), P.to_pt(pp), PX.infinity()), PM.vmul_go_r(one, h1, L.bits(ks), P.to_pt(pp), PX.infinity(), lbits01(one, h1, ks, hk), PT.tp_r(one, pp, hp), PM.pinf_r(one, h1)))

def mul_pub_v(+one: Nat, +h1: {one == 1n : Nat}, +ks: List<&2, Nat>, +pp: P.Point, +hk: {FS.limbs16(one, 16n, ks) == True{} : Bool}, +hp: {PT.pred(one, pp) == True{} : Bool}) -> {PT.pv(one, P.mul_pub(ks, pp)) == CV.pmul(FS.prime(one), FS.value(one, ks), PT.pv(one, pp)) : CV.SPoint}:
  %goal {PT.pv(one, P.of_pt(PX.vmul_go(L.bits(ks), P.to_pt(pp), PX.infinity()))) == CV.lmul(FS.prime(one), CV.bits(256n, FS.value(one, ks)), PT.pv(one, pp), CV.infinity()) : CV.SPoint}
  %rw PT.op_v(one, PX.vmul_go(L.bits(ks), P.to_pt(pp), PX.infinity()))
  %rw PM.vmul_go_v(one, h1, L.bits(ks), P.to_pt(pp), PX.infinity(), lbits01(one, h1, ks, hk), PT.tp_r(one, pp, hp), PM.pinf_r(one, h1))
  %rw PM.pinf_v(one, h1)
  %rw PT.tp_v(one, pp, hp)
  %rw lbits(one, h1, ks, hk)
  %close
