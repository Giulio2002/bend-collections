          sgo_e(one, h1, hp, hc, rb, rc, a, b, ha, hb, va, vb, PX.add(PX.add(PX.dbl(PX.dbl(PX.dbl(PX.dbl(r)))), PX.tpick(b1, b2, b3, b4, PX.tab(a))), PX.tpick(c1, c2, c3, c4, PX.tab(b))), G4.nxt(b4, G4.nxt(b3, G4.nxt(b2, G4.nxt(b1, v)))), G4.nxt(c4, G4.nxt(c3, G4.nxt(c2, G4.nxt(c1, w)))), WR.st_r(one, h1, a, b, r, ha, hb, hr, b1, b2, b3, b4, c1, c2, c3, c4), st_vd(one, h1, hp, hc, a, b, ha, hb, va, vb, r, hr, vr, b1, b2, b3, b4, c1, c2, c3, c4), st_e(one, h1, hp, hc, a, b, ha, hb, va, vb, r, v, w, hr, vr, he, b1, hb1, b2, hb2, b3, hb3, b4, hb4, c1, hc1, c2, hc2, c3, hc3, c4, hc4), hbt, hct, hq)

# the point at infinity is J(0, 0)
def j00(+one: Nat, +h1: {one == 1n : Nat}, +hp: NP.Prime(FS.prime(one)), +hc: {Nat.is_eq(FS.mpow(FS.prime(one), Nat.sub(FS.prime(one), 7n), Nat.div(Nat.sub(FS.prime(one), 1n), 3n)), 1n) == False{} : Bool}, +a: PX.PT, +b: PX.PT, +ha: {PP.pred(one, a) == True{} : Bool}, +hb: {PP.pred(one, b) == True{} : Bool}, +va: {GS.valid(FS.prime(one), PP.pv(one, a)) == True{} : Bool}, +vb: {GS.valid(FS.prime(one), PP.pv(one, b)) == True{} : Bool}) -> {GS.equiv(FS.prime(one), PP.pv(one, PX.infinity()), CV.padd(FS.prime(one), GS.smul(FS.prime(one), 0n, PP.pv(one, a)), GS.smul(FS.prime(one), 0n, PP.pv(one, b)))) == True{} : Bool}:
  %rw PM.pinf_v(one, h1)
  GP.equiv_sym(one, h1, hp, hc, CV.padd(FS.prime(one), GS.smul(FS.prime(one), 0n, PP.pv(one, a)), GS.smul(FS.prime(one), 0n, PP.pv(one, b))), CV.infinity(), GP.group_identity(one, h1, hp, hc, CV.infinity()))

def smul2_vd(+one: Nat, +h1: {one == 1n : Nat}, +hp: NP.Prime(FS.prime(one)), +hc: {Nat.is_eq(FS.mpow(FS.prime(one), Nat.sub(FS.prime(one), 7n), Nat.div(Nat.sub(FS.prime(one), 1n), 3n)), 1n) == False{} : Bool}, bs: List<&2, Nat>, +cs: List<&2, Nat>, +a: PX.PT, +b: PX.PT, +ha: {PP.pred(one, a) == True{} : Bool}, +hb: {PP.pred(one, b) == True{} : Bool}, +va: {GS.valid(FS.prime(one), PP.pv(one, a)) == True{} : Bool}, +vb: {GS.valid(FS.prime(one), PP.pv(one, b)) == True{} : Bool}) -> {GS.valid(FS.prime(one), PP.pv(one, PX.smul2(bs, cs, a, b))) == True{} : Bool}:
  match bs:
    case Nil{}:
      inf_vd(one, h1, hp, hc)
    case +x <> +t:
      sgo_vd(one, h1, hp, hc, x <> t, cs, a, b, ha, hb, va, vb, PX.infinity(), PM.pinf_r(one, h1), inf_vd(one, h1, hp, hc))

# smul2(bits j, bits k, a, b) is [j] a + [k] b
def smul2_e(+one: Nat, +h1: {one == 1n : Nat}, +hp: NP.Prime(FS.prime(one)), +hc: {Nat.is_eq(FS.mpow(FS.prime(one), Nat.sub(FS.prime(one), 7n), Nat.div(Nat.sub(FS.prime(one), 1n), 3n)), 1n) == False{} : Bool}, bs: List<&2, Nat>, +cs: List<&2, Nat>, +a: PX.PT, +b: PX.PT, +ha: {PP.pred(one, a) == True{} : Bool}, +hb: {PP.pred(one, b) == True{} : Bool}, +va: {GS.valid(FS.prime(one), PP.pv(one, a)) == True{} : Bool}, +vb: {GS.valid(FS.prime(one), PP.pv(one, b)) == True{} : Bool}, +hbb: {BV.all01(bs) == True{} : Bool}, +hcc: {BV.all01(cs) == True{} : Bool}, +hq: {WR.ok44(bs, cs) == True{} : Bool}) -> {GS.equiv(FS.prime(one), PP.pv(one, PX.smul2(bs, cs, a, b)), CV.padd(FS.prime(one), GS.smul(FS.prime(one), G4.bvl(bs, 0n), PP.pv(one, a)), GS.smul(FS.prime(one), G4.bvl(cs, 0n), PP.pv(one, b)))) == True{} : Bool}:
  match bs:
    case Nil{}:
      match cs:
        case Nil{}:
          j00(one, h1, hp, hc, a, b, ha, hb, va, vb)
        case +c <> +t:
          Empty.absurd({GS.equiv(FS.prime(one), PP.pv(one, PX.smul2(Nil{}, c <> t, a, b)), CV.padd(FS.prime(one), GS.smul(FS.prime(one), G4.bvl(Nil{}, 0n), PP.pv(one, a)), GS.smul(FS.prime(one), G4.bvl(c <> t, 0n), PP.pv(one, b)))) == True{} : Bool}, Lg.false_true(hq))
    case +x <> +t:
      sgo_e(one, h1, hp, hc, x <> t, cs, a, b, ha, hb, va, vb, PX.infinity(), 0n, 0n, PM.pinf_r(one, h1), inf_vd(one, h1, hp, hc), j00(one, h1, hp, hc, a, b, ha, hb, va, vb), hbb, hcc, hq)
