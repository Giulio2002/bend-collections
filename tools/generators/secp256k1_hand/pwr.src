      +hb4 = Lg.and_left(Nat.is_lt(b4, 2n), BV.all01(t), c3)
      +hbt = Lg.and_right(Nat.is_lt(b4, 2n), BV.all01(t), c3)
      wgo_r(one, h1, t, a, PX.add(PX.dbl(PX.dbl(PX.dbl(PX.dbl(r)))), PX.tsel(b1, b2, b3, b4, PX.tab(a))), ha, wst_r(one, h1, a, r, ha, hr, b1, b2, b3, b4, hb1, hb2, hb3, hb4), hbt, hq)

def wmul_r(+one: Nat, +h1: {one == 1n : Nat}, bs: List<&2, Nat>, +a: PX.PT, +ha: {PP.pred(one, a) == True{} : Bool}, +hb: {BV.all01(bs) == True{} : Bool}, +hq: {ok4(bs) == True{} : Bool}) -> {PP.pred(one, PX.wmul(bs, a)) == True{} : Bool}:
  match bs:
    case Nil{}:
      PM.pinf_r(one, h1)
    case +b <> +t:
      wgo_r(one, h1, b <> t, a, PX.infinity(), ha, PM.pinf_r(one, h1), hb, hq)
