def ok4(xs: List<&2, Nat>) -> Bool:
  match xs:
    case Nil{}: True{}
    case b1 <> Nil{}: False{}
    case b1 <> b2 <> Nil{}: False{}
    case b1 <> b2 <> b3 <> Nil{}: False{}
    case b1 <> b2 <> b3 <> b4 <> t: ok4(t)

