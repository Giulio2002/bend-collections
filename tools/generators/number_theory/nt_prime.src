import Base
import ../../../spec/math/number.bend as SN
import ../../../src/math/number.bend as NB
import ../../../src/math/natural.bend as M
import ./prime.bend as PR
import ./egcd.bend as EG
import ../natural/gcd.bend as G
import ../natural/arith.bend as NR
import ../../lib/nat.bend as N
import ../../lib/logic.bend as Lg
import ../../lib/lemmas/proofs/nat_algebra.bend as NA
import ../typed/width.bend as WW
import ../../crypto/secp256k1/semiring.bend as SR

# Primes and Euclid's lemma, for the elliptic-curve group laws (any modulus).
#
# Prime(n) is the repo's trial-division predicate SN.prime(n) == True (2 <= n
# and no d in [2, n) divides n; Lean 4 Mathlib Nat.Prime). It is a Bool
# equation, hence Data: a hypothesis hp : Prime(p) may be used any number of
# times (a universally quantified function hypothesis could be used once).
# The usual reading is prime_div: every divisor d > 1 of n (n == k d) is n.
# Small literal primes: small_prime (the repo's sqrt-bounded trial division
# NB.is_prime, computed by the checker).
#
# Divisibility is stated as Nat.mod(x, n) == 0n; the modulus of a prime is
# written 2n+pp (every prime is at least 2), the modulus of the arithmetic
# lemmas 1n+bp.

def Prime(+n: Nat) -> Data:
  {SN.prime(n) == True{} : Bool}

# ---- divisibility helpers ----

# k n mod n == 0
def mod_mul0(+bp: Nat, +k: Nat) -> {Nat.mod(Nat.mul(k, 1n+bp), 1n+bp) == 0n : Nat}:
  %rw <- NA.add_zero(Nat.mul(k, 1n+bp))
  %rw NR.absorb(bp, k, 0n)
  %close

# x mod n == 0 gives x == (x / n) n
def mod0_eq(+bp: Nat, +x: Nat, +h: {Nat.mod(x, 1n+bp) == 0n : Nat}) -> {x == Nat.mul(Nat.div(x, 1n+bp), 1n+bp) : Nat}:
  %rw@l NR.dm_eq(bp, x)
  %rwh h : {Nat.mod(x, 1n+bp) == 0n : Nat}
  %rw NA.add_zero(Nat.mul(Nat.div(x, 1n+bp), 1n+bp))
  %close

# x == k n gives x mod n == 0
def eq_mod0(+bp: Nat, +x: Nat, +k: Nat, +h: {x == Nat.mul(k, 1n+bp) : Nat}) -> {Nat.mod(x, 1n+bp) == 0n : Nat}:
  %rwh h : {x == Nat.mul(k, 1n+bp) : Nat}
  %rw mod_mul0(bp, k)
  %close

# (x + k n) mod n == x mod n
def mod_add_mul(+bp: Nat, +x: Nat, +k: Nat) -> {Nat.mod(Nat.add(x, Nat.mul(k, 1n+bp)), 1n+bp) == Nat.mod(x, 1n+bp) : Nat}:
  %rw NA.add_comm(x, Nat.mul(k, 1n+bp))
  %rw NR.absorb(bp, k, x)
  %close

# 0 < n == k d gives d <= n
def dvd_le(+n: Nat, k: Nat, +d: Nat, +e: {n == Nat.mul(k, d) : Nat}, +h: {Nat.is_lt(0n, n) == True{} : Bool}) -> {Nat.is_le(d, n) == True{} : Bool}:
  match k:
    case 0n:
      Empty.absurd({Nat.is_le(d, n) == True{} : Bool}, Lg.false_true(Equal.trans(Bool, False{}, Nat.is_lt(0n, n), True{}, Equal.cong(Nat, Bool, z => Nat.is_lt(0n, z), 0n, n, Equal.sym(Nat, n, 0n, e)), h)))
    case 1n+ +kp:
      %goal {Nat.is_le(d, n) == True{} : Bool}
      %rwh e : {n == Nat.mul(1n+kp, d) : Nat}
      N.le_add_right(d, Nat.mul(kp, d))

# ---- primes ----

def prime_ge2(n: Nat, +hp: Prime(n)) -> {Nat.is_lt(1n, n) == True{} : Bool}:
  match n:
    case 0n:
      Empty.absurd({Nat.is_lt(1n, 0n) == True{} : Bool}, Lg.false_true(hp))
    case 1n:
      Empty.absurd({Nat.is_lt(1n, 1n) == True{} : Bool}, Lg.false_true(hp))
    case 2n+pp:
      {==}

def pd_lt(+pp: Nat, +hp: Prime(2n+pp), +d: Nat, +dp: Nat, +hd: {d == 2n+dp : Nat}, +k: Nat, +e: {2n+pp == Nat.mul(k, d) : Nat}, +hlt: {Nat.is_lt(d, 2n+pp) == True{} : Bool}) -> Empty:
  +m0 = eq_mod0(1n+dp, 2n+pp, k, Equal.trans(Nat, 2n+pp, Nat.mul(k, d), Nat.mul(k, 2n+dp), e, Equal.cong(Nat, Nat, z => Nat.mul(k, z), d, 2n+dp, hd)))
  +nd = PR.nodiv_at(pp, 2n+pp, 2n, 2n+dp, hp, N.le_add_right(2n, dp), Equal.trans(Bool, Nat.is_lt(2n+dp, Nat.add(2n, pp)), Nat.is_lt(d, 2n+pp), True{}, Equal.cong(Nat, Bool, z => Nat.is_lt(z, 2n+pp), 2n+dp, d, Equal.sym(Nat, d, 2n+dp, hd)), hlt))
  Lg.true_false(Equal.trans(Bool, True{}, Nat.is_eq(Nat.mod(2n+pp, 2n+dp), 0n), False{}, Equal.cong(Nat, Bool, z => Nat.is_eq(z, 0n), 0n, Nat.mod(2n+pp, 2n+dp), Equal.sym(Nat, Nat.mod(2n+pp, 2n+dp), 0n, m0)), nd))

def pd_t(+pp: Nat, +hp: Prime(2n+pp), d: Nat, +k: Nat, +e: {2n+pp == Nat.mul(k, d) : Nat}, +l: {Nat.is_lt(1n, d) == True{} : Bool}, +hc: {Nat.is_lt(d, 2n+pp) == True{} : Bool}) -> {d == 2n+pp : Nat}:
  match d:
    case 0n:
      Empty.absurd({0n == 2n+pp : Nat}, Lg.false_true(l))
    case 1n:
      Empty.absurd({1n == 2n+pp : Nat}, Lg.false_true(l))
    case 2n+ +dp:
      Empty.absurd({2n+dp == 2n+pp : Nat}, pd_lt(pp, hp, 2n+dp, dp, {==}, k, e, hc))

def pd_case(+pp: Nat, +hp: Prime(2n+pp), +d: Nat, +k: Nat, +e: {2n+pp == Nat.mul(k, d) : Nat}, +l: {Nat.is_lt(1n, d) == True{} : Bool}, c: Bool, +hc: {Nat.is_lt(d, 2n+pp) == c : Bool}) -> {d == 2n+pp : Nat}:
  match c:
    case True{}:
      pd_t(pp, hp, d, k, e, l, hc)
    case False{}:
      N.le_antisym(d, 2n+pp, dvd_le(2n+pp, k, d, e, {==}), N.not_lt_le(d, 2n+pp, hc))

# every divisor d > 1 of a prime is the prime   (Mathlib Nat.Prime.eq_one_or_self_of_dvd)
def prime_div(n: Nat, +hp: Prime(n), +d: Nat, +k: Nat, +e: {n == Nat.mul(k, d) : Nat}, +l: {Nat.is_lt(1n, d) == True{} : Bool}) -> {d == n : Nat}:
  match n:
    case 0n:
      Empty.absurd({d == 0n : Nat}, Lg.false_true(hp))
    case 1n:
      Empty.absurd({d == 1n : Nat}, Lg.false_true(hp))
    case 2n+ +pp:
      pd_case(pp, hp, d, k, e, l, Nat.is_lt(d, 2n+pp), {==})

# a small literal prime, by the checker's trial division up to sqrt(n)
def small_prime(+n: Nat, +h: {NB.is_prime(n) == True{} : Bool}) -> Prime(n):
  Equal.trans(Bool, SN.prime(n), NB.is_prime(n), True{}, Equal.sym(Bool, NB.is_prime(n), SN.prime(n), PR.is_prime_value(n)), h)

# ---- Euclid's lemma ----

# a prime n does not divide a: gcd(a, n) == 1
def g1(+pp: Nat, +hp: Prime(2n+pp), +a: Nat, +ha: {Nat.is_eq(Nat.mod(a, 2n+pp), 0n) == False{} : Bool}, g: Nat, +hg: {M.gcd(a, 2n+pp) == g : Nat}) -> {M.gcd(a, 2n+pp) == 1n : Nat}:
  match g:
    case 0n:
      +w = G.ws(2n+pp, a, 2n+pp)
      +er = Equal.trans(Nat, 2n+pp, Nat.mul(G.wr(w), M.gcd(a, 2n+pp)), Nat.mul(G.wr(w), 0n), G.gcd_dvd_right(a, 2n+pp), Equal.cong(Nat, Nat, z => Nat.mul(G.wr(w), z), M.gcd(a, 2n+pp), 0n, hg))
      Empty.absurd({M.gcd(a, 2n+pp) == 1n : Nat}, N.succ_zero(1n+pp, Equal.trans(Nat, 2n+pp, Nat.mul(G.wr(w), 0n), 0n, er, NA.mul_zero(G.wr(w)))))
    case 1n:
      hg
    case 2n+ +gp:
      +w = G.ws(2n+pp, a, 2n+pp)
      +er = Equal.trans(Nat, 2n+pp, Nat.mul(G.wr(w), M.gcd(a, 2n+pp)), Nat.mul(G.wr(w), 2n+gp), G.gcd_dvd_right(a, 2n+pp), Equal.cong(Nat, Nat, z => Nat.mul(G.wr(w), z), M.gcd(a, 2n+pp), 2n+gp, hg))
      +el = Equal.trans(Nat, a, Nat.mul(G.wl(w), M.gcd(a, 2n+pp)), Nat.mul(G.wl(w), 2n+gp), G.gcd_dvd_left(a, 2n+pp), Equal.cong(Nat, Nat, z => Nat.mul(G.wl(w), z), M.gcd(a, 2n+pp), 2n+gp, hg))
      +en = prime_div(2n+pp, hp, 2n+gp, G.wr(w), er, {==})
      +ea = Equal.trans(Nat, a, Nat.mul(G.wl(w), 2n+gp), Nat.mul(G.wl(w), 2n+pp), el, Equal.cong(Nat, Nat, z => Nat.mul(G.wl(w), z), 2n+gp, 2n+pp, en))
      +m0 = eq_mod0(1n+pp, a, G.wl(w), ea)
      Empty.absurd({M.gcd(a, 2n+pp) == 1n : Nat}, Lg.true_false(Equal.trans(Bool, True{}, Nat.is_eq(Nat.mod(a, 2n+pp), 0n), False{}, Equal.cong(Nat, Bool, z => Nat.is_eq(z, 0n), 0n, Nat.mod(a, 2n+pp), Equal.sym(Nat, Nat.mod(a, 2n+pp), 0n, m0)), ha)))

# a x == g + n y, g == 1, a b == K n: b + (y b) n == (x K) n
def eu_pos(+a: Nat, +b: Nat, +x: Nat, +y: Nat, +g: Nat, +n: Nat, +k: Nat, +hpos: {Nat.mul(a, x) == Nat.add(g, Nat.mul(n, y)) : Nat}, +hg: {g == 1n : Nat}, +hk: {Nat.mul(a, b) == Nat.mul(k, n) : Nat}) -> {Nat.add(b, Nat.mul(Nat.mul(y, b), n)) == Nat.mul(Nat.mul(x, k), n) : Nat}:
  %rw NA.mul_assoc(x, k, n)
  %rwh <- hk : {Nat.mul(a, b) == Nat.mul(k, n) : Nat}
  %rw <- NA.mul_assoc(x, a, b)
  %rw NA.mul_comm(x, a)
  %rwh hpos : {Nat.mul(a, x) == Nat.add(g, Nat.mul(n, y)) : Nat}
  %rwh hg : {g == 1n : Nat}
  %norm

# n y == g + a x, g == 1, a b == K n: b + (x K) n == (y b) n
def eu_neg(+a: Nat, +b: Nat, +x: Nat, +y: Nat, +g: Nat, +n: Nat, +k: Nat, +hneg: {Nat.mul(n, y) == Nat.add(g, Nat.mul(a, x)) : Nat}, +hg: {g == 1n : Nat}, +hk: {Nat.mul(a, b) == Nat.mul(k, n) : Nat}) -> {Nat.add(b, Nat.mul(Nat.mul(x, k), n)) == Nat.mul(Nat.mul(y, b), n) : Nat}:
  %rw NA.mul_assoc(x, k, n)
  %rwh <- hk : {Nat.mul(a, b) == Nat.mul(k, n) : Nat}
  %goal {Nat.add(b, Nat.mul(x, Nat.mul(a, b))) == Nat.mul(Nat.mul(y, b), n) : Nat}
  %rw NA.mul_comm(Nat.mul(y, b), n)
  %rw <- NA.mul_assoc(n, y, b)
  %rwh hneg : {Nat.mul(n, y) == Nat.add(g, Nat.mul(a, x)) : Nat}
  %rwh hg : {g == 1n : Nat}
  %norm

# from x == z and z mod n == 0: x mod n == 0
def mod0_by(+bp: Nat, +x: Nat, +z: Nat, +e: {x == z : Nat}, +h: {Nat.mod(z, 1n+bp) == 0n : Nat}) -> {Nat.mod(x, 1n+bp) == 0n : Nat}:
  %rwh e : {x == z : Nat}
  h

def eu_bz(+pp: Nat, +a: Nat, +b: Nat, r: NB.EGcd, +hb: {SN.eg_pos(a, 2n+pp, r) == SN.eg_neg(a, 2n+pp, r) : Nat}, +hg: {SN.eg_gcd(r) == 1n : Nat}, +hab: {Nat.mod(Nat.mul(a, b), 2n+pp) == 0n : Nat}) -> {Nat.mod(b, 2n+pp) == 0n : Nat}:
  match r:
    case NB.EG{+g, +x, +y, neg}:
      match neg:
        case False{}:
          +k = Nat.div(Nat.mul(a, b), 2n+pp)
          +hk = mod0_eq(1n+pp, Nat.mul(a, b), hab)
          +e = eu_pos(a, b, x, y, g, 2n+pp, k, hb, hg, hk)
          %goal {Nat.mod(b, 2n+pp) == 0n : Nat}
          %rw <- mod_add_mul(1n+pp, b, Nat.mul(y, b))
          %rwh e : {Nat.add(b, Nat.mul(Nat.mul(y, b), 2n+pp)) == Nat.mul(Nat.mul(x, k), 2n+pp) : Nat}
          mod_mul0(1n+pp, Nat.mul(x, k))
        case True{}:
          +k = Nat.div(Nat.mul(a, b), 2n+pp)
          +hk = mod0_eq(1n+pp, Nat.mul(a, b), hab)
          +e = eu_neg(a, b, x, y, g, 2n+pp, k, hb, hg, hk)
          %goal {Nat.mod(b, 2n+pp) == 0n : Nat}
          %rw <- mod_add_mul(1n+pp, b, Nat.mul(x, k))
          %rwh e : {Nat.add(b, Nat.mul(Nat.mul(x, k), 2n+pp)) == Nat.mul(Nat.mul(y, b), 2n+pp) : Nat}
          mod_mul0(1n+pp, Nat.mul(y, b))

# Euclid's lemma: a prime dividing a b and not a divides b   (Mathlib Nat.Prime.dvd_mul)
def euclid(n: Nat, +hp: Prime(n), +a: Nat, +b: Nat, +hab: {Nat.mod(Nat.mul(a, b), n) == 0n : Nat}, +ha: {Nat.is_eq(Nat.mod(a, n), 0n) == False{} : Bool}) -> {Nat.mod(b, n) == 0n : Nat}:
  match n:
    case 0n:
      Empty.absurd({Nat.mod(b, 0n) == 0n : Nat}, Lg.false_true(hp))
    case 1n:
      Empty.absurd({Nat.mod(b, 1n) == 0n : Nat}, Lg.false_true(hp))
    case 2n+ +pp:
      +hg = Equal.trans(Nat, SN.eg_gcd(NB.egcd(a, 2n+pp)), M.gcd(a, 2n+pp), 1n, EG.egcd_gcd(a, 2n+pp), g1(pp, hp, a, ha, M.gcd(a, 2n+pp), {==}))
      eu_bz(pp, a, b, NB.egcd(a, 2n+pp), EG.egcd_bezout(a, 2n+pp), hg, hab)
