import Base
import ../../../spec/math/natural.bend as S
import ../natural/arith.bend as NR
import ../natural/fact.bend as FA
import ../../lib/nat.bend as N
import ../../lib/logic.bend as Lg
import ../../lib/lemmas/proofs/nat_algebra.bend as NA
import ../typed/width.bend as WW
import ../../crypto/secp256k1/semiring.bend as SR
import ./nt_prime.bend as PM

# Fermat's little theorem (Mathlib ZMod.pow_card, Nat.ModEq.pow_totient for
# a prime): for a prime p, a^p == a (mod p) for every a, and
# a^(p-1) == 1 (mod p) when p does not divide a.
#
# Route: the binomial theorem (x + 1)^n == sum_k C(n, k) x^k by Pascal's
# rule (bsum below), p | C(p, k) for 0 < k < p (fact.bend's
# (n + 1) C(n, k) == C(n + 1, k + 1) (k + 1) and Euclid's lemma), so
# (x + 1)^p == x^p + 1 (mod p); then induction on a. The second form
# cancels a with Euclid's lemma (no inverse needed).

# sum_{i <= k} C(n, i) x^i
def bsum(+n: Nat, k: Nat, +x: Nat) -> Nat:
  match k:
    case 0n:
      S.choose(n, 0n)
    case 1n+ +j:
      Nat.add(bsum(n, j, x), Nat.mul(S.choose(n, 1n+j), Nat.pow(x, 1n+j)))

# ---- the binomial theorem ----

def ring0(+c1: Nat, +x: Nat) -> {Nat.add(1n, Nat.mul(Nat.add(1n, c1), Nat.mul(x, 1n))) == Nat.add(Nat.add(1n, Nat.mul(c1, Nat.mul(x, 1n))), Nat.mul(x, 1n)) : Nat}:
  %norm

def ring1(+a: Nat, +b: Nat, +c1: Nat, +c2: Nat, +x: Nat, +q: Nat) -> {Nat.add(Nat.add(a, Nat.mul(x, b)), Nat.mul(Nat.add(c1, c2), Nat.mul(x, q))) == Nat.add(Nat.add(a, Nat.mul(c2, Nat.mul(x, q))), Nat.mul(x, Nat.add(b, Nat.mul(c1, q)))) : Nat}:
  %norm

# Pascal's rule on the sums: B(n + 1, k + 1) == B(n, k + 1) + x B(n, k)
def pascal(+n: Nat, k: Nat, +x: Nat) -> {bsum(1n+n, 1n+k, x) == Nat.add(bsum(n, 1n+k, x), Nat.mul(x, bsum(n, k, x))) : Nat}:
  match k:
    case 0n:
      %goal {Nat.add(1n, Nat.mul(Nat.add(S.choose(n, 0n), S.choose(n, 1n)), Nat.mul(x, 1n))) == Nat.add(Nat.add(S.choose(n, 0n), Nat.mul(S.choose(n, 1n), Nat.mul(x, 1n))), Nat.mul(x, S.choose(n, 0n))) : Nat}
      %rw FA.choose_zero_right(n)
      %rw FA.choose_zero_right(n)
      %rw FA.choose_zero_right(n)
      ring0(S.choose(n, 1n), x)
    case 1n+ +j:
      %goal {Nat.add(bsum(1n+n, 1n+j, x), Nat.mul(Nat.add(S.choose(n, 1n+j), S.choose(n, 2n+j)), Nat.mul(x, Nat.pow(x, 1n+j)))) == Nat.add(Nat.add(bsum(n, 1n+j, x), Nat.mul(S.choose(n, 2n+j), Nat.mul(x, Nat.pow(x, 1n+j)))), Nat.mul(x, Nat.add(bsum(n, j, x), Nat.mul(S.choose(n, 1n+j), Nat.pow(x, 1n+j))))) : Nat}
      %rw pascal(n, j, x)
      ring1(bsum(n, 1n+j, x), bsum(n, j, x), S.choose(n, 1n+j), S.choose(n, 2n+j), x, Nat.pow(x, 1n+j))

def ring2(+b: Nat, +x: Nat, +q: Nat) -> {Nat.mul(Nat.add(x, 1n), b) == Nat.add(Nat.add(b, Nat.mul(0n, q)), Nat.mul(x, b)) : Nat}:
  %norm

# (x + 1)^n == sum_k C(n, k) x^k   (Mathlib add_pow)
def binom(n: Nat, +x: Nat) -> {Nat.pow(Nat.add(x, 1n), n) == bsum(n, n, x) : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+ +m:
      %goal {Nat.mul(Nat.add(x, 1n), Nat.pow(Nat.add(x, 1n), m)) == bsum(1n+m, 1n+m, x) : Nat}
      %rw binom(m, x)
      %rw pascal(m, m, x)
      %goal {Nat.mul(Nat.add(x, 1n), bsum(m, m, x)) == Nat.add(Nat.add(bsum(m, m, x), Nat.mul(S.choose(m, 1n+m), Nat.pow(x, 1n+m))), Nat.mul(x, bsum(m, m, x))) : Nat}
      %rw FA.choose_eq_zero(m, 1n+m, N.lt_succ(m))
      ring2(bsum(m, m, x), x, Nat.pow(x, 1n+m))

# C(n, n) == 1
def choose_self(n: Nat) -> {S.choose(n, n) == 1n : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+ +m:
      %goal {Nat.add(S.choose(m, m), S.choose(m, 1n+m)) == 1n : Nat}
      %rw choose_self(m)
      %rw FA.choose_eq_zero(m, 1n+m, N.lt_succ(m))
      %close

# ---- the middle coefficients vanish mod p ----

# 0 < k < n (n = 1 + bp): k mod n != 0
def small_nz(+bp: Nat, +k: Nat, +h: {Nat.is_lt(k, 1n+bp) == True{} : Bool}) -> {Nat.mod(k, 1n+bp) == k : Nat}:
  NR.mod_of(0n, bp, k, h)

def ck_eq(+pm: Nat, +j: Nat) -> {Nat.mul(1n+j, S.choose(1n+pm, 1n+j)) == Nat.mul(S.choose(pm, j), 1n+pm) : Nat}:
  %rw NA.mul_comm(1n+j, S.choose(1n+pm, 1n+j))
  %rw <- FA.succ_mul_choose(pm, j)
  %rw NA.mul_comm(1n+pm, S.choose(pm, j))
  %close

# p | C(p, j + 1) for j + 1 < p   (Mathlib Nat.Prime.dvd_choose_self)
def choose_dvd(+pm: Nat, +hp: PM.Prime(1n+pm), +j: Nat, +h: {Nat.is_lt(1n+j, 1n+pm) == True{} : Bool}) -> {Nat.mod(S.choose(1n+pm, 1n+j), 1n+pm) == 0n : Nat}:
  +hab = PM.eq_mod0(pm, Nat.mul(1n+j, S.choose(1n+pm, 1n+j)), S.choose(pm, j), ck_eq(pm, j))
  +hk = small_nz(pm, 1n+j, h)
  +ha = Equal.cong(Nat, Bool, z => Nat.is_eq(z, 0n), Nat.mod(1n+j, 1n+pm), 1n+j, hk)
  PM.euclid(1n+pm, hp, 1n+j, S.choose(1n+pm, 1n+j), hab, ha)

# (u + c q) mod n == u mod n when c mod n == 0
def mod_drop(+bp: Nat, +u: Nat, +c: Nat, +q: Nat, +hc: {Nat.mod(c, 1n+bp) == 0n : Nat}) -> {Nat.mod(Nat.add(u, Nat.mul(c, q)), 1n+bp) == Nat.mod(u, 1n+bp) : Nat}:
  %rwh PM.mod0_eq(bp, c, hc) : {c == Nat.mul(Nat.div(c, 1n+bp), 1n+bp) : Nat}
  %rw NA.mul_assoc(Nat.div(c, 1n+bp), 1n+bp, q)
  %rw NA.mul_comm(1n+bp, q)
  %rw <- NA.mul_assoc(Nat.div(c, 1n+bp), q, 1n+bp)
  %rw PM.mod_add_mul(bp, u, Nat.mul(Nat.div(c, 1n+bp), q))
  %close

def one_mod(+bp: Nat, +h: {Nat.is_lt(1n, 1n+bp) == True{} : Bool}) -> {Nat.mod(1n, 1n+bp) == 1n : Nat}:
  NR.mod_of(0n, bp, 1n, h)

# the partial sums up to k < p are 1 mod p
def bsum_low(+pm: Nat, +hp: PM.Prime(1n+pm), k: Nat, +x: Nat, +h: {Nat.is_lt(k, 1n+pm) == True{} : Bool}) -> {Nat.mod(bsum(1n+pm, k, x), 1n+pm) == 1n : Nat}:
  match k:
    case 0n:
      %goal {Nat.mod(1n, 1n+pm) == 1n : Nat}
      one_mod(pm, PM.prime_ge2(1n+pm, hp))
    case 1n+ +j:
      %goal {Nat.mod(Nat.add(bsum(1n+pm, j, x), Nat.mul(S.choose(1n+pm, 1n+j), Nat.pow(x, 1n+j))), 1n+pm) == 1n : Nat}
      %rw mod_drop(pm, bsum(1n+pm, j, x), S.choose(1n+pm, 1n+j), Nat.pow(x, 1n+j), choose_dvd(pm, hp, j, h))
      bsum_low(pm, hp, j, x, N.lt_trans(j, 1n+j, 1n+pm, N.lt_succ(j), h))

# (x + 1)^p == x^p + 1 (mod p)
def frosh(+pm: Nat, +hp: PM.Prime(1n+pm), +x: Nat) -> {Nat.mod(Nat.pow(Nat.add(x, 1n), 1n+pm), 1n+pm) == Nat.mod(Nat.add(1n, Nat.pow(x, 1n+pm)), 1n+pm) : Nat}:
  %rw binom(1n+pm, x)
  %goal {Nat.mod(Nat.add(bsum(1n+pm, pm, x), Nat.mul(S.choose(1n+pm, 1n+pm), Nat.pow(x, 1n+pm))), 1n+pm) == Nat.mod(Nat.add(1n, Nat.pow(x, 1n+pm)), 1n+pm) : Nat}
  %rw choose_self(1n+pm)
  %rw SR.one_mul(Nat.pow(x, 1n+pm))
  %rw <- NR.mod_add_l(pm, bsum(1n+pm, pm, x), Nat.pow(x, 1n+pm))
  %rw bsum_low(pm, hp, pm, x, N.lt_succ(pm))
  %close

# ---- Fermat ----

def flt_s(+pm: Nat, +hp: PM.Prime(1n+pm), a: Nat) -> {Nat.mod(Nat.pow(a, 1n+pm), 1n+pm) == Nat.mod(a, 1n+pm) : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+ +c:
      %goal {Nat.mod(Nat.pow(Nat.add(1n, c), 1n+pm), 1n+pm) == Nat.mod(1n+c, 1n+pm) : Nat}
      %rw <- NA.add_comm(c, 1n)
      %rw frosh(pm, hp, c)
      %rw <- NR.mod_add_r(pm, 1n, Nat.pow(c, 1n+pm))
      %rw flt_s(pm, hp, c)
      %rw NR.mod_add_r(pm, 1n, c)
      %close

# a^p == a (mod p)   (Mathlib ZMod.pow_card)
def flt(p: Nat, +hp: PM.Prime(p), +a: Nat) -> {Nat.mod(Nat.pow(a, p), p) == Nat.mod(a, p) : Nat}:
  match p:
    case 0n:
      Empty.absurd({Nat.mod(Nat.pow(a, 0n), 0n) == Nat.mod(a, 0n) : Nat}, Lg.false_true(hp))
    case 1n+ +pm:
      flt_s(pm, hp, a)
