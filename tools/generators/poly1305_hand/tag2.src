def mae(+key: List<&2, U32>, +aad: List<&2, U32>, +ct: List<&2, U32>) -> {P.mac_aead(key, aad, ct) == P.mac_aead_w(1n, key, aad, ct) : List<&2, U32>}:
  match aad:
    case Nil{}: {==}
    case x <> rest: {==}

# The AEAD tag is the RFC 8439 Poly1305 tag of mac_data.
law mac_aead_correct:
  for +key: List<&2, U32>
  for +aad: List<&2, U32>
  for +ct: List<&2, U32>
  {P.mac_aead(key, aad, ct) == R.mac(key, RA.mac_data(aad, ct)) : List<&2, U32>}

def mac_aead_correct(key, aad, ct):
  +d = List.append(&2, U32, List.append(&2, U32, aad, P.pad16(aad)), List.append(&2, U32, List.append(&2, U32, ct, P.pad16(ct)), List.append(&2, U32, P.le8(8n, List.length(&2, U32, aad)), P.le8(8n, List.length(&2, U32, ct)))))
