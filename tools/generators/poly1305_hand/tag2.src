# The RFC 8439 2.8 tag without its message list: mac_aead(key, aad, ct)
# absorbs aad | pad16(aad), then ct | pad16(ct), then the two lengths, as
# the Poly1305 of mac_data = aad | pad16(aad) | ct | pad16(ct) | le64(len
# aad) | le64(len ct) would; so it is the spec's tag of mac_data (through
# mac_correct).

law app_assoc:
  for +xs: List<&2, U32>
  for +ys: List<&2, U32>
  for +zs: List<&2, U32>
  {List.append(&2, U32, List.append(&2, U32, xs, ys), zs) == List.append(&2, U32, xs, List.append(&2, U32, ys, zs)) : List<&2, U32>}

def app_assoc(xs, ys, zs):
  match xs:
    case Nil{}: {==}
    case x <> t: Equal.cong(List<&2, U32>, List<&2, U32>, l => x <> l, List.append(&2, U32, List.append(&2, U32, t, ys), zs), List.append(&2, U32, t, List.append(&2, U32, ys, zs)), app_assoc(t, ys, zs))

# 16 more bytes do not change pad16
