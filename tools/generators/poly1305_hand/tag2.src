      Equal.trans(List<&2, U32>, P.mac_w(1n, key, d), R.poly1305_mac(key, d), R.mac(key, RA.mac_data(aad, ct)), M.mac_w_ok(1n, {==}, 1n, {==}, M.bpv(1n), M.bp5(1n, {==}), key, d),
        Equal.trans(List<&2, U32>, R.poly1305_mac(key, d), R.poly1305_mac(key, RA.mac_data(aad, ct)), R.mac(key, RA.mac_data(aad, ct)),
          Equal.cong(List<&2, U32>, List<&2, U32>, l => R.poly1305_mac(key, l), d, RA.mac_data(aad, ct), data_eq(aad, ct)),
          Equal.sym(List<&2, U32>, R.mac(key, RA.mac_data(aad, ct)), R.poly1305_mac(key, RA.mac_data(aad, ct)), M.rmac(key, RA.mac_data(aad, ct)))))))
