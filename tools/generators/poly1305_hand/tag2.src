                                                                      Equal.cong(List<&2, U32>, P.A, l => P.A{P.absorb(pone, List.append(&2, U32, rest, l), k, h2), Nat.add(Nat.add(n, 16n), List.length(&2, U32, rest))}, P.pad16(rest), P.pad16(x0 <> x1 <> x2 <> x3 <> x4 <> x5 <> x6 <> x7 <> x8 <> x9 <> x10 <> x11 <> x12 <> x13 <> x14 <> x15 <> rest), Equal.sym(List<&2, U32>, P.pad16(x0 <> x1 <> x2 <> x3 <> x4 <> x5 <> x6 <> x7 <> x8 <> x9 <> x10 <> x11 <> x12 <> x13 <> x14 <> x15 <> rest), P.pad16(rest), pad_cons16(x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, rest))),
