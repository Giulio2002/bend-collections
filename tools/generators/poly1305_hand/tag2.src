  Equal.cong(Nat, List<&2, U32>, z => List.replicate(U32, Nat.mod(Nat.sub(16n, z), 16n), 0), Nat.mod(16n+List.length(&2, U32, rest), 16n), Nat.mod(List.length(&2, U32, rest), 16n), NR.absorb(15n, 1n, List.length(&2, U32, rest)))

# absorb_pad is absorb over msg | pad16(msg), with the byte count
law apad:
  for +pone: Nat
  for +k: L.K
  for +xs: List<&2, U32>
  for +h: L.F
  for +n: Nat
  {P.absorb_pad(pone, xs, k, h, n) == P.A{P.absorb(pone, List.append(&2, U32, xs, P.pad16(xs)), k, h), Nat.add(n, List.length(&2, U32, xs))} : P.A}

