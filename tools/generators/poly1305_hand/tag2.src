# absorbing (xs | pad16(xs)) | z is absorbing z after xs | pad16(xs)
law comp:
  for +pone: Nat
  for +k: L.K
  for +xs: List<&2, U32>
  for +z: List<&2, U32>
  for +h: L.F
  {P.absorb(pone, List.append(&2, U32, List.append(&2, U32, xs, P.pad16(xs)), z), k, h) == P.absorb(pone, z, k, P.absorb(pone, List.append(&2, U32, xs, P.pad16(xs)), k, h)) : L.F}

