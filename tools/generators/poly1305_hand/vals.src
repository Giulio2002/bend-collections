# ---- limbs to bytes ----

def high8(+a: Nat) -> {C.high(8n, a) == L.d8(a) : Nat}:
  WW.high_div(8n, a, 255n, {==})

def low8(+a: Nat) -> {C.low(8n, a) == Nat.mod(a, 256n) : Nat}:
  +lo = C.low(8n, a)
  +dv = Nat.div(a, 256n)
  +e1 = Equal.trans(Nat, Nat.add(lo, C.shift(8n, dv)), a, Nat.add(Nat.mod(a, 256n), C.shift(8n, dv)),
    Equal.trans(Nat, Nat.add(lo, C.shift(8n, dv)), Nat.add(lo, C.shift(8n, C.high(8n, a))), a,
      Equal.cong(Nat, Nat, t => Nat.add(lo, C.shift(8n, t)), dv, C.high(8n, a), Equal.sym(Nat, C.high(8n, a), dv, high8(a))),
      Equal.sym(Nat, a, Nat.add(lo, C.shift(8n, C.high(8n, a))), WW.low_high(8n, a))),
    K.d256(a))
  +e2 = Equal.trans(Nat, Nat.add(C.shift(8n, dv), lo), Nat.add(lo, C.shift(8n, dv)), Nat.add(C.shift(8n, dv), Nat.mod(a, 256n)), NA.add_comm(C.shift(8n, dv), lo),
    Equal.trans(Nat, Nat.add(lo, C.shift(8n, dv)), Nat.add(Nat.mod(a, 256n), C.shift(8n, dv)), Nat.add(C.shift(8n, dv), Nat.mod(a, 256n)), e1, NA.add_comm(Nat.mod(a, 256n), C.shift(8n, dv))))
  NR.add_cancel(C.shift(8n, dv), lo, Nat.mod(a, 256n), e2)

# one byte off a + 2^8 t
def lb(+m: Nat, +a: Nat, +t: Nat) -> {R.le_bytes(1n+m, Nat.add(a, C.shift(8n, t))) == L.by(a) <> R.le_bytes(m, Nat.add(L.d8(a), t)) : List<&2, U32>}:
  +x = Nat.add(a, C.shift(8n, t))
  %Equal.sym(Nat, C.low(8n, x), Nat.mod(a, 256n), Equal.trans(Nat, C.low(8n, x), C.low(8n, a), Nat.mod(a, 256n), WW.low_add_shift(8n, a, t), low8(a))) : {U32.from_nat(_) <> R.le_bytes(m, C.high(8n, x)) == L.by(a) <> R.le_bytes(m, Nat.add(L.d8(a), t)) : List<&2, U32>}
  %Equal.sym(Nat, C.high(8n, x), Nat.add(L.d8(a), t), Equal.trans(Nat, C.high(8n, x), Nat.add(C.high(8n, a), t), Nat.add(L.d8(a), t), WW.high_add_shift(8n, a, t), Equal.cong(Nat, Nat, z => Nat.add(z, t), C.high(8n, a), L.d8(a), high8(a)))) : {U32.from_nat(Nat.mod(a, 256n)) <> R.le_bytes(m, _) == L.by(a) <> R.le_bytes(m, Nat.add(L.d8(a), t)) : List<&2, U32>}
  {==}

def lb0(+m: Nat, +a: Nat) -> {R.le_bytes(1n+m, a) == L.by(a) <> R.le_bytes(m, L.d8(a)) : List<&2, U32>}:
  %Equal.sym(Nat, C.low(8n, a), Nat.mod(a, 256n), low8(a)) : {U32.from_nat(_) <> R.le_bytes(m, C.high(8n, a)) == L.by(a) <> R.le_bytes(m, L.d8(a)) : List<&2, U32>}
