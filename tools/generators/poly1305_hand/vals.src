  %normp

# The streamed bytes are the 16 low bytes of the limbs' value.
def bytes_val(+l0: Nat, +l1: Nat, +l2: Nat, +l3: Nat, +l4: Nat) -> {L.bytes(l0, l1, l2, l3, l4) == R.le_bytes(16n, ev(l0, l1, l2, l3, l4)) : List<&2, U32>}:
  %Equal.sym(List<&2, U32>, R.le_bytes(16n, Nat.add(l0, C.shift(8n, C.shift(18n, Nat.add(l1, C.shift(26n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4)))))))))), L.by(l0) <> R.le_bytes(15n, Nat.add(L.d8(l0), C.shift(18n, Nat.add(l1, C.shift(26n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4))))))))), lb(15n, l0, C.shift(18n, Nat.add(l1, C.shift(26n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4))))))))) : {L.bytes(l0, l1, l2, l3, l4) == _ : List<&2, U32>}
  %Equal.sym(List<&2, U32>, R.le_bytes(15n, Nat.add(L.d8(l0), C.shift(8n, C.shift(10n, Nat.add(l1, C.shift(26n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4)))))))))), L.by(L.d8(l0)) <> R.le_bytes(14n, Nat.add(L.d8(L.d8(l0)), C.shift(10n, Nat.add(l1, C.shift(26n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4))))))))), lb(14n, L.d8(l0), C.shift(10n, Nat.add(l1, C.shift(26n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4))))))))) : {L.bytes(l0, l1, l2, l3, l4) == L.by(l0) <> _ : List<&2, U32>}
  %Equal.sym(List<&2, U32>, R.le_bytes(14n, Nat.add(L.d8(L.d8(l0)), C.shift(8n, C.shift(2n, Nat.add(l1, C.shift(26n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4)))))))))), L.by(L.d8(L.d8(l0))) <> R.le_bytes(13n, Nat.add(L.d8(L.d8(L.d8(l0))), C.shift(2n, Nat.add(l1, C.shift(26n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4))))))))), lb(13n, L.d8(L.d8(l0)), C.shift(2n, Nat.add(l1, C.shift(26n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4))))))))) : {L.bytes(l0, l1, l2, l3, l4) == L.by(l0) <> L.by(L.d8(l0)) <> _ : List<&2, U32>}
  %Equal.cong(Nat, List<&2, U32>, z => R.le_bytes(13n, z), Nat.add(Nat.add(L.d8(L.d8(L.d8(l0))), Nat.mul(l1, 4n)), C.shift(8n, C.shift(20n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4))))))), Nat.add(L.d8(L.d8(L.d8(l0))), C.shift(2n, Nat.add(l1, C.shift(26n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4)))))))), Equal.sym(Nat, Nat.add(L.d8(L.d8(L.d8(l0))), C.shift(2n, Nat.add(l1, C.shift(26n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4)))))))), Nat.add(Nat.add(L.d8(L.d8(L.d8(l0))), Nat.mul(l1, 4n)), C.shift(8n, C.shift(20n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4))))))), e3(L.d8(L.d8(L.d8(l0))), l1, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4))))))) : {L.bytes(l0, l1, l2, l3, l4) == L.by(l0) <> L.by(L.d8(l0)) <> L.by(L.d8(L.d8(l0))) <> _ : List<&2, U32>}
  %Equal.sym(List<&2, U32>, R.le_bytes(13n, Nat.add(Nat.add(L.d8(L.d8(L.d8(l0))), Nat.mul(l1, 4n)), C.shift(8n, C.shift(20n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4)))))))), L.by(Nat.add(L.d8(L.d8(L.d8(l0))), Nat.mul(l1, 4n))) <> R.le_bytes(12n, Nat.add(L.d8(Nat.add(L.d8(L.d8(L.d8(l0))), Nat.mul(l1, 4n))), C.shift(20n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4))))))), lb(12n, Nat.add(L.d8(L.d8(L.d8(l0))), Nat.mul(l1, 4n)), C.shift(20n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4))))))) : {L.bytes(l0, l1, l2, l3, l4) == L.by(l0) <> L.by(L.d8(l0)) <> L.by(L.d8(L.d8(l0))) <> _ : List<&2, U32>}
  %Equal.sym(List<&2, U32>, R.le_bytes(12n, Nat.add(L.d8(Nat.add(L.d8(L.d8(L.d8(l0))), Nat.mul(l1, 4n))), C.shift(8n, C.shift(12n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4)))))))), L.by(L.d8(Nat.add(L.d8(L.d8(L.d8(l0))), Nat.mul(l1, 4n)))) <> R.le_bytes(11n, Nat.add(L.d8(L.d8(Nat.add(L.d8(L.d8(L.d8(l0))), Nat.mul(l1, 4n)))), C.shift(12n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4))))))), lb(11n, L.d8(Nat.add(L.d8(L.d8(L.d8(l0))), Nat.mul(l1, 4n))), C.shift(12n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4))))))) : {L.bytes(l0, l1, l2, l3, l4) == L.by(l0) <> L.by(L.d8(l0)) <> L.by(L.d8(L.d8(l0))) <> L.by(Nat.add(L.d8(L.d8(L.d8(l0))), Nat.mul(l1, 4n))) <> _ : List<&2, U32>}
  %Equal.sym(List<&2, U32>, R.le_bytes(11n, Nat.add(L.d8(L.d8(Nat.add(L.d8(L.d8(L.d8(l0))), Nat.mul(l1, 4n)))), C.shift(8n, C.shift(4n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4)))))))), L.by(L.d8(L.d8(Nat.add(L.d8(L.d8(L.d8(l0))), Nat.mul(l1, 4n))))) <> R.le_bytes(10n, Nat.add(L.d8(L.d8(L.d8(Nat.add(L.d8(L.d8(L.d8(l0))), Nat.mul(l1, 4n))))), C.shift(4n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4))))))), lb(10n, L.d8(L.d8(Nat.add(L.d8(L.d8(L.d8(l0))), Nat.mul(l1, 4n)))), C.shift(4n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4))))))) : {L.bytes(l0, l1, l2, l3, l4) == L.by(l0) <> L.by(L.d8(l0)) <> L.by(L.d8(L.d8(l0))) <> L.by(Nat.add(L.d8(L.d8(L.d8(l0))), Nat.mul(l1, 4n))) <> L.by(L.d8(Nat.add(L.d8(L.d8(L.d8(l0))), Nat.mul(l1, 4n)))) <> _ : List<&2, U32>}
  %Equal.cong(Nat, List<&2, U32>, z => R.le_bytes(10n, z), Nat.add(Nat.add(L.d8(L.d8(L.d8(Nat.add(L.d8(L.d8(L.d8(l0))), Nat.mul(l1, 4n))))), Nat.mul(l2, 16n)), C.shift(8n, C.shift(22n, Nat.add(l3, C.shift(26n, l4))))), Nat.add(L.d8(L.d8(L.d8(Nat.add(L.d8(L.d8(L.d8(l0))), Nat.mul(l1, 4n))))), C.shift(4n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4)))))), Equal.sym(Nat, Nat.add(L.d8(L.d8(L.d8(Nat.add(L.d8(L.d8(L.d8(l0))), Nat.mul(l1, 4n))))), C.shift(4n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4)))))), Nat.add(Nat.add(L.d8(L.d8(L.d8(Nat.add(L.d8(L.d8(L.d8(l0))), Nat.mul(l1, 4n))))), Nat.mul(l2, 16n)), C.shift(8n, C.shift(22n, Nat.add(l3, C.shift(26n, l4))))), e6(L.d8(L.d8(L.d8(Nat.add(L.d8(L.d8(L.d8(l0))), Nat.mul(l1, 4n))))), l2, Nat.add(l3, C.shift(26n, l4))))) : {L.bytes(l0, l1, l2, l3, l4) == L.by(l0) <> L.by(L.d8(l0)) <> L.by(L.d8(L.d8(l0))) <> L.by(Nat.add(L.d8(L.d8(L.d8(l0))), Nat.mul(l1, 4n))) <> L.by(L.d8(Nat.add(L.d8(L.d8(L.d8(l0))), Nat.mul(l1, 4n)))) <> L.by(L.d8(L.d8(Nat.add(L.d8(L.d8(L.d8(l0))), Nat.mul(l1, 4n))))) <> _ : List<&2, U32>}
