import Base
import ../../../spec/lib/common.bend as C
import ../../../spec/crypto/poly1305.bend as R
import ../../../src/crypto/poly1305/limbs.bend as L
import ../../../src/crypto/poly1305/poly1305.bend as P
import ../../lib/logic.bend as LG
import ../../lib/nat.bend as N
import ../../lib/lemmas/proofs/nat_algebra.bend as NA
import ../../math/typed/width.bend as WW
import ../../math/natural/arith.bend as NR
import ./arith.bend as A
import ./nat.bend as K
import ./vals.bend as V
import ./bnd.bend as B
import ./fin.bend as F
import ./modp.bend as MP

# The implementation's Poly1305 tag is the RFC 8439 tag (spec/crypto/
# poly1305.bend) for every key and message: the limb accumulator stays
# congruent to the spec's accumulator mod p block by block (vals.bend) with
# 27-bit limbs (bnd.bend), and the final reduction gives the spec's
# num_to_16_le_bytes (fin.bend). The radices are instantiated once, at the
# end: b = 8192 = C.shift(13n, 1n) (a unary 8192 for the checker) and
# w = b b.

# ---- p ----

# p == 1 + bp
law pp_eq:
  for +one: Nat
  for +h1: {one == 1n : Nat}
  for +bp: Nat
  for +h5: {Nat.add(1n+bp, 5n) == C.shift(130n, one) : Nat}
  {Nat.sub(C.shift(130n, one), 5n) == 1n+bp : Nat}

def pp_eq(one, h1, bp, h5):
  A.tr(Nat.sub(C.shift(130n, one), 5n), Nat.sub(Nat.add(1n+bp, 5n), 5n), 1n+bp, Equal.cong(Nat, Nat, z => Nat.sub(z, 5n), C.shift(130n, one), Nat.add(1n+bp, 5n), A.sy(Nat.add(1n+bp, 5n), C.shift(130n, one), h5)),
    A.tr(Nat.sub(Nat.add(1n+bp, 5n), 5n), Nat.sub(Nat.add(5n, 1n+bp), 5n), 1n+bp, Equal.cong(Nat, Nat, z => Nat.sub(z, 5n), Nat.add(1n+bp, 5n), Nat.add(5n, 1n+bp), N.add_comm(1n+bp, 5n)), N.add_sub_cancel(5n, 1n+bp)))

def bpv(+one: Nat) -> Nat:
  Nat.sub(C.shift(130n, one), 6n)

law bp5:
  for +one: Nat
  for +h1: {one == 1n : Nat}
  {Nat.add(1n+bpv(one), 5n) == C.shift(130n, one) : Nat}

def bp5(one, h1):
  +s = C.shift(130n, one)
  +h6 = N.le_trans(6n, C.shift(3n, one), s, LG.subst(Nat, z => {Nat.is_le(6n, C.shift(3n, z)) == True{} : Bool}, 1n, one, A.sy(one, 1n, h1), {==}), WW.shift_ge(127n, C.shift(3n, one)))
  A.tr(Nat.add(1n+bpv(one), 5n), Nat.add(5n, 1n+bpv(one)), s, N.add_comm(1n+bpv(one), 5n), N.sub_add(s, 6n, h6))

# ---- one block against the spec's step ----

def step_val(+one: Nat, +h1: {one == 1n : Nat}, +b: Nat, +hb: {b == C.shift(13n, one) : Nat}, +w: Nat, +hw: {w == Nat.mul(b, b) : Nat}, +bp: Nat, +h5: {Nat.add(1n+bp, 5n) == C.shift(130n, one) : Nat}, +r0: Nat, +r1: Nat, +r2: Nat, +r3: Nat, +r4: Nat, +h: L.F, +m: L.F, +a: Nat, +n: Nat, +ha: {Nat.mod(V.val(h), 1n+bp) == a : Nat}, +hn: {V.val(m) == n : Nat}) -> {Nat.mod(V.val(L.block(w, b, L.key(b, L.F{r0, r1, r2, r3, r4}), h, m)), 1n+bp) == R.modp(Nat.mul(V.ev(r0, r1, r2, r3, r4), Nat.add(a, n))) : Nat}:
  +pp = {1n+bp : Nat}
  +vr = V.ev(r0, r1, r2, r3, r4)
  +vh = V.val(h)
  +vm = V.val(m)
  +e1 = V.block_val(one, h1, b, hb, w, hw, bp, h5, r0, r1, r2, r3, r4, h, m)
  +e2 = Equal.cong(Nat, Nat, z => Nat.mod(z, pp), Nat.mul(Nat.add(vh, vm), vr), Nat.mul(vr, Nat.add(vh, n)),
    Equal.trans(Nat, Nat.mul(Nat.add(vh, vm), vr), Nat.mul(Nat.add(vh, n), vr), Nat.mul(vr, Nat.add(vh, n)), Equal.cong(Nat, Nat, z => Nat.mul(Nat.add(vh, z), vr), vm, n, hn), NA.mul_comm(Nat.add(vh, n), vr)))
  +e3 = Equal.trans(Nat, Nat.mod(Nat.mul(vr, Nat.add(vh, n)), pp), Nat.mod(Nat.mul(vr, Nat.mod(Nat.add(vh, n), pp)), pp), Nat.mod(Nat.mul(vr, Nat.add(a, n)), pp),
    Equal.sym(Nat, Nat.mod(Nat.mul(vr, Nat.mod(Nat.add(vh, n), pp)), pp), Nat.mod(Nat.mul(vr, Nat.add(vh, n)), pp), NR.mod_mul_r(bp, vr, Nat.add(vh, n))),
    Equal.trans(Nat, Nat.mod(Nat.mul(vr, Nat.mod(Nat.add(vh, n), pp)), pp), Nat.mod(Nat.mul(vr, Nat.mod(Nat.add(a, n), pp)), pp), Nat.mod(Nat.mul(vr, Nat.add(a, n)), pp),
      Equal.cong(Nat, Nat, z => Nat.mod(Nat.mul(vr, z), pp), Nat.mod(Nat.add(vh, n), pp), Nat.mod(Nat.add(a, n), pp),
        Equal.trans(Nat, Nat.mod(Nat.add(vh, n), pp), Nat.mod(Nat.add(Nat.mod(vh, pp), n), pp), Nat.mod(Nat.add(a, n), pp),
          Equal.sym(Nat, Nat.mod(Nat.add(Nat.mod(vh, pp), n), pp), Nat.mod(Nat.add(vh, n), pp), NR.mod_add_l(bp, vh, n)),
          Equal.cong(Nat, Nat, z => Nat.mod(Nat.add(z, n), pp), Nat.mod(vh, pp), a, ha))),
      NR.mod_mul_r(bp, vr, Nat.add(a, n))))
  Equal.trans(Nat, Nat.mod(V.val(L.block(w, b, L.key(b, L.F{r0, r1, r2, r3, r4}), h, m)), pp), Nat.mod(Nat.mul(Nat.add(vh, vm), vr), pp), R.modp(Nat.mul(vr, Nat.add(a, n))), e1,
    Equal.trans(Nat, Nat.mod(Nat.mul(Nat.add(vh, vm), vr), pp), Nat.mod(Nat.mul(vr, Nat.add(vh, n)), pp), R.modp(Nat.mul(vr, Nat.add(a, n))), e2,
      Equal.trans(Nat, Nat.mod(Nat.mul(vr, Nat.add(vh, n)), pp), Nat.mod(Nat.mul(vr, Nat.add(a, n)), pp), R.modp(Nat.mul(vr, Nat.add(a, n))), e3,
        Equal.sym(Nat, R.modp(Nat.mul(vr, Nat.add(a, n))), Nat.mod(Nat.mul(vr, Nat.add(a, n)), pp), MP.modp_mod(one, h1, bp, h5, Nat.mul(vr, Nat.add(a, n)))))))

# ---- lists ----

law bnil:
  for +k: Nat
  {R.blocks(k, []) == [] : List<&2, List<&2, U32>>}

def bnil(k):
  match k:
    case 0n: {==}
    case 1n+j: {==}

law leS:
  for +j: Nat
  for +n: Nat
  for +k: Nat
  for +h: {Nat.is_le(Nat.add(j, n), k) == True{} : Bool}
  {Nat.is_le(n, k) == True{} : Bool}

def leS(j, n, k, h):
  match j:
    case 0n: h
    case 1n+i: leS(i, n, k, N.le_trans(Nat.add(i, n), 1n+Nat.add(i, n), k, N.le_succ(Nat.add(i, n)), h))

def hd_fit(+xs: List<&2, U32>) -> {C.fits(8n, P.hd(xs)) == True{} : Bool}:
  match xs:
    case Nil{}: K.fz(8n)
    case x <> t: B.byte_fit(x)

law take_prefix:
  for +n: Nat
  for +xs: List<&2, U32>
  {P.take(n, xs) == R.prefix(n, xs) : List<&2, U32>}

def take_prefix(n, xs):
  match n xs:
    case 0n _: {==}
    case 1n+j Nil{}: {==}
    case 1n+j x <> t: Equal.cong(List<&2, U32>, List<&2, U32>, z => x <> z, P.take(j, t), R.prefix(j, t), take_prefix(j, t))

law skip_suffix:
  for +n: Nat
  for +xs: List<&2, U32>
  {P.skip(n, xs) == R.suffix(n, xs) : List<&2, U32>}

def skip_suffix(n, xs):
  match n xs:
    case 0n _: {==}
    case 1n+j Nil{}: {==}
    case 1n+j x <> t: skip_suffix(j, t)

law len_take:
  for +n: Nat
  for +xs: List<&2, U32>
  {Nat.is_le(List.length(&2, U32, P.take(n, xs)), n) == True{} : Bool}

def len_take(n, xs):
  match n xs:
    case 0n _: {==}
    case 1n+j Nil{}: {==}
    case 1n+j x <> t: len_take(j, t)

law len_app1:
  for +xs: List<&2, U32>
  {List.length(&2, U32, List.append(&2, U32, xs, [1])) == 1n+List.length(&2, U32, xs) : Nat}

def len_app1(xs):
  match xs:
    case Nil{}: {==}
    case x <> t: Equal.cong(Nat, Nat, z => 1n+z, List.length(&2, U32, List.append(&2, U32, t, [1])), 1n+List.length(&2, U32, t), len_app1(t))

law len_suffix:
  for +n: Nat
  for +xs: List<&2, U32>
  {Nat.is_le(List.length(&2, U32, R.suffix(n, xs)), List.length(&2, U32, xs)) == True{} : Bool}

def len_suffix(n, xs):
  match n xs:
    case 0n _: N.le_refl(List.length(&2, U32, xs))
    case 1n+j Nil{}: {==}
    case 1n+j x <> t: N.le_trans(List.length(&2, U32, R.suffix(j, t)), List.length(&2, U32, t), 1n+List.length(&2, U32, t), len_suffix(j, t), N.le_succ(List.length(&2, U32, t)))

# the blocks do not depend on the fuel once it covers the message
law bf:
  for +f: Nat
  for +g: Nat
  for +m: List<&2, U32>
  for +hf: {Nat.is_le(List.length(&2, U32, m), f) == True{} : Bool}
  for +hg: {Nat.is_le(List.length(&2, U32, m), g) == True{} : Bool}
  {R.blocks(f, m) == R.blocks(g, m) : List<&2, List<&2, U32>>}

def bf(f, g, m, hf, hg):
  match f g m:
    case 0n _ Nil{}: Equal.sym(List<&2, List<&2, U32>>, R.blocks(g, []), [], bnil(g))
    case 0n _ x <> t: Empty.absurd({R.blocks(0n, x <> t) == R.blocks(g, x <> t) : List<&2, List<&2, U32>>}, LG.false_true(hf))
    case 1n+i 0n Nil{}: {==}
    case 1n+i 0n x <> t: Empty.absurd({R.blocks(1n+i, x <> t) == R.blocks(0n, x <> t) : List<&2, List<&2, U32>>}, LG.false_true(hg))
    case 1n+i 1n+j Nil{}: {==}
    case 1n+i 1n+j x <> t:
      +sf = R.suffix(16n, x <> t)
      +ls = N.le_trans(List.length(&2, U32, sf), List.length(&2, U32, R.suffix(15n, t)), List.length(&2, U32, t), N.le_refl(List.length(&2, U32, sf)), len_suffix(15n, t))
      Equal.cong(List<&2, List<&2, U32>>, List<&2, List<&2, U32>>, z => R.prefix(16n, x <> t) <> z, R.blocks(i, sf), R.blocks(j, sf),
        bf(i, j, sf, N.le_trans(List.length(&2, U32, sf), List.length(&2, U32, t), i, ls, hf), N.le_trans(List.length(&2, U32, sf), List.length(&2, U32, t), j, ls, hg)))

# ---- a block of up to 17 bytes ----

def hvl(n: Nat, +ys: List<&2, U32>) -> Nat:
  match n:
    case 0n: 0n
    case 1n: P.hd(ys)
    case 2n+j: Nat.add(P.hd(ys), C.shift(8n, hvl(1n+j, P.tl(ys))))

law hvl_nil:
  for +n: Nat
  {hvl(n, []) == 0n : Nat}

def hvl_nil(n):
  match n:
    case 0n: {==}
    case 1n: {==}
    case 2n+j:
      %Equal.sym(Nat, hvl(1n+j, []), 0n, hvl_nil(1n+j)) : {C.shift(8n, _) == 0n : Nat}
      WW.shift_zero(8n)

law hvl_le:
  for +n: Nat
  for +ys: List<&2, U32>
  for +h: {Nat.is_le(List.length(&2, U32, ys), 1n+n) == True{} : Bool}
  {hvl(1n+n, ys) == R.le_num(ys) : Nat}

def hvl_le(n, ys, h):
  match n ys:
    case 0n Nil{}: {==}
    case 0n y <> Nil{}: Equal.sym(Nat, Nat.add(L.byte(y), 0n), L.byte(y), NA.add_zero(L.byte(y)))
    case 0n y <> z <> t: Empty.absurd({hvl(1n, y <> z <> t) == R.le_num(y <> z <> t) : Nat}, LG.false_true(h))
    case 1n+j Nil{}:
      %Equal.sym(Nat, hvl(1n+j, []), 0n, hvl_nil(1n+j)) : {C.shift(8n, _) == 0n : Nat}
      WW.shift_zero(8n)
    case 1n+j y <> t:
      Equal.cong(Nat, Nat, z => Nat.add(L.byte(y), C.shift(8n, z)), hvl(1n+j, t), R.le_num(t), hvl_le(j, t, h))

def blk_val(+xs: List<&2, U32>) -> {V.val(P.load17(List.append(&2, U32, P.take(16n, xs), [1]))) == R.le_num(List.append(&2, U32, R.prefix(16n, xs), [1])) : Nat}:
  +ys = List.append(&2, U32, P.take(16n, xs), [1])
  +hl = A.le_substl(1n+List.length(&2, U32, P.take(16n, xs)), List.length(&2, U32, ys), 17n, Equal.sym(Nat, List.length(&2, U32, ys), 1n+List.length(&2, U32, P.take(16n, xs)), len_app1(P.take(16n, xs))), len_take(16n, xs))
  Equal.trans(Nat, V.val(P.load17(ys)), hvl(17n, ys), R.le_num(List.append(&2, U32, R.prefix(16n, xs), [1])),
    Equal.trans(Nat, V.val(P.load17(ys)), V.hv(P.hd(ys), P.hd(P.tl(ys)), P.hd(P.tl(P.tl(ys))), P.hd(P.tl(P.tl(P.tl(ys)))), P.hd(P.tl(P.tl(P.tl(P.tl(ys))))), P.hd(P.tl(P.tl(P.tl(P.tl(P.tl(ys)))))), P.hd(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(ys))))))), P.hd(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(ys)))))))), P.hd(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(ys))))))))), P.hd(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(ys)))))))))), P.hd(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(ys))))))))))), P.hd(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(ys)))))))))))), P.hd(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(ys))))))))))))), P.hd(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(ys)))))))))))))), P.hd(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(ys))))))))))))))), P.hd(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(ys)))))))))))))))), P.hd(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(ys)))))))))))))))))), hvl(17n, ys), V.load_val(P.hd(ys), P.hd(P.tl(ys)), P.hd(P.tl(P.tl(ys))), P.hd(P.tl(P.tl(P.tl(ys)))), P.hd(P.tl(P.tl(P.tl(P.tl(ys))))), P.hd(P.tl(P.tl(P.tl(P.tl(P.tl(ys)))))), P.hd(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(ys))))))), P.hd(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(ys)))))))), P.hd(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(ys))))))))), P.hd(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(ys)))))))))), P.hd(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(ys))))))))))), P.hd(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(ys)))))))))))), P.hd(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(ys))))))))))))), P.hd(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(ys)))))))))))))), P.hd(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(ys))))))))))))))), P.hd(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(ys)))))))))))))))), P.hd(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(ys)))))))))))))))))), {==}),
    Equal.trans(Nat, hvl(17n, ys), R.le_num(ys), R.le_num(List.append(&2, U32, R.prefix(16n, xs), [1])), hvl_le(16n, ys, hl),
      Equal.cong(List<&2, U32>, Nat, z => R.le_num(List.append(&2, U32, z, [1])), P.take(16n, xs), R.prefix(16n, xs), take_prefix(16n, xs))))

# the 17th byte of take(16, xs) ++ [1] is 0 or 1
def pb_fit(+xs: List<&2, U32>) -> {C.fits(1n, P.hd(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(List.append(&2, U32, P.take(16n, xs), [1]))))))))))))))))))) == True{} : Bool}:
  match xs:
    case Nil{}: {==}
    case y0 <> t0:
      match t0:
        case Nil{}: {==}
        case y1 <> t1:
          match t1:
            case Nil{}: {==}
            case y2 <> t2:
              match t2:
                case Nil{}: {==}
                case y3 <> t3:
                  match t3:
                    case Nil{}: {==}
                    case y4 <> t4:
                      match t4:
                        case Nil{}: {==}
                        case y5 <> t5:
                          match t5:
                            case Nil{}: {==}
                            case y6 <> t6:
                              match t6:
                                case Nil{}: {==}
                                case y7 <> t7:
                                  match t7:
                                    case Nil{}: {==}
                                    case y8 <> t8:
                                      match t8:
                                        case Nil{}: {==}
                                        case y9 <> t9:
                                          match t9:
                                            case Nil{}: {==}
                                            case y10 <> t10:
                                              match t10:
                                                case Nil{}: {==}
                                                case y11 <> t11:
                                                  match t11:
                                                    case Nil{}: {==}
                                                    case y12 <> t12:
                                                      match t12:
                                                        case Nil{}: {==}
                                                        case y13 <> t13:
                                                          match t13:
                                                            case Nil{}: {==}
                                                            case y14 <> t14:
                                                              match t14:
                                                                case Nil{}: {==}
                                                                case y15 <> t15:
                                                                  {==}

# ---- the accumulator against the spec ----

law gen_val:
  for +one: Nat
  for +h1: {one == 1n : Nat}
  for +b: Nat
  for +hb: {b == C.shift(13n, one) : Nat}
  for +w: Nat
  for +hw: {w == Nat.mul(b, b) : Nat}
  for +bp: Nat
  for +h5: {Nat.add(1n+bp, 5n) == C.shift(130n, one) : Nat}
  for +r0: Nat
  for +r1: Nat
  for +r2: Nat
  for +r3: Nat
  for +r4: Nat
  for +fuel: Nat
  for +msg: List<&2, U32>
  for +h: L.F
  for +a: Nat
  for +ha: {Nat.mod(V.val(h), 1n+bp) == a : Nat}
  {Nat.mod(V.val(P.absorb_gen(w, b, fuel, msg, L.key(b, L.F{r0, r1, r2, r3, r4}), h)), 1n+bp) == R.absorb(R.blocks(fuel, msg), V.ev(r0, r1, r2, r3, r4), a) : Nat}

def gen_val(one, h1, b, hb, w, hw, bp, h5, r0, r1, r2, r3, r4, fuel, msg, h, a, ha):
  match fuel msg:
    case 0n _: ha
    case 1n+f Nil{}: ha
    case 1n+f +x <> +rest:
      +m = P.load17(List.append(&2, U32, P.take(16n, x <> rest), [1]))
      +n = R.le_num(List.append(&2, U32, R.prefix(16n, x <> rest), [1]))
      +a2 = R.modp(Nat.mul(V.ev(r0, r1, r2, r3, r4), Nat.add(a, n)))
