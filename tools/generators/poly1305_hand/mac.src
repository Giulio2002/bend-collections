law abs_inv:
  for +one: Nat
  for +h1: {one == 1n : Nat}
  for +b: Nat
  for +hb: {b == C.shift(13n, one) : Nat}
  for +w: Nat
  for +hw: {w == Nat.mul(b, b) : Nat}
  for +r0: Nat
  for +r1: Nat
  for +r2: Nat
  for +r3: Nat
  for +r4: Nat
  for +hr0: {C.fits(26n, r0) == True{} : Bool}
  for +hr1: {C.fits(26n, r1) == True{} : Bool}
  for +hr2: {C.fits(26n, r2) == True{} : Bool}
  for +hr3: {C.fits(26n, r3) == True{} : Bool}
  for +hr4: {C.fits(26n, r4) == True{} : Bool}
  for +msg: List<&2, U32>
  for +h: L.F
  for +hh: {B.lim(27n, h) == True{} : Bool}
  {B.lim(27n, P.absorb(w, b, msg, L.key(b, L.F{r0, r1, r2, r3, r4}), h)) == True{} : Bool}

