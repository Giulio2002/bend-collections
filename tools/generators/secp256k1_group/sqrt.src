import Base
import ../../../lib/lemmas/proofs/nat_algebra.bend as NA
import ../../../math/typed/width.bend as WW
import ../semiring.bend as SR
import ../../../lib/logic.bend as Lg
import ../../../lib/nat.bend as N
import ../../../math/natural/arith.bend as NR
import ../../../math/natural/modpow.bend as MP
import ../../../../spec/crypto/secp256k1/field.bend as FS
import ../../../../spec/crypto/secp256k1/curve.bend as CS
import ../../../math/number/nt_prime.bend as PM
import ../../../math/number/nt_flt.bend as FL
import ./zm.bend as Z
import ./fld.bend as F
import ./nc.bend as NC
import ./id_enc.bend as IE

# Square roots modulo a prime m = 1 + mp with m == 3 (mod 4), as the
# specification computes them (FS.fsqrt(m, a) = a^((m + 1) / 4), SEC 1
# section 2.3.4): for a square a the result squares to a; the two roots of
# a square are r and -r, of different parities when r != 0 (m is odd), so
# CS.pick_parity returns the root with the requested parity.
#
# The hypotheses on m: hp (m prime), he (m + 1 == 4 s), hodd (m odd).

def dbl_s(+s: Nat) -> {Nat.mul(s, 4n) == Nat.add(Nat.add(s, s), Nat.add(s, s)) : Nat}:
  %norm

def div4(+mp: Nat, +s: Nat, +he: {Nat.add(1n+mp, 1n) == Nat.mul(s, 4n) : Nat}) -> {Nat.div(Nat.add(1n+mp, 1n), 4n) == s : Nat}:
  %rwh he : {Nat.add(1n+mp, 1n) == Nat.mul(s, 4n) : Nat}
  %rw <- NA.add_zero(Nat.mul(s, 4n))
  NR.div_of(s, 3n, 0n, {==})

# fsqrt(a)^2 == a for a square a == y0^2
def sq_ok(+mp: Nat, +hp: PM.Prime(1n+mp), +s: Nat, +he: {Nat.add(1n+mp, 1n) == Nat.mul(s, 4n) : Nat}, +a: Nat, +y0: Nat, +ha: {Nat.mod(a, 1n+mp) == FS.mmul(1n+mp, y0, y0) : Nat}) -> {FS.mmul(1n+mp, FS.fsqrt(1n+mp, a), FS.fsqrt(1n+mp, a)) == Nat.mod(a, 1n+mp) : Nat}:
  %goal {Nat.mod(Nat.mul(Nat.mod(Nat.pow(a, Nat.div(Nat.add(1n+mp, 1n), 4n)), 1n+mp), Nat.mod(Nat.pow(a, Nat.div(Nat.add(1n+mp, 1n), 4n)), 1n+mp)), 1n+mp) == Nat.mod(a, 1n+mp) : Nat}
  %rw div4(mp, s, he)
  %rw div4(mp, s, he)
  %rw NR.mod_mul_l(mp, Nat.pow(a, s), Nat.mod(Nat.pow(a, s), 1n+mp))
  %rw NR.mod_mul_r(mp, Nat.pow(a, s), Nat.pow(a, s))
  %rw <- NR.pow_add(a, s, s)
  %rw <- MP.mod_pow(mp, a, Nat.add(s, s))
  %rwh ha : {Nat.mod(a, 1n+mp) == Nat.mod(Nat.mul(y0, y0), 1n+mp) : Nat}
  %rwh ha : {Nat.mod(a, 1n+mp) == Nat.mod(Nat.mul(y0, y0), 1n+mp) : Nat}
  %rw MP.mod_pow(mp, Nat.mul(y0, y0), Nat.add(s, s))
  %rw NR.mul_pow(y0, y0, Nat.add(s, s))
  %rw <- NR.pow_add(y0, Nat.add(s, s), Nat.add(s, s))
  %rw <- dbl_s(s)
  %rwh Equal.sym(Nat, Nat.add(1n+mp, 1n), Nat.mul(s, 4n), he) : {Nat.mul(s, 4n) == Nat.add(1n+mp, 1n) : Nat}
  %rw NR.pow_add(y0, 1n+mp, 1n)
  %rw <- NR.mod_mul_l(mp, Nat.pow(y0, 1n+mp), Nat.pow(y0, 1n))
  %rw FL.flt(1n+mp, hp, y0)
  %rw NR.mod_mul_l(mp, y0, Nat.pow(y0, 1n))
  %goal {Nat.mod(Nat.mul(y0, Nat.mul(y0, 1n)), 1n+mp) == Nat.mod(Nat.mul(y0, y0), 1n+mp) : Nat}
  %rw NA.mul_one(y0)
  %close

# ---- parities ----

def tw_s(+b: Nat) -> {Nat.add(b, b) == Nat.mul(b, 2n) : Nat}:
  %norm

# a + b odd: a and b have different parities
def par_ne(+a: Nat, +b: Nat, +heq: {Nat.mod(a, 2n) == Nat.mod(b, 2n) : Nat}, +hs: {Nat.mod(Nat.add(a, b), 2n) == 1n : Nat}) -> Empty:
  N.succ_zero(0n, Equal.trans(Nat, 1n, Nat.mod(Nat.add(a, b), 2n), 0n, Equal.sym(Nat, Nat.mod(Nat.add(a, b), 2n), 1n, hs),
    Equal.trans(Nat, Nat.mod(Nat.add(a, b), 2n), Nat.mod(Nat.add(Nat.mod(a, 2n), b), 2n), 0n, Equal.sym(Nat, Nat.mod(Nat.add(Nat.mod(a, 2n), b), 2n), Nat.mod(Nat.add(a, b), 2n), NR.mod_add_l(1n, a, b)),
      Equal.trans(Nat, Nat.mod(Nat.add(Nat.mod(a, 2n), b), 2n), Nat.mod(Nat.add(Nat.mod(b, 2n), b), 2n), 0n, Equal.cong(Nat, Nat, z => Nat.mod(Nat.add(z, b), 2n), Nat.mod(a, 2n), Nat.mod(b, 2n), heq),
        Equal.trans(Nat, Nat.mod(Nat.add(Nat.mod(b, 2n), b), 2n), Nat.mod(Nat.add(b, b), 2n), 0n, NR.mod_add_l(1n, b, b),
          Equal.trans(Nat, Nat.mod(Nat.add(b, b), 2n), Nat.mod(Nat.mul(b, 2n), 2n), 0n, Equal.cong(Nat, Nat, z => Nat.mod(z, 2n), Nat.add(b, b), Nat.mul(b, 2n), tw_s(b)), PM.mod_mul0(1n, b)))))))

def sub_le(a: Nat, b: Nat) -> {Nat.is_le(Nat.sub(a, b), a) == True{} : Bool}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+y:
      {==}
    case 1n+ +x 0n:
      N.le_refl(1n+x)
    case 1n+ +x 1n+ +y:
      N.le_trans(Nat.sub(x, y), x, 1n+x, sub_le(x, y), N.le_succ(x))

# a reduced residue is itself modulo m
def mred(+mp: Nat, +y: Nat, +hy: {Nat.is_lt(y, 1n+mp) == True{} : Bool}) -> {Nat.mod(y, 1n+mp) == y : Nat}:
  NR.mod_of(0n, mp, y, hy)

# -(1 + rp) is m - (1 + rp)
def neg_pos(+mp: Nat, +rp: Nat, +hr: {Nat.is_lt(1n+rp, 1n+mp) == True{} : Bool}) -> {FS.mneg(1n+mp, 1n+rp) == Nat.sub(mp, rp) : Nat}:
  %goal {Nat.mod(Nat.sub(1n+mp, Nat.mod(1n+rp, 1n+mp)), 1n+mp) == Nat.sub(mp, rp) : Nat}
  %rw mred(mp, 1n+rp, hr)
  mred(mp, Nat.sub(mp, rp), N.le_lt_succ(Nat.sub(mp, rp), mp, sub_le(mp, rp)))

def np_s(+d: Nat, +rp: Nat) -> {Nat.add(d, 1n+rp) == 1n+Nat.add(rp, d) : Nat}:
  %norm

# (m - r) + r == m
def neg_sum(+mp: Nat, +rp: Nat, +hr: {Nat.is_lt(1n+rp, 1n+mp) == True{} : Bool}) -> {Nat.add(Nat.sub(mp, rp), 1n+rp) == 1n+mp : Nat}:
  %rw np_s(Nat.sub(mp, rp), rp)
  %rw N.sub_add(mp, rp, N.lt_le(rp, mp, hr))
  %close

# -r and r have the same parity only for r == 0 (m odd)
def neg_par(+mp: Nat, +hodd: {Nat.mod(1n+mp, 2n) == 1n : Nat}, r: Nat, +hr: {Nat.is_lt(r, 1n+mp) == True{} : Bool}, +hpar: {Nat.mod(FS.mneg(1n+mp, r), 2n) == Nat.mod(r, 2n) : Nat}) -> {FS.mneg(1n+mp, r) == r : Nat}:
  match r:
    case 0n:
      %goal {Nat.mod(Nat.sub(1n+mp, 0n), 1n+mp) == 0n : Nat}
      %rw N.sub_zero(1n+mp)
      NC.m_self(mp)
    case 1n+ +rp:
      Empty.absurd({FS.mneg(1n+mp, 1n+rp) == 1n+rp : Nat}, par_ne(Nat.sub(mp, rp), 1n+rp,
        Equal.trans(Nat, Nat.mod(Nat.sub(mp, rp), 2n), Nat.mod(FS.mneg(1n+mp, 1n+rp), 2n), Nat.mod(1n+rp, 2n), Equal.cong(Nat, Nat, z => Nat.mod(z, 2n), Nat.sub(mp, rp), FS.mneg(1n+mp, 1n+rp), Equal.sym(Nat, FS.mneg(1n+mp, 1n+rp), Nat.sub(mp, rp), neg_pos(mp, rp, hr))), hpar),
        Equal.trans(Nat, Nat.mod(Nat.add(Nat.sub(mp, rp), 1n+rp), 2n), Nat.mod(1n+mp, 2n), 1n, Equal.cong(Nat, Nat, z => Nat.mod(z, 2n), Nat.add(Nat.sub(mp, rp), 1n+rp), 1n+mp, neg_sum(mp, rp, hr)), hodd)))

# ---- the root with the requested parity ----

# r + y == 0: y is -r
def neg_of(+mp: Nat, +r: Nat, +y: Nat, +hy: {Nat.is_lt(y, 1n+mp) == True{} : Bool}, +h: {Nat.mod(Nat.add(r, y), 1n+mp) == 0n : Nat}) -> {FS.mneg(1n+mp, r) == y : Nat}:
  Equal.trans(Nat, FS.mneg(1n+mp, r), Nat.mod(FS.mneg(1n+mp, r), 1n+mp), y, Equal.sym(Nat, Nat.mod(FS.mneg(1n+mp, r), 1n+mp), FS.mneg(1n+mp, r), NR.mod_mod(mp, Nat.sub(Nat.add(0n, 1n+mp), Nat.mod(r, 1n+mp)))),
    Equal.trans(Nat, Nat.mod(FS.mneg(1n+mp, r), 1n+mp), Nat.mod(y, 1n+mp), y,
      Z.mcancel(mp, FS.mneg(1n+mp, r), y, r, Equal.trans(Nat, Nat.mod(Nat.add(FS.mneg(1n+mp, r), r), 1n+mp), 0n, Nat.mod(Nat.add(y, r), 1n+mp), Z.msub_add(mp, 0n, r), Equal.sym(Nat, Nat.mod(Nat.add(y, r), 1n+mp), 0n, Equal.trans(Nat, Nat.mod(Nat.add(y, r), 1n+mp), Nat.mod(Nat.add(r, y), 1n+mp), 0n, Equal.cong(Nat, Nat, z => Nat.mod(z, 1n+mp), Nat.add(y, r), Nat.add(r, y), NA.add_comm(y, r)), h)))),
      mred(mp, y, hy)))

def pick_b(+mp: Nat, +hodd: {Nat.mod(1n+mp, 2n) == 1n : Nat}, +r: Nat, +y: Nat, +hr: {Nat.is_lt(r, 1n+mp) == True{} : Bool}, +hn: {FS.mneg(1n+mp, r) == y : Nat}, b: Bool, +hb: {Nat.is_eq(Nat.mod(r, 2n), Nat.mod(y, 2n)) == b : Bool}) -> {CS.pick_if(1n+mp, r, b) == y : Nat}:
  match b:
    case False{}:
      hn
    case True{}:
      Equal.trans(Nat, r, FS.mneg(1n+mp, r), y, Equal.sym(Nat, FS.mneg(1n+mp, r), r, neg_par(mp, hodd, r, hr, Equal.trans(Nat, Nat.mod(FS.mneg(1n+mp, r), 2n), Nat.mod(y, 2n), Nat.mod(r, 2n), Equal.cong(Nat, Nat, z => Nat.mod(z, 2n), FS.mneg(1n+mp, r), y, hn), Equal.sym(Nat, Nat.mod(r, 2n), Nat.mod(y, 2n), N.eq_from_is_eq(Nat.mod(r, 2n), Nat.mod(y, 2n), hb))))), hn)

def pick_same(+mp: Nat, +r: Nat) -> {CS.pick_parity(1n+mp, r, Nat.mod(r, 2n)) == r : Nat}:
  %goal {CS.pick_if(1n+mp, r, Nat.is_eq(Nat.mod(r, 2n), Nat.mod(r, 2n))) == r : Nat}
  %rw N.is_eq_refl(Nat.mod(r, 2n))
  %close

def pick_c(+mp: Nat, +hp: PM.Prime(1n+mp), +hodd: {Nat.mod(1n+mp, 2n) == 1n : Nat}, +r: Nat, +y: Nat, +hr: {Nat.is_lt(r, 1n+mp) == True{} : Bool}, +hy: {Nat.is_lt(y, 1n+mp) == True{} : Bool}, +hsq: {FS.mmul(1n+mp, r, r) == FS.mmul(1n+mp, y, y) : Nat}, c: Bool, +hc: {Nat.is_eq(Nat.mod(FS.msub(1n+mp, r, y), 1n+mp), 0n) == c : Bool}) -> {CS.pick_parity(1n+mp, r, Nat.mod(y, 2n)) == y : Nat}:
  match c:
    case True{}:
      %Equal.trans(Nat, r, Nat.mod(r, 1n+mp), y, Equal.sym(Nat, Nat.mod(r, 1n+mp), r, mred(mp, r, hr)), Equal.trans(Nat, Nat.mod(r, 1n+mp), Nat.mod(y, 1n+mp), y, F.msub_z(mp, r, y, N.eq_from_is_eq(Nat.mod(FS.msub(1n+mp, r, y), 1n+mp), 0n, hc)), mred(mp, y, hy))) : {CS.pick_parity(1n+mp, r, Nat.mod(_, 2n)) == y : Nat}
      %Equal.trans(Nat, r, Nat.mod(r, 1n+mp), y, Equal.sym(Nat, Nat.mod(r, 1n+mp), r, mred(mp, r, hr)), Equal.trans(Nat, Nat.mod(r, 1n+mp), Nat.mod(y, 1n+mp), y, F.msub_z(mp, r, y, N.eq_from_is_eq(Nat.mod(FS.msub(1n+mp, r, y), 1n+mp), 0n, hc)), mred(mp, y, hy))) : {CS.pick_parity(1n+mp, r, Nat.mod(r, 2n)) == _ : Nat}
      pick_same(mp, r)
    case False{}:
      pick_b(mp, hodd, r, y, hr, neg_of(mp, r, y, hy, F.z_red(mp, Nat.add(r, y), F.zprod(mp, hp, FS.msub(1n+mp, r, y), FS.madd(1n+mp, r, y), F.z_red(mp, Nat.mul(FS.msub(1n+mp, r, y), FS.madd(1n+mp, r, y)), IE.sq_diff(mp, r, y, hsq)), hc))), Nat.is_eq(Nat.mod(r, 2n), Nat.mod(y, 2n)), {==})

# r^2 == y^2 (both reduced): the root of r's pair with y's parity is y
def pick(+mp: Nat, +hp: PM.Prime(1n+mp), +hodd: {Nat.mod(1n+mp, 2n) == 1n : Nat}, +r: Nat, +y: Nat, +hr: {Nat.is_lt(r, 1n+mp) == True{} : Bool}, +hy: {Nat.is_lt(y, 1n+mp) == True{} : Bool}, +hsq: {FS.mmul(1n+mp, r, r) == FS.mmul(1n+mp, y, y) : Nat}) -> {CS.pick_parity(1n+mp, r, Nat.mod(y, 2n)) == y : Nat}:
  pick_c(mp, hp, hodd, r, y, hr, hy, hsq, Nat.is_eq(Nat.mod(FS.msub(1n+mp, r, y), 1n+mp), 0n), {==})
