import Base
import ../../../lib/lemmas/proofs/nat_algebra.bend as NA
import ../../../math/typed/width.bend as WW
import ../semiring.bend as SR
import ../../../lib/logic.bend as Lg
import ../../../lib/nat.bend as N
import ../../../../spec/lib/common.bend as C
import ../../../../spec/crypto/secp256k1/field.bend as FS
import ../../../../spec/crypto/secp256k1/curve.bend as CS
import ../../../../spec/crypto/secp256k1/group.bend as GS
import ../../../math/number/nt_prime.bend as PM
import ./glaw1.bend as G1
import ./glaw2.bend as G2
import ./glaw3.bend as G3

# Scalar multiplication on the specification's points (modulus m = 1 + mp
# with the field facts hp, h3, hnc, h21 of glaw1.bend): [k] A as k additions
# (GS.smul) is additive and multiplicative in k up to equiv, and the
# specification's double-and-add CS.pmul computes it.

def v_smul(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, k: Nat, +a: CS.SPoint, +va: {GS.valid(1n+mp, a) == True{} : Bool}) -> {GS.valid(1n+mp, GS.smul(1n+mp, k, a)) == True{} : Bool}:
  match k:
    case 0n:
      G2.v_inf(mp, h21)
    case 1n+ +j:
      G1.v_add(mp, hp, h3, hnc, h21, GS.smul(1n+mp, j, a), a, v_smul(mp, hp, h3, hnc, h21, j, a, va), va)

# O + A equiv A
def unit_l(+mp: Nat, +a: CS.SPoint) -> {GS.equiv(1n+mp, CS.padd(1n+mp, CS.infinity(), a), a) == True{} : Bool}:
  %G1.add_comm(mp, a, CS.infinity()) : {GS.equiv(1n+mp, _, a) == True{} : Bool}
  G2.unit(mp, a)

def assoc_c(+mp: Nat, +a: CS.SPoint, +b: CS.SPoint, +c: CS.SPoint, +va: {GS.valid(1n+mp, a) == True{} : Bool}, +vb: {GS.valid(1n+mp, b) == True{} : Bool}, +vc: {GS.valid(1n+mp, c) == True{} : Bool}) -> {GS.equiv(1n+mp, CS.padd(1n+mp, CS.padd(1n+mp, a, b), c), CS.padd(1n+mp, a, CS.padd(1n+mp, c, b))) == True{} : Bool}:
  %G1.add_comm(mp, b, c) : {GS.equiv(1n+mp, CS.padd(1n+mp, CS.padd(1n+mp, a, b), c), CS.padd(1n+mp, a, _)) == True{} : Bool}
  G3.assoc(mp, a, b, c, va, vb, vc)

# (A + B) + C equiv (A + C) + B
def add_swap(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +a: CS.SPoint, +b: CS.SPoint, +c: CS.SPoint, +va: {GS.valid(1n+mp, a) == True{} : Bool}, +vb: {GS.valid(1n+mp, b) == True{} : Bool}, +vc: {GS.valid(1n+mp, c) == True{} : Bool}) -> {GS.equiv(1n+mp, CS.padd(1n+mp, CS.padd(1n+mp, a, b), c), CS.padd(1n+mp, CS.padd(1n+mp, a, c), b)) == True{} : Bool}:
  G2.e_trans(mp, hp, CS.padd(1n+mp, CS.padd(1n+mp, a, b), c), CS.padd(1n+mp, a, CS.padd(1n+mp, c, b)), CS.padd(1n+mp, CS.padd(1n+mp, a, c), b), G1.v_add(mp, hp, h3, hnc, h21, a, CS.padd(1n+mp, c, b), va, G1.v_add(mp, hp, h3, hnc, h21, c, b, vc, vb)), assoc_c(mp, a, b, c, va, vb, vc), G2.e_sym(mp, CS.padd(1n+mp, CS.padd(1n+mp, a, c), b), CS.padd(1n+mp, a, CS.padd(1n+mp, c, b)), G3.assoc(mp, a, c, b, va, vc, vb)))

# [j + k] A equiv [j] A + [k] A
def smul_add(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, j: Nat, +k: Nat, +a: CS.SPoint, +va: {GS.valid(1n+mp, a) == True{} : Bool}) -> {GS.equiv(1n+mp, GS.smul(1n+mp, Nat.add(j, k), a), CS.padd(1n+mp, GS.smul(1n+mp, j, a), GS.smul(1n+mp, k, a))) == True{} : Bool}:
  match j:
    case 0n:
      G2.e_sym(mp, CS.padd(1n+mp, CS.infinity(), GS.smul(1n+mp, k, a)), GS.smul(1n+mp, k, a), unit_l(mp, GS.smul(1n+mp, k, a)))
    case 1n+ +i:
      +vi = v_smul(mp, hp, h3, hnc, h21, i, a, va)
      +vk = v_smul(mp, hp, h3, hnc, h21, k, a, va)
      +vik = v_smul(mp, hp, h3, hnc, h21, Nat.add(i, k), a, va)
      +vm = G1.v_add(mp, hp, h3, hnc, h21, GS.smul(1n+mp, i, a), GS.smul(1n+mp, k, a), vi, vk)
      G2.e_trans(mp, hp, CS.padd(1n+mp, GS.smul(1n+mp, Nat.add(i, k), a), a), CS.padd(1n+mp, CS.padd(1n+mp, GS.smul(1n+mp, i, a), GS.smul(1n+mp, k, a)), a), CS.padd(1n+mp, CS.padd(1n+mp, GS.smul(1n+mp, i, a), a), GS.smul(1n+mp, k, a)), G1.v_add(mp, hp, h3, hnc, h21, CS.padd(1n+mp, GS.smul(1n+mp, i, a), GS.smul(1n+mp, k, a)), a, vm, va),
        G2.e_add_l(mp, hp, GS.smul(1n+mp, Nat.add(i, k), a), CS.padd(1n+mp, GS.smul(1n+mp, i, a), GS.smul(1n+mp, k, a)), a, vik, vm, smul_add(mp, hp, h3, hnc, h21, i, k, a, va)),
        add_swap(mp, hp, h3, hnc, h21, GS.smul(1n+mp, i, a), GS.smul(1n+mp, k, a), a, vi, vk, va))

# [j k] A equiv [j] ([k] A)
def smul_mul(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, j: Nat, +k: Nat, +a: CS.SPoint, +va: {GS.valid(1n+mp, a) == True{} : Bool}) -> {GS.equiv(1n+mp, GS.smul(1n+mp, Nat.mul(j, k), a), GS.smul(1n+mp, j, GS.smul(1n+mp, k, a))) == True{} : Bool}:
  match j:
    case 0n:
      G2.e_refl(mp, CS.infinity())
    case 1n+ +i:
      +q = GS.smul(1n+mp, k, a)
      +vq = v_smul(mp, hp, h3, hnc, h21, k, a, va)
      +vi = v_smul(mp, hp, h3, hnc, h21, Nat.mul(i, k), a, va)
      +viq = v_smul(mp, hp, h3, hnc, h21, i, q, vq)
      %G1.add_comm(mp, q, GS.smul(1n+mp, i, q)) : {GS.equiv(1n+mp, GS.smul(1n+mp, Nat.add(k, Nat.mul(i, k)), a), _) == True{} : Bool}
      G2.e_trans(mp, hp, GS.smul(1n+mp, Nat.add(k, Nat.mul(i, k)), a), CS.padd(1n+mp, q, GS.smul(1n+mp, Nat.mul(i, k), a)), CS.padd(1n+mp, q, GS.smul(1n+mp, i, q)), G1.v_add(mp, hp, h3, hnc, h21, q, GS.smul(1n+mp, Nat.mul(i, k), a), vq, vi),
        smul_add(mp, hp, h3, hnc, h21, k, Nat.mul(i, k), a, va),
        G2.e_add_r(mp, hp, q, GS.smul(1n+mp, Nat.mul(i, k), a), GS.smul(1n+mp, i, q), vi, viq, smul_mul(mp, hp, h3, hnc, h21, i, k, a, va)))

# A equiv A2: [k] A equiv [k] A2
def smul_eqv(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, k: Nat, +a: CS.SPoint, +a2: CS.SPoint, +va: {GS.valid(1n+mp, a) == True{} : Bool}, +va2: {GS.valid(1n+mp, a2) == True{} : Bool}, +h: {GS.equiv(1n+mp, a, a2) == True{} : Bool}) -> {GS.equiv(1n+mp, GS.smul(1n+mp, k, a), GS.smul(1n+mp, k, a2)) == True{} : Bool}:
  match k:
    case 0n:
      G2.e_refl(mp, CS.infinity())
    case 1n+ +j:
      +v1 = v_smul(mp, hp, h3, hnc, h21, j, a, va)
      +v2 = v_smul(mp, hp, h3, hnc, h21, j, a2, va2)
      G2.e_trans(mp, hp, CS.padd(1n+mp, GS.smul(1n+mp, j, a), a), CS.padd(1n+mp, GS.smul(1n+mp, j, a2), a), CS.padd(1n+mp, GS.smul(1n+mp, j, a2), a2), G1.v_add(mp, hp, h3, hnc, h21, GS.smul(1n+mp, j, a2), a, v2, va),
        G2.e_add_l(mp, hp, GS.smul(1n+mp, j, a), GS.smul(1n+mp, j, a2), a, v1, v2, smul_eqv(mp, hp, h3, hnc, h21, j, a, a2, va, va2, h)),
        G2.e_add_r(mp, hp, GS.smul(1n+mp, j, a2), a, a2, va, va2, h))

# ---- the specification's double-and-add ----

# the number a list of bits adds to v (most significant bit first; any
# nonzero entry is a set bit, as CS.step takes it)
def nxt(b: Nat, +v: Nat) -> Nat:
  match b:
    case 0n:
      Nat.double(v)
    case 1n+c:
      1n+Nat.double(v)

def bvl(bs: List<&2, Nat>, +v: Nat) -> Nat:
  match bs:
    case Nil{}:
      v
    case b <> t:
      bvl(t, nxt(b, v))

# R equiv [v] A: 2 R equiv [2 v] A
def dbl_v(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +a: CS.SPoint, +r: CS.SPoint, +v: Nat, +va: {GS.valid(1n+mp, a) == True{} : Bool}, +vr: {GS.valid(1n+mp, r) == True{} : Bool}, +hr: {GS.equiv(1n+mp, r, GS.smul(1n+mp, v, a)) == True{} : Bool}) -> {GS.equiv(1n+mp, CS.pdbl(1n+mp, r), GS.smul(1n+mp, Nat.double(v), a)) == True{} : Bool}:
  +s = GS.smul(1n+mp, v, a)
  +vs = v_smul(mp, hp, h3, hnc, h21, v, a, va)
  %Equal.sym(CS.SPoint, CS.pdbl(1n+mp, r), CS.padd(1n+mp, r, r), G2.dbl(mp, r, vr)) : {GS.equiv(1n+mp, _, GS.smul(1n+mp, Nat.double(v), a)) == True{} : Bool}
  %Equal.sym(Nat, Nat.double(v), Nat.add(v, v), NA.double_self(v)) : {GS.equiv(1n+mp, CS.padd(1n+mp, r, r), GS.smul(1n+mp, _, a)) == True{} : Bool}
  G2.e_trans(mp, hp, CS.padd(1n+mp, r, r), CS.padd(1n+mp, s, s), GS.smul(1n+mp, Nat.add(v, v), a), G1.v_add(mp, hp, h3, hnc, h21, s, s, vs, vs),
    G2.e_trans(mp, hp, CS.padd(1n+mp, r, r), CS.padd(1n+mp, s, r), CS.padd(1n+mp, s, s), G1.v_add(mp, hp, h3, hnc, h21, s, r, vs, vr),
      G2.e_add_l(mp, hp, r, s, r, vr, vs, hr),
      G2.e_add_r(mp, hp, s, r, s, vr, vs, hr)),
    G2.e_sym(mp, GS.smul(1n+mp, Nat.add(v, v), a), CS.padd(1n+mp, s, s), smul_add(mp, hp, h3, hnc, h21, v, v, a, va)))

def dbl_valid(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +r: CS.SPoint, +vr: {GS.valid(1n+mp, r) == True{} : Bool}) -> {GS.valid(1n+mp, CS.pdbl(1n+mp, r)) == True{} : Bool}:
  %Equal.sym(CS.SPoint, CS.pdbl(1n+mp, r), CS.padd(1n+mp, r, r), G2.dbl(mp, r, vr)) : {GS.valid(1n+mp, _) == True{} : Bool}
  G1.v_add(mp, hp, h3, hnc, h21, r, r, vr, vr)

def LmulV(+mp: Nat, +bs: List<&2, Nat>, +a: CS.SPoint, +r: CS.SPoint, +v: Nat) -> Data:
  {GS.equiv(1n+mp, CS.lmul(1n+mp, bs, a, r), GS.smul(1n+mp, bvl(bs, v), a)) == True{} : Bool}

# the loop: R equiv [v] A gives lmul(bs, A, R) equiv [bvl(bs, v)] A
def lmul_v(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, bs: List<&2, Nat>, +a: CS.SPoint, +r: CS.SPoint, +v: Nat, +va: {GS.valid(1n+mp, a) == True{} : Bool}, +vr: {GS.valid(1n+mp, r) == True{} : Bool}, +hr: {GS.equiv(1n+mp, r, GS.smul(1n+mp, v, a)) == True{} : Bool}) -> {GS.equiv(1n+mp, CS.lmul(1n+mp, bs, a, r), GS.smul(1n+mp, bvl(bs, v), a)) == True{} : Bool}:
  match bs:
    case Nil{}:
      hr
    case 0n <> +t:
      lmul_v(mp, hp, h3, hnc, h21, t, a, CS.pdbl(1n+mp, r), Nat.double(v), va, dbl_valid(mp, hp, h3, hnc, h21, r, vr), dbl_v(mp, hp, h3, hnc, h21, a, r, v, va, vr, hr))
    case (1n+c) <> +t:
      +d = CS.pdbl(1n+mp, r)
      +vd = dbl_valid(mp, hp, h3, hnc, h21, r, vr)
      lmul_v(mp, hp, h3, hnc, h21, t, a, CS.padd(1n+mp, d, a), 1n+Nat.double(v), va, G1.v_add(mp, hp, h3, hnc, h21, d, a, vd, va),
        G2.e_add_l(mp, hp, d, GS.smul(1n+mp, Nat.double(v), a), a, vd, v_smul(mp, hp, h3, hnc, h21, Nat.double(v), a, va), dbl_v(mp, hp, h3, hnc, h21, a, r, v, va, vr, hr)))

def lmul_valid(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, bs: List<&2, Nat>, +a: CS.SPoint, +r: CS.SPoint, +va: {GS.valid(1n+mp, a) == True{} : Bool}, +vr: {GS.valid(1n+mp, r) == True{} : Bool}) -> {GS.valid(1n+mp, CS.lmul(1n+mp, bs, a, r)) == True{} : Bool}:
  match bs:
    case Nil{}:
      vr
    case 0n <> +t:
      lmul_valid(mp, hp, h3, hnc, h21, t, a, CS.pdbl(1n+mp, r), va, dbl_valid(mp, hp, h3, hnc, h21, r, vr))
    case (1n+c) <> +t:
      lmul_valid(mp, hp, h3, hnc, h21, t, a, CS.padd(1n+mp, CS.pdbl(1n+mp, r), a), va, G1.v_add(mp, hp, h3, hnc, h21, CS.pdbl(1n+mp, r), a, dbl_valid(mp, hp, h3, hnc, h21, r, vr), va))

# ---- the value of the specification's bits ----

def nxt_c(b: Nat, +v: Nat, +hb: {Nat.is_le(b, 1n) == True{} : Bool}) -> {nxt(b, v) == Nat.add(b, Nat.double(v)) : Nat}:
  match b:
    case 0n:
      {==}
    case 1n:
      {==}
    case 2n+q:
      Empty.absurd({nxt(2n+q, v) == Nat.add(2n+q, Nat.double(v)) : Nat}, Lg.false_true(hb))

def low_s(+b: Nat, +l: Nat, +s: Nat) -> {Nat.add(b, Nat.double(Nat.add(l, s))) == Nat.add(Nat.add(b, Nat.double(l)), Nat.double(s)) : Nat}:
  %rw NA.double_add(l, s)
  %norm

# the low 1 + j bits: the low j bits and bit j
def low_top(j: Nat, +n: Nat) -> {C.low(1n+j, n) == Nat.add(C.low(j, n), C.shift(j, C.bit(C.high(j, n)))) : Nat}:
  match j:
    case 0n:
      %goal {Nat.add(C.bit(n), 0n) == C.bit(n) : Nat}
      NA.add_zero(C.bit(n))
    case 1n+ +i:
      %goal {Nat.add(C.bit(n), Nat.double(C.low(1n+i, C.half(n)))) == Nat.add(Nat.add(C.bit(n), Nat.double(C.low(i, C.half(n)))), Nat.double(C.shift(i, C.bit(C.high(i, C.half(n)))))) : Nat}
      %rw low_top(i, C.half(n))
      low_s(C.bit(n), C.low(i, C.half(n)), C.shift(i, C.bit(C.high(i, C.half(n)))))

def bv_s(+l: Nat, +sb: Nat, +sv: Nat) -> {Nat.add(l, Nat.add(sb, sv)) == Nat.add(Nat.add(l, sb), sv) : Nat}:
  %norm

def bits_go_v(i: Nat, +k: Nat, +v: Nat) -> {bvl(CS.bits_go(i, k), v) == Nat.add(C.low(i, k), C.shift(i, v)) : Nat}:
  match i:
    case 0n:
      {==}
    case 1n+ +j:
      %goal {bvl(CS.bits_go(j, k), nxt(C.bit(C.high(j, k)), v)) == Nat.add(C.low(1n+j, k), Nat.double(C.shift(j, v))) : Nat}
      %rw bits_go_v(j, k, nxt(C.bit(C.high(j, k)), v))
      %rw nxt_c(C.bit(C.high(j, k)), v, WW.bit_le1(C.high(j, k)))
      %rw WW.shift_add(j, C.bit(C.high(j, k)), Nat.double(v))
      %rw WW.shift_dbl(j, v)
      %rw low_top(j, k)
      bv_s(C.low(j, k), C.shift(j, C.bit(C.high(j, k))), Nat.double(C.shift(j, v)))

def bits_is(+i: Nat, k: Nat) -> {CS.bits(i, k) == CS.bits_go(i, k) : List<&2, Nat>}:
  match k:
    case 0n:
      {==}
    case 1n+j:
      {==}

def bits_v(+i: Nat, +k: Nat) -> {bvl(CS.bits(i, k), 0n) == C.low(i, k) : Nat}:
  %rw bits_is(i, k)
  %rw bits_go_v(i, k, 0n)
  %rw WW.shift_zero(i)
  NA.add_zero(C.low(i, k))

def low_fit(+i: Nat, +k: Nat, +h: {C.fits(i, k) == True{} : Bool}) -> {C.low(i, k) == k : Nat}:
  %Equal.trans(Nat, Nat.add(k, C.shift(i, 0n)), Nat.add(k, 0n), k, Equal.cong(Nat, Nat, z => Nat.add(k, z), C.shift(i, 0n), 0n, WW.shift_zero(i)), NA.add_zero(k)) : {C.low(i, _) == k : Nat}
  WW.low_u(i, k, 0n, h)

# the specification's [k] A (256 bits of k) is [k mod 2^256] A
def pmul_low(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +k: Nat, +a: CS.SPoint, +va: {GS.valid(1n+mp, a) == True{} : Bool}) -> {GS.equiv(1n+mp, CS.pmul(1n+mp, k, a), GS.smul(1n+mp, C.low(256n, k), a)) == True{} : Bool}:
  %bits_v(256n, k) : {GS.equiv(1n+mp, CS.pmul(1n+mp, k, a), GS.smul(1n+mp, _, a)) == True{} : Bool}
  lmul_v(mp, hp, h3, hnc, h21, CS.bits(256n, k), a, CS.infinity(), 0n, va, G2.v_inf(mp, h21), G2.e_refl(mp, CS.infinity()))

# for k < 2^256 the specification's [k] A is k additions of A
def pmul_smul(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +k: Nat, +a: CS.SPoint, +va: {GS.valid(1n+mp, a) == True{} : Bool}, +hk: {C.fits(256n, k) == True{} : Bool}) -> {GS.equiv(1n+mp, CS.pmul(1n+mp, k, a), GS.smul(1n+mp, k, a)) == True{} : Bool}:
  %low_fit(256n, k, hk) : {GS.equiv(1n+mp, CS.pmul(1n+mp, k, a), GS.smul(1n+mp, _, a)) == True{} : Bool}
  pmul_low(mp, hp, h3, hnc, h21, k, a, va)

def pmul_valid(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +k: Nat, +a: CS.SPoint, +va: {GS.valid(1n+mp, a) == True{} : Bool}) -> {GS.valid(1n+mp, CS.pmul(1n+mp, k, a)) == True{} : Bool}:
  lmul_valid(mp, hp, h3, hnc, h21, CS.bits(256n, k), a, CS.infinity(), va, G2.v_inf(mp, h21))
