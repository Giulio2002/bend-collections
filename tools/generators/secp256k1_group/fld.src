import Base
import ../../../lib/lemmas/proofs/nat_algebra.bend as NA
import ../../../math/typed/width.bend as WW
import ../semiring.bend as SR
import ../../../lib/logic.bend as Lg
import ../../../lib/nat.bend as N
import ../../../math/natural/arith.bend as NR
import ../../../../spec/crypto/secp256k1/field.bend as FS
import ./prime.bend as PM
import ./ntfld.bend as FD
import ./zm.bend as Z

# Zero and nonzero residues modulo a prime m = 1 + mp, in the shapes the
# group proofs use: NZ(mp, a) says m does not divide a.

def NZ(+mp: Nat, +a: Nat) -> Data:
  {Nat.is_eq(Nat.mod(a, 1n+mp), 0n) == False{} : Bool}

def nz_absurd(+mp: Nat, +a: Nat, +ha: NZ(mp, a), +h0: {Nat.mod(a, 1n+mp) == 0n : Nat}) -> Empty:
  Lg.true_false(Equal.trans(Bool, True{}, Nat.is_eq(Nat.mod(a, 1n+mp), 0n), False{}, Equal.cong(Nat, Bool, z => Nat.is_eq(z, 0n), 0n, Nat.mod(a, 1n+mp), Equal.sym(Nat, Nat.mod(a, 1n+mp), 0n, h0)), ha))

# ---- zero residues ----

def z_mul_l(+mp: Nat, +a: Nat, +b: Nat, +ha: {Nat.mod(a, 1n+mp) == 0n : Nat}) -> {Nat.mod(Nat.mul(a, b), 1n+mp) == 0n : Nat}:
  Z.cg_mul_l(mp, a, 0n, b, ha)

def z_mul_r(+mp: Nat, +a: Nat, +b: Nat, +hb: {Nat.mod(b, 1n+mp) == 0n : Nat}) -> {Nat.mod(Nat.mul(a, b), 1n+mp) == 0n : Nat}:
  %rw NA.mul_comm(a, b)
  Z.cg_mul_l(mp, b, 0n, a, hb)

def z_add(+mp: Nat, +a: Nat, +b: Nat, +ha: {Nat.mod(a, 1n+mp) == 0n : Nat}, +hb: {Nat.mod(b, 1n+mp) == 0n : Nat}) -> {Nat.mod(Nat.add(a, b), 1n+mp) == 0n : Nat}:
  Equal.trans(Nat, Nat.mod(Nat.add(a, b), 1n+mp), Nat.mod(Nat.add(0n, b), 1n+mp), 0n, Z.cg_add_l(mp, a, 0n, b, ha), hb)

# a + b == 0 and b == 0 give a == 0
def z_add_l(+mp: Nat, +a: Nat, +b: Nat, +h: {Nat.mod(Nat.add(a, b), 1n+mp) == 0n : Nat}, +hb: {Nat.mod(b, 1n+mp) == 0n : Nat}) -> {Nat.mod(a, 1n+mp) == 0n : Nat}:
  Equal.trans(Nat, Nat.mod(a, 1n+mp), Nat.mod(Nat.add(a, 0n), 1n+mp), 0n,
    Equal.cong(Nat, Nat, z => Nat.mod(z, 1n+mp), a, Nat.add(a, 0n), Equal.sym(Nat, Nat.add(a, 0n), a, NA.add_zero(a))),
    Equal.trans(Nat, Nat.mod(Nat.add(a, 0n), 1n+mp), Nat.mod(Nat.add(a, b), 1n+mp), 0n, Equal.sym(Nat, Nat.mod(Nat.add(a, b), 1n+mp), Nat.mod(Nat.add(a, 0n), 1n+mp), Z.cg_add_r(mp, a, b, 0n, hb)), h))

# a residue that is 0 mod m is 0
def z_red(+mp: Nat, +u: Nat, +h: {Nat.mod(Nat.mod(u, 1n+mp), 1n+mp) == 0n : Nat}) -> {Nat.mod(u, 1n+mp) == 0n : Nat}:
  %rw <- NR.mod_mod(mp, u)
  h

def msub_refl(+mp: Nat, +r: Nat) -> {FS.msub(1n+mp, r, r) == 0n : Nat}:
  z_red(mp, Nat.sub(Nat.add(r, 1n+mp), Nat.mod(r, 1n+mp)), Z.mcancel(mp, FS.msub(1n+mp, r, r), 0n, r, Z.msub_add(mp, r, r)))

def msub_eq0(+mp: Nat, +l: Nat, +r: Nat, +h: {l == r : Nat}) -> {FS.msub(1n+mp, l, r) == 0n : Nat}:
  %rwh h : {l == r : Nat}
  msub_refl(mp, r)

# l - r == 0 gives l == r (mod m)
def msub_z(+mp: Nat, +a: Nat, +b: Nat, +h: {Nat.mod(FS.msub(1n+mp, a, b), 1n+mp) == 0n : Nat}) -> {Nat.mod(a, 1n+mp) == Nat.mod(b, 1n+mp) : Nat}:
  Z.msub_zero(mp, a, b, z_red(mp, Nat.sub(Nat.add(a, 1n+mp), Nat.mod(b, 1n+mp)), h))

# ---- a prime modulus ----

def zprod(+mp: Nat, +hp: PM.Prime(1n+mp), +a: Nat, +b: Nat, +hab: {Nat.mod(Nat.mul(a, b), 1n+mp) == 0n : Nat}, +ha: NZ(mp, a)) -> {Nat.mod(b, 1n+mp) == 0n : Nat}:
  FD.no_zero_div(1n+mp, hp, a, b, hab, ha)

def nz_mul_c(+mp: Nat, +hp: PM.Prime(1n+mp), +a: Nat, +b: Nat, +ha: NZ(mp, a), +hb: NZ(mp, b), c: Bool, +hc: {Nat.is_eq(Nat.mod(Nat.mul(a, b), 1n+mp), 0n) == c : Bool}) -> {Nat.is_eq(Nat.mod(Nat.mul(a, b), 1n+mp), 0n) == False{} : Bool}:
  match c:
    case False{}:
      hc
    case True{}:
      Empty.absurd({Nat.is_eq(Nat.mod(Nat.mul(a, b), 1n+mp), 0n) == False{} : Bool}, nz_absurd(mp, b, hb, zprod(mp, hp, a, b, N.eq_from_is_eq(Nat.mod(Nat.mul(a, b), 1n+mp), 0n, hc), ha)))

def nz_mul(+mp: Nat, +hp: PM.Prime(1n+mp), +a: Nat, +b: Nat, +ha: NZ(mp, a), +hb: NZ(mp, b)) -> NZ(mp, Nat.mul(a, b)):
  nz_mul_c(mp, hp, a, b, ha, hb, Nat.is_eq(Nat.mod(Nat.mul(a, b), 1n+mp), 0n), {==})

def nz_mod(+mp: Nat, +a: Nat, +ha: NZ(mp, a)) -> NZ(mp, Nat.mod(a, 1n+mp)):
  %goal {Nat.is_eq(Nat.mod(Nat.mod(a, 1n+mp), 1n+mp), 0n) == False{} : Bool}
  %rw NR.mod_mod(mp, a)
  ha

def nz_mmul(+mp: Nat, +hp: PM.Prime(1n+mp), +a: Nat, +b: Nat, +ha: NZ(mp, a), +hb: NZ(mp, b)) -> NZ(mp, FS.mmul(1n+mp, a, b)):
  nz_mod(mp, Nat.mul(a, b), nz_mul(mp, hp, a, b, ha, hb))

# (l - r) f == 0 with f nonzero: l == r
def eq_of_factor(+mp: Nat, +hp: PM.Prime(1n+mp), +l: Nat, +r: Nat, +f: Nat, +hf: NZ(mp, f), +h: {Nat.mod(Nat.mul(FS.msub(1n+mp, l, r), f), 1n+mp) == 0n : Nat}) -> {Nat.mod(l, 1n+mp) == Nat.mod(r, 1n+mp) : Nat}:
  msub_z(mp, l, r, zprod(mp, hp, f, FS.msub(1n+mp, l, r), Equal.trans(Nat, Nat.mod(Nat.mul(f, FS.msub(1n+mp, l, r)), 1n+mp), Nat.mod(Nat.mul(FS.msub(1n+mp, l, r), f), 1n+mp), 0n, Equal.cong(Nat, Nat, z => Nat.mod(z, 1n+mp), Nat.mul(f, FS.msub(1n+mp, l, r)), Nat.mul(FS.msub(1n+mp, l, r), f), NA.mul_comm(f, FS.msub(1n+mp, l, r))), h), hf))

def mmul_comm(+mp: Nat, +a: Nat, +b: Nat) -> {FS.mmul(1n+mp, a, b) == FS.mmul(1n+mp, b, a) : Nat}:
  Equal.cong(Nat, Nat, z => Nat.mod(z, 1n+mp), Nat.mul(a, b), Nat.mul(b, a), NA.mul_comm(a, b))

def z_mod(+mp: Nat, +u: Nat, +h: {Nat.mod(u, 1n+mp) == 0n : Nat}) -> {Nat.mod(Nat.mod(u, 1n+mp), 1n+mp) == 0n : Nat}:
  Equal.trans(Nat, Nat.mod(Nat.mod(u, 1n+mp), 1n+mp), Nat.mod(u, 1n+mp), 0n, NR.mod_mod(mp, u), h)

def z_mmul_l(+mp: Nat, +a: Nat, +b: Nat, +ha: {Nat.mod(a, 1n+mp) == 0n : Nat}) -> {Nat.mod(FS.mmul(1n+mp, a, b), 1n+mp) == 0n : Nat}:
  z_mod(mp, Nat.mul(a, b), z_mul_l(mp, a, b, ha))

def z_mmul_r(+mp: Nat, +a: Nat, +b: Nat, +hb: {Nat.mod(b, 1n+mp) == 0n : Nat}) -> {Nat.mod(FS.mmul(1n+mp, a, b), 1n+mp) == 0n : Nat}:
  z_mod(mp, Nat.mul(a, b), z_mul_r(mp, a, b, hb))

def z_cube(+mp: Nat, +d: Nat, +h: {Nat.mod(d, 1n+mp) == 0n : Nat}) -> {Nat.mod(FS.mmul(1n+mp, FS.mmul(1n+mp, d, d), d), 1n+mp) == 0n : Nat}:
  z_mmul_r(mp, FS.mmul(1n+mp, d, d), d, h)

def z_msub(+mp: Nat, +a: Nat, +b: Nat, +ha: {Nat.mod(a, 1n+mp) == 0n : Nat}, +hb: {Nat.mod(b, 1n+mp) == 0n : Nat}) -> {Nat.mod(FS.msub(1n+mp, a, b), 1n+mp) == 0n : Nat}:
  z_mod(mp, Nat.sub(Nat.add(a, 1n+mp), Nat.mod(b, 1n+mp)), z_red(mp, Nat.sub(Nat.add(a, 1n+mp), Nat.mod(b, 1n+mp)), z_add_l(mp, FS.msub(1n+mp, a, b), b, Equal.trans(Nat, Nat.mod(Nat.add(FS.msub(1n+mp, a, b), b), 1n+mp), Nat.mod(a, 1n+mp), 0n, Z.msub_add(mp, a, b), ha), hb)))

# the point (x : y : z) is on the curve X^3 == Y^2 Z - 7 Z^3 (residues mod m)
def OnC(+mp: Nat, +x: Nat, +y: Nat, +z: Nat) -> Data:
  {FS.mmul(1n+mp, FS.mmul(1n+mp, x, x), x) == FS.msub(1n+mp, FS.mmul(1n+mp, FS.mmul(1n+mp, y, y), z), FS.mmul(1n+mp, 7n, FS.mmul(1n+mp, FS.mmul(1n+mp, z, z), z))) : Nat}
