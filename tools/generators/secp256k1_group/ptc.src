  %Equal.sym(List<&2, Nat>, CS.run_go(1n+B.bval(p1), oc_prog(), M.vals([x, y, z, b7l()])), M.vals(M.rrr(M.brun(oc_prog(), c, p, M.RR{[x, y, z, b7l()], True{}}))), ev) : {Nat.is_eq(CS.nth(5n, _), CS.nth(11n, CS.run_go(1n+B.bval(p1), oc_prog(), M.vals([x, y, z, b7l()])))) == True{} : Bool}
  %Equal.sym(List<&2, Nat>, CS.run_go(1n+B.bval(p1), oc_prog(), M.vals([x, y, z, b7l()])), M.vals(M.rrr(M.brun(oc_prog(), c, p, M.RR{[x, y, z, b7l()], True{}}))), ev) : {Nat.is_eq(CS.nth(5n, M.vals(M.rrr(M.brun(oc_prog(), c, p, M.RR{[x, y, z, b7l()], True{}})))), CS.nth(11n, _)) == True{} : Bool}
  %Equal.sym(Nat, CS.nth(5n, M.vals(M.rrr(M.brun(oc_prog(), c, p, M.RR{[x, y, z, b7l()], True{}})))), B.bval(M.bnth(5n, M.rrr(M.brun(oc_prog(), c, p, M.RR{[x, y, z, b7l()], True{}})))), M.nth_vals(5n, M.rrr(M.brun(oc_prog(), c, p, M.RR{[x, y, z, b7l()], True{}})))) : {Nat.is_eq(_, CS.nth(11n, M.vals(M.rrr(M.brun(oc_prog(), c, p, M.RR{[x, y, z, b7l()], True{}}))))) == True{} : Bool}
