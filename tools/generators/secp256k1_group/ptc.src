  %B.beq_v(M.bnth(5n, M.rrr(M.brun(oc_prog(), c, p, M.RR{[x, y, z, b7l()], True{}}))), M.bnth(11n, M.rrr(M.brun(oc_prog(), c, p, M.RR{[x, y, z, b7l()], True{}}))), Lg.and_left(B.beq(M.bnth(5n, M.rrr(M.brun(oc_prog(), c, p, M.RR{[x, y, z, b7l()], True{}}))), M.bnth(11n, M.rrr(M.brun(oc_prog(), c, p, M.RR{[x, y, z, b7l()], True{}})))), B.beq(y, B.binc(y1)), Lg.and_right(M.rrk(M.brun(oc_prog(), c, p, M.RR{[x, y, z, b7l()], True{}})), Bool.and(B.beq(M.bnth(5n, M.rrr(M.brun(oc_prog(), c, p, M.RR{[x, y, z, b7l()], True{}}))), M.bnth(11n, M.rrr(M.brun(oc_prog(), c, p, M.RR{[x, y, z, b7l()], True{}})))), B.beq(y, B.binc(y1))), hc))) : {Nat.is_eq(B.bval(M.bnth(5n, M.rrr(M.brun(oc_prog(), c, p, M.RR{[x, y, z, b7l()], True{}})))), _) == True{} : Bool}
