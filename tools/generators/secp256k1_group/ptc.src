# Closed point computations, stated on X.bvalo (values stuck on `one`, never
# expanded): one chunk of the specification's double-and-add loop from a
# literal point to a literal point is one {==} check of the machine of
# ptm.bend (chunk), and the generator G is a point of the group (g_valid).
# The modulus is 1 + X.bvalo(one, p1) for the literals p == p1 + 1 (hn).

def spo(+one: Nat, a: M.BP) -> CS.SPoint:
  match a:
    case M.BP{x, y, z}:
      CS.SPoint{X.bvalo(one, x), X.bvalo(one, y), X.bvalo(one, z)}

def spo_v(+one: Nat, +h1: {one == 1n : Nat}, +x: B.Bn, +y: B.Bn, +z: B.Bn) -> {spo(one, M.BP{x, y, z}) == CS.SPoint{B.bval(x), B.bval(y), B.bval(z)} : CS.SPoint}:
  %X.bo(one, h1, x) : {CS.SPoint{X.bvalo(one, x), X.bvalo(one, y), X.bvalo(one, z)} == CS.SPoint{_, B.bval(y), B.bval(z)} : CS.SPoint}
  %X.bo(one, h1, y) : {CS.SPoint{X.bvalo(one, x), X.bvalo(one, y), X.bvalo(one, z)} == CS.SPoint{X.bvalo(one, x), _, B.bval(z)} : CS.SPoint}
  %X.bo(one, h1, z) : {CS.SPoint{X.bvalo(one, x), X.bvalo(one, y), X.bvalo(one, z)} == CS.SPoint{X.bvalo(one, x), X.bvalo(one, y), _} : CS.SPoint}
  {==}

def beq3(a: M.BP, b: M.BP) -> Bool:
  match a b:
    case M.BP{x1, y1, z1} M.BP{x2, y2, z2}:
      Bool.and(B.beq(x1, x2), Bool.and(B.beq(y1, y2), B.beq(z1, z2)))

def beq3_v(a: M.BP, b: M.BP, +h: {beq3(a, b) == True{} : Bool}) -> {M.spv(a) == M.spv(b) : CS.SPoint}:
  match a b:
    case M.BP{+x1, +y1, +z1} M.BP{+x2, +y2, +z2}:
      %Equal.sym(Nat, B.bval(x1), B.bval(x2), B.beq_v(x1, x2, Lg.and_left(B.beq(x1, x2), Bool.and(B.beq(y1, y2), B.beq(z1, z2)), h))) : {CS.SPoint{_, B.bval(y1), B.bval(z1)} == CS.SPoint{B.bval(x2), B.bval(y2), B.bval(z2)} : CS.SPoint}
      %Equal.sym(Nat, B.bval(y1), B.bval(y2), B.beq_v(y1, y2, Lg.and_left(B.beq(y1, y2), B.beq(z1, z2), Lg.and_right(B.beq(x1, x2), Bool.and(B.beq(y1, y2), B.beq(z1, z2)), h)))) : {CS.SPoint{B.bval(x2), _, B.bval(z1)} == CS.SPoint{B.bval(x2), B.bval(y2), B.bval(z2)} : CS.SPoint}
      %Equal.sym(Nat, B.bval(z1), B.bval(z2), B.beq_v(z1, z2, Lg.and_right(B.beq(y1, y2), B.beq(z1, z2), Lg.and_right(B.beq(x1, x2), Bool.and(B.beq(y1, y2), B.beq(z1, z2)), h)))) : {CS.SPoint{B.bval(x2), B.bval(y2), _} == CS.SPoint{B.bval(x2), B.bval(y2), B.bval(z2)} : CS.SPoint}
      {==}

# the result of a loop: every check passed and the point is e
def fck(r: M.RP, +e: M.BP) -> Bool:
  match r:
    case M.RP{pt, ok}:
      Bool.and(ok, beq3(pt, e))

def fck_ok(r: M.RP, +e: M.BP, +h: {fck(r, e) == True{} : Bool}) -> {M.rpk(r) == True{} : Bool}:
  match r:
    case M.RP{+pt, +ok}:
      Lg.and_left(ok, beq3(pt, e), h)

def fck_eq(r: M.RP, +e: M.BP, +h: {fck(r, e) == True{} : Bool}) -> {beq3(M.rpp(r), e) == True{} : Bool}:
  match r:
    case M.RP{+pt, +ok}:
      Lg.and_right(ok, beq3(pt, e), h)

# one chunk of CS.lmul on literals: from R, the bits bs give R2
def chunk(+one: Nat, +h1: {one == 1n : Nat}, +p: B.Bn, +p1: B.Bn, +c: B.Bn, +bs: List<&2, Nat>, +gx: B.Bn, +gy: B.Bn, +gz: B.Bn, +x: B.Bn, +y: B.Bn, +z: B.Bn, +x2: B.Bn, +y2: B.Bn, +z2: B.Bn, +hn: {B.beq(p, B.binc(p1)) == True{} : Bool}, +hwk: {B.beq(CB.bshl(256n, B.B1{B.BZ{}}), B.badd(p, c)) == True{} : Bool}, +h21: {M.ltk(M.b3l(), p) == True{} : Bool}, +hz: {M.ltk(B.BZ{}, p) == True{} : Bool}, +hg: {M.ok3(p, M.BP{gx, gy, gz}) == True{} : Bool}, +hr: {M.ok3(p, M.BP{x, y, z}) == True{} : Bool}, +hc: {fck(M.blmul(bs, c, p, M.BP{gx, gy, gz}, M.RP{M.BP{x, y, z}, True{}}), M.BP{x2, y2, z2}) == True{} : Bool}) -> {CS.lmul(1n+X.bvalo(one, p1), bs, spo(one, M.BP{gx, gy, gz}), spo(one, M.BP{x, y, z})) == spo(one, M.BP{x2, y2, z2}) : CS.SPoint}:
  %Equal.sym(Nat, X.bvalo(one, p1), B.bval(p1), X.bo(one, h1, p1)) : {CS.lmul(1n+_, bs, spo(one, M.BP{gx, gy, gz}), spo(one, M.BP{x, y, z})) == spo(one, M.BP{x2, y2, z2}) : CS.SPoint}
  %Equal.sym(CS.SPoint, spo(one, M.BP{gx, gy, gz}), CS.SPoint{B.bval(gx), B.bval(gy), B.bval(gz)}, spo_v(one, h1, gx, gy, gz)) : {CS.lmul(1n+B.bval(p1), bs, _, spo(one, M.BP{x, y, z})) == spo(one, M.BP{x2, y2, z2}) : CS.SPoint}
  %Equal.sym(CS.SPoint, spo(one, M.BP{x, y, z}), CS.SPoint{B.bval(x), B.bval(y), B.bval(z)}, spo_v(one, h1, x, y, z)) : {CS.lmul(1n+B.bval(p1), bs, CS.SPoint{B.bval(gx), B.bval(gy), B.bval(gz)}, _) == spo(one, M.BP{x2, y2, z2}) : CS.SPoint}
  %Equal.sym(CS.SPoint, spo(one, M.BP{x2, y2, z2}), CS.SPoint{B.bval(x2), B.bval(y2), B.bval(z2)}, spo_v(one, h1, x2, y2, z2)) : {CS.lmul(1n+B.bval(p1), bs, CS.SPoint{B.bval(gx), B.bval(gy), B.bval(gz)}, CS.SPoint{B.bval(x), B.bval(y), B.bval(z)}) == _ : CS.SPoint}
  Equal.trans(CS.SPoint, CS.lmul(1n+B.bval(p1), bs, CS.SPoint{B.bval(gx), B.bval(gy), B.bval(gz)}, CS.SPoint{B.bval(x), B.bval(y), B.bval(z)}), M.spv(M.rpp(M.blmul(bs, c, p, M.BP{gx, gy, gz}, M.RP{M.BP{x, y, z}, True{}}))), CS.SPoint{B.bval(x2), B.bval(y2), B.bval(z2)},
    M.blmul_v(bs, c, p, gx, gy, gz, x, y, z, True{}, B.bval(p1), Equal.trans(Nat, B.bval(p), B.bval(B.binc(p1)), 1n+B.bval(p1), B.beq_v(p, B.binc(p1), hn), B.binc_v(p1)), Equal.trans(Nat, B.bval(CB.bshl(256n, B.B1{B.BZ{}})), B.bval(B.badd(p, c)), Nat.add(B.bval(p), B.bval(c)), B.beq_v(CB.bshl(256n, B.B1{B.BZ{}}), B.badd(p, c), hwk), B.badd_v(p, c)), h21, hz, hg, hr, fck_ok(M.blmul(bs, c, p, M.BP{gx, gy, gz}, M.RP{M.BP{x, y, z}, True{}}), M.BP{x2, y2, z2}, hc)),
    beq3_v(M.rpp(M.blmul(bs, c, p, M.BP{gx, gy, gz}, M.RP{M.BP{x, y, z}, True{}})), M.BP{x2, y2, z2}, fck_eq(M.blmul(bs, c, p, M.BP{gx, gy, gz}, M.RP{M.BP{x, y, z}, True{}}), M.BP{x2, y2, z2}, hc)))

# ---- the literals of secp256k1 ----

# 2^256 - p = 2^32 + 977
def cl() -> B.Bn:
  B.badd(B.B1{B.B0{B.B0{B.B0{B.B1{B.B0{B.B1{B.B1{B.B1{B.B1{B.BZ{}}}}}}}}}}}, CB.bshl(32n, B.B1{B.BZ{}}))

def gxl() -> B.Bn:
  CB.bdig([B.B0{B.B0{B.B0{B.B1{B.B1{B.B0{B.B0{B.B1{B.B1{B.B1{B.B1{B.B0{B.B1{B.BZ{}}}}}}}}}}}}}}, B.B0{B.B0{B.B0{B.B1{B.B1{B.B1{B.B1{B.B1{B.B0{B.B1{B.B1{B.B0{B.B1{B.BZ{}}}}}}}}}}}}}}, B.B1{B.B1{B.B0{B.B1{B.B1{B.B0{B.B1{B.B0{B.B1{B.B0{B.B0{B.B0{B.B0{B.B0{B.B0{B.B1{B.BZ{}}}}}}}}}}}}}}}}}, B.B0{B.B1{B.B0{B.B0{B.B1{B.B1{B.B1{B.B1{B.B1{B.B0{B.B0{B.B1{B.B1{B.B0{B.B1{B.BZ{}}}}}}}}}}}}}}}}, B.B1{B.B0{B.B0{B.B1{B.B1{B.B0{B.B1{B.B1{B.B0{B.B0{B.B0{B.B1{B.B0{B.B1{B.BZ{}}}}}}}}}}}}}}}, B.B0{B.B1{B.B1{B.B1{B.B0{B.B0{B.B1{B.B1{B.B1{B.B0{B.B1{B.B1{B.B0{B.B1{B.BZ{}}}}}}}}}}}}}}}, B.B1{B.B1{B.B0{B.B1{B.B1{B.B0{B.B1{B.B1{B.B0{B.B0{B.B1{B.B1{B.B1{B.B1{B.B1{B.B1{B.BZ{}}}}}}}}}}}}}}}}}, B.B1{B.B1{B.B0{B.B1{B.B1{B.B0{B.B0{B.B1{B.B0{B.B1{B.BZ{}}}}}}}}}}}, B.B1{B.B1{B.B1{B.B0{B.B0{B.B0{B.B0{B.B0{B.B1{B.B1{B.B0{B.B1{B.BZ{}}}}}}}}}}}}}, B.B1{B.B1{B.B1{B.B0{B.B0{B.B0{B.B0{B.B1{B.B0{B.B1{B.B1{B.B1{B.B0{B.B0{B.B1{B.B1{B.BZ{}}}}}}}}}}}}}}}}}, B.B1{B.B0{B.B1{B.B0{B.B1{B.B0{B.B0{B.B1{B.B0{B.B1{B.B0{B.B0{B.B0{B.B1{B.B1{B.BZ{}}}}}}}}}}}}}}}}, B.B0{B.B0{B.B0{B.B0{B.B0{B.B1{B.B0{B.B1{B.B1{B.B0{B.B1{B.B0{B.B1{B.B0{B.B1{B.BZ{}}}}}}}}}}}}}}}}, B.B0{B.B0{B.B1{B.B1{B.B0{B.B1{B.B0{B.B1{B.B1{B.B1{B.B0{B.B1{B.B1{B.B1{B.B0{B.B1{B.BZ{}}}}}}}}}}}}}}}}}, B.B0{B.B0{B.B1{B.B1{B.B1{B.B0{B.B1{B.B1{B.B1{B.B0{B.B0{B.B1{B.B1{B.B1{B.B1{B.B1{B.BZ{}}}}}}}}}}}}}}}}}, B.B0{B.B1{B.B1{B.B1{B.B1{B.B1{B.B1{B.B0{B.B0{B.B1{B.B1{B.B0{B.B0{B.B1{B.B1{B.BZ{}}}}}}}}}}}}}}}}, B.B0{B.B1{B.B1{B.B1{B.B1{B.B1{B.B0{B.B1{B.B1{B.B0{B.B0{B.B1{B.B1{B.B1{B.B1{B.BZ{}}}}}}}}}}}}}}}}])

def gyl() -> B.Bn:
  CB.bdig([B.B0{B.B0{B.B0{B.B1{B.B1{B.B1{B.B0{B.B1{B.B0{B.B0{B.B1{B.B0{B.B1{B.B0{B.B1{B.B1{B.BZ{}}}}}}}}}}}}}}}}}, B.B0{B.B0{B.B0{B.B0{B.B1{B.B0{B.B0{B.B0{B.B1{B.B1{B.B0{B.B1{B.B1{B.B1{B.B1{B.B1{B.BZ{}}}}}}}}}}}}}}}}}, B.B1{B.B1{B.B1{B.B1{B.B0{B.B0{B.B0{B.B1{B.B0{B.B0{B.B0{B.B0{B.B1{B.B0{B.B1{B.B1{B.BZ{}}}}}}}}}}}}}}}}}, B.B1{B.B1{B.B1{B.B0{B.B0{B.B0{B.B1{B.B0{B.B0{B.B0{B.B1{B.B1{B.B1{B.B0{B.B0{B.B1{B.BZ{}}}}}}}}}}}}}}}}}, B.B1{B.B0{B.B0{B.B1{B.B1{B.B0{B.B0{B.B0{B.B0{B.B0{B.B1{B.B0{B.B1{B.B0{B.B1{B.BZ{}}}}}}}}}}}}}}}}, B.B1{B.B0{B.B1{B.B0{B.B0{B.B0{B.B0{B.B1{B.B0{B.B1{B.B1{B.B0{B.B0{B.B1{B.B0{B.B1{B.BZ{}}}}}}}}}}}}}}}}}, B.B0{B.B0{B.B0{B.B1{B.B0{B.B0{B.B1{B.B0{B.B0{B.B0{B.B1{B.B0{B.B1{B.B1{B.B0{B.B1{B.BZ{}}}}}}}}}}}}}}}}}, B.B1{B.B1{B.B1{B.B0{B.B1{B.B0{B.B0{B.B0{B.B1{B.B0{B.B1{B.B1{B.B1{B.B1{B.B1{B.B1{B.BZ{}}}}}}}}}}}}}}}}}, B.B0{B.B0{B.B0{B.B1{B.B0{B.B1{B.B0{B.B1{B.B0{B.B0{B.B0{B.B1{B.BZ{}}}}}}}}}}}}}, B.B1{B.B0{B.B0{B.B0{B.B1{B.B0{B.B0{B.B0{B.B0{B.B1{B.B1{B.B1{B.BZ{}}}}}}}}}}}}}, B.B0{B.B0{B.B1{B.B1{B.B1{B.B1{B.B1{B.B1{B.B1{B.B1{B.B0{B.B1{B.B1{B.B1{B.B1{B.B1{B.BZ{}}}}}}}}}}}}}}}}}, B.B0{B.B0{B.B1{B.B0{B.B0{B.B1{B.B0{B.B1{B.B1{B.B0{B.B1{B.B1{B.B1{B.B0{B.B1{B.BZ{}}}}}}}}}}}}}}}}, B.B1{B.B0{B.B1{B.B0{B.B0{B.B1{B.B1{B.B0{B.B0{B.B0{B.B1{B.B0{B.B0{B.B0{B.B1{B.B1{B.BZ{}}}}}}}}}}}}}}}}}, B.B1{B.B1{B.B0{B.B0{B.B0{B.B1{B.B0{B.B1{B.B0{B.B1{B.B1{B.B0{B.B0{B.B1{B.BZ{}}}}}}}}}}}}}}}, B.B1{B.B1{B.B1{B.B0{B.B1{B.B1{B.B1{B.B0{B.B0{B.B1{B.B0{B.B1{B.B1{B.B0{B.B1{B.B1{B.BZ{}}}}}}}}}}}}}}}}}, B.B0{B.B1{B.B0{B.B1{B.B1{B.B1{B.B0{B.B0{B.B0{B.B0{B.B0{B.B1{B.B0{B.B0{B.B1{B.BZ{}}}}}}}}}}}}}}}}])

def gbp() -> M.BP:
  M.BP{gxl(), gyl(), B.B1{B.BZ{}}}

def hn_p() -> {B.beq(CB.pl(), B.binc(CB.p1l())) == True{} : Bool}:
  {==}

def hw_p() -> {B.beq(CB.bshl(256n, B.B1{B.BZ{}}), B.badd(CB.pl(), cl())) == True{} : Bool}:
  {==}

def h21_p() -> {M.ltk(M.b3l(), CB.pl()) == True{} : Bool}:
  {==}

def hz_p() -> {M.ltk(B.BZ{}, CB.pl()) == True{} : Bool}:
  {==}

def hg_p() -> {M.ok3(CB.pl(), gbp()) == True{} : Bool}:
  {==}

# the literal is the specification's G
def g_is(+one: Nat, +h1: {one == 1n : Nat}) -> {spo(one, gbp()) == CS.g(one) : CS.SPoint}:
