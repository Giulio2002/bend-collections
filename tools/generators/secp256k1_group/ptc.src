# a literal point with the check vck is a point of the group
def gv(+one: Nat, +h1: {one == 1n : Nat}, +p: B.Bn, +p1: B.Bn, +c: B.Bn, +x: B.Bn, +y: B.Bn, +z: B.Bn, +y1: B.Bn, +hn: {B.beq(p, B.binc(p1)) == True{} : Bool}, +hwk: {B.beq(CB.bshl(256n, B.B1{B.BZ{}}), B.badd(p, c)) == True{} : Bool}, +hr: {M.ok3(p, M.BP{x, y, z}) == True{} : Bool}, +h7: {M.ltk(b7l(), p) == True{} : Bool}, +hc: {vck(c, p, x, y, z, y1) == True{} : Bool}) -> {GS.valid(1n+X.bvalo(one, p1), spo(one, M.BP{x, y, z})) == True{} : Bool}:
  %Equal.sym(Nat, X.bvalo(one, p1), B.bval(p1), X.bo(one, h1, p1)) : {GS.valid(1n+_, spo(one, M.BP{x, y, z})) == True{} : Bool}
  %Equal.sym(CS.SPoint, spo(one, M.BP{x, y, z}), CS.SPoint{B.bval(x), B.bval(y), B.bval(z)}, spo_v(one, h1, x, y, z)) : {GS.valid(1n+B.bval(p1), _) == True{} : Bool}
