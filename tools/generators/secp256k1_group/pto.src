# Points of finite order (modulus m = 1 + mp with the field facts of
# glaw1.bend): a double-and-add computation that ends at O gives [n] A
# equiv O (ord), and then [k] A depends only on k mod n.

# ---- the number of a bit list, with the unit kept symbolic ----

def nxo(+one: Nat, b: Nat, +v: Nat) -> Nat:
  match b:
    case 0n:
      Nat.double(v)
    case 1n+c:
      Nat.add(one, Nat.double(v))

def bvo(+one: Nat, bs: List<&2, Nat>, +v: Nat) -> Nat:
  match bs:
    case Nil{}:
      v
    case b <> t:
      bvo(one, t, nxo(one, b, v))

def nxo_v(+one: Nat, +h1: {one == 1n : Nat}, b: Nat, +v: Nat) -> {G4.nxt(b, v) == nxo(one, b, v) : Nat}:
  match b:
    case 0n:
      {==}
    case 1n+c:
      %Equal.sym(Nat, one, 1n, h1) : {1n+Nat.double(v) == Nat.add(_, Nat.double(v)) : Nat}
      {==}

def bvl_o(+one: Nat, +h1: {one == 1n : Nat}, bs: List<&2, Nat>, +v: Nat) -> {G4.bvl(bs, v) == bvo(one, bs, v) : Nat}:
  match bs:
    case Nil{}:
      {==}
    case +b <> +t:
      %Equal.sym(Nat, G4.nxt(b, v), nxo(one, b, v), nxo_v(one, h1, b, v)) : {G4.bvl(t, _) == bvo(one, t, nxo(one, b, v)) : Nat}
      bvl_o(one, h1, t, nxo(one, b, v))

# ---- a loop that ends at O ----

# the loop over bs from O reaches F equiv O, and bs is the number n: [n] G equiv O
def ord(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +bs: List<&2, Nat>, +g: CS.SPoint, +f: CS.SPoint, +n: Nat, +vg: {GS.valid(1n+mp, g) == True{} : Bool}, +hl: {CS.lmul(1n+mp, bs, g, CS.infinity()) == f : CS.SPoint}, +hv: {bvo(one, bs, 0n) == n : Nat}, +hf: {GS.equiv(1n+mp, f, CS.infinity()) == True{} : Bool}) -> {GS.equiv(1n+mp, GS.smul(1n+mp, n, g), CS.infinity()) == True{} : Bool}:
  +hn = Equal.trans(Nat, G4.bvl(bs, 0n), bvo(one, bs, 0n), n, bvl_o(one, h1, bs, 0n), hv)
  +e1 = Lg.subst(CS.SPoint, z => {GS.equiv(1n+mp, z, GS.smul(1n+mp, n, g)) == True{} : Bool}, CS.lmul(1n+mp, bs, g, CS.infinity()), f, hl, Lg.subst(Nat, z => {GS.equiv(1n+mp, CS.lmul(1n+mp, bs, g, CS.infinity()), GS.smul(1n+mp, z, g)) == True{} : Bool}, G4.bvl(bs, 0n), n, hn, G4.lmul_v(mp, hp, h3, hnc, h21, bs, g, CS.infinity(), 0n, vg, G2.v_inf(mp, h21), G2.e_refl(mp, CS.infinity()))))
  +vf = Lg.subst(CS.SPoint, z => {GS.valid(1n+mp, z) == True{} : Bool}, CS.lmul(1n+mp, bs, g, CS.infinity()), f, hl, G4.lmul_valid(mp, hp, h3, hnc, h21, bs, g, CS.infinity(), vg, G2.v_inf(mp, h21)))
  G2.e_trans(mp, hp, GS.smul(1n+mp, n, g), f, CS.infinity(), vf, G2.e_sym(mp, f, GS.smul(1n+mp, n, g), e1), hf)

# ---- scalars modulo the order ----

# [k] O equiv O
def smul_inf(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, k: Nat) -> {GS.equiv(1n+mp, GS.smul(1n+mp, k, CS.infinity()), CS.infinity()) == True{} : Bool}:
  match k:
    case 0n:
      G2.e_refl(mp, CS.infinity())
    case 1n+ +j:
      G2.e_trans(mp, hp, CS.padd(1n+mp, GS.smul(1n+mp, j, CS.infinity()), CS.infinity()), GS.smul(1n+mp, j, CS.infinity()), CS.infinity(), G4.v_smul(mp, hp, h3, hnc, h21, j, CS.infinity(), G2.v_inf(mp, h21)), G2.unit(mp, GS.smul(1n+mp, j, CS.infinity())), smul_inf(mp, hp, h3, hnc, h21, j))

# [n] A equiv O gives [q n] A equiv O
def smul_q(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +q: Nat, +n: Nat, +a: CS.SPoint, +va: {GS.valid(1n+mp, a) == True{} : Bool}, +hn: {GS.equiv(1n+mp, GS.smul(1n+mp, n, a), CS.infinity()) == True{} : Bool}) -> {GS.equiv(1n+mp, GS.smul(1n+mp, Nat.mul(q, n), a), CS.infinity()) == True{} : Bool}:
  +vn = G4.v_smul(mp, hp, h3, hnc, h21, n, a, va)
  +vi = G2.v_inf(mp, h21)
  G2.e_trans(mp, hp, GS.smul(1n+mp, Nat.mul(q, n), a), GS.smul(1n+mp, q, GS.smul(1n+mp, n, a)), CS.infinity(), G4.v_smul(mp, hp, h3, hnc, h21, q, GS.smul(1n+mp, n, a), vn), G4.smul_mul(mp, hp, h3, hnc, h21, q, n, a, va),
    G2.e_trans(mp, hp, GS.smul(1n+mp, q, GS.smul(1n+mp, n, a)), GS.smul(1n+mp, q, CS.infinity()), CS.infinity(), G4.v_smul(mp, hp, h3, hnc, h21, q, CS.infinity(), vi), G4.smul_eqv(mp, hp, h3, hnc, h21, q, GS.smul(1n+mp, n, a), CS.infinity(), vn, vi, hn), smul_inf(mp, hp, h3, hnc, h21, q)))

def smul_qr(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +q: Nat, +r: Nat, +n: Nat, +a: CS.SPoint, +va: {GS.valid(1n+mp, a) == True{} : Bool}, +hn: {GS.equiv(1n+mp, GS.smul(1n+mp, n, a), CS.infinity()) == True{} : Bool}) -> {GS.equiv(1n+mp, GS.smul(1n+mp, Nat.add(Nat.mul(q, n), r), a), GS.smul(1n+mp, r, a)) == True{} : Bool}:
  +vq = G4.v_smul(mp, hp, h3, hnc, h21, Nat.mul(q, n), a, va)
  +vr = G4.v_smul(mp, hp, h3, hnc, h21, r, a, va)
  +vi = G2.v_inf(mp, h21)
  G2.e_trans(mp, hp, GS.smul(1n+mp, Nat.add(Nat.mul(q, n), r), a), CS.padd(1n+mp, GS.smul(1n+mp, Nat.mul(q, n), a), GS.smul(1n+mp, r, a)), GS.smul(1n+mp, r, a), G1.v_add(mp, hp, h3, hnc, h21, GS.smul(1n+mp, Nat.mul(q, n), a), GS.smul(1n+mp, r, a), vq, vr), G4.smul_add(mp, hp, h3, hnc, h21, Nat.mul(q, n), r, a, va),
    G2.e_trans(mp, hp, CS.padd(1n+mp, GS.smul(1n+mp, Nat.mul(q, n), a), GS.smul(1n+mp, r, a)), CS.padd(1n+mp, CS.infinity(), GS.smul(1n+mp, r, a)), GS.smul(1n+mp, r, a), G1.v_add(mp, hp, h3, hnc, h21, CS.infinity(), GS.smul(1n+mp, r, a), vi, vr), G2.e_add_l(mp, hp, GS.smul(1n+mp, Nat.mul(q, n), a), CS.infinity(), GS.smul(1n+mp, r, a), vq, vi, smul_q(mp, hp, h3, hnc, h21, q, n, a, va, hn)), G4.unit_l(mp, GS.smul(1n+mp, r, a))))

# [k] A equiv [k mod n] A when [n] A equiv O (n = 1 + nq)
def smul_mod(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +k: Nat, +nq: Nat, +a: CS.SPoint, +va: {GS.valid(1n+mp, a) == True{} : Bool}, +hn: {GS.equiv(1n+mp, GS.smul(1n+mp, 1n+nq, a), CS.infinity()) == True{} : Bool}) -> {GS.equiv(1n+mp, GS.smul(1n+mp, k, a), GS.smul(1n+mp, Nat.mod(k, 1n+nq), a)) == True{} : Bool}:
  %Equal.sym(Nat, k, Nat.add(Nat.mul(Nat.div(k, 1n+nq), 1n+nq), Nat.mod(k, 1n+nq)), NR.dm_eq(nq, k)) : {GS.equiv(1n+mp, GS.smul(1n+mp, _, a), GS.smul(1n+mp, Nat.mod(k, 1n+nq), a)) == True{} : Bool}
  smul_qr(mp, hp, h3, hnc, h21, Nat.div(k, 1n+nq), Nat.mod(k, 1n+nq), 1n+nq, a, va, hn)

# [j] A + [k] A equiv [(j + k) mod n] A
def add_mod(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +j: Nat, +k: Nat, +nq: Nat, +a: CS.SPoint, +va: {GS.valid(1n+mp, a) == True{} : Bool}, +hn: {GS.equiv(1n+mp, GS.smul(1n+mp, 1n+nq, a), CS.infinity()) == True{} : Bool}) -> {GS.equiv(1n+mp, CS.padd(1n+mp, GS.smul(1n+mp, j, a), GS.smul(1n+mp, k, a)), GS.smul(1n+mp, Nat.mod(Nat.add(j, k), 1n+nq), a)) == True{} : Bool}:
  G2.e_trans(mp, hp, CS.padd(1n+mp, GS.smul(1n+mp, j, a), GS.smul(1n+mp, k, a)), GS.smul(1n+mp, Nat.add(j, k), a), GS.smul(1n+mp, Nat.mod(Nat.add(j, k), 1n+nq), a), G4.v_smul(mp, hp, h3, hnc, h21, Nat.add(j, k), a, va), G2.e_sym(mp, GS.smul(1n+mp, Nat.add(j, k), a), CS.padd(1n+mp, GS.smul(1n+mp, j, a), GS.smul(1n+mp, k, a)), G4.smul_add(mp, hp, h3, hnc, h21, j, k, a, va)), smul_mod(mp, hp, h3, hnc, h21, Nat.add(j, k), nq, a, va, hn))

# [j] ([k] A) equiv [(j k) mod n] A
def mul_mod(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +j: Nat, +k: Nat, +nq: Nat, +a: CS.SPoint, +va: {GS.valid(1n+mp, a) == True{} : Bool}, +hn: {GS.equiv(1n+mp, GS.smul(1n+mp, 1n+nq, a), CS.infinity()) == True{} : Bool}) -> {GS.equiv(1n+mp, GS.smul(1n+mp, j, GS.smul(1n+mp, k, a)), GS.smul(1n+mp, Nat.mod(Nat.mul(j, k), 1n+nq), a)) == True{} : Bool}:
  G2.e_trans(mp, hp, GS.smul(1n+mp, j, GS.smul(1n+mp, k, a)), GS.smul(1n+mp, Nat.mul(j, k), a), GS.smul(1n+mp, Nat.mod(Nat.mul(j, k), 1n+nq), a), G4.v_smul(mp, hp, h3, hnc, h21, Nat.mul(j, k), a, va), G2.e_sym(mp, GS.smul(1n+mp, Nat.mul(j, k), a), GS.smul(1n+mp, j, GS.smul(1n+mp, k, a)), G4.smul_mul(mp, hp, h3, hnc, h21, j, k, a, va)), smul_mod(mp, hp, h3, hnc, h21, Nat.mul(j, k), nq, a, va, hn))

# ---- the value of a loop from O ----

# the loop over bs from O reaches F, and bs is the number n: F equiv [n] G
def lval_e(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +bs: List<&2, Nat>, +g: CS.SPoint, +f: CS.SPoint, +n: Nat, +vg: {GS.valid(1n+mp, g) == True{} : Bool}, +hl: {CS.lmul(1n+mp, bs, g, CS.infinity()) == f : CS.SPoint}, +hv: {bvo(one, bs, 0n) == n : Nat}) -> {GS.equiv(1n+mp, f, GS.smul(1n+mp, n, g)) == True{} : Bool}:
  +hn = Equal.trans(Nat, G4.bvl(bs, 0n), bvo(one, bs, 0n), n, bvl_o(one, h1, bs, 0n), hv)
  Lg.subst(CS.SPoint, z => {GS.equiv(1n+mp, z, GS.smul(1n+mp, n, g)) == True{} : Bool}, CS.lmul(1n+mp, bs, g, CS.infinity()), f, hl, Lg.subst(Nat, z => {GS.equiv(1n+mp, CS.lmul(1n+mp, bs, g, CS.infinity()), GS.smul(1n+mp, z, g)) == True{} : Bool}, G4.bvl(bs, 0n), n, hn, G4.lmul_v(mp, hp, h3, hnc, h21, bs, g, CS.infinity(), 0n, vg, G2.v_inf(mp, h21), G2.e_refl(mp, CS.infinity()))))

def lval_v(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +bs: List<&2, Nat>, +g: CS.SPoint, +f: CS.SPoint, +vg: {GS.valid(1n+mp, g) == True{} : Bool}, +hl: {CS.lmul(1n+mp, bs, g, CS.infinity()) == f : CS.SPoint}) -> {GS.valid(1n+mp, f) == True{} : Bool}:
  Lg.subst(CS.SPoint, z => {GS.valid(1n+mp, z) == True{} : Bool}, CS.lmul(1n+mp, bs, g, CS.infinity()), f, hl, G4.lmul_valid(mp, hp, h3, hnc, h21, bs, g, CS.infinity(), vg, G2.v_inf(mp, h21)))

# ---- a point of prime order: [k] A is O only for k a multiple of n ----

def zc(a: CS.SPoint) -> Nat:
  match a:
    case CS.SPoint{x, y, z}:
      z

# a point with Z == 1 is not O
def inf_absurd(+mp: Nat, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, a: CS.SPoint, +hz: {zc(a) == 1n : Nat}, +h: {GS.equiv(1n+mp, a, CS.infinity()) == True{} : Bool}) -> Empty:
  match a:
    case CS.SPoint{+x, +y, +z}:
      +e1 = Lg.subst(Nat, v => {Nat.mod(Nat.mul(v, 1n), 1n+mp) == 0n : Nat}, z, 1n, hz, G1.e_z(mp, x, y, z, 0n, 1n, 0n, h))
      +e2 = NR.mod_of(0n, mp, 1n, G2.lt1(mp, h21))
      Lg.false_true(Equal.cong(Nat, Bool, v => Nat.is_eq(v, 0n), 1n, 0n, Equal.trans(Nat, 1n, Nat.mod(1n, 1n+mp), 0n, Equal.sym(Nat, Nat.mod(1n, 1n+mp), 1n, e2), e1)))

# [k] A equiv O with n prime and k not a multiple of n: A equiv [j k] A equiv [j] O equiv O
def ni_contra(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +nq: Nat, +hq: PM.Prime(1n+nq), +a: CS.SPoint, +va: {GS.valid(1n+mp, a) == True{} : Bool}, +hz: {zc(a) == 1n : Nat}, +hn: {GS.equiv(1n+mp, GS.smul(1n+mp, 1n+nq, a), CS.infinity()) == True{} : Bool}, +k: Nat, +hk: {Nat.is_eq(Nat.mod(k, 1n+nq), 0n) == False{} : Bool}, +h: {GS.equiv(1n+mp, GS.smul(1n+mp, k, a), CS.infinity()) == True{} : Bool}) -> Empty:
  +j = Nat.mod(Nat.pow(k, Nat.sub(1n+nq, 2n)), 1n+nq)
  +vi = G2.v_inf(mp, h21)
  +vk = G4.v_smul(mp, hp, h3, hnc, h21, k, a, va)
  +e1 = Equal.trans(Nat, Nat.mod(Nat.mul(j, k), 1n+nq), Nat.mod(Nat.mul(k, j), 1n+nq), 1n, Equal.cong(Nat, Nat, v => Nat.mod(v, 1n+nq), Nat.mul(j, k), Nat.mul(k, j), NA.mul_comm(j, k)), FD.inv_mod(1n+nq, hq, k, hk))
  +s1 = Lg.subst(Nat, v => {GS.equiv(1n+mp, GS.smul(1n+mp, j, GS.smul(1n+mp, k, a)), GS.smul(1n+mp, v, a)) == True{} : Bool}, Nat.mod(Nat.mul(j, k), 1n+nq), 1n, e1, mul_mod(mp, hp, h3, hnc, h21, j, k, nq, a, va, hn))
  +s2 = G2.e_trans(mp, hp, GS.smul(1n+mp, j, GS.smul(1n+mp, k, a)), CS.padd(1n+mp, CS.infinity(), a), a, G1.v_add(mp, hp, h3, hnc, h21, CS.infinity(), a, vi, va), s1, G4.unit_l(mp, a))
  +s3 = G2.e_trans(mp, hp, GS.smul(1n+mp, j, GS.smul(1n+mp, k, a)), GS.smul(1n+mp, j, CS.infinity()), CS.infinity(), G4.v_smul(mp, hp, h3, hnc, h21, j, CS.infinity(), vi), G4.smul_eqv(mp, hp, h3, hnc, h21, j, GS.smul(1n+mp, k, a), CS.infinity(), vk, vi, h), smul_inf(mp, hp, h3, hnc, h21, j))
  inf_absurd(mp, h21, a, hz, G2.e_trans(mp, hp, a, GS.smul(1n+mp, j, GS.smul(1n+mp, k, a)), CS.infinity(), G4.v_smul(mp, hp, h3, hnc, h21, j, GS.smul(1n+mp, k, a), vk), G2.e_sym(mp, GS.smul(1n+mp, j, GS.smul(1n+mp, k, a)), a, s2), s3))

def ni_c(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +nq: Nat, +hq: PM.Prime(1n+nq), +a: CS.SPoint, +va: {GS.valid(1n+mp, a) == True{} : Bool}, +hz: {zc(a) == 1n : Nat}, +hn: {GS.equiv(1n+mp, GS.smul(1n+mp, 1n+nq, a), CS.infinity()) == True{} : Bool}, +k: Nat, +hk: {Nat.is_eq(Nat.mod(k, 1n+nq), 0n) == False{} : Bool}, c: Bool, +hc: {GS.equiv(1n+mp, GS.smul(1n+mp, k, a), CS.infinity()) == c : Bool}) -> {GS.equiv(1n+mp, GS.smul(1n+mp, k, a), CS.infinity()) == False{} : Bool}:
  match c:
    case False{}:
      hc
    case True{}:
      Empty.absurd({GS.equiv(1n+mp, GS.smul(1n+mp, k, a), CS.infinity()) == False{} : Bool}, ni_contra(mp, hp, h3, hnc, h21, nq, hq, a, va, hz, hn, k, hk, hc))

# for n = 1 + nq prime, [n] A equiv O, Z(A) == 1 and k not a multiple of n: [k] A is not O
def not_inf(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +nq: Nat, +hq: PM.Prime(1n+nq), +a: CS.SPoint, +va: {GS.valid(1n+mp, a) == True{} : Bool}, +hz: {zc(a) == 1n : Nat}, +hn: {GS.equiv(1n+mp, GS.smul(1n+mp, 1n+nq, a), CS.infinity()) == True{} : Bool}, +k: Nat, +hk: {Nat.is_eq(Nat.mod(k, 1n+nq), 0n) == False{} : Bool}) -> {GS.equiv(1n+mp, GS.smul(1n+mp, k, a), CS.infinity()) == False{} : Bool}:
  ni_c(mp, hp, h3, hnc, h21, nq, hq, a, va, hz, hn, k, hk, GS.equiv(1n+mp, GS.smul(1n+mp, k, a), CS.infinity()), {==})

def pos_ne(k: Nat, +h: {Nat.is_lt(0n, k) == True{} : Bool}) -> {Nat.is_eq(k, 0n) == False{} : Bool}:
  match k:
    case 0n:
      Empty.absurd({Nat.is_eq(0n, 0n) == False{} : Bool}, Lg.false_true(h))
    case 1n+j:
      {==}

# 0 < k < n: k is not a multiple of n
def nz_k(+nq: Nat, +k: Nat, +h0: {Nat.is_lt(0n, k) == True{} : Bool}, +hl: {Nat.is_lt(k, 1n+nq) == True{} : Bool}) -> {Nat.is_eq(Nat.mod(k, 1n+nq), 0n) == False{} : Bool}:
  Lg.subst(Nat, v => {Nat.is_eq(v, 0n) == False{} : Bool}, k, Nat.mod(k, 1n+nq), Equal.sym(Nat, Nat.mod(k, 1n+nq), k, NR.mod_of(0n, nq, k, hl)), pos_ne(k, h0))
