# a 2^k
def bshl(k: Nat, a: B.Bn) -> B.Bn:
  match k:
    case 0n:
      a
    case 1n+j:
      B.B0{bshl(j, a)}

def shl_o(+one: Nat, k: Nat, +a: B.Bn) -> {X.bvalo(one, bshl(k, a)) == C.shift(k, X.bvalo(one, a)) : Nat}:
  match k:
    case 0n:
      {==}
    case 1n+ +j:
      Equal.cong(Nat, Nat, z => Nat.double(z), X.bvalo(one, bshl(j, a)), C.shift(j, X.bvalo(one, a)), shl_o(one, j, a))

def b1_o(+one: Nat) -> {X.bvalo(one, B.B1{B.BZ{}}) == one : Nat}:
  NA.add_zero(one)

def v977() -> {B.bval(B.B1{B.B0{B.B0{B.B0{B.B1{B.B0{B.B1{B.B1{B.B1{B.B1{B.BZ{}}}}}}}}}}}) == 977n : Nat}:
  {==}

def l977(+one: Nat, +h1: {one == 1n : Nat}) -> {X.bvalo(one, B.B1{B.B0{B.B0{B.B0{B.B1{B.B0{B.B1{B.B1{B.B1{B.B1{B.BZ{}}}}}}}}}}}) == Nat.mul(one, 977n) : Nat}:
  %rw X.lit_o(one, h1, B.B1{B.B0{B.B0{B.B0{B.B1{B.B0{B.B1{B.B1{B.B1{B.B1{B.BZ{}}}}}}}}}}}, 977n, v977())
  %rwh h1 : {one == 1n : Nat}
  %close

def v3() -> {B.bval(B.B1{B.B1{B.BZ{}}}) == 3n : Nat}:
  {==}

def v7() -> {B.bval(B.B1{B.B1{B.B1{B.BZ{}}}}) == 7n : Nat}:
  {==}

def v21() -> {B.bval(B.B1{B.B0{B.B1{B.B0{B.B1{B.BZ{}}}}}}) == 21n : Nat}:
  {==}

# 2^32 + 977
def cp_is(+one: Nat, +h1: {one == 1n : Nat}) -> {X.bvalo(one, B.badd(B.B1{B.B0{B.B0{B.B0{B.B1{B.B0{B.B1{B.B1{B.B1{B.B1{B.BZ{}}}}}}}}}}}, bshl(32n, B.B1{B.BZ{}}))) == FS.cp(one) : Nat}:
  %goal {X.bvalo(one, B.badd(B.B1{B.B0{B.B0{B.B0{B.B1{B.B0{B.B1{B.B1{B.B1{B.B1{B.BZ{}}}}}}}}}}}, bshl(32n, B.B1{B.BZ{}}))) == Nat.add(Nat.mul(one, 977n), C.shift(16n, Nat.add(Nat.mul(one, 0n), C.shift(16n, Nat.add(Nat.mul(one, 1n), C.shift(16n, 0n)))))) : Nat}
  %rw X.add_o(one, h1, B.B1{B.B0{B.B0{B.B0{B.B1{B.B0{B.B1{B.B1{B.B1{B.B1{B.BZ{}}}}}}}}}}}, bshl(32n, B.B1{B.BZ{}}))
  %rw shl_o(one, 32n, B.B1{B.BZ{}})
  %rw b1_o(one)
  %rw l977(one, h1)
  %rw NA.mul_zero(one)
  %rw NA.mul_one(one)
  %rw WW.shift_zero(16n)
  %rw NA.add_zero(one)
  %rw SR.zero_add(C.shift(16n, one))
  %rw SR.shift_shift(16n, 16n, one)
  %close

def p_sum(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.add(X.bvalo(one, pl()), X.bvalo(one, B.badd(B.B1{B.B0{B.B0{B.B0{B.B1{B.B0{B.B1{B.B1{B.B1{B.B1{B.BZ{}}}}}}}}}}}, bshl(32n, B.B1{B.BZ{}})))) == C.shift(256n, one) : Nat}:
  Equal.trans(Nat, Nat.add(X.bvalo(one, pl()), X.bvalo(one, B.badd(B.B1{B.B0{B.B0{B.B0{B.B1{B.B0{B.B1{B.B1{B.B1{B.B1{B.BZ{}}}}}}}}}}}, bshl(32n, B.B1{B.BZ{}})))), X.bvalo(one, B.badd(pl(), B.badd(B.B1{B.B0{B.B0{B.B0{B.B1{B.B0{B.B1{B.B1{B.B1{B.B1{B.BZ{}}}}}}}}}}}, bshl(32n, B.B1{B.BZ{}})))), C.shift(256n, one),
    Equal.sym(Nat, X.bvalo(one, B.badd(pl(), B.badd(B.B1{B.B0{B.B0{B.B0{B.B1{B.B0{B.B1{B.B1{B.B1{B.B1{B.BZ{}}}}}}}}}}}, bshl(32n, B.B1{B.BZ{}})))), Nat.add(X.bvalo(one, pl()), X.bvalo(one, B.badd(B.B1{B.B0{B.B0{B.B0{B.B1{B.B0{B.B1{B.B1{B.B1{B.B1{B.BZ{}}}}}}}}}}}, bshl(32n, B.B1{B.BZ{}})))), X.add_o(one, h1, pl(), B.badd(B.B1{B.B0{B.B0{B.B0{B.B1{B.B0{B.B1{B.B1{B.B1{B.B1{B.BZ{}}}}}}}}}}}, bshl(32n, B.B1{B.BZ{}})))),
    Equal.trans(Nat, X.bvalo(one, B.badd(pl(), B.badd(B.B1{B.B0{B.B0{B.B0{B.B1{B.B0{B.B1{B.B1{B.B1{B.B1{B.BZ{}}}}}}}}}}}, bshl(32n, B.B1{B.BZ{}})))), X.bvalo(one, bshl(256n, B.B1{B.BZ{}})), C.shift(256n, one),
      X.eq_o(one, h1, B.badd(pl(), B.badd(B.B1{B.B0{B.B0{B.B0{B.B1{B.B0{B.B1{B.B1{B.B1{B.B1{B.BZ{}}}}}}}}}}}, bshl(32n, B.B1{B.BZ{}}))), bshl(256n, B.B1{B.BZ{}}), {==}),
      Equal.trans(Nat, X.bvalo(one, bshl(256n, B.B1{B.BZ{}})), C.shift(256n, X.bvalo(one, B.B1{B.BZ{}})), C.shift(256n, one), shl_o(one, 256n, B.B1{B.BZ{}}), Equal.cong(Nat, Nat, z => C.shift(256n, z), X.bvalo(one, B.B1{B.BZ{}}), one, b1_o(one)))))

# the literal is the specification's p
def p_is(+one: Nat, +h1: {one == 1n : Nat}) -> {X.bvalo(one, pl()) == FS.prime(one) : Nat}:
  %goal {X.bvalo(one, pl()) == Nat.sub(C.shift(256n, one), FS.cp(one)) : Nat}
  %rw <- cp_is(one, h1)
  %rwh Equal.sym(Nat, Nat.add(X.bvalo(one, pl()), X.bvalo(one, B.badd(B.B1{B.B0{B.B0{B.B0{B.B1{B.B0{B.B1{B.B1{B.B1{B.B1{B.BZ{}}}}}}}}}}}, bshl(32n, B.B1{B.BZ{}})))), C.shift(256n, one), p_sum(one, h1)) : {C.shift(256n, one) == Nat.add(X.bvalo(one, pl()), X.bvalo(one, B.badd(B.B1{B.B0{B.B0{B.B0{B.B1{B.B0{B.B1{B.B1{B.B1{B.B1{B.BZ{}}}}}}}}}}}, bshl(32n, B.B1{B.BZ{}})))) : Nat}
  %rw NA.add_comm(X.bvalo(one, pl()), X.bvalo(one, B.badd(B.B1{B.B0{B.B0{B.B0{B.B1{B.B0{B.B1{B.B1{B.B1{B.B1{B.BZ{}}}}}}}}}}}, bshl(32n, B.B1{B.BZ{}}))))
  Equal.sym(Nat, Nat.sub(Nat.add(X.bvalo(one, B.badd(B.B1{B.B0{B.B0{B.B0{B.B1{B.B0{B.B1{B.B1{B.B1{B.B1{B.BZ{}}}}}}}}}}}, bshl(32n, B.B1{B.BZ{}}))), X.bvalo(one, pl())), X.bvalo(one, B.badd(B.B1{B.B0{B.B0{B.B0{B.B1{B.B0{B.B1{B.B1{B.B1{B.B1{B.BZ{}}}}}}}}}}}, bshl(32n, B.B1{B.BZ{}})))), X.bvalo(one, pl()), N.add_sub_cancel(X.bvalo(one, B.badd(B.B1{B.B0{B.B0{B.B0{B.B1{B.B0{B.B1{B.B1{B.B1{B.B1{B.BZ{}}}}}}}}}}}, bshl(32n, B.B1{B.BZ{}}))), X.bvalo(one, pl())))

# p == 1 + (p - 1)
def p_suc(+one: Nat, +h1: {one == 1n : Nat}) -> {FS.prime(one) == 1n+X.bvalo(one, p1l()) : Nat}:
  %rw <- p_is(one, h1)
  X.suc_o(one, h1, pl(), p1l(), {==})

# p - 1 == 3 e
def p_e3(+one: Nat, +h1: {one == 1n : Nat}) -> {X.bvalo(one, p1l()) == Nat.mul(X.bvalo(one, e3l()), 3n) : Nat}:
  Equal.trans(Nat, X.bvalo(one, p1l()), X.bvalo(one, B.bmul(e3l(), B.B1{B.B1{B.BZ{}}})), Nat.mul(X.bvalo(one, e3l()), 3n), X.eq_o(one, h1, p1l(), B.bmul(e3l(), B.B1{B.B1{B.BZ{}}}), {==}),
    Equal.trans(Nat, X.bvalo(one, B.bmul(e3l(), B.B1{B.B1{B.BZ{}}})), Nat.mul(X.bvalo(one, e3l()), X.bvalo(one, B.B1{B.B1{B.BZ{}}})), Nat.mul(X.bvalo(one, e3l()), 3n), X.mul_o(one, h1, e3l(), B.B1{B.B1{B.BZ{}}}),
      Equal.cong(Nat, Nat, z => Nat.mul(X.bvalo(one, e3l()), z), X.bvalo(one, B.B1{B.B1{B.BZ{}}}), 3n, X.lit_o(one, h1, B.B1{B.B1{B.BZ{}}}, 3n, v3()))))

def p_mod3(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.mod(X.bvalo(one, p1l()), 3n) == 0n : Nat}:
  %rw p_e3(one, h1)
  PM.mod_mul0(2n, X.bvalo(one, e3l()))

def p_div3(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.div(X.bvalo(one, p1l()), 3n) == X.bvalo(one, e3l()) : Nat}:
  Equal.trans(Nat, Nat.div(X.bvalo(one, p1l()), 3n), Nat.div(Nat.add(Nat.mul(X.bvalo(one, e3l()), 3n), 0n), 3n), X.bvalo(one, e3l()),
    Equal.cong(Nat, Nat, z => Nat.div(z, 3n), X.bvalo(one, p1l()), Nat.add(Nat.mul(X.bvalo(one, e3l()), 3n), 0n), Equal.trans(Nat, X.bvalo(one, p1l()), Nat.mul(X.bvalo(one, e3l()), 3n), Nat.add(Nat.mul(X.bvalo(one, e3l()), 3n), 0n), p_e3(one, h1), Equal.sym(Nat, Nat.add(Nat.mul(X.bvalo(one, e3l()), 3n), 0n), Nat.mul(X.bvalo(one, e3l()), 3n), NA.add_zero(Nat.mul(X.bvalo(one, e3l()), 3n))))),
    NR.div_of(X.bvalo(one, e3l()), 2n, 0n, {==}))

def p7_eq() -> {B.beq(pl(), B.badd(B.B1{B.B1{B.B1{B.BZ{}}}}, p7l())) == True{} : Bool}:
  {==}

# p - 7
def p_m7(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.sub(FS.prime(one), 7n) == X.bvalo(one, p7l()) : Nat}:
  %rw <- p_is(one, h1)
  %rw X.eq_o(one, h1, pl(), B.badd(B.B1{B.B1{B.B1{B.BZ{}}}}, p7l()), p7_eq())
  %rw X.add_o(one, h1, B.B1{B.B1{B.B1{B.BZ{}}}}, p7l())
  %rw X.lit_o(one, h1, B.B1{B.B1{B.B1{B.BZ{}}}}, 7n, v7())
  N.add_sub_cancel(7n, X.bvalo(one, p7l()))

