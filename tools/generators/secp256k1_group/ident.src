# Identities by reflection: residues a and b with polynomials sa and sb
# (Z.Rel) are equal modulo m when the polynomial sa - sb, reduced by the
# hypotheses x_i^3 == f_i, computes to the empty list.

def mon_unit(n: Nat, i: Nat, +k: Nat, +env: List<&2, Nat>, +hi: {Nat.is_lt(i, n) == True{} : Bool}) -> {E.mon(P.unit(n, i, k), env) == Nat.pow(E.venv(i, env), k) : Nat}:
  match n i:
    case 0n +i2:
      Empty.absurd({E.mon(P.unit(0n, i2, k), env) == Nat.pow(E.venv(i2, env), k) : Nat}, N.lt_zero_absurd(i2, hi))
    case 1n+ +m 0n:
      %goal {Nat.mul(Nat.pow(E.hd(env), k), E.mon(P.unit(m, 0n, 0n), E.tl(env))) == Nat.pow(E.hd(env), k) : Nat}
      %rw R.mon_zero(m, E.tl(env))
      NA.mul_one(Nat.pow(E.hd(env), k))
    case 1n+ +m 1n+ +j:
      %goal {Nat.mul(1n, E.mon(P.unit(m, j, k), E.tl(env))) == Nat.pow(E.venv(j, E.tl(env)), k) : Nat}
      %rw mon_unit(m, j, k, E.tl(env), hi)
      SR.one_mul(Nat.pow(E.venv(j, E.tl(env)), k))

def vp_s(+v: Nat) -> {Nat.add(v, 0n) == Nat.add(Nat.mul(1n, Nat.mul(v, 1n)), 0n) : Nat}:
  %norm

# variable i has the value of the polynomial x_i
def var_rel(+mp: Nat, +n: Nat, +i: Nat, +env: List<&2, Nat>, +hi: {Nat.is_lt(i, n) == True{} : Bool}) -> Z.Rel(mp, E.venv(i, env), E.eP(P.pvar(n, i), env), E.eN(P.pvar(n, i), env)):
  %goal {Nat.mod(Nat.add(E.venv(i, env), 0n), 1n+mp) == Nat.mod(Nat.add(Nat.mul(1n, E.mon(P.unit(n, i, 1n), env)), 0n), 1n+mp) : Nat}
  %rw mon_unit(n, i, 1n, env, hi)
  Equal.cong(Nat, Nat, z => Nat.mod(z, 1n+mp), Nat.add(E.venv(i, env), 0n), Nat.add(Nat.mul(1n, Nat.mul(E.venv(i, env), 1n)), 0n), vp_s(E.venv(i, env)))

# r == r2 (mod m) and r2 == P - N give r == P - N
def rel_of(+mp: Nat, +r: Nat, +r2: Nat, +p: Nat, +n: Nat, +h: {Nat.mod(r, 1n+mp) == Nat.mod(r2, 1n+mp) : Nat}, +hr: Z.Rel(mp, r2, p, n)) -> Z.Rel(mp, r, p, n):
  Equal.trans(Nat, Nat.mod(Nat.add(r, n), 1n+mp), Nat.mod(Nat.add(r2, n), 1n+mp), Nat.mod(p, 1n+mp), Z.cg_add_l(mp, r, r2, n, h), hr)

def pw_s(+x: Nat) -> {Nat.mul(x, Nat.mul(x, Nat.mul(x, 1n))) == Nat.mul(Nat.mul(x, x), x) : Nat}:
  %norm

def pw3(+mp: Nat, +x: Nat) -> {Nat.mod(Nat.pow(x, 3n), 1n+mp) == FS.mmul(1n+mp, FS.mmul(1n+mp, x, x), x) : Nat}:
  %goal {Nat.mod(Nat.mul(x, Nat.mul(x, Nat.mul(x, 1n))), 1n+mp) == Nat.mod(Nat.mul(Nat.mod(Nat.mul(x, x), 1n+mp), x), 1n+mp) : Nat}
  %rw NR.mod_mul_l(mp, Nat.mul(x, x), x)
  %rw pw_s(x)
  %close

def pnull_nil(a: List<&2, P.Tm>, +h: {P.pnull(a) == True{} : Bool}) -> {a == Nil{} : List<&2, P.Tm>}:
  match a:
    case Nil{}:
      {==}
    case x <> xs:
      Empty.absurd({x <> xs == Nil{} : List<&2, P.Tm>}, Lg.false_true(h))

# the polynomial computes to [] : its value is 0 - 0
def sm_nil(+mp: Nat, +a: List<&2, P.Tm>, +env: List<&2, Nat>, +h: {P.pnull(a) == True{} : Bool}) -> Z.SameM(mp, 0n, 0n, E.eP(a, env), E.eN(a, env)):
  %goal {Nat.mod(Nat.add(0n, E.eN(a, env)), 1n+mp) == Nat.mod(Nat.add(E.eP(a, env), 0n), 1n+mp) : Nat}
  %rwh pnull_nil(a, h) : {a == Nil{} : List<&2, P.Tm>}
  %rwh pnull_nil(a, h) : {a == Nil{} : List<&2, P.Tm>}
  %close

# one reduction step back
def sm_red(+mp: Nat, +n: Nat, +i: Nat, +f: List<&2, P.Tm>, +a: List<&2, P.Tm>, +env: List<&2, Nat>, +hi: {Nat.is_lt(i, n) == True{} : Bool}, +h: Z.Rel(mp, Nat.pow(E.venv(i, env), 3n), E.eP(f, env), E.eN(f, env)), +hz: Z.SameM(mp, 0n, 0n, E.eP(P.red(n, i, f, a), env), E.eN(P.red(n, i, f, a), env))) -> Z.SameM(mp, 0n, 0n, E.eP(a, env), E.eN(a, env)):
  Z.sameM_trans(mp, 0n, 0n, E.eP(P.red(n, i, f, a), env), E.eN(P.red(n, i, f, a), env), E.eP(a, env), E.eN(a, env), hz, R.red_v(mp, n, i, f, a, env, hi, h))

# a and b are equal modulo m when sa - sb is zero
def ident(+mp: Nat, +a: Nat, +b: Nat, +sa: List<&2, P.Tm>, +sb: List<&2, P.Tm>, +env: List<&2, Nat>, +ha: Z.Rel(mp, a, E.eP(sa, env), E.eN(sa, env)), +hb: Z.Rel(mp, b, E.eP(sb, env), E.eN(sb, env)), +hz: Z.SameM(mp, 0n, 0n, E.eP(P.psub(sa, sb), env), E.eN(P.psub(sa, sb), env))) -> {Nat.mod(a, 1n+mp) == Nat.mod(b, 1n+mp) : Nat}:
  +d = P.psub(sa, sb)
  +hr = Z.rel_same(mp, FS.msub(1n+mp, a, b), Nat.add(E.eP(sa, env), E.eN(sb, env)), Nat.add(E.eN(sa, env), E.eP(sb, env)), E.eP(d, env), E.eN(d, env),
    Equal.sym(Nat, Nat.add(E.eP(d, env), Nat.add(E.eN(sa, env), E.eP(sb, env))), Nat.add(Nat.add(E.eP(sa, env), E.eN(sb, env)), E.eN(d, env)), E.psub_v(sa, sb, env)),
    Z.rel_sub(mp, a, E.eP(sa, env), E.eN(sa, env), b, E.eP(sb, env), E.eN(sb, env), ha, hb))
  +h0 = Z.zero_rel(mp, FS.msub(1n+mp, a, b), E.eP(d, env), E.eN(d, env), hr, Equal.sym(Nat, Nat.mod(Nat.add(0n, E.eN(d, env)), 1n+mp), Nat.mod(Nat.add(E.eP(d, env), 0n), 1n+mp), hz))
  Z.msub_zero(mp, a, b, Equal.trans(Nat, FS.msub(1n+mp, a, b), Nat.mod(FS.msub(1n+mp, a, b), 1n+mp), 0n, Equal.sym(Nat, Nat.mod(FS.msub(1n+mp, a, b), 1n+mp), FS.msub(1n+mp, a, b), NR.mod_mod(mp, Nat.sub(Nat.add(a, 1n+mp), Nat.mod(b, 1n+mp)))), h0))

def exec_red(+mp: Nat, op: CS.SOp, +r: List<&2, Nat>) -> {Nat.mod(CS.exec(1n+mp, op, r), 1n+mp) == CS.exec(1n+mp, op, r) : Nat}:
  match op:
    case CS.SAdd{i, j}:
      NR.mod_mod(mp, Nat.add(CS.nth(i, r), CS.nth(j, r)))
    case CS.SSub{i, j}:
      NR.mod_mod(mp, Nat.sub(Nat.add(CS.nth(i, r), 1n+mp), Nat.mod(CS.nth(j, r), 1n+mp)))
    case CS.SMul{i, j}:
      NR.mod_mod(mp, Nat.mul(CS.nth(i, r), CS.nth(j, r)))
