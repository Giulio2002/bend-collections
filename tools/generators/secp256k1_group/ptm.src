def add_ok(+c: B.Bn, +p: B.Bn, +x1: B.Bn, +y1: B.Bn, +z1: B.Bn, +x2: B.Bn, +y2: B.Bn, +z2: B.Bn, +h21: {ltk(b3l(), p) == True{} : Bool}, +hz: {ltk(B.BZ{}, p) == True{} : Bool}, +ha: {ok3(p, BP{x1, y1, z1}) == True{} : Bool}, +hb: {ok3(p, BP{x2, y2, z2}) == True{} : Bool}, +h: {rrk(brun(CS.add_prog(), c, p, RR{[x1, y1, z1, x2, y2, z2, b3l()], True{}})) == True{} : Bool}) -> {ok3(p, BP{bnth(33n, rrr(brun(CS.add_prog(), c, p, RR{[x1, y1, z1, x2, y2, z2, b3l()], True{}}))), bnth(36n, rrr(brun(CS.add_prog(), c, p, RR{[x1, y1, z1, x2, y2, z2, b3l()], True{}}))), bnth(39n, rrr(brun(CS.add_prog(), c, p, RR{[x1, y1, z1, x2, y2, z2, b3l()], True{}})))}) == True{} : Bool}:
  +ha2 = brun_all(CS.add_prog(), c, p, [x1, y1, z1, x2, y2, z2, b3l()], True{}, add_all(p, x1, y1, z1, x2, y2, z2, h21, ha, hb), h)
  Lg.and_intro(ltk(bnth(33n, rrr(brun(CS.add_prog(), c, p, RR{[x1, y1, z1, x2, y2, z2, b3l()], True{}}))), p), Bool.and(ltk(bnth(36n, rrr(brun(CS.add_prog(), c, p, RR{[x1, y1, z1, x2, y2, z2, b3l()], True{}}))), p), ltk(bnth(39n, rrr(brun(CS.add_prog(), c, p, RR{[x1, y1, z1, x2, y2, z2, b3l()], True{}}))), p)), all_ltk(p, 33n, rrr(brun(CS.add_prog(), c, p, RR{[x1, y1, z1, x2, y2, z2, b3l()], True{}})), hz, ha2), Lg.and_intro(ltk(bnth(36n, rrr(brun(CS.add_prog(), c, p, RR{[x1, y1, z1, x2, y2, z2, b3l()], True{}}))), p), ltk(bnth(39n, rrr(brun(CS.add_prog(), c, p, RR{[x1, y1, z1, x2, y2, z2, b3l()], True{}}))), p), all_ltk(p, 36n, rrr(brun(CS.add_prog(), c, p, RR{[x1, y1, z1, x2, y2, z2, b3l()], True{}})), hz, ha2), all_ltk(p, 39n, rrr(brun(CS.add_prog(), c, p, RR{[x1, y1, z1, x2, y2, z2, b3l()], True{}})), hz, ha2)))

def dbl_all(+p: B.Bn, +x: B.Bn, +y: B.Bn, +z: B.Bn, +h21: {ltk(b3l(), p) == True{} : Bool}, +ha: {ok3(p, BP{x, y, z}) == True{} : Bool}) -> {allok(p, [x, y, z, b3l()]) == True{} : Bool}:
  Lg.and_intro(ltk(x, p), allok(p, [y, z, b3l()]), Lg.and_left(ltk(x, p), Bool.and(ltk(y, p), ltk(z, p)), ha), Lg.and_intro(ltk(y, p), allok(p, [z, b3l()]), Lg.and_left(ltk(y, p), ltk(z, p), Lg.and_right(ltk(x, p), Bool.and(ltk(y, p), ltk(z, p)), ha)), Lg.and_intro(ltk(z, p), allok(p, [b3l()]), Lg.and_right(ltk(y, p), ltk(z, p), Lg.and_right(ltk(x, p), Bool.and(ltk(y, p), ltk(z, p)), ha)), Lg.and_intro(ltk(b3l(), p), True{}, h21, {==}))))

# the dbl program on binary registers is the specification's
def dbl_v(+c: B.Bn, +p: B.Bn, +mp: Nat, +x: B.Bn, +y: B.Bn, +z: B.Bn, +hm: {B.bval(p) == 1n+mp : Nat}, +hw: {B.bval(CB.bshl(256n, B.B1{B.BZ{}})) == Nat.add(B.bval(p), B.bval(c)) : Nat}, +h21: {ltk(b3l(), p) == True{} : Bool}, +ha: {ok3(p, BP{x, y, z}) == True{} : Bool}, +h: {rrk(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}})) == True{} : Bool}) -> {CS.pdbl(1n+mp, CS.SPoint{B.bval(x), B.bval(y), B.bval(z)}) == CS.SPoint{B.bval(bnth(21n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}})))), B.bval(bnth(18n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}})))), B.bval(bnth(13n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))))} : CS.SPoint}:
  %goal {CS.SPoint{CS.nth(21n, CS.run(1n+mp, CS.dbl_prog(), [B.bval(x), B.bval(y), B.bval(z), 21n])), CS.nth(18n, CS.run(1n+mp, CS.dbl_prog(), [B.bval(x), B.bval(y), B.bval(z), 21n])), CS.nth(13n, CS.run(1n+mp, CS.dbl_prog(), [B.bval(x), B.bval(y), B.bval(z), 21n]))} == CS.SPoint{B.bval(bnth(21n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}})))), B.bval(bnth(18n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}})))), B.bval(bnth(13n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))))} : CS.SPoint}
  %rw S.run_is(1n+mp, CS.dbl_prog(), [B.bval(x), B.bval(y), B.bval(z), 21n])
  %rw S.run_is(1n+mp, CS.dbl_prog(), [B.bval(x), B.bval(y), B.bval(z), 21n])
  %rw S.run_is(1n+mp, CS.dbl_prog(), [B.bval(x), B.bval(y), B.bval(z), 21n])
  %Equal.sym(List<&2, Nat>, CS.run_go(1n+mp, CS.dbl_prog(), vals([x, y, z, b3l()])), vals(rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))), brun_v(CS.dbl_prog(), c, p, mp, [x, y, z, b3l()], True{}, hm, hw, dbl_all(p, x, y, z, h21, ha), h)) : {CS.SPoint{CS.nth(21n, _), CS.nth(18n, CS.run_go(1n+mp, CS.dbl_prog(), vals([x, y, z, b3l()]))), CS.nth(13n, CS.run_go(1n+mp, CS.dbl_prog(), vals([x, y, z, b3l()])))} == CS.SPoint{B.bval(bnth(21n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}})))), B.bval(bnth(18n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}})))), B.bval(bnth(13n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))))} : CS.SPoint}
  %Equal.sym(List<&2, Nat>, CS.run_go(1n+mp, CS.dbl_prog(), vals([x, y, z, b3l()])), vals(rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))), brun_v(CS.dbl_prog(), c, p, mp, [x, y, z, b3l()], True{}, hm, hw, dbl_all(p, x, y, z, h21, ha), h)) : {CS.SPoint{CS.nth(21n, vals(rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}})))), CS.nth(18n, _), CS.nth(13n, CS.run_go(1n+mp, CS.dbl_prog(), vals([x, y, z, b3l()])))} == CS.SPoint{B.bval(bnth(21n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}})))), B.bval(bnth(18n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}})))), B.bval(bnth(13n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))))} : CS.SPoint}
  %Equal.sym(List<&2, Nat>, CS.run_go(1n+mp, CS.dbl_prog(), vals([x, y, z, b3l()])), vals(rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))), brun_v(CS.dbl_prog(), c, p, mp, [x, y, z, b3l()], True{}, hm, hw, dbl_all(p, x, y, z, h21, ha), h)) : {CS.SPoint{CS.nth(21n, vals(rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}})))), CS.nth(18n, vals(rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}})))), CS.nth(13n, _)} == CS.SPoint{B.bval(bnth(21n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}})))), B.bval(bnth(18n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}})))), B.bval(bnth(13n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))))} : CS.SPoint}
  %goal {CS.SPoint{CS.nth(21n, vals(rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}})))), CS.nth(18n, vals(rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}})))), CS.nth(13n, vals(rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))))} == CS.SPoint{B.bval(bnth(21n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}})))), B.bval(bnth(18n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}})))), B.bval(bnth(13n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))))} : CS.SPoint}
  %rw nth_vals(21n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}})))
  %rw nth_vals(18n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}})))
  %rw nth_vals(13n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}})))
  %close

def dbl_ok(+c: B.Bn, +p: B.Bn, +x: B.Bn, +y: B.Bn, +z: B.Bn, +h21: {ltk(b3l(), p) == True{} : Bool}, +hz: {ltk(B.BZ{}, p) == True{} : Bool}, +ha: {ok3(p, BP{x, y, z}) == True{} : Bool}, +h: {rrk(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}})) == True{} : Bool}) -> {ok3(p, BP{bnth(21n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))), bnth(18n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))), bnth(13n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}})))}) == True{} : Bool}:
  +ha2 = brun_all(CS.dbl_prog(), c, p, [x, y, z, b3l()], True{}, dbl_all(p, x, y, z, h21, ha), h)
  Lg.and_intro(ltk(bnth(21n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))), p), Bool.and(ltk(bnth(18n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))), p), ltk(bnth(13n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))), p)), all_ltk(p, 21n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}})), hz, ha2), Lg.and_intro(ltk(bnth(18n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))), p), ltk(bnth(13n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))), p), all_ltk(p, 18n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}})), hz, ha2), all_ltk(p, 13n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}})), hz, ha2)))

# ---- the loop ----

def blmul_ok(bs: List<&2, Nat>, +c: B.Bn, +p: B.Bn, +gx: B.Bn, +gy: B.Bn, +gz: B.Bn, +x: B.Bn, +y: B.Bn, +z: B.Bn, +ok: Bool, +h: {rpk(blmul(bs, c, p, BP{gx, gy, gz}, RP{BP{x, y, z}, ok})) == True{} : Bool}) -> {ok == True{} : Bool}:
  match bs:
    case Nil{}:
      h
    case 0n <> +t:
      Lg.and_left(ok, rrk(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}})), blmul_ok(t, c, p, gx, gy, gz, bnth(21n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))), bnth(18n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))), bnth(13n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))), Bool.and(ok, rrk(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))), h))
    case (1n+k) <> +t:
      Lg.and_left(ok, Bool.and(rrk(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}})), rrk(brun(CS.add_prog(), c, p, RR{[bnth(21n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))), bnth(18n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))), bnth(13n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))), gx, gy, gz, b3l()], True{}}))), blmul_ok(t, c, p, gx, gy, gz, bnth(33n, rrr(brun(CS.add_prog(), c, p, RR{[bnth(21n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))), bnth(18n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))), bnth(13n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))), gx, gy, gz, b3l()], True{}}))), bnth(36n, rrr(brun(CS.add_prog(), c, p, RR{[bnth(21n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))), bnth(18n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))), bnth(13n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))), gx, gy, gz, b3l()], True{}}))), bnth(39n, rrr(brun(CS.add_prog(), c, p, RR{[bnth(21n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))), bnth(18n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))), bnth(13n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))), gx, gy, gz, b3l()], True{}}))), Bool.and(ok, Bool.and(rrk(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}})), rrk(brun(CS.add_prog(), c, p, RR{[bnth(21n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))), bnth(18n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))), bnth(13n, rrr(brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))), gx, gy, gz, b3l()], True{}})))), h))

# a verified loop computes the specification's CS.lmul
