import Base
import ../../../lib/lemmas/proofs/nat_algebra.bend as NA
import ../../../math/typed/width.bend as WW
import ../semiring.bend as SR
import ../../../lib/logic.bend as Lg
import ../../../lib/nat.bend as N
import ../../../math/natural/arith.bend as NR
import ../../../../spec/crypto/secp256k1/field.bend as FS
import ../../../../spec/crypto/secp256k1/curve.bend as CS
import ./bn.bend as B
import ./bnx.bend as X
import ./certb.bend as CB
import ./bnf.bend as F
import ./sym.bend as S

# The specification's point formulas on binary numbers (bn.bend), for
# closed computations on concrete points: a register machine that runs
# CS.add_prog / CS.dbl_prog on Bn registers modulo p = 2^256 - c, and the
# double-and-add loop CS.lmul over it. Nothing is trusted: every register
# is reduced by three folds x = lo + 2^256 hi -> lo + c hi (proved to keep
# the value modulo p) and one proposed subtraction of p that is verified
# with the proved sum and equality of bn.bend (t == r or t == p + r, and
# r < p as p == r + 1 + d); a difference a - b is proposed and verified as
# a + p == t + b. The machine answers a flag with its registers; brun_v:
# when the flag is True the registers are the specification's, for every
# input (values B.bval; ptc.bend states it on X.bvalo, never expanded).

# ---- an unproved comparison (it only chooses what to propose) ----

def cmp_lo(c: Cmp, lo: Cmp) -> Cmp:
  match c:
    case EQ{}:
      lo
    case LT{}:
      LT{}
    case GT{}:
      GT{}

def bcmp(a: B.Bn, b: B.Bn) -> Cmp:
  match a b:
    case B.BZ{} B.BZ{}:
      EQ{}
    case B.BZ{} B.B0{y}:
      bcmp(B.BZ{}, y)
    case B.BZ{} B.B1{y}:
      LT{}
    case B.B0{x} B.BZ{}:
      bcmp(x, B.BZ{})
    case B.B1{x} B.BZ{}:
      GT{}
    case B.B0{x} B.B0{y}:
      bcmp(x, y)
    case B.B1{x} B.B1{y}:
      bcmp(x, y)
    case B.B0{x} B.B1{y}:
      cmp_lo(bcmp(x, y), LT{})
    case B.B1{x} B.B0{y}:
      cmp_lo(bcmp(x, y), GT{})

def is_ge(c: Cmp) -> Bool:
  match c:
    case LT{}:
      False{}
    case EQ{}:
      True{}
    case GT{}:
      True{}

# ---- the low k bits and the rest ----

def blo(k: Nat, x: B.Bn) -> B.Bn:
  match k x:
    case 0n _:
      B.BZ{}
    case 1n+j B.BZ{}:
      B.BZ{}
    case 1n+j B.B0{t}:
      B.B0{blo(j, t)}
    case 1n+j B.B1{t}:
      B.B1{blo(j, t)}

def bhi(k: Nat, x: B.Bn) -> B.Bn:
  match k x:
    case 0n y:
      y
    case 1n+j B.BZ{}:
      B.BZ{}
    case 1n+j B.B0{t}:
      bhi(j, t)
    case 1n+j B.B1{t}:
      bhi(j, t)

# x = lo + 2^256 hi becomes lo + c hi
def fold(+c: B.Bn, +x: B.Bn) -> B.Bn:
  B.badd(blo(256n, x), B.bmul(c, bhi(256n, x)))

# r < p, as p == r + 1 + d
def ltk(+r: B.Bn, +p: B.Bn) -> Bool:
  B.beq(p, B.badd(B.binc(r), X.bsubu(p, B.binc(r))))

def red1s(+t: B.Bn, +p: B.Bn, +r: B.Bn) -> X.PR:
  X.PR{r, Bool.and(B.beq(t, B.badd(p, r)), ltk(r, p))}

def red1c(g: Bool, +t: B.Bn, +p: B.Bn) -> X.PR:
  match g:
    case False{}:
      X.PR{t, ltk(t, p)}
    case True{}:
      red1s(t, p, X.bnorm(X.bsubu(t, p)))

# t < 2 p to its residue
def red1(+t: B.Bn, +p: B.Bn) -> X.PR:
  red1c(is_ge(bcmp(t, p)), t, p)

def redp(+c: B.Bn, +p: B.Bn, y: B.Bn) -> X.PR:
  red1(fold(c, fold(c, fold(c, y))), p)

# ---- registers ----

def bnth(i: Nat, regs: List<&2, B.Bn>) -> B.Bn:
  match i regs:
    case _ Nil{}:
      B.BZ{}
    case 0n r <> t:
      r
    case 1n+k r <> t:
      bnth(k, t)

def pand(k: Bool, r: X.PR) -> X.PR:
  match r:
    case X.PR{x, ok}:
      X.PR{x, Bool.and(k, ok)}

def bsuby(+c: B.Bn, +p: B.Bn, +s: B.Bn, +b: B.Bn, +t: B.Bn) -> X.PR:
  pand(B.beq(s, B.badd(t, b)), red1(t, p))

# a square by F.bsq (half the work of the product)
def msel(c: Bool, +a: B.Bn, +b: B.Bn) -> B.Bn:
  match c:
    case True{}:
      F.bsq(a)
    case False{}:
      B.bmul(a, b)

def pmq(+i: Nat, +j: Nat, +regs: List<&2, B.Bn>) -> B.Bn:
  msel(Nat.is_eq(i, j), bnth(i, regs), bnth(j, regs))

def bsubx(+c: B.Bn, +p: B.Bn, +s: B.Bn, +b: B.Bn) -> X.PR:
  bsuby(c, p, s, b, X.bsubu(s, b))

def bexec(op: CS.SOp, +c: B.Bn, +p: B.Bn, +regs: List<&2, B.Bn>) -> X.PR:
  match op:
    case CS.SAdd{i, j}:
      red1(B.badd(bnth(i, regs), bnth(j, regs)), p)
    case CS.SSub{i, j}:
      bsubx(c, p, B.badd(bnth(i, regs), p), bnth(j, regs))
    case CS.SMul{i, j}:
      redp(c, p, pmq(i, j, regs))

type RR is Data:
  RR{regs: List<&2, B.Bn>, ok: Bool}

def rrr(r: RR) -> List<&2, B.Bn>:
  match r:
    case RR{regs, ok}:
      regs

def rrk(r: RR) -> Bool:
  match r:
    case RR{regs, ok}:
      ok

def bstep(+regs: List<&2, B.Bn>, ok: Bool, +e: X.PR) -> RR:
  RR{List.append(&2, B.Bn, regs, [X.prr(e)]), Bool.and(ok, X.prk(e))}

def brun(prog: List<&2, CS.SOp>, +c: B.Bn, +p: B.Bn, r: RR) -> RR:
  match prog r:
    case Nil{} r2:
      r2
    case op <> t RR{+regs, ok}:
      brun(t, c, p, bstep(regs, ok, bexec(op, c, p, regs)))

# ---- points ----

type BP is Data:
  BP{x: B.Bn, y: B.Bn, z: B.Bn}

type RP is Data:
  RP{pt: BP, ok: Bool}

def rpp(r: RP) -> BP:
  match r:
    case RP{pt, ok}:
      pt

def rpk(r: RP) -> Bool:
  match r:
    case RP{pt, ok}:
      ok

def b3l() -> B.Bn:
  B.B1{B.B0{B.B1{B.B0{B.B1{B.BZ{}}}}}}

def ok3(+p: B.Bn, a: BP) -> Bool:
  match a:
    case BP{x, y, z}:
      Bool.and(ltk(x, p), Bool.and(ltk(y, p), ltk(z, p)))

def add_fin(+p: B.Bn, r: RR) -> RP:
  match r:
    case RR{+regs, ok}:
      RP{BP{bnth(33n, regs), bnth(36n, regs), bnth(39n, regs)}, ok}

def bpadd(+c: B.Bn, +p: B.Bn, a: BP, b: BP) -> RP:
  match a b:
    case BP{x1, y1, z1} BP{x2, y2, z2}:
      add_fin(p, brun(CS.add_prog(), c, p, RR{[x1, y1, z1, x2, y2, z2, b3l()], True{}}))

def dbl_fin(+p: B.Bn, r: RR) -> RP:
  match r:
    case RR{+regs, ok}:
      RP{BP{bnth(21n, regs), bnth(18n, regs), bnth(13n, regs)}, ok}

def bpdbl(+c: B.Bn, +p: B.Bn, a: BP) -> RP:
  match a:
    case BP{x, y, z}:
      dbl_fin(p, brun(CS.dbl_prog(), c, p, RR{[x, y, z, b3l()], True{}}))

def rand(k: Bool, r: RP) -> RP:
  match r:
    case RP{pt, ok}:
      RP{pt, Bool.and(k, ok)}

def badd_k(+c: B.Bn, +p: B.Bn, +g: BP, d: RP) -> RP:
  match d:
    case RP{pt, ok}:
      rand(ok, bpadd(c, p, pt, g))

def bnext(b: Nat, +c: B.Bn, +p: B.Bn, +g: BP, d: RP) -> RP:
  match b:
    case 0n:
      d
    case 1n+k:
      badd_k(c, p, g, d)

# the loop of CS.lmul
def blmul(bs: List<&2, Nat>, +c: B.Bn, +p: B.Bn, +g: BP, r: RP) -> RP:
  match bs r:
    case Nil{} r2:
      r2
    case b <> t RP{pt, ok}:
      blmul(t, c, p, g, rand(ok, bnext(b, c, p, g, bpdbl(c, p, pt))))

# ---- values: splitting and folding ----

def shl_z(k: Nat) -> {B.bval(CB.bshl(k, B.BZ{})) == 0n : Nat}:
  match k:
    case 0n:
      {==}
    case 1n+ +j:
      %goal {Nat.add(B.bval(CB.bshl(j, B.BZ{})), B.bval(CB.bshl(j, B.BZ{}))) == 0n : Nat}
      %rw shl_z(j)
      %rw shl_z(j)
      %close

def shl_s(+v: Nat, +w: Nat) -> {Nat.add(Nat.mul(v, w), Nat.mul(v, w)) == Nat.mul(v, Nat.add(w, w)) : Nat}:
  %norm

# h 2^k == h * 2^k
def shl_v(k: Nat, +h: B.Bn) -> {B.bval(CB.bshl(k, h)) == Nat.mul(B.bval(h), B.bval(CB.bshl(k, B.B1{B.BZ{}}))) : Nat}:
  match k:
    case 0n:
      Equal.sym(Nat, Nat.mul(B.bval(h), 1n), B.bval(h), NA.mul_one(B.bval(h)))
    case 1n+ +j:
      %goal {Nat.add(B.bval(CB.bshl(j, h)), B.bval(CB.bshl(j, h))) == Nat.mul(B.bval(h), Nat.add(B.bval(CB.bshl(j, B.B1{B.BZ{}})), B.bval(CB.bshl(j, B.B1{B.BZ{}})))) : Nat}
      %rw shl_v(j, h)
      %rw shl_v(j, h)
      shl_s(B.bval(h), B.bval(CB.bshl(j, B.B1{B.BZ{}})))

def sp0_s(+l: Nat, +h: Nat) -> {Nat.add(Nat.add(l, h), Nat.add(l, h)) == Nat.add(Nat.add(l, l), Nat.add(h, h)) : Nat}:
  %norm

def sp1_s(+l: Nat, +h: Nat) -> {1n+Nat.add(Nat.add(l, h), Nat.add(l, h)) == Nat.add(1n+Nat.add(l, l), Nat.add(h, h)) : Nat}:
  %norm

# x == lo + 2^k hi
def split_v(k: Nat, x: B.Bn) -> {B.bval(x) == Nat.add(B.bval(blo(k, x)), B.bval(CB.bshl(k, bhi(k, x)))) : Nat}:
  match k x:
    case 0n y:
      {==}
    case 1n+ +j B.BZ{}:
      %goal {0n == Nat.add(B.bval(CB.bshl(j, B.BZ{})), B.bval(CB.bshl(j, B.BZ{}))) : Nat}
      %rw shl_z(j)
      %rw shl_z(j)
      %close
    case 1n+ +j B.B0{+t}:
      %goal {Nat.add(B.bval(t), B.bval(t)) == Nat.add(Nat.add(B.bval(blo(j, t)), B.bval(blo(j, t))), Nat.add(B.bval(CB.bshl(j, bhi(j, t))), B.bval(CB.bshl(j, bhi(j, t))))) : Nat}
      %rw split_v(j, t)
      %rw split_v(j, t)
      sp0_s(B.bval(blo(j, t)), B.bval(CB.bshl(j, bhi(j, t))))
    case 1n+ +j B.B1{+t}:
      %goal {1n+Nat.add(B.bval(t), B.bval(t)) == Nat.add(1n+Nat.add(B.bval(blo(j, t)), B.bval(blo(j, t))), Nat.add(B.bval(CB.bshl(j, bhi(j, t))), B.bval(CB.bshl(j, bhi(j, t))))) : Nat}
      %rw split_v(j, t)
      %rw split_v(j, t)
      sp1_s(B.bval(blo(j, t)), B.bval(CB.bshl(j, bhi(j, t))))

def fo_s(+lo: Nat, +h: Nat, +p: Nat, +c: Nat) -> {Nat.add(lo, Nat.mul(h, Nat.add(p, c))) == Nat.add(Nat.add(lo, Nat.mul(c, h)), Nat.mul(h, p)) : Nat}:
  %norm

# x == fold(x) + hi p, with 2^256 == p + c (hw)
def fold_v(+c: B.Bn, +x: B.Bn, +p: B.Bn, +hw: {B.bval(CB.bshl(256n, B.B1{B.BZ{}})) == Nat.add(B.bval(p), B.bval(c)) : Nat}) -> {B.bval(x) == Nat.add(B.bval(fold(c, x)), Nat.mul(B.bval(bhi(256n, x)), B.bval(p))) : Nat}:
  %goal {B.bval(x) == Nat.add(B.bval(B.badd(blo(256n, x), B.bmul(c, bhi(256n, x)))), Nat.mul(B.bval(bhi(256n, x)), B.bval(p))) : Nat}
  %rw split_v(256n, x)
  %rw shl_v(256n, bhi(256n, x))
  %rwh hw : {B.bval(CB.bshl(256n, B.B1{B.BZ{}})) == Nat.add(B.bval(p), B.bval(c)) : Nat}
  %rw B.badd_v(blo(256n, x), B.bmul(c, bhi(256n, x)))
  %rw B.bmul_v(c, bhi(256n, x))
  fo_s(B.bval(blo(256n, x)), B.bval(bhi(256n, x)), B.bval(p), B.bval(c))

def fold_mod(+c: B.Bn, +p: B.Bn, +mp: Nat, +x: B.Bn, +hm: {B.bval(p) == 1n+mp : Nat}, +hw: {B.bval(CB.bshl(256n, B.B1{B.BZ{}})) == Nat.add(B.bval(p), B.bval(c)) : Nat}) -> {Nat.mod(B.bval(x), 1n+mp) == Nat.mod(B.bval(fold(c, x)), 1n+mp) : Nat}:
  %rw fold_v(c, x, p, hw)
  %rwh hm : {B.bval(p) == 1n+mp : Nat}
  %rw NA.add_comm(B.bval(fold(c, x)), Nat.mul(B.bval(bhi(256n, x)), 1n+mp))
  NR.absorb(mp, B.bval(bhi(256n, x)), B.bval(fold(c, x)))

def ltk_v(+r: B.Bn, +p: B.Bn, +mp: Nat, +hm: {B.bval(p) == 1n+mp : Nat}, +h: {ltk(r, p) == True{} : Bool}) -> {Nat.is_lt(B.bval(r), 1n+mp) == True{} : Bool}:
  %hm : {Nat.is_lt(B.bval(r), _) == True{} : Bool}
  %Equal.sym(Nat, B.bval(p), B.bval(B.badd(B.binc(r), X.bsubu(p, B.binc(r)))), B.beq_v(p, B.badd(B.binc(r), X.bsubu(p, B.binc(r))), h)) : {Nat.is_lt(B.bval(r), _) == True{} : Bool}
  %Equal.sym(Nat, B.bval(B.badd(B.binc(r), X.bsubu(p, B.binc(r)))), Nat.add(B.bval(B.binc(r)), B.bval(X.bsubu(p, B.binc(r)))), B.badd_v(B.binc(r), X.bsubu(p, B.binc(r)))) : {Nat.is_lt(B.bval(r), _) == True{} : Bool}
  %Equal.sym(Nat, B.bval(B.binc(r)), 1n+B.bval(r), B.binc_v(r)) : {Nat.is_lt(B.bval(r), Nat.add(_, B.bval(X.bsubu(p, B.binc(r))))) == True{} : Bool}
  N.le_lt_succ(B.bval(r), Nat.add(B.bval(r), B.bval(X.bsubu(p, B.binc(r)))), N.le_add_right(B.bval(r), B.bval(X.bsubu(p, B.binc(r)))))

def red1c_lt(g: Bool, +t: B.Bn, +p: B.Bn, +h: {X.prk(red1c(g, t, p)) == True{} : Bool}) -> {ltk(X.prr(red1c(g, t, p)), p) == True{} : Bool}:
  match g:
    case False{}:
      h
    case True{}:
      Lg.and_right(B.beq(t, B.badd(p, X.bnorm(X.bsubu(t, p)))), ltk(X.bnorm(X.bsubu(t, p)), p), h)

def red1c_v(g: Bool, +t: B.Bn, +p: B.Bn, +mp: Nat, +hm: {B.bval(p) == 1n+mp : Nat}, +h: {X.prk(red1c(g, t, p)) == True{} : Bool}) -> {Nat.mod(B.bval(t), 1n+mp) == B.bval(X.prr(red1c(g, t, p))) : Nat}:
  match g:
    case False{}:
      NR.mod_of(0n, mp, B.bval(t), ltk_v(t, p, mp, hm, h))
    case True{}:
      +r = X.bnorm(X.bsubu(t, p))
      %Equal.sym(Nat, B.bval(t), B.bval(B.badd(p, r)), B.beq_v(t, B.badd(p, r), Lg.and_left(B.beq(t, B.badd(p, r)), ltk(r, p), h))) : {Nat.mod(_, 1n+mp) == B.bval(r) : Nat}
      %Equal.sym(Nat, B.bval(B.badd(p, r)), Nat.add(B.bval(p), B.bval(r)), B.badd_v(p, r)) : {Nat.mod(_, 1n+mp) == B.bval(r) : Nat}
      %Equal.sym(Nat, B.bval(p), 1n+mp, hm) : {Nat.mod(Nat.add(_, B.bval(r)), 1n+mp) == B.bval(r) : Nat}
      %SR.one_mul(1n+mp) : {Nat.mod(Nat.add(_, B.bval(r)), 1n+mp) == B.bval(r) : Nat}
      NR.mod_of(1n, mp, B.bval(r), ltk_v(r, p, mp, hm, Lg.and_right(B.beq(t, B.badd(p, r)), ltk(r, p), h)))

def redp_lt(+c: B.Bn, +p: B.Bn, +y: B.Bn, +h: {X.prk(redp(c, p, y)) == True{} : Bool}) -> {ltk(X.prr(redp(c, p, y)), p) == True{} : Bool}:
  red1c_lt(is_ge(bcmp(fold(c, fold(c, fold(c, y))), p)), fold(c, fold(c, fold(c, y))), p, h)

# the residue of y
def redp_v(+c: B.Bn, +p: B.Bn, +mp: Nat, +y: B.Bn, +hm: {B.bval(p) == 1n+mp : Nat}, +hw: {B.bval(CB.bshl(256n, B.B1{B.BZ{}})) == Nat.add(B.bval(p), B.bval(c)) : Nat}, +h: {X.prk(redp(c, p, y)) == True{} : Bool}) -> {Nat.mod(B.bval(y), 1n+mp) == B.bval(X.prr(redp(c, p, y))) : Nat}:
  Equal.trans(Nat, Nat.mod(B.bval(y), 1n+mp), Nat.mod(B.bval(fold(c, y)), 1n+mp), B.bval(X.prr(redp(c, p, y))), fold_mod(c, p, mp, y, hm, hw),
    Equal.trans(Nat, Nat.mod(B.bval(fold(c, y)), 1n+mp), Nat.mod(B.bval(fold(c, fold(c, y))), 1n+mp), B.bval(X.prr(redp(c, p, y))), fold_mod(c, p, mp, fold(c, y), hm, hw),
      Equal.trans(Nat, Nat.mod(B.bval(fold(c, fold(c, y))), 1n+mp), Nat.mod(B.bval(fold(c, fold(c, fold(c, y)))), 1n+mp), B.bval(X.prr(redp(c, p, y))), fold_mod(c, p, mp, fold(c, fold(c, y)), hm, hw),
        red1c_v(is_ge(bcmp(fold(c, fold(c, fold(c, y))), p)), fold(c, fold(c, fold(c, y))), p, mp, hm, h))))

# ---- registers ----

def vals(regs: List<&2, B.Bn>) -> List<&2, Nat>:
  match regs:
    case Nil{}:
      Nil{}
    case x <> t:
      B.bval(x) <> vals(t)

def allok(+p: B.Bn, regs: List<&2, B.Bn>) -> Bool:
  match regs:
    case Nil{}:
      True{}
    case x <> t:
      Bool.and(ltk(x, p), allok(p, t))

def nth_vals(i: Nat, regs: List<&2, B.Bn>) -> {CS.nth(i, vals(regs)) == B.bval(bnth(i, regs)) : Nat}:
  match i regs:
    case 0n Nil{}:
      {==}
    case 1n+k Nil{}:
      {==}
    case 0n r <> t:
      {==}
    case 1n+ +k r <> +t:
      nth_vals(k, t)

def all_lt(+p: B.Bn, +mp: Nat, i: Nat, regs: List<&2, B.Bn>, +hm: {B.bval(p) == 1n+mp : Nat}, +hall: {allok(p, regs) == True{} : Bool}) -> {Nat.is_lt(B.bval(bnth(i, regs)), 1n+mp) == True{} : Bool}:
  match i regs:
    case 0n Nil{}:
      {==}
    case 1n+k Nil{}:
      {==}
    case 0n +r <> +t:
      ltk_v(r, p, mp, hm, Lg.and_left(ltk(r, p), allok(p, t), hall))
    case 1n+ +k +r <> +t:
      all_lt(p, mp, k, t, hm, Lg.and_right(ltk(r, p), allok(p, t), hall))

def all_ltk(+p: B.Bn, i: Nat, regs: List<&2, B.Bn>, +hz: {ltk(B.BZ{}, p) == True{} : Bool}, +hall: {allok(p, regs) == True{} : Bool}) -> {ltk(bnth(i, regs), p) == True{} : Bool}:
  match i regs:
    case 0n Nil{}:
      hz
    case 1n+k Nil{}:
      hz
    case 0n +r <> +t:
      Lg.and_left(ltk(r, p), allok(p, t), hall)
    case 1n+ +k +r <> +t:
      all_ltk(p, k, t, hz, Lg.and_right(ltk(r, p), allok(p, t), hall))

def allok_app(+p: B.Bn, regs: List<&2, B.Bn>, +r: B.Bn, +hall: {allok(p, regs) == True{} : Bool}, +hr: {ltk(r, p) == True{} : Bool}) -> {allok(p, List.append(&2, B.Bn, regs, [r])) == True{} : Bool}:
  match regs:
    case Nil{}:
      Lg.and_intro(ltk(r, p), True{}, hr, {==})
    case +x <> +t:
      Lg.and_intro(ltk(x, p), allok(p, List.append(&2, B.Bn, t, [r])), Lg.and_left(ltk(x, p), allok(p, t), hall), allok_app(p, t, r, Lg.and_right(ltk(x, p), allok(p, t), hall), hr))

def vals_app(regs: List<&2, B.Bn>, +r: B.Bn) -> {vals(List.append(&2, B.Bn, regs, [r])) == List.append(&2, Nat, vals(regs), [B.bval(r)]) : List<&2, Nat>}:
  match regs:
    case Nil{}:
      {==}
    case +x <> +t:
      Equal.cong(List<&2, Nat>, List<&2, Nat>, l => B.bval(x) <> l, vals(List.append(&2, B.Bn, t, [r])), List.append(&2, Nat, vals(t), [B.bval(r)]), vals_app(t, r))

def pand_r(+k: Bool, r: X.PR) -> {X.prr(pand(k, r)) == X.prr(r) : B.Bn}:
  match r:
    case X.PR{x, ok}:
      {==}

def pand_k(+k: Bool, r: X.PR, +h: {X.prk(pand(k, r)) == True{} : Bool}) -> {k == True{} : Bool}:
  match r:
    case X.PR{x, +ok}:
      Lg.and_left(k, ok, h)

def pand_p(+k: Bool, r: X.PR, +h: {X.prk(pand(k, r)) == True{} : Bool}) -> {X.prk(r) == True{} : Bool}:
  match r:
    case X.PR{x, +ok}:
      Lg.and_right(k, ok, h)

def bexec_lt(op: CS.SOp, +c: B.Bn, +p: B.Bn, +regs: List<&2, B.Bn>, +h: {X.prk(bexec(op, c, p, regs)) == True{} : Bool}) -> {ltk(X.prr(bexec(op, c, p, regs)), p) == True{} : Bool}:
  match op:
    case CS.SAdd{+i, +j}:
      red1c_lt(is_ge(bcmp(B.badd(bnth(i, regs), bnth(j, regs)), p)), B.badd(bnth(i, regs), bnth(j, regs)), p, h)
    case CS.SSub{+i, +j}:
      %Equal.sym(B.Bn, X.prr(pand(B.beq(B.badd(bnth(i, regs), p), B.badd(X.bsubu(B.badd(bnth(i, regs), p), bnth(j, regs)), bnth(j, regs))), red1(X.bsubu(B.badd(bnth(i, regs), p), bnth(j, regs)), p))), X.prr(red1(X.bsubu(B.badd(bnth(i, regs), p), bnth(j, regs)), p)), pand_r(B.beq(B.badd(bnth(i, regs), p), B.badd(X.bsubu(B.badd(bnth(i, regs), p), bnth(j, regs)), bnth(j, regs))), red1(X.bsubu(B.badd(bnth(i, regs), p), bnth(j, regs)), p))) : {ltk(_, p) == True{} : Bool}
      red1c_lt(is_ge(bcmp(X.bsubu(B.badd(bnth(i, regs), p), bnth(j, regs)), p)), X.bsubu(B.badd(bnth(i, regs), p), bnth(j, regs)), p, pand_p(B.beq(B.badd(bnth(i, regs), p), B.badd(X.bsubu(B.badd(bnth(i, regs), p), bnth(j, regs)), bnth(j, regs))), red1(X.bsubu(B.badd(bnth(i, regs), p), bnth(j, regs)), p), h))
    case CS.SMul{+i, +j}:
      redp_lt(c, p, pmq(i, j, regs), h)

def msel_v(c: Bool, +i: Nat, +j: Nat, +regs: List<&2, B.Bn>, +hc: {Nat.is_eq(i, j) == c : Bool}) -> {B.bval(msel(c, bnth(i, regs), bnth(j, regs))) == Nat.mul(B.bval(bnth(i, regs)), B.bval(bnth(j, regs))) : Nat}:
  match c:
    case True{}:
      Lg.subst(Nat, v => {B.bval(F.bsq(bnth(i, regs))) == Nat.mul(B.bval(bnth(i, regs)), B.bval(bnth(v, regs))) : Nat}, i, j, N.eq_from_is_eq(i, j, hc), F.bsq_v(bnth(i, regs)))
    case False{}:
      B.bmul_v(bnth(i, regs), bnth(j, regs))

def pmq_v(+i: Nat, +j: Nat, +regs: List<&2, B.Bn>) -> {B.bval(pmq(i, j, regs)) == Nat.mul(B.bval(bnth(i, regs)), B.bval(bnth(j, regs))) : Nat}:
  msel_v(Nat.is_eq(i, j), i, j, regs, {==})

def sub_s(+t: Nat, +b: Nat) -> {Nat.sub(Nat.add(t, b), b) == t : Nat}:
  %rw NA.add_comm(t, b)
  N.add_sub_cancel(b, t)

# one instruction computes the specification's register
def bexec_v(op: CS.SOp, +c: B.Bn, +p: B.Bn, +mp: Nat, +regs: List<&2, B.Bn>, +hm: {B.bval(p) == 1n+mp : Nat}, +hw: {B.bval(CB.bshl(256n, B.B1{B.BZ{}})) == Nat.add(B.bval(p), B.bval(c)) : Nat}, +hall: {allok(p, regs) == True{} : Bool}, +h: {X.prk(bexec(op, c, p, regs)) == True{} : Bool}) -> {CS.exec(1n+mp, op, vals(regs)) == B.bval(X.prr(bexec(op, c, p, regs))) : Nat}:
  match op:
    case CS.SAdd{+i, +j}:
      %goal {Nat.mod(Nat.add(CS.nth(i, vals(regs)), CS.nth(j, vals(regs))), 1n+mp) == B.bval(X.prr(red1(B.badd(bnth(i, regs), bnth(j, regs)), p))) : Nat}
      %rw nth_vals(i, regs)
      %rw nth_vals(j, regs)
      %rw <- B.badd_v(bnth(i, regs), bnth(j, regs))
      red1c_v(is_ge(bcmp(B.badd(bnth(i, regs), bnth(j, regs)), p)), B.badd(bnth(i, regs), bnth(j, regs)), p, mp, hm, h)
    case CS.SSub{+i, +j}:
      %goal {Nat.mod(Nat.sub(Nat.add(CS.nth(i, vals(regs)), 1n+mp), Nat.mod(CS.nth(j, vals(regs)), 1n+mp)), 1n+mp) == B.bval(X.prr(pand(B.beq(B.badd(bnth(i, regs), p), B.badd(X.bsubu(B.badd(bnth(i, regs), p), bnth(j, regs)), bnth(j, regs))), red1(X.bsubu(B.badd(bnth(i, regs), p), bnth(j, regs)), p)))) : Nat}
      %rw nth_vals(i, regs)
      %rw nth_vals(j, regs)
      %rwh NR.mod_of(0n, mp, B.bval(bnth(j, regs)), all_lt(p, mp, j, regs, hm, hall)) : {Nat.mod(B.bval(bnth(j, regs)), 1n+mp) == B.bval(bnth(j, regs)) : Nat}
      %rwh Equal.sym(Nat, B.bval(p), 1n+mp, hm) : {1n+mp == B.bval(p) : Nat}
      %rw <- B.badd_v(bnth(i, regs), p)
      %rwh B.beq_v(B.badd(bnth(i, regs), p), B.badd(X.bsubu(B.badd(bnth(i, regs), p), bnth(j, regs)), bnth(j, regs)), pand_k(B.beq(B.badd(bnth(i, regs), p), B.badd(X.bsubu(B.badd(bnth(i, regs), p), bnth(j, regs)), bnth(j, regs))), red1(X.bsubu(B.badd(bnth(i, regs), p), bnth(j, regs)), p), h)) : {B.bval(B.badd(bnth(i, regs), p)) == B.bval(B.badd(X.bsubu(B.badd(bnth(i, regs), p), bnth(j, regs)), bnth(j, regs))) : Nat}
      %rw B.badd_v(X.bsubu(B.badd(bnth(i, regs), p), bnth(j, regs)), bnth(j, regs))
      %rw sub_s(B.bval(X.bsubu(B.badd(bnth(i, regs), p), bnth(j, regs))), B.bval(bnth(j, regs)))
      %rw pand_r(B.beq(B.badd(bnth(i, regs), p), B.badd(X.bsubu(B.badd(bnth(i, regs), p), bnth(j, regs)), bnth(j, regs))), red1(X.bsubu(B.badd(bnth(i, regs), p), bnth(j, regs)), p))
      red1c_v(is_ge(bcmp(X.bsubu(B.badd(bnth(i, regs), p), bnth(j, regs)), p)), X.bsubu(B.badd(bnth(i, regs), p), bnth(j, regs)), p, mp, hm, pand_p(B.beq(B.badd(bnth(i, regs), p), B.badd(X.bsubu(B.badd(bnth(i, regs), p), bnth(j, regs)), bnth(j, regs))), red1(X.bsubu(B.badd(bnth(i, regs), p), bnth(j, regs)), p), h))
    case CS.SMul{+i, +j}:
      %goal {Nat.mod(Nat.mul(CS.nth(i, vals(regs)), CS.nth(j, vals(regs))), 1n+mp) == B.bval(X.prr(redp(c, p, pmq(i, j, regs)))) : Nat}
      %rw nth_vals(i, regs)
      %rw nth_vals(j, regs)
      %rw <- pmq_v(i, j, regs)
      redp_v(c, p, mp, pmq(i, j, regs), hm, hw, h)

# ---- a run ----

def brun_ok(prog: List<&2, CS.SOp>, +c: B.Bn, +p: B.Bn, +regs: List<&2, B.Bn>, +ok: Bool, +h: {rrk(brun(prog, c, p, RR{regs, ok})) == True{} : Bool}) -> {ok == True{} : Bool}:
  match prog:
    case Nil{}:
      h
    case +op <> +t:
      Lg.and_left(ok, X.prk(bexec(op, c, p, regs)), brun_ok(t, c, p, List.append(&2, B.Bn, regs, [X.prr(bexec(op, c, p, regs))]), Bool.and(ok, X.prk(bexec(op, c, p, regs))), h))

def step_ok(+prog: List<&2, CS.SOp>, +op: CS.SOp, +c: B.Bn, +p: B.Bn, +regs: List<&2, B.Bn>, +ok: Bool, +h: {rrk(brun(op <> prog, c, p, RR{regs, ok})) == True{} : Bool}) -> {X.prk(bexec(op, c, p, regs)) == True{} : Bool}:
  Lg.and_right(ok, X.prk(bexec(op, c, p, regs)), brun_ok(prog, c, p, List.append(&2, B.Bn, regs, [X.prr(bexec(op, c, p, regs))]), Bool.and(ok, X.prk(bexec(op, c, p, regs))), h))

# a verified run leaves reduced registers
def brun_all(prog: List<&2, CS.SOp>, +c: B.Bn, +p: B.Bn, +regs: List<&2, B.Bn>, +ok: Bool, +hall: {allok(p, regs) == True{} : Bool}, +h: {rrk(brun(prog, c, p, RR{regs, ok})) == True{} : Bool}) -> {allok(p, rrr(brun(prog, c, p, RR{regs, ok}))) == True{} : Bool}:
  match prog:
    case Nil{}:
      hall
    case +op <> +t:
      brun_all(t, c, p, List.append(&2, B.Bn, regs, [X.prr(bexec(op, c, p, regs))]), Bool.and(ok, X.prk(bexec(op, c, p, regs))), allok_app(p, regs, X.prr(bexec(op, c, p, regs)), hall, bexec_lt(op, c, p, regs, step_ok(t, op, c, p, regs, ok, h))), h)

# a verified run computes the specification's registers
def brun_v(prog: List<&2, CS.SOp>, +c: B.Bn, +p: B.Bn, +mp: Nat, +regs: List<&2, B.Bn>, +ok: Bool, +hm: {B.bval(p) == 1n+mp : Nat}, +hw: {B.bval(CB.bshl(256n, B.B1{B.BZ{}})) == Nat.add(B.bval(p), B.bval(c)) : Nat}, +hall: {allok(p, regs) == True{} : Bool}, +h: {rrk(brun(prog, c, p, RR{regs, ok})) == True{} : Bool}) -> {CS.run_go(1n+mp, prog, vals(regs)) == vals(rrr(brun(prog, c, p, RR{regs, ok}))) : List<&2, Nat>}:
  match prog:
    case Nil{}:
      {==}
    case +op <> +t:
      +e = bexec(op, c, p, regs)
      +hk = step_ok(t, op, c, p, regs, ok, h)
      %Equal.sym(Nat, CS.exec(1n+mp, op, vals(regs)), B.bval(X.prr(e)), bexec_v(op, c, p, mp, regs, hm, hw, hall, hk)) : {CS.run_go(1n+mp, t, List.append(&2, Nat, vals(regs), [_])) == vals(rrr(brun(t, c, p, RR{List.append(&2, B.Bn, regs, [X.prr(e)]), Bool.and(ok, X.prk(e))}))) : List<&2, Nat>}
      %vals_app(regs, X.prr(e)) : {CS.run_go(1n+mp, t, _) == vals(rrr(brun(t, c, p, RR{List.append(&2, B.Bn, regs, [X.prr(e)]), Bool.and(ok, X.prk(e))}))) : List<&2, Nat>}
      brun_v(t, c, p, mp, List.append(&2, B.Bn, regs, [X.prr(e)]), Bool.and(ok, X.prk(e)), hm, hw, allok_app(p, regs, X.prr(e), hall, bexec_lt(op, c, p, regs, hk)), h)

# ---- points ----

def spv(a: BP) -> CS.SPoint:
  match a:
    case BP{x, y, z}:
      CS.SPoint{B.bval(x), B.bval(y), B.bval(z)}

def add_all(+p: B.Bn, +x1: B.Bn, +y1: B.Bn, +z1: B.Bn, +x2: B.Bn, +y2: B.Bn, +z2: B.Bn, +h21: {ltk(b3l(), p) == True{} : Bool}, +ha: {ok3(p, BP{x1, y1, z1}) == True{} : Bool}, +hb: {ok3(p, BP{x2, y2, z2}) == True{} : Bool}) -> {allok(p, [x1, y1, z1, x2, y2, z2, b3l()]) == True{} : Bool}:
  Lg.and_intro(ltk(x1, p), allok(p, [y1, z1, x2, y2, z2, b3l()]), Lg.and_left(ltk(x1, p), Bool.and(ltk(y1, p), ltk(z1, p)), ha), Lg.and_intro(ltk(y1, p), allok(p, [z1, x2, y2, z2, b3l()]), Lg.and_left(ltk(y1, p), ltk(z1, p), Lg.and_right(ltk(x1, p), Bool.and(ltk(y1, p), ltk(z1, p)), ha)), Lg.and_intro(ltk(z1, p), allok(p, [x2, y2, z2, b3l()]), Lg.and_right(ltk(y1, p), ltk(z1, p), Lg.and_right(ltk(x1, p), Bool.and(ltk(y1, p), ltk(z1, p)), ha)), Lg.and_intro(ltk(x2, p), allok(p, [y2, z2, b3l()]), Lg.and_left(ltk(x2, p), Bool.and(ltk(y2, p), ltk(z2, p)), hb), Lg.and_intro(ltk(y2, p), allok(p, [z2, b3l()]), Lg.and_left(ltk(y2, p), ltk(z2, p), Lg.and_right(ltk(x2, p), Bool.and(ltk(y2, p), ltk(z2, p)), hb)), Lg.and_intro(ltk(z2, p), allok(p, [b3l()]), Lg.and_right(ltk(y2, p), ltk(z2, p), Lg.and_right(ltk(x2, p), Bool.and(ltk(y2, p), ltk(z2, p)), hb)), Lg.and_intro(ltk(b3l(), p), True{}, h21, {==})))))))

# the add program on binary registers is the specification's
def add_v(+c: B.Bn, +p: B.Bn, +mp: Nat, +x1: B.Bn, +y1: B.Bn, +z1: B.Bn, +x2: B.Bn, +y2: B.Bn, +z2: B.Bn, +hm: {B.bval(p) == 1n+mp : Nat}, +hw: {B.bval(CB.bshl(256n, B.B1{B.BZ{}})) == Nat.add(B.bval(p), B.bval(c)) : Nat}, +h21: {ltk(b3l(), p) == True{} : Bool}, +ha: {ok3(p, BP{x1, y1, z1}) == True{} : Bool}, +hb: {ok3(p, BP{x2, y2, z2}) == True{} : Bool}, +h: {rrk(brun(CS.add_prog(), c, p, RR{[x1, y1, z1, x2, y2, z2, b3l()], True{}})) == True{} : Bool}) -> {CS.padd(1n+mp, CS.SPoint{B.bval(x1), B.bval(y1), B.bval(z1)}, CS.SPoint{B.bval(x2), B.bval(y2), B.bval(z2)}) == CS.SPoint{B.bval(bnth(33n, rrr(brun(CS.add_prog(), c, p, RR{[x1, y1, z1, x2, y2, z2, b3l()], True{}})))), B.bval(bnth(36n, rrr(brun(CS.add_prog(), c, p, RR{[x1, y1, z1, x2, y2, z2, b3l()], True{}})))), B.bval(bnth(39n, rrr(brun(CS.add_prog(), c, p, RR{[x1, y1, z1, x2, y2, z2, b3l()], True{}}))))} : CS.SPoint}:
  %goal {CS.SPoint{CS.nth(33n, CS.run(1n+mp, CS.add_prog(), [B.bval(x1), B.bval(y1), B.bval(z1), B.bval(x2), B.bval(y2), B.bval(z2), 21n])), CS.nth(36n, CS.run(1n+mp, CS.add_prog(), [B.bval(x1), B.bval(y1), B.bval(z1), B.bval(x2), B.bval(y2), B.bval(z2), 21n])), CS.nth(39n, CS.run(1n+mp, CS.add_prog(), [B.bval(x1), B.bval(y1), B.bval(z1), B.bval(x2), B.bval(y2), B.bval(z2), 21n]))} == CS.SPoint{B.bval(bnth(33n, rrr(brun(CS.add_prog(), c, p, RR{[x1, y1, z1, x2, y2, z2, b3l()], True{}})))), B.bval(bnth(36n, rrr(brun(CS.add_prog(), c, p, RR{[x1, y1, z1, x2, y2, z2, b3l()], True{}})))), B.bval(bnth(39n, rrr(brun(CS.add_prog(), c, p, RR{[x1, y1, z1, x2, y2, z2, b3l()], True{}}))))} : CS.SPoint}
  %rw S.run_is(1n+mp, CS.add_prog(), [B.bval(x1), B.bval(y1), B.bval(z1), B.bval(x2), B.bval(y2), B.bval(z2), 21n])
  %rw S.run_is(1n+mp, CS.add_prog(), [B.bval(x1), B.bval(y1), B.bval(z1), B.bval(x2), B.bval(y2), B.bval(z2), 21n])
  %rw S.run_is(1n+mp, CS.add_prog(), [B.bval(x1), B.bval(y1), B.bval(z1), B.bval(x2), B.bval(y2), B.bval(z2), 21n])
  %Equal.sym(List<&2, Nat>, CS.run_go(1n+mp, CS.add_prog(), vals([x1, y1, z1, x2, y2, z2, b3l()])), vals(rrr(brun(CS.add_prog(), c, p, RR{[x1, y1, z1, x2, y2, z2, b3l()], True{}}))), brun_v(CS.add_prog(), c, p, mp, [x1, y1, z1, x2, y2, z2, b3l()], True{}, hm, hw, add_all(p, x1, y1, z1, x2, y2, z2, h21, ha, hb), h)) : {CS.SPoint{CS.nth(33n, _), CS.nth(36n, CS.run_go(1n+mp, CS.add_prog(), vals([x1, y1, z1, x2, y2, z2, b3l()]))), CS.nth(39n, CS.run_go(1n+mp, CS.add_prog(), vals([x1, y1, z1, x2, y2, z2, b3l()])))} == CS.SPoint{B.bval(bnth(33n, rrr(brun(CS.add_prog(), c, p, RR{[x1, y1, z1, x2, y2, z2, b3l()], True{}})))), B.bval(bnth(36n, rrr(brun(CS.add_prog(), c, p, RR{[x1, y1, z1, x2, y2, z2, b3l()], True{}})))), B.bval(bnth(39n, rrr(brun(CS.add_prog(), c, p, RR{[x1, y1, z1, x2, y2, z2, b3l()], True{}}))))} : CS.SPoint}
  %Equal.sym(List<&2, Nat>, CS.run_go(1n+mp, CS.add_prog(), vals([x1, y1, z1, x2, y2, z2, b3l()])), vals(rrr(brun(CS.add_prog(), c, p, RR{[x1, y1, z1, x2, y2, z2, b3l()], True{}}))), brun_v(CS.add_prog(), c, p, mp, [x1, y1, z1, x2, y2, z2, b3l()], True{}, hm, hw, add_all(p, x1, y1, z1, x2, y2, z2, h21, ha, hb), h)) : {CS.SPoint{CS.nth(33n, vals(rrr(brun(CS.add_prog(), c, p, RR{[x1, y1, z1, x2, y2, z2, b3l()], True{}})))), CS.nth(36n, _), CS.nth(39n, CS.run_go(1n+mp, CS.add_prog(), vals([x1, y1, z1, x2, y2, z2, b3l()])))} == CS.SPoint{B.bval(bnth(33n, rrr(brun(CS.add_prog(), c, p, RR{[x1, y1, z1, x2, y2, z2, b3l()], True{}})))), B.bval(bnth(36n, rrr(brun(CS.add_prog(), c, p, RR{[x1, y1, z1, x2, y2, z2, b3l()], True{}})))), B.bval(bnth(39n, rrr(brun(CS.add_prog(), c, p, RR{[x1, y1, z1, x2, y2, z2, b3l()], True{}}))))} : CS.SPoint}
