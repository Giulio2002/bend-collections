import Base
import ../../../lib/lemmas/proofs/nat_algebra.bend as NA
import ../../../math/typed/width.bend as WW
import ../semiring.bend as SR
import ../../../lib/logic.bend as Lg
import ../../../lib/nat.bend as N
import ../../../math/natural/arith.bend as NR
import ./bn.bend as B
import ./zm.bend as Z

# Modular exponentiation on the binary numbers of bn.bend for a modulus
# m = 2^k - c with a small or sparse c (secp256k1's p, and p - 1 for the
# factor q1 of p - 1): a product t = lo + 2^k hi is folded to lo + c hi,
# which is t - hi m, so congruent to t. No quotient is supplied and none is
# computed; the residues are not canonical (about one bit over k), only
# congruent. fexp(e, a, k, c) is a^e by squarings down the bits of e;
# fexp_v: its value is a^e modulo m, for every input.
#
# bsq is the square by (1 + 2t)^2 = 1 + 4(t + t^2): one addition per one
# bit, of the length of the rest, half the work of bn.bend's product.

def bsq(a: B.Bn) -> B.Bn:
  match a:
    case B.BZ{}:
      B.BZ{}
    case B.B0{t}:
      B.B0{B.B0{bsq(t)}}
    case B.B1{+t}:
      B.B1{B.B0{B.badd(t, bsq(t))}}

# a 2^k
def fshl(k: Nat, a: B.Bn) -> B.Bn:
  match k:
    case 0n:
      a
    case 1n+j:
      B.B0{fshl(j, a)}

def flo(k: Nat, a: B.Bn) -> B.Bn:
  match k a:
    case 0n _:
      B.BZ{}
    case 1n+j B.BZ{}:
      B.BZ{}
    case 1n+j B.B0{t}:
      B.B0{flo(j, t)}
    case 1n+j B.B1{t}:
      B.B1{flo(j, t)}

def fhi(k: Nat, a: B.Bn) -> B.Bn:
  match k a:
    case 0n x:
      x
    case 1n+j B.BZ{}:
      B.BZ{}
    case 1n+j B.B0{t}:
      fhi(j, t)
    case 1n+j B.B1{t}:
      fhi(j, t)

# lo + c hi
def fold(+k: Nat, +c: B.Bn, +t: B.Bn) -> B.Bn:
  B.badd(flo(k, t), B.bmul(c, fhi(k, t)))

# two folds
def fred(+k: Nat, +c: B.Bn, +t: B.Bn) -> B.Bn:
  fold(k, c, fold(k, c, t))

def fexp(e: B.Bn, +a: B.Bn, +k: Nat, +c: B.Bn) -> B.Bn:
  match e:
    case B.BZ{}:
      B.B1{B.BZ{}}
    case B.B0{t}:
      fred(k, c, bsq(fexp(t, a, k, c)))
    case B.B1{t}:
      fred(k, c, B.bmul(a, bsq(fexp(t, a, k, c))))

# ---- values ----

def q0_s(+v: Nat) -> {Nat.add(Nat.add(Nat.mul(v, v), Nat.mul(v, v)), Nat.add(Nat.mul(v, v), Nat.mul(v, v))) == Nat.mul(Nat.add(v, v), Nat.add(v, v)) : Nat}:
  %norm

def q1_s(+v: Nat) -> {1n+Nat.add(Nat.add(Nat.add(v, Nat.mul(v, v)), Nat.add(v, Nat.mul(v, v))), Nat.add(Nat.add(v, Nat.mul(v, v)), Nat.add(v, Nat.mul(v, v)))) == Nat.mul(1n+Nat.add(v, v), 1n+Nat.add(v, v)) : Nat}:
  %norm

def bsq_v(a: B.Bn) -> {B.bval(bsq(a)) == Nat.mul(B.bval(a), B.bval(a)) : Nat}:
  match a:
    case B.BZ{}:
      {==}
    case B.B0{+t}:
      %goal {Nat.add(Nat.add(B.bval(bsq(t)), B.bval(bsq(t))), Nat.add(B.bval(bsq(t)), B.bval(bsq(t)))) == Nat.mul(Nat.add(B.bval(t), B.bval(t)), Nat.add(B.bval(t), B.bval(t))) : Nat}
      %rw bsq_v(t)
      %rw bsq_v(t)
      %rw bsq_v(t)
      %rw bsq_v(t)
      q0_s(B.bval(t))
    case B.B1{+t}:
      %goal {1n+Nat.add(Nat.add(B.bval(B.badd(t, bsq(t))), B.bval(B.badd(t, bsq(t)))), Nat.add(B.bval(B.badd(t, bsq(t))), B.bval(B.badd(t, bsq(t))))) == Nat.mul(1n+Nat.add(B.bval(t), B.bval(t)), 1n+Nat.add(B.bval(t), B.bval(t))) : Nat}
      %rw B.badd_v(t, bsq(t))
      %rw B.badd_v(t, bsq(t))
      %rw B.badd_v(t, bsq(t))
      %rw B.badd_v(t, bsq(t))
      %rw bsq_v(t)
      %rw bsq_v(t)
      %rw bsq_v(t)
      %rw bsq_v(t)
      q1_s(B.bval(t))

def s0_s(+v: Nat) -> {v == Nat.add(0n, Nat.mul(v, 1n)) : Nat}:
  %norm

def sz_s(+k: Nat) -> {0n == Nat.add(0n, Nat.mul(0n, k)) : Nat}:
  %norm

def s2_s(+l: Nat, +h: Nat, +k: Nat) -> {Nat.add(Nat.add(l, Nat.mul(h, k)), Nat.add(l, Nat.mul(h, k))) == Nat.add(Nat.add(l, l), Nat.mul(h, Nat.add(k, k))) : Nat}:
  %norm

def s3_s(+l: Nat, +h: Nat, +k: Nat) -> {1n+Nat.add(Nat.add(l, Nat.mul(h, k)), Nat.add(l, Nat.mul(h, k))) == Nat.add(1n+Nat.add(l, l), Nat.mul(h, Nat.add(k, k))) : Nat}:
  %norm

# a == lo + hi 2^k
def split_v(k: Nat, a: B.Bn) -> {B.bval(a) == Nat.add(B.bval(flo(k, a)), Nat.mul(B.bval(fhi(k, a)), B.bval(fshl(k, B.B1{B.BZ{}})))) : Nat}:
  match k a:
    case 0n +x:
      s0_s(B.bval(x))
    case 1n+ +j B.BZ{}:
      sz_s(B.bval(fshl(1n+j, B.B1{B.BZ{}})))
    case 1n+ +j B.B0{+t}:
      %goal {Nat.add(B.bval(t), B.bval(t)) == Nat.add(Nat.add(B.bval(flo(j, t)), B.bval(flo(j, t))), Nat.mul(B.bval(fhi(j, t)), Nat.add(B.bval(fshl(j, B.B1{B.BZ{}})), B.bval(fshl(j, B.B1{B.BZ{}}))))) : Nat}
      %rw split_v(j, t)
      %rw split_v(j, t)
      s2_s(B.bval(flo(j, t)), B.bval(fhi(j, t)), B.bval(fshl(j, B.B1{B.BZ{}})))
    case 1n+ +j B.B1{+t}:
      %goal {1n+Nat.add(B.bval(t), B.bval(t)) == Nat.add(1n+Nat.add(B.bval(flo(j, t)), B.bval(flo(j, t))), Nat.mul(B.bval(fhi(j, t)), Nat.add(B.bval(fshl(j, B.B1{B.BZ{}})), B.bval(fshl(j, B.B1{B.BZ{}}))))) : Nat}
      %rw split_v(j, t)
      %rw split_v(j, t)
      s3_s(B.bval(flo(j, t)), B.bval(fhi(j, t)), B.bval(fshl(j, B.B1{B.BZ{}})))

def fs_s(+l: Nat, +h: Nat, +c: Nat, +m: Nat) -> {Nat.add(l, Nat.mul(h, Nat.add(m, c))) == Nat.add(Nat.mul(h, m), Nat.add(l, Nat.mul(c, h))) : Nat}:
  %norm

# a fold keeps the value modulo m = 1 + mp, when 2^k == m + c
def fold_v(+mp: Nat, +k: Nat, +c: B.Bn, +t: B.Bn, +hm: {B.bval(fshl(k, B.B1{B.BZ{}})) == Nat.add(1n+mp, B.bval(c)) : Nat}) -> {Nat.mod(B.bval(fold(k, c, t)), 1n+mp) == Nat.mod(B.bval(t), 1n+mp) : Nat}:
  %goal {Nat.mod(B.bval(B.badd(flo(k, t), B.bmul(c, fhi(k, t)))), 1n+mp) == Nat.mod(B.bval(t), 1n+mp) : Nat}
  %rw B.badd_v(flo(k, t), B.bmul(c, fhi(k, t)))
  %rw B.bmul_v(c, fhi(k, t))
  %rw split_v(k, t)
  %rwh hm : {B.bval(fshl(k, B.B1{B.BZ{}})) == Nat.add(1n+mp, B.bval(c)) : Nat}
  %rw fs_s(B.bval(flo(k, t)), B.bval(fhi(k, t)), B.bval(c), 1n+mp)
  %rw NR.absorb(mp, B.bval(fhi(k, t)), Nat.add(B.bval(flo(k, t)), Nat.mul(B.bval(c), B.bval(fhi(k, t)))))
  %close

def fred_v(+mp: Nat, +k: Nat, +c: B.Bn, +t: B.Bn, +hm: {B.bval(fshl(k, B.B1{B.BZ{}})) == Nat.add(1n+mp, B.bval(c)) : Nat}) -> {Nat.mod(B.bval(fred(k, c, t)), 1n+mp) == Nat.mod(B.bval(t), 1n+mp) : Nat}:
  Equal.trans(Nat, Nat.mod(B.bval(fold(k, c, fold(k, c, t))), 1n+mp), Nat.mod(B.bval(fold(k, c, t)), 1n+mp), Nat.mod(B.bval(t), 1n+mp), fold_v(mp, k, c, fold(k, c, t), hm), fold_v(mp, k, c, t, hm))

def sq_c(+mp: Nat, +x: Nat, +w: Nat, +hx: {Nat.mod(x, 1n+mp) == Nat.mod(w, 1n+mp) : Nat}) -> {Nat.mod(Nat.mul(x, x), 1n+mp) == Nat.mod(Nat.mul(w, w), 1n+mp) : Nat}:
  Equal.trans(Nat, Nat.mod(Nat.mul(x, x), 1n+mp), Nat.mod(Nat.mul(w, x), 1n+mp), Nat.mod(Nat.mul(w, w), 1n+mp), Z.cg_mul_l(mp, x, w, x, hx), Z.cg_mul_r(mp, w, x, w, hx))

def e0(+mp: Nat, +x: B.Bn, +w: Nat, +hx: {Nat.mod(B.bval(x), 1n+mp) == Nat.mod(w, 1n+mp) : Nat}) -> {Nat.mod(B.bval(bsq(x)), 1n+mp) == Nat.mod(Nat.mul(w, w), 1n+mp) : Nat}:
  %rw bsq_v(x)
  sq_c(mp, B.bval(x), w, hx)

def e1(+mp: Nat, +a: B.Bn, +x: B.Bn, +w: Nat, +hx: {Nat.mod(B.bval(x), 1n+mp) == Nat.mod(w, 1n+mp) : Nat}) -> {Nat.mod(B.bval(B.bmul(a, bsq(x))), 1n+mp) == Nat.mod(Nat.mul(B.bval(a), Nat.mul(w, w)), 1n+mp) : Nat}:
  %rw B.bmul_v(a, bsq(x))
  %rw bsq_v(x)
  Z.cg_mul_r(mp, B.bval(a), Nat.mul(B.bval(x), B.bval(x)), Nat.mul(w, w), sq_c(mp, B.bval(x), w, hx))

# fexp is a^e modulo m = 1 + mp, when 2^k == m + c
def fexp_v(e: B.Bn, +a: B.Bn, +k: Nat, +c: B.Bn, +mp: Nat, +hm: {B.bval(fshl(k, B.B1{B.BZ{}})) == Nat.add(1n+mp, B.bval(c)) : Nat}) -> {Nat.mod(B.bval(fexp(e, a, k, c)), 1n+mp) == Nat.mod(Nat.pow(B.bval(a), B.bval(e)), 1n+mp) : Nat}:
  match e:
    case B.BZ{}:
      {==}
    case B.B0{+t}:
      %goal {Nat.mod(B.bval(fred(k, c, bsq(fexp(t, a, k, c)))), 1n+mp) == Nat.mod(Nat.pow(B.bval(a), Nat.add(B.bval(t), B.bval(t))), 1n+mp) : Nat}
      %rw NR.pow_add(B.bval(a), B.bval(t), B.bval(t))
      Equal.trans(Nat, Nat.mod(B.bval(fred(k, c, bsq(fexp(t, a, k, c)))), 1n+mp), Nat.mod(B.bval(bsq(fexp(t, a, k, c))), 1n+mp), Nat.mod(Nat.mul(Nat.pow(B.bval(a), B.bval(t)), Nat.pow(B.bval(a), B.bval(t))), 1n+mp), fred_v(mp, k, c, bsq(fexp(t, a, k, c)), hm), e0(mp, fexp(t, a, k, c), Nat.pow(B.bval(a), B.bval(t)), fexp_v(t, a, k, c, mp, hm)))
    case B.B1{+t}:
      %goal {Nat.mod(B.bval(fred(k, c, B.bmul(a, bsq(fexp(t, a, k, c))))), 1n+mp) == Nat.mod(Nat.mul(B.bval(a), Nat.pow(B.bval(a), Nat.add(B.bval(t), B.bval(t)))), 1n+mp) : Nat}
      %rw NR.pow_add(B.bval(a), B.bval(t), B.bval(t))
      Equal.trans(Nat, Nat.mod(B.bval(fred(k, c, B.bmul(a, bsq(fexp(t, a, k, c))))), 1n+mp), Nat.mod(B.bval(B.bmul(a, bsq(fexp(t, a, k, c)))), 1n+mp), Nat.mod(Nat.mul(B.bval(a), Nat.mul(Nat.pow(B.bval(a), B.bval(t)), Nat.pow(B.bval(a), B.bval(t)))), 1n+mp), fred_v(mp, k, c, B.bmul(a, bsq(fexp(t, a, k, c))), hm), e1(mp, a, fexp(t, a, k, c), Nat.pow(B.bval(a), B.bval(t)), fexp_v(t, a, k, c, mp, hm)))

# ---- powers and congruences ----

# a^(f e) == (a^e)^f
def pow_mul(+a: Nat, +e: Nat, f: Nat) -> {Nat.pow(a, Nat.mul(f, e)) == Nat.pow(Nat.pow(a, e), f) : Nat}:
  match f:
    case 0n:
      {==}
    case 1n+ +t:
      %goal {Nat.pow(a, Nat.add(e, Nat.mul(t, e))) == Nat.mul(Nat.pow(a, e), Nat.pow(Nat.pow(a, e), t)) : Nat}
      %rw NR.pow_add(a, e, Nat.mul(t, e))
      %rw pow_mul(a, e, t)
      %close

def pow_cg(+mp: Nat, +x: Nat, +w: Nat, k: Nat, +h: {Nat.mod(x, 1n+mp) == Nat.mod(w, 1n+mp) : Nat}) -> {Nat.mod(Nat.pow(x, k), 1n+mp) == Nat.mod(Nat.pow(w, k), 1n+mp) : Nat}:
  match k:
    case 0n:
      {==}
    case 1n+ +j:
      Equal.trans(Nat, Nat.mod(Nat.mul(x, Nat.pow(x, j)), 1n+mp), Nat.mod(Nat.mul(w, Nat.pow(x, j)), 1n+mp), Nat.mod(Nat.mul(w, Nat.pow(w, j)), 1n+mp), Z.cg_mul_l(mp, x, w, Nat.pow(x, j), h), Z.cg_mul_r(mp, w, Nat.pow(x, j), Nat.pow(w, j), pow_cg(mp, x, w, j, h)))

# y == x^f and x == a^e give y == a^(f e)
def rebase(+mp: Nat, +a: Nat, +e: Nat, +x: Nat, +f: Nat, +y: Nat, +hx: {Nat.mod(x, 1n+mp) == Nat.mod(Nat.pow(a, e), 1n+mp) : Nat}, +hy: {Nat.mod(y, 1n+mp) == Nat.mod(Nat.pow(x, f), 1n+mp) : Nat}) -> {Nat.mod(y, 1n+mp) == Nat.mod(Nat.pow(a, Nat.mul(f, e)), 1n+mp) : Nat}:
  %rw pow_mul(a, e, f)
  Equal.trans(Nat, Nat.mod(y, 1n+mp), Nat.mod(Nat.pow(x, f), 1n+mp), Nat.mod(Nat.pow(Nat.pow(a, e), f), 1n+mp), hy, pow_cg(mp, x, Nat.pow(a, e), f, hx))

# x == a^e, y == a^f and x y == q m + z give z == a^(e + f)
def mulc(+mp: Nat, +a: Nat, +e: Nat, +f: Nat, +x: Nat, +y: Nat, +q: Nat, +z: Nat, +hx: {Nat.mod(x, 1n+mp) == Nat.mod(Nat.pow(a, e), 1n+mp) : Nat}, +hy: {Nat.mod(y, 1n+mp) == Nat.mod(Nat.pow(a, f), 1n+mp) : Nat}, +hs: {Nat.mul(x, y) == Nat.add(Nat.mul(q, 1n+mp), z) : Nat}) -> {Nat.mod(z, 1n+mp) == Nat.mod(Nat.pow(a, Nat.add(e, f)), 1n+mp) : Nat}:
  %rw NR.pow_add(a, e, f)
  %rw <- NR.absorb(mp, q, z)
  %rwh Equal.sym(Nat, Nat.mul(x, y), Nat.add(Nat.mul(q, 1n+mp), z), hs) : {Nat.add(Nat.mul(q, 1n+mp), z) == Nat.mul(x, y) : Nat}
  Equal.trans(Nat, Nat.mod(Nat.mul(x, y), 1n+mp), Nat.mod(Nat.mul(Nat.pow(a, e), y), 1n+mp), Nat.mod(Nat.mul(Nat.pow(a, e), Nat.pow(a, f)), 1n+mp), Z.cg_mul_l(mp, x, Nat.pow(a, e), y, hx), Z.cg_mul_r(mp, Nat.pow(a, e), y, Nat.pow(a, f), hy))
