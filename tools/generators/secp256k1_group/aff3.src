# The affine group law of secp256k1 (spec/crypto/secp256k1/affine.bend), from
# the projective one through GA.of_proj / GA.to_proj: the chord-and-tangent
# addition is closed on the points of the curve, commutative, associative,
# with identity the point at infinity and inverse (x, -y). Modulus
# m = 1 + mp with the field facts of glaw1.bend. GA.valid: on the curve with
# coordinates below m.

# ---- an affine point as a projective point of the group ----

def lift_onc(+mp: Nat, +x: Nat, +y: Nat, +hc: {CS.on_curve(1n+mp, x, y) == True{} : Bool}) -> F.OnC(mp, x, y, 1n):
  I.both_red(mp, Nat.mul(FS.mmul(1n+mp, x, x), x), Nat.sub(Nat.add(FS.mmul(1n+mp, FS.mmul(1n+mp, y, y), 1n), 1n+mp), Nat.mod(FS.mmul(1n+mp, 7n, FS.mmul(1n+mp, FS.mmul(1n+mp, 1n, 1n), 1n)), 1n+mp)), F.msub_z(mp, FS.mmul(1n+mp, FS.mmul(1n+mp, x, x), x), FS.msub(1n+mp, FS.mmul(1n+mp, FS.mmul(1n+mp, y, y), 1n), FS.mmul(1n+mp, 7n, FS.mmul(1n+mp, FS.mmul(1n+mp, 1n, 1n), 1n))), K9.on_a2p(mp, x, y, Equal.sym(Nat, FS.mmul(1n+mp, y, y), FS.madd(1n+mp, FS.mmul(1n+mp, FS.mmul(1n+mp, x, x), x), 7n), N.eq_from_is_eq(FS.mmul(1n+mp, y, y), FS.madd(1n+mp, FS.mmul(1n+mp, FS.mmul(1n+mp, x, x), x), 7n), hc)))))

def lift_nz_c(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +x: Nat, +y: Nat, +hc: {CS.on_curve(1n+mp, x, y) == True{} : Bool}, c: Bool, +hy: {Nat.is_eq(Nat.mod(y, 1n+mp), 0n) == c : Bool}) -> F.NZ(mp, y):
  match c:
    case False{}:
      hy
    case True{}:
      Empty.absurd(F.NZ(mp, y), F.nz_absurd(mp, 1n, AF.one_nz(mp, h21), NC.nc_hom(mp, hp, h3, hnc, h21, x, 1n, F.z_red(mp, Nat.add(FS.mmul(1n+mp, FS.mmul(1n+mp, x, x), x), FS.mmul(1n+mp, 7n, FS.mmul(1n+mp, FS.mmul(1n+mp, 1n, 1n), 1n))), K9.nz_y(mp, x, y, Equal.sym(Nat, FS.mmul(1n+mp, y, y), FS.madd(1n+mp, FS.mmul(1n+mp, FS.mmul(1n+mp, x, x), x), 7n), N.eq_from_is_eq(FS.mmul(1n+mp, y, y), FS.madd(1n+mp, FS.mmul(1n+mp, FS.mmul(1n+mp, x, x), x), 7n), hc)), F.z_mul_l(mp, y, y, N.eq_from_is_eq(Nat.mod(y, 1n+mp), 0n, hy)))))))

# a point of the affine curve has y != 0 (-7 is not a cube)
def lift_nz(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +x: Nat, +y: Nat, +hc: {CS.on_curve(1n+mp, x, y) == True{} : Bool}) -> F.NZ(mp, y):
  lift_nz_c(mp, hp, h3, hnc, h21, x, y, hc, Nat.is_eq(Nat.mod(y, 1n+mp), 0n), {==})

def lift_v(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, a: GA.APoint, +va: {GA.valid(1n+mp, a) == True{} : Bool}) -> {GS.valid(1n+mp, GA.to_proj(a)) == True{} : Bool}:
  match a:
    case GA.AInf{}:
      G2.v_inf(mp, h21)
    case GA.APt{+x, +y}:
      +hc = Lg.and_left(CS.on_curve(1n+mp, x, y), Bool.and(Nat.is_lt(x, 1n+mp), Nat.is_lt(y, 1n+mp)), va)
      G1.v_pack(mp, x, y, 1n, lift_onc(mp, x, y, hc), lift_nz(mp, hp, h3, hnc, h21, x, y, hc))

def one_inv(+mp: Nat, +hp: PM.Prime(1n+mp), +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}) -> {Nat.mod(FS.minv(1n+mp, 1n), 1n+mp) == 1n : Nat}:
  Equal.trans(Nat, Nat.mod(FS.minv(1n+mp, 1n), 1n+mp), Nat.mod(Nat.mul(1n, FS.minv(1n+mp, 1n)), 1n+mp), 1n, Equal.cong(Nat, Nat, k => Nat.mod(k, 1n+mp), FS.minv(1n+mp, 1n), Nat.mul(1n, FS.minv(1n+mp, 1n)), Equal.sym(Nat, Nat.mul(1n, FS.minv(1n+mp, 1n)), FS.minv(1n+mp, 1n), SR.one_mul(FS.minv(1n+mp, 1n)))), AF.inv_ok(mp, hp, 1n, AF.one_nz(mp, h21)))

def div1(+mp: Nat, +hp: PM.Prime(1n+mp), +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +x: Nat) -> {FS.mmul(1n+mp, x, FS.minv(1n+mp, 1n)) == Nat.mod(x, 1n+mp) : Nat}:
  Equal.trans(Nat, Nat.mod(Nat.mul(x, FS.minv(1n+mp, 1n)), 1n+mp), Nat.mod(Nat.mul(x, Nat.mod(FS.minv(1n+mp, 1n), 1n+mp)), 1n+mp), Nat.mod(x, 1n+mp), Equal.sym(Nat, Nat.mod(Nat.mul(x, Nat.mod(FS.minv(1n+mp, 1n), 1n+mp)), 1n+mp), Nat.mod(Nat.mul(x, FS.minv(1n+mp, 1n)), 1n+mp), NR.mod_mul_r(mp, x, FS.minv(1n+mp, 1n))),
    Equal.trans(Nat, Nat.mod(Nat.mul(x, Nat.mod(FS.minv(1n+mp, 1n), 1n+mp)), 1n+mp), Nat.mod(Nat.mul(x, 1n), 1n+mp), Nat.mod(x, 1n+mp), Equal.cong(Nat, Nat, k => Nat.mod(Nat.mul(x, k), 1n+mp), Nat.mod(FS.minv(1n+mp, 1n), 1n+mp), 1n, one_inv(mp, hp, h21)), Equal.cong(Nat, Nat, k => Nat.mod(k, 1n+mp), Nat.mul(x, 1n), x, NA.mul_one(x))))

# the affine point of (x : y : 1)
def of1(+mp: Nat, +hp: PM.Prime(1n+mp), +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +x: Nat, +y: Nat) -> {GA.of_proj(1n+mp, CS.SPoint{x, y, 1n}) == GA.APt{Nat.mod(x, 1n+mp), Nat.mod(y, 1n+mp)} : GA.APoint}:
  %Equal.sym(Bool, Nat.is_eq(Nat.mod(1n, 1n+mp), 0n), False{}, AF.one_nz(mp, h21)) : {GA.of_sel(_, 1n+mp, x, y, FS.minv(1n+mp, 1n)) == GA.APt{Nat.mod(x, 1n+mp), Nat.mod(y, 1n+mp)} : GA.APoint}
  AF.apt_eq(FS.mmul(1n+mp, x, FS.minv(1n+mp, 1n)), FS.mmul(1n+mp, y, FS.minv(1n+mp, 1n)), Nat.mod(x, 1n+mp), Nat.mod(y, 1n+mp), div1(mp, hp, h21, x), div1(mp, hp, h21, y))

def lift_a(+mp: Nat, +hp: PM.Prime(1n+mp), +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, a: GA.APoint, +va: {GA.valid(1n+mp, a) == True{} : Bool}) -> {GA.of_proj(1n+mp, GA.to_proj(a)) == a : GA.APoint}:
  match a:
    case GA.AInf{}:
      {==}
    case GA.APt{+x, +y}:
      +hl = Lg.and_right(CS.on_curve(1n+mp, x, y), Bool.and(Nat.is_lt(x, 1n+mp), Nat.is_lt(y, 1n+mp)), va)
      Equal.trans(GA.APoint, GA.of_proj(1n+mp, CS.SPoint{x, y, 1n}), GA.APt{Nat.mod(x, 1n+mp), Nat.mod(y, 1n+mp)}, GA.APt{x, y}, of1(mp, hp, h21, x, y),
        AF.apt_eq(Nat.mod(x, 1n+mp), Nat.mod(y, 1n+mp), x, y, NR.mod_of(0n, mp, x, Lg.and_left(Nat.is_lt(x, 1n+mp), Nat.is_lt(y, 1n+mp), hl)), NR.mod_of(0n, mp, y, Lg.and_right(Nat.is_lt(x, 1n+mp), Nat.is_lt(y, 1n+mp), hl))))

def aff_val_c(+mp: Nat, +hp: PM.Prime(1n+mp), +x: Nat, +y: Nat, +z: Nat, +c: F.OnC(mp, x, y, z), +n: F.NZ(mp, y), i: Bool, +hi: {Nat.is_eq(Nat.mod(z, 1n+mp), 0n) == i : Bool}) -> {GA.valid(1n+mp, GA.of_sel(i, 1n+mp, x, y, FS.minv(1n+mp, z))) == True{} : Bool}:
  match i:
    case True{}:
      {==}
    case False{}:
      Lg.and_intro(CS.on_curve(1n+mp, FS.mmul(1n+mp, x, FS.minv(1n+mp, z)), FS.mmul(1n+mp, y, FS.minv(1n+mp, z))), Bool.and(Nat.is_lt(FS.mmul(1n+mp, x, FS.minv(1n+mp, z)), 1n+mp), Nat.is_lt(FS.mmul(1n+mp, y, FS.minv(1n+mp, z)), 1n+mp)),
        G1.is_eq_of(FS.mmul(1n+mp, FS.mmul(1n+mp, y, FS.minv(1n+mp, z)), FS.mmul(1n+mp, y, FS.minv(1n+mp, z))), FS.madd(1n+mp, FS.mmul(1n+mp, FS.mmul(1n+mp, FS.mmul(1n+mp, x, FS.minv(1n+mp, z)), FS.mmul(1n+mp, x, FS.minv(1n+mp, z))), FS.mmul(1n+mp, x, FS.minv(1n+mp, z))), 7n), I.both_red(mp, Nat.mul(FS.mmul(1n+mp, y, FS.minv(1n+mp, z)), FS.mmul(1n+mp, y, FS.minv(1n+mp, z))), Nat.add(FS.mmul(1n+mp, FS.mmul(1n+mp, FS.mmul(1n+mp, x, FS.minv(1n+mp, z)), FS.mmul(1n+mp, x, FS.minv(1n+mp, z))), FS.mmul(1n+mp, x, FS.minv(1n+mp, z))), 7n), F.msub_z(mp, FS.mmul(1n+mp, FS.mmul(1n+mp, y, FS.minv(1n+mp, z)), FS.mmul(1n+mp, y, FS.minv(1n+mp, z))), FS.madd(1n+mp, FS.mmul(1n+mp, FS.mmul(1n+mp, FS.mmul(1n+mp, x, FS.minv(1n+mp, z)), FS.mmul(1n+mp, x, FS.minv(1n+mp, z))), FS.mmul(1n+mp, x, FS.minv(1n+mp, z))), 7n), K9.on_p2a(mp, FS.mmul(1n+mp, x, FS.minv(1n+mp, z)), FS.mmul(1n+mp, y, FS.minv(1n+mp, z)), Equal.sym(Nat, FS.mmul(1n+mp, FS.mmul(1n+mp, FS.mmul(1n+mp, x, FS.minv(1n+mp, z)), FS.mmul(1n+mp, x, FS.minv(1n+mp, z))), FS.mmul(1n+mp, x, FS.minv(1n+mp, z))), FS.msub(1n+mp, FS.mmul(1n+mp, FS.mmul(1n+mp, FS.mmul(1n+mp, y, FS.minv(1n+mp, z)), FS.mmul(1n+mp, y, FS.minv(1n+mp, z))), 1n), FS.mmul(1n+mp, 7n, FS.mmul(1n+mp, FS.mmul(1n+mp, 1n, 1n), 1n))), G1.v_onc(mp, FS.mmul(1n+mp, x, FS.minv(1n+mp, z)), FS.mmul(1n+mp, y, FS.minv(1n+mp, z)), 1n, A1.nrm_v(mp, hp, x, y, z, c, n, hi))))))),
        Lg.and_intro(Nat.is_lt(FS.mmul(1n+mp, x, FS.minv(1n+mp, z)), 1n+mp), Nat.is_lt(FS.mmul(1n+mp, y, FS.minv(1n+mp, z)), 1n+mp), NR.dm_lt(mp, Nat.mul(x, FS.minv(1n+mp, z))), NR.dm_lt(mp, Nat.mul(y, FS.minv(1n+mp, z)))))

# the affine point of a point of the group is on the curve, reduced
def aff_val(+mp: Nat, +hp: PM.Prime(1n+mp), s: CS.SPoint, +vs: {GS.valid(1n+mp, s) == True{} : Bool}) -> {GA.valid(1n+mp, GA.of_proj(1n+mp, s)) == True{} : Bool}:
  match s:
    case CS.SPoint{+x, +y, +z}:
      aff_val_c(mp, hp, x, y, z, G1.v_onc(mp, x, y, z, vs), G1.v_nz(mp, x, y, z, vs), Nat.is_eq(Nat.mod(z, 1n+mp), 0n), {==})

# ---- the affine addition through the projective one ----

def add_lift(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +a: GA.APoint, +b: GA.APoint, +va: {GA.valid(1n+mp, a) == True{} : Bool}, +vb: {GA.valid(1n+mp, b) == True{} : Bool}) -> {GA.add(1n+mp, a, b) == GA.of_proj(1n+mp, CS.padd(1n+mp, GA.to_proj(a), GA.to_proj(b))) : GA.APoint}:
  %lift_a(mp, hp, h21, a, va) : {GA.add(1n+mp, _, b) == GA.of_proj(1n+mp, CS.padd(1n+mp, GA.to_proj(a), GA.to_proj(b))) : GA.APoint}
  %lift_a(mp, hp, h21, b, vb) : {GA.add(1n+mp, GA.of_proj(1n+mp, GA.to_proj(a)), _) == GA.of_proj(1n+mp, CS.padd(1n+mp, GA.to_proj(a), GA.to_proj(b))) : GA.APoint}
  Equal.sym(GA.APoint, GA.of_proj(1n+mp, CS.padd(1n+mp, GA.to_proj(a), GA.to_proj(b))), GA.add(1n+mp, GA.of_proj(1n+mp, GA.to_proj(a)), GA.of_proj(1n+mp, GA.to_proj(b))), A2.corr(mp, hp, h3, hnc, h21, GA.to_proj(a), GA.to_proj(b), lift_v(mp, hp, h3, hnc, h21, a, va), lift_v(mp, hp, h3, hnc, h21, b, vb)))

def add_r(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +s: CS.SPoint, +c: GA.APoint, +vs: {GS.valid(1n+mp, s) == True{} : Bool}, +vc: {GA.valid(1n+mp, c) == True{} : Bool}) -> {GA.add(1n+mp, GA.of_proj(1n+mp, s), c) == GA.of_proj(1n+mp, CS.padd(1n+mp, s, GA.to_proj(c))) : GA.APoint}:
  %lift_a(mp, hp, h21, c, vc) : {GA.add(1n+mp, GA.of_proj(1n+mp, s), _) == GA.of_proj(1n+mp, CS.padd(1n+mp, s, GA.to_proj(c))) : GA.APoint}
  Equal.sym(GA.APoint, GA.of_proj(1n+mp, CS.padd(1n+mp, s, GA.to_proj(c))), GA.add(1n+mp, GA.of_proj(1n+mp, s), GA.of_proj(1n+mp, GA.to_proj(c))), A2.corr(mp, hp, h3, hnc, h21, s, GA.to_proj(c), vs, lift_v(mp, hp, h3, hnc, h21, c, vc)))

def add_l(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +a: GA.APoint, +s: CS.SPoint, +va: {GA.valid(1n+mp, a) == True{} : Bool}, +vs: {GS.valid(1n+mp, s) == True{} : Bool}) -> {GA.add(1n+mp, a, GA.of_proj(1n+mp, s)) == GA.of_proj(1n+mp, CS.padd(1n+mp, GA.to_proj(a), s)) : GA.APoint}:
  %lift_a(mp, hp, h21, a, va) : {GA.add(1n+mp, _, GA.of_proj(1n+mp, s)) == GA.of_proj(1n+mp, CS.padd(1n+mp, GA.to_proj(a), s)) : GA.APoint}
  Equal.sym(GA.APoint, GA.of_proj(1n+mp, CS.padd(1n+mp, GA.to_proj(a), s)), GA.add(1n+mp, GA.of_proj(1n+mp, GA.to_proj(a)), GA.of_proj(1n+mp, s)), A2.corr(mp, hp, h3, hnc, h21, GA.to_proj(a), s, lift_v(mp, hp, h3, hnc, h21, a, va), vs))

# ---- the group law ----

# closure
def a_closed(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +a: GA.APoint, +b: GA.APoint, +va: {GA.valid(1n+mp, a) == True{} : Bool}, +vb: {GA.valid(1n+mp, b) == True{} : Bool}) -> {GA.valid(1n+mp, GA.add(1n+mp, a, b)) == True{} : Bool}:
  %Equal.sym(GA.APoint, GA.add(1n+mp, a, b), GA.of_proj(1n+mp, CS.padd(1n+mp, GA.to_proj(a), GA.to_proj(b))), add_lift(mp, hp, h3, hnc, h21, a, b, va, vb)) : {GA.valid(1n+mp, _) == True{} : Bool}
  aff_val(mp, hp, CS.padd(1n+mp, GA.to_proj(a), GA.to_proj(b)), G1.v_add(mp, hp, h3, hnc, h21, GA.to_proj(a), GA.to_proj(b), lift_v(mp, hp, h3, hnc, h21, a, va), lift_v(mp, hp, h3, hnc, h21, b, vb)))

# commutativity
def a_comm(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +a: GA.APoint, +b: GA.APoint, +va: {GA.valid(1n+mp, a) == True{} : Bool}, +vb: {GA.valid(1n+mp, b) == True{} : Bool}) -> {GA.add(1n+mp, a, b) == GA.add(1n+mp, b, a) : GA.APoint}:
  Equal.trans(GA.APoint, GA.add(1n+mp, a, b), GA.of_proj(1n+mp, CS.padd(1n+mp, GA.to_proj(a), GA.to_proj(b))), GA.add(1n+mp, b, a), add_lift(mp, hp, h3, hnc, h21, a, b, va, vb),
    Equal.trans(GA.APoint, GA.of_proj(1n+mp, CS.padd(1n+mp, GA.to_proj(a), GA.to_proj(b))), GA.of_proj(1n+mp, CS.padd(1n+mp, GA.to_proj(b), GA.to_proj(a))), GA.add(1n+mp, b, a), Equal.cong(CS.SPoint, GA.APoint, t => GA.of_proj(1n+mp, t), CS.padd(1n+mp, GA.to_proj(a), GA.to_proj(b)), CS.padd(1n+mp, GA.to_proj(b), GA.to_proj(a)), G1.add_comm(mp, GA.to_proj(a), GA.to_proj(b))),
      Equal.sym(GA.APoint, GA.add(1n+mp, b, a), GA.of_proj(1n+mp, CS.padd(1n+mp, GA.to_proj(b), GA.to_proj(a))), add_lift(mp, hp, h3, hnc, h21, b, a, vb, va))))

# associativity
def a_assoc(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +a: GA.APoint, +b: GA.APoint, +c: GA.APoint, +va: {GA.valid(1n+mp, a) == True{} : Bool}, +vb: {GA.valid(1n+mp, b) == True{} : Bool}, +vc: {GA.valid(1n+mp, c) == True{} : Bool}) -> {GA.add(1n+mp, GA.add(1n+mp, a, b), c) == GA.add(1n+mp, a, GA.add(1n+mp, b, c)) : GA.APoint}:
  +wa = lift_v(mp, hp, h3, hnc, h21, a, va)
  +wb = lift_v(mp, hp, h3, hnc, h21, b, vb)
  +wc = lift_v(mp, hp, h3, hnc, h21, c, vc)
  +ws = G1.v_add(mp, hp, h3, hnc, h21, GA.to_proj(a), GA.to_proj(b), wa, wb)
  +wt = G1.v_add(mp, hp, h3, hnc, h21, GA.to_proj(b), GA.to_proj(c), wb, wc)
