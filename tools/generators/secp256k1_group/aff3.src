# identity
def a_unit_r(+p: Nat, a: GA.APoint) -> {GA.add(p, a, GA.AInf{}) == a : GA.APoint}:
  match a:
    case GA.AInf{}:
      {==}
    case GA.APt{x, y}:
      {==}

def a_unit_l(+p: Nat, +a: GA.APoint) -> {GA.add(p, GA.AInf{}, a) == a : GA.APoint}:
  {==}

def neg_of(+mp: Nat, +hp: PM.Prime(1n+mp), +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +x: Nat, +y: Nat, +hx: {Nat.is_lt(x, 1n+mp) == True{} : Bool}) -> {GA.of_proj(1n+mp, CS.SPoint{x, FS.msub(1n+mp, 0n, y), 1n}) == GA.APt{x, FS.msub(1n+mp, 0n, y)} : GA.APoint}:
  Equal.trans(GA.APoint, GA.of_proj(1n+mp, CS.SPoint{x, FS.msub(1n+mp, 0n, y), 1n}), GA.APt{Nat.mod(x, 1n+mp), Nat.mod(FS.msub(1n+mp, 0n, y), 1n+mp)}, GA.APt{x, FS.msub(1n+mp, 0n, y)}, of1(mp, hp, h21, x, FS.msub(1n+mp, 0n, y)),
    AF.apt_eq(Nat.mod(x, 1n+mp), Nat.mod(FS.msub(1n+mp, 0n, y), 1n+mp), x, FS.msub(1n+mp, 0n, y), NR.mod_of(0n, mp, x, hx), NR.mod_mod(mp, Nat.sub(Nat.add(0n, 1n+mp), Nat.mod(y, 1n+mp)))))

# inverse
def a_inv(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, a: GA.APoint, +va: {GA.valid(1n+mp, a) == True{} : Bool}) -> {GA.add(1n+mp, a, GA.neg(1n+mp, a)) == GA.AInf{} : GA.APoint}:
  match a:
    case GA.AInf{}:
      {==}
    case GA.APt{+x, +y}:
      +hl = Lg.and_right(CS.on_curve(1n+mp, x, y), Bool.and(Nat.is_lt(x, 1n+mp), Nat.is_lt(y, 1n+mp)), va)
      +wa = lift_v(mp, hp, h3, hnc, h21, GA.APt{x, y}, va)
      %lift_a(mp, hp, h21, GA.APt{x, y}, va) : {GA.add(1n+mp, _, GA.APt{x, FS.msub(1n+mp, 0n, y)}) == GA.AInf{} : GA.APoint}
      %neg_of(mp, hp, h21, x, y, Lg.and_left(Nat.is_lt(x, 1n+mp), Nat.is_lt(y, 1n+mp), hl)) : {GA.add(1n+mp, GA.of_proj(1n+mp, CS.SPoint{x, y, 1n}), _) == GA.AInf{} : GA.APoint}
      Equal.trans(GA.APoint, GA.add(1n+mp, GA.of_proj(1n+mp, CS.SPoint{x, y, 1n}), GA.of_proj(1n+mp, CS.SPoint{x, FS.msub(1n+mp, 0n, y), 1n})), GA.of_proj(1n+mp, CS.padd(1n+mp, CS.SPoint{x, y, 1n}, CS.SPoint{x, FS.msub(1n+mp, 0n, y), 1n})), GA.AInf{},
        Equal.sym(GA.APoint, GA.of_proj(1n+mp, CS.padd(1n+mp, CS.SPoint{x, y, 1n}, CS.SPoint{x, FS.msub(1n+mp, 0n, y), 1n})), GA.add(1n+mp, GA.of_proj(1n+mp, CS.SPoint{x, y, 1n}), GA.of_proj(1n+mp, CS.SPoint{x, FS.msub(1n+mp, 0n, y), 1n})), A2.corr(mp, hp, h3, hnc, h21, CS.SPoint{x, y, 1n}, CS.SPoint{x, FS.msub(1n+mp, 0n, y), 1n}, wa, G2.v_neg(mp, CS.SPoint{x, y, 1n}, wa))),
        A2.cinv(mp, x, y))

# -A is a point of the curve
def a_neg_valid(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, a: GA.APoint, +va: {GA.valid(1n+mp, a) == True{} : Bool}) -> {GA.valid(1n+mp, GA.neg(1n+mp, a)) == True{} : Bool}:
  match a:
    case GA.AInf{}:
      {==}
    case GA.APt{+x, +y}:
      +hl = Lg.and_right(CS.on_curve(1n+mp, x, y), Bool.and(Nat.is_lt(x, 1n+mp), Nat.is_lt(y, 1n+mp)), va)
      +wa = lift_v(mp, hp, h3, hnc, h21, GA.APt{x, y}, va)
      %neg_of(mp, hp, h21, x, y, Lg.and_left(Nat.is_lt(x, 1n+mp), Nat.is_lt(y, 1n+mp), hl)) : {GA.valid(1n+mp, _) == True{} : Bool}
      aff_val(mp, hp, CS.SPoint{x, FS.msub(1n+mp, 0n, y), 1n}, G2.v_neg(mp, CS.SPoint{x, y, 1n}, wa))
