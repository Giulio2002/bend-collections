import Base
import ../../../lib/lemmas/proofs/nat_algebra.bend as NA
import ../../../math/typed/width.bend as WW
import ../semiring.bend as SR
import ../../../lib/logic.bend as Lg
import ../../../lib/nat.bend as N
import ../../../math/natural/arith.bend as NR
import ./bn.bend as B
import ./zm.bend as Z

# Modular exponentiation certificates on the binary numbers of bn.bend.
#
# A power a^e mod m is not computed by division: the certificate lists, for
# every step of the left-to-right binary method (a squaring, or a squaring
# followed by a multiplication by the base), the quotient q (found outside,
# by tools/generators/secp256k1_group/gen_cert.py). run computes the
# remainder r as x x - q m with a subtraction that nothing is proved about,
# and verifies x x == q m + r (or a (x x) == q m + r) with the proved
# product, sum and equality of bn.bend; it answers Some{the last remainder}
# when every step verifies. run_v: then that remainder is a^eb (mod m), for
# every input. The literal lists are checked by {==}, one closed
# computation each.

type St is Data:
  Sq{q: B.Bn}
  SM{q: B.Bn}

def bdec(a: B.Bn) -> B.Bn:
  match a:
    case B.BZ{}:
      B.BZ{}
    case B.B0{t}:
      B.B1{bdec(t)}
    case B.B1{t}:
      B.B0{t}

# a - b for a >= b (used only to propose a remainder; not trusted)
def bsubu(a: B.Bn, b: B.Bn) -> B.Bn:
  match a b:
    case B.BZ{} y:
      B.BZ{}
    case B.B0{x} B.BZ{}:
      B.B0{x}
    case B.B1{x} B.BZ{}:
      B.B1{x}
    case B.B0{x} B.B0{y}:
      B.B0{bsubu(x, y)}
    case B.B1{x} B.B1{y}:
      B.B0{bsubu(x, y)}
    case B.B1{x} B.B0{y}:
      B.B1{bsubu(x, y)}
    case B.B0{x} B.B1{y}:
      B.B1{bdec(bsubu(x, y))}

# leading zeros removed
def bnz(t: B.Bn) -> B.Bn:
  match t:
    case B.BZ{}:
      B.BZ{}
    case B.B0{x}:
      B.B0{B.B0{x}}
    case B.B1{x}:
      B.B0{B.B1{x}}

def bnorm(a: B.Bn) -> B.Bn:
  match a:
    case B.BZ{}:
      B.BZ{}
    case B.B0{t}:
      bnz(bnorm(t))
    case B.B1{t}:
      B.B1{bnorm(t)}

# a remainder and whether it verifies
type PR is Data:
  PR{r: B.Bn, ok: Bool}

def prr(p: PR) -> B.Bn:
  match p:
    case PR{r, ok}:
      r

def prk(p: PR) -> Bool:
  match p:
    case PR{r, ok}:
      ok

# y == q m + r with r = y - q m
def pr3(+y: B.Bn, +qm: B.Bn, +r: B.Bn) -> PR:
  PR{r, B.beq(y, B.badd(qm, r))}

def pr2(+y: B.Bn, +qm: B.Bn) -> PR:
  pr3(y, qm, bnorm(bsubu(y, qm)))

def stp(s: St, +a: B.Bn, +m: B.Bn, +x: B.Bn) -> PR:
  match s:
    case Sq{q}:
      pr2(B.bmul(x, x), B.bmul(q, m))
    case SM{q}:
      pr2(B.bmul(a, B.bmul(x, x)), B.bmul(q, m))

def fin(ok: Bool, x: B.Bn) -> Maybe<&2, B.Bn>:
  match ok:
    case True{}:
      Some{x}
    case False{}:
      None{}

def run(steps: List<&2, St>, +a: B.Bn, +m: B.Bn, +x: B.Bn, ok: Bool) -> Maybe<&2, B.Bn>:
  match steps:
    case Nil{}:
      fin(ok, x)
    case s <> t:
      +p = stp(s, a, m, x)
      run(t, a, m, prr(p), Bool.and(ok, prk(p)))

def isok(r: Maybe<&2, B.Bn>) -> Bool:
  match r:
    case None{}:
      False{}
    case Some{x}:
      True{}

def val(r: Maybe<&2, B.Bn>) -> B.Bn:
  match r:
    case None{}:
      B.BZ{}
    case Some{x}:
      x

# every step verified and the last remainder is x2
def okv(r: Maybe<&2, B.Bn>, x2: B.Bn) -> Bool:
  match r:
    case None{}:
      False{}
    case Some{x}:
      B.beq(x, x2)

def eb1(s: St, e: B.Bn) -> B.Bn:
  match s:
    case Sq{q}:
      B.B0{e}
    case SM{q}:
      B.B1{e}

# the exponent reached from e
def eb(steps: List<&2, St>, e: B.Bn) -> B.Bn:
  match steps:
    case Nil{}:
      e
    case s <> t:
      eb(t, eb1(s, e))

def sq_cong(+mp: Nat, +x: Nat, +q: Nat, +r: Nat, +w: Nat, +hx: {Nat.mod(x, 1n+mp) == Nat.mod(w, 1n+mp) : Nat}, +hs: {Nat.mul(x, x) == Nat.add(Nat.mul(q, 1n+mp), r) : Nat}) -> {Nat.mod(r, 1n+mp) == Nat.mod(Nat.mul(w, w), 1n+mp) : Nat}:
  %rw <- NR.absorb(mp, q, r)
  %rwh Equal.sym(Nat, Nat.mul(x, x), Nat.add(Nat.mul(q, 1n+mp), r), hs) : {Nat.add(Nat.mul(q, 1n+mp), r) == Nat.mul(x, x) : Nat}
  Equal.trans(Nat, Nat.mod(Nat.mul(x, x), 1n+mp), Nat.mod(Nat.mul(w, x), 1n+mp), Nat.mod(Nat.mul(w, w), 1n+mp), Z.cg_mul_l(mp, x, w, x, hx), Z.cg_mul_r(mp, w, x, w, hx))

def sm_cong(+mp: Nat, +x: Nat, +a: Nat, +q: Nat, +r: Nat, +w: Nat, +hx: {Nat.mod(x, 1n+mp) == Nat.mod(w, 1n+mp) : Nat}, +hs: {Nat.mul(a, Nat.mul(x, x)) == Nat.add(Nat.mul(q, 1n+mp), r) : Nat}) -> {Nat.mod(r, 1n+mp) == Nat.mod(Nat.mul(a, Nat.mul(w, w)), 1n+mp) : Nat}:
  %rw <- NR.absorb(mp, q, r)
  %rwh Equal.sym(Nat, Nat.mul(a, Nat.mul(x, x)), Nat.add(Nat.mul(q, 1n+mp), r), hs) : {Nat.add(Nat.mul(q, 1n+mp), r) == Nat.mul(a, Nat.mul(x, x)) : Nat}
  Z.cg_mul_r(mp, a, Nat.mul(x, x), Nat.mul(w, w), Equal.trans(Nat, Nat.mod(Nat.mul(x, x), 1n+mp), Nat.mod(Nat.mul(w, x), 1n+mp), Nat.mod(Nat.mul(w, w), 1n+mp), Z.cg_mul_l(mp, x, w, x, hx), Z.cg_mul_r(mp, w, x, w, hx)))

# a verified remainder: y == q m + r on values, the modulus written 1 + mp
def st_eq(+y: B.Bn, +q: B.Bn, +m: B.Bn, +mp: Nat, +hm: {B.bval(m) == 1n+mp : Nat}, +h: {prk(pr2(y, B.bmul(q, m))) == True{} : Bool}) -> {B.bval(y) == Nat.add(Nat.mul(B.bval(q), 1n+mp), B.bval(prr(pr2(y, B.bmul(q, m))))) : Nat}:
  %rwh Equal.sym(Nat, B.bval(m), 1n+mp, hm) : {1n+mp == B.bval(m) : Nat}
  %rw <- B.bmul_v(q, m)
  %goal {B.bval(y) == Nat.add(B.bval(B.bmul(q, m)), B.bval(bnorm(bsubu(y, B.bmul(q, m))))) : Nat}
  %rw <- B.badd_v(B.bmul(q, m), bnorm(bsubu(y, B.bmul(q, m))))
  B.beq_v(y, B.badd(B.bmul(q, m), bnorm(bsubu(y, B.bmul(q, m)))), h)

# one verified step keeps x == a^e (mod m)
def stp_inv(s: St, +a: B.Bn, +m: B.Bn, +mp: Nat, +x: B.Bn, +e: B.Bn, +hm: {B.bval(m) == 1n+mp : Nat}, +hx: {Nat.mod(B.bval(x), 1n+mp) == Nat.mod(Nat.pow(B.bval(a), B.bval(e)), 1n+mp) : Nat}, +hp: {prk(stp(s, a, m, x)) == True{} : Bool}) -> {Nat.mod(B.bval(prr(stp(s, a, m, x))), 1n+mp) == Nat.mod(Nat.pow(B.bval(a), B.bval(eb1(s, e))), 1n+mp) : Nat}:
  match s:
    case Sq{+q}:
      +hs = Equal.trans(Nat, Nat.mul(B.bval(x), B.bval(x)), B.bval(B.bmul(x, x)), Nat.add(Nat.mul(B.bval(q), 1n+mp), B.bval(prr(pr2(B.bmul(x, x), B.bmul(q, m))))), Equal.sym(Nat, B.bval(B.bmul(x, x)), Nat.mul(B.bval(x), B.bval(x)), B.bmul_v(x, x)), st_eq(B.bmul(x, x), q, m, mp, hm, hp))
      %goal {Nat.mod(B.bval(prr(pr2(B.bmul(x, x), B.bmul(q, m)))), 1n+mp) == Nat.mod(Nat.pow(B.bval(a), Nat.add(B.bval(e), B.bval(e))), 1n+mp) : Nat}
      %rw NR.pow_add(B.bval(a), B.bval(e), B.bval(e))
      sq_cong(mp, B.bval(x), B.bval(q), B.bval(prr(pr2(B.bmul(x, x), B.bmul(q, m)))), Nat.pow(B.bval(a), B.bval(e)), hx, hs)
    case SM{+q}:
      +hs = Equal.trans(Nat, Nat.mul(B.bval(a), Nat.mul(B.bval(x), B.bval(x))), B.bval(B.bmul(a, B.bmul(x, x))), Nat.add(Nat.mul(B.bval(q), 1n+mp), B.bval(prr(pr2(B.bmul(a, B.bmul(x, x)), B.bmul(q, m))))), Equal.sym(Nat, B.bval(B.bmul(a, B.bmul(x, x))), Nat.mul(B.bval(a), Nat.mul(B.bval(x), B.bval(x))), Equal.trans(Nat, B.bval(B.bmul(a, B.bmul(x, x))), Nat.mul(B.bval(a), B.bval(B.bmul(x, x))), Nat.mul(B.bval(a), Nat.mul(B.bval(x), B.bval(x))), B.bmul_v(a, B.bmul(x, x)), Equal.cong(Nat, Nat, z => Nat.mul(B.bval(a), z), B.bval(B.bmul(x, x)), Nat.mul(B.bval(x), B.bval(x)), B.bmul_v(x, x)))), st_eq(B.bmul(a, B.bmul(x, x)), q, m, mp, hm, hp))
      %goal {Nat.mod(B.bval(prr(pr2(B.bmul(a, B.bmul(x, x)), B.bmul(q, m)))), 1n+mp) == Nat.mod(Nat.mul(B.bval(a), Nat.pow(B.bval(a), Nat.add(B.bval(e), B.bval(e)))), 1n+mp) : Nat}
      %rw NR.pow_add(B.bval(a), B.bval(e), B.bval(e))
      sm_cong(mp, B.bval(x), B.bval(a), B.bval(q), B.bval(prr(pr2(B.bmul(a, B.bmul(x, x)), B.bmul(q, m)))), Nat.pow(B.bval(a), B.bval(e)), hx, hs)

def fin_ok(ok: Bool, +x: B.Bn, +h: {isok(fin(ok, x)) == True{} : Bool}) -> {ok == True{} : Bool}:
  match ok:
    case True{}:
      {==}
    case False{}:
      Empty.absurd({False{} == True{} : Bool}, Lg.false_true(h))

# a run that answers Some started from ok == True
def run_ok(steps: List<&2, St>, +a: B.Bn, +m: B.Bn, +x: B.Bn, +ok: Bool, +h: {isok(run(steps, a, m, x, ok)) == True{} : Bool}) -> {ok == True{} : Bool}:
  match steps:
    case Nil{}:
      fin_ok(ok, x, h)
    case +s <> +t:
      Lg.and_left(ok, prk(stp(s, a, m, x)), run_ok(t, a, m, prr(stp(s, a, m, x)), Bool.and(ok, prk(stp(s, a, m, x))), h))

def fin_v(ok: Bool, +x: B.Bn, +w: Nat, +mp: Nat, +hx: {Nat.mod(B.bval(x), 1n+mp) == w : Nat}, +h: {isok(fin(ok, x)) == True{} : Bool}) -> {Nat.mod(B.bval(val(fin(ok, x))), 1n+mp) == w : Nat}:
  match ok:
    case True{}:
      hx
    case False{}:
      Empty.absurd({Nat.mod(B.bval(val(fin(False{}, x))), 1n+mp) == w : Nat}, Lg.false_true(h))

def run_v(steps: List<&2, St>, +a: B.Bn, +m: B.Bn, +mp: Nat, +x: B.Bn, +e: B.Bn, +ok: Bool, +hm: {B.bval(m) == 1n+mp : Nat}, +hx: {Nat.mod(B.bval(x), 1n+mp) == Nat.mod(Nat.pow(B.bval(a), B.bval(e)), 1n+mp) : Nat}, +hc: {isok(run(steps, a, m, x, ok)) == True{} : Bool}) -> {Nat.mod(B.bval(val(run(steps, a, m, x, ok))), 1n+mp) == Nat.mod(Nat.pow(B.bval(a), B.bval(eb(steps, e))), 1n+mp) : Nat}:
  match steps:
    case Nil{}:
      fin_v(ok, x, Nat.mod(Nat.pow(B.bval(a), B.bval(e)), 1n+mp), mp, hx, hc)
    case +s <> +t:
      +hk = run_ok(t, a, m, prr(stp(s, a, m, x)), Bool.and(ok, prk(stp(s, a, m, x))), hc)
      run_v(t, a, m, mp, prr(stp(s, a, m, x)), eb1(s, e), Bool.and(ok, prk(stp(s, a, m, x))), hm, stp_inv(s, a, m, mp, x, e, hm, hx, Lg.and_right(ok, prk(stp(s, a, m, x)), hk)), hc)

def okv_ok(r: Maybe<&2, B.Bn>, +x2: B.Bn, +h: {okv(r, x2) == True{} : Bool}) -> {isok(r) == True{} : Bool}:
  match r:
    case None{}:
      h
    case Some{x}:
      {==}

def okv_eq(r: Maybe<&2, B.Bn>, +x2: B.Bn, +h: {okv(r, x2) == True{} : Bool}) -> {B.beq(val(r), x2) == True{} : Bool}:
  match r:
    case None{}:
      Empty.absurd({B.beq(B.BZ{}, x2) == True{} : Bool}, Lg.false_true(h))
    case Some{x}:
      h

# ---- values that the checker never expands ----

# bval with the unit kept symbolic: for one == 1 it is bval, and on a
# literal it is a term stuck on `one` (no unary number is ever built)
def bvalo(+one: Nat, a: B.Bn) -> Nat:
  match a:
    case B.BZ{}:
      0n
    case B.B0{t}:
      Nat.double(bvalo(one, t))
    case B.B1{t}:
      Nat.add(one, Nat.double(bvalo(one, t)))

def bo(+one: Nat, +h1: {one == 1n : Nat}, a: B.Bn) -> {bvalo(one, a) == B.bval(a) : Nat}:
  match a:
    case B.BZ{}:
      {==}
    case B.B0{+t}:
      %goal {Nat.double(bvalo(one, t)) == Nat.add(B.bval(t), B.bval(t)) : Nat}
      %rw bo(one, h1, t)
      NA.double_self(B.bval(t))
    case B.B1{+t}:
      %goal {Nat.add(one, Nat.double(bvalo(one, t))) == 1n+Nat.add(B.bval(t), B.bval(t)) : Nat}
      %rw bo(one, h1, t)
      %rwh h1 : {one == 1n : Nat}
      %rw NA.double_self(B.bval(t))
      %close

def eq_o(+one: Nat, +h1: {one == 1n : Nat}, +a: B.Bn, +b: B.Bn, +h: {B.beq(a, b) == True{} : Bool}) -> {bvalo(one, a) == bvalo(one, b) : Nat}:
  %rw bo(one, h1, a)
  %rw bo(one, h1, b)
  B.beq_v(a, b, h)

def mul_o(+one: Nat, +h1: {one == 1n : Nat}, +a: B.Bn, +b: B.Bn) -> {bvalo(one, B.bmul(a, b)) == Nat.mul(bvalo(one, a), bvalo(one, b)) : Nat}:
  %rw bo(one, h1, B.bmul(a, b))
  %rw bo(one, h1, a)
  %rw bo(one, h1, b)
  B.bmul_v(a, b)

def add_o(+one: Nat, +h1: {one == 1n : Nat}, +a: B.Bn, +b: B.Bn) -> {bvalo(one, B.badd(a, b)) == Nat.add(bvalo(one, a), bvalo(one, b)) : Nat}:
  %rw bo(one, h1, B.badd(a, b))
  %rw bo(one, h1, a)
  %rw bo(one, h1, b)
  B.badd_v(a, b)

def inc_o(+one: Nat, +h1: {one == 1n : Nat}, +a: B.Bn) -> {bvalo(one, B.binc(a)) == 1n+bvalo(one, a) : Nat}:
  %rw bo(one, h1, B.binc(a))
  %rw bo(one, h1, a)
  B.binc_v(a)

def one_o(+one: Nat, +h1: {one == 1n : Nat}) -> {bvalo(one, B.B1{B.BZ{}}) == 1n : Nat}:
  bo(one, h1, B.B1{B.BZ{}})

# a small literal: its value as a unary number
def lit_o(+one: Nat, +h1: {one == 1n : Nat}, +a: B.Bn, +k: Nat, +h: {B.bval(a) == k : Nat}) -> {bvalo(one, a) == k : Nat}:
  Equal.trans(Nat, bvalo(one, a), B.bval(a), k, bo(one, h1, a), h)

# n == binc(n1): n == 1 + n1
def suc_o(+one: Nat, +h1: {one == 1n : Nat}, +n: B.Bn, +n1: B.Bn, +h: {B.beq(n, B.binc(n1)) == True{} : Bool}) -> {bvalo(one, n) == 1n+bvalo(one, n1) : Nat}:
  Equal.trans(Nat, bvalo(one, n), bvalo(one, B.binc(n1)), 1n+bvalo(one, n1), eq_o(one, h1, n, B.binc(n1), h), inc_o(one, h1, n1))

def suc2_o(+one: Nat, +h1: {one == 1n : Nat}, +n: B.Bn, +n2: B.Bn, +h: {B.beq(n, B.binc(B.binc(n2))) == True{} : Bool}) -> {bvalo(one, n) == 2n+bvalo(one, n2) : Nat}:
  Equal.trans(Nat, bvalo(one, n), 1n+bvalo(one, B.binc(n2)), 2n+bvalo(one, n2), suc_o(one, h1, n, B.binc(n2), h), Equal.cong(Nat, Nat, z => 1n+z, bvalo(one, B.binc(n2)), 1n+bvalo(one, n2), inc_o(one, h1, n2)))

# n == r + 1 + d: r < n
def lt_o(+one: Nat, +h1: {one == 1n : Nat}, +r: B.Bn, +n: B.Bn, +d: B.Bn, +h: {B.beq(n, B.badd(B.binc(r), d)) == True{} : Bool}) -> {Nat.is_lt(bvalo(one, r), bvalo(one, n)) == True{} : Bool}:
  %rw eq_o(one, h1, n, B.badd(B.binc(r), d), h)
  %rw add_o(one, h1, B.binc(r), d)
  %rw inc_o(one, h1, r)
  N.le_lt_succ(bvalo(one, r), Nat.add(bvalo(one, r), bvalo(one, d)), N.le_add_right(bvalo(one, r), bvalo(one, d)))

# ---- the equations of a Pocklington certificate (ntpock.bend) ----

def e2_o(+one: Nat, +h1: {one == 1n : Nat}, +n: B.Bn, +q: B.Bn, +m: B.Bn, +h: {B.beq(n, B.binc(B.bmul(q, m))) == True{} : Bool}) -> {bvalo(one, n) == Nat.add(Nat.mul(bvalo(one, q), bvalo(one, m)), 1n) : Nat}:
  %rw <- mul_o(one, h1, q, m)
  %rw NA.add_comm(bvalo(one, B.bmul(q, m)), 1n)
  suc_o(one, h1, n, B.bmul(q, m), h)

def e5_o(+one: Nat, +h1: {one == 1n : Nat}, +u: B.Bn, +b: B.Bn, +b1: B.Bn, +v: B.Bn, +n: B.Bn, +hb: {B.beq(b, B.binc(b1)) == True{} : Bool}, +h: {B.beq(B.bmul(u, b1), B.binc(B.bmul(v, n))) == True{} : Bool}) -> {Nat.mul(bvalo(one, u), Nat.sub(bvalo(one, b), 1n)) == Nat.add(Nat.mul(bvalo(one, v), bvalo(one, n)), 1n) : Nat}:
  %rw suc_o(one, h1, b, b1, hb)
  %goal {Nat.mul(bvalo(one, u), Nat.sub(bvalo(one, b1), 0n)) == Nat.add(Nat.mul(bvalo(one, v), bvalo(one, n)), 1n) : Nat}
  %rw N.sub_zero(bvalo(one, b1))
  %rw <- mul_o(one, h1, u, b1)
  %rw <- mul_o(one, h1, v, n)
  %rw NA.add_comm(bvalo(one, B.bmul(v, n)), 1n)
  suc_o(one, h1, B.bmul(u, b1), B.bmul(v, n), h)

# f == k q + (1 + r1) with 1 + r1 < q: q does not divide f
def e6_o(+one: Nat, +h1: {one == 1n : Nat}, +f: B.Bn, +ff: Nat, +hf: {bvalo(one, f) == ff : Nat}, +q: B.Bn, +k: B.Bn, +r1: B.Bn, +d: B.Bn, +h: {B.beq(f, B.badd(B.bmul(k, q), B.binc(r1))) == True{} : Bool}, +hl: {B.beq(q, B.badd(B.binc(B.binc(r1)), d)) == True{} : Bool}) -> {Nat.is_eq(Nat.mod(ff, bvalo(one, q)), 0n) == False{} : Bool}:
  +qp = Nat.add(bvalo(one, B.binc(r1)), bvalo(one, d))
  +hq = Equal.trans(Nat, bvalo(one, q), bvalo(one, B.badd(B.binc(B.binc(r1)), d)), 1n+qp, eq_o(one, h1, q, B.badd(B.binc(B.binc(r1)), d), hl), Equal.trans(Nat, bvalo(one, B.badd(B.binc(B.binc(r1)), d)), Nat.add(bvalo(one, B.binc(B.binc(r1))), bvalo(one, d)), 1n+qp, add_o(one, h1, B.binc(B.binc(r1)), d), Equal.cong(Nat, Nat, z => Nat.add(z, bvalo(one, d)), bvalo(one, B.binc(B.binc(r1))), 1n+bvalo(one, B.binc(r1)), inc_o(one, h1, B.binc(r1)))))
  %rwh Equal.sym(Nat, bvalo(one, f), ff, hf) : {ff == bvalo(one, f) : Nat}
  %rw eq_o(one, h1, f, B.badd(B.bmul(k, q), B.binc(r1)), h)
  %rw add_o(one, h1, B.bmul(k, q), B.binc(r1))
  %rw mul_o(one, h1, k, q)
  %rwh hq : {bvalo(one, q) == 1n+qp : Nat}
  %rwh hq : {bvalo(one, q) == 1n+qp : Nat}
  %rw NR.mod_of(bvalo(one, k), qp, bvalo(one, B.binc(r1)), N.le_lt_succ(bvalo(one, B.binc(r1)), qp, N.le_add_right(bvalo(one, B.binc(r1)), bvalo(one, d))))
  %rw inc_o(one, h1, r1)
  %close

def one_lt(+x: Nat) -> {Nat.is_lt(1n, 2n+x) == True{} : Bool}:
  {==}

# q >= 2: q does not divide 1
def e6_1(+one: Nat, +h1: {one == 1n : Nat}, +q: B.Bn, +q2: B.Bn, +h: {B.beq(q, B.binc(B.binc(q2))) == True{} : Bool}) -> {Nat.is_eq(Nat.mod(1n, bvalo(one, q)), 0n) == False{} : Bool}:
  %rw suc2_o(one, h1, q, q2, h)
  %goal {Nat.is_eq(Nat.mod(Nat.add(Nat.mul(0n, 2n+bvalo(one, q2)), 1n), 2n+bvalo(one, q2)), 0n) == False{} : Bool}
  %rw NR.mod_of(0n, 1n+bvalo(one, q2), 1n, one_lt(bvalo(one, q2)))
  %close

def fp_o(+one: Nat, +h1: {one == 1n : Nat}, +q: B.Bn, +f: B.Bn, +ff: Nat, +hf: {bvalo(one, f) == ff : Nat}) -> {bvalo(one, B.bmul(q, f)) == Nat.mul(bvalo(one, q), ff) : Nat}:
  %rwh Equal.sym(Nat, bvalo(one, f), ff, hf) : {ff == bvalo(one, f) : Nat}
  mul_o(one, h1, q, f)

# f f == n + d: n <= F F
def hf_o(+one: Nat, +h1: {one == 1n : Nat}, +n: B.Bn, +f: B.Bn, +ff: Nat, +hf: {bvalo(one, f) == ff : Nat}, +d: B.Bn, +h: {B.beq(B.bmul(f, f), B.badd(n, d)) == True{} : Bool}) -> {Nat.is_le(bvalo(one, n), Nat.mul(ff, ff)) == True{} : Bool}:
  %rwh Equal.sym(Nat, bvalo(one, f), ff, hf) : {ff == bvalo(one, f) : Nat}
  %rwh Equal.sym(Nat, bvalo(one, f), ff, hf) : {ff == bvalo(one, f) : Nat}
  %rw <- mul_o(one, h1, f, f)
  %rw eq_o(one, h1, B.bmul(f, f), B.badd(n, d), h)
  %rw add_o(one, h1, n, d)
  N.le_add_right(bvalo(one, n), bvalo(one, d))
