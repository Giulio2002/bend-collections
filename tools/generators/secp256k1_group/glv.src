# The GLV endomorphism of secp256k1 on the specification's points:
# phi(X : Y : Z) = (beta X : Y : Z) with beta^3 == 1 (hb) maps the group to
# itself and is a homomorphism for the complete addition (as triples), so
# phi([k] G) equiv [k] phi(G); and if phi(G) equiv [lambda] G (hf) then
# phi([k] G) equiv [lambda] ([k] G) for every k (glv_main).
#
# NOT proved: phi(A) equiv [lambda] A for an arbitrary point A of the group.
# That needs every point to be a multiple of G, i.e. #E(F_p) = n (point
# counting), which is not proved here.

def phi(+p: Nat, +beta: Nat, a: CS.SPoint) -> CS.SPoint:
  match a:
    case CS.SPoint{x, y, z}:
      CS.SPoint{FS.mmul(p, beta, x), y, z}

# phi(A) is a point of the group
def phi_valid(+mp: Nat, +be: Nat, +hb: {FS.mmul(1n+mp, FS.mmul(1n+mp, be, be), be) == 1n : Nat}, a: CS.SPoint, +va: {GS.valid(1n+mp, a) == True{} : Bool}) -> {GS.valid(1n+mp, phi(1n+mp, be, a)) == True{} : Bool}:
  match a:
    case CS.SPoint{+x, +y, +z}:
      G1.v_pack(mp, FS.mmul(1n+mp, be, x), y, z,
        I.both_red(mp, Nat.mul(FS.mmul(1n+mp, FS.mmul(1n+mp, be, x), FS.mmul(1n+mp, be, x)), FS.mmul(1n+mp, be, x)), Nat.sub(Nat.add(FS.mmul(1n+mp, FS.mmul(1n+mp, y, y), z), 1n+mp), Nat.mod(FS.mmul(1n+mp, 7n, FS.mmul(1n+mp, FS.mmul(1n+mp, z, z), z)), 1n+mp)), GJ.phi_curve(mp, x, y, z, be, G1.v_onc(mp, x, y, z, va), hb)),
        G1.v_nz(mp, x, y, z, va))

# phi(A) + phi(B) == phi(A + B), as triples
def phi_add(+mp: Nat, +be: Nat, +hb: {FS.mmul(1n+mp, FS.mmul(1n+mp, be, be), be) == 1n : Nat}, a: CS.SPoint, b: CS.SPoint) -> {CS.padd(1n+mp, phi(1n+mp, be, a), phi(1n+mp, be, b)) == phi(1n+mp, be, CS.padd(1n+mp, a, b)) : CS.SPoint}:
  match a b:
    case CS.SPoint{+x1, +y1, +z1} CS.SPoint{+x2, +y2, +z2}:
      G1.sp_eq(CS.nth(33n, CS.run(1n+mp, CS.add_prog(), [FS.mmul(1n+mp, be, x1), y1, z1, FS.mmul(1n+mp, be, x2), y2, z2, 21n])), CS.nth(36n, CS.run(1n+mp, CS.add_prog(), [FS.mmul(1n+mp, be, x1), y1, z1, FS.mmul(1n+mp, be, x2), y2, z2, 21n])), CS.nth(39n, CS.run(1n+mp, CS.add_prog(), [FS.mmul(1n+mp, be, x1), y1, z1, FS.mmul(1n+mp, be, x2), y2, z2, 21n])), FS.mmul(1n+mp, be, CS.nth(33n, CS.run(1n+mp, CS.add_prog(), [x1, y1, z1, x2, y2, z2, 21n]))), CS.nth(36n, CS.run(1n+mp, CS.add_prog(), [x1, y1, z1, x2, y2, z2, 21n])), CS.nth(39n, CS.run(1n+mp, CS.add_prog(), [x1, y1, z1, x2, y2, z2, 21n])),
        G1.reg_eq(mp, CS.nth(33n, CS.run(1n+mp, CS.add_prog(), [FS.mmul(1n+mp, be, x1), y1, z1, FS.mmul(1n+mp, be, x2), y2, z2, 21n])), FS.mmul(1n+mp, be, CS.nth(33n, CS.run(1n+mp, CS.add_prog(), [x1, y1, z1, x2, y2, z2, 21n]))), G1.ax_red(mp, FS.mmul(1n+mp, be, x1), y1, z1, FS.mmul(1n+mp, be, x2), y2, z2), NR.mod_mod(mp, Nat.mul(be, CS.nth(33n, CS.run(1n+mp, CS.add_prog(), [x1, y1, z1, x2, y2, z2, 21n])))), GI.phi_x(mp, x1, y1, z1, x2, y2, z2, be, 21n, hb)),
        G1.reg_eq(mp, CS.nth(36n, CS.run(1n+mp, CS.add_prog(), [FS.mmul(1n+mp, be, x1), y1, z1, FS.mmul(1n+mp, be, x2), y2, z2, 21n])), CS.nth(36n, CS.run(1n+mp, CS.add_prog(), [x1, y1, z1, x2, y2, z2, 21n])), G1.ay_red(mp, FS.mmul(1n+mp, be, x1), y1, z1, FS.mmul(1n+mp, be, x2), y2, z2), G1.ay_red(mp, x1, y1, z1, x2, y2, z2), GI.phi_y(mp, x1, y1, z1, x2, y2, z2, be, 21n, hb)),
        G1.reg_eq(mp, CS.nth(39n, CS.run(1n+mp, CS.add_prog(), [FS.mmul(1n+mp, be, x1), y1, z1, FS.mmul(1n+mp, be, x2), y2, z2, 21n])), CS.nth(39n, CS.run(1n+mp, CS.add_prog(), [x1, y1, z1, x2, y2, z2, 21n])), G1.az_red(mp, FS.mmul(1n+mp, be, x1), y1, z1, FS.mmul(1n+mp, be, x2), y2, z2), G1.az_red(mp, x1, y1, z1, x2, y2, z2), GI.phi_z(mp, x1, y1, z1, x2, y2, z2, be, 21n, hb)))

# phi(O) equiv O
def phi_inf(+mp: Nat, +be: Nat) -> {GS.equiv(1n+mp, phi(1n+mp, be, CS.infinity()), CS.infinity()) == True{} : Bool}:
  G1.e_pack(mp, FS.mmul(1n+mp, be, 0n), 1n, 0n, 0n, 1n, 0n, F.z_mul_l(mp, FS.mmul(1n+mp, be, 0n), 1n, F.z_mmul_r(mp, be, 0n, {==})), {==})

# phi([k] A) equiv [k] phi(A)
def phi_smul(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +be: Nat, +hb: {FS.mmul(1n+mp, FS.mmul(1n+mp, be, be), be) == 1n : Nat}, k: Nat, +a: CS.SPoint, +va: {GS.valid(1n+mp, a) == True{} : Bool}) -> {GS.equiv(1n+mp, phi(1n+mp, be, GS.smul(1n+mp, k, a)), GS.smul(1n+mp, k, phi(1n+mp, be, a))) == True{} : Bool}:
  match k:
    case 0n:
      phi_inf(mp, be)
    case 1n+ +j:
      %phi_add(mp, be, hb, GS.smul(1n+mp, j, a), a) : {GS.equiv(1n+mp, _, CS.padd(1n+mp, GS.smul(1n+mp, j, phi(1n+mp, be, a)), phi(1n+mp, be, a))) == True{} : Bool}
      G2.e_add_l(mp, hp, phi(1n+mp, be, GS.smul(1n+mp, j, a)), GS.smul(1n+mp, j, phi(1n+mp, be, a)), phi(1n+mp, be, a), phi_valid(mp, be, hb, GS.smul(1n+mp, j, a), G4.v_smul(mp, hp, h3, hnc, h21, j, a, va)), G4.v_smul(mp, hp, h3, hnc, h21, j, phi(1n+mp, be, a), phi_valid(mp, be, hb, a, va)), phi_smul(mp, hp, h3, hnc, h21, be, hb, j, a, va))

# [k] ([la] G) equiv [la k] G
def kl_comm(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +la: Nat, +g: CS.SPoint, +vg: {GS.valid(1n+mp, g) == True{} : Bool}, +k: Nat) -> {GS.equiv(1n+mp, GS.smul(1n+mp, k, GS.smul(1n+mp, la, g)), GS.smul(1n+mp, Nat.mul(la, k), g)) == True{} : Bool}:
  %NA.mul_comm(k, la) : {GS.equiv(1n+mp, GS.smul(1n+mp, k, GS.smul(1n+mp, la, g)), GS.smul(1n+mp, _, g)) == True{} : Bool}
  G2.e_sym(mp, GS.smul(1n+mp, Nat.mul(k, la), g), GS.smul(1n+mp, k, GS.smul(1n+mp, la, g)), G4.smul_mul(mp, hp, h3, hnc, h21, k, la, g, vg))

# phi(G) equiv [la] G gives phi([k] G) equiv [la] ([k] G)
def glv_main(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +be: Nat, +hb: {FS.mmul(1n+mp, FS.mmul(1n+mp, be, be), be) == 1n : Nat}, +la: Nat, +g: CS.SPoint, +vg: {GS.valid(1n+mp, g) == True{} : Bool}, +hf: {GS.equiv(1n+mp, phi(1n+mp, be, g), GS.smul(1n+mp, la, g)) == True{} : Bool}, +k: Nat) -> {GS.equiv(1n+mp, phi(1n+mp, be, GS.smul(1n+mp, k, g)), GS.smul(1n+mp, la, GS.smul(1n+mp, k, g))) == True{} : Bool}:
  +vpg = phi_valid(mp, be, hb, g, vg)
  +vlg = G4.v_smul(mp, hp, h3, hnc, h21, la, g, vg)
  G2.e_trans(mp, hp, phi(1n+mp, be, GS.smul(1n+mp, k, g)), GS.smul(1n+mp, k, phi(1n+mp, be, g)), GS.smul(1n+mp, la, GS.smul(1n+mp, k, g)), G4.v_smul(mp, hp, h3, hnc, h21, k, phi(1n+mp, be, g), vpg), phi_smul(mp, hp, h3, hnc, h21, be, hb, k, g, vg),
    G2.e_trans(mp, hp, GS.smul(1n+mp, k, phi(1n+mp, be, g)), GS.smul(1n+mp, k, GS.smul(1n+mp, la, g)), GS.smul(1n+mp, la, GS.smul(1n+mp, k, g)), G4.v_smul(mp, hp, h3, hnc, h21, k, GS.smul(1n+mp, la, g), vlg), G4.smul_eqv(mp, hp, h3, hnc, h21, k, phi(1n+mp, be, g), GS.smul(1n+mp, la, g), vpg, vlg, hf),
      G2.e_trans(mp, hp, GS.smul(1n+mp, k, GS.smul(1n+mp, la, g)), GS.smul(1n+mp, Nat.mul(la, k), g), GS.smul(1n+mp, la, GS.smul(1n+mp, k, g)), G4.v_smul(mp, hp, h3, hnc, h21, Nat.mul(la, k), g, vg), kl_comm(mp, hp, h3, hnc, h21, la, g, vg, k), G4.smul_mul(mp, hp, h3, hnc, h21, la, k, g, vg))))
