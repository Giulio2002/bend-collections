# Lists of octets and small arithmetic for the ECDSA proofs.

def first_cat(a: List<&2, U32>, n: Nat, +m: Nat, +b: List<&2, U32>, +h: {List.length(&2, U32, a) == n : Nat}) -> {CS.first(Nat.add(n, m), List.append(&2, U32, a, b)) == List.append(&2, U32, a, CS.first(m, b)) : List<&2, U32>}:
  match a n:
    case Nil{} 0n:
      {==}
    case Nil{} 1n+k:
      Empty.absurd({CS.first(Nat.add(1n+k, m), List.append(&2, U32, Nil{}, b)) == List.append(&2, U32, Nil{}, CS.first(m, b)) : List<&2, U32>}, N.zero_succ(k, h))
    case x <> t 0n:
      Empty.absurd({CS.first(Nat.add(0n, m), List.append(&2, U32, x <> t, b)) == List.append(&2, U32, x <> t, CS.first(m, b)) : List<&2, U32>}, N.succ_zero(List.length(&2, U32, t), h))
    case +x <> +t 1n+ +k:
      Equal.cong(List<&2, U32>, List<&2, U32>, l => x <> l, CS.first(Nat.add(k, m), List.append(&2, U32, t, b)), List.append(&2, U32, t, CS.first(m, b)), first_cat(t, k, m, b, N.succ_inj(List.length(&2, U32, t), k, h)))

def after_cat(a: List<&2, U32>, n: Nat, +m: Nat, +b: List<&2, U32>, +h: {List.length(&2, U32, a) == n : Nat}) -> {CS.after(Nat.add(n, m), List.append(&2, U32, a, b)) == CS.after(m, b) : List<&2, U32>}:
  match a n:
    case Nil{} 0n:
      {==}
    case Nil{} 1n+k:
      Empty.absurd({CS.after(Nat.add(1n+k, m), List.append(&2, U32, Nil{}, b)) == CS.after(m, b) : List<&2, U32>}, N.zero_succ(k, h))
    case x <> t 0n:
      Empty.absurd({CS.after(Nat.add(0n, m), List.append(&2, U32, x <> t, b)) == CS.after(m, b) : List<&2, U32>}, N.succ_zero(List.length(&2, U32, t), h))
    case +x <> +t 1n+ +k:
      after_cat(t, k, m, b, N.succ_inj(List.length(&2, U32, t), k, h))

def len_app(a: List<&2, U32>, +b: List<&2, U32>) -> {List.length(&2, U32, List.append(&2, U32, a, b)) == Nat.add(List.length(&2, U32, a), List.length(&2, U32, b)) : Nat}:
  match a:
    case Nil{}:
      {==}
    case x <> +t:
      Equal.cong(Nat, Nat, z => 1n+z, List.length(&2, U32, List.append(&2, U32, t, b)), Nat.add(List.length(&2, U32, t), List.length(&2, U32, b)), len_app(t, b))

# x >= n, x < 2 n: (x mod n) + 1 n == x
def mod_big_c(+nm: Nat, +x: Nat, +h2: {Nat.is_lt(x, Nat.double(1n+nm)) == True{} : Bool}, +hl: {Nat.is_le(1n+nm, x) == True{} : Bool}) -> {Nat.add(Nat.mod(x, 1n+nm), Nat.mul(1n, 1n+nm)) == x : Nat}:
  +d = Nat.sub(x, 1n+nm)
  +e1 = N.sub_add(x, 1n+nm, hl)
  +hd = N.sub_lt(x, 1n+nm, 1n+nm, hl, Equal.trans(Bool, Nat.is_lt(x, Nat.add(1n+nm, 1n+nm)), Nat.is_lt(x, Nat.double(1n+nm)), True{}, Equal.cong(Nat, Bool, z => Nat.is_lt(x, z), Nat.add(1n+nm, 1n+nm), Nat.double(1n+nm), Equal.sym(Nat, Nat.double(1n+nm), Nat.add(1n+nm, 1n+nm), NA.double_self(1n+nm))), h2))
  +e2 = NR.mod_of(1n, nm, d, hd)
  %Equal.sym(Nat, x, Nat.add(1n+nm, d), Equal.sym(Nat, Nat.add(1n+nm, d), x, e1)) : {Nat.add(Nat.mod(_, 1n+nm), Nat.mul(1n, 1n+nm)) == x : Nat}
  %SR.one_mul(1n+nm) : {Nat.add(Nat.mod(Nat.add(_, d), 1n+nm), Nat.mul(1n, 1n+nm)) == x : Nat}
  %Equal.sym(Nat, Nat.mod(Nat.add(Nat.mul(1n, 1n+nm), d), 1n+nm), d, e2) : {Nat.add(_, Nat.mul(1n, 1n+nm)) == x : Nat}
  %Equal.sym(Nat, Nat.mul(1n, 1n+nm), 1n+nm, SR.one_mul(1n+nm)) : {Nat.add(d, _) == x : Nat}
  %NA.add_comm(1n+nm, d) : {_ == x : Nat}
  e1

# t + s < 2 s: not (t + s < 2 t)
def low_half(+s: Nat, +t: Nat, +h: {Nat.is_lt(Nat.add(t, s), Nat.double(s)) == True{} : Bool}) -> {Nat.is_lt(Nat.add(t, s), Nat.double(t)) == False{} : Bool}:
  +h2 = Equal.trans(Bool, Nat.is_lt(t, s), Nat.is_lt(Nat.add(t, s), Nat.add(s, s)), True{}, Equal.sym(Bool, Nat.is_lt(Nat.add(t, s), Nat.add(s, s)), Nat.is_lt(t, s), WW.lt_cancel_r(t, s, s)), Equal.trans(Bool, Nat.is_lt(Nat.add(t, s), Nat.add(s, s)), Nat.is_lt(Nat.add(t, s), Nat.double(s)), True{}, Equal.cong(Nat, Bool, z => Nat.is_lt(Nat.add(t, s), z), Nat.add(s, s), Nat.double(s), Equal.sym(Nat, Nat.double(s), Nat.add(s, s), NA.double_self(s))), h))
  %Equal.sym(Nat, Nat.double(t), Nat.add(t, t), NA.double_self(t)) : {Nat.is_lt(Nat.add(t, s), _) == False{} : Bool}
  %Equal.sym(Bool, Nat.is_lt(Nat.add(t, s), Nat.add(t, t)), Nat.is_lt(s, t), WW.lt_cancel_l(t, s, t)) : {_ == False{} : Bool}
  N.le_not_lt(s, t, N.lt_le(t, s, h2))
