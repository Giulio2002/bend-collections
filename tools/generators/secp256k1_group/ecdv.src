# The two checks of ECDSA on abstract points (modulus 1 + mp, order
# n = 1 + nm, generator g as in ecdg.bend): K equiv [k] g is the nonce
# point and Q equiv [d] g the public key; r = x(K) mod n,
# s = k^-1 (e + r d) mod n, and s' is s or n - s (ES.low).
#   vfy: the verification sum [e / s'] g + [r / s'] Q is not infinity and
#        its affine x mod n is r;
#   rcv_*: the recovery sum [-e / r] g + [s' / r] R', with R' the
#        normalized K or its negative, is not infinity and encodes as Q;
#   dcp: decompressing x(K) with the parity of y(K), flipped with s',
#        gives R'.

def scal(+mp: Nat, +rr: CS.SPoint, +g: CS.SPoint, +a: Nat, +b: Nat, +h: {a == b : Nat}, +he: {GS.equiv(1n+mp, rr, GS.smul(1n+mp, a, g)) == True{} : Bool}) -> {GS.equiv(1n+mp, rr, GS.smul(1n+mp, b, g)) == True{} : Bool}:
  %h : {GS.equiv(1n+mp, rr, GS.smul(1n+mp, _, g)) == True{} : Bool}
  he

def qnrm(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +nm: Nat, +hq: PM.Prime(1n+nm), +g: CS.SPoint, +vg: {GS.valid(1n+mp, g) == True{} : Bool}, +hng: {GS.equiv(1n+mp, GS.smul(1n+mp, 1n+nm, g), CS.infinity()) == True{} : Bool}, +hgo: {GS.equiv(1n+mp, g, CS.infinity()) == False{} : Bool}, +qp: CS.SPoint, +d: Nat, +nzd: F.NZ(nm, d), +vqp: {GS.valid(1n+mp, qp) == True{} : Bool}, +hqp: {GS.equiv(1n+mp, qp, GS.smul(1n+mp, d, g)) == True{} : Bool}) -> {GS.equiv(1n+mp, EG.nrm(1n+mp, qp), GS.smul(1n+mp, d, g)) == True{} : Bool}:
  G2.e_trans(mp, hp, EG.nrm(1n+mp, qp), qp, GS.smul(1n+mp, d, g), vqp, G2.e_sym(mp, qp, EG.nrm(1n+mp, qp), EG.w_nrm_e(mp, hp, qp, EG.knz(mp, hp, h3, hnc, h21, nm, hq, g, vg, hng, hgo, qp, d, nzd, vqp, hqp))), hqp)

def qnrm_v(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +nm: Nat, +hq: PM.Prime(1n+nm), +g: CS.SPoint, +vg: {GS.valid(1n+mp, g) == True{} : Bool}, +hng: {GS.equiv(1n+mp, GS.smul(1n+mp, 1n+nm, g), CS.infinity()) == True{} : Bool}, +hgo: {GS.equiv(1n+mp, g, CS.infinity()) == False{} : Bool}, +qp: CS.SPoint, +d: Nat, +nzd: F.NZ(nm, d), +vqp: {GS.valid(1n+mp, qp) == True{} : Bool}, +hqp: {GS.equiv(1n+mp, qp, GS.smul(1n+mp, d, g)) == True{} : Bool}) -> {GS.valid(1n+mp, EG.nrm(1n+mp, qp)) == True{} : Bool}:
  EG.w_nrm_v(mp, hp, qp, vqp, EG.knz(mp, hp, h3, hnc, h21, nm, hq, g, vg, hng, hgo, qp, d, nzd, vqp, hqp))

# the verification check
def vfy(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +nm: Nat, +hq: PM.Prime(1n+nm), +g: CS.SPoint, +vg: {GS.valid(1n+mp, g) == True{} : Bool}, +hng: {GS.equiv(1n+mp, GS.smul(1n+mp, 1n+nm, g), CS.infinity()) == True{} : Bool}, +hgo: {GS.equiv(1n+mp, g, CS.infinity()) == False{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +hn256: {Nat.is_le(1n+nm, C.shift(256n, one)) == True{} : Bool}, +kp: CS.SPoint, +qp: CS.SPoint, +k: Nat, +d: Nat, +e: Nat, hi: Bool, +nzk: F.NZ(nm, k), +hk: {Nat.is_lt(k, 1n+nm) == True{} : Bool}, +nzd: F.NZ(nm, d), +vkp: {GS.valid(1n+mp, kp) == True{} : Bool}, +hkp: {GS.equiv(1n+mp, kp, GS.smul(1n+mp, k, g)) == True{} : Bool}, +vqp: {GS.valid(1n+mp, qp) == True{} : Bool}, +hqp: {GS.equiv(1n+mp, qp, GS.smul(1n+mp, d, g)) == True{} : Bool}, +nzs: F.NZ(nm, FS.mmul(1n+nm, FS.minv(1n+nm, k), FS.madd(1n+nm, e, FS.mmul(1n+nm, Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm), d))))) -> {Bool.and(Bool.not(CS.is_inf(CS.padd(1n+mp, CS.pmul(1n+mp, FS.mmul(1n+nm, e, FS.minv(1n+nm, ES.low(hi, 1n+nm, FS.mmul(1n+nm, FS.minv(1n+nm, k), FS.madd(1n+nm, e, FS.mmul(1n+nm, Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm), d)))))), g), CS.pmul(1n+mp, FS.mmul(1n+nm, Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm), FS.minv(1n+nm, ES.low(hi, 1n+nm, FS.mmul(1n+nm, FS.minv(1n+nm, k), FS.madd(1n+nm, e, FS.mmul(1n+nm, Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm), d)))))), EG.nrm(1n+mp, qp))))), Nat.is_eq(Nat.mod(CS.aff_x(CS.to_affine(1n+mp, CS.padd(1n+mp, CS.pmul(1n+mp, FS.mmul(1n+nm, e, FS.minv(1n+nm, ES.low(hi, 1n+nm, FS.mmul(1n+nm, FS.minv(1n+nm, k), FS.madd(1n+nm, e, FS.mmul(1n+nm, Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm), d)))))), g), CS.pmul(1n+mp, FS.mmul(1n+nm, Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm), FS.minv(1n+nm, ES.low(hi, 1n+nm, FS.mmul(1n+nm, FS.minv(1n+nm, k), FS.madd(1n+nm, e, FS.mmul(1n+nm, Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm), d)))))), EG.nrm(1n+mp, qp))))), 1n+nm), Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm))) == True{} : Bool}:
  match hi:
    case False{}:
      +nq = EG.nrm(1n+mp, qp)
      +vnq = qnrm_v(mp, hp, h3, hnc, h21, nm, hq, g, vg, hng, hgo, qp, d, nzd, vqp, hqp)
      +hnq = qnrm(mp, hp, h3, hnc, h21, nm, hq, g, vg, hng, hgo, qp, d, nzd, vqp, hqp)
      +w = FS.minv(1n+nm, FS.mmul(1n+nm, FS.minv(1n+nm, k), FS.madd(1n+nm, e, FS.mmul(1n+nm, Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm), d))))
      +u1 = FS.mmul(1n+nm, e, w)
      +u2 = FS.mmul(1n+nm, Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm), w)
      EG.rr_pos(mp, hp, h3, hnc, h21, nm, hq, g, vg, hng, hgo, CS.padd(1n+mp, CS.pmul(1n+mp, u1, g), CS.pmul(1n+mp, u2, nq)), kp, k, nzk, vkp, hkp, G1.v_add(mp, hp, h3, hnc, h21, CS.pmul(1n+mp, u1, g), CS.pmul(1n+mp, u2, nq), G4.pmul_valid(mp, hp, h3, hnc, h21, u1, g, vg), G4.pmul_valid(mp, hp, h3, hnc, h21, u2, nq, vnq)),
        scal(mp, CS.padd(1n+mp, CS.pmul(1n+mp, u1, g), CS.pmul(1n+mp, u2, nq)), g, FS.madd(1n+nm, u1, FS.mmul(1n+nm, u2, d)), k, EN.kk_pos(nm, hq, e, Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm), d, k, nzk, hk, nzs),
          EG.lin2(mp, hp, h3, hnc, h21, nm, hq, g, vg, hng, hgo, one, h1, hn256, u1, u2, nq, d, NR.dm_lt(nm, Nat.mul(e, w)), NR.dm_lt(nm, Nat.mul(Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm), w)), vnq, hnq)))
    case True{}:
      +nq = EG.nrm(1n+mp, qp)
      +vnq = qnrm_v(mp, hp, h3, hnc, h21, nm, hq, g, vg, hng, hgo, qp, d, nzd, vqp, hqp)
      +hnq = qnrm(mp, hp, h3, hnc, h21, nm, hq, g, vg, hng, hgo, qp, d, nzd, vqp, hqp)
      +w = FS.minv(1n+nm, FS.msub(1n+nm, 0n, FS.mmul(1n+nm, FS.minv(1n+nm, k), FS.madd(1n+nm, e, FS.mmul(1n+nm, Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm), d)))))
      +u1 = FS.mmul(1n+nm, e, w)
      +u2 = FS.mmul(1n+nm, Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm), w)
      EG.rr_neg(mp, hp, h3, hnc, h21, nm, hq, g, vg, hng, hgo, CS.padd(1n+mp, CS.pmul(1n+mp, u1, g), CS.pmul(1n+mp, u2, nq)), kp, k, nzk, vkp, hkp, G1.v_add(mp, hp, h3, hnc, h21, CS.pmul(1n+mp, u1, g), CS.pmul(1n+mp, u2, nq), G4.pmul_valid(mp, hp, h3, hnc, h21, u1, g, vg), G4.pmul_valid(mp, hp, h3, hnc, h21, u2, nq, vnq)),
        scal(mp, CS.padd(1n+mp, CS.pmul(1n+mp, u1, g), CS.pmul(1n+mp, u2, nq)), g, FS.madd(1n+nm, u1, FS.mmul(1n+nm, u2, d)), FS.msub(1n+nm, 0n, k), EN.kk_neg(nm, hq, e, Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm), d, k, nzk, hk, nzs),
          EG.lin2(mp, hp, h3, hnc, h21, nm, hq, g, vg, hng, hgo, one, h1, hn256, u1, u2, nq, d, NR.dm_lt(nm, Nat.mul(e, w)), NR.dm_lt(nm, Nat.mul(Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm), w)), vnq, hnq)))

# ---- recovery ----

# the normalized K, or its negative when s was replaced by n - s
def prh(+p: Nat, hi: Bool, +a: CS.SPoint) -> CS.SPoint:
  match hi:
    case False{}:
      EG.nrm(p, a)
    case True{}:
      GS.neg(p, EG.nrm(p, a))

# the recovery sum is [d] g
def rcv_q(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +nm: Nat, +hq: PM.Prime(1n+nm), +g: CS.SPoint, +vg: {GS.valid(1n+mp, g) == True{} : Bool}, +hng: {GS.equiv(1n+mp, GS.smul(1n+mp, 1n+nm, g), CS.infinity()) == True{} : Bool}, +hgo: {GS.equiv(1n+mp, g, CS.infinity()) == False{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +hn256: {Nat.is_le(1n+nm, C.shift(256n, one)) == True{} : Bool}, +kp: CS.SPoint, +k: Nat, +d: Nat, +e: Nat, hi: Bool, +nzk: F.NZ(nm, k), +hd: {Nat.is_lt(d, 1n+nm) == True{} : Bool}, +vkp: {GS.valid(1n+mp, kp) == True{} : Bool}, +hkp: {GS.equiv(1n+mp, kp, GS.smul(1n+mp, k, g)) == True{} : Bool}, +nzr: F.NZ(nm, Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm))) -> {GS.equiv(1n+mp, CS.padd(1n+mp, CS.pmul(1n+mp, FS.mmul(1n+nm, FS.msub(1n+nm, 0n, e), FS.minv(1n+nm, Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm))), g), CS.pmul(1n+mp, FS.mmul(1n+nm, ES.low(hi, 1n+nm, FS.mmul(1n+nm, FS.minv(1n+nm, k), FS.madd(1n+nm, e, FS.mmul(1n+nm, Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm), d)))), FS.minv(1n+nm, Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm))), prh(1n+mp, hi, kp))), GS.smul(1n+mp, d, g)) == True{} : Bool}:
  match hi:
    case False{}:
      +nk = EG.knz(mp, hp, h3, hnc, h21, nm, hq, g, vg, hng, hgo, kp, k, nzk, vkp, hkp)
      +nr = EG.nrm(1n+mp, kp)
      +vnr = EG.w_nrm_v(mp, hp, kp, vkp, nk)
      +hnr = G2.e_trans(mp, hp, nr, kp, GS.smul(1n+mp, k, g), vkp, G2.e_sym(mp, kp, nr, EG.w_nrm_e(mp, hp, kp, nk)), hkp)
      +ri = FS.minv(1n+nm, Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm))
      +u1 = FS.mmul(1n+nm, FS.msub(1n+nm, 0n, e), ri)
      +u2 = FS.mmul(1n+nm, FS.mmul(1n+nm, FS.minv(1n+nm, k), FS.madd(1n+nm, e, FS.mmul(1n+nm, Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm), d))), ri)
      scal(mp, CS.padd(1n+mp, CS.pmul(1n+mp, u1, g), CS.pmul(1n+mp, u2, nr)), g, FS.madd(1n+nm, u1, FS.mmul(1n+nm, u2, k)), d, EN.rec_pos(nm, hq, e, Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm), d, k, nzk, nzr, hd),
        EG.lin2(mp, hp, h3, hnc, h21, nm, hq, g, vg, hng, hgo, one, h1, hn256, u1, u2, nr, k, NR.dm_lt(nm, Nat.mul(FS.msub(1n+nm, 0n, e), ri)), NR.dm_lt(nm, Nat.mul(FS.mmul(1n+nm, FS.minv(1n+nm, k), FS.madd(1n+nm, e, FS.mmul(1n+nm, Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm), d))), ri)), vnr, hnr))
    case True{}:
      +nk = EG.knz(mp, hp, h3, hnc, h21, nm, hq, g, vg, hng, hgo, kp, k, nzk, vkp, hkp)
      +nr = EG.nrm(1n+mp, kp)
      +vnr = EG.w_nrm_v(mp, hp, kp, vkp, nk)
      +hnr = G2.e_trans(mp, hp, nr, kp, GS.smul(1n+mp, k, g), vkp, G2.e_sym(mp, kp, nr, EG.w_nrm_e(mp, hp, kp, nk)), hkp)
      +ri = FS.minv(1n+nm, Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm))
      +u1 = FS.mmul(1n+nm, FS.msub(1n+nm, 0n, e), ri)
      +u2 = FS.mmul(1n+nm, FS.msub(1n+nm, 0n, FS.mmul(1n+nm, FS.minv(1n+nm, k), FS.madd(1n+nm, e, FS.mmul(1n+nm, Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm), d)))), ri)
      +vsk = G4.v_smul(mp, hp, h3, hnc, h21, k, g, vg)
      scal(mp, CS.padd(1n+mp, CS.pmul(1n+mp, u1, g), CS.pmul(1n+mp, u2, GS.neg(1n+mp, nr))), g, FS.madd(1n+nm, u1, FS.mmul(1n+nm, u2, FS.msub(1n+nm, 0n, k))), d, EN.rec_neg(nm, hq, e, Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm), d, k, nzk, nzr, hd),
        EG.lin2(mp, hp, h3, hnc, h21, nm, hq, g, vg, hng, hgo, one, h1, hn256, u1, u2, GS.neg(1n+mp, nr), FS.msub(1n+nm, 0n, k), NR.dm_lt(nm, Nat.mul(FS.msub(1n+nm, 0n, e), ri)), NR.dm_lt(nm, Nat.mul(FS.msub(1n+nm, 0n, FS.mmul(1n+nm, FS.minv(1n+nm, k), FS.madd(1n+nm, e, FS.mmul(1n+nm, Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm), d)))), ri)), G2.v_neg(mp, nr, vnr),
          G2.e_trans(mp, hp, GS.neg(1n+mp, nr), GS.neg(1n+mp, GS.smul(1n+mp, k, g)), GS.smul(1n+mp, FS.msub(1n+nm, 0n, k), g), G2.v_neg(mp, GS.smul(1n+mp, k, g), vsk), G5.e_neg(mp, nr, GS.smul(1n+mp, k, g), hnr), G2.e_sym(mp, GS.smul(1n+mp, FS.msub(1n+nm, 0n, k), g), GS.neg(1n+mp, GS.smul(1n+mp, k, g)), EG.negk(mp, hp, h3, hnc, h21, nm, hq, g, vg, hng, hgo, k)))))

def prh_v(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +nm: Nat, +hq: PM.Prime(1n+nm), +g: CS.SPoint, +vg: {GS.valid(1n+mp, g) == True{} : Bool}, +hng: {GS.equiv(1n+mp, GS.smul(1n+mp, 1n+nm, g), CS.infinity()) == True{} : Bool}, +hgo: {GS.equiv(1n+mp, g, CS.infinity()) == False{} : Bool}, +kp: CS.SPoint, +k: Nat, hi: Bool, +nzk: F.NZ(nm, k), +vkp: {GS.valid(1n+mp, kp) == True{} : Bool}, +hkp: {GS.equiv(1n+mp, kp, GS.smul(1n+mp, k, g)) == True{} : Bool}) -> {GS.valid(1n+mp, prh(1n+mp, hi, kp)) == True{} : Bool}:
  match hi:
    case False{}:
      EG.w_nrm_v(mp, hp, kp, vkp, EG.knz(mp, hp, h3, hnc, h21, nm, hq, g, vg, hng, hgo, kp, k, nzk, vkp, hkp))
    case True{}:
      G2.v_neg(mp, EG.nrm(1n+mp, kp), EG.w_nrm_v(mp, hp, kp, vkp, EG.knz(mp, hp, h3, hnc, h21, nm, hq, g, vg, hng, hgo, kp, k, nzk, vkp, hkp)))

# a point equiv [d] g (d != 0 mod n) is not infinity ...
def rcv_i(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +nm: Nat, +hq: PM.Prime(1n+nm), +g: CS.SPoint, +vg: {GS.valid(1n+mp, g) == True{} : Bool}, +hng: {GS.equiv(1n+mp, GS.smul(1n+mp, 1n+nm, g), CS.infinity()) == True{} : Bool}, +hgo: {GS.equiv(1n+mp, g, CS.infinity()) == False{} : Bool}, +qr: CS.SPoint, +d: Nat, +nzd: F.NZ(nm, d), +vqr: {GS.valid(1n+mp, qr) == True{} : Bool}, +hqr: {GS.equiv(1n+mp, qr, GS.smul(1n+mp, d, g)) == True{} : Bool}) -> {CS.is_inf(qr) == False{} : Bool}:
  EG.w_inf(mp, qr, EG.knz(mp, hp, h3, hnc, h21, nm, hq, g, vg, hng, hgo, qr, d, nzd, vqr, hqr))

# ... and encodes as any other
def rcv_e(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +nm: Nat, +hq: PM.Prime(1n+nm), +g: CS.SPoint, +vg: {GS.valid(1n+mp, g) == True{} : Bool}, +hng: {GS.equiv(1n+mp, GS.smul(1n+mp, 1n+nm, g), CS.infinity()) == True{} : Bool}, +hgo: {GS.equiv(1n+mp, g, CS.infinity()) == False{} : Bool}, +qr: CS.SPoint, +qp: CS.SPoint, +d: Nat, +nzd: F.NZ(nm, d), +vqr: {GS.valid(1n+mp, qr) == True{} : Bool}, +hqr: {GS.equiv(1n+mp, qr, GS.smul(1n+mp, d, g)) == True{} : Bool}, +vqp: {GS.valid(1n+mp, qp) == True{} : Bool}, +hqp: {GS.equiv(1n+mp, qp, GS.smul(1n+mp, d, g)) == True{} : Bool}) -> {CS.encode_uncompressed(1n+mp, qr) == CS.encode_uncompressed(1n+mp, qp) : List<&2, U32>}:
  Equal.cong(CS.SAffine, List<&2, U32>, t => CS.enc_u(t), CS.to_affine(1n+mp, qr), CS.to_affine(1n+mp, qp), EG.w_ta(mp, hp, qr, qp, vqr, vqp, EG.knz(mp, hp, h3, hnc, h21, nm, hq, g, vg, hng, hgo, qr, d, nzd, vqr, hqr), EG.knz(mp, hp, h3, hnc, h21, nm, hq, g, vg, hng, hgo, qp, d, nzd, vqp, hqp), G2.e_trans(mp, hp, qr, GS.smul(1n+mp, d, g), qp, G4.v_smul(mp, hp, h3, hnc, h21, d, g, vg), hqr, G2.e_sym(mp, qp, GS.smul(1n+mp, d, g), hqp))))

# ---- decompression of x(K) ----

def two_cases(a: Nat, b: Nat, +ha: {Nat.is_lt(a, 2n) == True{} : Bool}, +hb: {Nat.is_lt(b, 2n) == True{} : Bool}, +hne: {Nat.is_eq(a, b) == False{} : Bool}) -> {a == Nat.sub(1n, b) : Nat}:
  match a b:
    case 0n 0n:
      Empty.absurd({0n == Nat.sub(1n, 0n) : Nat}, Lg.true_false(hne))
    case 0n 1n:
      {==}
    case 0n 2n+ +q:
      Empty.absurd({0n == Nat.sub(1n, 2n+q) : Nat}, N.lt_zero_absurd(q, hb))
    case 1n 0n:
      {==}
    case 1n 1n:
      Empty.absurd({1n == Nat.sub(1n, 1n) : Nat}, Lg.true_false(hne))
    case 1n 2n+ +q:
      Empty.absurd({1n == Nat.sub(1n, 2n+q) : Nat}, N.lt_zero_absurd(q, hb))
    case 2n+ +p b2:
      Empty.absurd({2n+p == Nat.sub(1n, b2) : Nat}, N.lt_zero_absurd(p, ha))

def par_ne_c(+a: Nat, +b: Nat, +hs: {Nat.mod(Nat.add(a, b), 2n) == 1n : Nat}, c: Bool, +hc: {Nat.is_eq(Nat.mod(a, 2n), Nat.mod(b, 2n)) == c : Bool}) -> {Nat.is_eq(Nat.mod(a, 2n), Nat.mod(b, 2n)) == False{} : Bool}:
  match c:
    case False{}:
      hc
    case True{}:
      Empty.absurd({Nat.is_eq(Nat.mod(a, 2n), Nat.mod(b, 2n)) == False{} : Bool}, SQ.par_ne(a, b, N.eq_from_is_eq(Nat.mod(a, 2n), Nat.mod(b, 2n), hc), hs))

def par_sum(+mp: Nat, +hodd: {Nat.mod(1n+mp, 2n) == 1n : Nat}, +yp: Nat, +hy: {Nat.is_lt(1n+yp, 1n+mp) == True{} : Bool}) -> {Nat.mod(Nat.add(FS.mneg(1n+mp, 1n+yp), 1n+yp), 2n) == 1n : Nat}:
  %Equal.sym(Nat, FS.mneg(1n+mp, 1n+yp), Nat.sub(mp, yp), SQ.neg_pos(mp, yp, hy)) : {Nat.mod(Nat.add(_, 1n+yp), 2n) == 1n : Nat}
  %Equal.sym(Nat, Nat.add(Nat.sub(mp, yp), 1n+yp), 1n+mp, SQ.neg_sum(mp, yp, hy)) : {Nat.mod(_, 2n) == 1n : Nat}
  hodd

# p odd, 0 < y < p: p - y has the other parity
def par_flip(+mp: Nat, +hodd: {Nat.mod(1n+mp, 2n) == 1n : Nat}, y: Nat, +hy: {Nat.is_lt(y, 1n+mp) == True{} : Bool}, +nzy: {Nat.is_eq(y, 0n) == False{} : Bool}) -> {Nat.mod(FS.mneg(1n+mp, y), 2n) == Nat.sub(1n, Nat.mod(y, 2n)) : Nat}:
  match y:
    case 0n:
      Empty.absurd({Nat.mod(FS.mneg(1n+mp, 0n), 2n) == Nat.sub(1n, Nat.mod(0n, 2n)) : Nat}, Lg.true_false(nzy))
    case 1n+ +yp:
      two_cases(Nat.mod(FS.mneg(1n+mp, 1n+yp), 2n), Nat.mod(1n+yp, 2n), NR.dm_lt(1n, FS.mneg(1n+mp, 1n+yp)), NR.dm_lt(1n, 1n+yp),
        par_ne_c(FS.mneg(1n+mp, 1n+yp), 1n+yp, par_sum(mp, hodd, yp, hy), Nat.is_eq(Nat.mod(FS.mneg(1n+mp, 1n+yp), 2n), Nat.mod(1n+yp, 2n)), {==}))

def dcp(+one: Nat, +h1: {one == 1n : Nat}, +mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +s4: Nat, +he: {Nat.add(1n+mp, 1n) == Nat.mul(s4, 4n) : Nat}, +hodd: {Nat.mod(1n+mp, 2n) == 1n : Nat}, +h256: {Nat.is_le(1n+mp, C.shift(256n, one)) == True{} : Bool}, kp: CS.SPoint, hi: Bool, +vkp: {GS.valid(1n+mp, kp) == True{} : Bool}, +nk: F.NZ(mp, EG.pz(kp))) -> {CS.decompress(1n+mp, CS.aff_x(CS.to_affine(1n+mp, kp)), ES.flip(hi, Nat.mod(CS.aff_y(CS.to_affine(1n+mp, kp)), 2n))) == Some{prh(1n+mp, hi, kp)} : Maybe<&2, CS.SPoint>}:
  match kp hi:
    case CS.SPoint{+kx, +ky, +kz} False{}:
      EC.decomp(one, h1, mp, hp, s4, he, hodd, h256, FS.mmul(1n+mp, kx, FS.minv(1n+mp, kz)), FS.mmul(1n+mp, ky, FS.minv(1n+mp, kz)), NR.dm_lt(mp, Nat.mul(ky, FS.minv(1n+mp, kz))), EC.aff_on(mp, hp, kx, ky, kz, vkp, nk))
    case CS.SPoint{+kx, +ky, +kz} True{}:
      +x = FS.mmul(1n+mp, kx, FS.minv(1n+mp, kz))
      +y = FS.mmul(1n+mp, ky, FS.minv(1n+mp, kz))
      +hy = NR.dm_lt(mp, Nat.mul(ky, FS.minv(1n+mp, kz)))
      +on = EC.aff_on(mp, hp, kx, ky, kz, vkp, nk)
      +nzy = EN.nz_ne0(mp, y, G1.v_nz(mp, x, y, 1n, A1.nrm_v(mp, hp, kx, ky, kz, G1.v_onc(mp, kx, ky, kz, vkp), G1.v_nz(mp, kx, ky, kz, vkp), nk)))
      %par_flip(mp, hodd, y, hy, nzy) : {CS.decompress(1n+mp, x, _) == Some{CS.SPoint{x, FS.mneg(1n+mp, y), 1n}} : Maybe<&2, CS.SPoint>}
      EC.decomp(one, h1, mp, hp, s4, he, hodd, h256, x, FS.mneg(1n+mp, y), NR.dm_lt(mp, Nat.sub(Nat.add(0n, 1n+mp), Nat.mod(y, 1n+mp))), EV.neg_on(mp, x, y, on))
