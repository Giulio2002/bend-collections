# Multiples of a point by an addition chain in affine coordinates, for
# closed computations: every step is a doubling or an addition of two
# earlier entries, with the slope supplied as a witness (found outside, by
# tools/generators/secp256k1_group/gen_pta.py) and verified, so that a step
# costs three or four products modulo p and no inversion. The machine
# (arun) runs the register programs ch_prog / tg_prog on the verified
# binary registers of ptm.bend and tracks the scalar of every entry;
# chain_b: when all checks pass, the entry k, (x, y) is the affine point of
# [k] G (GA.of_proj of GS.smul), for every input. Nothing is trusted: a
# wrong slope fails the check.

# ---- the affine addition with a verified slope (modulus m = 1 + mp) ----

# a == l d with d nonzero: a / d == l
def div_w(+mp: Nat, +hp: PM.Prime(1n+mp), +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +l: Nat, +d: Nat, +a: Nat, +nd: F.NZ(mp, d), +hl: {FS.mmul(1n+mp, l, d) == a : Nat}, +rl: {Nat.mod(l, 1n+mp) == l : Nat}) -> {FS.mmul(1n+mp, a, FS.minv(1n+mp, d)) == l : Nat}:
  +e0 = Lg.subst(Nat, v => {FS.mmul(1n+mp, v, 1n) == FS.mmul(1n+mp, l, d) : Nat}, FS.mmul(1n+mp, l, d), a, hl, Equal.trans(Nat, Nat.mod(Nat.mul(FS.mmul(1n+mp, l, d), 1n), 1n+mp), Nat.mod(FS.mmul(1n+mp, l, d), 1n+mp), FS.mmul(1n+mp, l, d), Equal.cong(Nat, Nat, v => Nat.mod(v, 1n+mp), Nat.mul(FS.mmul(1n+mp, l, d), 1n), FS.mmul(1n+mp, l, d), NA.mul_one(FS.mmul(1n+mp, l, d))), NR.mod_mod(mp, Nat.mul(l, d))))
  Equal.trans(Nat, FS.mmul(1n+mp, a, FS.minv(1n+mp, d)), FS.mmul(1n+mp, l, FS.minv(1n+mp, 1n)), l, AF.div_eq(mp, hp, a, d, l, 1n, nd, AF.one_nz(mp, h21), e0), Equal.trans(Nat, FS.mmul(1n+mp, l, FS.minv(1n+mp, 1n)), Nat.mod(l, 1n+mp), l, A3.div1(mp, hp, h21, l), rl))

def ch_c(+mp: Nat, +hp: PM.Prime(1n+mp), +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +x1: Nat, +y1: Nat, +x2: Nat, +y2: Nat, +l: Nat, +f: Bool, +rl: {Nat.mod(l, 1n+mp) == l : Nat}, +nd: F.NZ(mp, FS.msub(1n+mp, x2, x1)), +hl: {FS.mmul(1n+mp, l, FS.msub(1n+mp, x2, x1)) == FS.msub(1n+mp, y2, y1) : Nat}, c: Bool, +hc: {Nat.is_eq(Nat.mod(x1, 1n+mp), Nat.mod(x2, 1n+mp)) == c : Bool}) -> {GA.add_pt(c, f, 1n+mp, x1, y1, x2, y2) == GA.add_lam(1n+mp, x1, y1, x2, l) : GA.APoint}:
  match c:
    case False{}:
      Equal.cong(Nat, GA.APoint, v => GA.add_lam(1n+mp, x1, y1, x2, v), FS.mmul(1n+mp, FS.msub(1n+mp, y2, y1), FS.minv(1n+mp, FS.msub(1n+mp, x2, x1))), l, div_w(mp, hp, h21, l, FS.msub(1n+mp, x2, x1), FS.msub(1n+mp, y2, y1), nd, hl, rl))
    case True{}:
      Empty.absurd({GA.add_pt(True{}, f, 1n+mp, x1, y1, x2, y2) == GA.add_lam(1n+mp, x1, y1, x2, l) : GA.APoint}, F.nz_absurd(mp, FS.msub(1n+mp, x2, x1), nd, AF.msub_cong0(mp, x2, x1, Equal.sym(Nat, Nat.mod(x1, 1n+mp), Nat.mod(x2, 1n+mp), N.eq_from_is_eq(Nat.mod(x1, 1n+mp), Nat.mod(x2, 1n+mp), hc)))))

# the chord: l (x2 - x1) == y2 - y1 with x2 - x1 nonzero
def chord_nat(+mp: Nat, +hp: PM.Prime(1n+mp), +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +x1: Nat, +y1: Nat, +x2: Nat, +y2: Nat, +l: Nat, +rl: {Nat.mod(l, 1n+mp) == l : Nat}, +nd: F.NZ(mp, FS.msub(1n+mp, x2, x1)), +hl: {FS.mmul(1n+mp, l, FS.msub(1n+mp, x2, x1)) == FS.msub(1n+mp, y2, y1) : Nat}) -> {GA.add(1n+mp, GA.APt{x1, y1}, GA.APt{x2, y2}) == GA.add_lam(1n+mp, x1, y1, x2, l) : GA.APoint}:
  ch_c(mp, hp, h21, x1, y1, x2, y2, l, Bool.and(Nat.is_eq(Nat.mod(y1, 1n+mp), Nat.mod(y2, 1n+mp)), Bool.not(Nat.is_eq(Nat.mod(y1, 1n+mp), 0n))), rl, nd, hl, Nat.is_eq(Nat.mod(x1, 1n+mp), Nat.mod(x2, 1n+mp)), {==})

def ny_c(+mp: Nat, +y: Nat, +nd: F.NZ(mp, FS.mmul(1n+mp, 2n, y)), c: Bool, +hc: {Nat.is_eq(Nat.mod(y, 1n+mp), 0n) == c : Bool}) -> F.NZ(mp, y):
  match c:
    case False{}:
      hc
    case True{}:
      Empty.absurd(F.NZ(mp, y), F.nz_absurd(mp, FS.mmul(1n+mp, 2n, y), nd, F.z_mmul_r(mp, 2n, y, N.eq_from_is_eq(Nat.mod(y, 1n+mp), 0n, hc))))

# the tangent: l (2 y) == 3 x^2 with 2 y nonzero
def tangent_nat(+mp: Nat, +hp: PM.Prime(1n+mp), +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +x: Nat, +y: Nat, +l: Nat, +rl: {Nat.mod(l, 1n+mp) == l : Nat}, +nd: F.NZ(mp, FS.mmul(1n+mp, 2n, y)), +hl: {FS.mmul(1n+mp, l, FS.mmul(1n+mp, 2n, y)) == FS.mmul(1n+mp, 3n, FS.mmul(1n+mp, x, x)) : Nat}) -> {GA.add(1n+mp, GA.APt{x, y}, GA.APt{x, y}) == GA.add_lam(1n+mp, x, y, x, l) : GA.APoint}:
  Lg.subst(Bool, b => {GA.add_pt(b, Bool.and(Nat.is_eq(Nat.mod(y, 1n+mp), Nat.mod(y, 1n+mp)), Bool.not(Nat.is_eq(Nat.mod(y, 1n+mp), 0n))), 1n+mp, x, y, x, y) == GA.add_lam(1n+mp, x, y, x, l) : GA.APoint}, True{}, Nat.is_eq(Nat.mod(x, 1n+mp), Nat.mod(x, 1n+mp)), Equal.sym(Bool, Nat.is_eq(Nat.mod(x, 1n+mp), Nat.mod(x, 1n+mp)), True{}, N.is_eq_refl(Nat.mod(x, 1n+mp))),
    Lg.subst(Bool, b => {GA.add_pt(True{}, Bool.and(b, Bool.not(Nat.is_eq(Nat.mod(y, 1n+mp), 0n))), 1n+mp, x, y, x, y) == GA.add_lam(1n+mp, x, y, x, l) : GA.APoint}, True{}, Nat.is_eq(Nat.mod(y, 1n+mp), Nat.mod(y, 1n+mp)), Equal.sym(Bool, Nat.is_eq(Nat.mod(y, 1n+mp), Nat.mod(y, 1n+mp)), True{}, N.is_eq_refl(Nat.mod(y, 1n+mp))),
      Lg.subst(Bool, b => {GA.add_pt(True{}, Bool.and(True{}, Bool.not(b)), 1n+mp, x, y, x, y) == GA.add_lam(1n+mp, x, y, x, l) : GA.APoint}, False{}, Nat.is_eq(Nat.mod(y, 1n+mp), 0n), Equal.sym(Bool, Nat.is_eq(Nat.mod(y, 1n+mp), 0n), False{}, ny_c(mp, y, nd, Nat.is_eq(Nat.mod(y, 1n+mp), 0n), {==})),
        Equal.cong(Nat, GA.APoint, v => GA.add_lam(1n+mp, x, y, x, v), FS.mmul(1n+mp, FS.mmul(1n+mp, 3n, FS.mmul(1n+mp, x, x)), FS.minv(1n+mp, FS.mmul(1n+mp, 2n, y))), l, div_w(mp, hp, h21, l, FS.mmul(1n+mp, 2n, y), FS.mmul(1n+mp, 3n, FS.mmul(1n+mp, x, x)), nd, hl, rl)))))

# [a] G and [b] G with affine points p1 and p2: [a + b] G has the affine point p1 + p2
def grp(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +g: CS.SPoint, +vg: {GS.valid(1n+mp, g) == True{} : Bool}, +a: Nat, +b: Nat, +p1: GA.APoint, +p2: GA.APoint, +r: GA.APoint, +h1: {GA.of_proj(1n+mp, GS.smul(1n+mp, a, g)) == p1 : GA.APoint}, +h2: {GA.of_proj(1n+mp, GS.smul(1n+mp, b, g)) == p2 : GA.APoint}, +ha: {GA.add(1n+mp, p1, p2) == r : GA.APoint}) -> {GA.of_proj(1n+mp, GS.smul(1n+mp, Nat.add(a, b), g)) == r : GA.APoint}:
  +va = G4.v_smul(mp, hp, h3, hnc, h21, a, g, vg)
  +vb = G4.v_smul(mp, hp, h3, hnc, h21, b, g, vg)
  Equal.trans(GA.APoint, GA.of_proj(1n+mp, GS.smul(1n+mp, Nat.add(a, b), g)), GA.of_proj(1n+mp, CS.padd(1n+mp, GS.smul(1n+mp, a, g), GS.smul(1n+mp, b, g))), r, A1.aff_eqv(mp, hp, GS.smul(1n+mp, Nat.add(a, b), g), CS.padd(1n+mp, GS.smul(1n+mp, a, g), GS.smul(1n+mp, b, g)), G4.v_smul(mp, hp, h3, hnc, h21, Nat.add(a, b), g, vg), G1.v_add(mp, hp, h3, hnc, h21, GS.smul(1n+mp, a, g), GS.smul(1n+mp, b, g), va, vb), G4.smul_add(mp, hp, h3, hnc, h21, a, b, g, vg)),
    Equal.trans(GA.APoint, GA.of_proj(1n+mp, CS.padd(1n+mp, GS.smul(1n+mp, a, g), GS.smul(1n+mp, b, g))), GA.add(1n+mp, GA.of_proj(1n+mp, GS.smul(1n+mp, a, g)), GA.of_proj(1n+mp, GS.smul(1n+mp, b, g))), r, A2.corr(mp, hp, h3, hnc, h21, GS.smul(1n+mp, a, g), GS.smul(1n+mp, b, g), va, vb),
      Lg.subst(GA.APoint, q => {GA.add(1n+mp, q, GA.of_proj(1n+mp, GS.smul(1n+mp, b, g))) == r : GA.APoint}, p1, GA.of_proj(1n+mp, GS.smul(1n+mp, a, g)), Equal.sym(GA.APoint, GA.of_proj(1n+mp, GS.smul(1n+mp, a, g)), p1, h1), Lg.subst(GA.APoint, q => {GA.add(1n+mp, p1, q) == r : GA.APoint}, p2, GA.of_proj(1n+mp, GS.smul(1n+mp, b, g)), Equal.sym(GA.APoint, GA.of_proj(1n+mp, GS.smul(1n+mp, b, g)), p2, h2), ha))))

# ---- the machine ----

# an entry: the scalar k and the affine point of [k] G
type AE is Data:
  AE{k: B.Bn, x: B.Bn, y: B.Bn}

# a step: double entry i, or add entries i and j; l is the slope
type AS is Data:
  AD{i: Nat, l: B.Bn}
  AA{i: Nat, j: Nat, l: B.Bn}

type AR is Data:
  AR{e: AE, ok: Bool}

type AQ is Data:
  AQ{es: List<&2, AE>, ok: Bool}

def are(r: AR) -> AE:
  match r:
    case AR{e, ok}:
      e

def ark(r: AR) -> Bool:
  match r:
    case AR{e, ok}:
      ok

def aqe(r: AQ) -> List<&2, AE>:
  match r:
    case AQ{es, ok}:
      es

def aqk(r: AQ) -> Bool:
  match r:
    case AQ{es, ok}:
      ok

def enth(i: Nat, +d: AE, es: List<&2, AE>) -> AE:
  match i es:
    case _ Nil{}:
      d
    case 0n e <> t:
      e
    case 1n+k e <> t:
      enth(k, d, t)

def two() -> B.Bn:
  B.B0{B.B1{B.BZ{}}}

def three() -> B.Bn:
  B.B1{B.B1{B.BZ{}}}

# registers x1 y1 x2 y2 l: d = x2 - x1, e = y2 - y1, l d, l^2, l^2 - x1, x3, x1 - x3, l (x1 - x3), y3
def ch_prog() -> List<&2, CS.SOp>:
  [CS.SSub{2n, 0n}, CS.SSub{3n, 1n}, CS.SMul{4n, 5n}, CS.SMul{4n, 4n}, CS.SSub{8n, 0n}, CS.SSub{9n, 2n}, CS.SSub{0n, 10n}, CS.SMul{4n, 11n}, CS.SSub{12n, 1n}]

# registers x y l 2 3: x^2, 3 x^2, 2 y, l (2 y), l^2, l^2 - x, x3, x - x3, l (x - x3), y3
def tg_prog() -> List<&2, CS.SOp>:
  [CS.SMul{0n, 0n}, CS.SMul{4n, 5n}, CS.SMul{3n, 1n}, CS.SMul{2n, 7n}, CS.SMul{2n, 2n}, CS.SSub{9n, 0n}, CS.SSub{10n, 0n}, CS.SSub{0n, 11n}, CS.SMul{2n, 12n}, CS.SSub{13n, 1n}]

# d != 0, as d == (d - 1) + 1
def nzk(+d: B.Bn) -> Bool:
  B.beq(d, B.binc(X.bdec(d)))

def afa(+k: B.Bn, +l: B.Bn, +p: B.Bn, r: M.RR) -> AR:
  match r:
    case M.RR{+regs, ok}:
      AR{AE{k, M.bnth(10n, regs), M.bnth(13n, regs)}, Bool.and(ok, Bool.and(M.ltk(l, p), Bool.and(B.beq(M.bnth(7n, regs), M.bnth(6n, regs)), nzk(M.bnth(5n, regs)))))}

def aadd(+c: B.Bn, +p: B.Bn, e1: AE, e2: AE, +l: B.Bn) -> AR:
  match e1 e2:
    case AE{k1, x1, y1} AE{k2, x2, y2}:
      afa(B.badd(k1, k2), l, p, M.brun(ch_prog(), c, p, M.RR{[x1, y1, x2, y2, l], True{}}))

def afd(+k: B.Bn, +l: B.Bn, +p: B.Bn, r: M.RR) -> AR:
  match r:
    case M.RR{+regs, ok}:
      AR{AE{k, M.bnth(11n, regs), M.bnth(14n, regs)}, Bool.and(ok, Bool.and(M.ltk(l, p), Bool.and(B.beq(M.bnth(8n, regs), M.bnth(6n, regs)), nzk(M.bnth(7n, regs)))))}

def adbl(+c: B.Bn, +p: B.Bn, e: AE, +l: B.Bn) -> AR:
  match e:
    case AE{+k, x, y}:
      afd(B.badd(k, k), l, p, M.brun(tg_prog(), c, p, M.RR{[x, y, l, two(), three()], True{}}))

def aexec(s: AS, +c: B.Bn, +p: B.Bn, +d: AE, +es: List<&2, AE>) -> AR:
  match s:
    case AD{i, l}:
      adbl(c, p, enth(i, d, es), l)
    case AA{i, j, l}:
      aadd(c, p, enth(i, d, es), enth(j, d, es), l)

def astp(+es: List<&2, AE>, ok: Bool, r: AR) -> AQ:
  match r:
    case AR{e, k}:
      AQ{List.append(&2, AE, es, [e]), Bool.and(ok, k)}

def arun(steps: List<&2, AS>, +c: B.Bn, +p: B.Bn, +d: AE, r: AQ) -> AQ:
  match steps r:
    case Nil{} r2:
      r2
    case s <> t AQ{+es, ok}:
      arun(t, c, p, d, astp(es, ok, aexec(s, c, p, d, es)))

def aeq(e: AE, +kn: B.Bn, +ex: B.Bn, +ey: B.Bn) -> Bool:
  match e:
    case AE{k, x, y}:
      Bool.and(B.beq(k, kn), Bool.and(B.beq(x, ex), B.beq(y, ey)))

def afin(r: AQ, +d: AE, +idx: Nat, +kn: B.Bn, +ex: B.Bn, +ey: B.Bn) -> Bool:
  match r:
    case AQ{es, ok}:
      Bool.and(ok, aeq(enth(idx, d, es), kn, ex, ey))

# the closed check: the chain from [d] runs and entry idx is kn, (ex, ey)
def acheck(+steps: List<&2, AS>, +c: B.Bn, +p: B.Bn, +d: AE, +idx: Nat, +kn: B.Bn, +ex: B.Bn, +ey: B.Bn) -> Bool:
  afin(arun(steps, c, p, d, AQ{[d], True{}}), d, idx, kn, ex, ey)

# ---- the invariant ----

# the entry is reduced and is the affine point of [k] G
def PE(+mp: Nat, +p: B.Bn, +g: CS.SPoint, e: AE) -> Data:
  match e:
    case AE{+k, +x, +y}:
      S.Both<{Bool.and(M.ltk(x, p), M.ltk(y, p)) == True{} : Bool}, {GA.of_proj(1n+mp, GS.smul(1n+mp, B.bval(k), g)) == GA.APt{B.bval(x), B.bval(y)} : GA.APoint}>

def Inv(+mp: Nat, +p: B.Bn, +g: CS.SPoint, es: List<&2, AE>) -> Data:
  match es:
    case Nil{}:
      Unit
    case +e <> t:
      S.Both<PE(mp, p, g, e), Inv(mp, p, g, t)>

def inv_nth(+mp: Nat, +p: B.Bn, +g: CS.SPoint, i: Nat, +d: AE, es: List<&2, AE>, hd: PE(mp, p, g, d), hi: Inv(mp, p, g, es)) -> PE(mp, p, g, enth(i, d, es)):
  match i es:
    case 0n Nil{}:
      hd
    case 1n+k Nil{}:
      hd
    case 0n e <> t:
      S.Both{h, r} = hi
      h
    case 1n+k e <> t:
      S.Both{h, r} = hi
      inv_nth(mp, p, g, k, d, t, hd, r)

def inv_app(+mp: Nat, +p: B.Bn, +g: CS.SPoint, es: List<&2, AE>, +e: AE, hi: Inv(mp, p, g, es), he: PE(mp, p, g, e)) -> Inv(mp, p, g, List.append(&2, AE, es, [e])):
  match es:
    case Nil{}:
      S.Both{he, Unit{}}
    case x <> t:
      S.Both{h, r} = hi
      S.Both{h, inv_app(mp, p, g, t, e, r, he)}

# ---- one step ----

def regv(+w: List<&2, Nat>, +rf: List<&2, B.Bn>, +i: Nat, +ev: {w == M.vals(rf) : List<&2, Nat>}) -> {CS.nth(i, w) == B.bval(M.bnth(i, rf)) : Nat}:
  Equal.trans(Nat, CS.nth(i, w), CS.nth(i, M.vals(rf)), B.bval(M.bnth(i, rf)), Equal.cong(List<&2, Nat>, Nat, q => CS.nth(i, q), w, M.vals(rf), ev), M.nth_vals(i, rf))

def nz_1(+v: Nat) -> {Nat.is_eq(1n+v, 0n) == False{} : Bool}:
  {==}

def nz_b(+mp: Nat, +r: B.Bn, +hz: {nzk(r) == True{} : Bool}, +hl: {Nat.is_lt(B.bval(r), 1n+mp) == True{} : Bool}) -> F.NZ(mp, B.bval(r)):
  Lg.subst(Nat, v => {Nat.is_eq(v, 0n) == False{} : Bool}, B.bval(r), Nat.mod(B.bval(r), 1n+mp), Equal.sym(Nat, Nat.mod(B.bval(r), 1n+mp), B.bval(r), NR.mod_of(0n, mp, B.bval(r), hl)),
    Lg.subst(Nat, v => {Nat.is_eq(v, 0n) == False{} : Bool}, 1n+B.bval(X.bdec(r)), B.bval(r), Equal.sym(Nat, B.bval(r), 1n+B.bval(X.bdec(r)), Equal.trans(Nat, B.bval(r), B.bval(B.binc(X.bdec(r))), 1n+B.bval(X.bdec(r)), B.beq_v(r, B.binc(X.bdec(r)), hz), B.binc_v(X.bdec(r)))), nz_1(B.bval(X.bdec(r)))))

def afa_e(+k: B.Bn, +l: B.Bn, +p: B.Bn, r: M.RR) -> {are(afa(k, l, p, r)) == AE{k, M.bnth(10n, M.rrr(r)), M.bnth(13n, M.rrr(r))} : AE}:
  match r:
    case M.RR{regs, ok}:
      {==}

def afa_k(+k: B.Bn, +l: B.Bn, +p: B.Bn, r: M.RR, +h: {ark(afa(k, l, p, r)) == True{} : Bool}) -> {Bool.and(M.rrk(r), Bool.and(M.ltk(l, p), Bool.and(B.beq(M.bnth(7n, M.rrr(r)), M.bnth(6n, M.rrr(r))), nzk(M.bnth(5n, M.rrr(r)))))) == True{} : Bool}:
  match r:
    case M.RR{+regs, +ok}:
      h

def afd_e(+k: B.Bn, +l: B.Bn, +p: B.Bn, r: M.RR) -> {are(afd(k, l, p, r)) == AE{k, M.bnth(11n, M.rrr(r)), M.bnth(14n, M.rrr(r))} : AE}:
  match r:
    case M.RR{regs, ok}:
      {==}

