def astp_eq(+es: List<&2, AE>, +ok: Bool, r: AR) -> {astp(es, ok, r) == AQ{List.append(&2, AE, es, [are(r)]), Bool.and(ok, ark(r))} : AQ}:
  match r:
    case AR{e, k}:
      {==}

def arun_ok(steps: List<&2, AS>, +c: B.Bn, +p: B.Bn, +d: AE, +es: List<&2, AE>, +ok: Bool, +h: {aqk(arun(steps, c, p, d, AQ{es, ok})) == True{} : Bool}) -> {ok == True{} : Bool}:
