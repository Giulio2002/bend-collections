      Lg.and_left(ok, aeq(enth(idx, d, es), kn, ex, ey), h)

def afin_e(r: AQ, +d: AE, +idx: Nat, +kn: B.Bn, +ex: B.Bn, +ey: B.Bn, +h: {afin(r, d, idx, kn, ex, ey) == True{} : Bool}) -> {aeq(enth(idx, d, aqe(r)), kn, ex, ey) == True{} : Bool}:
