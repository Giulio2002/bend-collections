    Equal.trans(Nat, B.bval(p), B.bval(B.binc(p1)), 1n+X.bvalo(one, p1), B.beq_v(p, B.binc(p1), hn), Equal.trans(Nat, B.bval(B.binc(p1)), 1n+B.bval(p1), 1n+X.bvalo(one, p1), B.binc_v(p1), Equal.cong(Nat, Nat, v => 1n+v, B.bval(p1), X.bvalo(one, p1), bo_s(one, h1, p1)))),
    Equal.trans(Nat, B.bval(CB.bshl(256n, B.B1{B.BZ{}})), B.bval(B.badd(p, c)), Nat.add(B.bval(p), B.bval(c)), B.beq_v(CB.bshl(256n, B.B1{B.BZ{}}), B.badd(p, c), hwk), B.badd_v(p, c)),
    hz0, h2p, h3p, gx, gy, steps, idx, kn, ex, ey, X.bvalo(one, gx), X.bvalo(one, gy), X.bvalo(one, kn), X.bvalo(one, ex), X.bvalo(one, ey), bo_s(one, h1, gx), bo_s(one, h1, gy), bo_s(one, h1, kn), bo_s(one, h1, ex), bo_s(one, h1, ey), hgx, hgy, vg, hc)
