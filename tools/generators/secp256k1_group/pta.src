  fin_e(mp, p, CS.SPoint{B.bval(gx), B.bval(gy), 1n}, enth(idx, AE{B.B1{B.BZ{}}, gx, gy}, aqe(arun(steps, c, p, AE{B.B1{B.BZ{}}, gx, gy}, AQ{[AE{B.B1{B.BZ{}}, gx, gy}], True{}}))), kn, ex, ey, inv_nth(mp, p, CS.SPoint{B.bval(gx), B.bval(gy), 1n}, idx, AE{B.B1{B.BZ{}}, gx, gy}, aqe(arun(steps, c, p, AE{B.B1{B.BZ{}}, gx, gy}, AQ{[AE{B.B1{B.BZ{}}, gx, gy}], True{}})), hd, inv), afin_e(arun(steps, c, p, AE{B.B1{B.BZ{}}, gx, gy}, AQ{[AE{B.B1{B.BZ{}}, gx, gy}], True{}}), AE{B.B1{B.BZ{}}, gx, gy}, idx, kn, ex, ey, hc))

# the same with the values named (vgx == B.bval(gx), ...)
def chain_n(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +c: B.Bn, +p: B.Bn, +hm: {B.bval(p) == 1n+mp : Nat}, +hw: {B.bval(CB.bshl(256n, B.B1{B.BZ{}})) == Nat.add(B.bval(p), B.bval(c)) : Nat}, +hz0: {M.ltk(B.BZ{}, p) == True{} : Bool}, +h2p: {M.ltk(two(), p) == True{} : Bool}, +h3p: {M.ltk(three(), p) == True{} : Bool}, +gx: B.Bn, +gy: B.Bn, +steps: List<&2, AS>, +idx: Nat, +kn: B.Bn, +ex: B.Bn, +ey: B.Bn, +vgx: Nat, +vgy: Nat, +vkn: Nat, +vex: Nat, +vey: Nat, +egx: {B.bval(gx) == vgx : Nat}, +egy: {B.bval(gy) == vgy : Nat}, +ekn: {B.bval(kn) == vkn : Nat}, +eex: {B.bval(ex) == vex : Nat}, +eey: {B.bval(ey) == vey : Nat}, +hgx: {M.ltk(gx, p) == True{} : Bool}, +hgy: {M.ltk(gy, p) == True{} : Bool}, +vg: {GS.valid(1n+mp, CS.SPoint{vgx, vgy, 1n}) == True{} : Bool}, +hc: {acheck(steps, c, p, AE{B.B1{B.BZ{}}, gx, gy}, idx, kn, ex, ey) == True{} : Bool}) -> {GA.of_proj(1n+mp, GS.smul(1n+mp, vkn, CS.SPoint{vgx, vgy, 1n})) == GA.APt{vex, vey} : GA.APoint}:
  Lg.subst(Nat, v => {GA.of_proj(1n+mp, GS.smul(1n+mp, vkn, CS.SPoint{vgx, vgy, 1n})) == GA.APt{vex, v} : GA.APoint}, B.bval(ey), vey, eey, Lg.subst(Nat, v => {GA.of_proj(1n+mp, GS.smul(1n+mp, vkn, CS.SPoint{vgx, vgy, 1n})) == GA.APt{v, B.bval(ey)} : GA.APoint}, B.bval(ex), vex, eex, Lg.subst(Nat, v => {GA.of_proj(1n+mp, GS.smul(1n+mp, v, CS.SPoint{vgx, vgy, 1n})) == GA.APt{B.bval(ex), B.bval(ey)} : GA.APoint}, B.bval(kn), vkn, ekn, Lg.subst(Nat, v => {GA.of_proj(1n+mp, GS.smul(1n+mp, B.bval(kn), CS.SPoint{vgx, v, 1n})) == GA.APt{B.bval(ex), B.bval(ey)} : GA.APoint}, B.bval(gy), vgy, egy, Lg.subst(Nat, v => {GA.of_proj(1n+mp, GS.smul(1n+mp, B.bval(kn), CS.SPoint{v, B.bval(gy), 1n})) == GA.APt{B.bval(ex), B.bval(ey)} : GA.APoint}, B.bval(gx), vgx, egx, chain_b(mp, hp, h3, hnc, h21, c, p, hm, hw, hz0, h2p, h3p, gx, gy, hgx, hgy, Lg.subst(Nat, v => {GS.valid(1n+mp, CS.SPoint{v, B.bval(gy), 1n}) == True{} : Bool}, vgx, B.bval(gx), Equal.sym(Nat, B.bval(gx), vgx, egx), Lg.subst(Nat, v => {GS.valid(1n+mp, CS.SPoint{vgx, v, 1n}) == True{} : Bool}, vgy, B.bval(gy), Equal.sym(Nat, B.bval(gy), vgy, egy), vg)), steps, idx, kn, ex, ey, hc))))))

def bo_s(+one: Nat, +h1: {one == 1n : Nat}, +a: B.Bn) -> {B.bval(a) == X.bvalo(one, a) : Nat}:
  Equal.sym(Nat, X.bvalo(one, a), B.bval(a), X.bo(one, h1, a))

# the same on X.bvalo (values stuck on `one`, never expanded), modulus 1 + X.bvalo(one, p1)
def chain_o(+one: Nat, +h1: {one == 1n : Nat}, +p: B.Bn, +p1: B.Bn, +c: B.Bn, +hp: PM.Prime(1n+X.bvalo(one, p1)), +h3: {Nat.mod(X.bvalo(one, p1), 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+X.bvalo(one, p1), 7n), Nat.div(X.bvalo(one, p1), 3n)), 1n+X.bvalo(one, p1)), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+X.bvalo(one, p1)) == True{} : Bool}, +hn: {B.beq(p, B.binc(p1)) == True{} : Bool}, +hwk: {B.beq(CB.bshl(256n, B.B1{B.BZ{}}), B.badd(p, c)) == True{} : Bool}, +hz0: {M.ltk(B.BZ{}, p) == True{} : Bool}, +h2p: {M.ltk(two(), p) == True{} : Bool}, +h3p: {M.ltk(three(), p) == True{} : Bool}, +gx: B.Bn, +gy: B.Bn, +hgx: {M.ltk(gx, p) == True{} : Bool}, +hgy: {M.ltk(gy, p) == True{} : Bool}, +vg: {GS.valid(1n+X.bvalo(one, p1), CS.SPoint{X.bvalo(one, gx), X.bvalo(one, gy), 1n}) == True{} : Bool}, +steps: List<&2, AS>, +idx: Nat, +kn: B.Bn, +ex: B.Bn, +ey: B.Bn, +hc: {acheck(steps, c, p, AE{B.B1{B.BZ{}}, gx, gy}, idx, kn, ex, ey) == True{} : Bool}) -> {GA.of_proj(1n+X.bvalo(one, p1), GS.smul(1n+X.bvalo(one, p1), X.bvalo(one, kn), CS.SPoint{X.bvalo(one, gx), X.bvalo(one, gy), 1n})) == GA.APt{X.bvalo(one, ex), X.bvalo(one, ey)} : GA.APoint}:
