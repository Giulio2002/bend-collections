# ---- (beta X : Y : Z) and a literal point are the same projective point ----

# registers beta, gx, gy, gz, lx, ly, lz: beta gx, (beta gx) ly, lx gy, gz ly, lz gy
def xc_prog() -> List<&2, CS.SOp>:
  [CS.SMul{0n, 1n}, CS.SMul{7n, 5n}, CS.SMul{4n, 2n}, CS.SMul{3n, 5n}, CS.SMul{6n, 2n}]

def xfin(r: M.RR) -> Bool:
  match r:
    case M.RR{+regs, ok}:
      Bool.and(ok, Bool.and(B.beq(M.bnth(8n, regs), M.bnth(9n, regs)), B.beq(M.bnth(10n, regs), M.bnth(11n, regs))))

def xck(+c: B.Bn, +p: B.Bn, +be: B.Bn, +gx: B.Bn, +gy: B.Bn, +gz: B.Bn, +lx: B.Bn, +ly: B.Bn, +lz: B.Bn) -> Bool:
  xfin(M.brun(xc_prog(), c, p, M.RR{[be, gx, gy, gz, lx, ly, lz], True{}}))

