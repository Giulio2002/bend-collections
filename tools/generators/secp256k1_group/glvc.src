  %X.mul_o(one, h1, lamkl(), CB.nl()) : {Nat.add(Nat.add(Nat.mul(X.bvalo(one, laml()), X.bvalo(one, laml())), X.bvalo(one, laml())), 1n) == _ : Nat}
  %X.one_o(one, h1) : {Nat.add(Nat.add(Nat.mul(X.bvalo(one, laml()), X.bvalo(one, laml())), X.bvalo(one, laml())), _) == X.bvalo(one, B.bmul(lamkl(), CB.nl())) : Nat}
  %X.mul_o(one, h1, laml(), laml()) : {Nat.add(Nat.add(_, X.bvalo(one, laml())), X.bvalo(one, B.B1{B.BZ{}})) == X.bvalo(one, B.bmul(lamkl(), CB.nl())) : Nat}
