# ---- beta^3 == 1 ----

def cb_prog() -> List<&2, CS.SOp>:
  [CS.SMul{0n, 0n}, CS.SMul{1n, 0n}]

def cfin(r: M.RR) -> Bool:
  match r:
    case M.RR{+regs, ok}:
      Bool.and(ok, B.beq(M.bnth(2n, regs), B.B1{B.BZ{}}))

def cck(+c: B.Bn, +p: B.Bn, +b: B.Bn) -> Bool:
  cfin(M.brun(cb_prog(), c, p, M.RR{[b], True{}}))

def cb_b(+p: B.Bn, +p1: B.Bn, +c: B.Bn, +b: B.Bn, +hn: {B.beq(p, B.binc(p1)) == True{} : Bool}, +hwk: {B.beq(CB.bshl(256n, B.B1{B.BZ{}}), B.badd(p, c)) == True{} : Bool}, +hb: {M.ltk(b, p) == True{} : Bool}, +hc: {cck(c, p, b) == True{} : Bool}) -> {FS.mmul(1n+B.bval(p1), FS.mmul(1n+B.bval(p1), B.bval(b), B.bval(b)), B.bval(b)) == 1n : Nat}:
  +ev = M.brun_v(cb_prog(), c, p, B.bval(p1), [b], True{}, Equal.trans(Nat, B.bval(p), B.bval(B.binc(p1)), 1n+B.bval(p1), B.beq_v(p, B.binc(p1), hn), B.binc_v(p1)), Equal.trans(Nat, B.bval(CB.bshl(256n, B.B1{B.BZ{}})), B.bval(B.badd(p, c)), Nat.add(B.bval(p), B.bval(c)), B.beq_v(CB.bshl(256n, B.B1{B.BZ{}}), B.badd(p, c), hwk), B.badd_v(p, c)), Lg.and_intro(M.ltk(b, p), True{}, hb, {==}), Lg.and_left(M.rrk(M.brun(cb_prog(), c, p, M.RR{[b], True{}})), B.beq(M.bnth(2n, M.rrr(M.brun(cb_prog(), c, p, M.RR{[b], True{}}))), B.B1{B.BZ{}}), hc))
  Equal.trans(Nat, CS.nth(2n, CS.run_go(1n+B.bval(p1), cb_prog(), M.vals([b]))), CS.nth(2n, M.vals(M.rrr(M.brun(cb_prog(), c, p, M.RR{[b], True{}})))), 1n, Equal.cong(List<&2, Nat>, Nat, l => CS.nth(2n, l), CS.run_go(1n+B.bval(p1), cb_prog(), M.vals([b])), M.vals(M.rrr(M.brun(cb_prog(), c, p, M.RR{[b], True{}}))), ev),
    Equal.trans(Nat, CS.nth(2n, M.vals(M.rrr(M.brun(cb_prog(), c, p, M.RR{[b], True{}})))), B.bval(M.bnth(2n, M.rrr(M.brun(cb_prog(), c, p, M.RR{[b], True{}})))), 1n, M.nth_vals(2n, M.rrr(M.brun(cb_prog(), c, p, M.RR{[b], True{}}))), B.beq_v(M.bnth(2n, M.rrr(M.brun(cb_prog(), c, p, M.RR{[b], True{}}))), B.B1{B.BZ{}}, Lg.and_right(M.rrk(M.brun(cb_prog(), c, p, M.RR{[b], True{}})), B.beq(M.bnth(2n, M.rrr(M.brun(cb_prog(), c, p, M.RR{[b], True{}}))), B.B1{B.BZ{}}), hc))))

def cb_o(+one: Nat, +h1: {one == 1n : Nat}, +p: B.Bn, +p1: B.Bn, +c: B.Bn, +b: B.Bn, +hn: {B.beq(p, B.binc(p1)) == True{} : Bool}, +hwk: {B.beq(CB.bshl(256n, B.B1{B.BZ{}}), B.badd(p, c)) == True{} : Bool}, +hb: {M.ltk(b, p) == True{} : Bool}, +hc: {cck(c, p, b) == True{} : Bool}) -> {FS.mmul(1n+X.bvalo(one, p1), FS.mmul(1n+X.bvalo(one, p1), X.bvalo(one, b), X.bvalo(one, b)), X.bvalo(one, b)) == 1n : Nat}:
  Lg.subst(Nat, z => {FS.mmul(1n+X.bvalo(one, p1), FS.mmul(1n+X.bvalo(one, p1), z, z), z) == 1n : Nat}, B.bval(b), X.bvalo(one, b), Equal.sym(Nat, X.bvalo(one, b), B.bval(b), X.bo(one, h1, b)),
    Lg.subst(Nat, z => {FS.mmul(1n+z, FS.mmul(1n+z, B.bval(b), B.bval(b)), B.bval(b)) == 1n : Nat}, B.bval(p1), X.bvalo(one, p1), Equal.sym(Nat, X.bvalo(one, p1), B.bval(p1), X.bo(one, h1, p1)), cb_b(p, p1, c, b, hn, hwk, hb, hc)))

# beta^3 == 1 in GF(p) (modulus 1 + pm)
def beta_cube_m(+one: Nat, +h1: {one == 1n : Nat}) -> {FS.mmul(1n+X.bvalo(one, CB.p1l()), FS.mmul(1n+X.bvalo(one, CB.p1l()), X.bvalo(one, betal()), X.bvalo(one, betal())), X.bvalo(one, betal())) == 1n : Nat}:
  cb_o(one, h1, CB.pl(), CB.p1l(), PC.cl(), betal(), PC.hn_p(), PC.hw_p(), {==}, {==})

# beta^3 == 1 in GF(p)
def beta_cube(+one: Nat, +h1: {one == 1n : Nat}) -> {FS.mmul(FS.prime(one), FS.mmul(FS.prime(one), X.bvalo(one, betal()), X.bvalo(one, betal())), X.bvalo(one, betal())) == 1n : Nat}:
  Lg.subst(Nat, q => {FS.mmul(q, FS.mmul(q, X.bvalo(one, betal()), X.bvalo(one, betal())), X.bvalo(one, betal())) == 1n : Nat}, 1n+X.bvalo(one, CB.p1l()), FS.prime(one), Equal.sym(Nat, FS.prime(one), 1n+X.bvalo(one, CB.p1l()), CB.p_suc(one, h1)), beta_cube_m(one, h1))

