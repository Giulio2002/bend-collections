import Base
import ../../../../spec/lib/common.bend as C
import ../../../../spec/crypto/curve25519/field.bend as FS
import ../../../../spec/crypto/ed25519.bend as ED
import ./lite/lib/lemmas/proofs/nat_algebra.bend as NA
import ./lite/math/typed/width.bend as WW
import ../../secp256k1/semiring.bend as SR
import ./lite/lib/nat.bend as N
import ../../secp256k1/group/bn.bend as B
import ../../secp256k1/group/bnx.bend as X
import ../../../lib/logic.bend as Lg
import ./pfacts.bend as PF

# The group order of edwards25519 as a binary literal: X.bvalo(one, PF.ll())
# is the specification's ED.ell(one) (its 32 little-endian bytes, each
# scaled by the symbolic one). Apart from pfacts.bend because it needs the
# Ed25519 specification, which the facts about p do not.

def umatch(ds: List<&2, B.Bn>, xs: List<&2, U32>) -> Bool:
  match ds xs:
    case Nil{} Nil{}:
      True{}
    case Nil{} x <> u:
      False{}
    case d <> t Nil{}:
      False{}
    case d <> t x <> u:
      Bool.and(Nat.is_eq(B.bval(d), U32.to_nat(x)), umatch(t, u))

# the literal of FS.uvalue
def udig_o(+one: Nat, +h1: {one == 1n : Nat}, ds: List<&2, B.Bn>, xs: List<&2, U32>, +h: {umatch(ds, xs) == True{} : Bool}) -> {X.bvalo(one, PF.bdig(ds)) == FS.uvalue(one, xs) : Nat}:
  match ds xs:
    case Nil{} Nil{}:
      {==}
    case Nil{} x <> u:
      Empty.absurd({X.bvalo(one, PF.bdig(Nil{})) == FS.uvalue(one, x <> u) : Nat}, Lg.false_true(h))
    case d <> t Nil{}:
      Empty.absurd({X.bvalo(one, PF.bdig(d <> t)) == FS.uvalue(one, Nil{}) : Nat}, Lg.false_true(h))
    case +d <> +t +x <> +u:
      %goal {X.bvalo(one, B.badd(d, PF.bshl(8n, PF.bdig(t)))) == Nat.add(Nat.mul(one, U32.to_nat(x)), C.shift(8n, FS.uvalue(one, u))) : Nat}
      %rw X.add_o(one, h1, d, PF.bshl(8n, PF.bdig(t)))
      %rw PF.shl_o(one, 8n, PF.bdig(t))
      %rw udig_o(one, h1, t, u, Lg.and_right(Nat.is_eq(B.bval(d), U32.to_nat(x)), umatch(t, u), h))
      %rw X.lit_o(one, h1, d, U32.to_nat(x), N.eq_from_is_eq(B.bval(d), U32.to_nat(x), Lg.and_left(Nat.is_eq(B.bval(d), U32.to_nat(x)), umatch(t, u), h)))
      %rw PF.dmul(one, h1, U32.to_nat(x))
      %close

# L's little-endian bytes
def lbl() -> List<&2, B.Bn>:
  [B.B1{B.B0{B.B1{B.B1{B.B0{B.B1{B.B1{B.B1{B.BZ{}}}}}}}}}, B.B1{B.B1{B.B0{B.B0{B.B1{B.B0{B.B1{B.B1{B.BZ{}}}}}}}}}, B.B1{B.B0{B.B1{B.B0{B.B1{B.B1{B.B1{B.B1{B.BZ{}}}}}}}}}, B.B0{B.B0{B.B1{B.B1{B.B1{B.B0{B.B1{B.BZ{}}}}}}}}, B.B0{B.B1{B.B0{B.B1{B.B1{B.BZ{}}}}}}, B.B1{B.B1{B.B0{B.B0{B.B0{B.B1{B.B1{B.BZ{}}}}}}}}, B.B0{B.B1{B.B0{B.B0{B.B1{B.BZ{}}}}}}, B.B0{B.B0{B.B0{B.B1{B.B1{B.B0{B.B1{B.BZ{}}}}}}}}, B.B0{B.B1{B.B1{B.B0{B.B1{B.B0{B.B1{B.B1{B.BZ{}}}}}}}}}, B.B0{B.B0{B.B1{B.B1{B.B1{B.B0{B.B0{B.B1{B.BZ{}}}}}}}}}, B.B1{B.B1{B.B1{B.B0{B.B1{B.B1{B.B1{B.B1{B.BZ{}}}}}}}}}, B.B0{B.B1{B.B0{B.B0{B.B0{B.B1{B.B0{B.B1{B.BZ{}}}}}}}}}, B.B0{B.B1{B.B1{B.B1{B.B1{B.B0{B.B1{B.B1{B.BZ{}}}}}}}}}, B.B1{B.B0{B.B0{B.B1{B.B1{B.B1{B.B1{B.B1{B.BZ{}}}}}}}}}, B.B0{B.B1{B.B1{B.B1{B.B1{B.B0{B.B1{B.B1{B.BZ{}}}}}}}}}, B.B0{B.B0{B.B1{B.B0{B.B1{B.BZ{}}}}}}, B.BZ{}, B.BZ{}, B.BZ{}, B.BZ{}, B.BZ{}, B.BZ{}, B.BZ{}, B.BZ{}, B.BZ{}, B.BZ{}, B.BZ{}, B.BZ{}, B.BZ{}, B.BZ{}, B.BZ{}, B.B0{B.B0{B.B0{B.B0{B.B1{B.BZ{}}}}}}]

def l_ok() -> {umatch(lbl(), ED.ell_bytes()) == True{} : Bool}:
  {==}

def eq6() -> {B.beq(PF.ll(), PF.bdig(lbl())) == True{} : Bool}:
  {==}

# the literal is the specification's L
def l_is(+one: Nat, +h1: {one == 1n : Nat}) -> {X.bvalo(one, PF.ll()) == ED.ell(one) : Nat}:
  %goal {X.bvalo(one, PF.ll()) == FS.uvalue(one, ED.ell_bytes()) : Nat}
  %rw X.eq_o(one, h1, PF.ll(), PF.bdig(lbl()), eq6())
  udig_o(one, h1, lbl(), ED.ell_bytes(), l_ok())

# L == 1 + (L - 1)
def l_suc(+one: Nat, +h1: {one == 1n : Nat}) -> {ED.ell(one) == 1n+X.bvalo(one, PF.l1l()) : Nat}:
  %rw <- l_is(one, h1)
  X.suc_o(one, h1, PF.ll(), PF.l1l(), {==})
