import Base
import ../../../lib/lemmas/proofs/nat_algebra.bend as NA
import ../../../math/typed/width.bend as WW
import ../../secp256k1/semiring.bend as SR
import ../../secp256k1/group/poly.bend as P
import ../../secp256k1/group/pev.bend as E
import ../../secp256k1/group/zm.bend as Z
import ../../secp256k1/group/fld.bend as F
import ../../../../spec/crypto/curve25519/field.bend as FS
import ./redm.bend as RM

# Glue for the generated identities (id_*.bend, by gen_ids.py): the
# hypothesis of a rule "monomial -> polynomial" of redm.bend from an equation
# between two residues.

# the curve equation at (x, y) as the rule x^2 y^2 -> e (y^2 - x^2 - 1), e the inverse of d
def Rule(+mp: Nat, +e: Nat, +x: Nat, +y: Nat) -> Data:
  {Nat.mod(FS.fmul(1n+mp, FS.fmul(1n+mp, x, x), FS.fmul(1n+mp, y, y)), 1n+mp) == Nat.mod(FS.fmul(1n+mp, e, FS.fsub(1n+mp, FS.fsub(1n+mp, FS.fmul(1n+mp, y, y), FS.fmul(1n+mp, x, x)), 1n)), 1n+mp) : Nat}

# a b == 1 (mod m)
def Inv(+mp: Nat, +a: Nat, +b: Nat) -> Data:
  {Nat.mod(FS.fmul(1n+mp, a, b), 1n+mp) == Nat.mod(1n, 1n+mp) : Nat}

def s1(+m: Nat) -> {Nat.add(Nat.mul(1n, m), 0n) == m : Nat}:
  %rw NA.add_zero(Nat.mul(1n, m))
  %rw SR.one_mul(m)
  %close

def s0(+m: Nat) -> {Nat.add(Nat.mul(0n, m), 0n) == 0n : Nat}:
  %rw NA.add_zero(Nat.mul(0n, m))
  %rw SR.zero_mul(m)
  %close

# v == 1 m - 0 m gives v == m (mod m)
def mono_a(+mp: Nat, +v: Nat, +m: Nat, +gp: Nat, +gn: Nat, +hgp: {gp == Nat.add(Nat.mul(1n, m), 0n) : Nat}, +hgn: {gn == Nat.add(Nat.mul(0n, m), 0n) : Nat}, +hv: Z.Rel(mp, v, gp, gn)) -> {Nat.mod(v, 1n+mp) == Nat.mod(m, 1n+mp) : Nat}:
  %rw <- NA.add_zero(v)
  %rwh Equal.sym(Nat, Nat.add(Nat.mul(0n, m), 0n), 0n, s0(m)) : {0n == Nat.add(Nat.mul(0n, m), 0n) : Nat}
  %rwh Equal.sym(Nat, gn, Nat.add(Nat.mul(0n, m), 0n), hgn) : {Nat.add(Nat.mul(0n, m), 0n) == gn : Nat}
  %rwh Equal.sym(Nat, Nat.add(Nat.mul(1n, m), 0n), m, s1(m)) : {m == Nat.add(Nat.mul(1n, m), 0n) : Nat}
  %rwh Equal.sym(Nat, gp, Nat.add(Nat.mul(1n, m), 0n), hgp) : {Nat.add(Nat.mul(1n, m), 0n) == gp : Nat}
  hv

# The residue v has the polynomial g, which computes to the monomial x^u
# (hgp, hgn: closed checks), and v == fv (mod m) where fv has the polynomial
# f: the rule x^u -> f holds at env.
def mono_rel(+mp: Nat, +v: Nat, +fv: Nat, +g: List<&2, P.Tm>, +u: List<&2, Nat>, +f: List<&2, P.Tm>, +env: List<&2, Nat>, +hgp: {E.eP(g, env) == Nat.add(Nat.mul(1n, E.mon(u, env)), 0n) : Nat}, +hgn: {E.eN(g, env) == Nat.add(Nat.mul(0n, E.mon(u, env)), 0n) : Nat}, +hv: Z.Rel(mp, v, E.eP(g, env), E.eN(g, env)), +hvf: {Nat.mod(v, 1n+mp) == Nat.mod(fv, 1n+mp) : Nat}, +hf: Z.Rel(mp, fv, E.eP(f, env), E.eN(f, env))) -> Z.Rel(mp, E.mon(u, env), E.eP(f, env), E.eN(f, env)):
  +hm = mono_a(mp, v, E.mon(u, env), E.eP(g, env), E.eN(g, env), hgp, hgn, hv)
  Equal.trans(Nat, Nat.mod(Nat.add(E.mon(u, env), E.eN(f, env)), 1n+mp), Nat.mod(Nat.add(fv, E.eN(f, env)), 1n+mp), Nat.mod(E.eP(f, env), 1n+mp),
    Z.cg_add_l(mp, E.mon(u, env), fv, E.eN(f, env), Equal.trans(Nat, Nat.mod(E.mon(u, env), 1n+mp), Nat.mod(v, 1n+mp), Nat.mod(fv, 1n+mp), Equal.sym(Nat, Nat.mod(v, 1n+mp), Nat.mod(E.mon(u, env), 1n+mp), hm), hvf)),
    hf)

# l == r (mod m): l - r is 0
def fsub_eq0(+mp: Nat, +l: Nat, +r: Nat, +h: {Nat.mod(l, 1n+mp) == Nat.mod(r, 1n+mp) : Nat}) -> {FS.fsub(1n+mp, l, r) == 0n : Nat}:
  %goal {Nat.mod(Nat.sub(Nat.add(l, 1n+mp), Nat.mod(r, 1n+mp)), 1n+mp) == 0n : Nat}
  %rwh Equal.sym(Nat, Nat.mod(l, 1n+mp), Nat.mod(r, 1n+mp), h) : {Nat.mod(r, 1n+mp) == Nat.mod(l, 1n+mp) : Nat}
  F.msub_refl(mp, l)
