def v2() -> {B.bval(l2()) == 2n : Nat}:
  {==}

def v4() -> {B.bval(l4()) == 4n : Nat}:
  {==}

def v5() -> {B.bval(l5()) == 5n : Nat}:
  {==}

def v8() -> {B.bval(l8()) == 8n : Nat}:
  {==}

def v19() -> {B.bval(l19()) == 19n : Nat}:
  {==}

# ---- tools ----

# a 2^k
def bshl(k: Nat, a: B.Bn) -> B.Bn:
  match k:
    case 0n:
      a
    case 1n+j:
      B.B0{bshl(j, a)}

def shl_o(+one: Nat, k: Nat, +a: B.Bn) -> {X.bvalo(one, bshl(k, a)) == C.shift(k, X.bvalo(one, a)) : Nat}:
  match k:
    case 0n:
      {==}
    case 1n+ +j:
      Equal.cong(Nat, Nat, z => Nat.double(z), X.bvalo(one, bshl(j, a)), C.shift(j, X.bvalo(one, a)), shl_o(one, j, a))

def b1_o(+one: Nat) -> {X.bvalo(one, B.B1{B.BZ{}}) == one : Nat}:
  NA.add_zero(one)

def dmul(+one: Nat, +h1: {one == 1n : Nat}, +n: Nat) -> {Nat.mul(one, n) == n : Nat}:
  %rwh h1 : {one == 1n : Nat}
  SR.one_mul(n)

# little-endian radix-2^8 digits
def bdig(ds: List<&2, B.Bn>) -> B.Bn:
  match ds:
    case Nil{}:
      B.BZ{}
    case d <> t:
      B.badd(d, bshl(8n, bdig(t)))

def dmatch(ds: List<&2, B.Bn>, ns: List<&2, Nat>) -> Bool:
  match ds ns:
    case Nil{} Nil{}:
      True{}
    case Nil{} n <> u:
      False{}
    case d <> t Nil{}:
      False{}
    case d <> t n <> u:
      Bool.and(Nat.is_eq(B.bval(d), n), dmatch(t, u))

# the literal of FS.digits
def dig_o(+one: Nat, +h1: {one == 1n : Nat}, ds: List<&2, B.Bn>, ns: List<&2, Nat>, +h: {dmatch(ds, ns) == True{} : Bool}) -> {X.bvalo(one, bdig(ds)) == FS.digits(one, ns) : Nat}:
  match ds ns:
    case Nil{} Nil{}:
      {==}
    case Nil{} n <> u:
      Empty.absurd({X.bvalo(one, bdig(Nil{})) == FS.digits(one, n <> u) : Nat}, Lg.false_true(h))
    case d <> t Nil{}:
      Empty.absurd({X.bvalo(one, bdig(d <> t)) == FS.digits(one, Nil{}) : Nat}, Lg.false_true(h))
    case +d <> +t +n <> +u:
      %goal {X.bvalo(one, B.badd(d, bshl(8n, bdig(t)))) == Nat.add(Nat.mul(one, n), C.shift(8n, FS.digits(one, u))) : Nat}
      %rw X.add_o(one, h1, d, bshl(8n, bdig(t)))
      %rw shl_o(one, 8n, bdig(t))
      %rw dig_o(one, h1, t, u, Lg.and_right(Nat.is_eq(B.bval(d), n), dmatch(t, u), h))
      %rw X.lit_o(one, h1, d, n, N.eq_from_is_eq(B.bval(d), n, Lg.and_left(Nat.is_eq(B.bval(d), n), dmatch(t, u), h)))
      %rw dmul(one, h1, n)
      %close

# a == q d: a / d == q and a mod d == 0, for a small d
def div_o(+one: Nat, +h1: {one == 1n : Nat}, +a: B.Bn, +q: B.Bn, +d: B.Bn, +dp: Nat, +hd: {B.bval(d) == 1n+dp : Nat}, +h: {B.beq(a, B.bmul(q, d)) == True{} : Bool}) -> {Nat.div(X.bvalo(one, a), 1n+dp) == X.bvalo(one, q) : Nat}:
  %rw X.eq_o(one, h1, a, B.bmul(q, d), h)
  %rw X.mul_o(one, h1, q, d)
  %rw X.lit_o(one, h1, d, 1n+dp, hd)
  %rw <- NA.add_zero(Nat.mul(X.bvalo(one, q), 1n+dp))
  NR.div_of(X.bvalo(one, q), dp, 0n, {==})

def mod_o(+one: Nat, +h1: {one == 1n : Nat}, +a: B.Bn, +q: B.Bn, +d: B.Bn, +dp: Nat, +hd: {B.bval(d) == 1n+dp : Nat}, +h: {B.beq(a, B.bmul(q, d)) == True{} : Bool}) -> {Nat.mod(X.bvalo(one, a), 1n+dp) == 0n : Nat}:
  %rw X.eq_o(one, h1, a, B.bmul(q, d), h)
  %rw X.mul_o(one, h1, q, d)
  %rw X.lit_o(one, h1, d, 1n+dp, hd)
  PM.mod_mul0(dp, X.bvalo(one, q))

# ---- p ----

def eq0() -> {B.beq(B.badd(l19(), pl()), bshl(255n, B.B1{B.BZ{}})) == True{} : Bool}:
  {==}

def p_sum(+one: Nat, +h1: {one == 1n : Nat}) -> {C.shift(255n, one) == Nat.add(19n, X.bvalo(one, pl())) : Nat}:
  %rw <- X.lit_o(one, h1, l19(), 19n, v19())
  %rw <- X.add_o(one, h1, l19(), pl())
  %rw X.eq_o(one, h1, B.badd(l19(), pl()), bshl(255n, B.B1{B.BZ{}}), eq0())
  %rw shl_o(one, 255n, B.B1{B.BZ{}})
  %rw b1_o(one)
  %close

# the literal is the specification's p
def p_is(+one: Nat, +h1: {one == 1n : Nat}) -> {X.bvalo(one, pl()) == FS.prime(one) : Nat}:
  %goal {X.bvalo(one, pl()) == Nat.sub(C.shift(255n, one), 19n) : Nat}
  %rw p_sum(one, h1)
  Equal.sym(Nat, Nat.sub(Nat.add(19n, X.bvalo(one, pl())), 19n), X.bvalo(one, pl()), N.add_sub_cancel(19n, X.bvalo(one, pl())))

# p == 1 + (p - 1)
def p_suc(+one: Nat, +h1: {one == 1n : Nat}) -> {FS.prime(one) == 1n+X.bvalo(one, p1l()) : Nat}:
  %rw <- p_is(one, h1)
  X.suc_o(one, h1, pl(), p1l(), {==})

# p - 1
def p_m1(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.sub(FS.prime(one), 1n) == X.bvalo(one, p1l()) : Nat}:
  %rw p_suc(one, h1)
  N.sub_zero(X.bvalo(one, p1l()))

def eq1() -> {B.beq(pl(), B.badd(l2(), p2l())) == True{} : Bool}:
  {==}

# p - 2
def p_m2(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.sub(FS.prime(one), 2n) == X.bvalo(one, p2l()) : Nat}:
  %rw <- p_is(one, h1)
  %rw X.eq_o(one, h1, pl(), B.badd(l2(), p2l()), eq1())
  %rw X.add_o(one, h1, l2(), p2l())
  %rw X.lit_o(one, h1, l2(), 2n, v2())
  N.add_sub_cancel(2n, X.bvalo(one, p2l()))

def eq2() -> {B.beq(pl(), B.badd(l5(), p5l())) == True{} : Bool}:
  {==}

# p - 5
def p_m5(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.sub(FS.prime(one), 5n) == X.bvalo(one, p5l()) : Nat}:
  %rw <- p_is(one, h1)
  %rw X.eq_o(one, h1, pl(), B.badd(l5(), p5l()), eq2())
  %rw X.add_o(one, h1, l5(), p5l())
  %rw X.lit_o(one, h1, l5(), 5n, v5())
  N.add_sub_cancel(5n, X.bvalo(one, p5l()))

# (p - 1) / 2
def p_half(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.div(X.bvalo(one, p1l()), 2n) == X.bvalo(one, hl()) : Nat}:
  div_o(one, h1, p1l(), hl(), l2(), 1n, v2(), {==})

def p_even(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.mod(X.bvalo(one, p1l()), 2n) == 0n : Nat}:
  mod_o(one, h1, p1l(), hl(), l2(), 1n, v2(), {==})

def eq3() -> {B.beq(p1l(), B.bmul(hl(), l2())) == True{} : Bool}:
  {==}

# p - 1 == 2 ((p - 1) / 2)
def p_h2(+one: Nat, +h1: {one == 1n : Nat}) -> {X.bvalo(one, p1l()) == Nat.mul(X.bvalo(one, hl()), 2n) : Nat}:
  %rw X.eq_o(one, h1, p1l(), B.bmul(hl(), l2()), eq3())
  %rw X.mul_o(one, h1, hl(), l2())
  %rw X.lit_o(one, h1, l2(), 2n, v2())
  %close

# (p - 1) / 4, the exponent of ED.sqm1
def p_q4(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.div(Nat.sub(FS.prime(one), 1n), 4n) == X.bvalo(one, q4l()) : Nat}:
  %rw p_m1(one, h1)
  div_o(one, h1, p1l(), q4l(), l4(), 3n, v4(), {==})

# (p - 5) / 8, the exponent of FS.PowP58
def p_e58(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.div(Nat.sub(FS.prime(one), 5n), 8n) == X.bvalo(one, e58l()) : Nat}:
  %rw p_m5(one, h1)
  div_o(one, h1, p5l(), e58l(), l8(), 7n, v8(), {==})

def eq_m8() -> {B.beq(pl(), B.badd(B.bmul(e58l(), l8()), l5())) == True{} : Bool}:
  {==}

# p mod 8 == 5
def p_mod8(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.mod(FS.prime(one), 8n) == 5n : Nat}:
  %rw <- p_is(one, h1)
  %rw X.eq_o(one, h1, pl(), B.badd(B.bmul(e58l(), l8()), l5()), eq_m8())
  %rw X.add_o(one, h1, B.bmul(e58l(), l8()), l5())
  %rw X.mul_o(one, h1, e58l(), l8())
  %rw X.lit_o(one, h1, l8(), 8n, v8())
  %rw X.lit_o(one, h1, l5(), 5n, v5())
  NR.mod_of(X.bvalo(one, e58l()), 7n, 5n, {==})

def eq_m84() -> {B.beq(p1l(), B.badd(B.bmul(e58l(), l8()), l4())) == True{} : Bool}:
  {==}

# (p - 1) mod 8 == 4
def p1_mod8(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.mod(X.bvalo(one, p1l()), 8n) == 4n : Nat}:
  %rw X.eq_o(one, h1, p1l(), B.badd(B.bmul(e58l(), l8()), l4()), eq_m84())
  %rw X.add_o(one, h1, B.bmul(e58l(), l8()), l4())
  %rw X.mul_o(one, h1, e58l(), l8())
  %rw X.lit_o(one, h1, l8(), 8n, v8())
  %rw X.lit_o(one, h1, l4(), 4n, v4())
  NR.mod_of(X.bvalo(one, e58l()), 7n, 4n, {==})

# (p - 1) mod 4 == 0
def p1_mod4(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.mod(X.bvalo(one, p1l()), 4n) == 0n : Nat}:
  mod_o(one, h1, p1l(), q4l(), l4(), 3n, v4(), {==})

def lt2(+y: Nat) -> {Nat.is_lt(2n, 3n+y) == True{} : Bool}:
  {==}

def nz2(+y: Nat) -> {Nat.is_eq(Nat.mod(2n, 3n+y), 0n) == False{} : Bool}:
  %Equal.sym(Nat, Nat.mod(Nat.add(Nat.mul(0n, 3n+y), 2n), 3n+y), 2n, NR.mod_of(0n, 2n+y, 2n, lt2(y))) : {Nat.is_eq(_, 0n) == False{} : Bool}
  {==}

def p_nz2_eq(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.is_eq(Nat.mod(2n, 1n+X.bvalo(one, p1l())), 0n) == False{} : Bool}:
  %Equal.sym(Nat, X.bvalo(one, p1l()), 2n+X.bvalo(one, p3l()), X.suc2_o(one, h1, p1l(), p3l(), {==})) : {Nat.is_eq(Nat.mod(2n, 1n+_), 0n) == False{} : Bool}
  nz2(X.bvalo(one, p3l()))

# 2 is not 0 modulo p
def p_nz2(+one: Nat, +h1: {one == 1n : Nat}) -> F.NZ(X.bvalo(one, p1l()), 2n):
  p_nz2_eq(one, h1)

# x == k p: x mod p == 0
def pmod0(+one: Nat, +h1: {one == 1n : Nat}, +x: B.Bn, +k: B.Bn, +h: {B.beq(x, B.bmul(k, pl())) == True{} : Bool}) -> {Nat.mod(X.bvalo(one, x), FS.prime(one)) == 0n : Nat}:
  %rw X.eq_o(one, h1, x, B.bmul(k, pl()), h)
  %rw X.mul_o(one, h1, k, pl())
  %rw p_is(one, h1)
  %rw p_suc(one, h1)
  %rw p_suc(one, h1)
  PM.mod_mul0(X.bvalo(one, p1l()), X.bvalo(one, k))

# ---- d = -121665 / 121666 ----

def c5_ok() -> {dmatch([B.B1{B.B0{B.B0{B.B0{B.B0{B.B0{B.B1{B.BZ{}}}}}}}}, B.B1{B.B1{B.B0{B.B1{B.B1{B.B0{B.B1{B.B1{B.BZ{}}}}}}}}}, B.B1{B.BZ{}}], [65n, 219n, 1n]) == True{} : Bool}:
  {==}

def c6_ok() -> {dmatch([B.B0{B.B1{B.B0{B.B0{B.B0{B.B0{B.B1{B.BZ{}}}}}}}}, B.B1{B.B1{B.B0{B.B1{B.B1{B.B0{B.B1{B.B1{B.BZ{}}}}}}}}}, B.B1{B.BZ{}}], [66n, 219n, 1n]) == True{} : Bool}:
  {==}

def eq4() -> {B.beq(c5l(), bdig([B.B1{B.B0{B.B0{B.B0{B.B0{B.B0{B.B1{B.BZ{}}}}}}}}, B.B1{B.B1{B.B0{B.B1{B.B1{B.B0{B.B1{B.B1{B.BZ{}}}}}}}}}, B.B1{B.BZ{}}])) == True{} : Bool}:
  {==}

# 121665, as ED.dconst writes it
def c5_is(+one: Nat, +h1: {one == 1n : Nat}) -> {X.bvalo(one, c5l()) == FS.digits(one, [65n, 219n, 1n]) : Nat}:
  %rw X.eq_o(one, h1, c5l(), bdig([B.B1{B.B0{B.B0{B.B0{B.B0{B.B0{B.B1{B.BZ{}}}}}}}}, B.B1{B.B1{B.B0{B.B1{B.B1{B.B0{B.B1{B.B1{B.BZ{}}}}}}}}}, B.B1{B.BZ{}}]), eq4())
  dig_o(one, h1, [B.B1{B.B0{B.B0{B.B0{B.B0{B.B0{B.B1{B.BZ{}}}}}}}}, B.B1{B.B1{B.B0{B.B1{B.B1{B.B0{B.B1{B.B1{B.BZ{}}}}}}}}}, B.B1{B.BZ{}}], [65n, 219n, 1n], c5_ok())

def eq5() -> {B.beq(c6l(), bdig([B.B0{B.B1{B.B0{B.B0{B.B0{B.B0{B.B1{B.BZ{}}}}}}}}, B.B1{B.B1{B.B0{B.B1{B.B1{B.B0{B.B1{B.B1{B.BZ{}}}}}}}}}, B.B1{B.BZ{}}])) == True{} : Bool}:
  {==}

# 121666
def c6_is(+one: Nat, +h1: {one == 1n : Nat}) -> {X.bvalo(one, c6l()) == FS.digits(one, [66n, 219n, 1n]) : Nat}:
  %rw X.eq_o(one, h1, c6l(), bdig([B.B0{B.B1{B.B0{B.B0{B.B0{B.B0{B.B1{B.BZ{}}}}}}}}, B.B1{B.B1{B.B0{B.B1{B.B1{B.B0{B.B1{B.B1{B.BZ{}}}}}}}}}, B.B1{B.BZ{}}]), eq5())
  dig_o(one, h1, [B.B0{B.B1{B.B0{B.B0{B.B0{B.B0{B.B1{B.BZ{}}}}}}}}, B.B1{B.B1{B.B0{B.B1{B.B1{B.B0{B.B1{B.B1{B.BZ{}}}}}}}}}, B.B1{B.BZ{}}], [66n, 219n, 1n], c6_ok())

# 121666 d + 121665 == 0 (mod p), on the literals
def d_defl(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.mod(Nat.add(Nat.mul(X.bvalo(one, dl()), X.bvalo(one, c6l())), X.bvalo(one, c5l())), FS.prime(one)) == 0n : Nat}:
  %rw <- X.mul_o(one, h1, dl(), c6l())
  %rw <- X.add_o(one, h1, B.bmul(dl(), c6l()), c5l())
  pmod0(one, h1, B.badd(B.bmul(dl(), c6l()), c5l()), dkl(), {==})

# the same with the specification's 121666 and 121665
def d_def(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.mod(Nat.add(Nat.mul(X.bvalo(one, dl()), FS.digits(one, [66n, 219n, 1n])), FS.digits(one, [65n, 219n, 1n])), FS.prime(one)) == 0n : Nat}:
  %rw <- c6_is(one, h1)
  %rw <- c5_is(one, h1)
  d_defl(one, h1)

def d_lt(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.is_lt(X.bvalo(one, dl()), FS.prime(one)) == True{} : Bool}:
  %rw <- p_is(one, h1)
  X.lt_o(one, h1, dl(), pl(), dcl(), {==})

# ---- I = sqrt(-1) ----

# I^2 + 1 == 0 (mod p)
def i_sq(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.mod(Nat.add(Nat.mul(X.bvalo(one, il()), X.bvalo(one, il())), 1n), FS.prime(one)) == 0n : Nat}:
  %rw <- X.mul_o(one, h1, il(), il())
  %rw <- X.one_o(one, h1)
  %rw <- X.add_o(one, h1, B.bmul(il(), il()), B.B1{B.BZ{}})
  pmod0(one, h1, B.badd(B.bmul(il(), il()), B.B1{B.BZ{}}), ikl(), {==})

def i_lt(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.is_lt(X.bvalo(one, il()), FS.prime(one)) == True{} : Bool}:
  %rw <- p_is(one, h1)
  X.lt_o(one, h1, il(), pl(), icl(), {==})
