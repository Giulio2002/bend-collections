# [L]B = O for the base point of edwards25519, by checked computation: the
# soundness of lbk.bend's checker. If chk accepts a chain from (n, x, y) to
# (n2, x2, y2) and [n]B is (x, y) modulo p, then [n2]B is (x2, y2) modulo p
# (`sound`, `reach`), for B = (bx, by) the literal base point (on the curve:
# `b_on`) and the parameters of edwards25519 (a hypothesis G.Curve: cpar.bend
# proves it from the certificates). So a chain from (1, B) to (L, (0, 1))
# gives [L]B == O (`lb_fin`). The segments of the chain are independent
# roots (lb_NN.bend) that import only the checker; lbz.bend concludes.
#
# One addition (x3, y3) = (X1, Y1) + (X2, Y2) is verified without dividing:
# with t == d X1 X2 Y1 Y2, (1 + t) x3 == nx and y3 == ny + t y3 modulo p
# give dx x3 == dx add_x and dy y3 == dy add_y (GL.sum_x, GL.sum_y), and the
# denominators dx, dy are not zero on the curve (GL.compl_x, GL.compl_y), so
# they cancel. Everything is modulo p (CG.ceq): the literals need no bound.

# ---- one addition, on residues ----

def prod(+mp: Nat, +A: Nat, +B: Nat, +a: Nat, +b: Nat, +hA: CG.ceq(mp, A, a), +hB: CG.ceq(mp, B, b)) -> CG.ceq(mp, FS.fmul(1n+mp, A, B), Nat.mul(a, b)):
  CG.c_trans(mp, FS.fmul(1n+mp, A, B), Nat.mul(A, B), Nat.mul(a, b), CG.c_mod(mp, Nat.mul(A, B)), CG.c_mul(mp, A, a, B, b, hA, hB))

def sum2(+mp: Nat, +A1: Nat, +B1: Nat, +A2: Nat, +B2: Nat, +a1: Nat, +b1: Nat, +a2: Nat, +b2: Nat, +hA1: CG.ceq(mp, A1, a1), +hB1: CG.ceq(mp, B1, b1), +hA2: CG.ceq(mp, A2, a2), +hB2: CG.ceq(mp, B2, b2)) -> CG.ceq(mp, FS.fadd(1n+mp, FS.fmul(1n+mp, A1, B1), FS.fmul(1n+mp, A2, B2)), Nat.add(Nat.mul(a1, b1), Nat.mul(a2, b2))):
  CG.c_trans(mp, FS.fadd(1n+mp, FS.fmul(1n+mp, A1, B1), FS.fmul(1n+mp, A2, B2)), Nat.add(FS.fmul(1n+mp, A1, B1), FS.fmul(1n+mp, A2, B2)), Nat.add(Nat.mul(a1, b1), Nat.mul(a2, b2)),
    CG.c_mod(mp, Nat.add(FS.fmul(1n+mp, A1, B1), FS.fmul(1n+mp, A2, B2))),
    CG.c_add(mp, FS.fmul(1n+mp, A1, B1), Nat.mul(a1, b1), FS.fmul(1n+mp, A2, B2), Nat.mul(a2, b2), prod(mp, A1, B1, a1, b1, hA1, hB1), prod(mp, A2, B2, a2, b2, hA2, hB2)))

# d X1 X2 Y1 Y2 == t
def ct_c(+mp: Nat, +d: Nat, +X1: Nat, +Y1: Nat, +X2: Nat, +Y2: Nat, +x1: Nat, +y1: Nat, +x2: Nat, +y2: Nat, +t: Nat, +c1x: CG.ceq(mp, X1, x1), +c1y: CG.ceq(mp, Y1, y1), +c2x: CG.ceq(mp, X2, x2), +c2y: CG.ceq(mp, Y2, y2), +ht: CG.ceq(mp, Nat.mul(d, Nat.mul(Nat.mul(x1, x2), Nat.mul(y1, y2))), t)) -> CG.ceq(mp, G.ct(1n+mp, d, X1, Y1, X2, Y2), t):
  CG.c_trans(mp, G.ct(1n+mp, d, X1, Y1, X2, Y2), Nat.mul(d, Nat.mul(Nat.mul(x1, x2), Nat.mul(y1, y2))), t,
    prod(mp, d, FS.fmul(1n+mp, FS.fmul(1n+mp, X1, X2), FS.fmul(1n+mp, Y1, Y2)), d, Nat.mul(Nat.mul(x1, x2), Nat.mul(y1, y2)), CG.c_refl(mp, d),
      prod(mp, FS.fmul(1n+mp, X1, X2), FS.fmul(1n+mp, Y1, Y2), Nat.mul(x1, x2), Nat.mul(y1, y2), prod(mp, X1, X2, x1, x2, c1x, c2x), prod(mp, Y1, Y2, y1, y2, c1y, c2y))),
    ht)

# a (mod p) == b (mod p) is mod(a) b-free: the product by dx or dy, both ways
def fm_comm(+mp: Nat, +a: Nat, +b: Nat) -> CG.ceq(mp, Nat.mul(b, a), FS.fmul(1n+mp, a, b)):
  CG.c_trans(mp, Nat.mul(b, a), Nat.mul(a, b), FS.fmul(1n+mp, a, b), CG.c_eq(mp, Nat.mul(b, a), Nat.mul(a, b), NA.mul_comm(b, a)), CG.c_sym(mp, FS.fmul(1n+mp, a, b), Nat.mul(a, b), CG.c_mod(mp, Nat.mul(a, b))))

# (1 + t) x3 == nx: the sum's x is x3
def stepx(+mp: Nat, +d: Nat, +hc: G.Curve(mp, d), +X1: Nat, +Y1: Nat, +X2: Nat, +Y2: Nat, +x1: Nat, +y1: Nat, +x2: Nat, +y2: Nat, +x3: Nat, +t: Nat, +he1: GL.Eq(mp, d, X1, Y1), +he2: GL.Eq(mp, d, X2, Y2), +c1x: CG.ceq(mp, X1, x1), +c1y: CG.ceq(mp, Y1, y1), +c2x: CG.ceq(mp, X2, x2), +c2y: CG.ceq(mp, Y2, y2), +ht: CG.ceq(mp, Nat.mul(d, Nat.mul(Nat.mul(x1, x2), Nat.mul(y1, y2))), t), +hx: CG.ceq(mp, Nat.mul(Nat.add(1n, t), x3), Nat.add(Nat.mul(x1, y2), Nat.mul(y1, x2)))) -> CG.ceq(mp, G.add_x(1n+mp, d, X1, Y1, X2, Y2), x3):
  +hdx = CG.c_trans(mp, G.dx(1n+mp, d, X1, Y1, X2, Y2), Nat.add(1n, G.ct(1n+mp, d, X1, Y1, X2, Y2)), Nat.add(1n, t), CG.c_mod(mp, Nat.add(1n, G.ct(1n+mp, d, X1, Y1, X2, Y2))), CG.c_add(mp, 1n, 1n, G.ct(1n+mp, d, X1, Y1, X2, Y2), t, CG.c_refl(mp, 1n), ct_c(mp, d, X1, Y1, X2, Y2, x1, y1, x2, y2, t, c1x, c1y, c2x, c2y, ht)))
  +hn = sum2(mp, X1, Y2, Y1, X2, x1, y2, y1, x2, c1x, c2y, c1y, c2x)
  +h1 = CG.c_trans(mp, Nat.mul(G.dx(1n+mp, d, X1, Y1, X2, Y2), x3), Nat.mul(Nat.add(1n, t), x3), G.nx(1n+mp, X1, Y1, X2, Y2), CG.c_mul(mp, G.dx(1n+mp, d, X1, Y1, X2, Y2), Nat.add(1n, t), x3, x3, hdx, CG.c_refl(mp, x3)), CG.c_trans(mp, Nat.mul(Nat.add(1n, t), x3), Nat.add(Nat.mul(x1, y2), Nat.mul(y1, x2)), G.nx(1n+mp, X1, Y1, X2, Y2), hx, CG.c_sym(mp, G.nx(1n+mp, X1, Y1, X2, Y2), Nat.add(Nat.mul(x1, y2), Nat.mul(y1, x2)), hn)))
  +h2 = CG.c_trans(mp, Nat.mul(G.dx(1n+mp, d, X1, Y1, X2, Y2), G.add_x(1n+mp, d, X1, Y1, X2, Y2)), FS.fmul(1n+mp, G.add_x(1n+mp, d, X1, Y1, X2, Y2), G.dx(1n+mp, d, X1, Y1, X2, Y2)), G.nx(1n+mp, X1, Y1, X2, Y2), fm_comm(mp, G.add_x(1n+mp, d, X1, Y1, X2, Y2), G.dx(1n+mp, d, X1, Y1, X2, Y2)), GL.sum_x(mp, d, hc, X1, Y1, X2, Y2, he1, he2))
  FD.mul_cancel(1n+mp, FQ.cv_prime(mp, d, hc), G.dx(1n+mp, d, X1, Y1, X2, Y2), GL.compl_x(mp, d, hc, X1, Y1, X2, Y2, he1, he2), G.add_x(1n+mp, d, X1, Y1, X2, Y2), x3, CG.c_trans(mp, Nat.mul(G.dx(1n+mp, d, X1, Y1, X2, Y2), G.add_x(1n+mp, d, X1, Y1, X2, Y2)), G.nx(1n+mp, X1, Y1, X2, Y2), Nat.mul(G.dx(1n+mp, d, X1, Y1, X2, Y2), x3), h2, CG.c_sym(mp, Nat.mul(G.dx(1n+mp, d, X1, Y1, X2, Y2), x3), G.nx(1n+mp, X1, Y1, X2, Y2), h1)))

# y3 == ny + t y3: the sum's y is y3
def stepy(+mp: Nat, +d: Nat, +hc: G.Curve(mp, d), +X1: Nat, +Y1: Nat, +X2: Nat, +Y2: Nat, +x1: Nat, +y1: Nat, +x2: Nat, +y2: Nat, +y3: Nat, +t: Nat, +he1: GL.Eq(mp, d, X1, Y1), +he2: GL.Eq(mp, d, X2, Y2), +c1x: CG.ceq(mp, X1, x1), +c1y: CG.ceq(mp, Y1, y1), +c2x: CG.ceq(mp, X2, x2), +c2y: CG.ceq(mp, Y2, y2), +ht: CG.ceq(mp, Nat.mul(d, Nat.mul(Nat.mul(x1, x2), Nat.mul(y1, y2))), t), +hy: CG.ceq(mp, y3, Nat.add(Nat.add(Nat.mul(y1, y2), Nat.mul(x1, x2)), Nat.mul(t, y3)))) -> CG.ceq(mp, G.add_y(1n+mp, d, X1, Y1, X2, Y2), y3):
  +hct = ct_c(mp, d, X1, Y1, X2, Y2, x1, y1, x2, y2, t, c1x, c1y, c2x, c2y, ht)
  +hone = CG.c_trans(mp, Nat.add(G.dy(1n+mp, d, X1, Y1, X2, Y2), t), Nat.add(G.dy(1n+mp, d, X1, Y1, X2, Y2), G.ct(1n+mp, d, X1, Y1, X2, Y2)), 1n, CG.c_add(mp, G.dy(1n+mp, d, X1, Y1, X2, Y2), G.dy(1n+mp, d, X1, Y1, X2, Y2), t, G.ct(1n+mp, d, X1, Y1, X2, Y2), CG.c_refl(mp, G.dy(1n+mp, d, X1, Y1, X2, Y2)), CG.c_sym(mp, G.ct(1n+mp, d, X1, Y1, X2, Y2), t, hct)), CG.c_trans(mp, Nat.add(G.dy(1n+mp, d, X1, Y1, X2, Y2), G.ct(1n+mp, d, X1, Y1, X2, Y2)), FS.fadd(1n+mp, G.dy(1n+mp, d, X1, Y1, X2, Y2), G.ct(1n+mp, d, X1, Y1, X2, Y2)), 1n, CG.c_sym(mp, FS.fadd(1n+mp, G.dy(1n+mp, d, X1, Y1, X2, Y2), G.ct(1n+mp, d, X1, Y1, X2, Y2)), Nat.add(G.dy(1n+mp, d, X1, Y1, X2, Y2), G.ct(1n+mp, d, X1, Y1, X2, Y2)), CG.c_mod(mp, Nat.add(G.dy(1n+mp, d, X1, Y1, X2, Y2), G.ct(1n+mp, d, X1, Y1, X2, Y2)))), IL.dy_one(mp, G.ct(1n+mp, d, X1, Y1, X2, Y2))))
  +e1 = CG.c_trans(mp, Nat.add(Nat.mul(G.dy(1n+mp, d, X1, Y1, X2, Y2), y3), Nat.mul(t, y3)), Nat.mul(Nat.add(G.dy(1n+mp, d, X1, Y1, X2, Y2), t), y3), y3, CG.c_eq(mp, Nat.add(Nat.mul(G.dy(1n+mp, d, X1, Y1, X2, Y2), y3), Nat.mul(t, y3)), Nat.mul(Nat.add(G.dy(1n+mp, d, X1, Y1, X2, Y2), t), y3), Equal.sym(Nat, Nat.mul(Nat.add(G.dy(1n+mp, d, X1, Y1, X2, Y2), t), y3), Nat.add(Nat.mul(G.dy(1n+mp, d, X1, Y1, X2, Y2), y3), Nat.mul(t, y3)), NA.mul_add_right(G.dy(1n+mp, d, X1, Y1, X2, Y2), t, y3))), CG.c_trans(mp, Nat.mul(Nat.add(G.dy(1n+mp, d, X1, Y1, X2, Y2), t), y3), Nat.mul(1n, y3), y3, CG.c_mul(mp, Nat.add(G.dy(1n+mp, d, X1, Y1, X2, Y2), t), 1n, y3, y3, hone, CG.c_refl(mp, y3)), CG.c_eq(mp, Nat.mul(1n, y3), y3, SR.one_mul(y3))))
  +e2 = CG.c_trans(mp, Nat.add(Nat.mul(G.dy(1n+mp, d, X1, Y1, X2, Y2), y3), Nat.mul(t, y3)), y3, Nat.add(Nat.add(Nat.mul(y1, y2), Nat.mul(x1, x2)), Nat.mul(t, y3)), e1, hy)
  +hn = sum2(mp, Y1, Y2, X1, X2, y1, y2, x1, x2, c1y, c2y, c1x, c2x)
  +h1 = CG.c_trans(mp, Nat.mul(G.dy(1n+mp, d, X1, Y1, X2, Y2), y3), Nat.add(Nat.mul(y1, y2), Nat.mul(x1, x2)), G.ny(1n+mp, X1, Y1, X2, Y2), CG.c_cancel(mp, Nat.mul(G.dy(1n+mp, d, X1, Y1, X2, Y2), y3), Nat.add(Nat.mul(y1, y2), Nat.mul(x1, x2)), Nat.mul(t, y3), e2), CG.c_sym(mp, G.ny(1n+mp, X1, Y1, X2, Y2), Nat.add(Nat.mul(y1, y2), Nat.mul(x1, x2)), hn))
  +h2 = CG.c_trans(mp, Nat.mul(G.dy(1n+mp, d, X1, Y1, X2, Y2), G.add_y(1n+mp, d, X1, Y1, X2, Y2)), FS.fmul(1n+mp, G.add_y(1n+mp, d, X1, Y1, X2, Y2), G.dy(1n+mp, d, X1, Y1, X2, Y2)), G.ny(1n+mp, X1, Y1, X2, Y2), fm_comm(mp, G.add_y(1n+mp, d, X1, Y1, X2, Y2), G.dy(1n+mp, d, X1, Y1, X2, Y2)), GL.sum_y(mp, d, hc, X1, Y1, X2, Y2, he1, he2))
  FD.mul_cancel(1n+mp, FQ.cv_prime(mp, d, hc), G.dy(1n+mp, d, X1, Y1, X2, Y2), GL.compl_y(mp, d, hc, X1, Y1, X2, Y2, he1, he2), G.add_y(1n+mp, d, X1, Y1, X2, Y2), y3, CG.c_trans(mp, Nat.mul(G.dy(1n+mp, d, X1, Y1, X2, Y2), G.add_y(1n+mp, d, X1, Y1, X2, Y2)), G.ny(1n+mp, X1, Y1, X2, Y2), Nat.mul(G.dy(1n+mp, d, X1, Y1, X2, Y2), y3), h2, CG.c_sym(mp, Nat.mul(G.dy(1n+mp, d, X1, Y1, X2, Y2), y3), G.ny(1n+mp, X1, Y1, X2, Y2), h1)))

# ---- points ----

def ax_add(+mp: Nat, +d: Nat, a: G.APt, b: G.APt) -> {G.ax(G.aadd(1n+mp, d, a, b)) == G.add_x(1n+mp, d, G.ax(a), G.ay(a), G.ax(b), G.ay(b)) : Nat}:
  match a b:
    case G.APt{x1, y1} G.APt{x2, y2}:
      {==}

def ay_add(+mp: Nat, +d: Nat, a: G.APt, b: G.APt) -> {G.ay(G.aadd(1n+mp, d, a, b)) == G.add_y(1n+mp, d, G.ax(a), G.ay(a), G.ax(b), G.ay(b)) : Nat}:
  match a b:
    case G.APt{x1, y1} G.APt{x2, y2}:
      {==}

def oc_eq(+mp: Nat, +d: Nat, a: G.APt, +h: G.OnCurve(1n+mp, d, a)) -> GL.Eq(mp, d, G.ax(a), G.ay(a)):
  match a:
    case G.APt{+x, +y}:
      GP.oc_e(mp, d, x, y, h)

# ---- the checks of lbk.bend, as congruences ----

def et_o(+one: Nat, +h1: {one == 1n : Nat}, +x1: B.Bn, +y1: B.Bn, +x2: B.Bn, +y2: B.Bn, +kt: B.Bn, +t: B.Bn, +e: {LK.c1(LK.tT(x1, y1, x2, y2), kt, t) == True{} : Bool}) -> {Nat.mod(Nat.mul(X.bvalo(one, PF.dl()), Nat.mul(Nat.mul(X.bvalo(one, x1), X.bvalo(one, x2)), Nat.mul(X.bvalo(one, y1), X.bvalo(one, y2)))), 1n+X.bvalo(one, PF.p1l())) == Nat.mod(X.bvalo(one, t), 1n+X.bvalo(one, PF.p1l())) : Nat}:
  %rw <- X.mul_o(one, h1, x1, x2)
  %rw <- X.mul_o(one, h1, y1, y2)
  %rw <- X.mul_o(one, h1, B.bmul(x1, x2), B.bmul(y1, y2))
  %rw <- X.mul_o(one, h1, PF.dl(), B.bmul(B.bmul(x1, x2), B.bmul(y1, y2)))
  %rw X.eq_o(one, h1, B.bmul(PF.dl(), B.bmul(B.bmul(x1, x2), B.bmul(y1, y2))), B.badd(B.bmul(kt, PF.pl()), t), e)
  %rw X.add_o(one, h1, B.bmul(kt, PF.pl()), t)
  %rw X.mul_o(one, h1, kt, PF.pl())
  %rw PF.p_is(one, h1)
  %rw PF.p_suc(one, h1)
  NR.absorb(X.bvalo(one, PF.p1l()), X.bvalo(one, kt), X.bvalo(one, t))

def ex_a(+one: Nat, +h1: {one == 1n : Nat}, +x1: B.Bn, +y1: B.Bn, +x2: B.Bn, +y2: B.Bn, +x3: B.Bn, +jx: B.Bn, +kx: B.Bn, +t: B.Bn, +e: {LK.c2(x1, y1, x2, y2, x3, jx, kx, t) == True{} : Bool}) -> {Nat.mod(Nat.add(Nat.mul(X.bvalo(one, jx), 1n+X.bvalo(one, PF.p1l())), Nat.mul(1n+X.bvalo(one, t), X.bvalo(one, x3))), 1n+X.bvalo(one, PF.p1l())) == Nat.mod(Nat.add(Nat.mul(X.bvalo(one, x1), X.bvalo(one, y2)), Nat.mul(X.bvalo(one, y1), X.bvalo(one, x2))), 1n+X.bvalo(one, PF.p1l())) : Nat}:
  %rw <- PF.p_suc(one, h1)
  %rw <- PF.p_is(one, h1)
  %rw <- X.mul_o(one, h1, jx, PF.pl())
  %rw <- X.inc_o(one, h1, t)
  %rw <- X.mul_o(one, h1, B.binc(t), x3)
  %rw <- X.add_o(one, h1, B.bmul(jx, PF.pl()), B.bmul(B.binc(t), x3))
  %rw X.eq_o(one, h1, B.badd(B.bmul(jx, PF.pl()), B.bmul(B.binc(t), x3)), B.badd(B.bmul(kx, PF.pl()), B.badd(B.bmul(x1, y2), B.bmul(y1, x2))), e)
  %rw X.add_o(one, h1, B.bmul(kx, PF.pl()), B.badd(B.bmul(x1, y2), B.bmul(y1, x2)))
  %rw X.mul_o(one, h1, kx, PF.pl())
  %rw PF.p_is(one, h1)
  %rw PF.p_suc(one, h1)
  %rw X.add_o(one, h1, B.bmul(x1, y2), B.bmul(y1, x2))
  %rw X.mul_o(one, h1, x1, y2)
  %rw X.mul_o(one, h1, y1, x2)
  NR.absorb(X.bvalo(one, PF.p1l()), X.bvalo(one, kx), Nat.add(Nat.mul(X.bvalo(one, x1), X.bvalo(one, y2)), Nat.mul(X.bvalo(one, y1), X.bvalo(one, x2))))

def ex_o(+one: Nat, +h1: {one == 1n : Nat}, +x1: B.Bn, +y1: B.Bn, +x2: B.Bn, +y2: B.Bn, +x3: B.Bn, +jx: B.Bn, +kx: B.Bn, +t: B.Bn, +e: {LK.c2(x1, y1, x2, y2, x3, jx, kx, t) == True{} : Bool}) -> {Nat.mod(Nat.mul(Nat.add(1n, X.bvalo(one, t)), X.bvalo(one, x3)), 1n+X.bvalo(one, PF.p1l())) == Nat.mod(Nat.add(Nat.mul(X.bvalo(one, x1), X.bvalo(one, y2)), Nat.mul(X.bvalo(one, y1), X.bvalo(one, x2))), 1n+X.bvalo(one, PF.p1l())) : Nat}:
  Equal.trans(Nat, Nat.mod(Nat.mul(1n+X.bvalo(one, t), X.bvalo(one, x3)), 1n+X.bvalo(one, PF.p1l())), Nat.mod(Nat.add(Nat.mul(X.bvalo(one, jx), 1n+X.bvalo(one, PF.p1l())), Nat.mul(1n+X.bvalo(one, t), X.bvalo(one, x3))), 1n+X.bvalo(one, PF.p1l())), Nat.mod(Nat.add(Nat.mul(X.bvalo(one, x1), X.bvalo(one, y2)), Nat.mul(X.bvalo(one, y1), X.bvalo(one, x2))), 1n+X.bvalo(one, PF.p1l())),
    Equal.sym(Nat, Nat.mod(Nat.add(Nat.mul(X.bvalo(one, jx), 1n+X.bvalo(one, PF.p1l())), Nat.mul(1n+X.bvalo(one, t), X.bvalo(one, x3))), 1n+X.bvalo(one, PF.p1l())), Nat.mod(Nat.mul(1n+X.bvalo(one, t), X.bvalo(one, x3)), 1n+X.bvalo(one, PF.p1l())), NR.absorb(X.bvalo(one, PF.p1l()), X.bvalo(one, jx), Nat.mul(1n+X.bvalo(one, t), X.bvalo(one, x3)))),
    ex_a(one, h1, x1, y1, x2, y2, x3, jx, kx, t, e))

def ey_a(+one: Nat, +h1: {one == 1n : Nat}, +x1: B.Bn, +y1: B.Bn, +x2: B.Bn, +y2: B.Bn, +y3: B.Bn, +ky: B.Bn, +t: B.Bn, +e: {LK.c3(x1, y1, x2, y2, y3, ky, t) == True{} : Bool}) -> {Nat.mod(Nat.add(Nat.mul(X.bvalo(one, ky), 1n+X.bvalo(one, PF.p1l())), X.bvalo(one, y3)), 1n+X.bvalo(one, PF.p1l())) == Nat.mod(Nat.add(Nat.add(Nat.mul(X.bvalo(one, y1), X.bvalo(one, y2)), Nat.mul(X.bvalo(one, x1), X.bvalo(one, x2))), Nat.mul(X.bvalo(one, t), X.bvalo(one, y3))), 1n+X.bvalo(one, PF.p1l())) : Nat}:
  %rw <- PF.p_suc(one, h1)
  %rw <- PF.p_is(one, h1)
  %rw <- X.mul_o(one, h1, ky, PF.pl())
  %rw <- X.add_o(one, h1, B.bmul(ky, PF.pl()), y3)
  %rw X.eq_o(one, h1, B.badd(B.bmul(ky, PF.pl()), y3), B.badd(B.badd(B.bmul(y1, y2), B.bmul(x1, x2)), B.bmul(t, y3)), e)
  %rw X.add_o(one, h1, B.badd(B.bmul(y1, y2), B.bmul(x1, x2)), B.bmul(t, y3))
  %rw X.add_o(one, h1, B.bmul(y1, y2), B.bmul(x1, x2))
  %rw X.mul_o(one, h1, y1, y2)
  %rw X.mul_o(one, h1, x1, x2)
  %rw X.mul_o(one, h1, t, y3)
  %close

def ey_o(+one: Nat, +h1: {one == 1n : Nat}, +x1: B.Bn, +y1: B.Bn, +x2: B.Bn, +y2: B.Bn, +y3: B.Bn, +ky: B.Bn, +t: B.Bn, +e: {LK.c3(x1, y1, x2, y2, y3, ky, t) == True{} : Bool}) -> {Nat.mod(X.bvalo(one, y3), 1n+X.bvalo(one, PF.p1l())) == Nat.mod(Nat.add(Nat.add(Nat.mul(X.bvalo(one, y1), X.bvalo(one, y2)), Nat.mul(X.bvalo(one, x1), X.bvalo(one, x2))), Nat.mul(X.bvalo(one, t), X.bvalo(one, y3))), 1n+X.bvalo(one, PF.p1l())) : Nat}:
  Equal.trans(Nat, Nat.mod(X.bvalo(one, y3), 1n+X.bvalo(one, PF.p1l())), Nat.mod(Nat.add(Nat.mul(X.bvalo(one, ky), 1n+X.bvalo(one, PF.p1l())), X.bvalo(one, y3)), 1n+X.bvalo(one, PF.p1l())), Nat.mod(Nat.add(Nat.add(Nat.mul(X.bvalo(one, y1), X.bvalo(one, y2)), Nat.mul(X.bvalo(one, x1), X.bvalo(one, x2))), Nat.mul(X.bvalo(one, t), X.bvalo(one, y3))), 1n+X.bvalo(one, PF.p1l())),
    Equal.sym(Nat, Nat.mod(Nat.add(Nat.mul(X.bvalo(one, ky), 1n+X.bvalo(one, PF.p1l())), X.bvalo(one, y3)), 1n+X.bvalo(one, PF.p1l())), Nat.mod(X.bvalo(one, y3), 1n+X.bvalo(one, PF.p1l())), NR.absorb(X.bvalo(one, PF.p1l()), X.bvalo(one, ky), X.bvalo(one, y3))),
    ey_a(one, h1, x1, y1, x2, y2, y3, ky, t, e))

# ---- one addition of two points known modulo p ----

def paddx(+one: Nat, +h1: {one == 1n : Nat}, +hc: G.Curve(X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl())), +a: G.APt, +b: G.APt, +ha: G.OnCurve(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), a), +hb: G.OnCurve(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), b), +x1: B.Bn, +y1: B.Bn, +x2: B.Bn, +y2: B.Bn, +x3: B.Bn, +kt: B.Bn, +jx: B.Bn, +kx: B.Bn, +t: B.Bn, +c1x: CG.ceq(X.bvalo(one, PF.p1l()), G.ax(a), X.bvalo(one, x1)), +c1y: CG.ceq(X.bvalo(one, PF.p1l()), G.ay(a), X.bvalo(one, y1)), +c2x: CG.ceq(X.bvalo(one, PF.p1l()), G.ax(b), X.bvalo(one, x2)), +c2y: CG.ceq(X.bvalo(one, PF.p1l()), G.ay(b), X.bvalo(one, y2)), +e1: {LK.c1(LK.tT(x1, y1, x2, y2), kt, t) == True{} : Bool}, +e2: {LK.c2(x1, y1, x2, y2, x3, jx, kx, t) == True{} : Bool}) -> {Nat.mod(G.ax(G.aadd(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), a, b)), 1n+X.bvalo(one, PF.p1l())) == Nat.mod(X.bvalo(one, x3), 1n+X.bvalo(one, PF.p1l())) : Nat}:
  %rw ax_add(X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), a, b)
  stepx(X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), hc, G.ax(a), G.ay(a), G.ax(b), G.ay(b), X.bvalo(one, x1), X.bvalo(one, y1), X.bvalo(one, x2), X.bvalo(one, y2), X.bvalo(one, x3), X.bvalo(one, t), oc_eq(X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), a, ha), oc_eq(X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), b, hb), c1x, c1y, c2x, c2y, et_o(one, h1, x1, y1, x2, y2, kt, t, e1), ex_o(one, h1, x1, y1, x2, y2, x3, jx, kx, t, e2))

def paddy(+one: Nat, +h1: {one == 1n : Nat}, +hc: G.Curve(X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl())), +a: G.APt, +b: G.APt, +ha: G.OnCurve(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), a), +hb: G.OnCurve(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), b), +x1: B.Bn, +y1: B.Bn, +x2: B.Bn, +y2: B.Bn, +y3: B.Bn, +kt: B.Bn, +ky: B.Bn, +t: B.Bn, +c1x: CG.ceq(X.bvalo(one, PF.p1l()), G.ax(a), X.bvalo(one, x1)), +c1y: CG.ceq(X.bvalo(one, PF.p1l()), G.ay(a), X.bvalo(one, y1)), +c2x: CG.ceq(X.bvalo(one, PF.p1l()), G.ax(b), X.bvalo(one, x2)), +c2y: CG.ceq(X.bvalo(one, PF.p1l()), G.ay(b), X.bvalo(one, y2)), +e1: {LK.c1(LK.tT(x1, y1, x2, y2), kt, t) == True{} : Bool}, +e3: {LK.c3(x1, y1, x2, y2, y3, ky, t) == True{} : Bool}) -> {Nat.mod(G.ay(G.aadd(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), a, b)), 1n+X.bvalo(one, PF.p1l())) == Nat.mod(X.bvalo(one, y3), 1n+X.bvalo(one, PF.p1l())) : Nat}:
  %rw ay_add(X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), a, b)
  stepy(X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), hc, G.ax(a), G.ay(a), G.ax(b), G.ay(b), X.bvalo(one, x1), X.bvalo(one, y1), X.bvalo(one, x2), X.bvalo(one, y2), X.bvalo(one, y3), X.bvalo(one, t), oc_eq(X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), a, ha), oc_eq(X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), b, hb), c1x, c1y, c2x, c2y, et_o(one, h1, x1, y1, x2, y2, kt, t, e1), ey_o(one, h1, x1, y1, x2, y2, y3, ky, t, e3))

def padd(+one: Nat, +h1: {one == 1n : Nat}, +hc: G.Curve(X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl())), +a: G.APt, +b: G.APt, +ha: G.OnCurve(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), a), +hb: G.OnCurve(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), b), +x1: B.Bn, +y1: B.Bn, +x2: B.Bn, +y2: B.Bn, +x3: B.Bn, +y3: B.Bn, +kt: B.Bn, +jx: B.Bn, +kx: B.Bn, +ky: B.Bn, +t: B.Bn, +c1x: CG.ceq(X.bvalo(one, PF.p1l()), G.ax(a), X.bvalo(one, x1)), +c1y: CG.ceq(X.bvalo(one, PF.p1l()), G.ay(a), X.bvalo(one, y1)), +c2x: CG.ceq(X.bvalo(one, PF.p1l()), G.ax(b), X.bvalo(one, x2)), +c2y: CG.ceq(X.bvalo(one, PF.p1l()), G.ay(b), X.bvalo(one, y2)), +e1: {LK.c1(LK.tT(x1, y1, x2, y2), kt, t) == True{} : Bool}, +e2: {LK.c2(x1, y1, x2, y2, x3, jx, kx, t) == True{} : Bool}, +e3: {LK.c3(x1, y1, x2, y2, y3, ky, t) == True{} : Bool}) -> {G.APt{Nat.mod(G.ax(G.aadd(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), a, b)), 1n+X.bvalo(one, PF.p1l())), Nat.mod(G.ay(G.aadd(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), a, b)), 1n+X.bvalo(one, PF.p1l()))} == G.APt{Nat.mod(X.bvalo(one, x3), 1n+X.bvalo(one, PF.p1l())), Nat.mod(X.bvalo(one, y3), 1n+X.bvalo(one, PF.p1l()))} : G.APt}:
  GP.apt_eq(Nat.mod(G.ax(G.aadd(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), a, b)), 1n+X.bvalo(one, PF.p1l())), Nat.mod(G.ay(G.aadd(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), a, b)), 1n+X.bvalo(one, PF.p1l())), Nat.mod(X.bvalo(one, x3), 1n+X.bvalo(one, PF.p1l())), Nat.mod(X.bvalo(one, y3), 1n+X.bvalo(one, PF.p1l())),
    paddx(one, h1, hc, a, b, ha, hb, x1, y1, x2, y2, x3, kt, jx, kx, t, c1x, c1y, c2x, c2y, e1, e2),
    paddy(one, h1, hc, a, b, ha, hb, x1, y1, x2, y2, y3, kt, ky, t, c1x, c1y, c2x, c2y, e1, e3))

# ---- the base point ----

def bp(+one: Nat) -> G.APt:
  G.APt{X.bvalo(one, PF.bxl()), X.bvalo(one, PF.byl())}

def fmul_lit(+one: Nat, +h1: {one == 1n : Nat}, +a: B.Bn, +b: B.Bn, +k: B.Bn, +r: B.Bn, +c: B.Bn, +h: {B.beq(B.bmul(a, b), B.badd(B.bmul(k, PF.pl()), r)) == True{} : Bool}, +hl: {B.beq(PF.pl(), B.badd(B.binc(r), c)) == True{} : Bool}) -> {FS.fmul(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, a), X.bvalo(one, b)) == X.bvalo(one, r) : Nat}:
  %goal {Nat.mod(Nat.mul(X.bvalo(one, a), X.bvalo(one, b)), 1n+X.bvalo(one, PF.p1l())) == X.bvalo(one, r) : Nat}
  %rw <- X.mul_o(one, h1, a, b)
  CP.mod_p(one, h1, B.bmul(a, b), k, r, c, h, hl)

def hb1() -> {B.beq(B.bmul(PF.byl(), PF.byl()), B.badd(B.bmul(PL.bukl(), PF.pl()), PL.bul())) == True{} : Bool}:
  {==}

def hb2() -> {B.beq(PF.pl(), B.badd(B.binc(PL.bul()), PL.bucl())) == True{} : Bool}:
  {==}

def hb3() -> {B.beq(B.bmul(PF.bxl(), PF.bxl()), B.badd(B.bmul(PL.bwkl(), PF.pl()), PL.bwl())) == True{} : Bool}:
  {==}

def hb4() -> {B.beq(PF.pl(), B.badd(B.binc(PL.bwl()), PL.bwcl())) == True{} : Bool}:
  {==}

def hb5() -> {B.beq(B.bmul(PL.bwl(), PL.bul()), B.badd(B.bmul(PL.bwukl(), PF.pl()), PL.bwul())) == True{} : Bool}:
  {==}

def hb6() -> {B.beq(PF.pl(), B.badd(B.binc(PL.bwul()), PL.bwucl())) == True{} : Bool}:
  {==}

def hb7() -> {B.beq(B.bmul(PF.dl(), PL.bwul()), B.badd(B.bmul(PL.bvkl(), PF.pl()), PL.bvl())) == True{} : Bool}:
  {==}

def hb8() -> {B.beq(PF.pl(), B.badd(B.binc(PL.bvl()), PL.bvcl())) == True{} : Bool}:
  {==}

def hb9() -> {B.beq(B.badd(PL.bul(), PF.pl()), B.badd(PL.bwl(), PL.bzl())) == True{} : Bool}:
  {==}

def hb10() -> {B.beq(PL.bzl(), B.badd(B.bmul(PL.bzkl(), PF.pl()), PL.bel())) == True{} : Bool}:
  {==}

def hb11() -> {B.beq(PF.pl(), B.badd(B.binc(PL.bel()), PL.becl())) == True{} : Bool}:
  {==}

def hb12() -> {B.beq(B.binc(PL.bvl()), B.badd(B.bmul(B.BZ{}, PF.pl()), PL.bel())) == True{} : Bool}:
  {==}

def hb13() -> {B.beq(PF.pl(), B.badd(B.binc(PF.bxl()), PF.bxcl())) == True{} : Bool}:
  {==}

def hb14() -> {B.beq(PF.pl(), B.badd(B.binc(PF.byl()), PF.bycl())) == True{} : Bool}:
  {==}

def hb15() -> {B.beq(B.bmul(PF.l5(), PF.byl()), B.badd(B.bmul(PL.b5kl(), PF.pl()), PF.l4())) == True{} : Bool}:
  {==}

def hb16() -> {B.beq(PF.pl(), B.badd(B.binc(PF.l4()), PF.p5l())) == True{} : Bool}:
  {==}

# B is on the curve: -bx^2 + by^2 == 1 + d bx^2 by^2 (mod p)
def b_on(+one: Nat, +h1: {one == 1n : Nat}) -> GL.Eq(X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), X.bvalo(one, PF.bxl()), X.bvalo(one, PF.byl())):
  %goal {FS.fsub(1n+X.bvalo(one, PF.p1l()), FS.fmul(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.byl()), X.bvalo(one, PF.byl())), FS.fmul(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.bxl()), X.bvalo(one, PF.bxl()))) == FS.fadd(1n+X.bvalo(one, PF.p1l()), 1n, FS.fmul(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), FS.fmul(1n+X.bvalo(one, PF.p1l()), FS.fmul(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.bxl()), X.bvalo(one, PF.bxl())), FS.fmul(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.byl()), X.bvalo(one, PF.byl()))))) : Nat}
  %rw fmul_lit(one, h1, PF.byl(), PF.byl(), PL.bukl(), PL.bul(), PL.bucl(), hb1(), hb2())
  %rw fmul_lit(one, h1, PF.byl(), PF.byl(), PL.bukl(), PL.bul(), PL.bucl(), hb1(), hb2())
  %rw fmul_lit(one, h1, PF.bxl(), PF.bxl(), PL.bwkl(), PL.bwl(), PL.bwcl(), hb3(), hb4())
  %rw fmul_lit(one, h1, PF.bxl(), PF.bxl(), PL.bwkl(), PL.bwl(), PL.bwcl(), hb3(), hb4())
  %rw fmul_lit(one, h1, PL.bwl(), PL.bul(), PL.bwukl(), PL.bwul(), PL.bwucl(), hb5(), hb6())
  %rw fmul_lit(one, h1, PF.dl(), PL.bwul(), PL.bvkl(), PL.bvl(), PL.bvcl(), hb7(), hb8())
  %goal {Nat.mod(Nat.sub(Nat.add(X.bvalo(one, PL.bul()), 1n+X.bvalo(one, PF.p1l())), Nat.mod(X.bvalo(one, PL.bwl()), 1n+X.bvalo(one, PF.p1l()))), 1n+X.bvalo(one, PF.p1l())) == Nat.mod(1n+X.bvalo(one, PL.bvl()), 1n+X.bvalo(one, PF.p1l())) : Nat}
  %rw FL.small_nz(X.bvalo(one, PF.p1l()), X.bvalo(one, PL.bwl()), CP.lt_p(one, h1, PL.bwl(), PL.bwcl(), hb4()))
  %rw <- PF.p_suc(one, h1)
  %rw <- PF.p_is(one, h1)
  %rw <- X.add_o(one, h1, PL.bul(), PF.pl())
  %rw X.eq_o(one, h1, B.badd(PL.bul(), PF.pl()), B.badd(PL.bwl(), PL.bzl()), hb9())
  %rw X.add_o(one, h1, PL.bwl(), PL.bzl())
  %rw N.add_sub_cancel(X.bvalo(one, PL.bwl()), X.bvalo(one, PL.bzl()))
  %rw <- X.inc_o(one, h1, PL.bvl())
  %rw CP.mod_p(one, h1, PL.bzl(), PL.bzkl(), PL.bel(), PL.becl(), hb10(), hb11())
  %rw CP.mod_p(one, h1, B.binc(PL.bvl()), B.BZ{}, PL.bel(), PL.becl(), hb12(), hb11())
  %close

def bx_lt(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.is_lt(X.bvalo(one, PF.bxl()), 1n+X.bvalo(one, PF.p1l())) == True{} : Bool}:
  CP.lt_p(one, h1, PF.bxl(), PF.bxcl(), hb13())

def by_lt(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.is_lt(X.bvalo(one, PF.byl()), 1n+X.bvalo(one, PF.p1l())) == True{} : Bool}:
  CP.lt_p(one, h1, PF.byl(), PF.bycl(), hb14())

def b_oc(+one: Nat, +h1: {one == 1n : Nat}) -> G.OnCurve(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), bp(one)):
  GP.oc_in(X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), X.bvalo(one, PF.bxl()), X.bvalo(one, PF.byl()), bx_lt(one, h1), by_lt(one, h1), b_on(one, h1))

# bx is even (the sign bit of B's encoding is 0)
def bx_even(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.mod(X.bvalo(one, PF.bxl()), 2n) == 0n : Nat}:
  PF.mod_o(one, h1, PF.bxl(), PF.bxhl(), PF.l2(), 1n, PF.v2(), {==})

# 5 by == 4 (mod p): by = 4 / 5
def by_45(+one: Nat, +h1: {one == 1n : Nat}) -> {FS.fmul(1n+X.bvalo(one, PF.p1l()), 5n, X.bvalo(one, PF.byl())) == 4n : Nat}:
  %rw <- X.lit_o(one, h1, PF.l5(), 5n, PF.v5())
  %rw fmul_lit(one, h1, PF.l5(), PF.byl(), PL.b5kl(), PF.l4(), PF.p5l(), hb15(), hb16())
  X.lit_o(one, h1, PF.l4(), 4n, PF.v4())

# ---- [n]B == (x, y) modulo p ----

def Pt(+one: Nat, +n: B.Bn, +x: B.Bn, +y: B.Bn) -> Data:
  {G.APt{Nat.mod(G.ax(G.nmul(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), X.bvalo(one, n), bp(one))), 1n+X.bvalo(one, PF.p1l())), Nat.mod(G.ay(G.nmul(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), X.bvalo(one, n), bp(one))), 1n+X.bvalo(one, PF.p1l()))} == G.APt{Nat.mod(X.bvalo(one, x), 1n+X.bvalo(one, PF.p1l())), Nat.mod(X.bvalo(one, y), 1n+X.bvalo(one, PF.p1l()))} : G.APt}

def pt_x(+one: Nat, +n: B.Bn, +x: B.Bn, +y: B.Bn, +h: Pt(one, n, x, y)) -> CG.ceq(X.bvalo(one, PF.p1l()), G.ax(G.nmul(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), X.bvalo(one, n), bp(one))), X.bvalo(one, x)):
  Equal.cong(G.APt, Nat, q => G.ax(q), G.APt{Nat.mod(G.ax(G.nmul(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), X.bvalo(one, n), bp(one))), 1n+X.bvalo(one, PF.p1l())), Nat.mod(G.ay(G.nmul(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), X.bvalo(one, n), bp(one))), 1n+X.bvalo(one, PF.p1l()))}, G.APt{Nat.mod(X.bvalo(one, x), 1n+X.bvalo(one, PF.p1l())), Nat.mod(X.bvalo(one, y), 1n+X.bvalo(one, PF.p1l()))}, h)

def pt_y(+one: Nat, +n: B.Bn, +x: B.Bn, +y: B.Bn, +h: Pt(one, n, x, y)) -> CG.ceq(X.bvalo(one, PF.p1l()), G.ay(G.nmul(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), X.bvalo(one, n), bp(one))), X.bvalo(one, y)):
  Equal.cong(G.APt, Nat, q => G.ay(q), G.APt{Nat.mod(G.ax(G.nmul(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), X.bvalo(one, n), bp(one))), 1n+X.bvalo(one, PF.p1l())), Nat.mod(G.ay(G.nmul(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), X.bvalo(one, n), bp(one))), 1n+X.bvalo(one, PF.p1l()))}, G.APt{Nat.mod(X.bvalo(one, x), 1n+X.bvalo(one, PF.p1l())), Nat.mod(X.bvalo(one, y), 1n+X.bvalo(one, PF.p1l()))}, h)

# [1]B == B
def pt_one(+one: Nat, +h1: {one == 1n : Nat}, +hc: G.Curve(X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()))) -> Pt(one, B.B1{B.BZ{}}, PF.bxl(), PF.byl()):
  %goal {G.APt{Nat.mod(G.ax(G.nmul(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), X.bvalo(one, B.B1{B.BZ{}}), bp(one))), 1n+X.bvalo(one, PF.p1l())), Nat.mod(G.ay(G.nmul(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), X.bvalo(one, B.B1{B.BZ{}}), bp(one))), 1n+X.bvalo(one, PF.p1l()))} == G.APt{Nat.mod(X.bvalo(one, PF.bxl()), 1n+X.bvalo(one, PF.p1l())), Nat.mod(X.bvalo(one, PF.byl()), 1n+X.bvalo(one, PF.p1l()))} : G.APt}
  %rw X.one_o(one, h1)
  %rw X.one_o(one, h1)
  %goal {G.APt{Nat.mod(G.ax(G.aadd(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), bp(one), G.azero())), 1n+X.bvalo(one, PF.p1l())), Nat.mod(G.ay(G.aadd(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), bp(one), G.azero())), 1n+X.bvalo(one, PF.p1l()))} == G.APt{Nat.mod(X.bvalo(one, PF.bxl()), 1n+X.bvalo(one, PF.p1l())), Nat.mod(X.bvalo(one, PF.byl()), 1n+X.bvalo(one, PF.p1l()))} : G.APt}
  %rw GP.add_zero_r(X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), hc, bp(one), b_oc(one, h1))
  %rw GP.add_zero_r(X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), hc, bp(one), b_oc(one, h1))
  %close

# [n]B -> [n + n]B
def dbl(+one: Nat, +h1: {one == 1n : Nat}, +hc: G.Curve(X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl())), +n: B.Bn, +x: B.Bn, +y: B.Bn, +x3: B.Bn, +y3: B.Bn, +kt: B.Bn, +jx: B.Bn, +kx: B.Bn, +ky: B.Bn, +hp: Pt(one, n, x, y), +h: {LK.step(x, y, x, y, x3, y3, kt, jx, kx, ky) == True{} : Bool}) -> Pt(one, B.badd(n, n), x3, y3):
  %goal {G.APt{Nat.mod(G.ax(G.nmul(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), X.bvalo(one, B.badd(n, n)), bp(one))), 1n+X.bvalo(one, PF.p1l())), Nat.mod(G.ay(G.nmul(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), X.bvalo(one, B.badd(n, n)), bp(one))), 1n+X.bvalo(one, PF.p1l()))} == G.APt{Nat.mod(X.bvalo(one, x3), 1n+X.bvalo(one, PF.p1l())), Nat.mod(X.bvalo(one, y3), 1n+X.bvalo(one, PF.p1l()))} : G.APt}
  %rw X.add_o(one, h1, n, n)
  %rw X.add_o(one, h1, n, n)
  %rw GP.nmul_add(X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), hc, X.bvalo(one, n), X.bvalo(one, n), bp(one), b_oc(one, h1))
  %rw GP.nmul_add(X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), hc, X.bvalo(one, n), X.bvalo(one, n), bp(one), b_oc(one, h1))
  padd(one, h1, hc, G.nmul(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), X.bvalo(one, n), bp(one)), G.nmul(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), X.bvalo(one, n), bp(one)), GP.nmul_on(X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), hc, X.bvalo(one, n), bp(one), b_oc(one, h1)), GP.nmul_on(X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), hc, X.bvalo(one, n), bp(one), b_oc(one, h1)), x, y, x, y, x3, y3, kt, jx, kx, ky, LK.tof(LK.tT(x, y, x, y), kt), pt_x(one, n, x, y, hp), pt_y(one, n, x, y, hp), pt_x(one, n, x, y, hp), pt_y(one, n, x, y, hp), Lg.and_left(LK.c1(LK.tT(x, y, x, y), kt, LK.tof(LK.tT(x, y, x, y), kt)), Bool.and(LK.c2(x, y, x, y, x3, jx, kx, LK.tof(LK.tT(x, y, x, y), kt)), LK.c3(x, y, x, y, y3, ky, LK.tof(LK.tT(x, y, x, y), kt))), h), Lg.and_left(LK.c2(x, y, x, y, x3, jx, kx, LK.tof(LK.tT(x, y, x, y), kt)), LK.c3(x, y, x, y, y3, ky, LK.tof(LK.tT(x, y, x, y), kt)), Lg.and_right(LK.c1(LK.tT(x, y, x, y), kt, LK.tof(LK.tT(x, y, x, y), kt)), Bool.and(LK.c2(x, y, x, y, x3, jx, kx, LK.tof(LK.tT(x, y, x, y), kt)), LK.c3(x, y, x, y, y3, ky, LK.tof(LK.tT(x, y, x, y), kt))), h)), Lg.and_right(LK.c2(x, y, x, y, x3, jx, kx, LK.tof(LK.tT(x, y, x, y), kt)), LK.c3(x, y, x, y, y3, ky, LK.tof(LK.tT(x, y, x, y), kt)), Lg.and_right(LK.c1(LK.tT(x, y, x, y), kt, LK.tof(LK.tT(x, y, x, y), kt)), Bool.and(LK.c2(x, y, x, y, x3, jx, kx, LK.tof(LK.tT(x, y, x, y), kt)), LK.c3(x, y, x, y, y3, ky, LK.tof(LK.tT(x, y, x, y), kt))), h)))

# [n]B -> [1 + n]B == B + [n]B
def inc(+one: Nat, +h1: {one == 1n : Nat}, +hc: G.Curve(X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl())), +n: B.Bn, +x: B.Bn, +y: B.Bn, +x3: B.Bn, +y3: B.Bn, +kt: B.Bn, +jx: B.Bn, +kx: B.Bn, +ky: B.Bn, +hp: Pt(one, n, x, y), +h: {LK.step(PL.bxl(), PL.byl(), x, y, x3, y3, kt, jx, kx, ky) == True{} : Bool}) -> Pt(one, B.binc(n), x3, y3):
  %goal {G.APt{Nat.mod(G.ax(G.nmul(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), X.bvalo(one, B.binc(n)), bp(one))), 1n+X.bvalo(one, PF.p1l())), Nat.mod(G.ay(G.nmul(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), X.bvalo(one, B.binc(n)), bp(one))), 1n+X.bvalo(one, PF.p1l()))} == G.APt{Nat.mod(X.bvalo(one, x3), 1n+X.bvalo(one, PF.p1l())), Nat.mod(X.bvalo(one, y3), 1n+X.bvalo(one, PF.p1l()))} : G.APt}
  %rw X.inc_o(one, h1, n)
  %rw X.inc_o(one, h1, n)
  %goal {G.APt{Nat.mod(G.ax(G.aadd(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), bp(one), G.nmul(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), X.bvalo(one, n), bp(one)))), 1n+X.bvalo(one, PF.p1l())), Nat.mod(G.ay(G.aadd(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), bp(one), G.nmul(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), X.bvalo(one, n), bp(one)))), 1n+X.bvalo(one, PF.p1l()))} == G.APt{Nat.mod(X.bvalo(one, x3), 1n+X.bvalo(one, PF.p1l())), Nat.mod(X.bvalo(one, y3), 1n+X.bvalo(one, PF.p1l()))} : G.APt}
  padd(one, h1, hc, bp(one), G.nmul(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), X.bvalo(one, n), bp(one)), b_oc(one, h1), GP.nmul_on(X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), hc, X.bvalo(one, n), bp(one), b_oc(one, h1)), PL.bxl(), PL.byl(), x, y, x3, y3, kt, jx, kx, ky, LK.tof(LK.tT(PL.bxl(), PL.byl(), x, y), kt), CG.c_refl(X.bvalo(one, PF.p1l()), X.bvalo(one, PL.bxl())), CG.c_refl(X.bvalo(one, PF.p1l()), X.bvalo(one, PL.byl())), pt_x(one, n, x, y, hp), pt_y(one, n, x, y, hp), Lg.and_left(LK.c1(LK.tT(PL.bxl(), PL.byl(), x, y), kt, LK.tof(LK.tT(PL.bxl(), PL.byl(), x, y), kt)), Bool.and(LK.c2(PL.bxl(), PL.byl(), x, y, x3, jx, kx, LK.tof(LK.tT(PL.bxl(), PL.byl(), x, y), kt)), LK.c3(PL.bxl(), PL.byl(), x, y, y3, ky, LK.tof(LK.tT(PL.bxl(), PL.byl(), x, y), kt))), h), Lg.and_left(LK.c2(PL.bxl(), PL.byl(), x, y, x3, jx, kx, LK.tof(LK.tT(PL.bxl(), PL.byl(), x, y), kt)), LK.c3(PL.bxl(), PL.byl(), x, y, y3, ky, LK.tof(LK.tT(PL.bxl(), PL.byl(), x, y), kt)), Lg.and_right(LK.c1(LK.tT(PL.bxl(), PL.byl(), x, y), kt, LK.tof(LK.tT(PL.bxl(), PL.byl(), x, y), kt)), Bool.and(LK.c2(PL.bxl(), PL.byl(), x, y, x3, jx, kx, LK.tof(LK.tT(PL.bxl(), PL.byl(), x, y), kt)), LK.c3(PL.bxl(), PL.byl(), x, y, y3, ky, LK.tof(LK.tT(PL.bxl(), PL.byl(), x, y), kt))), h)), Lg.and_right(LK.c2(PL.bxl(), PL.byl(), x, y, x3, jx, kx, LK.tof(LK.tT(PL.bxl(), PL.byl(), x, y), kt)), LK.c3(PL.bxl(), PL.byl(), x, y, y3, ky, LK.tof(LK.tT(PL.bxl(), PL.byl(), x, y), kt)), Lg.and_right(LK.c1(LK.tT(PL.bxl(), PL.byl(), x, y), kt, LK.tof(LK.tT(PL.bxl(), PL.byl(), x, y), kt)), Bool.and(LK.c2(PL.bxl(), PL.byl(), x, y, x3, jx, kx, LK.tof(LK.tT(PL.bxl(), PL.byl(), x, y), kt)), LK.c3(PL.bxl(), PL.byl(), x, y, y3, ky, LK.tof(LK.tT(PL.bxl(), PL.byl(), x, y), kt))), h)))

# the same point under equal literals
def pt_eq(+one: Nat, +h1: {one == 1n : Nat}, +n: B.Bn, +x: B.Bn, +y: B.Bn, +n2: B.Bn, +x2: B.Bn, +y2: B.Bn, +hp: Pt(one, n, x, y), +hn: {B.beq(n, n2) == True{} : Bool}, +hx: {B.beq(x, x2) == True{} : Bool}, +hy: {B.beq(y, y2) == True{} : Bool}) -> Pt(one, n2, x2, y2):
  %goal {G.APt{Nat.mod(G.ax(G.nmul(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), X.bvalo(one, n2), bp(one))), 1n+X.bvalo(one, PF.p1l())), Nat.mod(G.ay(G.nmul(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), X.bvalo(one, n2), bp(one))), 1n+X.bvalo(one, PF.p1l()))} == G.APt{Nat.mod(X.bvalo(one, x2), 1n+X.bvalo(one, PF.p1l())), Nat.mod(X.bvalo(one, y2), 1n+X.bvalo(one, PF.p1l()))} : G.APt}
  %rw <- X.eq_o(one, h1, n, n2, hn)
  %rw <- X.eq_o(one, h1, n, n2, hn)
  %rw <- X.eq_o(one, h1, x, x2, hx)
  %rw <- X.eq_o(one, h1, y, y2, hy)
  hp

# ---- soundness of the checker ----

def sound(+one: Nat, +h1: {one == 1n : Nat}, +hc: G.Curve(X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl())), ops: List<&2, LK.Op>, +n: B.Bn, +x: B.Bn, +y: B.Bn, +n2: B.Bn, +x2: B.Bn, +y2: B.Bn, +hp: Pt(one, n, x, y), +h: {LK.chk(ops, n, x, y, n2, x2, y2) == True{} : Bool}) -> Pt(one, n2, x2, y2):
  match ops:
    case Nil{}:
      pt_eq(one, h1, n, x, y, n2, x2, y2, hp, Lg.and_left(B.beq(n, n2), Bool.and(B.beq(x, x2), B.beq(y, y2)), h), Lg.and_left(B.beq(x, x2), B.beq(y, y2), Lg.and_right(B.beq(n, n2), Bool.and(B.beq(x, x2), B.beq(y, y2)), h)), Lg.and_right(B.beq(x, x2), B.beq(y, y2), Lg.and_right(B.beq(n, n2), Bool.and(B.beq(x, x2), B.beq(y, y2)), h)))
    case o <> +r:
      match o:
        case LK.D{+x3, +y3, +kt, +jx, +kx, +ky}:
          sound(one, h1, hc, r, B.badd(n, n), x3, y3, n2, x2, y2, dbl(one, h1, hc, n, x, y, x3, y3, kt, jx, kx, ky, hp, Lg.and_left(LK.step(x, y, x, y, x3, y3, kt, jx, kx, ky), LK.chk(r, B.badd(n, n), x3, y3, n2, x2, y2), h)), Lg.and_right(LK.step(x, y, x, y, x3, y3, kt, jx, kx, ky), LK.chk(r, B.badd(n, n), x3, y3, n2, x2, y2), h))
        case LK.A{+x3, +y3, +kt, +jx, +kx, +ky}:
          sound(one, h1, hc, r, B.binc(n), x3, y3, n2, x2, y2, inc(one, h1, hc, n, x, y, x3, y3, kt, jx, kx, ky, hp, Lg.and_left(LK.step(PL.bxl(), PL.byl(), x, y, x3, y3, kt, jx, kx, ky), LK.chk(r, B.binc(n), x3, y3, n2, x2, y2), h)), Lg.and_right(LK.step(PL.bxl(), PL.byl(), x, y, x3, y3, kt, jx, kx, ky), LK.chk(r, B.binc(n), x3, y3, n2, x2, y2), h))

# a checked segment carries [n]B == (x, y) to [n2]B == (x2, y2)
def reach(+one: Nat, +h1: {one == 1n : Nat}, +hc: G.Curve(X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl())), +n: B.Bn, +x: B.Bn, +y: B.Bn, +n2: B.Bn, +x2: B.Bn, +y2: B.Bn, +hp: Pt(one, n, x, y), r: LK.Reach(n, x, y, n2, x2, y2)) -> Pt(one, n2, x2, y2):
  match r:
    case (ops, h):
      sound(one, h1, hc, ops, n, x, y, n2, x2, y2, hp, h)

# ---- the conclusion ----

# a point of the curve that is (0, 1) modulo p is O
def fin(+mp: Nat, +d: Nat, +hc: G.Curve(mp, d), q: G.APt, +hq: G.OnCurve(1n+mp, d, q), +hx: CG.ceq(mp, G.ax(q), 0n), +hy: CG.ceq(mp, G.ay(q), 1n)) -> {q == G.azero() : G.APt}:
  match q:
    case G.APt{+x, +y}:
      GP.apt_eq(x, y, 0n, 1n,
        Equal.trans(Nat, x, Nat.mod(x, 1n+mp), 0n, Equal.sym(Nat, Nat.mod(x, 1n+mp), x, FL.small_nz(mp, x, GP.oc_x(mp, d, x, y, hq))), Equal.trans(Nat, Nat.mod(x, 1n+mp), Nat.mod(0n, 1n+mp), 0n, hx, FL.small_nz(mp, 0n, {==}))),
        Equal.trans(Nat, y, Nat.mod(y, 1n+mp), 1n, Equal.sym(Nat, Nat.mod(y, 1n+mp), y, FL.small_nz(mp, y, GP.oc_y(mp, d, x, y, hq))), Equal.trans(Nat, Nat.mod(y, 1n+mp), Nat.mod(1n, 1n+mp), 1n, hy, FQ.one_mod(mp, FQ.cv_prime(mp, d, hc)))))

def one_c(+one: Nat, +h1: {one == 1n : Nat}) -> CG.ceq(X.bvalo(one, PF.p1l()), X.bvalo(one, B.B1{B.BZ{}}), 1n):
  CG.c_eq(X.bvalo(one, PF.p1l()), X.bvalo(one, B.B1{B.BZ{}}), 1n, X.one_o(one, h1))

# [L]B == O, from the chain's last point
def lb_fin(+one: Nat, +h1: {one == 1n : Nat}, +hc: G.Curve(X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl())), +hl: Pt(one, PF.ll(), B.BZ{}, B.B1{B.BZ{}})) -> {G.nmul(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), X.bvalo(one, PF.ll()), bp(one)) == G.azero() : G.APt}:
  fin(X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), hc, G.nmul(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), X.bvalo(one, PF.ll()), bp(one)), GP.nmul_on(X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), hc, X.bvalo(one, PF.ll()), bp(one), b_oc(one, h1)), pt_x(one, PF.ll(), B.BZ{}, B.B1{B.BZ{}}, hl),
    CG.c_trans(X.bvalo(one, PF.p1l()), G.ay(G.nmul(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.dl()), X.bvalo(one, PF.ll()), bp(one))), X.bvalo(one, B.B1{B.BZ{}}), 1n, pt_y(one, PF.ll(), B.BZ{}, B.B1{B.BZ{}}, hl), one_c(one, h1)))
