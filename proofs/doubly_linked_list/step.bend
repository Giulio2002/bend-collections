  +ec = Equal.sym(Nat, SC.length(Nat, WK.rapp(sl, Nil{})), SC.length(Nat, sl), Equal.trans(Nat, SC.length(Nat, WK.rapp(sl, Nil{})), Nat.add(SC.length(Nat, sl), 0n), SC.length(Nat, sl), WK.len_rapp(sl, Nil{}), N.add_zero(SC.length(Nat, sl))))
  +et = Equal.trans(U32, tail, LST.last_or(sl, 0), LST.fst_or(WK.rapp(sl, Nil{}), 0), A.eq_of(tail, LST.last_or(sl, 0), ST.g_ctail(~T, tag, cap, fresh, free, head, tail, depth, vT, pT, nT, gT, sl, fl, hg)), Equal.sym(U32, LST.fst_or(WK.rapp(sl, Nil{}), 0), LST.last_or(sl, 0), WK.fo_rapp(sl, Nil{}, 0)))
  +hrok = WL.rok_app(~T, AR.slots(U32, pT), AR.slots(U32, nT), AR.slots(Maybe<&2, T>, vT), sl, Nil{}, UD.v(fresh), 0, 0, ST.g_cseg(~T, tag, cap, fresh, free, head, tail, depth, vT, pT, nT, gT, sl, fl, hg), ST.g_csl(~T, tag, cap, fresh, free, head, tail, depth, vT, pT, nT, gT, sl, fl, hg), {==}, DL.u_refl(0))
  +ew = WL.walk(~T, one, h1, depth, ST.g_cdep(~T, tag, cap, fresh, free, head, tail, depth, vT, pT, nT, gT, sl, fl, hg), vT, pT, ST.g_cpv(~T, tag, cap, fresh, free, head, tail, depth, vT, pT, nT, gT, sl, fl, hg), ST.g_cpp(~T, tag, cap, fresh, free, head, tail, depth, vT, pT, nT, gT, sl, fl, hg), UD.v(fresh), hfr2, WK.rapp(sl, Nil{}), Nil{}, hrok)
  +er1 = Equal.cong(Nat, R.DList<T> & List<&2, T>, n => R.tl_fin(~T, tag, fresh, free, SC.length(Nat, sl), head, tail, depth, cap, AR.thaw(U32, nT), R.walk(~T, n, R.C{AR.thaw(Maybe<&2, T>, vT), AR.thaw(U32, pT), Nil{}, tail})), SC.length(Nat, sl), SC.length(Nat, WK.rapp(sl, Nil{})), ec)
  +er2 = Equal.cong(U32, R.DList<T> & List<&2, T>, z => R.tl_fin(~T, tag, fresh, free, SC.length(Nat, sl), head, tail, depth, cap, AR.thaw(U32, nT), R.walk(~T, SC.length(Nat, WK.rapp(sl, Nil{})), R.C{AR.thaw(Maybe<&2, T>, vT), AR.thaw(U32, pT), Nil{}, z})), tail, LST.fst_or(WK.rapp(sl, Nil{}), 0), et)
  +er3 = Equal.cong(R.Cur<T>, R.DList<T> & List<&2, T>, c => R.tl_fin(~T, tag, fresh, free, SC.length(Nat, sl), head, tail, depth, cap, AR.thaw(U32, nT), c), R.walk(~T, SC.length(Nat, WK.rapp(sl, Nil{})), R.C{AR.thaw(Maybe<&2, T>, vT), AR.thaw(U32, pT), Nil{}, LST.fst_or(WK.rapp(sl, Nil{}), 0)}), R.C{AR.thaw(Maybe<&2, T>, vT), AR.thaw(U32, pT), WL.racc(T, AR.slots(Maybe<&2, T>, vT), WK.rapp(sl, Nil{}), Nil{}), 0}, ew)
  +ev = Equal.trans(List<&2, T>, WL.racc(T, AR.slots(Maybe<&2, T>, vT), WK.rapp(sl, Nil{}), Nil{}), SC.append(T, S.values(T, AR.slots(Maybe<&2, T>, vT), sl), Nil{}), S.values(T, AR.slots(Maybe<&2, T>, vT), sl), WL.ra_rapp(T, AR.slots(Maybe<&2, T>, vT), sl, Nil{}, Nil{}), LL.append_nil(T, S.values(T, AR.slots(Maybe<&2, T>, vT), sl)))
