# Removal of a live element: unlinked from between its neighbours, its value
# dropped, and its id either retired (generation exhausted) or pushed on the
# free stack at the next generation.


# ---- the specification's delete ----

def del_mid(+a: List<&2, Nat>, +s: Nat, +b: List<&2, Nat>, +h: {HT.memn(s, a) == False{} : Bool}) -> {S.delete(SC.append(Nat, a, Con{s, b}), s) == SC.append(Nat, a, b) : List<&2, Nat>}:
  match a:
    case Nil{}:
      Equal.cong(Bool, List<&2, Nat>, z => S.pick_list(z, b, Con{s, S.delete(b, s)}), Nat.is_eq(s, s), True{}, N.is_eq_refl(s))
    case Con{+x, +t}:
      +e0 = Equal.cong(Bool, List<&2, Nat>, z => S.pick_list(z, SC.append(Nat, t, Con{s, b}), Con{x, S.delete(SC.append(Nat, t, Con{s, b}), s)}), Nat.is_eq(x, s), False{}, DL.or_ff_l(Nat.is_eq(x, s), HT.memn(s, t), h))
      Equal.trans(List<&2, Nat>, S.delete(SC.append(Nat, Con{x, t}, Con{s, b}), s), Con{x, S.delete(SC.append(Nat, t, Con{s, b}), s)}, Con{x, SC.append(Nat, t, b)}, e0, LL.cons_cong(Nat, x, S.delete(SC.append(Nat, t, Con{s, b}), s), SC.append(Nat, t, b), del_mid(t, s, b, DL.or_ff_r(Nat.is_eq(x, s), HT.memn(s, t), h))))

# ---- facts of the removed state ----

def s_in(+a: List<&2, Nat>, +s: Nat, +b: List<&2, Nat>) -> {HT.memn(s, SC.append(Nat, a, Con{s, b})) == True{} : Bool}:
  LS.mem_app_r(s, a, Con{s, b}, RL.self_in(s, b))

def s_off(+a: List<&2, Nat>, +s: Nat, +b: List<&2, Nat>, +hn: {LST.nodupn(SC.append(Nat, a, Con{s, b})) == True{} : Bool}) -> {HT.memn(s, SC.append(Nat, a, b)) == False{} : Bool}:
  +h = RL.to_eq(LST.nodupn(SC.append(Nat, a, Con{s, b})), Bool.and(LST.nodupn(SC.append(Nat, a, b)), Bool.not(HT.memn(s, SC.append(Nat, a, b)))), LS.nd_mid(a, s, b), hn)
  LS.not_t_f(HT.memn(s, SC.append(Nat, a, b)), L.and_right(LST.nodupn(SC.append(Nat, a, b)), Bool.not(HT.memn(s, SC.append(Nat, a, b))), h))

def nd_rm(+a: List<&2, Nat>, +s: Nat, +b: List<&2, Nat>, +hn: {LST.nodupn(SC.append(Nat, a, Con{s, b})) == True{} : Bool}) -> {LST.nodupn(SC.append(Nat, a, b)) == True{} : Bool}:
  +h = RL.to_eq(LST.nodupn(SC.append(Nat, a, Con{s, b})), Bool.and(LST.nodupn(SC.append(Nat, a, b)), Bool.not(HT.memn(s, SC.append(Nat, a, b)))), LS.nd_mid(a, s, b), hn)
  L.and_left(LST.nodupn(SC.append(Nat, a, b)), Bool.not(HT.memn(s, SC.append(Nat, a, b))), h)

