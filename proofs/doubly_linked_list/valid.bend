  +e2 = Equal.cong(Maybe<&2, T>, Maybe<&2, E.Error>, m => S.live_gen(T, m, U32.is_eq(S.gen_of(SC.take(U32, AR.slots(U32, gT), UD.v(fresh)), UD.v(id)), g)), S.val_of(T, SC.take(Maybe<&2, T>, AR.slots(Maybe<&2, T>, vT), UD.v(fresh)), UD.v(id)), S.val_of(T, AR.slots(Maybe<&2, T>, vT), UD.v(id)), VA.val_take(T, AR.slots(Maybe<&2, T>, vT), UD.v(fresh), UD.v(id), hlt))
  +e3 = Equal.cong(U32, Maybe<&2, E.Error>, z => S.live_gen(T, S.val_of(T, AR.slots(Maybe<&2, T>, vT), UD.v(id)), U32.is_eq(z, g)), S.gen_of(SC.take(U32, AR.slots(U32, gT), UD.v(fresh)), UD.v(id)), W32.nth0(AR.slots(U32, gT), UD.v(id)), VA.gen_take(AR.slots(U32, gT), UD.v(fresh), UD.v(id), hlt))
  Equal.trans(Maybe<&2, E.Error>, S.validate(T, ST.model(~T, ST.LS{tag, cap, fresh, free, head, tail, depth, vT, pT, nT, gT, sl, fl}), E.H{owner, id, g}), S.valid_own(T, SC.take(Maybe<&2, T>, AR.slots(Maybe<&2, T>, vT), UD.v(fresh)), SC.take(U32, AR.slots(U32, gT), UD.v(fresh)), UD.v(id), g, True{}), S.live_gen(T, S.val_of(T, AR.slots(Maybe<&2, T>, vT), UD.v(id)), U32.is_eq(W32.nth0(AR.slots(U32, gT), UD.v(id)), g)), e1, Equal.trans(Maybe<&2, E.Error>, S.valid_own(T, SC.take(Maybe<&2, T>, AR.slots(Maybe<&2, T>, vT), UD.v(fresh)), SC.take(U32, AR.slots(U32, gT), UD.v(fresh)), UD.v(id), g, True{}), S.live_gen(T, S.val_of(T, AR.slots(Maybe<&2, T>, vT), UD.v(id)), U32.is_eq(S.gen_of(SC.take(U32, AR.slots(U32, gT), UD.v(fresh)), UD.v(id)), g)), S.live_gen(T, S.val_of(T, AR.slots(Maybe<&2, T>, vT), UD.v(id)), U32.is_eq(W32.nth0(AR.slots(U32, gT), UD.v(id)), g)), e2, e3))

def lg_false(-T: Data, +m: Maybe<&2, T>) -> {S.live_gen(T, m, False{}) == Some{E.StaleHandle{}} : Maybe<&2, E.Error>}:
  match m:
    case None{}:
      {==}
    case Some{v}:
      {==}

# ---- the verdicts' results ----


# both sides fail with e
