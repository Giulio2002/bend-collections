# 32-bit Montgomery multiplication: mont32(a, b) < m and mont32(a, b) 2^32 == a b (mod m)
def mont_lt(+one: Nat, +h1: {one == 1n : Nat}, +bp: Nat, +m: U32, +mp: U32, +hM: {v(m) == 1n+bp : Nat}, +hinv: {1n+C.low(32n, Nat.mul(1n+bp, v(mp))) == C.shift(32n, one) : Nat}, +a: U32, +b: U32, +hT: {Nat.is_lt(Nat.mul(v(a), v(b)), Nat.mul(1n+bp, 1n+bp)) == True{} : Bool}) -> {Nat.is_lt(v(X.mont32(m, mp, a, b)), 1n+bp) == True{} : Bool}:
