# MulMod.value of spec/math/w64.bend: a * b mod m, the 128-bit product
# reduced by two 96-by-64 steps, each x - q m for the corrected quotient q
# (HACL* Hacl.Spec.Bignum.ModReduction; the Why3 gallery's division
# invariant).

def v(+x: U32) -> Nat:
  U32.to_nat(x)

