def red_q(+x0: U32, +y0: U32, +ml: U32, +mh: U32, +q1: U32, +q2: U32, +e: {q1 == q2 : U32}) -> {SW.value(X.sub(WU.U64{x0, y0}, X.fst_q(X.mul_32_64(q1, WU.U64{ml, mh})))) == SW.value(X.sub(WU.U64{x0, y0}, X.fst_q(X.mul_32_64(q2, WU.U64{ml, mh})))) : Nat}:
  Equal.cong(U32, Nat, t => SW.value(X.sub(WU.U64{x0, y0}, X.fst_q(X.mul_32_64(t, WU.U64{ml, mh})))), q1, q2, e)

def red_fin(+one: Nat, +h1: {one == 1n : Nat}, +x0: U32, +y0: U32, +y1: U32, +ml: U32, +mh: U32, +q: U32, +bp: Nat, +hB: {SW.value(WU.U64{ml, mh}) == 1n+bp : Nat}, p: {Nat.is_le(DM.QB(WU.U64{ml, mh}, q), DM.X96(WU.U64{x0, y0}, y1)) == True{} : Bool} & {Nat.is_lt(DM.X96(WU.U64{x0, y0}, y1), Nat.mul(1n+v(q), SW.value(WU.U64{ml, mh}))) == True{} : Bool}) -> {SW.value(X.sub(WU.U64{x0, y0}, X.fst_q(X.mul_32_64(q, WU.U64{ml, mh})))) == Nat.mod(DM.X96(WU.U64{x0, y0}, y1), SW.value(WU.U64{ml, mh})) : Nat}:
  (+a, +c) = p
