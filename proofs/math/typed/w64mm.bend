      +h2 = N.le_trans(C.shift(32n, one), C.shift(32n, v(ah)), SW.value(WU.U64{al, ah}), WW.shift_mono(32n, one, v(ah), h1a), L.subst(Nat, z => {Nat.is_le(C.shift(32n, v(ah)), z) == True{} : Bool}, Nat.add(C.shift(32n, v(ah)), v(al)), SW.value(WU.U64{al, ah}), N.add_comm(C.shift(32n, v(ah)), v(al)), N.le_add_right(C.shift(32n, v(ah)), v(al))))
