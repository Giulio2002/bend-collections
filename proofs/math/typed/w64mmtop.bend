def v(+x: U32) -> Nat:
  U32.to_nat(x)

def val0(+x: U32) -> {SW.value(WU.U64{x, 0}) == v(x) : Nat}:
  Equal.trans(Nat, Nat.add(v(x), C.shift(32n, 0n)), Nat.add(v(x), 0n), v(x), Equal.cong(Nat, Nat, z => Nat.add(v(x), z), C.shift(32n, 0n), 0n, WW.shift_zero(32n)), N.add_zero(v(x)))

def vm_small(+ml: U32, +mh: U32, +hz: {U32.is_zero(mh) == True{} : Bool}) -> {SW.value(WU.U64{ml, mh}) == v(ml) : Nat}:
  +e0 = N.eq_from_is_eq(v(mh), 0n, Equal.trans(Bool, Nat.is_eq(v(mh), 0n), U32.is_zero(mh), True{}, Equal.sym(Bool, U32.is_zero(mh), Nat.is_eq(v(mh), 0n), LW.zero_nat(mh)), hz))
  Equal.trans(Nat, SW.value(WU.U64{ml, mh}), Nat.add(v(ml), C.shift(32n, 0n)), v(ml), Equal.cong(Nat, Nat, z => Nat.add(v(ml), C.shift(32n, z)), v(mh), 0n, e0), Equal.trans(Nat, Nat.add(v(ml), C.shift(32n, 0n)), Nat.add(v(ml), 0n), v(ml), Equal.cong(Nat, Nat, z => Nat.add(v(ml), z), C.shift(32n, 0n), 0n, WW.shift_zero(32n)), N.add_zero(v(ml))))

