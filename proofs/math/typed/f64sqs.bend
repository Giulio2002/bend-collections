# The spec's root 2 * isqrt(N * 4^j) + [inexact], cut at bit 1 + j, is
# SoftFloat's floor(sqrt(N)) with its sticky bit (Flocq's sqrt with a
# sticky remainder bit, round_NE once).

def hb2n(+c: Bool) -> {C.half(SF.b2n(c)) == 0n : Nat}:
  match c:
    case True{}:
      {==}
    case False{}:
      {==}

def bb2n(+c: Bool) -> {C.bit(SF.b2n(c)) == SF.b2n(c) : Nat}:
  match c:
    case True{}:
      {==}
    case False{}:
      {==}

def eb2n(+c: Bool) -> {Nat.is_eq(SF.b2n(Bool.not(c)), 0n) == c : Bool}:
  match c:
    case True{}:
      {==}
    case False{}:
      {==}

