def plus1(+x: Nat) -> {Nat.add(x, 1n) == 1n+x : Nat}:
  Equal.trans(Nat, Nat.add(x, 1n), 1n+Nat.add(x, 0n), 1n+x, N.add_succ(x, 0n), N.succ_cong(Nat.add(x, 0n), x, N.add_zero(x)))

# m + 1 == 2 hh for odd m, hh = m / 2 + 1
