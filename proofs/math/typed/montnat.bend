  +e2 = Equal.cong(Nat, Nat, w => 1n+w, 1n+bp, 1n+Nat.add(Nat.div(1n+bp, 2n), Nat.div(1n+bp, 2n)), e1)
  Equal.trans(Nat, 1n+1n+bp, 1n+1n+Nat.add(Nat.div(1n+bp, 2n), Nat.div(1n+bp, 2n)), Nat.add(1n+Nat.div(1n+bp, 2n), 1n+Nat.div(1n+bp, 2n)), e2, Equal.sym(Nat, Nat.add(1n+Nat.div(1n+bp, 2n), 1n+Nat.div(1n+bp, 2n)), 1n+1n+Nat.add(Nat.div(1n+bp, 2n), Nat.div(1n+bp, 2n)), Equal.cong(Nat, Nat, w => 1n+w, Nat.add(Nat.div(1n+bp, 2n), 1n+Nat.div(1n+bp, 2n)), 1n+Nat.add(Nat.div(1n+bp, 2n), Nat.div(1n+bp, 2n)), N.add_succ(Nat.div(1n+bp, 2n), Nat.div(1n+bp, 2n)))))
