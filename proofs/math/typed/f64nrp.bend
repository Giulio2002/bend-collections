  +eq = shl_v(sig, Nat.sub(Nat.sub(X.clz(sig), 1n), 10n), M.bit_length(SW.value(sig)), hk10, L.subst(Nat, w => {Nat.is_le(w, 64n) == True{} : Bool}, 53n, Nat.add(Nat.sub(Nat.sub(X.clz(sig), 1n), 10n), M.bit_length(SW.value(sig))), Equal.sym(Nat, Nat.add(Nat.sub(Nat.sub(X.clz(sig), 1n), 10n), M.bit_length(SW.value(sig))), 53n, ek10), {==}), RT.bl_fit(SW.value(sig)))
