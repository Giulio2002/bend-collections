def nrp_c(+one: Nat, +h1: {one == 1n : Nat}, +s: Bool, +e: Nat, +sig: WU.U64, +x: Nat, +hx: {Nat.add(x, 2180n) == e : Nat}, +hz: {Nat.is_eq(SW.value(sig), 0n) == False{} : Bool}, +h63: {C.fits(63n, SW.value(sig)) == True{} : Bool}, +hx63: {Nat.is_le(63n, x) == True{} : Bool}, +d: Bool, +hd: {Bool.and(Nat.is_le(10n, Nat.sub(X.clz(sig), 1n)), Bool.and(Nat.is_le(Nat.add(F.off(), Nat.sub(X.clz(sig), 1n)), e), Nat.is_lt(Nat.sub(e, Nat.sub(X.clz(sig), 1n)), Nat.add(F.off(), 2045n)))) == d : Bool}) -> {F.nrp_pick(s, e, sig, Nat.sub(X.clz(sig), 1n), d) == SF.round(s, SW.value(sig), x) : F.F64}:
  match d:
    case True{}:
      +ha = and_l(Nat.is_le(10n, Nat.sub(X.clz(sig), 1n)), Bool.and(Nat.is_le(Nat.add(F.off(), Nat.sub(X.clz(sig), 1n)), e), Nat.is_lt(Nat.sub(e, Nat.sub(X.clz(sig), 1n)), Nat.add(F.off(), 2045n))), hd)
