def tbn(+k: Nat, +V: Nat, +K: Nat, +hz: {Nat.is_eq(V, 0n) == False{} : Bool}, +ek: {Nat.add(k, M.bit_length(V)) == 1n+K : Nat}) -> {C.fits(K, C.shift(k, V)) == False{} : Bool}:
