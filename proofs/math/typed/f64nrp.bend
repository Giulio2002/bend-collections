  +h52 = tbn(Nat.sub(Nat.sub(X.clz(sig), 1n), 10n), SW.value(sig), 52n, hz, ek10)
  +hkx = N.le_trans(k, 63n, x, sd_le(sig, h63), hx63)
  +ex = N.sub_add(x, k, hkx)
  +eek = Equal.trans(Nat, Nat.sub(e, k), Nat.sub(Nat.add(x, 2180n), k), Nat.add(Nat.sub(x, Nat.sub(X.clz(sig), 1n)), 2180n), Equal.cong(Nat, Nat, w => Nat.sub(w, k), e, Nat.add(x, 2180n), Equal.sym(Nat, Nat.add(x, 2180n), e, hx)), FR.sub_add_r(x, 2180n, k, hkx))
  +hw = L.subst(Nat, w => {Nat.is_le(4096n, w) == True{} : Bool}, Nat.sub(e, k), Nat.add(Nat.sub(x, Nat.sub(X.clz(sig), 1n)), 2180n), eek, RT.le_sub(4096n, k, e, L.subst(Nat, w => {Nat.is_le(w, e) == True{} : Bool}, Nat.add(F.off(), k), Nat.add(4096n, k), {==}, hoff)))
