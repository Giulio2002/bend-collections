def sdb(+sig: WU.U64, +h63: {C.fits(63n, SW.value(sig)) == True{} : Bool}) -> {Nat.add(Nat.sub(X.clz(sig), 1n), M.bit_length(SW.value(sig))) == 63n : Nat}:
