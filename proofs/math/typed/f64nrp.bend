      nrp_d(one, h1, s, e, sig, x, hx, hz, h63, hx63, ha, and_l(Nat.is_le(Nat.add(F.off(), Nat.sub(X.clz(sig), 1n)), e), Nat.is_lt(Nat.sub(e, Nat.sub(X.clz(sig), 1n)), Nat.add(F.off(), 2045n)), hb), and_r(Nat.is_le(Nat.add(F.off(), Nat.sub(X.clz(sig), 1n)), e), Nat.is_lt(Nat.sub(e, Nat.sub(X.clz(sig), 1n)), Nat.add(F.off(), 2045n)), hb))
    case False{}:
