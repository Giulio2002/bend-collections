      L.subst(Nat, z => {Nat.add(U32.to_nat(U32.from_nat(Nat.add(Nat.mul(Nat.add(Nat.mul(Nat.div(X.dig_t(v(U32.mod(hi, d)), 256n, d1g(lo, c24)), z), 4096n), Nat.div(X.dig_t(Nat.mod(X.dig_t(v(U32.mod(hi, d)), 256n, d1g(lo, c24)), z), 4096n, d2g(lo, c12, m12)), z)), 4096n), Nat.div(X.dig_t(Nat.mod(X.dig_t(Nat.mod(X.dig_t(v(U32.mod(hi, d)), 256n, d1g(lo, c24)), z), 4096n, d2g(lo, c12, m12)), z), 4096n, d3g(lo, m12)), z)))), C.shift(32n, v(U32.div(hi, d)))) == Nat.div(SW.value(WU.U64{lo, hi}), z) : Nat}, 1n+dp, v(d), Equal.sym(Nat, v(d), 1n+dp, hnd), quot_core(one, h1, k, hk, lo, hi, d, hd, c24, p24, c12, p12, m12, pm12, dp, hnd))

# Div32.quot: a 64-bit value divided by a nonzero U32
def div32_quot(+a: WU.U64, +d: U32, +hd: {U32.is_zero(d) == False{} : Bool}) -> SW.Div32.quot(a, d, hd):
  match a:
    case WU.U64{+lo, +hi}:
      %Equal.sym(WU.U64, X.fst_q(X.div32(WU.U64{lo, hi}, d)), div32q_g(lo, hi, d, 16777216, 4096, 4095), impl_q(lo, hi, d)) : {SW.value(_) == Nat.div(SW.value(WU.U64{lo, hi}), U32.to_nat(d)) : Nat}
      quot_inner(1n, {==}, 32n, {==}, lo, hi, d, hd, 16777216, {==}, 4096, {==}, 4095, {==}, v(d), {==})
