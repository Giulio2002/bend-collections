# Mod32.value and Div32 of spec/math/w64.bend: 64 / 32 long division, the
# high word by U32 division and the low word by 8, 12 and 12-bit digits
# (Knuth TAOCP 4.3.1, short division; the digit decomposition follows the
# proved 20/8/12 split of proofs/math/u64/u64div.bend, and the invariant
# "remainder of the prefix" is WhyMP's mpn_divrem_1 loop invariant, Rieu-Helft
# et al., VSTTE 2017). The digit constants 2^24, 2^12 are U32 words kept
# symbolic; the Nat bases 256 and 4096 are small enough for the checker.

def v(+x: U32) -> Nat:
  UD.v(x)

# ---- the low word in 8/12/12-bit digits ----

def lo_dig(+one: Nat, +h1: {one == 1n : Nat}, +lo: U32, +c24: U32, +c12x: U32, +m12: U32, +ml: U32, +h24: {UD.v(c24) == WD.sc(24n, one) : Nat}, +h12x: {UD.v(c12x) == WD.sc(12n, one) : Nat}, +hm12: {m12 == U32{WD.mask(32n, 12n)} : U32}, +hml: {ml == U32{WD.mask(32n, 12n)} : U32}, +nz24: {U32.is_zero(c24) == False{} : Bool}, +nz12: {U32.is_zero(c12x) == False{} : Bool}) -> {UD.v(lo) == Nat.add(Nat.add(WD.sc(24n, UD.v(U32.div(lo, c24))), WD.sc(12n, UD.v(U32.and(U32.div(lo, c12x), m12)))), UD.v(U32.and(lo, ml))) : Nat}:
  +ln = UD.v(lo)
  +l1 = UD.v(U32.div(lo, c24))
  +r1 = UD.v(U32.mod(lo, c24))
  +w8 = UD.v(U32.div(lo, c12x))
  +r8 = UD.v(U32.mod(lo, c12x))
  +l2 = UD.v(U32.and(U32.div(lo, c12x), m12))
  +l3 = UD.v(U32.and(lo, ml))
  +y2 = PD.hp32(12n, U32.div(lo, c12x))
  +y3 = PD.hp32(12n, lo)
  +e24 = Equal.trans(Nat, Nat.add(WD.sc(24n, l1), r1), Nat.add(Nat.mul(l1, UD.v(c24)), r1), ln, Equal.cong(Nat, Nat, z => Nat.add(z, r1), WD.sc(24n, l1), Nat.mul(l1, UD.v(c24)), Equal.sym(Nat, Nat.mul(l1, UD.v(c24)), WD.sc(24n, l1), PD.mul_pow(one, h1, 24n, l1, UD.v(c24), h24))), PD.dm_e(lo, c24, nz24))
  +l24 = L.subst(Nat, z => {Nat.is_lt(r1, z) == True{} : Bool}, UD.v(c24), WD.sc(24n, one), h24, PD.dm_l(lo, c24, nz24))
  +e12x = Equal.trans(Nat, Nat.add(WD.sc(12n, w8), r8), Nat.add(Nat.mul(w8, UD.v(c12x)), r8), ln, Equal.cong(Nat, Nat, z => Nat.add(z, r8), WD.sc(12n, w8), Nat.mul(w8, UD.v(c12x)), Equal.sym(Nat, Nat.mul(w8, UD.v(c12x)), WD.sc(12n, w8), PD.mul_pow(one, h1, 12n, w8, UD.v(c12x), h12x))), PD.dm_e(lo, c12x, nz12))
  +l12x = L.subst(Nat, z => {Nat.is_lt(r8, z) == True{} : Bool}, UD.v(c12x), WD.sc(12n, one), h12x, PD.dm_l(lo, c12x, nz12))
  +s3 = PD.and32(12n, lo, ml, hml)
  +b3 = PD.and32_lt(12n, one, h1, lo, ml, hml)
  +er8 = WD.uniq(12n, one, h1, r8, l3, w8, y3, Equal.trans(Nat, Nat.add(r8, WD.sc(12n, w8)), Nat.add(WD.sc(12n, w8), r8), Nat.add(l3, WD.sc(12n, y3)), N.add_comm(r8, WD.sc(12n, w8)), Equal.trans(Nat, Nat.add(WD.sc(12n, w8), r8), ln, Nat.add(l3, WD.sc(12n, y3)), e12x, s3)), l12x, b3)
  +s2 = PD.and32(12n, U32.div(lo, c12x), m12, hm12)
  +b2 = PD.and32_lt(12n, one, h1, U32.div(lo, c12x), m12, hm12)
  # ln == (2^8 l2 + 2^20 y2) + l3
  +elw = Equal.trans(Nat, ln, Nat.add(WD.sc(12n, w8), l3), Nat.add(Nat.add(WD.sc(12n, l2), WD.sc(24n, y2)), l3),
    Equal.trans(Nat, ln, Nat.add(WD.sc(12n, w8), r8), Nat.add(WD.sc(12n, w8), l3), Equal.sym(Nat, Nat.add(WD.sc(12n, w8), r8), ln, e12x), Equal.cong(Nat, Nat, z => Nat.add(WD.sc(12n, w8), z), r8, l3, er8)),
    Equal.cong(Nat, Nat, z => Nat.add(z, l3), WD.sc(12n, w8), Nat.add(WD.sc(12n, l2), WD.sc(24n, y2)),
      Equal.trans(Nat, WD.sc(12n, w8), WD.sc(12n, Nat.add(l2, WD.sc(12n, y2))), Nat.add(WD.sc(12n, l2), WD.sc(24n, y2)), Equal.cong(Nat, Nat, z => WD.sc(12n, z), w8, Nat.add(l2, WD.sc(12n, y2)), s2), Equal.sym(Nat, Nat.add(WD.sc(12n, l2), WD.sc(12n, WD.sc(12n, y2))), WD.sc(12n, Nat.add(l2, WD.sc(12n, y2))), A.sc_add(12n, l2, WD.sc(12n, y2))))))
  +hb2 = AR.digit_lt(12n, one, h1, l3, l2, WD.sc(12n, one), b3, b2)
  +er1 = WD.uniq(24n, one, h1, r1, Nat.add(WD.sc(12n, l2), l3), l1, y2,
    Equal.trans(Nat, Nat.add(r1, WD.sc(24n, l1)), ln, Nat.add(Nat.add(WD.sc(12n, l2), l3), WD.sc(24n, y2)),
      Equal.trans(Nat, Nat.add(r1, WD.sc(24n, l1)), Nat.add(WD.sc(24n, l1), r1), ln, N.add_comm(r1, WD.sc(24n, l1)), e24),
      Equal.trans(Nat, ln, Nat.add(Nat.add(WD.sc(12n, l2), WD.sc(24n, y2)), l3), Nat.add(Nat.add(WD.sc(12n, l2), l3), WD.sc(24n, y2)), elw, A.add_rot(WD.sc(12n, l2), WD.sc(24n, y2), l3))),
    l24, hb2)
  Equal.trans(Nat, ln, Nat.add(WD.sc(24n, l1), Nat.add(WD.sc(12n, l2), l3)), Nat.add(Nat.add(WD.sc(24n, l1), WD.sc(12n, l2)), l3),
    Equal.trans(Nat, ln, Nat.add(WD.sc(24n, l1), r1), Nat.add(WD.sc(24n, l1), Nat.add(WD.sc(12n, l2), l3)), Equal.sym(Nat, Nat.add(WD.sc(24n, l1), r1), ln, e24), Equal.cong(Nat, Nat, z => Nat.add(WD.sc(24n, l1), z), r1, Nat.add(WD.sc(12n, l2), l3), er1)),
    Equal.sym(Nat, Nat.add(Nat.add(WD.sc(24n, l1), WD.sc(12n, l2)), l3), Nat.add(WD.sc(24n, l1), Nat.add(WD.sc(12n, l2), l3)), N.add_assoc(WD.sc(24n, l1), WD.sc(12n, l2), l3)))

# the top digit of the low limb is below 2^12

def lo_top(+one: Nat, +h1: {one == 1n : Nat}, +lo: U32, +c24: U32, +h24: {UD.v(c24) == WD.sc(24n, one) : Nat}, +nz24: {U32.is_zero(c24) == False{} : Bool}) -> {Nat.is_lt(UD.v(U32.div(lo, c24)), WD.sc(8n, one)) == True{} : Bool}:
  +l1 = UD.v(U32.div(lo, c24))
  +r1 = UD.v(U32.mod(lo, c24))
  +e24 = Equal.trans(Nat, Nat.add(WD.sc(24n, l1), r1), Nat.add(Nat.mul(l1, UD.v(c24)), r1), UD.v(lo), Equal.cong(Nat, Nat, z => Nat.add(z, r1), WD.sc(24n, l1), Nat.mul(l1, UD.v(c24)), Equal.sym(Nat, Nat.mul(l1, UD.v(c24)), WD.sc(24n, l1), PD.mul_pow(one, h1, 24n, l1, UD.v(c24), h24))), PD.dm_e(lo, c24, nz24))
  +le = L.subst(Nat, z => {Nat.is_le(WD.sc(24n, l1), z) == True{} : Bool}, Nat.add(WD.sc(24n, l1), r1), UD.v(lo), e24, N.le_add_right(WD.sc(24n, l1), r1))
  AR.sc_lt_cancel(24n, l1, WD.sc(8n, one), N.le_lt_trans(WD.sc(24n, l1), UD.v(lo), WD.sc(32n, one), le, UD.vb(one, h1, lo)))


# ---- the Nat bases ----

def k256(+one: Nat, +h1: {one == 1n : Nat}) -> {256n == WD.sc(8n, one) : Nat}:
  L.subst(Nat, o => {256n == WD.sc(8n, o) : Nat}, 1n, one, Equal.sym(Nat, one, 1n, h1), {==})

def k4096(+one: Nat, +h1: {one == 1n : Nat}) -> {4096n == WD.sc(12n, one) : Nat}:
  L.subst(Nat, o => {4096n == WD.sc(12n, o) : Nat}, 1n, one, Equal.sym(Nat, one, 1n, h1), {==})

# ---- one short-division step keeps the remainder of the prefix ----

def mstep(+dp: Nat, +x: Nat, +b: Nat, +g: Nat) -> {Nat.mod(Nat.add(Nat.mul(Nat.mod(x, 1n+dp), b), g), 1n+dp) == Nat.mod(Nat.add(Nat.mul(x, b), g), 1n+dp) : Nat}:
  +y = Nat.mul(Nat.mod(x, 1n+dp), b)
  Equal.trans(Nat, Nat.mod(Nat.add(y, g), 1n+dp), Nat.mod(Nat.add(Nat.mod(y, 1n+dp), g), 1n+dp), Nat.mod(Nat.add(Nat.mul(x, b), g), 1n+dp), Equal.sym(Nat, Nat.mod(Nat.add(Nat.mod(y, 1n+dp), g), 1n+dp), Nat.mod(Nat.add(y, g), 1n+dp), NR.mod_add_l(dp, y, g)),
    Equal.trans(Nat, Nat.mod(Nat.add(Nat.mod(y, 1n+dp), g), 1n+dp), Nat.mod(Nat.add(Nat.mod(Nat.mul(x, b), 1n+dp), g), 1n+dp), Nat.mod(Nat.add(Nat.mul(x, b), g), 1n+dp), Equal.cong(Nat, Nat, t => Nat.mod(Nat.add(t, g), 1n+dp), Nat.mod(y, 1n+dp), Nat.mod(Nat.mul(x, b), 1n+dp), NR.mod_mul_l(dp, x, b)), NR.mod_add_l(dp, Nat.mul(x, b), g)))

# ---- the digits rebuild the 64-bit value ----

def x3_eq(+one: Nat, +h1: {one == 1n : Nat}, +h: Nat, +g1: Nat, +g2: Nat, +g3: Nat) -> {Nat.add(Nat.mul(Nat.add(Nat.mul(Nat.add(Nat.mul(h, 256n), g1), 4096n), g2), 4096n), g3) == Nat.add(Nat.add(Nat.add(WD.sc(24n, g1), WD.sc(12n, g2)), g3), WD.sc(32n, h)) : Nat}:
  +h8 = WD.sc(8n, h)
  +a1 = Nat.add(Nat.mul(h, 256n), g1)
  +e1 = WM.cong_l(Nat.mul(h, 256n), h8, g1, PD.mul_pow(one, h1, 8n, h, 256n, k256(one, h1)))
  +b1 = Nat.add(WD.sc(20n, h), WD.sc(12n, g1))
  +s2 = Equal.trans(Nat, Nat.mul(Nat.add(h8, g1), 4096n), WD.sc(12n, Nat.add(h8, g1)), b1, PD.mul_pow(one, h1, 12n, Nat.add(h8, g1), 4096n, k4096(one, h1)), Equal.trans(Nat, WD.sc(12n, Nat.add(h8, g1)), Nat.add(WD.sc(12n, h8), WD.sc(12n, g1)), b1, WM.sc_add2(12n, h8, g1), WM.cong_l(WD.sc(12n, h8), WD.sc(20n, h), WD.sc(12n, g1), WM.sc_sc(12n, 8n, h))))
  +e2 = Equal.trans(Nat, Nat.mul(a1, 4096n), Nat.mul(Nat.add(h8, g1), 4096n), b1, Equal.cong(Nat, Nat, t => Nat.mul(t, 4096n), a1, Nat.add(h8, g1), e1), s2)
  +a2 = Nat.add(Nat.mul(a1, 4096n), g2)
  +b2 = Nat.add(b1, g2)
  +e3 = WM.cong_l(Nat.mul(a1, 4096n), b1, g2, e2)
  +b3 = Nat.add(Nat.add(WD.sc(32n, h), WD.sc(24n, g1)), WD.sc(12n, g2))
  +s3 = Equal.trans(Nat, Nat.mul(b2, 4096n), WD.sc(12n, b2), b3, PD.mul_pow(one, h1, 12n, b2, 4096n, k4096(one, h1)), Equal.trans(Nat, WD.sc(12n, b2), Nat.add(WD.sc(12n, b1), WD.sc(12n, g2)), b3, WM.sc_add2(12n, b1, g2), WM.cong_l(WD.sc(12n, b1), Nat.add(WD.sc(32n, h), WD.sc(24n, g1)), WD.sc(12n, g2), Equal.trans(Nat, WD.sc(12n, b1), Nat.add(WD.sc(12n, WD.sc(20n, h)), WD.sc(12n, WD.sc(12n, g1))), Nat.add(WD.sc(32n, h), WD.sc(24n, g1)), WM.sc_add2(12n, WD.sc(20n, h), WD.sc(12n, g1)), Equal.trans(Nat, Nat.add(WD.sc(12n, WD.sc(20n, h)), WD.sc(12n, WD.sc(12n, g1))), Nat.add(WD.sc(32n, h), WD.sc(12n, WD.sc(12n, g1))), Nat.add(WD.sc(32n, h), WD.sc(24n, g1)), WM.cong_l(WD.sc(12n, WD.sc(20n, h)), WD.sc(32n, h), WD.sc(12n, WD.sc(12n, g1)), WM.sc_sc(12n, 20n, h)), WM.cong_r(WD.sc(32n, h), WD.sc(12n, WD.sc(12n, g1)), WD.sc(24n, g1), WM.sc_sc(12n, 12n, g1)))))))
  +e4 = Equal.trans(Nat, Nat.mul(a2, 4096n), Nat.mul(b2, 4096n), b3, Equal.cong(Nat, Nat, t => Nat.mul(t, 4096n), a2, b2, e3), s3)
  +pp = WD.sc(32n, h)
  +aa = WD.sc(24n, g1)
  +bb = WD.sc(12n, g2)
  +e5 = Equal.trans(Nat, Nat.add(Nat.add(Nat.add(pp, aa), bb), g3), Nat.add(Nat.add(pp, Nat.add(aa, bb)), g3), Nat.add(Nat.add(Nat.add(aa, bb), g3), pp), WM.cong_l(Nat.add(Nat.add(pp, aa), bb), Nat.add(pp, Nat.add(aa, bb)), g3, NA.add_assoc(pp, aa, bb)), Equal.trans(Nat, Nat.add(Nat.add(pp, Nat.add(aa, bb)), g3), Nat.add(pp, Nat.add(Nat.add(aa, bb), g3)), Nat.add(Nat.add(Nat.add(aa, bb), g3), pp), NA.add_assoc(pp, Nat.add(aa, bb), g3), NA.add_comm(pp, Nat.add(Nat.add(aa, bb), g3))))
  Equal.trans(Nat, Nat.add(Nat.mul(a2, 4096n), g3), Nat.add(b3, g3), Nat.add(Nat.add(Nat.add(aa, bb), g3), pp), WM.cong_l(Nat.mul(a2, 4096n), b3, g3, e4), e5)

# ---- mod32 with its word constants symbolic ----

def d1g(+lo: U32, +c24: U32) -> Nat:
  U32.to_nat(U32.div(lo, c24))

def d2g(+lo: U32, +c12: U32, +m12: U32) -> Nat:
  U32.to_nat(U32.and(U32.div(lo, c12), m12))

def d3g(+lo: U32, +m12: U32) -> Nat:
  U32.to_nat(U32.and(lo, m12))

def mod32g(+a: WU.U64, +d: U32, +c24: U32, +c12: U32, +m12: U32) -> U32:
  U32.from_nat(X.mod_step(X.mod_step(X.mod_step(U32.to_nat(U32.mod(X.hi(a), d)), 256n, d1g(X.lo(a), c24), U32.to_nat(d)), 4096n, d2g(X.lo(a), c12, m12), U32.to_nat(d)), 4096n, d3g(X.lo(a), m12), U32.to_nat(d)))

def impl_mod(+a: WU.U64, +d: U32) -> {X.mod32(a, d) == mod32g(a, d, 16777216, 4096, 4095) : U32}:
  {==}

def mod_inner(+one: Nat, +h1: {one == 1n : Nat}, +k: Nat, +hk: {k == 32n : Nat}, +lo: U32, +hi: U32, +d: U32, +hd: {U32.is_zero(d) == False{} : Bool}, +c24: U32, +p24: {c24 == U32{WD.pw(32n, 24n)} : U32}, +c12: U32, +p12: {c12 == U32{WD.pw(32n, 12n)} : U32}, +m12: U32, +pm12: {m12 == U32{WD.mask(32n, 12n)} : U32}, +nd: Nat, +hnd: {v(d) == nd : Nat}) -> {v(mod32g(WU.U64{lo, hi}, d, c24, c12, m12)) == Nat.mod(SW.value(WU.U64{lo, hi}), v(d)) : Nat}:
  match nd:
    case 0n:
      Empty.absurd({v(mod32g(WU.U64{lo, hi}, d, c24, c12, m12)) == Nat.mod(SW.value(WU.U64{lo, hi}), v(d)) : Nat}, U32P.true_ne_false(Equal.trans(Bool, True{}, U32.is_zero(d), False{}, Equal.sym(Bool, U32.is_zero(d), True{}, L.subst(U32, z => {U32.is_zero(z) == True{} : Bool}, 0, d, Equal.sym(U32, d, 0, U.injective(d, 0, hnd)), {==})), hd)))
    case 1n+ +dp:
      +hh = v(hi)
      +g1 = d1g(lo, c24)
      +g2 = d2g(lo, c12, m12)
      +g3 = d3g(lo, m12)
      +h24 = PD.pow32(24n, {==}, one, h1, c24, p24)
      +h12 = PD.pow32(12n, {==}, one, h1, c12, p12)
      +nz24 = L.subst(U32, z => {U32.is_zero(z) == False{} : Bool}, U32{WD.pw(32n, 24n)}, c24, Equal.sym(U32, c24, U32{WD.pw(32n, 24n)}, p24), {==})
      +nz12 = L.subst(U32, z => {U32.is_zero(z) == False{} : Bool}, U32{WD.pw(32n, 12n)}, c12, Equal.sym(U32, c12, U32{WD.pw(32n, 12n)}, p12), {==})
      +e0 = Equal.trans(Nat, v(U32.mod(hi, d)), Nat.mod(hh, v(d)), Nat.mod(hh, 1n+dp), UD.mod_nat(hi, d, hd), Equal.cong(Nat, Nat, t => Nat.mod(hh, t), v(d), 1n+dp, hnd))
      +x1 = Nat.add(Nat.mul(hh, 256n), g1)
      +x2 = Nat.add(Nat.mul(x1, 4096n), g2)
      +x3 = Nat.add(Nat.mul(x2, 4096n), g3)
      +m0 = v(U32.mod(hi, d))
      +m1 = Nat.mod(Nat.add(Nat.mul(m0, 256n), g1), 1n+dp)
      +m2 = Nat.mod(Nat.add(Nat.mul(m1, 4096n), g2), 1n+dp)
      +rr = Nat.mod(Nat.add(Nat.mul(m2, 4096n), g3), 1n+dp)
      +e1 = Equal.trans(Nat, m1, Nat.mod(Nat.add(Nat.mul(Nat.mod(hh, 1n+dp), 256n), g1), 1n+dp), Nat.mod(x1, 1n+dp), Equal.cong(Nat, Nat, t => Nat.mod(Nat.add(Nat.mul(t, 256n), g1), 1n+dp), m0, Nat.mod(hh, 1n+dp), e0), mstep(dp, hh, 256n, g1))
      +e2 = Equal.trans(Nat, m2, Nat.mod(Nat.add(Nat.mul(Nat.mod(x1, 1n+dp), 4096n), g2), 1n+dp), Nat.mod(x2, 1n+dp), Equal.cong(Nat, Nat, t => Nat.mod(Nat.add(Nat.mul(t, 4096n), g2), 1n+dp), m1, Nat.mod(x1, 1n+dp), e1), mstep(dp, x1, 4096n, g2))
      +e3 = Equal.trans(Nat, rr, Nat.mod(Nat.add(Nat.mul(Nat.mod(x2, 1n+dp), 4096n), g3), 1n+dp), Nat.mod(x3, 1n+dp), Equal.cong(Nat, Nat, t => Nat.mod(Nat.add(Nat.mul(t, 4096n), g3), 1n+dp), m2, Nat.mod(x2, 1n+dp), e2), mstep(dp, x2, 4096n, g3))
      +elo = lo_dig(one, h1, lo, c24, c12, m12, m12, h24, h12, pm12, pm12, nz24, nz12)
      +ex3 = Equal.trans(Nat, x3, Nat.add(Nat.add(Nat.add(WD.sc(24n, g1), WD.sc(12n, g2)), g3), WD.sc(32n, hh)), SW.value(WU.U64{lo, hi}), x3_eq(one, h1, hh, g1, g2, g3), Equal.trans(Nat, Nat.add(Nat.add(Nat.add(WD.sc(24n, g1), WD.sc(12n, g2)), g3), WD.sc(32n, hh)), Nat.add(v(lo), WD.sc(32n, hh)), SW.value(WU.U64{lo, hi}), WM.cong_l(Nat.add(Nat.add(WD.sc(24n, g1), WD.sc(12n, g2)), g3), v(lo), WD.sc(32n, hh), Equal.sym(Nat, v(lo), Nat.add(Nat.add(WD.sc(24n, g1), WD.sc(12n, g2)), g3), elo)), WM.cong_r(v(lo), WD.sc(32n, hh), C.shift(32n, hh), Equal.sym(Nat, C.shift(32n, hh), WD.sc(32n, hh), WM.shift_sc(32n, hh)))))
      +eres = Equal.trans(Nat, rr, Nat.mod(x3, 1n+dp), Nat.mod(SW.value(WU.U64{lo, hi}), 1n+dp), e3, Equal.cong(Nat, Nat, t => Nat.mod(t, 1n+dp), x3, SW.value(WU.U64{lo, hi}), ex3))
      +blt = N.lt_le_trans(rr, 1n+dp, C.pow2(k), NR.dm_lt(dp, Nat.add(Nat.mul(m2, 4096n), g3)), N.lt_le(1n+dp, C.pow2(k), L.subst(Nat, z => {Nat.is_lt(z, C.pow2(k)) == True{} : Bool}, v(d), 1n+dp, hnd, U32P.val_lt(1n, {==}, k, hk, d))))
      +efit = U.to_nat_from_nat(rr, k, U32P.le_k(k, hk), blt)
      %Equal.sym(Nat, v(d), 1n+dp, hnd) : {v(U32.from_nat(X.mod_step(X.mod_step(X.mod_step(v(U32.mod(hi, d)), 256n, g1, _), 4096n, g2, _), 4096n, g3, _))) == Nat.mod(SW.value(WU.U64{lo, hi}), _) : Nat}
      Equal.trans(Nat, v(U32.from_nat(rr)), rr, Nat.mod(SW.value(WU.U64{lo, hi}), 1n+dp), efit, eres)

# Mod32.value: a 64-bit value mod a nonzero U32
def mod32_value(+a: WU.U64, +d: U32, +hd: {U32.is_zero(d) == False{} : Bool}) -> SW.Mod32.value(a, d, hd):
  match a:
    case WU.U64{+lo, +hi}:
      %Equal.sym(U32, X.mod32(WU.U64{lo, hi}, d), mod32g(WU.U64{lo, hi}, d, 16777216, 4096, 4095), impl_mod(WU.U64{lo, hi}, d)) : {U32.to_nat(_) == Nat.mod(SW.value(WU.U64{lo, hi}), U32.to_nat(d)) : Nat}
      mod_inner(1n, {==}, 32n, {==}, lo, hi, d, hd, 16777216, {==}, 4096, {==}, 4095, {==}, v(d), {==})

# Div32.rem: div32's remainder is mod32's term
def div32_rem(+a: WU.U64, +d: U32, +hd: {U32.is_zero(d) == False{} : Bool}) -> SW.Div32.rem(a, d, hd):
  mod32_value(a, d, hd)

