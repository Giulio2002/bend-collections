  %Equal.sym(Nat, Nat.mul(Nat.mul(d, k), r), Nat.mul(d, Nat.mul(k, r)), NA.mul_assoc(d, k, r)) : {Nat.add(Nat.mul(d, Nat.mul(k, r)), y) == Nat.add(y, _) : Nat}
  %Equal.sym(Nat, Nat.add(y, Nat.mul(d, Nat.mul(k, r))), Nat.add(Nat.mul(d, Nat.mul(k, r)), y), NA.add_comm(y, Nat.mul(d, Nat.mul(k, r)))) : {Nat.add(Nat.mul(d, Nat.mul(k, r)), y) == _ : Nat}
  {==}

