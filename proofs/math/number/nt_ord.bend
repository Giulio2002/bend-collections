    case 1n+kp:
      N.zero_succ(Nat.add(rr, Nat.mul(kp, 2n+rr)), N.succ_inj(0n, 1n+Nat.add(rr, Nat.mul(kp, 2n+rr)), e))

def step_abs(np: Nat, +rr: Nat, +k: Nat, +qq: Nat, +m: Nat, +a: Nat, +b: Nat, +u: Nat, +v: Nat, +hr: PM.Prime(2n+rr), +e: {1n+np == Nat.mul(k, 2n+rr) : Nat}, +hq: PM.Prime(2n+qq), +en: {1n+np == Nat.add(Nat.mul(2n+qq, m), 1n) : Nat}, +h1: {Nat.mod(Nat.pow(a, Nat.mul(2n+qq, m)), 1n+np) == 1n : Nat}, +hb: {Nat.mod(Nat.pow(a, m), 1n+np) == b : Nat}, +hz: {Nat.mul(u, Nat.sub(b, 1n)) == Nat.add(Nat.mul(v, 1n+np), 1n) : Nat}, +hn: {Nat.is_eq(Nat.mod(1n+rr, 2n+qq), 0n) == False{} : Bool}) -> Empty:
  match np:
    case 0n:
      one_ne(k, rr, e)
    case 1n+ +j:
      +x = Nat.mul(2n+qq, m)
      +ex = N.succ_inj(1n+j, x, Equal.trans(Nat, 2n+j, Nat.add(x, 1n), 1n+x, en, NA.add_comm(x, 1n)))
      +hx = Equal.trans(Nat, Nat.mod(Nat.pow(a, x), 2n+rr), Nat.mod(Nat.mod(Nat.pow(a, x), 2n+j), 2n+rr), 1n, Equal.sym(Nat, Nat.mod(Nat.mod(Nat.pow(a, x), 2n+j), 2n+rr), Nat.mod(Nat.pow(a, x), 2n+rr), md(1n+j, 1n+rr, k, Nat.pow(a, x), e)), Equal.trans(Nat, Nat.mod(Nat.mod(Nat.pow(a, x), 2n+j), 2n+rr), Nat.mod(1n, 2n+rr), 1n, Equal.cong(Nat, Nat, z => Nat.mod(z, 2n+rr), Nat.mod(Nat.pow(a, x), 2n+j), 1n, h1), one_mod(rr)))
      +hj = Equal.trans(Nat, Nat.mod(Nat.pow(a, 1n+j), 2n+rr), Nat.mod(Nat.pow(a, x), 2n+rr), 1n, Equal.cong(Nat, Nat, z => Nat.mod(Nat.pow(a, z), 2n+rr), 1n+j, x, ex), hx)
      +hy = FD.flt1_s(rr, hr, a, nz(rr, a, j, hj))
      +g = M.gcd(x, 1n+rr)
      +hg = ag(rr, a, x, 1n+rr, hx, hy)
      +w = G.ws(1n+rr, x, 1n+rr)
      +em = gm(qq, hq, m, 1n+rr, g, G.wl(w), G.wr(w), G.gcd_dvd_left(x, 1n+rr), G.gcd_dvd_right(x, 1n+rr), hn)
      +d = Nat.div(G.wl(w), 2n+qq)
      +hm = Equal.trans(Nat, Nat.mod(Nat.pow(a, m), 2n+rr), Nat.mod(Nat.pow(a, Nat.mul(d, g)), 2n+rr), 1n, Equal.cong(Nat, Nat, z => Nat.mod(Nat.pow(a, z), 2n+rr), m, Nat.mul(d, g), em), pw1(rr, a, g, d, hg))
      +hb1 = Equal.trans(Nat, Nat.mod(b, 2n+rr), Nat.mod(Nat.mod(Nat.pow(a, m), 2n+j), 2n+rr), 1n, Equal.cong(Nat, Nat, z => Nat.mod(z, 2n+rr), b, Nat.mod(Nat.pow(a, m), 2n+j), Equal.sym(Nat, Nat.mod(Nat.pow(a, m), 2n+j), b, hb)), Equal.trans(Nat, Nat.mod(Nat.mod(Nat.pow(a, m), 2n+j), 2n+rr), Nat.mod(Nat.pow(a, m), 2n+rr), 1n, md(1n+j, 1n+rr, k, Nat.pow(a, m), e), hm))
      bz(rr, b, u, v, k, 2n+j, hb1, hz, e)

def step_c(+np: Nat, +rr: Nat, +k: Nat, +qq: Nat, +m: Nat, +a: Nat, +b: Nat, +u: Nat, +v: Nat, +hr: PM.Prime(2n+rr), +e: {1n+np == Nat.mul(k, 2n+rr) : Nat}, +hq: PM.Prime(2n+qq), +en: {1n+np == Nat.add(Nat.mul(2n+qq, m), 1n) : Nat}, +h1: {Nat.mod(Nat.pow(a, Nat.mul(2n+qq, m)), 1n+np) == 1n : Nat}, +hb: {Nat.mod(Nat.pow(a, m), 1n+np) == b : Nat}, +hz: {Nat.mul(u, Nat.sub(b, 1n)) == Nat.add(Nat.mul(v, 1n+np), 1n) : Nat}, c: Bool, +hc: {Nat.is_eq(Nat.mod(1n+rr, 2n+qq), 0n) == c : Bool}) -> {Nat.mod(1n+rr, 2n+qq) == 0n : Nat}:
  match c:
    case True{}:
      N.eq_from_is_eq(Nat.mod(1n+rr, 2n+qq), 0n, hc)
    case False{}:
      Empty.absurd({Nat.mod(1n+rr, 2n+qq) == 0n : Nat}, step_abs(np, rr, k, qq, m, a, b, u, v, hr, e, hq, en, h1, hb, hz, hc))

# Pocklington's step: q divides r - 1 for every prime factor r = 2 + rr of N = 1 + np
def step(+np: Nat, +rr: Nat, +k: Nat, q: Nat, +m: Nat, +a: Nat, +b: Nat, +u: Nat, +v: Nat, +hr: PM.Prime(2n+rr), +e: {1n+np == Nat.mul(k, 2n+rr) : Nat}, +hq: PM.Prime(q), +en: {1n+np == Nat.add(Nat.mul(q, m), 1n) : Nat}, +h1: {Nat.mod(Nat.pow(a, Nat.mul(q, m)), 1n+np) == 1n : Nat}, +hb: {Nat.mod(Nat.pow(a, m), 1n+np) == b : Nat}, +hz: {Nat.mul(u, Nat.sub(b, 1n)) == Nat.add(Nat.mul(v, 1n+np), 1n) : Nat}) -> {Nat.mod(1n+rr, q) == 0n : Nat}:
  match q:
    case 0n:
      Empty.absurd({Nat.mod(1n+rr, 0n) == 0n : Nat}, Lg.false_true(hq))
    case 1n:
      Empty.absurd({Nat.mod(1n+rr, 1n) == 0n : Nat}, Lg.false_true(hq))
    case 2n+ +qq:
      step_c(np, rr, k, qq, m, a, b, u, v, hr, e, hq, en, h1, hb, hz, Nat.is_eq(Nat.mod(1n+rr, 2n+qq), 0n), {==})
