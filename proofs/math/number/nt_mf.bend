# Every n >= 2 has a prime factor (Mathlib Nat.minFac, Nat.minFac_prime,
# Nat.minFac_dvd): mf(n) is the least d >= 2 dividing n, found by a search
# from 2; it is prime because a divisor of it would be a smaller divisor
# of n.

# the least d' >= d dividing n (c: d divides n; f: fuel)
def mfgo(f: Nat, +n: Nat, +d: Nat, c: Bool) -> Nat:
  match f c:
    case 0n _:
      d
    case 1n+g True{}:
      d
    case 1n+g False{}:
      mfgo(g, n, 1n+d, Nat.is_eq(Nat.mod(n, 1n+d), 0n))

def mf(+n: Nat) -> Nat:
  mfgo(n, n, 2n, Nat.is_eq(Nat.mod(n, 2n), 0n))

