def inv_from(~K: Data, ~cmp: K -> K -> Cmp, ~o: O.Order(~K, ~cmp), -V: Data, +ops: List<&2, E.Op<K, V>>, +d0: B.OrdMap<K, V>, +g0: {ST.inv(~K, ~cmp, V, d0) == True{} : Bool}) -> {ST.inv(~K, ~cmp, V, Pair.fst(B.OrdMap<K, V>, List<&2, E.Obs<K, V>>, B.run(~K, ~cmp, V, ops, d0))) == True{} : Bool}:
