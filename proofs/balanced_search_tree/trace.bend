  -P1 = {B.run_acc(~K, ~cmp, V, ops, (d0, Nil{})) == (fin(~K, ~cmp, ~o, V, ops, d0, Nil{}), List.reverse.go(&2, E.Obs<K, V>, srun_obs(~K, ~cmp, ~o, V, ops, m0), Nil{})) : B.OrdMap<K, V> & List<&2, E.Obs<K, V>>}
