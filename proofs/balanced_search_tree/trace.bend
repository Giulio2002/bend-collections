  -P3 = {ST.inv(~K, ~cmp, V, fin(~K, ~cmp, ~o, V, ops, d0, Nil{})) == True{} : Bool}
  %Equal.sym(B.OrdMap<K, V> & List<&2, E.Obs<K, V>>, B.run_acc(~K, ~cmp, V, ops, (d0, Nil{})), (fin(~K, ~cmp, ~o, V, ops, d0, Nil{}), List.reverse.go(&2, E.Obs<K, V>, srun_obs(~K, ~cmp, ~o, V, ops, m0), Nil{})), Pair.fst(P1, P2 & P3, run_ok(~K, ~cmp, ~o, V, ops, d0, Nil{}, g0))) : {view(~K, ~cmp, ~o, V, B.finish(K, V, _)) == S.run(~K, ~cmp, V, ops, m0) : List<&2, E.Entry<K, V>> & List<&2, E.Obs<K, V>>}
  %Equal.sym(List<&2, E.Obs<K, V>>, List.reverse(&2, E.Obs<K, V>, List.reverse.go(&2, E.Obs<K, V>, srun_obs(~K, ~cmp, ~o, V, ops, m0), Nil{})), srun_obs(~K, ~cmp, ~o, V, ops, m0), LL.rev_rev(E.Obs<K, V>, srun_obs(~K, ~cmp, ~o, V, ops, m0))) : {(ST.abs(~K, ~cmp, V, fin(~K, ~cmp, ~o, V, ops, d0, Nil{})), _) == S.run(~K, ~cmp, V, ops, m0) : List<&2, E.Entry<K, V>> & List<&2, E.Obs<K, V>>}
