def lnz(+sd: Nat, +key: String, +b: B.Bk, +hw: {B.wb(sd, b) == True{} : Bool}, +hk: {B.hold(key, b) == True{} : Bool}) -> {U32.is_eq(B.lnk(b), 0) == False{} : Bool}:
  match b:
    case B.BE{}:
      Empty.absurd({U32.is_eq(B.lnk(B.BE{}), 0) == False{} : Bool}, L.false_true(hk))
    case B.BF{+w, +l, +k}:
