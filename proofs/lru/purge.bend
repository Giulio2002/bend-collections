# purge: every entry and the counters cleared, the table kept at its size.



def z_bsl(+d: Nat, +kl: List<&2, String>, +n: Nat, +sl: List<&2, Nat>, +ll: List<&2, U32>, +m: Nat, +hm: {Nat.is_le(m, n) == True{} : Bool}) -> {ST.bsl(TB.buckets(AR.slots(U32, AR.trep(U32, d, 0)), kl, n), sl, ll, m) == True{} : Bool}:
  match m:
    case 0n:
      {==}
    case 1n+q:
      +hq = N.succ_le_lt(q, n, hm)
      L.and_intro(ST.bslb(sl, ll, B.at(TB.buckets(AR.slots(U32, AR.trep(U32, d, 0)), kl, n), q)), ST.bsl(TB.buckets(AR.slots(U32, AR.trep(U32, d, 0)), kl, n), sl, ll, q), L.subst(B.Bk, z => {ST.bslb(sl, ll, z) == True{} : Bool}, B.BE{}, B.at(TB.buckets(AR.slots(U32, AR.trep(U32, d, 0)), kl, n), q), Equal.sym(B.Bk, B.at(TB.buckets(AR.slots(U32, AR.trep(U32, d, 0)), kl, n), q), B.BE{}, GR.at_z(d, kl, n, q, hq)), {==}), z_bsl(d, kl, n, sl, ll, q, N.lt_le(q, n, hq)))

