# touch on the shadow: the slot holding key becomes the newest.


def TouchOK(~V: Data, +spec: SP.Lru<V>, r: LR.Fast<&2, V>) -> Type:
  Sigma<&1, &1, ST.Sh<V>, sh2 => {r == ST.real(~V, sh2) : LR.Fast<&2, V>} & ({ST.model(~V, sh2) == spec : SP.Lru<V>} & {ST.good(~V, sh2) == True{} : Bool})>

def sd29(+k: Nat, +sd: Nat, +hk: {Nat.is_lt(k, 30n) == True{} : Bool}, +hs: {Nat.is_lt(sd, k) == True{} : Bool}) -> {Nat.is_lt(3n+sd, 32n) == True{} : Bool}:
  +h1 = N.lt_le_trans(sd, k, 29n, hs, N.lt_succ_le(k, 29n, hk))
  N.lt_add_left(sd, 29n, 3n, h1)

# the newest slot has nothing after it
def new_nil(~V: Data, +one: Nat, +h1: {one == 1n : Nat}, +sd: Nat, +hsd: {Nat.is_lt(3n+sd, 32n) == True{} : Bool}, +fr: Nat, +el: List<&2, Maybe<&2, V>>, +hfr: {Nat.is_le(fr, SC.pow2(sd)) == True{} : Bool}, +a: List<&2, Nat>, +s: Nat, +b0: Nat, +b2: List<&2, Nat>, +su: U32, +hsv: {UD.v(su) == s : Nat}, +hs0: {Nat.is_lt(s, SC.pow2(sd)) == True{} : Bool}, +tail: U32, +ht: {U32.is_eq(tail, ST.last_or(SC.append(Nat, a, Con{s, Con{b0, b2}}), 0)) == True{} : Bool}, +hc: {U32.is_eq(H.link(su), tail) == True{} : Bool}, +hnd: {ST.nodupn(SC.append(Nat, a, Con{s, Con{b0, b2}})) == True{} : Bool}, +hbB: {ST.sall(~V, ST.PLive{fr, el}, Con{b0, b2}) == True{} : Bool}) -> Empty:
  +z = DL.lastn(b2, b0)
  +hz = UL.bnd_of(~V, z, Con{b0, b2}, fr, el, sd, hfr, hbB, DL.lastn_mem(b2, b0))
  +et = Equal.trans(U32, tail, ST.last_or(SC.append(Nat, a, Con{s, Con{b0, b2}}), 0), ST.lnk(z), A.eq_of(tail, ST.last_or(SC.append(Nat, a, Con{s, Con{b0, b2}}), 0), ht), Equal.trans(U32, ST.last_or(SC.append(Nat, a, Con{s, Con{b0, b2}}), 0), ST.last_or(b2, ST.lnk(b0)), ST.lnk(z), DL.last_app(a, Con{s, Con{b0, b2}}, 0), DL.last_lnk(b2, b0)))
  +el2 = Equal.trans(U32, ST.lnk(s), H.link(su), ST.lnk(z), Equal.sym(U32, H.link(su), ST.lnk(s), LT.lnk_su(su, s, sd, hsd, hsv, hs0)), Equal.trans(U32, H.link(su), tail, ST.lnk(z), A.eq_of(H.link(su), tail, hc), et))
  +esz = Equal.trans(Nat, s, UD.v(H.slot(ST.lnk(s))), z, Equal.sym(Nat, UD.v(H.slot(ST.lnk(s))), s, UL.ix_o(one, h1, s, sd, hsd, hs0)), Equal.trans(Nat, UD.v(H.slot(ST.lnk(s))), UD.v(H.slot(ST.lnk(z))), z, Equal.cong(U32, Nat, w => UD.v(H.slot(w)), ST.lnk(s), ST.lnk(z), el2), UL.ix_o(one, h1, z, sd, hsd, hz)))
  +hin = L.subst(Nat, w => {HT.memn(w, Con{b0, b2}) == True{} : Bool}, z, s, Equal.sym(Nat, s, z, esz), DL.lastn_mem(b2, b0))
  +hno = L.and_left(Bool.not(HT.memn(s, Con{b0, b2})), ST.nodupn(Con{b0, b2}), LS.nd_r(a, Con{s, Con{b0, b2}}, hnd))
  L.false_true(L.subst(Bool, w => {Bool.not(w) == True{} : Bool}, HT.memn(s, Con{b0, b2}), True{}, hin, hno))


