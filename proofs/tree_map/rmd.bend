    case M.Free{f} +m:
      Empty.absurd({S.del(~K, ~V, ~cmp, k, ST.ents(~K, ~V, ST.ids(tg), nl, pl)) == ST.ents(~K, ~V, SC.append(Nat, xs, ys), nl, pl) : List<&2, M.Entry<K, V>>} & {ST.ordered(~K, ~V, ~cmp, S.del(~K, ~V, ~cmp, k, ST.ents(~K, ~V, ST.ids(tg), nl, pl))) == True{} : Bool}, L.false_true(hx))
    case M.N{c0, x1, x2, x3, key} None{}:
