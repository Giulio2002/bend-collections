import Base
import ../lib/logic.bend as L
import ../lib/nat.bend as N
import ../lib/array.bend as AR
import ../spec/common.bend as SC
import ../spec/tree_map.bend as S
import ../dynamic_array/layout.bend as LY
import ../dynamic_array/state.bend as DAS
import ../lru/state.bend as LST
import ../../src/containers/balanced_search_tree.bend as M

# The indexed TreeMap's shadow: the header, the mirror trees of the node and
# payload arrays (one limit, depth and length for both), a ghost tree of node
# ids and the free stack (ghost). Colours, links and keys are read from the
# node list. (generated by tools/generators/tm_state.py)

type Tr is Data:
  TE{}
  TN{id: Nat, left: Tr, right: Tr}

type Sh<-K: Data, -V: Data> is Data:
  SH{n: Nat, root: Nat, lo: Nat, hi: Nat, free: Nat, l: Nat, d: Nat, len: Nat, nT: AR.Tree<Maybe<&2, M.Node<K>>>, pT: AR.Tree<Maybe<&2, Maybe<&2, V>>>, t: Tr, fl: List<&2, Nat>}

def real(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, sh: Sh<K, V>) -> M.TreeMap<K, V, cmp>:
  match sh:
    case SH{+n, +root, +lo, +hi, +free, +l, +d, +len, +nT, +pT, +t, +fl}:
      M.TM{n, root, lo, hi, free, DAS.real(M.Node<K>, DAS.Sh{l, d, len, nT}), DAS.real(Maybe<&2, V>, DAS.Sh{l, d, len, pT})}

# ---- the ghost tree ----

def rid(t: Tr) -> Nat:
  match t:
    case TE{}:
      0n
    case TN{+i, l, r}:
      i

# the ids in key (in-)order
def ids(t: Tr) -> List<&2, Nat>:
  match t:
    case TE{}:
      Nil{}
    case TN{+i, l, r}:
      SC.append(Nat, ids(l), Con{i, ids(r)})

def fst0(xs: List<&2, Nat>) -> Nat:
  match xs:
    case Nil{}:
      0n
    case Con{+x, t}:
      x

def last0(xs: List<&2, Nat>) -> Nat:
  match xs:
    case Nil{}:
      0n
    case Con{+x, t}:
      match t:
        case Nil{}:
          x
        case Con{+y, +u}:
          last0(Con{y, u})

# ---- nodes read by id ----

def nth_or(-X: Data, xs: List<&2, X>, +i: Nat, +dflt: X) -> X:
  match xs i:
    case Nil{} _:
      dflt
    case Con{x, t} 0n:
      x
    case Con{x, t} 1n+p:
      nth_or(X, t, p, dflt)

# the node of id (a free sentinel for 0 or an id out of range)
def nd(-K: Data, xs: List<&2, M.Node<K>>, +id: Nat) -> M.Node<K>:
  match id:
    case 0n:
      M.Free{0n}
    case 1n+i:
      nth_or(M.Node<K>, xs, i, M.Free{0n})

def pv(-V: Data, xs: List<&2, Maybe<&2, V>>, +id: Nat) -> Maybe<&2, V>:
  match id:
    case 0n:
      None{}
    case 1n+i:
      nth_or(Maybe<&2, V>, xs, i, None{})

def is_node(-K: Data, x: M.Node<K>, +a: Nat, +b: Nat, +p: Nat) -> Bool:
  match x:
    case M.Free{f}:
      False{}
    case M.N{c, +x1, +x2, +x3, k}:
      Bool.and(Nat.is_eq(x1, a), Bool.and(Nat.is_eq(x2, b), Nat.is_eq(x3, p)))

def is_free(-K: Data, x: M.Node<K>, +q: Nat) -> Bool:
  match x:
    case M.Free{+f}:
      Nat.is_eq(f, q)
    case M.N{c, x1, x2, x3, k}:
      False{}

def is_red(-K: Data, x: M.Node<K>) -> Bool:
  match x:
    case M.Free{f}:
      False{}
    case M.N{+c, x1, x2, x3, k}:
      c

# every node of t links to its children's ids and to its parent p
def rep(~K: Data, t: Tr, +p: Nat, +xs: List<&2, M.Node<K>>) -> Bool:
  match t:
    case TE{}:
      True{}
    case TN{+i, +l, +r}:
      Bool.and(Nat.is_lt(0n, i), Bool.and(is_node(K, nd(K, xs, i), rid(l), rid(r), p), Bool.and(rep(~K, l, i, xs), rep(~K, r, i, xs))))

def some2(-V: Data, m: Maybe<&2, V>) -> Bool:
  match m:
    case None{}:
      False{}
    case Some{v}:
      True{}

# every node of t has a value
def pay(~V: Data, t: Tr, +ys: List<&2, Maybe<&2, V>>) -> Bool:
  match t:
    case TE{}:
      True{}
    case TN{+i, l, r}:
      Bool.and(some2(V, pv(V, ys, i)), Bool.and(pay(~V, l, ys), pay(~V, r, ys)))

# the free stack: each id is a free node pointing to the next (0 last)
def fll(~K: Data, +xs: List<&2, M.Node<K>>, fl: List<&2, Nat>) -> Bool:
  match fl:
    case Nil{}:
      True{}
    case Con{+f, +t}:
      Bool.and(is_free(K, nd(K, xs, f), fst0(t)), fll(~K, xs, t))

# every id in 1..len
def allin(xs: List<&2, Nat>, +len: Nat) -> Bool:
  match xs:
    case Nil{}:
      True{}
    case Con{+x, t}:
      Bool.and(Bool.and(Nat.is_lt(0n, x), Nat.is_le(x, len)), allin(t, len))

# ---- entries ----

def ent(-K: Data, -V: Data, x: M.Node<K>, m: Maybe<&2, V>) -> Maybe<&2, M.Entry<K, V>>:
  match x m:
    case M.N{c, a, b, p, k} Some{v}:
      Some{M.Entry{k, v}}
    case _ _:
      None{}

def cons_m(-X: Data, m: Maybe<&2, X>, xs: List<&2, X>) -> List<&2, X>:
  match m:
    case None{}:
      xs
    case Some{x}:
      Con{x, xs}

# the entries of the ids, in order
def ents(~K: Data, ~V: Data, ix: List<&2, Nat>, +xs: List<&2, M.Node<K>>, +ys: List<&2, Maybe<&2, V>>) -> List<&2, M.Entry<K, V>>:
  match ix:
    case Nil{}:
      Nil{}
    case Con{+i, t}:
      cons_m(M.Entry<K, V>, ent(K, V, nd(K, xs, i), pv(V, ys, i)), ents(~K, ~V, t, xs, ys))

# consecutive keys strictly increasing
def ordered(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, es: List<&2, M.Entry<K, V>>) -> Bool:
  match es:
    case Nil{}:
      True{}
    case Con{e, t}:
      match t:
        case Nil{}:
          True{}
        case Con{+e2, +u}:
          Bool.and(Cmp.is_lt(cmp(S.key(K, V, e), S.key(K, V, e2))), ordered(~K, ~V, ~cmp, Con{e2, u}))

def root_black(~K: Data, t: Tr, +xs: List<&2, M.Node<K>>) -> Bool:
  match t:
    case TE{}:
      True{}
    case TN{+i, l, r}:
      Bool.not(is_red(K, nd(K, xs, i)))

def model(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, sh: Sh<K, V>) -> S.Model<K, V>:
  match sh:
    case SH{+n, +root, +lo, +hi, +free, +l, +d, +len, +nT, +pT, +t, +fl}:
      S.TM{l, ents(~K, ~V, ids(t), LY.somes(M.Node<K>, AR.slots(Maybe<&2, M.Node<K>>, nT)), LY.somes(Maybe<&2, V>, AR.slots(Maybe<&2, Maybe<&2, V>>, pT)))}

# ---- the invariant ----

def cl(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +n: Nat, +root: Nat, +lo: Nat, +hi: Nat, +free: Nat, +l: Nat, +d: Nat, +len: Nat, +nT: AR.Tree<Maybe<&2, M.Node<K>>>, +pT: AR.Tree<Maybe<&2, Maybe<&2, V>>>, +t: Tr, +fl: List<&2, Nat>) -> Bool:
  Nat.is_le(l, 31n)

def cd(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +n: Nat, +root: Nat, +lo: Nat, +hi: Nat, +free: Nat, +l: Nat, +d: Nat, +len: Nat, +nT: AR.Tree<Maybe<&2, M.Node<K>>>, +pT: AR.Tree<Maybe<&2, Maybe<&2, V>>>, +t: Tr, +fl: List<&2, Nat>) -> Bool:
  Nat.is_le(d, l)

def cpn(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +n: Nat, +root: Nat, +lo: Nat, +hi: Nat, +free: Nat, +l: Nat, +d: Nat, +len: Nat, +nT: AR.Tree<Maybe<&2, M.Node<K>>>, +pT: AR.Tree<Maybe<&2, Maybe<&2, V>>>, +t: Tr, +fl: List<&2, Nat>) -> Bool:
  AR.perfect(Maybe<&2, M.Node<K>>, d, nT)

def cpp(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +n: Nat, +root: Nat, +lo: Nat, +hi: Nat, +free: Nat, +l: Nat, +d: Nat, +len: Nat, +nT: AR.Tree<Maybe<&2, M.Node<K>>>, +pT: AR.Tree<Maybe<&2, Maybe<&2, V>>>, +t: Tr, +fl: List<&2, Nat>) -> Bool:
  AR.perfect(Maybe<&2, Maybe<&2, V>>, d, pT)

def cln(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +n: Nat, +root: Nat, +lo: Nat, +hi: Nat, +free: Nat, +l: Nat, +d: Nat, +len: Nat, +nT: AR.Tree<Maybe<&2, M.Node<K>>>, +pT: AR.Tree<Maybe<&2, Maybe<&2, V>>>, +t: Tr, +fl: List<&2, Nat>) -> Bool:
  LY.lay(M.Node<K>, AR.slots(Maybe<&2, M.Node<K>>, nT), len)

def clp(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +n: Nat, +root: Nat, +lo: Nat, +hi: Nat, +free: Nat, +l: Nat, +d: Nat, +len: Nat, +nT: AR.Tree<Maybe<&2, M.Node<K>>>, +pT: AR.Tree<Maybe<&2, Maybe<&2, V>>>, +t: Tr, +fl: List<&2, Nat>) -> Bool:
  LY.lay(Maybe<&2, V>, AR.slots(Maybe<&2, Maybe<&2, V>>, pT), len)

def crep(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +n: Nat, +root: Nat, +lo: Nat, +hi: Nat, +free: Nat, +l: Nat, +d: Nat, +len: Nat, +nT: AR.Tree<Maybe<&2, M.Node<K>>>, +pT: AR.Tree<Maybe<&2, Maybe<&2, V>>>, +t: Tr, +fl: List<&2, Nat>) -> Bool:
  rep(~K, t, 0n, LY.somes(M.Node<K>, AR.slots(Maybe<&2, M.Node<K>>, nT)))

def cpay(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +n: Nat, +root: Nat, +lo: Nat, +hi: Nat, +free: Nat, +l: Nat, +d: Nat, +len: Nat, +nT: AR.Tree<Maybe<&2, M.Node<K>>>, +pT: AR.Tree<Maybe<&2, Maybe<&2, V>>>, +t: Tr, +fl: List<&2, Nat>) -> Bool:
  pay(~V, t, LY.somes(Maybe<&2, V>, AR.slots(Maybe<&2, Maybe<&2, V>>, pT)))

def cfll(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +n: Nat, +root: Nat, +lo: Nat, +hi: Nat, +free: Nat, +l: Nat, +d: Nat, +len: Nat, +nT: AR.Tree<Maybe<&2, M.Node<K>>>, +pT: AR.Tree<Maybe<&2, Maybe<&2, V>>>, +t: Tr, +fl: List<&2, Nat>) -> Bool:
  fll(~K, LY.somes(M.Node<K>, AR.slots(Maybe<&2, M.Node<K>>, nT)), fl)

def cnd(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +n: Nat, +root: Nat, +lo: Nat, +hi: Nat, +free: Nat, +l: Nat, +d: Nat, +len: Nat, +nT: AR.Tree<Maybe<&2, M.Node<K>>>, +pT: AR.Tree<Maybe<&2, Maybe<&2, V>>>, +t: Tr, +fl: List<&2, Nat>) -> Bool:
  LST.nodupn(SC.append(Nat, ids(t), fl))

def cin(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +n: Nat, +root: Nat, +lo: Nat, +hi: Nat, +free: Nat, +l: Nat, +d: Nat, +len: Nat, +nT: AR.Tree<Maybe<&2, M.Node<K>>>, +pT: AR.Tree<Maybe<&2, Maybe<&2, V>>>, +t: Tr, +fl: List<&2, Nat>) -> Bool:
  allin(SC.append(Nat, ids(t), fl), len)

def clen(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +n: Nat, +root: Nat, +lo: Nat, +hi: Nat, +free: Nat, +l: Nat, +d: Nat, +len: Nat, +nT: AR.Tree<Maybe<&2, M.Node<K>>>, +pT: AR.Tree<Maybe<&2, Maybe<&2, V>>>, +t: Tr, +fl: List<&2, Nat>) -> Bool:
  Nat.is_eq(SC.length(Nat, SC.append(Nat, ids(t), fl)), len)

def cord(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +n: Nat, +root: Nat, +lo: Nat, +hi: Nat, +free: Nat, +l: Nat, +d: Nat, +len: Nat, +nT: AR.Tree<Maybe<&2, M.Node<K>>>, +pT: AR.Tree<Maybe<&2, Maybe<&2, V>>>, +t: Tr, +fl: List<&2, Nat>) -> Bool:
  ordered(~K, ~V, ~cmp, ents(~K, ~V, ids(t), LY.somes(M.Node<K>, AR.slots(Maybe<&2, M.Node<K>>, nT)), LY.somes(Maybe<&2, V>, AR.slots(Maybe<&2, Maybe<&2, V>>, pT))))

def cblk(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +n: Nat, +root: Nat, +lo: Nat, +hi: Nat, +free: Nat, +l: Nat, +d: Nat, +len: Nat, +nT: AR.Tree<Maybe<&2, M.Node<K>>>, +pT: AR.Tree<Maybe<&2, Maybe<&2, V>>>, +t: Tr, +fl: List<&2, Nat>) -> Bool:
  root_black(~K, t, LY.somes(M.Node<K>, AR.slots(Maybe<&2, M.Node<K>>, nT)))

def csz(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +n: Nat, +root: Nat, +lo: Nat, +hi: Nat, +free: Nat, +l: Nat, +d: Nat, +len: Nat, +nT: AR.Tree<Maybe<&2, M.Node<K>>>, +pT: AR.Tree<Maybe<&2, Maybe<&2, V>>>, +t: Tr, +fl: List<&2, Nat>) -> Bool:
  Nat.is_eq(n, SC.length(Nat, ids(t)))

def croot(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +n: Nat, +root: Nat, +lo: Nat, +hi: Nat, +free: Nat, +l: Nat, +d: Nat, +len: Nat, +nT: AR.Tree<Maybe<&2, M.Node<K>>>, +pT: AR.Tree<Maybe<&2, Maybe<&2, V>>>, +t: Tr, +fl: List<&2, Nat>) -> Bool:
  Nat.is_eq(root, rid(t))

def clo(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +n: Nat, +root: Nat, +lo: Nat, +hi: Nat, +free: Nat, +l: Nat, +d: Nat, +len: Nat, +nT: AR.Tree<Maybe<&2, M.Node<K>>>, +pT: AR.Tree<Maybe<&2, Maybe<&2, V>>>, +t: Tr, +fl: List<&2, Nat>) -> Bool:
  Nat.is_eq(lo, fst0(ids(t)))

def chi(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +n: Nat, +root: Nat, +lo: Nat, +hi: Nat, +free: Nat, +l: Nat, +d: Nat, +len: Nat, +nT: AR.Tree<Maybe<&2, M.Node<K>>>, +pT: AR.Tree<Maybe<&2, Maybe<&2, V>>>, +t: Tr, +fl: List<&2, Nat>) -> Bool:
  Nat.is_eq(hi, last0(ids(t)))

def cfree(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +n: Nat, +root: Nat, +lo: Nat, +hi: Nat, +free: Nat, +l: Nat, +d: Nat, +len: Nat, +nT: AR.Tree<Maybe<&2, M.Node<K>>>, +pT: AR.Tree<Maybe<&2, Maybe<&2, V>>>, +t: Tr, +fl: List<&2, Nat>) -> Bool:
  Nat.is_eq(free, fst0(fl))

def goodF(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +n: Nat, +root: Nat, +lo: Nat, +hi: Nat, +free: Nat, +l: Nat, +d: Nat, +len: Nat, +nT: AR.Tree<Maybe<&2, M.Node<K>>>, +pT: AR.Tree<Maybe<&2, Maybe<&2, V>>>, +t: Tr, +fl: List<&2, Nat>) -> Bool:
  Bool.and(cl(~K, ~V, ~cmp, n, root, lo, hi, free, l, d, len, nT, pT, t, fl), Bool.and(cd(~K, ~V, ~cmp, n, root, lo, hi, free, l, d, len, nT, pT, t, fl), Bool.and(cpn(~K, ~V, ~cmp, n, root, lo, hi, free, l, d, len, nT, pT, t, fl), Bool.and(cpp(~K, ~V, ~cmp, n, root, lo, hi, free, l, d, len, nT, pT, t, fl), Bool.and(cln(~K, ~V, ~cmp, n, root, lo, hi, free, l, d, len, nT, pT, t, fl), Bool.and(clp(~K, ~V, ~cmp, n, root, lo, hi, free, l, d, len, nT, pT, t, fl), Bool.and(crep(~K, ~V, ~cmp, n, root, lo, hi, free, l, d, len, nT, pT, t, fl), Bool.and(cpay(~K, ~V, ~cmp, n, root, lo, hi, free, l, d, len, nT, pT, t, fl), Bool.and(cfll(~K, ~V, ~cmp, n, root, lo, hi, free, l, d, len, nT, pT, t, fl), Bool.and(cnd(~K, ~V, ~cmp, n, root, lo, hi, free, l, d, len, nT, pT, t, fl), Bool.and(cin(~K, ~V, ~cmp, n, root, lo, hi, free, l, d, len, nT, pT, t, fl), Bool.and(clen(~K, ~V, ~cmp, n, root, lo, hi, free, l, d, len, nT, pT, t, fl), Bool.and(cord(~K, ~V, ~cmp, n, root, lo, hi, free, l, d, len, nT, pT, t, fl), Bool.and(cblk(~K, ~V, ~cmp, n, root, lo, hi, free, l, d, len, nT, pT, t, fl), Bool.and(csz(~K, ~V, ~cmp, n, root, lo, hi, free, l, d, len, nT, pT, t, fl), Bool.and(croot(~K, ~V, ~cmp, n, root, lo, hi, free, l, d, len, nT, pT, t, fl), Bool.and(clo(~K, ~V, ~cmp, n, root, lo, hi, free, l, d, len, nT, pT, t, fl), Bool.and(chi(~K, ~V, ~cmp, n, root, lo, hi, free, l, d, len, nT, pT, t, fl), cfree(~K, ~V, ~cmp, n, root, lo, hi, free, l, d, len, nT, pT, t, fl)))))))))))))))))))

def good(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, sh: Sh<K, V>) -> Bool:
  match sh:
    case SH{+n, +root, +lo, +hi, +free, +l, +d, +len, +nT, +pT, +t, +fl}:
      goodF(~K, ~V, ~cmp, n, root, lo, hi, free, l, d, len, nT, pT, t, fl)

def g_cl(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +n: Nat, +root: Nat, +lo: Nat, +hi: Nat, +free: Nat, +l: Nat, +d: Nat, +len: Nat, +nT: AR.Tree<Maybe<&2, M.Node<K>>>, +pT: AR.Tree<Maybe<&2, Maybe<&2, V>>>, +t: Tr, +fl: List<&2, Nat>, +g: {goodF(~K, ~V, ~cmp, n, root, lo, hi, free, l, d, len, nT, pT, t, fl) == True{} : Bool}) -> {cl(~K, ~V, ~cmp, n, root, lo, hi, free, l, d, len, nT, pT, t, fl) == True{} : Bool}:
