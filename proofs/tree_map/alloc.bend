  %Equal.sym(Bool, Nat.is_lt(SC.length(M.Entry<K, V>, ST.ents(~K, ~V, ST.ids(tg), nl, pl)), SC.pow2(l)), False{}, hl) : {S.pick(S.Model<K, V> & Result<&2, &2, M.Rejected<K, V>, Maybe<&2, V>>, _, (S.TM{l, S.ins(~K, ~V, ~cmp, k, v, ST.ents(~K, ~V, ST.ids(tg), nl, pl))}, Done{None{}}), (S.TM{l, ST.ents(~K, ~V, ST.ids(tg), nl, pl)}, Fail{M.Rejected{M.CapacityExceeded{}, k, v}})) == (S.TM{l, ST.ents(~K, ~V, ST.ids(tg), nl, pl)}, Fail{M.Rejected{M.CapacityExceeded{}, k, v}}) : S.Model<K, V> & Result<&2, &2, M.Rejected<K, V>, Maybe<&2, V>>}
