    case Tuple{+px2, M.Free{+px4}}:
      g_r
    case Tuple{+px2, M.N{+px5, 0n, 0n, +px8, +px9}}:
      g_r
    case Tuple{+px2, M.N{+px5, 0n, 1n+ +px12, +px8, +px9}}:
      g_r
    case Tuple{+px2, M.N{+px5, 1n+ +px10, 0n, +px8, +px9}}:
