def delete_red_sibling_left_g(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +m: ST.Sh<K, V>, +p: Nat, +w: Nat, +red_sibling: Bool, +g_m: {MI.dg(K, V, m) == True{} : Bool}) -> {MI.dgp(K, V, M.DeleteFix, MI.delete_red_sibling_left(~K, ~V, ~cmp, m, p, w, red_sibling)) == True{} : Bool}:
  match red_sibling:
    case True{}:
      delete_sibling_left_g(~K, ~V, ~cmp, MI.rotate_left(~K, ~V, ~cmp, MI.set_red(~K, ~V, ~cmp, MI.set_red(~K, ~V, ~cmp, m, w, False{}), p, True{}), p), p, rotate_left_g(~K, ~V, ~cmp, MI.set_red(~K, ~V, ~cmp, MI.set_red(~K, ~V, ~cmp, m, w, False{}), p, True{}), p, set_red_g(~K, ~V, ~cmp, MI.set_red(~K, ~V, ~cmp, m, w, False{}), p, True{}, set_red_g(~K, ~V, ~cmp, m, w, False{}, g_m))))
    case False{}:
      delete_sibling_left_g(~K, ~V, ~cmp, m, p, g_m)

