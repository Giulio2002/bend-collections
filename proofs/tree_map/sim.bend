def insert_fix_loop_g(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +fuel: Nat, st: ST.Sh<K, V> & M.Fix, +g_st: {MI.dgp(K, V, M.Fix, st) == True{} : Bool}) -> {MI.dg(K, V, MI.insert_fix_loop(~K, ~V, ~cmp, fuel, st)) == True{} : Bool}:
  match fuel st:
    case 0n Tuple{+px4, +px5}:
      black_root_g(~K, ~V, ~cmp, px4, g_st)
    case 1n+ +px3 Tuple{+px6, M.Fix{+px8, False{}}}:
      black_root_g(~K, ~V, ~cmp, px6, g_st)
    case 1n+ +px3 Tuple{+px6, M.Fix{+px8, True{}}}:
      insert_fix_loop_g(~K, ~V, ~cmp, px3, MI.insert_fix_step(~K, ~V, ~cmp, px6, px8), insert_fix_step_g(~K, ~V, ~cmp, px6, px8, g_st))

