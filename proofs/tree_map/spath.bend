      +q1 = L.subst(Cmp, z => {TR.pk3(M.Search, z, TR.tsearch(~K, ~V, ~cmp, l, nl, k, i, True{}), TR.tsearch(~K, ~V, ~cmp, r, nl, k, i, False{}), M.Search{i, P.top(c), dir(c)}) == M.Search{ST.rid(t2), P.top(c2), dir(c2)} : M.Search}, LT{}, TR.kc(~K, ~cmp, k, ST.nd(K, nl, i)), Equal.sym(Cmp, TR.kc(~K, ~cmp, k, ST.nd(K, nl, i)), LT{}, ekc), p1)
