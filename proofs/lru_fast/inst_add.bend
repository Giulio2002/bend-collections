def grow_inv_u32(+cap: U32, +fresh: Nat, +depth: Nat, +life: T.Int64, +tc: AR.Tree<U32>, +table: Map<&2, Maybe<&2, U32>>, +tk: AR.Tree<String>, +te: AR.Tree<F.Slot<U32>>, +tp: AR.Tree<U32>, +tn: AR.Tree<U32>, +ord: List<&2, Nat>, +fl: List<&2, Nat>, +h: {ST.inv(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl) == True{} : Bool}, +hdl: {Nat.is_lt(depth, 31n) == True{} : Bool}) -> {ST.inv(~U32, cap, fresh, 1n+depth, life, tc, table, AR.TNode{tk, AR.trep(String, depth, "")}, AR.TNode{te, AR.trep(F.Slot<U32>, depth, F.Vacant{})}, AR.TNode{tp, AR.trep(U32, depth, 0)}, AR.TNode{tn, AR.trep(U32, depth, 0)}, ord, fl) == True{} : Bool}:
