  AF.entry_occ(~U32, life, v, now)

def entry_ent_u32(+k: String, +v: U32, +life: T.Int64, +now: T.Int64) -> {ST.ent_at(U32, k, AF.entry(~U32, life, v, now), Nil{}) == Con{S.En{k, v, NS.deadline(now, life)}, Nil{}} : List<&2, S.Ent<U32>>}:
  AF.entry_ent(~U32, k, v, life, now)


def rep_real_u32(+cap: U32, +fresh: Nat, +depth: Nat, +life: T.Int64, +tc: AR.Tree<U32>, +table: Map<&2, Maybe<&2, U32>>, +tk: AR.Tree<String>, +te: AR.Tree<F.Slot<U32>>, +tp: AR.Tree<U32>, +tn: AR.Tree<U32>, +ord: List<&2, Nat>, +fl: List<&2, Nat>, +s: Nat, e: F.Slot<U32>, +hm: {DST.lmem(s, ord) == True{} : Bool}, +h: {ST.inv(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl) == True{} : Bool}) -> {F.replace(~U32, ST.real(~U32, ST.Sh{cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl}), U32.from_nat(s), e) == ST.real(~U32, AD.rep_sh(U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl, s, e)) : F.Fast<U32>}:
  AD.rep_real(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl, s, e, hm, h)

def rep_inv_u32(+cap: U32, +fresh: Nat, +depth: Nat, +life: T.Int64, +tc: AR.Tree<U32>, +table: Map<&2, Maybe<&2, U32>>, +tk: AR.Tree<String>, +te: AR.Tree<F.Slot<U32>>, +tp: AR.Tree<U32>, +tn: AR.Tree<U32>, +ord: List<&2, Nat>, +fl: List<&2, Nat>, +s: Nat, +e: F.Slot<U32>, +ho: {ST.is_occ(U32, e) == True{} : Bool}, +hm: {DST.lmem(s, ord) == True{} : Bool}, +h: {ST.inv(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl) == True{} : Bool}) -> {ST.good(~U32, AD.rep_sh(U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl, s, e)) == True{} : Bool}:
  AD.rep_inv(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl, s, e, ho, hm, h)

def rep_model_u32(+cap: U32, +fresh: Nat, +depth: Nat, +life: T.Int64, +tc: AR.Tree<U32>, +table: Map<&2, Maybe<&2, U32>>, +tk: AR.Tree<String>, +te: AR.Tree<F.Slot<U32>>, +tp: AR.Tree<U32>, +tn: AR.Tree<U32>, +ord: List<&2, Nat>, +fl: List<&2, Nat>, +s: Nat, +key: String, +v: U32, +now: T.Int64, +elk: {TB.lk(table, key) == Some{U32.from_nat(s)} : Maybe<&2, U32>}, +heq: {String.eq(ST.kat(AR.slots(String, tk), s), key) == True{} : Bool}, +hm: {DST.lmem(s, ord) == True{} : Bool}, +h: {ST.inv(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl) == True{} : Bool}) -> {S.add_found(U32, cap, life, ST.ents(U32, AR.slots(String, tk), AR.slots(F.Slot<U32>, te), ord), ST.mets(AR.slots(U32, tc)), key, S.En{key, v, NS.deadline(now, life)}, S.find(U32, ST.ents(U32, AR.slots(String, tk), AR.slots(F.Slot<U32>, te), ord), key)) == (ST.model(~U32, AD.rep_sh(U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl, s, AF.entry(~U32, life, v, now))), E.OFlag{False{}}) : S.Model<U32> & E.Obs<U32>}:
  AD.rep_model(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl, s, key, v, now, elk, heq, hm, h)


def put_ok_u32(+cap: U32, +fresh2: Nat, +depth: Nat, +life: T.Int64, +tc: AR.Tree<U32>, +table: Map<&2, Maybe<&2, U32>>, +tk: AR.Tree<String>, +te: AR.Tree<F.Slot<U32>>, +tp: AR.Tree<U32>, +tn: AR.Tree<U32>, +ord: List<&2, Nat>, +fl2: List<&2, Nat>, +s: Nat, +key: String, e: F.Slot<U32>, +hd: {Nat.is_le(depth, 31n) == True{} : Bool}, +pfc: {AR.perfect(U32, 4n, tc) == True{} : Bool}, +pfk: {AR.perfect(String, depth, tk) == True{} : Bool}, +pfe: {AR.perfect(F.Slot<U32>, depth, te) == True{} : Bool}, +pfp: {AR.perfect(U32, depth, tp) == True{} : Bool}, +pfn: {AR.perfect(U32, depth, tn) == True{} : Bool}, +hs: {Nat.is_lt(s, SC.pow2(depth)) == True{} : Bool}, +hl: {DST.alllt(ord, SC.pow2(depth)) == True{} : Bool}) -> {F.put_new(~U32, cap, U32.from_nat(SC.length(Nat, ord)), U32.from_nat(fresh2), U.pow2u(depth), depth, Bool.not(Time.is_zero(life)), F.int_stamp(life), AR.thaw(U32, tc), table, AR.thaw(String, tk), AR.thaw(F.Slot<U32>, te), F.CH{DST.hd(ord), DST.lst(ord), DST.hd(fl2), AR.thaw(U32, tp), AR.thaw(U32, tn)}, U32.from_nat(s), key, e) == ST.real(~U32, INS.ins_sh(U32, cap, fresh2, depth, life, tc, table, tk, te, tp, tn, ord, fl2, s, key, e)) : F.Fast<U32>}:
  INS.put_ok(~U32, cap, fresh2, depth, life, tc, table, tk, te, tp, tn, ord, fl2, s, key, e, hd, pfc, pfk, pfe, pfp, pfn, hs, hl)

def ins_inv_u32(+cap: U32, +fresh: Nat, +fresh2: Nat, +depth: Nat, +life: T.Int64, +tc: AR.Tree<U32>, +table: Map<&2, Maybe<&2, U32>>, +tk: AR.Tree<String>, +te: AR.Tree<F.Slot<U32>>, +tp: AR.Tree<U32>, +tn: AR.Tree<U32>, +ord: List<&2, Nat>, +fl: List<&2, Nat>, +fl2: List<&2, Nat>, +s: Nat, +key: String, +e: F.Slot<U32>, +h: {ST.inv(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl) == True{} : Bool}, +hno: {TB.lk(table, key) == None{} : Maybe<&2, U32>}, +ho: {ST.is_occ(U32, e) == True{} : Bool}, +hs: {Nat.is_lt(s, SC.pow2(depth)) == True{} : Bool}, +hfr2: {Nat.is_le(fresh2, SC.pow2(depth)) == True{} : Bool}, +hol2: {DST.alllt(SC.append(Nat, ord, Con{s, Nil{}}), fresh2) == True{} : Bool}, +hfl2: {DST.alllt(fl2, fresh2) == True{} : Bool}, +hnd2: {DST.nodup(SC.append(Nat, SC.append(Nat, ord, Con{s, Nil{}}), fl2)) == True{} : Bool}, +hcnt2: {Nat.is_eq(Nat.add(SC.length(Nat, SC.append(Nat, ord, Con{s, Nil{}})), SC.length(Nat, fl2)), fresh2) == True{} : Bool}, +hfk2: {ST.fk(fl2, AR.slots(U32, tn)) == True{} : Bool}, +hn2: {Nat.is_le(SC.length(Nat, SC.append(Nat, ord, Con{s, Nil{}})), U32.to_nat(cap)) == True{} : Bool}) -> {ST.good(~U32, INS.ins_sh(U32, cap, fresh2, depth, life, tc, table, tk, te, tp, tn, ord, fl2, s, key, e)) == True{} : Bool}:
  INS.ins_inv(~U32, cap, fresh, fresh2, depth, life, tc, table, tk, te, tp, tn, ord, fl, fl2, s, key, e, h, hno, ho, hs, hfr2, hol2, hfl2, hnd2, hcnt2, hfk2, hn2)

def ins_model_u32(+cap: U32, +fresh2: Nat, +depth: Nat, +life: T.Int64, +tc: AR.Tree<U32>, +table: Map<&2, Maybe<&2, U32>>, +tk: AR.Tree<String>, +te: AR.Tree<F.Slot<U32>>, +tp: AR.Tree<U32>, +tn: AR.Tree<U32>, +ord: List<&2, Nat>, +fl2: List<&2, Nat>, +s: Nat, +key: String, +v: U32, +now: T.Int64, +hs: {Nat.is_lt(s, SC.pow2(depth)) == True{} : Bool}, +hn: {DST.lmem(s, ord) == False{} : Bool}, +pfc: {AR.perfect(U32, 4n, tc) == True{} : Bool}, +pfk: {AR.perfect(String, depth, tk) == True{} : Bool}, +pfe: {AR.perfect(F.Slot<U32>, depth, te) == True{} : Bool}) -> {ST.model(~U32, INS.ins_sh(U32, cap, fresh2, depth, life, tc, table, tk, te, tp, tn, ord, fl2, s, key, AF.entry(~U32, life, v, now))) == S.LM{cap, life, S.snoc(U32, ST.ents(U32, AR.slots(String, tk), AR.slots(F.Slot<U32>, te), ord), S.En{key, v, NS.deadline(now, life)}), T.bump(0n, ST.mets(AR.slots(U32, tc)))} : S.Model<U32>}:
  INS.ins_model(~U32, cap, fresh2, depth, life, tc, table, tk, te, tp, tn, ord, fl2, s, key, v, now, hs, hn, pfc, pfk, pfe)

def ins_free_real_u32(+cap: U32, +fresh: Nat, +depth: Nat, +life: T.Int64, +tc: AR.Tree<U32>, +table: Map<&2, Maybe<&2, U32>>, +tk: AR.Tree<String>, +te: AR.Tree<F.Slot<U32>>, +tp: AR.Tree<U32>, +tn: AR.Tree<U32>, +ord: List<&2, Nat>, +f0: Nat, +rest: List<&2, Nat>, +key: String, e: F.Slot<U32>, +hd: {Nat.is_le(depth, 31n) == True{} : Bool}, +pfc: {AR.perfect(U32, 4n, tc) == True{} : Bool}, +pfk: {AR.perfect(String, depth, tk) == True{} : Bool}, +pfe: {AR.perfect(F.Slot<U32>, depth, te) == True{} : Bool}, +pfp: {AR.perfect(U32, depth, tp) == True{} : Bool}, +pfn: {AR.perfect(U32, depth, tn) == True{} : Bool}, +hl: {DST.alllt(ord, SC.pow2(depth)) == True{} : Bool}, +hf0: {Nat.is_lt(f0, SC.pow2(depth)) == True{} : Bool}, +hfk: {ST.fk(Con{f0, rest}, AR.slots(U32, tn)) == True{} : Bool}) -> {F.insert_new(~U32, ST.real(~U32, ST.Sh{cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, Con{f0, rest}}), key, e) == ST.real(~U32, INS.ins_sh(U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, rest, f0, key, e)) : F.Fast<U32>}:
  INS.ins_free_real(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, f0, rest, key, e, hd, pfc, pfk, pfe, pfp, pfn, hl, hf0, hfk)

def ins_fresh_real_u32(+cap: U32, +fresh: Nat, +depth: Nat, +life: T.Int64, +tc: AR.Tree<U32>, +table: Map<&2, Maybe<&2, U32>>, +tk: AR.Tree<String>, +te: AR.Tree<F.Slot<U32>>, +tp: AR.Tree<U32>, +tn: AR.Tree<U32>, +ord: List<&2, Nat>, +key: String, e: F.Slot<U32>, +hd: {Nat.is_le(depth, 31n) == True{} : Bool}, +pfc: {AR.perfect(U32, 4n, tc) == True{} : Bool}, +pfk: {AR.perfect(String, depth, tk) == True{} : Bool}, +pfe: {AR.perfect(F.Slot<U32>, depth, te) == True{} : Bool}, +pfp: {AR.perfect(U32, depth, tp) == True{} : Bool}, +pfn: {AR.perfect(U32, depth, tn) == True{} : Bool}, +hl: {DST.alllt(ord, SC.pow2(depth)) == True{} : Bool}, +hroom: {Nat.is_lt(fresh, SC.pow2(depth)) == True{} : Bool}) -> {F.insert_new(~U32, ST.real(~U32, ST.Sh{cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, Nil{}}), key, e) == ST.real(~U32, INS.ins_sh(U32, cap, 1n+fresh, depth, life, tc, table, tk, te, tp, tn, ord, Nil{}, fresh, key, e)) : F.Fast<U32>}:
  INS.ins_fresh_real(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, key, e, hd, pfc, pfk, pfe, pfp, pfn, hl, hroom)

def ins_grow_real_u32(+cap: U32, +fresh: Nat, +depth: Nat, +life: T.Int64, +tc: AR.Tree<U32>, +table: Map<&2, Maybe<&2, U32>>, +tk: AR.Tree<String>, +te: AR.Tree<F.Slot<U32>>, +tp: AR.Tree<U32>, +tn: AR.Tree<U32>, +ord: List<&2, Nat>, +key: String, e: F.Slot<U32>, +hd: {Nat.is_le(depth, 31n) == True{} : Bool}, +pfc: {AR.perfect(U32, 4n, tc) == True{} : Bool}, +pfk: {AR.perfect(String, depth, tk) == True{} : Bool}, +pfe: {AR.perfect(F.Slot<U32>, depth, te) == True{} : Bool}, +pfp: {AR.perfect(U32, depth, tp) == True{} : Bool}, +pfn: {AR.perfect(U32, depth, tn) == True{} : Bool}, +hl: {DST.alllt(ord, SC.pow2(depth)) == True{} : Bool}, +hdl: {Nat.is_lt(depth, 31n) == True{} : Bool}, +hfr: {Nat.is_le(fresh, SC.pow2(depth)) == True{} : Bool}, +hfull: {Nat.is_lt(fresh, SC.pow2(depth)) == False{} : Bool}) -> {F.insert_new(~U32, ST.real(~U32, ST.Sh{cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, Nil{}}), key, e) == ST.real(~U32, INS.ins_sh(U32, cap, 1n+fresh, 1n+depth, life, tc, table, AR.TNode{tk, AR.trep(String, depth, "")}, AR.TNode{te, AR.trep(F.Slot<U32>, depth, F.Vacant{})}, AR.TNode{tp, AR.trep(U32, depth, 0)}, AR.TNode{tn, AR.trep(U32, depth, 0)}, ord, Nil{}, fresh, key, e)) : F.Fast<U32>}:
