def good(~V: Data, sh: Shadow<V>) -> Bool:
  match sh:
    case Sh{+cap, +fresh, +depth, +life, +tc, +table, +tk, +te, +tp, +tn, +ord, +fl}:
      inv(~V, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl)

# ---- the constructor ----

def initial(~V: Data, +cap: U32) -> Shadow<V>:
  Sh{cap, 0n, 0n, S.zero_time(), AR.trep(U32, 4n, 0), Map.new(&2, Maybe<&2, U32>), AR.TLeaf{""}, AR.TLeaf{F.Vacant{}}, AR.TLeaf{0}, AR.TLeaf{0}, Nil{}, Nil{}}

def new_real(~V: Data, +cap: U32) -> {F.init(~V, cap) == real(~V, initial(~V, cap)) : F.Fast<V>}:
  %Equal.sym(Array<U32>, Array.new(U32, 4n, 0), AR.thaw(U32, AR.trep(U32, 4n, 0)), AR.new(U32, 4n, 0)) : {F.F{cap, 0, 0, 1, 0n, False{}, F.zero_stamp(), _, Map.new(&2, Maybe<&2, U32>), Array.new(String, 0n, ""), Array.new(F.Slot<V>, 0n, F.Vacant{}), F.empty_chain()} == real(~V, initial(~V, cap)) : F.Fast<V>}
  {==}

def new_model(~V: Data, +cap: U32) -> {model(~V, initial(~V, cap)) == S.LM{cap, S.zero_time(), Nil{}, T.zero_metrics()} : S.Model<V>}:
  {==}

def new_good(~V: Data, +cap: U32, +hc: {U32.is_eq(cap, 0) == False{} : Bool}) -> {good(~V, initial(~V, cap)) == True{} : Bool}:
  inv_mk(~V, cap, 0n, 0n, S.zero_time(), AR.trep(U32, 4n, 0), Map.new(&2, Maybe<&2, U32>), AR.TLeaf{""}, AR.TLeaf{F.Vacant{}}, AR.TLeaf{0}, AR.TLeaf{0}, Nil{}, Nil{},
    {==}, {==}, {==}, {==}, {==}, AR.trep_perfect(U32, 4n, 0), {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==},
    L.subst(Bool, b => {Bool.not(b) == True{} : Bool}, False{}, U32.is_eq(cap, 0), Equal.sym(Bool, U32.is_eq(cap, 0), False{}, hc), {==}),
    N.zero_le(U32.to_nat(cap)))
