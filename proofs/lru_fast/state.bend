import Base
import ../lib/logic.bend as L
import ../lib/nat.bend as N
import ../lib/u32.bend as U
import ../lib/array.bend as AR
import ../../spec/common.bend as SC
import ../../spec/lru_fast.bend as S
import ../../src/lru/fast.bend as F
import ../../src/lru/time.bend as Time
import ../../src/lru/wide.bend as W
import support/link_primitives.bend as D
import ../../types/lru_model.bend as T
import support/links_state.bend as DST
import ../../reference/lru/proofs/invariants.bend as Inv
import ../../reference/lru/proofs/map_insert.bend as MI
import ../../reference/lru/proofs/map_populated.bend as Pop

# The indexed LRU cache (src/lru/fast.bend): the proof shadow.
#
# The runtime holds five linear Base.Arrays (keys, slots, prev links, next
# links, counter limbs), so -- as for the other array-backed structures --
# the statements are about the cache BUILT from a Data mirror: perfect trees
# for the arrays, the native Map itself (it is Data), and two ghost lists:
#   ord  the live slots in RECENCY order (oldest first)
#   fl   the free slots in free-list order
# The runtime count, head, tail and free-list head are functions of them.
# Links are slot + 1 with 0 = none (DST.ln / DST.hd / DST.lst).

type Shadow<-V: Data> is Data:
  Sh{cap: U32, fresh: Nat, depth: Nat, life: T.Int64, tc: AR.Tree<U32>, table: Map<&2, Maybe<&2, U32>>, tk: AR.Tree<String>, te: AR.Tree<F.Slot<V>>, tp: AR.Tree<U32>, tn: AR.Tree<U32>, ord: List<&2, Nat>, fl: List<&2, Nat>}

def real(~V: Data, sh: Shadow<V>) -> F.Fast<V>:
  match sh:
    case Sh{+cap, +fresh, +depth, +life, tc, table, tk, te, tp, tn, +ord, +fl}:
      F.F{cap, U32.from_nat(SC.length(Nat, ord)), U32.from_nat(fresh), U.pow2u(depth), depth, Bool.not(Time.is_zero(life)), F.int_stamp(life), AR.thaw(U32, tc), table, AR.thaw(String, tk), AR.thaw(F.Slot<V>, te), F.CH{DST.hd(ord), DST.lst(ord), DST.hd(fl), AR.thaw(U32, tp), AR.thaw(U32, tn)}}

# ---- reading the slot lists ----

def kat(+ks: List<&2, String>, +s: Nat) -> String:
  L.some_value(String, SC.nth(String, ks, s), "")

def sat_m(-V: Data, m: Maybe<&2, F.Slot<V>>) -> F.Slot<V>:
  match m:
    case None{}:
      F.Vacant{}
    case Some{x}:
      x

def sat(-V: Data, +es: List<&2, F.Slot<V>>, +s: Nat) -> F.Slot<V>:
  sat_m(V, SC.nth(F.Slot<V>, es, s))

# ---- the abstraction ----

def ent_at(-V: Data, +k: String, e: F.Slot<V>, rest: List<&2, S.Ent<V>>) -> List<&2, S.Ent<V>>:
  match e:
    case F.Vacant{}:
      rest
    case F.Live{v}:
      Con{S.En{k, v, S.zero_time()}, rest}
    case F.Timed{v, d}:
      Con{S.En{k, v, F.stamp_int(d)}, rest}

def ents(-V: Data, +ks: List<&2, String>, +es: List<&2, F.Slot<V>>, ord: List<&2, Nat>) -> List<&2, S.Ent<V>>:
  match ord:
    case Nil{}:
      Nil{}
    case Con{+s, t}:
      ent_at(V, kat(ks, s), sat(V, es, s), ents(V, ks, es, t))

def pk(+cs: List<&2, U32>, +i: Nat, +j: Nat) -> Word(64n):
  W.pack(DST.lat(cs, i), DST.lat(cs, j))

# the five counters: counter c has its low limb at 2c and its high limb at 2c+1
def mets(+cs: List<&2, U32>) -> T.Metrics:
  T.Counts{Con{pk(cs, 0n, 1n), Con{pk(cs, 2n, 3n), Con{pk(cs, 4n, 5n), Con{pk(cs, 6n, 7n), Con{pk(cs, 8n, 9n), Nil{}}}}}}}

def model(~V: Data, sh: Shadow<V>) -> S.Model<V>:
  match sh:
    case Sh{+cap, fresh, depth, +life, +tc, table, +tk, +te, tp, tn, +ord, fl}:
      S.LM{cap, life, ents(V, AR.slots(String, tk), AR.slots(F.Slot<V>, te), ord), mets(AR.slots(U32, tc))}

# ---- the invariant's list predicates ----

# the free chain: each free slot links on to the next one (the last to none)
def fk(xs: List<&2, Nat>, +ns: List<&2, U32>) -> Bool:
  match xs:
    case Nil{}:
      True{}
    case Con{+x, +t}:
      Bool.and(U32.is_eq(DST.lat(ns, x), DST.hd_or(t, D.nil())), fk(t, ns))

def is_occ(-V: Data, e: F.Slot<V>) -> Bool:
  match e:
    case F.Vacant{}:
      False{}
    case F.Live{v}:
      True{}
    case F.Timed{v, d}:
      True{}

def all_occ(-V: Data, +es: List<&2, F.Slot<V>>, ord: List<&2, Nat>) -> Bool:
  match ord:
    case Nil{}:
      True{}
    case Con{+s, t}:
      Bool.and(is_occ(V, sat(V, es, s)), all_occ(V, es, t))

def mapped_m(m: Maybe<&2, U32>, +s: Nat) -> Bool:
  match m:
    case None{}:
      False{}
    case Some{x}:
      U32.is_eq(x, U32.from_nat(s))

# the table sends the key of slot s to s
def mapped(+table: Map<&2, Maybe<&2, U32>>, +key: String, +s: Nat) -> Bool:
  mapped_m(MI.lookup(Maybe<&2, U32>, None{}, table, key), s)

def all_mapped(+table: Map<&2, Maybe<&2, U32>>, +ks: List<&2, String>, ord: List<&2, Nat>) -> Bool:
  match ord:
    case Nil{}:
      True{}
    case Con{+s, t}:
      Bool.and(mapped(table, kat(ks, s), s), all_mapped(table, ks, t))

def keys_at(+ks: List<&2, String>, ord: List<&2, Nat>) -> List<&2, String>:
  match ord:
    case Nil{}:
      Nil{}
    case Con{+s, t}:
      Con{kat(ks, s), keys_at(ks, t)}

# ---- the invariant ----
def inv(~V: Data, +cap: U32, +fresh: Nat, +depth: Nat, +life: T.Int64, +tc: AR.Tree<U32>, +table: Map<&2, Maybe<&2, U32>>, +tk: AR.Tree<String>, +te: AR.Tree<F.Slot<V>>, +tp: AR.Tree<U32>, +tn: AR.Tree<U32>, +ord: List<&2, Nat>, +fl: List<&2, Nat>) -> Bool:
