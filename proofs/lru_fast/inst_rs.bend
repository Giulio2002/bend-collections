# Checked instantiations of the slot-removal core at V = U32.

def rs_real_u32(+cap: U32, +fresh: Nat, +depth: Nat, +life: T.Int64, +tc: AR.Tree<U32>, +table: Map<&2, Maybe<&2, U32>>, +tk: AR.Tree<String>, +te: AR.Tree<F.Slot<U32>>, +tp: AR.Tree<U32>, +tn: AR.Tree<U32>, +a: List<&2, Nat>, +s: Nat, +b: List<&2, Nat>, +fl: List<&2, Nat>, +metric: Nat, +hd: {Nat.is_le(depth, 31n) == True{} : Bool}, +pfc: {AR.perfect(U32, 4n, tc) == True{} : Bool}, +pfk: {AR.perfect(String, depth, tk) == True{} : Bool}, +pfe: {AR.perfect(F.Slot<U32>, depth, te) == True{} : Bool}, +pfp: {AR.perfect(U32, depth, tp) == True{} : Bool}, +pfn: {AR.perfect(U32, depth, tn) == True{} : Bool}, +hs: {Nat.is_lt(s, SC.pow2(depth)) == True{} : Bool}, +hl: {DST.alllt(SC.append(Nat, a, Con{s, b}), SC.pow2(depth)) == True{} : Bool}, +hk: {DST.lk(SC.append(Nat, a, Con{s, b}), D.nil(), D.nil(), AR.slots(U32, tp), AR.slots(U32, tn)) == True{} : Bool}, +hle: {Nat.is_le(SC.length(Nat, SC.append(Nat, a, Con{s, b})), SC.pow2(depth)) == True{} : Bool}) -> {F.remove_slot(~U32, ST.real(~U32, ST.Sh{cap, fresh, depth, life, tc, table, tk, te, tp, tn, SC.append(Nat, a, Con{s, b}), fl}), U32.from_nat(s), metric) == (ST.real(~U32, RS.rs_sh(U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, a, s, b, fl, metric)), F.slot_val(~U32, ST.sat(U32, AR.slots(F.Slot<U32>, te), s))) : F.Fast<U32> & Maybe<&2, U32>}:
  RS.rs_real(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, a, s, b, fl, metric, hd, pfc, pfk, pfe, pfp, pfn, hs, hl, hk, hle)

def rs_model_u32(+cap: U32, +fresh: Nat, +depth: Nat, +life: T.Int64, +tc: AR.Tree<U32>, +table: Map<&2, Maybe<&2, U32>>, +tk: AR.Tree<String>, +te: AR.Tree<F.Slot<U32>>, +tp: AR.Tree<U32>, +tn: AR.Tree<U32>, +a: List<&2, Nat>, +s: Nat, +b: List<&2, Nat>, +fl: List<&2, Nat>, +metric: Nat, +hd: {Nat.is_le(depth, 31n) == True{} : Bool}, +pfc: {AR.perfect(U32, 4n, tc) == True{} : Bool}, +pfe: {AR.perfect(F.Slot<U32>, depth, te) == True{} : Bool}, +hs: {Nat.is_lt(s, SC.pow2(depth)) == True{} : Bool}, +hl: {DST.alllt(SC.append(Nat, a, Con{s, b}), SC.pow2(depth)) == True{} : Bool}, +hnd: {DST.nodup(SC.append(Nat, a, Con{s, b})) == True{} : Bool}, +hocc: {ST.all_occ(U32, AR.slots(F.Slot<U32>, te), SC.append(Nat, a, Con{s, b})) == True{} : Bool}, +hmap: {ST.all_mapped(table, AR.slots(String, tk), SC.append(Nat, a, Con{s, b})) == True{} : Bool}) -> {ST.model(~U32, RS.rs_sh(U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, a, s, b, fl, metric)) == S.LM{cap, life, S.drop(U32, ST.ents(U32, AR.slots(String, tk), AR.slots(F.Slot<U32>, te), SC.append(Nat, a, Con{s, b})), ST.kat(AR.slots(String, tk), s)), T.bump(RS.mi(metric), ST.mets(AR.slots(U32, tc)))} : S.Model<U32>}:
  RS.rs_model(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, a, s, b, fl, metric, hd, pfc, pfe, hs, hl, hnd, hocc, hmap)

def rs_inv_u32(+cap: U32, +fresh: Nat, +depth: Nat, +life: T.Int64, +tc: AR.Tree<U32>, +table: Map<&2, Maybe<&2, U32>>, +tk: AR.Tree<String>, +te: AR.Tree<F.Slot<U32>>, +tp: AR.Tree<U32>, +tn: AR.Tree<U32>, +a: List<&2, Nat>, +s: Nat, +b: List<&2, Nat>, +fl: List<&2, Nat>, +metric: Nat, +h: {ST.inv(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, SC.append(Nat, a, Con{s, b}), fl) == True{} : Bool}) -> {ST.good(~U32, RS.rs_sh(U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, a, s, b, fl, metric)) == True{} : Bool}:
  RS.rs_inv(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, a, s, b, fl, metric, h)


def remove_real_u32(+cap: U32, +fresh: Nat, +depth: Nat, +life: T.Int64, +tc: AR.Tree<U32>, +table: Map<&2, Maybe<&2, U32>>, +tk: AR.Tree<String>, +te: AR.Tree<F.Slot<U32>>, +tp: AR.Tree<U32>, +tn: AR.Tree<U32>, +ord: List<&2, Nat>, +fl: List<&2, Nat>, +key: String, +h: {ST.inv(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl) == True{} : Bool}) -> {F.remove(~U32, ST.real(~U32, ST.Sh{cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl}), key) == RM.rp(~U32, RM.rm_ghost(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl, key, TB.lk(table, key))) : F.Fast<U32> & Maybe<&2, U32>}:
  RM.remove_real(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl, key, h)

def remove_inv_u32(+cap: U32, +fresh: Nat, +depth: Nat, +life: T.Int64, +tc: AR.Tree<U32>, +table: Map<&2, Maybe<&2, U32>>, +tk: AR.Tree<String>, +te: AR.Tree<F.Slot<U32>>, +tp: AR.Tree<U32>, +tn: AR.Tree<U32>, +ord: List<&2, Nat>, +fl: List<&2, Nat>, +key: String, +h: {ST.inv(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl) == True{} : Bool}) -> {RM.gp(~U32, RM.rm_ghost(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl, key, TB.lk(table, key))) == True{} : Bool}:
  RM.remove_inv(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl, key, h)

def remove_model_u32(+cap: U32, +fresh: Nat, +depth: Nat, +life: T.Int64, +tc: AR.Tree<U32>, +table: Map<&2, Maybe<&2, U32>>, +tk: AR.Tree<String>, +te: AR.Tree<F.Slot<U32>>, +tp: AR.Tree<U32>, +tn: AR.Tree<U32>, +ord: List<&2, Nat>, +fl: List<&2, Nat>, +key: String, +h: {ST.inv(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl) == True{} : Bool}) -> {S.remove(U32, ST.model(~U32, ST.Sh{cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl}), key) == RM.mp(~U32, RM.rm_ghost(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl, key, TB.lk(table, key))) : S.Model<U32> & Maybe<&2, U32>}:
  RM.remove_model(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl, key, h)

def touch_inv_u32(+cap: U32, +fresh: Nat, +depth: Nat, +life: T.Int64, +tc: AR.Tree<U32>, +table: Map<&2, Maybe<&2, U32>>, +tk: AR.Tree<String>, +te: AR.Tree<F.Slot<U32>>, +tp: AR.Tree<U32>, +tn: AR.Tree<U32>, +a: List<&2, Nat>, +s: Nat, +b: List<&2, Nat>, +fl: List<&2, Nat>, +tc2: AR.Tree<U32>, +te2: AR.Tree<F.Slot<U32>>, +h: {ST.inv(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, SC.append(Nat, a, Con{s, b}), fl) == True{} : Bool}, +pfc2: {AR.perfect(U32, 4n, tc2) == True{} : Bool}, +pfe2: {AR.perfect(F.Slot<U32>, depth, te2) == True{} : Bool}, +hocc2: {ST.all_occ(U32, AR.slots(F.Slot<U32>, te2), TO.mv(a, s, b)) == True{} : Bool}) -> {ST.inv(~U32, cap, fresh, depth, life, tc2, table, tk, te2, TO.t_tp(depth, tp, a, s, b), TO.t_tn(depth, tn, a, s, b), TO.t_ord(a, s, b), fl) == True{} : Bool}:
  T2.touch_inv(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, a, s, b, fl, tc2, te2, h, pfc2, pfe2, hocc2)

def read_real_u32(+cap: U32, +fresh: Nat, +depth: Nat, +life: T.Int64, +tc: AR.Tree<U32>, +table: Map<&2, Maybe<&2, U32>>, +tk: AR.Tree<String>, +te: AR.Tree<F.Slot<U32>>, +tp: AR.Tree<U32>, +tn: AR.Tree<U32>, +ord: List<&2, Nat>, +fl: List<&2, Nat>, +key: String, +now: T.Int64, +tracked: Bool, +h: {ST.inv(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl) == True{} : Bool}) -> {F.read(~U32, ST.real(~U32, ST.Sh{cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl}), key, F.int_stamp(now), tracked) == RM.rp(~U32, RD.rd_ghost(U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl, key, now, tracked, TB.lk(table, key))) : F.Fast<U32> & Maybe<&2, U32>}:
  RD.read_real(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl, key, now, tracked, h)
def read_inv_u32(+cap: U32, +fresh: Nat, +depth: Nat, +life: T.Int64, +tc: AR.Tree<U32>, +table: Map<&2, Maybe<&2, U32>>, +tk: AR.Tree<String>, +te: AR.Tree<F.Slot<U32>>, +tp: AR.Tree<U32>, +tn: AR.Tree<U32>, +ord: List<&2, Nat>, +fl: List<&2, Nat>, +key: String, +now: T.Int64, +tracked: Bool, +h: {ST.inv(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl) == True{} : Bool}) -> {RM.gp(~U32, RD.rd_ghost(U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl, key, now, tracked, TB.lk(table, key))) == True{} : Bool}:
  RD.read_inv(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl, key, now, tracked, h)

def rl_model_u32(+cap: U32, +fresh: Nat, +depth: Nat, +life: T.Int64, +tc: AR.Tree<U32>, +table: Map<&2, Maybe<&2, U32>>, +tk: AR.Tree<String>, +te: AR.Tree<F.Slot<U32>>, +tp: AR.Tree<U32>, +tn: AR.Tree<U32>, +ord: List<&2, Nat>, +fl: List<&2, Nat>, +s: Nat, +key: String, tracked: Bool, v: U32, +x: S.Ent<U32>, +hx: {ST.ents(U32, AR.slots(String, tk), AR.slots(F.Slot<U32>, te), Con{s, Nil{}}) == Con{x, Nil{}} : List<&2, S.Ent<U32>>}, +hvx: {S.val_of(U32, x) == v : U32}, +elk: {TB.lk(table, key) == Some{U32.from_nat(s)} : Maybe<&2, U32>}, +heq: {String.eq(ST.kat(AR.slots(String, tk), s), key) == True{} : Bool}, +hm: {DST.lmem(s, ord) == True{} : Bool}, +h: {ST.inv(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl) == True{} : Bool}) -> {S.read_live(U32, cap, life, ST.ents(U32, AR.slots(String, tk), AR.slots(F.Slot<U32>, te), ord), ST.mets(AR.slots(U32, tc)), key, x, tracked) == RM.mp(~U32, RD.rd_live(U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl, s, tracked, v)) : S.Model<U32> & Maybe<&2, U32>}:
  RD.rl_model(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl, s, key, tracked, v, x, hx, hvx, elk, heq, hm, h)

def rx_model_u32(+cap: U32, +fresh: Nat, +depth: Nat, +life: T.Int64, +tc: AR.Tree<U32>, +table: Map<&2, Maybe<&2, U32>>, +tk: AR.Tree<String>, +te: AR.Tree<F.Slot<U32>>, +tp: AR.Tree<U32>, +tn: AR.Tree<U32>, +ord: List<&2, Nat>, +fl: List<&2, Nat>, +s: Nat, +key: String, +tracked: Bool, +elk: {TB.lk(table, key) == Some{U32.from_nat(s)} : Maybe<&2, U32>}, +heq: {String.eq(ST.kat(AR.slots(String, tk), s), key) == True{} : Bool}, +hm: {DST.lmem(s, ord) == True{} : Bool}, +h: {ST.inv(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl) == True{} : Bool}) -> {(S.LM{cap, life, S.drop(U32, ST.ents(U32, AR.slots(String, tk), AR.slots(F.Slot<U32>, te), ord), key), S.count_if(tracked, 4n, T.bump(2n, ST.mets(AR.slots(U32, tc))))}, None{}) == RM.mp(~U32, (RD.hcs(U32, RM.rs_sh_at(U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, s, fl, 2n), tracked), None{})) : S.Model<U32> & Maybe<&2, U32>}:
  RD.rx_model(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl, s, key, tracked, elk, heq, hm, h)

def read_model_u32(+cap: U32, +fresh: Nat, +depth: Nat, +life: T.Int64, +tc: AR.Tree<U32>, +table: Map<&2, Maybe<&2, U32>>, +tk: AR.Tree<String>, +te: AR.Tree<F.Slot<U32>>, +tp: AR.Tree<U32>, +tn: AR.Tree<U32>, +ord: List<&2, Nat>, +fl: List<&2, Nat>, +key: String, +now: T.Int64, +tracked: Bool, +h: {ST.inv(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl) == True{} : Bool}) -> {S.read(U32, ST.model(~U32, ST.Sh{cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl}), key, now, tracked) == RM.mp(~U32, RD.rd_ghost(U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl, key, now, tracked, TB.lk(table, key))) : S.Model<U32> & Maybe<&2, U32>}:
  RD.read_model(~U32, cap, fresh, depth, life, tc, table, tk, te, tp, tn, ord, fl, key, now, tracked, h)
