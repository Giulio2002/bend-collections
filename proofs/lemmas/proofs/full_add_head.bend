def model_head(-V: Data, +cap: Nat, +table: Map<&2, Maybe<&2, T.Entry<String, V>>>, +oldkey: String, +rest: List<&2, String>, +life: T.Int64, counts: T.Metrics, +cb: Bool, +key: String, +value: V, +deadline: T.Int64, +entry: T.Entry<String, V>, +valid: {Inv.representation(~String, ~Codec.string_encode, V, C.State{cap, table, Con{oldkey, rest}, life, counts, cb}) == True{} : Bool}, full: {Nat.is_ge(1n+List.length(&2, String, rest), cap) == True{} : Bool}, found: {C.lookup(String, V, C.State{cap, table, Con{oldkey, rest}, life, counts, cb}, oldkey) == Some{entry} : Maybe<&2, T.Entry<String, V>>}) -> {O.absent_add(~String, ~Lookup.string_same, V, F.abstract(String, V, C.State{cap, table, Con{oldkey, rest}, life, counts, cb}), key, value, deadline) == O.after_eviction(~String, ~Lookup.string_same, V, F.abstract(String, V, C.State{cap, table, Con{oldkey, rest}, life, counts, cb}), key, value, deadline, entry) : S.Observation<String, V>}:
  T.Counts{+i, +e, +r, +h, +m} = counts
  %Equal.sym(S.Model<String, V>, F.abstract(String, V, C.State{cap, table, Con{oldkey, rest}, life, T.Counts{i, e, r, h, m}, cb}), Order.normal(V, C.State{cap, table, Con{oldkey, rest}, life, T.Counts{i, e, r, h, m}, cb}), Order.normalize(V, C.State{cap, table, Con{oldkey, rest}, life, T.Counts{i, e, r, h, m}, cb}, valid)) : {O.absent_add(~String, ~Lookup.string_same, V, _, key, value, deadline) == O.after_eviction(~String, ~Lookup.string_same, V, _, key, value, deadline, entry) : S.Observation<String, V>}
  %Equal.sym(Bool, Nat.is_ge(1n+List.length(&2, String, rest), cap), True{}, full) : {O.new_room(~String, ~Lookup.string_same, V, Order.normal(V, C.State{cap, table, Con{oldkey, rest}, life, T.Counts{i, e, r, h, m}, cb}), key, value, deadline, F.bindings(String, V, Map.to_list(&2, Maybe<&2, T.Entry<String, V>>, table)), Con{oldkey, rest}, _) == O.after_eviction(~String, ~Lookup.string_same, V, Order.normal(V, C.State{cap, table, Con{oldkey, rest}, life, T.Counts{i, e, r, h, m}, cb}), key, value, deadline, entry) : S.Observation<String, V>}
  Equal.cong(Maybe<&2, T.Entry<String, V>>, S.Observation<String, V>, item => O.evict_found(~String, ~Lookup.string_same, V, Order.normal(V, C.State{cap, table, Con{oldkey, rest}, life, T.Counts{i, e, r, h, m}, cb}), key, value, deadline, item), S.find(~String, ~Lookup.string_same, V, F.bindings(String, V, Map.to_list(&2, Maybe<&2, T.Entry<String, V>>, table)), oldkey), Some{entry}, Equal.trans(Maybe<&2, T.Entry<String, V>>, S.find(~String, ~Lookup.string_same, V, F.bindings(String, V, Map.to_list(&2, Maybe<&2, T.Entry<String, V>>, table)), oldkey), C.lookup(String, V, C.State{cap, table, Con{oldkey, rest}, life, T.Counts{i, e, r, h, m}, cb}, oldkey), Some{entry}, Equal.sym(Maybe<&2, T.Entry<String, V>>, C.lookup(String, V, C.State{cap, table, Con{oldkey, rest}, life, T.Counts{i, e, r, h, m}, cb}, oldkey), S.find(~String, ~Lookup.string_same, V, F.bindings(String, V, Map.to_list(&2, Maybe<&2, T.Entry<String, V>>, table)), oldkey), Removal.normal_lookup(V, C.State{cap, table, Con{oldkey, rest}, life, T.Counts{i, e, r, h, m}, cb}, oldkey, valid)), found))

def room_after_head(-V: Data, +cap: Nat, +table: Map<&2, Maybe<&2, T.Entry<String, V>>>, +oldkey: String, +rest: List<&2, String>, +life: T.Int64, counts: T.Metrics, +cb: Bool, +key: String, +value: V, +deadline: T.Int64, +oldvalue: V, +oldexpiry: T.Int64, bound: {Nat.is_le(1n+List.length(&2, String, rest), cap) == True{} : Bool}, +found: {C.lookup(String, V, C.State{cap, table, Con{oldkey, rest}, life, counts, cb}, oldkey) == Some{T.Item{oldkey, oldvalue, oldexpiry}} : Maybe<&2, T.Entry<String, V>>}) -> Store.bounded(V, C.step_cache(String, V, C.remove_present(String, V, C.State{cap, table, Con{oldkey, rest}, life, counts, cb}, oldkey, True{}, T.Item{oldkey, oldvalue, oldexpiry})), key, value, deadline, True{}, C.step_events(String, V, C.remove_present(String, V, C.State{cap, table, Con{oldkey, rest}, life, counts, cb}, oldkey, True{}, T.Item{oldkey, oldvalue, oldexpiry}))):
  T.Counts{+i, +e, +r, +h, +m} = counts
  %found : {Nat.is_le(C.len(String, V, C.step_cache(String, V, C.store_after_evict(String, V, key, key, value, deadline, C.remove_found(String, V, C.State{cap, table, Con{oldkey, rest}, life, T.Counts{i, e, r, h, m}, cb}, oldkey, True{}, _)))), cap) == True{} : Bool}
  Capacity.evict_then_store_bounded(String, V, cap, table, oldkey, rest, life, T.Counts{i, e, r, h, m}, cb, key, key, value, deadline, bound, (T.Item{oldkey, oldvalue, oldexpiry}, found))

def known(-V: Data, +cap: Nat, +table: Map<&2, Maybe<&2, T.Entry<String, V>>>, +oldkey: String, +rest: List<&2, String>, +life: T.Int64, +counts: T.Metrics, +cb: Bool, +key: String, +value: V, +deadline: T.Int64, +oldvalue: V, +oldexpiry: T.Int64, +valid: {Inv.representation(~String, ~Codec.string_encode, V, C.State{cap, table, Con{oldkey, rest}, life, counts, cb}) == True{} : Bool}, disabled: {cb == False{} : Bool}, full: {Nat.is_ge(1n+List.length(&2, String, rest), cap) == True{} : Bool}, +found: {C.lookup(String, V, C.State{cap, table, Con{oldkey, rest}, life, counts, cb}, oldkey) == Some{T.Item{oldkey, oldvalue, oldexpiry}} : Maybe<&2, T.Entry<String, V>>}) -> E.observations(~String, ~Lookup.string_same, V, F.observe(String, V, C.add_room(String, V, C.State{cap, table, Con{oldkey, rest}, life, counts, cb}, key, key, value, deadline, True{})), O.absent_add(~String, ~Lookup.string_same, V, F.abstract(String, V, C.State{cap, table, Con{oldkey, rest}, life, counts, cb}), key, value, deadline)):
  %Equal.sym(S.Observation<String, V>, O.absent_add(~String, ~Lookup.string_same, V, F.abstract(String, V, C.State{cap, table, Con{oldkey, rest}, life, counts, cb}), key, value, deadline), O.after_eviction(~String, ~Lookup.string_same, V, F.abstract(String, V, C.State{cap, table, Con{oldkey, rest}, life, counts, cb}), key, value, deadline, T.Item{oldkey, oldvalue, oldexpiry}), model_head(V, cap, table, oldkey, rest, life, counts, cb, key, value, deadline, T.Item{oldkey, oldvalue, oldexpiry}, valid, full, found)) : E.observations(~String, ~Lookup.string_same, V, F.observe(String, V, C.add_room(String, V, C.State{cap, table, Con{oldkey, rest}, life, counts, cb}, key, key, value, deadline, True{})), _)
  %Equal.sym(Maybe<&2, T.Entry<String, V>>, C.lookup(String, V, C.State{cap, table, Con{oldkey, rest}, life, counts, cb}, oldkey), Some{T.Item{oldkey, oldvalue, oldexpiry}}, found) : E.observations(~String, ~Lookup.string_same, V, F.observe(String, V, C.store_after_evict(String, V, key, key, value, deadline, C.remove_found(String, V, C.State{cap, table, Con{oldkey, rest}, life, counts, cb}, oldkey, True{}, _))), O.after_eviction(~String, ~Lookup.string_same, V, F.abstract(String, V, C.State{cap, table, Con{oldkey, rest}, life, counts, cb}), key, value, deadline, T.Item{oldkey, oldvalue, oldexpiry}))
  EvictWrite.known(V, C.State{cap, table, Con{oldkey, rest}, life, counts, cb}, oldkey, oldvalue, oldexpiry, key, value, deadline, valid, disabled, room_after_head(V, cap, table, oldkey, rest, life, counts, cb, key, value, deadline, oldvalue, oldexpiry, Access.get_bounded(~String, ~Codec.string_encode, V, C.State{cap, table, Con{oldkey, rest}, life, counts, cb}, valid), found))
