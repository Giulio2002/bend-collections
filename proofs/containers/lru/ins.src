# add, a new key, the core: slot s (free, off the list) takes the key, its
# bucket fills the empty bucket e that ends the key's probe, the slot is
# linked as the newest; the model gains the entry, counted as an insertion.

%include read.src

%def KW K.kword(key)
%def KS PA.stored(key)
%def LS1 H.link(su)
%def FE U32.from_nat(e)
%def T2 AR.upd(U32, 1n+k, AR.upd(U32, 1n+k, tabT, UD.v(U32.shl($FE)), $KW), UD.v(U32.inc(U32.shl($FE))), $LS1)
%def KTF AR.upd(String, sd, ksT, UD.v(su), $KS)
%def ETF AR.upd(Maybe<&2, V>, sd, eT, UD.v(su), Some{v})
%def LK1 AR.upd(U32, 3n+sd, lkT, UD.v(LR.tidx(su)), t)
%def LK2 AR.upd(U32, 3n+sd, $LK1, UD.v(LR.dlo_idx(su)), lo)
%def LK3 AR.upd(U32, 3n+sd, $LK2, UD.v(LR.dhi_idx(su)), hi)
%def LK4 AR.upd(U32, 3n+sd, $LK3, UD.v(LR.hidx(su)), $KW)
%def L0 AR.slots(U32, lkT)
%def L1 AR.slots(U32, $LK1)
%def L2 AR.slots(U32, $LK2)
%def L3 AR.slots(U32, $LK3)
%def L4 AR.slots(U32, $LK4)
%def KLF AR.slots(String, $KTF)
%def ELF AR.slots(Maybe<&2, V>, $ETF)
%def LLF AR.slots(U32, t3)
%def SL2 SC.append(Nat, sl, Con{s, Nil{}})
%def BF B.BF{$KW, $LS1, key}
%def BN IM.bupd($BS, e, $BF)
%def BSF TB.buckets(AR.slots(U32, $T2), $KLF, $NN)
%def UKL SC.update(String, $KL, s, $KS)
%def UEL SC.update(Maybe<&2, V>, $EL, s, Some{v})
%def EN SP.LE{key, v, t, W.U64{lo, hi}}
%def SPEC SP.L{cap, $M3, $W4, SP.snoc(~V, $ES, $EN), SP.c_ins($CTR)}
%def MFL AR.slots(U32, Mf)
%def MBL AR.slots(U32, mB)
%def SHF2 ST.LS{cap, U32.inc(n), LK.fst_or($SL2, 0), LK.lnk(s), free2, mB, k, sd, $T2, $KTF, $ETF, t3, $SL2, fl2}
%def FR2 UD.v(fr2u)
%def ICF $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +key: String, +hno: {B.all_lt(B.PNo{$BS, key}, $NN) == True{} : Bool}, +e: Nat, +he: {Nat.is_lt(e, $NN) == True{} : Bool}, +hz: {B.at($BS, e) == B.BE{} : B.Bk}, +hp: {B.occpath($BS, $NN, $HOME, M.dist($NN, $HOME, e)) == True{} : Bool}, +hroom: {Nat.is_le(Nat.double(1n+UD.v(n)), $NN) == True{} : Bool}, +s: Nat, +su: U32, +hsv: {UD.v(su) == s : Nat}, +hs0: {Nat.is_lt(s, SC.pow2(sd)) == True{} : Bool}, +hsn: {NL.memn(s, sl) == False{} : Bool}, +fl2: List<&2, Nat>, +free2: U32, +fr2u: U32, +hfree: {U32.is_eq(free2, LK.fst_or(fl2, 0)) == True{} : Bool}, +hfll: {ST.fll($LLo, fl2) == True{} : Bool}, +hfl: {ST.flok(~V, fl2, $FR2, $EL) == True{} : Bool}, +hfnd: {NL.nodupn(fl2) == True{} : Bool}, +hcnt: {Nat.is_eq(Nat.add(SC.length(Nat, $SL2), SC.length(Nat, fl2)), $FR2) == True{} : Bool}, +hsfl: {NL.memn(s, fl2) == False{} : Bool}, +hsfr: {Nat.is_lt(s, $FR2) == True{} : Bool}, +hfrle: {Nat.is_le($FR, $FR2) == True{} : Bool}, +hfr2: {Nat.is_le($FR2, SC.pow2(sd)) == True{} : Bool}, +Mf: AR.Tree<U32>, +pf5: {AR.perfect(U32, 5n, Mf) == True{} : Bool}, +hsm: {$MFL == SC.update(U32, $ML, 0n, fr2u) : List<&2, U32>}, +v: V, +t: U32, +lo: U32, +hi: U32
%def ICA $SHA, hg, one, h1, key, hno, e, he, hz, hp, hroom, s, su, hsv, hs0, hsn, fl2, free2, fr2u, hfree, hfll, hfl, hfnd, hcnt, hsfl, hsfr, hfrle, hfr2, Mf, pf5, hsm, v, t, lo, hi
%def POST +mB: AR.Tree<U32>, +pm2: {AR.perfect(U32, 5n, mB) == True{} : Bool}, +ew: {ST.w64($MBL, 16n) == SP.inc64(ST.w64($MFL, 16n)) : W.U64}, +x: U32, +y: U32, +eb: {$MBL == SC.update(U32, SC.update(U32, $MFL, 16n, x), 1n+16n, y) : List<&2, U32>}, +t3: AR.Tree<U32>, +tr: TR.Tr, +hp3: {AR.perfect(U32, 3n+sd, t3) == True{} : Bool}, +hs3: {$LLF == TR.app($L4, tr) : List<&2, U32>}, +hlo: {TR.trlo(tr) == True{} : Bool}, +hin: {TR.trin(tr, $SL2) == True{} : Bool}, +hg3: {ST.seg($LLF, $SL2, 0, 0) == True{} : Bool}
%def POSTA mB, pm2, ew, x, y, eb, t3, tr, hp3, hs3, hlo, hin, hg3
%def NE(a, b) ID.off_ne(s, s, a, b, {==}, {==}, DL.ne_word(s, s, a, b, {==}))
%def KP(j) BS.keep($MFL, mB, 16n, x, y, eb, j, {==}, {==})
%def MF(j) Equal.trans(U32, W32.nth0($MFL, j), W32.nth0(SC.update(U32, $ML, 0n, fr2u), j), W32.nth0($ML, j), Equal.cong(List<&2, U32>, U32, z => W32.nth0(z, j), $MFL, SC.update(U32, $ML, 0n, fr2u), hsm), W32.nth0_upd_other($ML, 0n, j, fr2u, {==}))
%def KQ(j) Equal.trans(U32, W32.nth0($MBL, j), W32.nth0($MFL, j), W32.nth0($ML, j), $KP(j), $MF(j))

# the model of the placed entry
def ic_model(~V: Data, $ICF, $POST) -> {ST.model(~V, $SHF2) == $SPEC : SP.Lru<V>}:
  +hsd = RD.f_hsd(~V, $SHA, hg)
  +hsd1 = UL.sd1(sd, hsd)
  +hsd32 = N.lt_trans(sd, 1n+sd, 32n, N.lt_succ(sd), hsd1)
  +hk30 = L.and_left(Nat.is_lt(k, 30n), Nat.is_lt(0n, k), $G(ck))
  +hk31 = N.lt_trans(k, 30n, 31n, hk30, {==})
  +hk0 = L.and_right(Nat.is_lt(k, 30n), Nat.is_lt(0n, k), $G(ck))
