  +se = Equal.trans(List<&2, Maybe<&2, V>>, $ELF, SC.update(Maybe<&2, V>, $EL, UD.v(su), Some{v}), $UEL, AR.upd_slots(Maybe<&2, V>, sd, eT, UD.v(su), Some{v}, hsu, hpe), Equal.cong(Nat, List<&2, Maybe<&2, V>>, z => SC.update(Maybe<&2, V>, $EL, z, Some{v}), UD.v(su), s, hsv))
  +hle = UT.len_of(Maybe<&2, V>, sd, eT, hpe, s, hs0)
  +hlk = UT.len_of(String, sd, ksT, hpk, s, hs0)
  +hb32 = W32.bound32(one, h1, UD.v(su), sd, hsd1, hsu)
  +hsls = Equal.trans(Nat, UD.v(H.slot($LS1)), UD.v(su), s, LK.slot_link(one, h1, su, hb32), hsv)
  +elk = LT.lnk_su(su, s, sd, hsd, hsv, hs0)
  +hns = I1.noslot_bsl($BS, sl, $L0, s, hsn, $NN, $G(cbsl))
  +hns2 = L.subst(Nat, z => {HT.noslot($BS, z, $NN) == True{} : Bool}, s, UD.v(H.slot($LS1)), Equal.sym(Nat, UD.v(H.slot($LS1)), s, hsls), hns)
  +hel = I1.tp_len(AR.slots(U32, tabT), $KL, k, e, he)
  +tsl = I1.tp_sl(k, hk30, tabT, $G(cpt), e, he, $KW, $LS1)
  +w2 = Equal.trans(U32, ST.lw($LLF, s, 2n), ST.lw($L4, s, 2n), $KW, Equal.trans(U32, ST.lw($LLF, s, 2n), ST.lw(TR.app($L4, tr), s, 2n), ST.lw($L4, s, 2n), Equal.cong(List<&2, U32>, U32, z => ST.lw(z, s, 2n), $LLF, TR.app($L4, tr), hs3), TR.lw_tr_hi($L4, tr, hlo, s, 2n, {==}, {==})), MT.nth_same(3n+sd, $LK3, p3, ST.off(s, 2n), ID.off_lt(s, sd, hs0, 2n, {==}), $KW, $LK4, s4))
  +w3 = Equal.trans(U32, ST.lw($LLF, s, 3n), ST.lw($L4, s, 3n), t, Equal.trans(U32, ST.lw($LLF, s, 3n), ST.lw(TR.app($L4, tr), s, 3n), ST.lw($L4, s, 3n), Equal.cong(List<&2, U32>, U32, z => ST.lw(z, s, 3n), $LLF, TR.app($L4, tr), hs3), TR.lw_tr_hi($L4, tr, hlo, s, 3n, {==}, {==})), Equal.trans(U32, W32.nth0($L4, ST.off(s, 3n)), W32.nth0($L3, ST.off(s, 3n)), t, MT.nth_other($LK3, ST.off(s, 2n), $KW, $LK4, s4, ST.off(s, 3n), $NE(2n, 3n)), Equal.trans(U32, W32.nth0($L3, ST.off(s, 3n)), W32.nth0($L2, ST.off(s, 3n)), t, MT.nth_other($LK2, ST.off(s, 5n), hi, $LK3, s3, ST.off(s, 3n), $NE(5n, 3n)), Equal.trans(U32, W32.nth0($L2, ST.off(s, 3n)), W32.nth0($L1, ST.off(s, 3n)), t, MT.nth_other($LK1, ST.off(s, 4n), lo, $LK2, s2, ST.off(s, 3n), $NE(4n, 3n)), MT.nth_same(3n+sd, lkT, hpl, ST.off(s, 3n), ID.off_lt(s, sd, hs0, 3n, {==}), t, $LK1, s1)))))
  +w4 = Equal.trans(U32, ST.lw($LLF, s, 4n), ST.lw($L4, s, 4n), lo, Equal.trans(U32, ST.lw($LLF, s, 4n), ST.lw(TR.app($L4, tr), s, 4n), ST.lw($L4, s, 4n), Equal.cong(List<&2, U32>, U32, z => ST.lw(z, s, 4n), $LLF, TR.app($L4, tr), hs3), TR.lw_tr_hi($L4, tr, hlo, s, 4n, {==}, {==})), Equal.trans(U32, W32.nth0($L4, ST.off(s, 4n)), W32.nth0($L3, ST.off(s, 4n)), lo, MT.nth_other($LK3, ST.off(s, 2n), $KW, $LK4, s4, ST.off(s, 4n), $NE(2n, 4n)), Equal.trans(U32, W32.nth0($L3, ST.off(s, 4n)), W32.nth0($L2, ST.off(s, 4n)), lo, MT.nth_other($LK2, ST.off(s, 5n), hi, $LK3, s3, ST.off(s, 4n), $NE(5n, 4n)), MT.nth_same(3n+sd, $LK1, p1, ST.off(s, 4n), ID.off_lt(s, sd, hs0, 4n, {==}), lo, $LK2, s2))))
  +w5 = Equal.trans(U32, ST.lw($LLF, s, 5n), ST.lw($L4, s, 5n), hi, Equal.trans(U32, ST.lw($LLF, s, 5n), ST.lw(TR.app($L4, tr), s, 5n), ST.lw($L4, s, 5n), Equal.cong(List<&2, U32>, U32, z => ST.lw(z, s, 5n), $LLF, TR.app($L4, tr), hs3), TR.lw_tr_hi($L4, tr, hlo, s, 5n, {==}, {==})), Equal.trans(U32, W32.nth0($L4, ST.off(s, 5n)), W32.nth0($L3, ST.off(s, 5n)), hi, MT.nth_other($LK3, ST.off(s, 2n), $KW, $LK4, s4, ST.off(s, 5n), $NE(2n, 5n)), MT.nth_same(3n+sd, $LK2, p2, ST.off(s, 5n), ID.off_lt(s, sd, hs0, 5n, {==}), hi, $LK3, s3)))
