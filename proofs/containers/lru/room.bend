# add, first step: room keeps the table at most half full for one more entry,
# doubling it when needed (a rehash); the model is unchanged.


# the state is roomy: one more entry keeps the table at most half full
def roomy(~V: Data, sh: ST.Sh<V>) -> Bool:
  match sh:
    case ST.LS{+cap, +n, +head, +tail, +free, +mT, +k, +sd, +tabT, +ksT, +eT, +lkT, +sl, +fl}:
      Nat.is_le(Nat.double(1n+UD.v(n)), SC.pow2(k))

def RoomOK(~V: Data, +sh: ST.Sh<V>, r: LR.LRU<&2, V>) -> Type:
  Sigma<&1, &1, ST.Sh<V>, sh2 => {r == ST.real(~V, sh2) : LR.LRU<&2, V>} & ({ST.model(~V, sh2) == ST.model(~V, sh) : SP.Lru<V>} & ({ST.good(~V, sh2) == True{} : Bool} & {roomy(~V, sh2) == True{} : Bool}))>

def mk_room(~V: Data, +sh: ST.Sh<V>, -r: LR.LRU<&2, V>, +sh2: ST.Sh<V>, +e: {r == ST.real(~V, sh2) : LR.LRU<&2, V>}, +em: {ST.model(~V, sh2) == ST.model(~V, sh) : SP.Lru<V>}, +g: {ST.good(~V, sh2) == True{} : Bool}, +h: {roomy(~V, sh2) == True{} : Bool}) -> RoomOK(~V, sh, r):
  (sh2, (e, (em, (g, h))))


# the invariant from its components with the meta words named
def good_mk(~V: Data, +cap: U32, +n: U32, +head: U32, +tail: U32, +free: U32, +mT2: AR.Tree<U32>, +a0: U32, +a1: U32, +a2: U32, +a6: U32, +a7: U32, +k: Nat, +sd: Nat, +tabT: AR.Tree<U32>, +ksT: AR.Tree<String>, +eT: AR.Tree<Maybe<&2, V>>, +lkT: AR.Tree<U32>, +sl: List<&2, Nat>, +fl: List<&2, Nat>, +hg: {ST.goodF(~V, cap, n, head, tail, free, a0, a1, a2, a6, a7, True{}, k, sd, tabT, AR.slots(String, ksT), AR.perfect(String, sd, ksT), eT, lkT, sl, fl) == True{} : Bool}, +e0: {W32.nth0(AR.slots(U32, mT2), 0n) == a0 : U32}, +e1: {W32.nth0(AR.slots(U32, mT2), 1n) == a1 : U32}, +e2: {W32.nth0(AR.slots(U32, mT2), 2n) == a2 : U32}, +e6: {W32.nth0(AR.slots(U32, mT2), 6n) == a6 : U32}, +e7: {W32.nth0(AR.slots(U32, mT2), 7n) == a7 : U32}, +hp: {AR.perfect(U32, 5n, mT2) == True{} : Bool}) -> {ST.good(~V, ST.LS{cap, n, head, tail, free, mT2, k, sd, tabT, ksT, eT, lkT, sl, fl}) == True{} : Bool}:
  +g0 = L.subst(U32, z => {ST.goodF(~V, cap, n, head, tail, free, z, a1, a2, a6, a7, True{}, k, sd, tabT, AR.slots(String, ksT), AR.perfect(String, sd, ksT), eT, lkT, sl, fl) == True{} : Bool}, a0, W32.nth0(AR.slots(U32, mT2), 0n), Equal.sym(U32, W32.nth0(AR.slots(U32, mT2), 0n), a0, e0), hg)
  +g1 = L.subst(U32, z => {ST.goodF(~V, cap, n, head, tail, free, W32.nth0(AR.slots(U32, mT2), 0n), z, a2, a6, a7, True{}, k, sd, tabT, AR.slots(String, ksT), AR.perfect(String, sd, ksT), eT, lkT, sl, fl) == True{} : Bool}, a1, W32.nth0(AR.slots(U32, mT2), 1n), Equal.sym(U32, W32.nth0(AR.slots(U32, mT2), 1n), a1, e1), g0)
  +g2 = L.subst(U32, z => {ST.goodF(~V, cap, n, head, tail, free, W32.nth0(AR.slots(U32, mT2), 0n), W32.nth0(AR.slots(U32, mT2), 1n), z, a6, a7, True{}, k, sd, tabT, AR.slots(String, ksT), AR.perfect(String, sd, ksT), eT, lkT, sl, fl) == True{} : Bool}, a2, W32.nth0(AR.slots(U32, mT2), 2n), Equal.sym(U32, W32.nth0(AR.slots(U32, mT2), 2n), a2, e2), g1)
  +g6 = L.subst(U32, z => {ST.goodF(~V, cap, n, head, tail, free, W32.nth0(AR.slots(U32, mT2), 0n), W32.nth0(AR.slots(U32, mT2), 1n), W32.nth0(AR.slots(U32, mT2), 2n), z, a7, True{}, k, sd, tabT, AR.slots(String, ksT), AR.perfect(String, sd, ksT), eT, lkT, sl, fl) == True{} : Bool}, a6, W32.nth0(AR.slots(U32, mT2), 6n), Equal.sym(U32, W32.nth0(AR.slots(U32, mT2), 6n), a6, e6), g2)
  +g7 = L.subst(U32, z => {ST.goodF(~V, cap, n, head, tail, free, W32.nth0(AR.slots(U32, mT2), 0n), W32.nth0(AR.slots(U32, mT2), 1n), W32.nth0(AR.slots(U32, mT2), 2n), W32.nth0(AR.slots(U32, mT2), 6n), z, True{}, k, sd, tabT, AR.slots(String, ksT), AR.perfect(String, sd, ksT), eT, lkT, sl, fl) == True{} : Bool}, a7, W32.nth0(AR.slots(U32, mT2), 7n), Equal.sym(U32, W32.nth0(AR.slots(U32, mT2), 7n), a7, e7), g6)
  L.subst(Bool, z => {ST.goodF(~V, cap, n, head, tail, free, W32.nth0(AR.slots(U32, mT2), 0n), W32.nth0(AR.slots(U32, mT2), 1n), W32.nth0(AR.slots(U32, mT2), 2n), W32.nth0(AR.slots(U32, mT2), 6n), W32.nth0(AR.slots(U32, mT2), 7n), z, k, sd, tabT, AR.slots(String, ksT), AR.perfect(String, sd, ksT), eT, lkT, sl, fl) == True{} : Bool}, True{}, AR.perfect(U32, 5n, mT2), Equal.sym(Bool, AR.perfect(U32, 5n, mT2), True{}, hp), g7)


# a meta word other than 6 and 7 is kept
def oth2(+mT: AR.Tree<U32>, +k: Nat, +hs1: {AR.slots(U32, AR.upd(U32, 5n, mT, 6n, U32.inc(U32.shl(CY.msk(k))))) == SC.update(U32, AR.slots(U32, mT), 6n, U32.inc(U32.shl(CY.msk(k)))) : List<&2, U32>}, +hs2: {AR.slots(U32, AR.upd(U32, 5n, AR.upd(U32, 5n, mT, 6n, U32.inc(U32.shl(CY.msk(k)))), 7n, U32.inc(W32.nth0(AR.slots(U32, mT), 7n)))) == SC.update(U32, AR.slots(U32, AR.upd(U32, 5n, mT, 6n, U32.inc(U32.shl(CY.msk(k))))), 7n, U32.inc(W32.nth0(AR.slots(U32, mT), 7n))) : List<&2, U32>}, +j: Nat, +n6: {Nat.is_eq(6n, j) == False{} : Bool}, +n7: {Nat.is_eq(7n, j) == False{} : Bool}) -> {W32.nth0(AR.slots(U32, AR.upd(U32, 5n, AR.upd(U32, 5n, mT, 6n, U32.inc(U32.shl(CY.msk(k)))), 7n, U32.inc(W32.nth0(AR.slots(U32, mT), 7n)))), j) == W32.nth0(AR.slots(U32, mT), j) : U32}:
  Equal.trans(U32, W32.nth0(AR.slots(U32, AR.upd(U32, 5n, AR.upd(U32, 5n, mT, 6n, U32.inc(U32.shl(CY.msk(k)))), 7n, U32.inc(W32.nth0(AR.slots(U32, mT), 7n)))), j), W32.nth0(AR.slots(U32, AR.upd(U32, 5n, mT, 6n, U32.inc(U32.shl(CY.msk(k))))), j), W32.nth0(AR.slots(U32, mT), j), MT.nth_other(AR.upd(U32, 5n, mT, 6n, U32.inc(U32.shl(CY.msk(k)))), 7n, U32.inc(W32.nth0(AR.slots(U32, mT), 7n)), AR.upd(U32, 5n, AR.upd(U32, 5n, mT, 6n, U32.inc(U32.shl(CY.msk(k)))), 7n, U32.inc(W32.nth0(AR.slots(U32, mT), 7n))), hs2, j, n7), MT.nth_other(mT, 6n, U32.inc(U32.shl(CY.msk(k))), AR.upd(U32, 5n, mT, 6n, U32.inc(U32.shl(CY.msk(k)))), hs1, j, n6))


# the model reads meta words 3, 4, 5 and 16 .. 25 only
