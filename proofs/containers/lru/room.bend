# the state can take one more entry within 2^29 buckets
def capok(~V: Data, sh: ST.Sh<V>, +cz: Nat) -> Bool:
  match sh:
    case ST.LS{+cap, +n, +head, +tail, +free, +mT, +k, +sd, +tabT, +ksT, +eT, +lkT, +sl, +fl}:
      Nat.is_le(Nat.double(1n+UD.v(n)), SC.pow2(cz))

# THEOREM: room keeps the model and the invariant and leaves room for one more
def room_ok(~V: Data, +one: Nat, +h1: {one == 1n : Nat}, +sh: ST.Sh<V>, +hg: {ST.good(~V, sh) == True{} : Bool}, +cz: Nat, +hcz: {cz == 29n : Nat}, +hcap: {capok(~V, sh, cz) == True{} : Bool}) -> RoomOK(~V, sh, LR.room(&2, V, ST.real(~V, sh))):
  match sh:
    case ST.LS{cap, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, sl, fl}:
      room_f(~V, cap, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, sl, fl, hg, one, h1, cz, hcz, hcap)
