  +hk30 = L.and_left(Nat.is_lt(k, 30n), Nat.is_lt(0n, k), ST.g_ck(~V, cap, n, head, tail, free, W32.nth0(AR.slots(U32, mT), 0n), W32.nth0(AR.slots(U32, mT), 1n), W32.nth0(AR.slots(U32, mT), 2n), W32.nth0(AR.slots(U32, mT), 6n), W32.nth0(AR.slots(U32, mT), 7n), AR.perfect(U32, 5n, mT), k, sd, tabT, AR.slots(String, ksT), AR.perfect(String, sd, ksT), eT, lkT, sl, fl, hg))
  +hk5 = L.subst(Nat, z => {Nat.is_lt(1n+z, SC.pow2(5n)) == True{} : Bool}, k, UD.v(W32.nth0(AR.slots(U32, mT), 7n)), Equal.sym(Nat, UD.v(W32.nth0(AR.slots(U32, mT), 7n)), k, ek), N.lt_trans(1n+k, 31n, 32n, hk30, {==}))
  +hk5b = L.subst(Nat, z => {Nat.is_lt(z, SC.pow2(5n)) == True{} : Bool}, k, UD.v(W32.nth0(AR.slots(U32, mT), 7n)), Equal.sym(Nat, UD.v(W32.nth0(AR.slots(U32, mT), 7n)), k, ek), N.lt_trans(k, 30n, 32n, hk30, {==}))
  +ei1 = W32.inc_val(one, h1, W32.nth0(AR.slots(U32, mT), 7n), W32.bound32(one, h1, UD.v(W32.nth0(AR.slots(U32, mT), 7n)), 5n, {==}, hk5b))
  +hi1 = L.subst(Nat, z => {Nat.is_lt(z, SC.pow2(5n)) == True{} : Bool}, 1n+UD.v(W32.nth0(AR.slots(U32, mT), 7n)), UD.v(U32.inc(W32.nth0(AR.slots(U32, mT), 7n))), Equal.sym(Nat, UD.v(U32.inc(W32.nth0(AR.slots(U32, mT), 7n))), 1n+UD.v(W32.nth0(AR.slots(U32, mT), 7n)), ei1), hk5)
