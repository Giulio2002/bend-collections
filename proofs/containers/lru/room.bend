  +ec = BA.ctr_eq(AR.slots(U32, AR.upd(U32, 5n, AR.upd(U32, 5n, mT, 6n, U32.inc(U32.shl(CY.msk(k)))), 7n, U32.inc(W32.nth0(AR.slots(U32, mT), 7n)))), AR.slots(U32, mT), oth2(mT, k, hs1, hs2, 16n, {==}, {==}), oth2(mT, k, hs1, hs2, 17n, {==}, {==}), oth2(mT, k, hs1, hs2, 18n, {==}, {==}), oth2(mT, k, hs1, hs2, 19n, {==}, {==}), oth2(mT, k, hs1, hs2, 20n, {==}, {==}), oth2(mT, k, hs1, hs2, 21n, {==}, {==}), oth2(mT, k, hs1, hs2, 22n, {==}, {==}), oth2(mT, k, hs1, hs2, 23n, {==}, {==}), oth2(mT, k, hs1, hs2, 24n, {==}, {==}), oth2(mT, k, hs1, hs2, 25n, {==}, {==}))
