import ../../lib/u32.bend as U
import ./evict.bend as EV
import ../../lib/words32.bend as W32

# resize: evicting the oldest until the cache fits.

%include read.src

%def RR Result<&2, &2, String, U32>

def RzOK(~V: Data, spec: SP.Lru<V> & U32, r: LR.LRU<&2, V> & $RR) -> Type:
  Sigma<&1, &1, ST.Sh<V>, sh2 => Sigma<&1, &1, U32, e => {r == (ST.real(~V, sh2), Done{e}) : LR.LRU<&2, V> & $RR} & ({spec == (ST.model(~V, sh2), e) : SP.Lru<V> & U32} & {ST.good(~V, sh2) == True{} : Bool})>>

%def RZ(f, s, ev) LR.rz_go(&2, V, f, LR.rz_check(&2, V, ST.real(~V, s)), ev)
%def SK(f, s, ev) SP.shrink(~V, f, ST.model(~V, s), ev)
%def REC(p, ev) @sh1: ST.Sh<V> -> @g1: {ST.good(~V, sh1) == True{} : Bool} -> RzOK(~V, $SK(p, sh1, U32.inc(ev)), $RZ(p, sh1, U32.inc(ev)))

# the count is the model's length
def n_len(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}) -> {U32.from_nat(SP.length(~V, $ES)) == n : U32}:
  +hk = L.and_left(Nat.is_lt(k, 30n), Nat.is_lt(0n, k), $G(ck))
  Equal.trans(U32, U32.from_nat(SP.length(~V, $ES)), U32.from_nat(UD.v(n)), n, Equal.cong(Nat, U32, z => U32.from_nat(z), SP.length(~V, $ES), UD.v(n), BA.len_model(~V, $SHA, hg)), PI.from_v(n, k, N.lt_le(k, 32n, N.lt_trans(k, 30n, 32n, hk, {==})), BA.n_lt(~V, $SHA, hg)))

def rz0(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, +ev: U32, +b: Bool) -> RzOK(~V, $SK(0n, $SH, ev), LR.rz_go(&2, V, 0n, LR.rz_pick(&2, V, $F, b), ev)):
  match b:
    case True{}:
      ($SH, (ev, ({==}, ({==}, hg))))
    case False{}:
      ($SH, (ev, ({==}, ({==}, hg))))

def rz_ev(~V: Data, +p: Nat, +ev: U32, +sh: ST.Sh<V>, +spec: SP.Lru<V>, -r: LR.LRU<&2, V>, co: BS.CountOK(~V, spec, r), rec: $REC(p, ev)) -> RzOK(~V, SP.shrink(~V, p, spec, U32.inc(ev)), LR.rz_go(&2, V, p, LR.rz_check(&2, V, r), U32.inc(ev))):
  match co:
    case Tuple{+sh1, Tuple{+e1, Tuple{+em1, g1}}}:
      ok = rec(sh1, g1)
      ok2 = L.subst(SP.Lru<V>, z => RzOK(~V, SP.shrink(~V, p, z, U32.inc(ev)), $RZ(p, sh1, U32.inc(ev))), ST.model(~V, sh1), spec, em1, ok)
      L.subst(LR.LRU<&2, V>, z => RzOK(~V, SP.shrink(~V, p, spec, U32.inc(ev)), LR.rz_go(&2, V, p, LR.rz_check(&2, V, z), U32.inc(ev))), ST.real(~V, sh1), r, Equal.sym(LR.LRU<&2, V>, r, ST.real(~V, sh1), e1), ok2)

%def SPT SP.L{cap, $M3, $W4, SP.tail(~V, $ES), SP.c_ev($CTR)}

def lt0(+x: U32) -> {U32.is_lt(x, 0) == False{} : Bool}:
  Equal.trans(Bool, U32.is_lt(x, 0), Nat.is_lt(UD.v(x), 0n), False{}, U.is_lt_nat(x, 0), N.not_lt_zero(UD.v(x)))

def rz_sl(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +p: Nat, +ev: U32, +hb: {U32.is_lt(cap, n) == True{} : Bool}, rec: $REC(p, ev)) -> RzOK(~V, SP.shrink(~V, p, $SPT, U32.inc(ev)), LR.rz_go(&2, V, p, LR.rz_check(&2, V, LR.evict_oldest(&2, V, $F)), U32.inc(ev))):
  match sl:
    case Nil{}:
      +en = Equal.trans(U32, n, U32.from_nat(0n), 0, Equal.sym(U32, U32.from_nat(0n), n, n_len(~V, cap, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, Nil{}, fl, hg)), {==})
      Empty.absurd(RzOK(~V, SP.shrink(~V, p, SP.L{cap, $M3, $W4, SP.tail(~V, ST.es(~V, $LLo, $KL, $EL, Nil{})), SP.c_ev($CTR)}, U32.inc(ev)), LR.rz_go(&2, V, p, LR.rz_check(&2, V, LR.evict_oldest(&2, V, ST.real(~V, ST.LS{cap, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, Nil{}, fl}))), U32.inc(ev))), L.true_false(Equal.trans(Bool, True{}, U32.is_lt(cap, n), False{}, Equal.sym(Bool, U32.is_lt(cap, n), True{}, hb), L.subst(U32, z => {U32.is_lt(cap, z) == False{} : Bool}, 0, n, Equal.sym(U32, n, 0, en), lt0(cap)))))
    case Con{+s0, +t}:
      rz_ev(~V, p, ev, ST.LS{cap, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, Con{s0, t}, fl}, SP.L{cap, $M3, $W4, SP.tail(~V, ST.es(~V, $LLo, $KL, $EL, Con{s0, t})), SP.c_ev($CTR)}, LR.evict_oldest(&2, V, ST.real(~V, ST.LS{cap, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, Con{s0, t}, fl})), EV.old_ev(~V, cap, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, s0, t, fl, hg, one, h1), rec)

def rz1(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +p: Nat, +ev: U32, +b: Bool, +hb: {U32.is_lt(cap, n) == b : Bool}, rec: $REC(p, ev)) -> RzOK(~V, Bool.pick(SP.Lru<V> & U32, b, SP.shrink(~V, p, $SPT, U32.inc(ev)), (SP.L{cap, $M3, $W4, $ES, $CTR}, ev)), LR.rz_go(&2, V, 1n+p, LR.rz_pick(&2, V, $F, b), ev)):
  match b:
    case True{}:
      rz_sl(~V, $SHA, hg, one, h1, p, ev, hb, rec)
    case False{}:
      ($SH, (ev, ({==}, ({==}, hg))))

def rz_f(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +p: Nat, +ev: U32, rec: $REC(p, ev)) -> RzOK(~V, $SK(1n+p, $SH, ev), $RZ(1n+p, $SH, ev)):
  +en = n_len(~V, $SHA, hg)
  ok = rz1(~V, $SHA, hg, one, h1, p, ev, U32.is_lt(cap, n), {==}, rec)
  L.subst(U32, z => RzOK(~V, Bool.pick(SP.Lru<V> & U32, U32.is_lt(cap, z), SP.shrink(~V, p, $SPT, U32.inc(ev)), (SP.L{cap, $M3, $W4, $ES, $CTR}, ev)), $RZ(1n+p, $SH, ev)), n, U32.from_nat(SP.length(~V, $ES)), Equal.sym(U32, U32.from_nat(SP.length(~V, $ES)), n, en), ok)

# THEOREM: the eviction loop is the specification's shrink
def rz_ok(~V: Data, +one: Nat, +h1: {one == 1n : Nat}, +f: Nat, +sh: ST.Sh<V>, +hg: {ST.good(~V, sh) == True{} : Bool}, +ev: U32) -> RzOK(~V, $SK(f, sh, ev), $RZ(f, sh, ev)):
  match f sh:
    case 0n ST.LS{$SHA}:
      rz0(~V, $SHA, hg, ev, U32.is_lt(cap, n))
    case 1n+p ST.LS{$SHA}:
      rz_f(~V, $SHA, hg, one, h1, p, ev, sh1 => g1 => rz_ok(~V, one, h1, p, sh1, g1, U32.inc(ev)))

%def GB2 cap2, n, head, tail, free, W32.nth0($ML, 0n), W32.nth0($ML, 1n), W32.nth0($ML, 2n), W32.nth0($ML, 6n), W32.nth0($ML, 7n), AR.perfect(U32, 5n, mT), k, sd, tabT, $KL, AR.perfect(String, sd, ksT), eT, lkT, sl, fl
%def SHC ST.LS{cap2, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, sl, fl}

# a new positive capacity keeps the invariant
def good_cap(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, +cap2: U32, +hz: {U32.is_eq(cap2, 0) == False{} : Bool}) -> {ST.good(~V, $SHC) == True{} : Bool}:
  ST.good_intro(~V, $GB2, $G(ck), $G(csdk), $G(cpt), $G(cpk), $G(cpe), $G(cpl), $G(cpm), $G(cmask), $G(cbits), $G(csize), $G(cdepth), $G(cfresh), $G(cwell), $G(cclus), $G(cuniq), $G(cn), $G(cload), Equal.cong(Bool, Bool, b => Bool.not(b), U32.is_eq(cap2, 0), False{}, hz), $G(cbsl), $G(chas), $G(csl), $G(cnd), $G(clen), $G(chead), $G(ctail), $G(cdll), $G(ckeys), $G(cfree), $G(cfll), $G(cfl), $G(cfnd), $G(cfcnt))

def rs_fin(~V: Data, spec: SP.Lru<V> & U32, -r: LR.LRU<&2, V> & $RR, ok: RzOK(~V, spec, r)) -> RM.POK(~V, $RR, SP.rs_done(~V, spec), r):
  match ok:
    case Tuple{+sh2, Tuple{+e, Tuple{+er, Tuple{+es, g}}}}:
      (sh2, (Done{e}, (er, (Equal.cong(SP.Lru<V> & U32, SP.Lru<V> & $RR, z => SP.rs_done(~V, z), spec, (ST.model(~V, sh2), e), es), g))))

def rs_c(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +cap2: U32, +z: Bool, +hz: {U32.is_eq(cap2, 0) == z : Bool}) -> RM.POK(~V, $RR, SP.resize_c(~V, cap, $M3, $W4, $ES, $CTR, cap2, z), LR.resize_go(&2, V, $F, cap2, z)):
  match z:
    case True{}:
      ($SH, (Fail{"capacity must be positive"}, ({==}, ({==}, hg))))
    case False{}:
      +g2 = good_cap(~V, $SHA, hg, cap2, hz)
      ok = rz_ok(~V, one, h1, U32.to_nat(n), $SHC, g2, 0)
      +el = Equal.trans(Nat, U32.to_nat(n), UD.v(n), SP.length(~V, $ES), {==}, Equal.sym(Nat, SP.length(~V, $ES), UD.v(n), BA.len_model(~V, $SHA, hg)))
      ok2 = L.subst(Nat, f => RzOK(~V, $SK(f, $SHC, 0), $RZ(U32.to_nat(n), $SHC, 0)), U32.to_nat(n), SP.length(~V, $ES), el, ok)
      rs_fin(~V, $SK(SP.length(~V, $ES), $SHC, 0), $RZ(U32.to_nat(n), $SHC, 0), ok2)

# THEOREM (resize): the specification's resize
def resize_ok(~V: Data, +one: Nat, +h1: {one == 1n : Nat}, +sh: ST.Sh<V>, +hg: {ST.good(~V, sh) == True{} : Bool}, +cap2: U32) -> RM.POK(~V, $RR, SP.resize(~V, ST.model(~V, sh), cap2), LR.resize(&2, V, ST.real(~V, sh), cap2)):
  match sh:
    case ST.LS{$SHA}:
      rs_c(~V, $SHA, hg, one, h1, cap2, U32.is_eq(cap2, 0), {==})
