def rs_fin(~V: Data, spec: SP.Lru<V> & U32, -r: LR.LRU<&2, V> & Result<&2, &2, String, U32>, ok: RzOK(~V, spec, r)) -> RM.POK(~V, Result<&2, &2, String, U32>, SP.rs_done(~V, spec), r):
  match ok:
    case Tuple{+sh2, Tuple{+e, Tuple{+er, Tuple{+es, g}}}}:
      (sh2, (Done{e}, (er, (Equal.cong(SP.Lru<V> & U32, SP.Lru<V> & Result<&2, &2, String, U32>, z => SP.rs_done(~V, z), spec, (ST.model(~V, sh2), e), es), g))))

def rs_c(~V: Data, +cap: U32, +n: U32, +head: U32, +tail: U32, +free: U32, +mT: AR.Tree<U32>, +k: Nat, +sd: Nat, +tabT: AR.Tree<U32>, +ksT: AR.Tree<String>, +eT: AR.Tree<Maybe<&2, V>>, +lkT: AR.Tree<U32>, +sl: List<&2, Nat>, +fl: List<&2, Nat>, +hg: {ST.good(~V, ST.LS{cap, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, sl, fl}) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +cap2: U32, +z: Bool, +hz: {U32.is_eq(cap2, 0) == z : Bool}) -> RM.POK(~V, Result<&2, &2, String, U32>, SP.resize_c(~V, cap, W32.nth0(AR.slots(U32, mT), 3n), ST.w64(AR.slots(U32, mT), 4n), ST.es(~V, AR.slots(U32, lkT), AR.slots(String, ksT), AR.slots(Maybe<&2, V>, eT), sl), ST.ctr(AR.slots(U32, mT)), cap2, z), LR.resize_go(&2, V, ST.real(~V, ST.LS{cap, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, sl, fl}), cap2, z)):
  match z:
    case True{}:
      (ST.LS{cap, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, sl, fl}, (Fail{"capacity must be positive"}, ({==}, ({==}, hg))))
    case False{}:
      +g2 = good_cap(~V, cap, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, sl, fl, hg, cap2, hz)
      ok = rz_ok(~V, one, h1, U32.to_nat(n), ST.LS{cap2, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, sl, fl}, g2, 0)
      +el = Equal.trans(Nat, U32.to_nat(n), UD.v(n), SP.length(~V, ST.es(~V, AR.slots(U32, lkT), AR.slots(String, ksT), AR.slots(Maybe<&2, V>, eT), sl)), {==}, Equal.sym(Nat, SP.length(~V, ST.es(~V, AR.slots(U32, lkT), AR.slots(String, ksT), AR.slots(Maybe<&2, V>, eT), sl)), UD.v(n), BA.len_model(~V, cap, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, sl, fl, hg)))
      ok2 = L.subst(Nat, f => RzOK(~V, SP.shrink(~V, f, ST.model(~V, ST.LS{cap2, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, sl, fl}), 0), LR.rz_go(&2, V, U32.to_nat(n), LR.rz_check(&2, V, ST.real(~V, ST.LS{cap2, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, sl, fl})), 0)), U32.to_nat(n), SP.length(~V, ST.es(~V, AR.slots(U32, lkT), AR.slots(String, ksT), AR.slots(Maybe<&2, V>, eT), sl)), el, ok)
      rs_fin(~V, SP.shrink(~V, SP.length(~V, ST.es(~V, AR.slots(U32, lkT), AR.slots(String, ksT), AR.slots(Maybe<&2, V>, eT), sl)), ST.model(~V, ST.LS{cap2, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, sl, fl}), 0), LR.rz_go(&2, V, U32.to_nat(n), LR.rz_check(&2, V, ST.real(~V, ST.LS{cap2, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, sl, fl})), 0), ok2)

# THEOREM (resize): the specification's resize
def resize_ok(~V: Data, +one: Nat, +h1: {one == 1n : Nat}, +sh: ST.Sh<V>, +hg: {ST.good(~V, sh) == True{} : Bool}, +cap2: U32) -> RM.POK(~V, Result<&2, &2, String, U32>, SP.resize(~V, ST.model(~V, sh), cap2), LR.resize(&2, V, ST.real(~V, sh), cap2)):
  match sh:
    case ST.LS{cap, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, sl, fl}:
      rs_c(~V, cap, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, sl, fl, hg, one, h1, cap2, U32.is_eq(cap2, 0), {==})
