# add, first step: room keeps the table at most half full for one more entry,
# doubling it when needed (a rehash); the model is unchanged.

%include read.src

# the state is roomy: one more entry keeps the table at most half full
def roomy(~V: Data, sh: ST.Sh<V>) -> Bool:
  match sh:
    case ST.LS{+cap, +n, +head, +tail, +free, +mT, +k, +sd, +tabT, +ksT, +eT, +lkT, +sl, +fl}:
      Nat.is_le(Nat.double(1n+UD.v(n)), SC.pow2(k))

def RoomOK(~V: Data, +sh: ST.Sh<V>, r: LR.LRU<&2, V>) -> Type:
  Sigma<&1, &1, ST.Sh<V>, sh2 => {r == ST.real(~V, sh2) : LR.LRU<&2, V>} & ({ST.model(~V, sh2) == ST.model(~V, sh) : SP.Lru<V>} & ({ST.good(~V, sh2) == True{} : Bool} & {roomy(~V, sh2) == True{} : Bool}))>

def mk_room(~V: Data, +sh: ST.Sh<V>, -r: LR.LRU<&2, V>, +sh2: ST.Sh<V>, +e: {r == ST.real(~V, sh2) : LR.LRU<&2, V>}, +em: {ST.model(~V, sh2) == ST.model(~V, sh) : SP.Lru<V>}, +g: {ST.good(~V, sh2) == True{} : Bool}, +h: {roomy(~V, sh2) == True{} : Bool}) -> RoomOK(~V, sh, r):
  (sh2, (e, (em, (g, h))))

%def GP(a0, a1, a2, a6, a7, p) cap, n, head, tail, free, a0, a1, a2, a6, a7, p, k, sd, tabT, AR.slots(String, ksT), AR.perfect(String, sd, ksT), eT, lkT, sl, fl
%def GF(a0, a1, a2, a6, a7, p) {ST.goodF(~V, $GP(a0, a1, a2, a6, a7, p)) == True{} : Bool}
%def N2(i) W32.nth0(AR.slots(U32, mT2), i)

# the invariant from its components with the meta words named
def good_mk(~V: Data, +cap: U32, +n: U32, +head: U32, +tail: U32, +free: U32, +mT2: AR.Tree<U32>, +a0: U32, +a1: U32, +a2: U32, +a6: U32, +a7: U32, +k: Nat, +sd: Nat, +tabT: AR.Tree<U32>, +ksT: AR.Tree<String>, +eT: AR.Tree<Maybe<&2, V>>, +lkT: AR.Tree<U32>, +sl: List<&2, Nat>, +fl: List<&2, Nat>, +hg: $GF(a0, a1, a2, a6, a7, True{}), +e0: {$N2(0n) == a0 : U32}, +e1: {$N2(1n) == a1 : U32}, +e2: {$N2(2n) == a2 : U32}, +e6: {$N2(6n) == a6 : U32}, +e7: {$N2(7n) == a7 : U32}, +hp: {AR.perfect(U32, 5n, mT2) == True{} : Bool}) -> {ST.good(~V, ST.LS{cap, n, head, tail, free, mT2, k, sd, tabT, ksT, eT, lkT, sl, fl}) == True{} : Bool}:
  +g0 = L.subst(U32, z => $GF(z, a1, a2, a6, a7, True{}), a0, $N2(0n), Equal.sym(U32, $N2(0n), a0, e0), hg)
  +g1 = L.subst(U32, z => $GF($N2(0n), z, a2, a6, a7, True{}), a1, $N2(1n), Equal.sym(U32, $N2(1n), a1, e1), g0)
  +g2 = L.subst(U32, z => $GF($N2(0n), $N2(1n), z, a6, a7, True{}), a2, $N2(2n), Equal.sym(U32, $N2(2n), a2, e2), g1)
  +g6 = L.subst(U32, z => $GF($N2(0n), $N2(1n), $N2(2n), z, a7, True{}), a6, $N2(6n), Equal.sym(U32, $N2(6n), a6, e6), g2)
  +g7 = L.subst(U32, z => $GF($N2(0n), $N2(1n), $N2(2n), $N2(6n), z, True{}), a7, $N2(7n), Equal.sym(U32, $N2(7n), a7, e7), g6)
  L.subst(Bool, z => $GF($N2(0n), $N2(1n), $N2(2n), $N2(6n), $N2(7n), z), True{}, AR.perfect(U32, 5n, mT2), Equal.sym(Bool, AR.perfect(U32, 5n, mT2), True{}, hp), g7)

%def NM U32.inc(U32.shl(CY.msk(k)))
%def M7 W32.nth0($ML, 7n)
%def MA AR.upd(U32, 5n, mT, 6n, $NM)
%def MB AR.upd(U32, 5n, $MA, 7n, U32.inc($M7))
%def MLB AR.slots(U32, $MB)
%def SHB ST.LS{cap, n, head, tail, free, $MB, 1n+k, sd, T2, ksT, eT, lkT, sl, fl}
%def BS2 TB.buckets(AR.slots(U32, T2), $KL, SC.pow2(1n+k))
%def GAX cap, n, head, tail, free, W32.nth0($ML, 0n), W32.nth0($ML, 1n), W32.nth0($ML, 2n), CY.msk(1n+k), U32.inc($M7), True{}, 1n+k, sd, T2, $KL, AR.perfect(String, sd, ksT), eT, lkT, sl, fl
%def HS1 {AR.slots(U32, $MA) == SC.update(U32, $ML, 6n, $NM) : List<&2, U32>}
%def HS2 {$MLB == SC.update(U32, AR.slots(U32, $MA), 7n, U32.inc($M7)) : List<&2, U32>}

# a meta word other than 6 and 7 is kept
def oth2(+mT: AR.Tree<U32>, +k: Nat, +hs1: $HS1, +hs2: $HS2, +j: Nat, +n6: {Nat.is_eq(6n, j) == False{} : Bool}, +n7: {Nat.is_eq(7n, j) == False{} : Bool}) -> {W32.nth0($MLB, j) == W32.nth0($ML, j) : U32}:
  Equal.trans(U32, W32.nth0($MLB, j), W32.nth0(AR.slots(U32, $MA), j), W32.nth0($ML, j), MT.nth_other($MA, 7n, U32.inc($M7), $MB, hs2, j, n7), MT.nth_other(mT, 6n, $NM, $MA, hs1, j, n6))

%def O2(j) oth2(mT, k, hs1, hs2, j, {==}, {==})
%def O2S(j) Equal.sym(U32, W32.nth0($MLB, j), W32.nth0($ML, j), $O2(j))

# the model reads meta words 3, 4, 5 and 16 .. 25 only
def model_m(~V: Data, $SHF, +T2: AR.Tree<U32>, +hs1: $HS1, +hs2: $HS2) -> {ST.model(~V, $SHB) == ST.model(~V, $SH) : SP.Lru<V>}:
  +ec = BA.ctr_eq($MLB, $ML, $O2(16n), $O2(17n), $O2(18n), $O2(19n), $O2(20n), $O2(21n), $O2(22n), $O2(23n), $O2(24n), $O2(25n))
  BA.lru_eq(~V, cap, W32.nth0($MLB, 3n), $M3, ST.w64($MLB, 4n), $W4, $ES, $ES, ST.ctr($MLB), $CTR, $O2(3n), BA.w64_eq($MLB, $ML, 4n, $O2(4n), $O2(5n)), {==}, ec)

%def TG H.mv_fin(H.mv_go(U32.to_nat(U32.inc(CY.msk(k))), 0, $NM, H.MV{AR.thaw(U32, tabT), Array.new(U32, U32.to_nat(U32.add($M7, 2)), 0)}))

# the grown table: the implementation's size word is the hash map's
def tg_eq(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}) -> {$TG == H.grow_tab(CY.msk(k), U32.inc($M7), AR.thaw(U32, tabT)) : Array<U32>}:
  +ek = N.eq_from_is_eq(UD.v($M7), k, $G(cbits))
  +hk30 = L.and_left(Nat.is_lt(k, 30n), Nat.is_lt(0n, k), $G(ck))
  +hk5 = L.subst(Nat, z => {Nat.is_lt(1n+z, SC.pow2(5n)) == True{} : Bool}, k, UD.v($M7), Equal.sym(Nat, UD.v($M7), k, ek), N.lt_trans(1n+k, 31n, 32n, hk30, {==}))
  +hk5b = L.subst(Nat, z => {Nat.is_lt(z, SC.pow2(5n)) == True{} : Bool}, k, UD.v($M7), Equal.sym(Nat, UD.v($M7), k, ek), N.lt_trans(k, 30n, 32n, hk30, {==}))
  +ei1 = W32.inc_val(one, h1, $M7, W32.bound32(one, h1, UD.v($M7), 5n, {==}, hk5b))
  +hi1 = L.subst(Nat, z => {Nat.is_lt(z, SC.pow2(5n)) == True{} : Bool}, 1n+UD.v($M7), UD.v(U32.inc($M7)), Equal.sym(Nat, UD.v(U32.inc($M7)), 1n+UD.v($M7), ei1), hk5)
  +ei2 = W32.inc_val(one, h1, U32.inc($M7), W32.bound32(one, h1, UD.v(U32.inc($M7)), 5n, {==}, hi1))
  +ea0 = Equal.trans(Nat, Nat.add(UD.v($M7), 2n), 1n+Nat.add(UD.v($M7), 1n), 2n+UD.v($M7), N.add_succ(UD.v($M7), 1n), Equal.cong(Nat, Nat, z => 1n+z, Nat.add(UD.v($M7), 1n), 1n+UD.v($M7), Equal.trans(Nat, Nat.add(UD.v($M7), 1n), 1n+Nat.add(UD.v($M7), 0n), 1n+UD.v($M7), N.add_succ(UD.v($M7), 0n), Equal.cong(Nat, Nat, z => 1n+z, Nat.add(UD.v($M7), 0n), UD.v($M7), N.add_zero(UD.v($M7))))))
  +hb2 = L.subst(Nat, z => {Nat.is_lt(z, WD.sc(32n, one)) == True{} : Bool}, 1n+UD.v(U32.inc($M7)), Nat.add(UD.v($M7), 2n), Equal.trans(Nat, 1n+UD.v(U32.inc($M7)), 2n+UD.v($M7), Nat.add(UD.v($M7), 2n), Equal.cong(Nat, Nat, z => 1n+z, UD.v(U32.inc($M7)), 1n+UD.v($M7), ei1), Equal.sym(Nat, Nat.add(UD.v($M7), 2n), 2n+UD.v($M7), ea0)), W32.bound32(one, h1, UD.v(U32.inc($M7)), 5n, {==}, hi1))
  +ea = ID.add_val(one, h1, $M7, 2, hb2)
  +es = Equal.trans(Nat, UD.v(U32.add($M7, 2)), 2n+UD.v($M7), UD.v(U32.inc(U32.inc($M7))), Equal.trans(Nat, UD.v(U32.add($M7, 2)), Nat.add(UD.v($M7), 2n), 2n+UD.v($M7), ea, ea0), Equal.sym(Nat, UD.v(U32.inc(U32.inc($M7))), 2n+UD.v($M7), Equal.trans(Nat, UD.v(U32.inc(U32.inc($M7))), 1n+UD.v(U32.inc($M7)), 2n+UD.v($M7), ei2, Equal.cong(Nat, Nat, z => 1n+z, UD.v(U32.inc($M7)), 1n+UD.v($M7), ei1))))
  Equal.cong(Nat, Array<U32>, d => H.mv_fin(H.mv_go(U32.to_nat(U32.inc(CY.msk(k))), 0, $NM, H.MV{AR.thaw(U32, tabT), Array.new(U32, d, 0)})), UD.v(U32.add($M7, 2)), UD.v(U32.inc(U32.inc($M7))), es)

%def RFG(x) LR.room_fin(&2, V, cap, n, head, tail, free, AR.thaw(String, KT), AR.thaw(Maybe<&2, V>, ET), AR.thaw(U32, LT), x)
%def MVG H.mv_fin(H.mv_go(U32.to_nat(U32.inc(mask)), 0, U32.inc(U32.shl(mask)), H.MV{AR.thaw(U32, TT), Array.new(U32, U32.to_nat(U32.add(bits, 2)), 0)}))
%def SSG Array.set(U32, Array.set(U32, AR.thaw(U32, MT), 6, U32.inc(U32.shl(mask))), 7, U32.inc(bits))
%def AX AR.thaw(U32, XT)
%def AY AR.thaw(U32, YT)

# the grown state, for any mask (kept symbolic so nothing unfolds)
def gtb(~V: Data, +cap: U32, +n: U32, +head: U32, +tail: U32, +free: U32, +KT: AR.Tree<String>, +ET: AR.Tree<Maybe<&2, V>>, +LT: AR.Tree<U32>, +TT: AR.Tree<U32>, +mask: U32, +MT: AR.Tree<U32>, +bits: U32, +er: {Array.get(U32, AR.thaw(U32, MT), 7) == (AR.thaw(U32, MT), bits) : Array<U32> & U32}, +XT: AR.Tree<U32>, +YT: AR.Tree<U32>, +ex: {$SSG == $AX : Array<U32>}, +ey: {$MVG == $AY : Array<U32>}) -> {$RFG(LR.grow_tab(AR.thaw(U32, MT), AR.thaw(U32, TT), mask, True{})) == $RFG(($AX, $AY)) : LR.LRU<&2, V>}:
  +e1 = Equal.cong(Array<U32> & U32, LR.LRU<&2, V>, z => $RFG(LR.grow_tab_b(AR.thaw(U32, TT), mask, z)), Array.get(U32, AR.thaw(U32, MT), 7), (AR.thaw(U32, MT), bits), er)
  +e2 = Equal.cong(Array<U32>, LR.LRU<&2, V>, z => $RFG((z, $MVG)), $SSG, $AX, ex)
  +e3 = Equal.cong(Array<U32>, LR.LRU<&2, V>, z => $RFG(($AX, z)), $MVG, $AY, ey)
  Equal.trans(LR.LRU<&2, V>, $RFG(LR.grow_tab(AR.thaw(U32, MT), AR.thaw(U32, TT), mask, True{})), $RFG(($SSG, $MVG)), $RFG(($AX, $AY)), e1, Equal.trans(LR.LRU<&2, V>, $RFG(($SSG, $MVG)), $RFG(($AX, $MVG)), $RFG(($AX, $AY)), e2, e3))

%def RF(x) LR.room_fin(&2, V, cap, n, head, tail, free, AR.thaw(String, ksT), AR.thaw(Maybe<&2, V>, eT), AR.thaw(U32, lkT), x)
%def GT(b) LR.grow_tab(AR.thaw(U32, mT), AR.thaw(U32, tabT), CY.msk(k), b)
%def OV Nat.is_gt(Nat.double(1n+UD.v(n)), SC.pow2(k))
%def CAP {Nat.is_le(Nat.double(1n+UD.v(n)), SC.pow2(cz)) == True{} : Bool}
%def SS Array.set(U32, Array.set(U32, AR.thaw(U32, mT), 6, $NM), 7, U32.inc($M7))
%def PB($x, $y) LR.room_fin(&2, V, cap, n, head, tail, free, AR.thaw(String, ksT), AR.thaw(Maybe<&2, V>, eT), AR.thaw(U32, lkT), ($x, $y))

def rm_g3(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +cz: Nat, +hcz: {cz == 29n : Nat}, +hcap: $CAP, +hov: {$OV == True{} : Bool}, +htd: {UD.v(U32.inc($M7)) == 1n+k : Nat}, -r: LR.LRU<&2, V>, +T2: AR.Tree<U32>, +hr: {GR.rinv(tabT, $KL, k, sd, T2, $NN) == True{} : Bool}, +erl: {r == ST.real(~V, $SHB) : LR.LRU<&2, V>}) -> RoomOK(~V, $SH, r):
  +hk30 = L.and_left(Nat.is_lt(k, 30n), Nat.is_lt(0n, k), $G(ck))
  +hk31 = N.lt_trans(k, 30n, 31n, hk30, {==})
  +hk0 = L.and_right(Nat.is_lt(k, 30n), Nat.is_lt(0n, k), $G(ck))
  +pm = $G(cpm)
  +a1 = UT.uset_a(5n, {==}, mT, pm, 6, {==}, $NM)
  +p1 = UT.uset_p(5n, mT, pm, 6n, $NM)
  +hs1 = UT.uset_s(5n, mT, pm, 6n, {==}, $NM)
  +a2 = UT.uset_a(5n, {==}, $MA, p1, 7, {==}, U32.inc($M7))
  +p2 = UT.uset_p(5n, $MA, p1, 7n, U32.inc($M7))
  +hs2 = UT.uset_s(5n, $MA, p1, 7n, {==}, U32.inc($M7))
  +lt = N.not_le_lt(Nat.double(1n+UD.v(n)), SC.pow2(k), IU.gt_true_nle(Nat.double(1n+UD.v(n)), SC.pow2(k), hov))
  +hk29 = L.subst(Nat, z => {Nat.is_lt(k, z) == True{} : Bool}, cz, 29n, hcz, IG.pow2_lt_inv(k, cz, N.lt_le_trans(SC.pow2(k), Nat.double(1n+UD.v(n)), SC.pow2(cz), lt, hcap)))
  +hck = L.and_intro(Nat.is_lt(1n+k, 30n), Nat.is_lt(0n, 1n+k), hk29, {==})
  +hsdk = N.lt_trans(sd, k, 1n+k, $G(csdk), N.lt_succ(k))
  +hbits = L.subst(Nat, z => {Nat.is_eq(z, 1n+k) == True{} : Bool}, 1n+k, UD.v(U32.inc($M7)), Equal.sym(Nat, UD.v(U32.inc($M7)), 1n+k, htd), N.is_eq_refl(1n+k))
  +eo = Equal.trans(Nat, UD.v(n), IV.occn($BS, $NN), IV.occn($BS2, SC.pow2(1n+k)), N.eq_from_is_eq(UD.v(n), IV.occn($BS, $NN), $G(cn)), Equal.sym(Nat, IV.occn($BS2, SC.pow2(1n+k)), IV.occn($BS, $NN), N.eq_from_is_eq(IV.occn($BS2, SC.pow2(1n+k)), IV.occn($BS, $NN), GR.r_5(tabT, $KL, k, sd, T2, $NN, hr))))
  +hcn = L.subst(Nat, z => {Nat.is_eq(UD.v(n), z) == True{} : Bool}, UD.v(n), IV.occn($BS2, SC.pow2(1n+k)), eo, N.is_eq_refl(UD.v(n)))
  +hld2 = N.le_trans(Nat.double(UD.v(n)), SC.pow2(k), SC.pow2(1n+k), $G(cload), N.lt_le(SC.pow2(k), SC.pow2(1n+k), N.pow2_lt_succ(k)))
  +gx = ST.good_intro(~V, $GAX, hck, hsdk, GR.r_1(tabT, $KL, k, sd, T2, $NN, hr), $G(cpk), $G(cpe), $G(cpl), {==}, A.eq_refl(CY.msk(1n+k)), hbits, $G(csize), $G(cdepth), $G(cfresh), GR.r_3(tabT, $KL, k, sd, T2, $NN, hr), GR.r_2(tabT, $KL, k, sd, T2, $NN, hr), GR.r_4(tabT, $KL, k, sd, T2, $NN, hr), hcn, hld2, $G(ccap), TS.bsl_from($BS2, $BS, $NN, SC.pow2(1n+k), GR.r_6(tabT, $KL, k, sd, T2, $NN, hr), sl, $LLo, $G(cbsl)), TS.has_to(~V, $BS, $BS2, $NN, SC.pow2(1n+k), GR.r_7(tabT, $KL, k, sd, T2, $NN, hr), $LLo, sl, $G(chas)), $G(csl), $G(cnd), $G(clen), $G(chead), $G(ctail), $G(cdll), $G(ckeys), $G(cfree), $G(cfll), $G(cfl), $G(cfnd), $G(cfcnt))
  +e6 = Equal.trans(U32, W32.nth0($MLB, 6n), W32.nth0(AR.slots(U32, $MA), 6n), CY.msk(1n+k), MT.nth_other($MA, 7n, U32.inc($M7), $MB, hs2, 6n, {==}), Equal.trans(U32, W32.nth0(AR.slots(U32, $MA), 6n), $NM, CY.msk(1n+k), MT.nth_same(5n, mT, pm, 6n, {==}, $NM, $MA, hs1), GR.msk_up(one, h1, k, hk31)))
  +e7 = MT.nth_same(5n, $MA, p1, 7n, {==}, U32.inc($M7), $MB, hs2)
  +g = good_mk(~V, cap, n, head, tail, free, $MB, W32.nth0($ML, 0n), W32.nth0($ML, 1n), W32.nth0($ML, 2n), CY.msk(1n+k), U32.inc($M7), 1n+k, sd, T2, ksT, eT, lkT, sl, fl, gx, $O2(0n), $O2(1n), $O2(2n), e6, e7, p2)
  +hro = N.double_le(1n+UD.v(n), SC.pow2(k), IU.over_c(one, h1, k, hk31, hk0, UD.v(n), $G(cload)))
  mk_room(~V, $SH, r, $SHB, erl, model_m(~V, $SHA, T2, hs1, hs2), g, hro)

def rm_g2(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +cz: Nat, +hcz: {cz == 29n : Nat}, +hcap: $CAP, +hov: {$OV == True{} : Bool}, +htd: {UD.v(U32.inc($M7)) == 1n+k : Nat}, -r: LR.LRU<&2, V>, +hr0: {r == $RF($GT(True{})) : LR.LRU<&2, V>}, go: GR.GrowOK(tabT, $KL, k, sd, U32.inc($M7))) -> RoomOK(~V, $SH, r):
  match go:
    case Tuple{+T2, Tuple{+e0, hr}}:
      +pm = $G(cpm)
      +G7 = UT.uget(5n, {==}, mT, pm, 7, {==})
      +a1 = UT.uset_a(5n, {==}, mT, pm, 6, {==}, $NM)
      +p1 = UT.uset_p(5n, mT, pm, 6n, $NM)
      +hs1 = UT.uset_s(5n, mT, pm, 6n, {==}, $NM)
      +a2 = UT.uset_a(5n, {==}, $MA, p1, 7, {==}, U32.inc($M7))
      +p2 = UT.uset_p(5n, $MA, p1, 7n, U32.inc($M7))
      +hs2 = UT.uset_s(5n, $MA, p1, 7n, {==}, U32.inc($M7))
      +eM = Equal.trans(Array<U32>, $SS, Array.set(U32, AR.thaw(U32, $MA), 7, U32.inc($M7)), AR.thaw(U32, $MB), Equal.cong(Array<U32>, Array<U32>, z => Array.set(U32, z, 7, U32.inc($M7)), Array.set(U32, AR.thaw(U32, mT), 6, $NM), AR.thaw(U32, $MA), a1), a2)
      +eTb = Equal.trans(Array<U32>, $TG, H.grow_tab(CY.msk(k), U32.inc($M7), AR.thaw(U32, tabT)), AR.thaw(U32, T2), tg_eq(~V, $SHA, hg, one, h1), e0)
      +er = gtb(~V, cap, n, head, tail, free, ksT, eT, lkT, tabT, CY.msk(k), mT, $M7, G7, $MB, T2, eM, eTb)
      rm_g3(~V, $SHA, hg, one, h1, cz, hcz, hcap, hov, htd, r, T2, hr, Equal.trans(LR.LRU<&2, V>, r, $RF($GT(True{})), ST.real(~V, $SHB), hr0, er))

def rm_grow(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +cz: Nat, +hcz: {cz == 29n : Nat}, +hcap: $CAP, +hov: {$OV == True{} : Bool}) -> RoomOK(~V, $SH, $RF($GT(True{}))):
  +hk30 = L.and_left(Nat.is_lt(k, 30n), Nat.is_lt(0n, k), $G(ck))
  +hk31 = N.lt_trans(k, 30n, 31n, hk30, {==})
  +hk0 = L.and_right(Nat.is_lt(k, 30n), Nat.is_lt(0n, k), $G(ck))
  +ek = N.eq_from_is_eq(UD.v($M7), k, $G(cbits))
  +hk5b = L.subst(Nat, z => {Nat.is_lt(z, SC.pow2(5n)) == True{} : Bool}, k, UD.v($M7), Equal.sym(Nat, UD.v($M7), k, ek), N.lt_trans(k, 30n, 32n, hk30, {==}))
  +htd = Equal.trans(Nat, UD.v(U32.inc($M7)), 1n+UD.v($M7), 1n+k, W32.inc_val(one, h1, $M7, W32.bound32(one, h1, UD.v($M7), 5n, {==}, hk5b)), Equal.cong(Nat, Nat, z => 1n+z, UD.v($M7), k, ek))
  +hlen = AR.slots_length(String, sd, ksT, $G(cpk))
  +hld = L.subst(Nat, z => {Nat.is_le(Nat.double(z), $NN) == True{} : Bool}, UD.v(n), IV.occn($BS, $NN), N.eq_from_is_eq(UD.v(n), IV.occn($BS, $NN), $G(cn)), $G(cload))
  rm_g2(~V, $SHA, hg, one, h1, cz, hcz, hcap, hov, htd, $RF($GT(True{})), {==}, GR.grow_ok(one, h1, k, hk31, hk30, hk0, tabT, $G(cpt), $KL, sd, hlen, $G(cwell), $G(cuniq), hld, U32.inc($M7), htd))

def rm_b(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +cz: Nat, +hcz: {cz == 29n : Nat}, +hcap: $CAP, +b: Bool, +hb: {$OV == b : Bool}) -> RoomOK(~V, $SH, $RF($GT(b))):
  match b:
    case True{}:
      rm_grow(~V, $SHA, hg, one, h1, cz, hcz, hcap, hb)
    case False{}:
      ($SH, ({==}, ({==}, (hg, IU.gt_false_le(Nat.double(1n+UD.v(n)), SC.pow2(k), hb)))))

%def RMM(r) LR.room_m(&2, V, cap, n, head, tail, free, AR.thaw(U32, tabT), AR.thaw(String, ksT), AR.thaw(Maybe<&2, V>, eT), AR.thaw(U32, lkT), r)

def room_f(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +cz: Nat, +hcz: {cz == 29n : Nat}, +hcap: $CAP) -> RoomOK(~V, $SH, LR.room(&2, V, $F)):
  +hk30 = L.and_left(Nat.is_lt(k, 30n), Nat.is_lt(0n, k), $G(ck))
  +hk31 = N.lt_trans(k, 30n, 31n, hk30, {==})
  +hk0 = L.and_right(Nat.is_lt(k, 30n), Nat.is_lt(0n, k), $G(ck))
  +G6 = Equal.trans(Array<U32> & U32, Array.get(U32, AR.thaw(U32, mT), 6), (AR.thaw(U32, mT), W32.nth0($ML, 6n)), (AR.thaw(U32, mT), CY.msk(k)), UT.uget(5n, {==}, mT, $G(cpm), 6, {==}), Equal.cong(U32, Array<U32> & U32, z => (AR.thaw(U32, mT), z), W32.nth0($ML, 6n), CY.msk(k), A.eq_of(W32.nth0($ML, 6n), CY.msk(k), $G(cmask))))
  +E1 = Equal.cong(Array<U32> & U32, LR.LRU<&2, V>, r => $RMM(r), Array.get(U32, AR.thaw(U32, mT), 6), (AR.thaw(U32, mT), CY.msk(k)), G6)
  +E2 = Equal.cong(Bool, LR.LRU<&2, V>, b => $RF($GT(b)), U32.is_gt(U32.shl(U32.inc(n)), U32.inc(CY.msk(k))), $OV, IU.over_val(one, h1, k, hk31, hk0, n, $G(cload)))
  +E = Equal.trans(LR.LRU<&2, V>, LR.room(&2, V, $F), $RF($GT(U32.is_gt(U32.shl(U32.inc(n)), U32.inc(CY.msk(k))))), $RF($GT($OV)), E1, E2)
  L.subst(LR.LRU<&2, V>, z => RoomOK(~V, $SH, z), $RF($GT($OV)), LR.room(&2, V, $F), Equal.sym(LR.LRU<&2, V>, LR.room(&2, V, $F), $RF($GT($OV)), E), rm_b(~V, $SHA, hg, one, h1, cz, hcz, hcap, $OV, {==}))

# the state can take one more entry within 2^29 buckets
def capok(~V: Data, sh: ST.Sh<V>, +cz: Nat) -> Bool:
  match sh:
    case ST.LS{+cap, +n, +head, +tail, +free, +mT, +k, +sd, +tabT, +ksT, +eT, +lkT, +sl, +fl}:
      Nat.is_le(Nat.double(1n+UD.v(n)), SC.pow2(cz))

# THEOREM: room keeps the model and the invariant and leaves room for one more
def room_ok(~V: Data, +one: Nat, +h1: {one == 1n : Nat}, +sh: ST.Sh<V>, +hg: {ST.good(~V, sh) == True{} : Bool}, +cz: Nat, +hcz: {cz == 29n : Nat}, +hcap: {capok(~V, sh, cz) == True{} : Bool}) -> RoomOK(~V, sh, LR.room(&2, V, ST.real(~V, sh))):
  match sh:
    case ST.LS{$SHA}:
      room_f(~V, $SHA, hg, one, h1, cz, hcz, hcap)
