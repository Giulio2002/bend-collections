  L.subst(LR.LRU<&2, V> & Maybe<&2, V>, z => RM.POK(~V, Maybe<&2, V>, $RF(Some{$EV}), z), LR.rd_gone_pick(V, $F, su, U32.from_nat(i), tracked, SP.gone(~V, $EV, now)), LR.rd_hit(V, $F, su, U32.from_nat(i), now, tracked), Equal.sym(LR.LRU<&2, V> & Maybe<&2, V>, LR.rd_hit(V, $F, su, U32.from_nat(i), now, tracked), LR.rd_gone_pick(V, $F, su, U32.from_nat(i), tracked, SP.gone(~V, $EV, now)), E), rd_gp(~V, $SHA, hg, key, now, tracked, $HPA, $RHXA, SP.gone(~V, $EV, now)))

# ---- the probe's result ----

def lnz(+sd: Nat, +key: String, +b: B.Bk, +hw: {B.wb(sd, b) == True{} : Bool}, +hk: {B.hold(key, b) == True{} : Bool}) -> {U32.is_eq(B.lnk(b), 0) == False{} : Bool}:
  match b:
    case B.BE{}:
      Empty.absurd({U32.is_eq(B.lnk(B.BE{}), 0) == False{} : Bool}, L.false_true(hk))
    case B.BF{+w, +l, +k}:
      L.not_true(U32.is_eq(l, 0), L.and_right(U32.is_eq(w, K.kword(k)), Bool.not(U32.is_eq(l, 0)), L.and_right(Nat.is_lt(UD.v(H.slot(l)), SC.pow2(sd)), Bool.and(U32.is_eq(w, K.kword(k)), Bool.not(U32.is_eq(l, 0))), hw)))

%def PR PI.fd_of(r0, AR.thaw(U32, tabT), AR.thaw(String, ksT), PA.stored(key))
%def RFD(x) LR.rd_fd(V, cap, n, head, tail, free, AR.thaw(U32, mT), AR.thaw(Maybe<&2, V>, eT), AR.thaw(U32, lkT), now, tracked, x)
%def HOME UD.v(HS.bucket(K.kword(key), CY.msk(k)))

def rd_v0(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, $RP, +one: Nat, +h1: {one == 1n : Nat}, +s: Nat, +hmem: {NL.memn(s, sl) == True{} : Bool}, +su: U32, +hsv: {UD.v(su) == s : Nat}, +hk: {S.str_eq(ST.skey($LLo, $KL, s), key) == True{} : Bool}, $RHX, +m: Maybe<&2, V>, +hmm: {HT.nthm(~V, $EL, s) == m : Maybe<&2, V>}, +hsm: {HT.some_b(~V, m) == True{} : Bool}) -> RM.POK(~V, Maybe<&2, V>, $RF(SP.find(~V, $ES, key)), LR.rd_hit(V, $F, su, U32.from_nat(i), now, tracked)):
  match m:
    case None{}:
      Empty.absurd(RM.POK(~V, Maybe<&2, V>, $RF(SP.find(~V, $ES, key)), LR.rd_hit(V, $F, su, U32.from_nat(i), now, tracked)), L.false_true(hsm))
    case Some{+v}:
      +hm = {hmm : {HT.nthm(~V, $EL, s) == Some{v} : Maybe<&2, V>}}
      +hlv = L.subst(Maybe<&2, V>, z => {HT.some_b(~V, z) == True{} : Bool}, Some{v}, HT.nthm(~V, $EL, s), Equal.sym(Maybe<&2, V>, HT.nthm(~V, $EL, s), Some{v}, hm), {==})
      +hf = Equal.trans(Maybe<&2, SP.Ent<V>>, SP.find(~V, $ES, key), FD.fnd(~V, $LLo, $KL, s, HT.nthm(~V, $EL, s)), Some{$EV}, FD.find_hit(~V, $LLo, $KL, $EL, s, hlv, key, hk, sl, hmem, $G(ckeys)), Equal.cong(Maybe<&2, V>, Maybe<&2, SP.Ent<V>>, z => FD.fnd(~V, $LLo, $KL, s, z), HT.nthm(~V, $EL, s), Some{v}, hm))
      L.subst(Maybe<&2, SP.Ent<V>>, z => RM.POK(~V, Maybe<&2, V>, $RF(z), LR.rd_hit(V, $F, su, U32.from_nat(i), now, tracked)), Some{$EV}, SP.find(~V, $ES, key), Equal.sym(Maybe<&2, SP.Ent<V>>, SP.find(~V, $ES, key), Some{$EV}, hf), rd_h(~V, $SHA, hg, key, now, tracked, one, h1, s, hmem, su, hsv, v, hm, hk, $RHXA))

%def Bi B.at($BS, i)
%def Si UD.v(H.slot(l))

def rd_hi(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, $RP, +one: Nat, +h1: {one == 1n : Nat}, +i: Nat, +l: U32, +hi: {Nat.is_lt(i, $NN) == True{} : Bool}, +hk0: {B.hold(key, $Bi) == True{} : Bool}, +hl: {B.lnk($Bi) == l : U32}) -> RM.POK(~V, Maybe<&2, V>, $RF(SP.find(~V, $ES, key)), LR.rd_pick(V, $F, U32.from_nat(i), l, now, tracked, U32.is_eq(l, 0))):
  +hwb = B.all_inst(B.PWell{$BS, sd}, $NN, $G(cwell), i, hi)
  +hz = L.subst(U32, z => {U32.is_eq(z, 0) == False{} : Bool}, B.lnk($Bi), l, hl, lnz(sd, key, $Bi, hwb, hk0))
  +hsi = Equal.cong(U32, Nat, z => UD.v(H.slot(z)), B.lnk($Bi), l, hl)
  +hbl = TF.bsl_inst($BS, sl, $LLo, $NN, $G(cbsl), i, hi)
  +hmem = L.subst(Nat, z => {NL.memn(z, sl) == True{} : Bool}, UD.v(H.slot(B.lnk($Bi))), $Si, hsi, TF.hit_mem(sl, $LLo, key, $Bi, hk0, hbl))
  +hk = L.subst(Nat, z => {S.str_eq(ST.skey($LLo, $KL, z), key) == True{} : Bool}, UD.v(H.slot(B.lnk($Bi))), $Si, hsi, TF.hit_key(sl, $LLo, $KL, key, $Bi, hk0, hbl, TF.bkok_at(AR.slots(U32, tabT), $KL, $NN, i, hi)))
  +hls = TF.slok_mem(~V, $EL, $FR, $Si, sl, $G(csl), hmem)
  ok = rd_v0(~V, $SHA, hg, key, now, tracked, one, h1, $Si, hmem, H.slot(l), {==}, hk, i, hi, B.hold_occ(key, $Bi, hk0), hsi, HT.nthm(~V, $EL, $Si), {==}, L.and_right(Nat.is_lt($Si, $FR), ST.live(~V, $EL, $Si), hls))
  L.subst(Bool, z => RM.POK(~V, Maybe<&2, V>, $RF(SP.find(~V, $ES, key)), LR.rd_pick(V, $F, U32.from_nat(i), l, now, tracked, z)), False{}, U32.is_eq(l, 0), Equal.sym(Bool, U32.is_eq(l, 0), False{}, hz), ok)

def rd_r(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, $RP, +one: Nat, +h1: {one == 1n : Nat}, +h: Nat, +r0: B.Res, hres: B.ResOK($BS, $NN, h, key, r0)) -> RM.POK(~V, Maybe<&2, V>, $RF(SP.find(~V, $ES, key)), $RFD($PR)):
  match r0:
    case B.RHit{+i, +l}:
      (+hi, rest) = hres
      (+hk0, hl) = rest
      rd_hi(~V, $SHA, hg, key, now, tracked, one, h1, i, l, hi, hk0, hl)
    case B.REnd{+e0}:
      (+he, rest) = hres
      (+hz, rest2) = rest
      (+hp, hno) = rest2
      +hsd1 = UL.sd1(sd, f_hsd(~V, $SHA, hg))
      +hnk = TF.nokey_of(~V, one, h1, AR.slots(U32, tabT), $KL, $NN, key, hno, $LLo, $EL, sd, hsd1, $FR, $G(cfresh), sl, $G(csl), $G(chas))
      rd_end(~V, $SHA, hg, key, now, tracked, U32.from_nat(e0), FD.find_miss(~V, $LLo, $KL, $EL, key, sl, hnk))

# ---- read ----

%def K2L AR.slots(String, K2)
%def PB H.probe(AR.thaw(U32, tabT), AR.thaw(String, ksT), CY.msk(k), key)
%def RFN(x) LR.rd_found(V, cap, n, head, tail, free, AR.thaw(U32, mT), AR.thaw(Maybe<&2, V>, eT), AR.thaw(U32, lkT), now, tracked, x)
%def RFz(z) SP.read_found(~V, cap, $M3, $W4, ST.es(~V, $LLo, z, $EL, sl), $CTR, key, now, tracked, SP.find(~V, ST.es(~V, $LLo, z, $EL, sl), key))
%def GFz(z, p) ST.goodF(~V, cap, n, head, tail, free, W32.nth0($ML, 0n), W32.nth0($ML, 1n), W32.nth0($ML, 2n), W32.nth0($ML, 6n), W32.nth0($ML, 7n), AR.perfect(U32, 5n, mT), k, sd, tabT, z, p, eT, lkT, sl, fl)

def rd_po(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, $RP, +one: Nat, +h1: {one == 1n : Nat}, +r0: B.Res, hres: B.ResOK($BS, $NN, $HOME, key, r0), po: PA.ProbeOK(tabT, sd, $KL, PA.stored(key), K.kword(key), r0, $PB)) -> RM.POK(~V, Maybe<&2, V>, $RF(SP.find(~V, $ES, key)), $RFN($PB)):
  match po:
    case Tuple{+K2, Tuple{+e, Tuple{+hsl, pk2}}}:
      +pk = $G(cpk)
      +g1 = L.subst(List<&2, String>, z => {$GFz(z, AR.perfect(String, sd, ksT)) == True{} : Bool}, $KL, $K2L, Equal.sym(List<&2, String>, $K2L, $KL, hsl), hg)
      +hg2 = L.subst(Bool, z => {$GFz($K2L, z) == True{} : Bool}, AR.perfect(String, sd, ksT), AR.perfect(String, sd, K2), Equal.trans(Bool, AR.perfect(String, sd, ksT), True{}, AR.perfect(String, sd, K2), pk, Equal.sym(Bool, AR.perfect(String, sd, K2), True{}, pk2)), g1)
      hres2 = L.subst(List<&2, String>, z => B.ResOK(TB.buckets(AR.slots(U32, tabT), z, $NN), $NN, $HOME, key, r0), $KL, $K2L, Equal.sym(List<&2, String>, $K2L, $KL, hsl), hres)
      ok = rd_r(~V, cap, n, head, tail, free, mT, k, sd, tabT, K2, eT, lkT, sl, fl, hg2, key, now, tracked, one, h1, $HOME, r0, hres2)
      +E = Equal.cong(H.Found & U32, LR.LRU<&2, V> & Maybe<&2, V>, x => $RFN(x), $PB, (PI.fd_of(r0, AR.thaw(U32, tabT), AR.thaw(String, K2), PA.stored(key)), K.kword(key)), e)
      ok2 = L.subst(List<&2, String>, z => RM.POK(~V, Maybe<&2, V>, $RFz(z), $RFN((PI.fd_of(r0, AR.thaw(U32, tabT), AR.thaw(String, K2), PA.stored(key)), K.kword(key)))), $K2L, $KL, hsl, ok)
      L.subst(LR.LRU<&2, V> & Maybe<&2, V>, z => RM.POK(~V, Maybe<&2, V>, $RF(SP.find(~V, $ES, key)), z), $RFN((PI.fd_of(r0, AR.thaw(U32, tabT), AR.thaw(String, K2), PA.stored(key)), K.kword(key))), $RFN($PB), Equal.sym(LR.LRU<&2, V> & Maybe<&2, V>, $RFN($PB), $RFN((PI.fd_of(r0, AR.thaw(U32, tabT), AR.thaw(String, K2), PA.stored(key)), K.kword(key))), E), ok2)

%def R0 B.pf(key, $BS, $NN, $NN, B.mstep(key, B.at($BS, $HOME)), $HOME)

def read_sh(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, $RP, +one: Nat, +h1: {one == 1n : Nat}) -> RM.POK(~V, Maybe<&2, V>, SP.read(~V, ST.model(~V, $SH), key, now, tracked), LR.read(V, $F, key, now, tracked)):
  +hk30 = L.and_left(Nat.is_lt(k, 30n), Nat.is_lt(0n, k), $G(ck))
  +hk31 = N.lt_trans(k, 30n, 31n, hk30, {==})
  +hsd32 = N.lt_trans(sd, 3n+sd, 32n, N.lt_le_trans(sd, 1n+sd, 3n+sd, N.lt_succ(sd), N.le_trans(1n+sd, 2n+sd, 3n+sd, N.le_succ(1n+sd), N.le_succ(2n+sd))), f_hsd(~V, $SHA, hg))
  +hn = N.succ_le_lt(0n, $NN, N.pow2_pos(k))
  +cn = N.eq_from_is_eq(UD.v(n), IV.occn($BS, $NN), $G(cn))
  +hocc = L.subst(Nat, z => {Nat.is_lt(z, $NN) == True{} : Bool}, UD.v(n), IV.occn($BS, $NN), cn, BA.n_lt(~V, $SHA, hg))
  hres = G.res_e0($BS, $NN, hn, CY.msk(k), key, $HOME, PA.home_lt(K.kword(key), k), $G(cclus), IV.home_all($BS, sd, CY.msk(k), key, $NN, $G(cwell), $NN, N.le_refl($NN)), IV.find_empty($BS, $NN, hocc))
  ok = rd_po(~V, $SHA, hg, key, now, tracked, one, h1, $R0, hres, PA.probe_ok(one, h1, k, hk31, tabT, $G(cpt), sd, hsd32, $KL, ksT, {==}, $G(cpk), $G(cwell), key))
  +em6 = A.eq_of(W32.nth0($ML, 6n), CY.msk(k), $G(cmask))
  +g6 = Equal.trans(Array<U32> & U32, Array.get(U32, AR.thaw(U32, mT), 6), (AR.thaw(U32, mT), W32.nth0($ML, 6n)), (AR.thaw(U32, mT), CY.msk(k)), UT.uget(5n, {==}, mT, $G(cpm), 6, {==}), Equal.cong(U32, Array<U32> & U32, z => (AR.thaw(U32, mT), z), W32.nth0($ML, 6n), CY.msk(k), em6))
  +E = Equal.cong(Array<U32> & U32, LR.LRU<&2, V> & Maybe<&2, V>, r => LR.rd_m(V, cap, n, head, tail, free, AR.thaw(U32, tabT), AR.thaw(String, ksT), AR.thaw(Maybe<&2, V>, eT), AR.thaw(U32, lkT), key, now, tracked, r), Array.get(U32, AR.thaw(U32, mT), 6), (AR.thaw(U32, mT), CY.msk(k)), g6)
  L.subst(LR.LRU<&2, V> & Maybe<&2, V>, z => RM.POK(~V, Maybe<&2, V>, SP.read(~V, ST.model(~V, $SH), key, now, tracked), z), $RFN($PB), LR.read(V, $F, key, now, tracked), Equal.sym(LR.LRU<&2, V> & Maybe<&2, V>, LR.read(V, $F, key, now, tracked), $RFN($PB), E), ok)

# THEOREM (read): get (tracked) and peek (untracked) are the specification's
def read_ok(~V: Data, +one: Nat, +h1: {one == 1n : Nat}, +sh: ST.Sh<V>, +hg: {ST.good(~V, sh) == True{} : Bool}, $RP) -> RM.POK(~V, Maybe<&2, V>, SP.read(~V, ST.model(~V, sh), key, now, tracked), LR.read(V, ST.real(~V, sh), key, now, tracked)):
  match sh:
    case ST.LS{$SHA}:
      read_sh(~V, $SHA, hg, key, now, tracked, one, h1)
