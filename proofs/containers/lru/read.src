# get and peek (read): the implementation's read is the specification's.

%def SHF +cap: U32, +n: U32, +head: U32, +tail: U32, +free: U32, +mT: AR.Tree<U32>, +k: Nat, +sd: Nat, +tabT: AR.Tree<U32>, +ksT: AR.Tree<String>, +eT: AR.Tree<Maybe<&2, V>>, +lkT: AR.Tree<U32>, +sl: List<&2, Nat>, +fl: List<&2, Nat>
%def SHA cap, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, sl, fl
%def SH ST.LS{$SHA}
%def F ST.real(~V, $SH)
%def ML AR.slots(U32, mT)
%def KL AR.slots(String, ksT)
%def LLo AR.slots(U32, lkT)
%def EL AR.slots(Maybe<&2, V>, eT)
%def ES ST.es(~V, $LLo, $KL, $EL, sl)
%def M3 W32.nth0($ML, 3n)
%def W4 ST.w64($ML, 4n)
%def CTR ST.ctr($ML)
%def RF(m) SP.read_found(~V, cap, $M3, $W4, $ES, $CTR, key, now, tracked, m)
%def RP +key: String, +now: W.U64, +tracked: Bool

# a miss is counted
def rd_miss(~V: Data, +sh: ST.Sh<V>, co: BS.CountOK(~V, BS.cg_miss(~V, ST.model(~V, sh)), LR.fbump(&2, V, 4, ST.real(~V, sh)))) -> RM.POK(~V, Maybe<&2, V>, (BS.cg_miss(~V, ST.model(~V, sh)), None{}), (LR.fbump(&2, V, 4, ST.real(~V, sh)), None{})):
  match co:
    case Tuple{+sh2, Tuple{+e, Tuple{+em, g}}}:
      (sh2, (None{}, (Equal.cong(LR.LRU<&2, V>, LR.LRU<&2, V> & Maybe<&2, V>, z => (z, None{}), LR.fbump(&2, V, 4, ST.real(~V, sh)), ST.real(~V, sh2), e), (Equal.cong(SP.Lru<V>, SP.Lru<V> & Maybe<&2, V>, z => (z, None{}), BS.cg_miss(~V, ST.model(~V, sh)), ST.model(~V, sh2), Equal.sym(SP.Lru<V>, ST.model(~V, sh2), BS.cg_miss(~V, ST.model(~V, sh)), em)), g))))

# ---- the key is absent ----

def rd_end0(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, $RP, +at: U32) -> RM.POK(~V, Maybe<&2, V>, $RF(None{}), LR.rd_pick(V, $F, at, 0, now, tracked, True{})):
  match tracked:
    case True{}:
      rd_miss(~V, $SH, BS.countg_miss(~V, $SH, hg))
    case False{}:
      ($SH, (None{}, ({==}, ({==}, hg))))

def rd_end(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, $RP, +at: U32, +hf: {SP.find(~V, $ES, key) == None{} : Maybe<&2, SP.Ent<V>>}) -> RM.POK(~V, Maybe<&2, V>, $RF(SP.find(~V, $ES, key)), LR.rd_pick(V, $F, at, 0, now, tracked, True{})):
  L.subst(Maybe<&2, SP.Ent<V>>, z => RM.POK(~V, Maybe<&2, V>, $RF(z), LR.rd_pick(V, $F, at, 0, now, tracked, True{})), None{}, SP.find(~V, $ES, key), Equal.sym(Maybe<&2, SP.Ent<V>>, SP.find(~V, $ES, key), None{}, hf), rd_end0(~V, $SHA, hg, key, now, tracked, at))


# ---- the key's slot s holds value v ----

%def HP +one: Nat, +h1: {one == 1n : Nat}, +s: Nat, +hmem: {NL.memn(s, sl) == True{} : Bool}, +su: U32, +hsv: {UD.v(su) == s : Nat}, +v: V, +hm: {HT.nthm(~V, $EL, s) == Some{v} : Maybe<&2, V>}, +hk: {S.str_eq(ST.skey($LLo, $KL, s), key) == True{} : Bool}
%def HPA one, h1, s, hmem, su, hsv, v, hm, hk
%def EV TO.ev(~V, $LLo, $KL, s, v)
%def ML2 AR.slots(U32, m2)
%def SHM(m) ST.LS{cap, n, head, tail, free, m, k, sd, tabT, ksT, eT, lkT, sl, fl}
%def LIVE(t) SP.read_live(~V, cap, $M3, $W4, $ES, $CTR, key, $EV, t)

def l_on(~V: Data, l: SP.Lru<V>) -> U32:
  match l:
    case SP.L{cap, on, life, es, c}:
      on

def l_life(~V: Data, l: SP.Lru<V>) -> W.U64:
  match l:
    case SP.L{cap, on, life, es, c}:
      life

def l_c(~V: Data, l: SP.Lru<V>) -> SP.Ctr:
  match l:
    case SP.L{cap, on, life, es, c}:
      c

def rd_tch(~V: Data, $SHF, $RP, $HP, +m2: AR.Tree<U32>, +em: {ST.model(~V, $SHM(m2)) == SP.L{cap, $M3, $W4, $ES, SP.c_hit($CTR)} : SP.Lru<V>}, -r: LR.LRU<&2, V>, to: TSH.TouchOK(~V, SP.L{cap, W32.nth0($ML2, 3n), ST.w64($ML2, 4n), SP.snoc(~V, SP.drop(~V, $ES, key), $EV), ST.ctr($ML2)}, r)) -> RM.POK(~V, Maybe<&2, V>, $LIVE(True{}), (r, Some{v})):
  match to:
    case Tuple{+sh3, Tuple{+e3, Tuple{+em3, g3}}}:
      +eo = Equal.cong(SP.Lru<V>, U32, w => l_on(~V, w), ST.model(~V, $SHM(m2)), SP.L{cap, $M3, $W4, $ES, SP.c_hit($CTR)}, em)
      +el = Equal.cong(SP.Lru<V>, W.U64, w => l_life(~V, w), ST.model(~V, $SHM(m2)), SP.L{cap, $M3, $W4, $ES, SP.c_hit($CTR)}, em)
      +ec = Equal.cong(SP.Lru<V>, SP.Ctr, w => l_c(~V, w), ST.model(~V, $SHM(m2)), SP.L{cap, $M3, $W4, $ES, SP.c_hit($CTR)}, em)
      +es1 = BA.lru_eq(~V, cap, W32.nth0($ML2, 3n), $M3, ST.w64($ML2, 4n), $W4, SP.snoc(~V, SP.drop(~V, $ES, key), $EV), SP.snoc(~V, SP.drop(~V, $ES, key), $EV), ST.ctr($ML2), SP.c_hit($CTR), eo, el, {==}, ec)
      +esp = Equal.trans(SP.Lru<V>, ST.model(~V, sh3), SP.L{cap, W32.nth0($ML2, 3n), ST.w64($ML2, 4n), SP.snoc(~V, SP.drop(~V, $ES, key), $EV), ST.ctr($ML2)}, SP.L{cap, $M3, $W4, SP.snoc(~V, SP.drop(~V, $ES, key), $EV), SP.c_hit($CTR)}, em3, es1)
      (sh3, (Some{v}, (Equal.cong(LR.LRU<&2, V>, LR.LRU<&2, V> & Maybe<&2, V>, z => (z, Some{v}), r, ST.real(~V, sh3), e3), (Equal.cong(SP.Lru<V>, SP.Lru<V> & Maybe<&2, V>, z => (z, Some{v}), SP.L{cap, $M3, $W4, SP.snoc(~V, SP.drop(~V, $ES, key), $EV), SP.c_hit($CTR)}, ST.model(~V, sh3), Equal.sym(SP.Lru<V>, ST.model(~V, sh3), SP.L{cap, $M3, $W4, SP.snoc(~V, SP.drop(~V, $ES, key), $EV), SP.c_hit($CTR)}, esp)), g3))))

def rd_hitc(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, $RP, $HP, cm: BS.CntM(~V, $SHA, SP.L{cap, $M3, $W4, $ES, SP.c_hit($CTR)}, LR.fbump(&2, V, 3, $F))) -> RM.POK(~V, Maybe<&2, V>, $LIVE(True{}), (LR.touch(&2, V, LR.fbump(&2, V, 3, $F), su), Some{v})):
  match cm:
    case Tuple{+m2, Tuple{+e1, Tuple{+em, g1}}}:
      +E = Equal.cong(LR.LRU<&2, V>, LR.LRU<&2, V>, z => LR.touch(&2, V, z, su), LR.fbump(&2, V, 3, $F), ST.real(~V, $SHM(m2)), e1)
      ok = rd_tch(~V, $SHA, key, now, tracked, $HPA, m2, em, LR.touch(&2, V, ST.real(~V, $SHM(m2)), su), TSH.touch_sh(~V, one, h1, cap, n, head, tail, free, m2, k, sd, tabT, ksT, eT, lkT, sl, fl, g1, s, hmem, su, hsv, key, hk, v, hm))
      L.subst(LR.LRU<&2, V>, z => RM.POK(~V, Maybe<&2, V>, $LIVE(True{}), (z, Some{v})), LR.touch(&2, V, ST.real(~V, $SHM(m2)), su), LR.touch(&2, V, LR.fbump(&2, V, 3, $F), su), Equal.sym(LR.LRU<&2, V>, LR.touch(&2, V, LR.fbump(&2, V, 3, $F), su), LR.touch(&2, V, ST.real(~V, $SHM(m2)), su), E), ok)

%def GCPM ST.g_cpm(~V, cap, n, head, tail, free, W32.nth0($ML, 0n), W32.nth0($ML, 1n), W32.nth0($ML, 2n), W32.nth0($ML, 6n), W32.nth0($ML, 7n), AR.perfect(U32, 5n, mT), k, sd, tabT, $KL, AR.perfect(String, sd, ksT), eT, lkT, sl, fl, hg)

# a live entry read: tracked, it is counted and touched; untracked, nothing
def rd_lv(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, $RP, $HP) -> RM.POK(~V, Maybe<&2, V>, $LIVE(tracked), LR.rd_live(&2, V, $F, su, tracked, v)):
  match tracked:
    case True{}:
      rd_hitc(~V, $SHA, hg, key, now, True{}, $HPA, BS.cntm_hit(~V, $SHA, hg, BU.bump_ok(mT, $GCPM, 3, 22n, {==}, {==}, {==})))
    case False{}:
      ($SH, (Some{v}, ({==}, ({==}, hg))))

%def GA0 cap, n, head, tail, free, W32.nth0($ML, 0n), W32.nth0($ML, 1n), W32.nth0($ML, 2n), W32.nth0($ML, 6n), W32.nth0($ML, 7n), AR.perfect(U32, 5n, mT), k, sd, tabT, $KL, AR.perfect(String, sd, ksT), eT, lkT, sl, fl
%def G(c) ST.g_$c(~V, $GA0, hg)
%def FR UD.v(W32.nth0($ML, 0n))
%def NN SC.pow2(k)
%def BS TB.buckets(AR.slots(U32, tabT), $KL, $NN)

def f_hsd(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}) -> {Nat.is_lt(3n+sd, 32n) == True{} : Bool}:
  TSH.sd29(k, sd, L.and_left(Nat.is_lt(k, 30n), Nat.is_lt(0n, k), $G(ck)), $G(csdk))

def f_s0(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, +s: Nat, +hmem: {NL.memn(s, sl) == True{} : Bool}) -> {Nat.is_lt(s, SC.pow2(sd)) == True{} : Bool}:
  UL.bnd_of(~V, s, sl, $FR, $EL, sd, $G(cfresh), $G(csl), hmem)

# reading the value cell of a live slot
def rd_lf(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, $RP, $HP) -> RM.POK(~V, Maybe<&2, V>, $LIVE(tracked), LR.rd_live_f(V, $F, su, tracked)):
  +hs0 = f_s0(~V, $SHA, hg, s, hmem)
  +hsu = GO.su_lt(su, s, sd, hsv, hs0)
  +hd = N.lt_trans(sd, 3n+sd, 32n, N.lt_le_trans(sd, 1n+sd, 3n+sd, N.lt_succ(sd), N.le_trans(1n+sd, 2n+sd, 3n+sd, N.le_succ(1n+sd), N.le_succ(2n+sd))), f_hsd(~V, $SHA, hg))
  +hn = Equal.trans(Maybe<&2, V>, HT.nthm(~V, $EL, UD.v(su)), HT.nthm(~V, $EL, s), Some{v}, Equal.cong(Nat, Maybe<&2, V>, z => HT.nthm(~V, $EL, z), UD.v(su), s, hsv), hm)
  +hx = L.subst(Maybe<&2, V>, z => {SC.nth(Maybe<&2, V>, $EL, UD.v(su)) == Some{z} : Maybe<&2, Maybe<&2, V>>}, HT.nthm(~V, $EL, UD.v(su)), Some{v}, hn, HT.nthm_some(~V, $EL, UD.v(su), UT.len_of(Maybe<&2, V>, sd, eT, $G(cpe), UD.v(su), hsu)))
  +eg = AR.get(Maybe<&2, V>, sd, eT, su, Some{v}, hd, hsu, hx, $G(cpe))
  +E = Equal.cong(Array<Maybe<&2, V>> & Maybe<&2, V>, LR.LRU<&2, V> & Maybe<&2, V>, r => LR.rd_v(V, cap, n, head, tail, free, AR.thaw(U32, mT), AR.thaw(U32, tabT), AR.thaw(String, ksT), AR.thaw(U32, lkT), su, tracked, r), Array.get(Maybe<&2, V>, AR.thaw(Maybe<&2, V>, eT), su), (AR.thaw(Maybe<&2, V>, eT), Some{v}), eg)
  L.subst(LR.LRU<&2, V> & Maybe<&2, V>, z => RM.POK(~V, Maybe<&2, V>, $LIVE(tracked), z), LR.rd_live(&2, V, $F, su, tracked, v), LR.rd_live_f(V, $F, su, tracked), Equal.sym(LR.LRU<&2, V> & Maybe<&2, V>, LR.rd_live_f(V, $F, su, tracked), LR.rd_live(&2, V, $F, su, tracked, v), E), rd_lv(~V, $SHA, hg, key, now, tracked, $HPA))

%def EXP (SP.L{cap, $M3, $W4, SP.drop(~V, $ES, key), SP.c_miss_if(SP.c_rm($CTR), tracked)}, None{})
%def EXP0 (SP.L{cap, $M3, $W4, SP.drop(~V, $ES, key), SP.c_rm($CTR)}, Some{v})

# after the removal of the expired entry: a miss, counted when tracked
def rd_gn(~V: Data, +tracked: Bool, +sh2: ST.Sh<V>, +hg2: {ST.good(~V, sh2) == True{} : Bool}, +x: Maybe<&2, V>, +cap: U32, +on: U32, +life: W.U64, +es2: List<&2, SP.Ent<V>>, +c: SP.Ctr, +hm2: {SP.L{cap, on, life, es2, c} == ST.model(~V, sh2) : SP.Lru<V>}) -> RM.POK(~V, Maybe<&2, V>, (SP.L{cap, on, life, es2, SP.c_miss_if(c, tracked)}, None{}), LR.rd_gone(&2, V, tracked, (ST.real(~V, sh2), x))):
  match tracked:
    case True{}:
      L.subst(SP.Lru<V>, z => RM.POK(~V, Maybe<&2, V>, (BS.cg_miss(~V, z), None{}), (LR.fbump(&2, V, 4, ST.real(~V, sh2)), None{})), ST.model(~V, sh2), SP.L{cap, on, life, es2, c}, Equal.sym(SP.Lru<V>, SP.L{cap, on, life, es2, c}, ST.model(~V, sh2), hm2), rd_miss(~V, sh2, BS.countg_miss(~V, sh2, hg2)))
    case False{}:
      (sh2, (None{}, ({==}, (Equal.cong(SP.Lru<V>, SP.Lru<V> & Maybe<&2, V>, z => (z, None{}), SP.L{cap, on, life, es2, c}, ST.model(~V, sh2), hm2), hg2))))

def rd_ex2(~V: Data, $SHF, $RP, $HP, -r: LR.LRU<&2, V> & Maybe<&2, V>, pk: RM.POK(~V, Maybe<&2, V>, $EXP0, r)) -> RM.POK(~V, Maybe<&2, V>, $EXP, LR.rd_gone(&2, V, tracked, r)):
  match pk:
    case Tuple{+sh2, Tuple{+x, Tuple{+er, Tuple{+es, g2}}}}:
      +hm2 = L.pair_fst(SP.Lru<V>, Maybe<&2, V>, SP.L{cap, $M3, $W4, SP.drop(~V, $ES, key), SP.c_rm($CTR)}, Some{v}, ST.model(~V, sh2), x, es)
      L.subst(LR.LRU<&2, V> & Maybe<&2, V>, z => RM.POK(~V, Maybe<&2, V>, $EXP, LR.rd_gone(&2, V, tracked, z)), (ST.real(~V, sh2), x), r, Equal.sym(LR.LRU<&2, V> & Maybe<&2, V>, r, (ST.real(~V, sh2), x), er), rd_gn(~V, tracked, sh2, g2, x, cap, $M3, $W4, SP.drop(~V, $ES, key), SP.c_rm($CTR), hm2))

%def RHX +i: Nat, +hi: {Nat.is_lt(i, $NN) == True{} : Bool}, +hoi: {B.occ(B.at($BS, i)) == True{} : Bool}, +hsi: {UD.v(H.slot(B.lnk(B.at($BS, i)))) == s : Nat}
%def RHXA i, hi, hoi, hsi
%def DT H.del_at(AR.thaw(U32, tabT), CY.msk(k), U32.from_nat(i))
%def F0(x) LR.F{cap, n, head, tail, free, AR.thaw(U32, mT), x, AR.thaw(String, ksT), AR.thaw(Maybe<&2, V>, eT), AR.thaw(U32, lkT)}

# an expired entry: removed, then read as a miss
def rd_ex(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, $RP, $HP, $RHX) -> RM.POK(~V, Maybe<&2, V>, $EXP, LR.rd_expire(&2, V, $F, su, U32.from_nat(i), tracked)):
  +em6 = A.eq_of(W32.nth0($ML, 6n), CY.msk(k), $G(cmask))
  +g6 = Equal.trans(Array<U32> & U32, Array.get(U32, AR.thaw(U32, mT), 6), (AR.thaw(U32, mT), W32.nth0($ML, 6n)), (AR.thaw(U32, mT), CY.msk(k)), UT.uget(5n, {==}, mT, $G(cpm), 6, {==}), Equal.cong(U32, Array<U32> & U32, z => (AR.thaw(U32, mT), z), W32.nth0($ML, 6n), CY.msk(k), em6))
  +E = Equal.cong(Array<U32> & U32, LR.LRU<&2, V> & Maybe<&2, V>, r => LR.rd_exp_m(&2, V, cap, n, head, tail, free, AR.thaw(U32, tabT), AR.thaw(String, ksT), AR.thaw(Maybe<&2, V>, eT), AR.thaw(U32, lkT), su, U32.from_nat(i), tracked, r), Array.get(U32, AR.thaw(U32, mT), 6), (AR.thaw(U32, mT), CY.msk(k)), g6)
  ok = rd_ex2(~V, $SHA, key, now, tracked, $HPA, LR.drop_slot(&2, V, $F0($DT), su, 2), RM.rm_at_rm(~V, cap, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, sl, fl, hg, s, hmem, one, h1, i, hi, hoi, hsi, su, hsv, v, hm, key, hk))
  L.subst(LR.LRU<&2, V> & Maybe<&2, V>, z => RM.POK(~V, Maybe<&2, V>, $EXP, z), LR.rd_gone(&2, V, tracked, LR.drop_slot(&2, V, $F0($DT), su, 2)), LR.rd_expire(&2, V, $F, su, U32.from_nat(i), tracked), Equal.sym(LR.LRU<&2, V> & Maybe<&2, V>, LR.rd_expire(&2, V, $F, su, U32.from_nat(i), tracked), LR.rd_gone(&2, V, tracked, LR.drop_slot(&2, V, $F0($DT), su, 2)), E), ok)

def rd_gp(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, $RP, $HP, $RHX, +g: Bool) -> RM.POK(~V, Maybe<&2, V>, Bool.pick(SP.Lru<V> & Maybe<&2, V>, g, $EXP, $LIVE(tracked)), LR.rd_gone_pick(V, $F, su, U32.from_nat(i), tracked, g)):
  match g:
    case True{}:
      rd_ex(~V, $SHA, hg, key, now, tracked, $HPA, $RHXA)
    case False{}:
      rd_lf(~V, $SHA, hg, key, now, tracked, $HPA)

# a hit: the expiry test, then the live or the expired read
def rd_h(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, $RP, $HP, $RHX) -> RM.POK(~V, Maybe<&2, V>, $RF(Some{$EV}), LR.rd_hit(V, $F, su, U32.from_nat(i), now, tracked)):
