# Removing the oldest entry: evict_oldest (an eviction) and drop_head (a
# removal, for keys).

%include read.src

%def S0L Con{s0, t}
%def SH0 ST.LS{cap, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, $S0L, fl}
%def SHF0 +cap: U32, +n: U32, +head: U32, +tail: U32, +free: U32, +mT: AR.Tree<U32>, +k: Nat, +sd: Nat, +tabT: AR.Tree<U32>, +ksT: AR.Tree<String>, +eT: AR.Tree<Maybe<&2, V>>, +lkT: AR.Tree<U32>, +s0: Nat, +t: List<&2, Nat>, +fl: List<&2, Nat>
%def SHA0 cap, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, $S0L, fl
%def SHA0x cap, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, s0, t, fl
%def GA1 cap, n, head, tail, free, W32.nth0($ML, 0n), W32.nth0($ML, 1n), W32.nth0($ML, 2n), W32.nth0($ML, 6n), W32.nth0($ML, 7n), AR.perfect(U32, 5n, mT), k, sd, tabT, $KL, AR.perfect(String, sd, ksT), eT, lkT, $S0L, fl
%def G1(c) ST.g_$c(~V, $GA1, hg)
%def ES0(x) ST.es(~V, $LLo, $KL, $EL, x)
%def F1 ST.real(~V, $SH0)
%def SU H.slot(head)
%def W0 ST.lw($LLo, s0, 2n)

# the first entry has the first slot's key: dropping it is the tail
def drop_first(~V: Data, +ll: List<&2, U32>, +kl: List<&2, String>, +el: List<&2, Maybe<&2, V>>, +s0: Nat, +t: List<&2, Nat>, +v: V, +hm: {HT.nthm(~V, el, s0) == Some{v} : Maybe<&2, V>}) -> {SP.drop(~V, ST.es(~V, ll, kl, el, Con{s0, t}), ST.skey(ll, kl, s0)) == SP.tail(~V, ST.es(~V, ll, kl, el, Con{s0, t})) : List<&2, SP.Ent<V>>}:
  +e = TO.es_cons(~V, ll, kl, el, s0, v, hm, t)
  +d = L.subst(Bool, z => {Bool.pick(List<&2, SP.Ent<V>>, z, ST.es(~V, ll, kl, el, t), Con{TO.ev(~V, ll, kl, s0, v), SP.drop(~V, ST.es(~V, ll, kl, el, t), ST.skey(ll, kl, s0))}) == ST.es(~V, ll, kl, el, t) : List<&2, SP.Ent<V>>}, True{}, S.str_eq(ST.skey(ll, kl, s0), ST.skey(ll, kl, s0)), Equal.sym(Bool, S.str_eq(ST.skey(ll, kl, s0), ST.skey(ll, kl, s0)), True{}, K.str_refl(ST.skey(ll, kl, s0))), {==})
  L.subst(List<&2, SP.Ent<V>>, z => {SP.drop(~V, z, ST.skey(ll, kl, s0)) == SP.tail(~V, z) : List<&2, SP.Ent<V>>}, Con{TO.ev(~V, ll, kl, s0, v), ST.es(~V, ll, kl, el, t)}, ST.es(~V, ll, kl, el, Con{s0, t}), Equal.sym(List<&2, SP.Ent<V>>, ST.es(~V, ll, kl, el, Con{s0, t}), Con{TO.ev(~V, ll, kl, s0, v), ST.es(~V, ll, kl, el, t)}, e), d)

%def SPX_ev SP.L{cap, $M3, $W4, SP.tail(~V, $ES0($S0L)), SP.c_ev($CTR)}
%def SPD_ev (SP.L{cap, $M3, $W4, SP.drop(~V, $ES0($S0L), ST.skey($LLo, $KL, s0)), SP.c_ev($CTR)}, Some{v})

def dv_ev(~V: Data, $SHF0, +v: V, +hm: {HT.nthm(~V, $EL, s0) == Some{v} : Maybe<&2, V>}, -r: LR.LRU<&2, V> & Maybe<&2, V>, pk: RM.POK(~V, Maybe<&2, V>, $SPD_ev, r)) -> BS.CountOK(~V, $SPX_ev, LR.drop_v(&2, V, r)):
  match pk:
    case Tuple{+sh2, Tuple{+x, Tuple{+er, Tuple{+es, g2}}}}:
      +hm2 = L.pair_fst(SP.Lru<V>, Maybe<&2, V>, SP.L{cap, $M3, $W4, SP.drop(~V, $ES0($S0L), ST.skey($LLo, $KL, s0)), SP.c_ev($CTR)}, Some{v}, ST.model(~V, sh2), x, es)
      +ed = Equal.cong(List<&2, SP.Ent<V>>, SP.Lru<V>, z => SP.L{cap, $M3, $W4, z, SP.c_ev($CTR)}, SP.drop(~V, $ES0($S0L), ST.skey($LLo, $KL, s0)), SP.tail(~V, $ES0($S0L)), drop_first(~V, $LLo, $KL, $EL, s0, t, v, hm))
      +em = Equal.trans(SP.Lru<V>, ST.model(~V, sh2), SP.L{cap, $M3, $W4, SP.drop(~V, $ES0($S0L), ST.skey($LLo, $KL, s0)), SP.c_ev($CTR)}, $SPX_ev, Equal.sym(SP.Lru<V>, SP.L{cap, $M3, $W4, SP.drop(~V, $ES0($S0L), ST.skey($LLo, $KL, s0)), SP.c_ev($CTR)}, ST.model(~V, sh2), hm2), ed)
      (sh2, (Equal.cong(LR.LRU<&2, V> & Maybe<&2, V>, LR.LRU<&2, V>, z => LR.drop_v(&2, V, z), r, (ST.real(~V, sh2), x), er), (em, g2)))

%def DL0 LR.del_link(AR.thaw(U32, tabT), CY.msk(k), $W0, H.link($SU))
%def FT(x) LR.F{cap, n, head, tail, free, AR.thaw(U32, mT), x, AR.thaw(String, ksT), AR.thaw(Maybe<&2, V>, eT), AR.thaw(U32, lkT)}

%def DTe H.del_at(AR.thaw(U32, tabT), CY.msk(k), U32.from_nat(e))

def eb_ev(~V: Data, $SHF0, +hg: {ST.good(~V, $SH0) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +v: V, +hm: {HT.nthm(~V, $EL, s0) == Some{v} : Maybe<&2, V>}, +hsv: {UD.v($SU) == s0 : Nat}, +e: Nat, +he: {Nat.is_lt(e, $NN) == True{} : Bool}, +b: B.Bk, +hbe0: {B.at($BS, e) == b : B.Bk}, +hb: {ST.isbf(b, $W0, LK.lnk(s0)) == True{} : Bool}, +hk31: {Nat.is_lt(k, 31n) == True{} : Bool}, +el: {H.link($SU) == LK.lnk(s0) : U32}) -> BS.CountOK(~V, $SPX_ev, LR.drop_v(&2, V, LR.drop_slot(&2, V, $FT($DL0), $SU, 1))):
  match b:
    case B.BE{}:
      Empty.absurd(BS.CountOK(~V, $SPX_ev, LR.drop_v(&2, V, LR.drop_slot(&2, V, $FT($DL0), $SU, 1))), L.false_true(hb))
    case B.BF{+w2, +l2, +k2}:
      +ew = A.eq_of(w2, $W0, L.and_left(U32.is_eq(w2, $W0), U32.is_eq(l2, LK.lnk(s0)), hb))
      +elk = A.eq_of(l2, LK.lnk(s0), L.and_right(U32.is_eq(w2, $W0), U32.is_eq(l2, LK.lnk(s0)), hb))
      +hbe = Equal.trans(B.Bk, B.at($BS, e), B.BF{w2, l2, k2}, B.BF{$W0, LK.lnk(s0), k2}, hbe0, Equal.trans(B.Bk, B.BF{w2, l2, k2}, B.BF{$W0, l2, k2}, B.BF{$W0, LK.lnk(s0), k2}, Equal.cong(U32, B.Bk, z => B.BF{z, l2, k2}, w2, $W0, ew), Equal.cong(U32, B.Bk, z => B.BF{$W0, z, k2}, l2, LK.lnk(s0), elk)))
      +hoi = L.subst(B.Bk, z => {B.occ(z) == True{} : Bool}, B.BF{$W0, LK.lnk(s0), k2}, B.at($BS, e), Equal.sym(B.Bk, B.at($BS, e), B.BF{$W0, LK.lnk(s0), k2}, hbe), {==})
      +hsd = RD.f_hsd(~V, $SHA0, hg)
      +hs0 = RD.f_s0(~V, $SHA0, hg, s0, UL.self_in(s0, t))
      +hsi = Equal.trans(Nat, UD.v(H.slot(B.lnk(B.at($BS, e)))), UD.v(H.slot(LK.lnk(s0))), s0, Equal.cong(B.Bk, Nat, z => UD.v(H.slot(B.lnk(z))), B.at($BS, e), B.BF{$W0, LK.lnk(s0), k2}, hbe), UL.ix_o(one, h1, s0, sd, hsd, hs0))
      +edl = Equal.trans(Array<U32>, $DL0, LR.del_link(AR.thaw(U32, tabT), CY.msk(k), $W0, LK.lnk(s0)), $DTe, Equal.cong(U32, Array<U32>, z => LR.del_link(AR.thaw(U32, tabT), CY.msk(k), $W0, z), H.link($SU), LK.lnk(s0), el), DK.del_link_ok(one, h1, k, hk31, tabT, $G1(cpt), $KL, $G1(cclus), $G1(cuniq), e, he, $W0, LK.lnk(s0), k2, hbe))
      ok = dv_ev(~V, $SHA0x, v, hm, LR.drop_slot(&2, V, $FT($DTe), $SU, 1), RM.rm_at_ev(~V, cap, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, $S0L, fl, hg, s0, UL.self_in(s0, t), one, h1, e, he, hoi, hsi, $SU, hsv, v, hm, ST.skey($LLo, $KL, s0), K.str_refl(ST.skey($LLo, $KL, s0))))
      L.subst(Array<U32>, z => BS.CountOK(~V, $SPX_ev, LR.drop_v(&2, V, LR.drop_slot(&2, V, $FT(z), $SU, 1))), $DTe, $DL0, Equal.sym(Array<U32>, $DL0, $DTe, edl), ok)

def ek_ev(~V: Data, $SHF0, +hg: {ST.good(~V, $SH0) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +v: V, +hm: {HT.nthm(~V, $EL, s0) == Some{v} : Maybe<&2, V>}, +hsv: {UD.v($SU) == s0 : Nat}, ea: TS.AnybAt($BS, $NN, LK.lnk(s0), $W0)) -> BS.CountOK(~V, $SPX_ev, LR.drop_v(&2, V, LR.drop_slot(&2, V, $FT($DL0), $SU, 1))):
  match ea:
    case Tuple{+e, Tuple{+he, hb}}:
      +hsd = RD.f_hsd(~V, $SHA0, hg)
      +hs0 = RD.f_s0(~V, $SHA0, hg, s0, UL.self_in(s0, t))
      +el = LT.lnk_su($SU, s0, sd, hsd, hsv, hs0)
      +hk31 = N.lt_trans(k, 30n, 31n, L.and_left(Nat.is_lt(k, 30n), Nat.is_lt(0n, k), $G1(ck)), {==})
      eb_ev(~V, $SHA0x, hg, one, h1, v, hm, hsv, e, he, B.at($BS, e), {==}, hb, hk31, el)

%def RS(c) LR.remove_slot(&2, V, $F1, $SU, c)

def ev_m_ev(~V: Data, $SHF0, +hg: {ST.good(~V, $SH0) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +m: Maybe<&2, V>, +hmm: {HT.nthm(~V, $EL, s0) == m : Maybe<&2, V>}, +hsm: {HT.some_b(~V, m) == True{} : Bool}, +hsv: {UD.v($SU) == s0 : Nat}) -> BS.CountOK(~V, $SPX_ev, LR.drop_v(&2, V, $RS(1))):
  match m:
    case None{}:
      Empty.absurd(BS.CountOK(~V, $SPX_ev, LR.drop_v(&2, V, $RS(1))), L.false_true(hsm))
    case Some{+v}:
      +hm = {hmm : {HT.nthm(~V, $EL, s0) == Some{v} : Maybe<&2, V>}}
      +hsd = RD.f_hsd(~V, $SHA0, hg)
      +hs0 = RD.f_s0(~V, $SHA0, hg, s0, UL.self_in(s0, t))
      +hk31 = N.lt_trans(k, 30n, 31n, L.and_left(Nat.is_lt(k, 30n), Nat.is_lt(0n, k), $G1(ck)), {==})
      +ha = L.and_left(ST.anyb($BS, $NN, LK.lnk(s0), $W0), ST.hasall(~V, $BS, $NN, $LLo, t), $G1(chas))
      ok = ek_ev(~V, $SHA0x, hg, one, h1, v, hm, hsv, TS.find_anyb($BS, $NN, LK.lnk(s0), $W0, ha))
      +hsu = GO.su_lt($SU, s0, sd, hsv, hs0)
      +i2 = Equal.trans(Nat, UD.v(LR.hidx($SU)), ST.off(UD.v($SU), 2n), ST.off(s0, 2n), ID.w2(one, h1, $SU, sd, UL.sd3(sd, hsd), hsu), Equal.cong(Nat, Nat, z => ST.off(z, 2n), UD.v($SU), s0, hsv))
      +E2 = Equal.cong(Array<U32> & U32, LR.LRU<&2, V> & Maybe<&2, V>, r => LR.dl_h(&2, V, cap, n, head, tail, free, AR.thaw(U32, tabT), AR.thaw(String, ksT), AR.thaw(Maybe<&2, V>, eT), $SU, 1, CY.msk(k), AR.thaw(U32, mT), r), Array.get(U32, AR.thaw(U32, lkT), LR.hidx($SU)), (AR.thaw(U32, lkT), $W0), GO.rd(one, h1, lkT, sd, hsd, $G1(cpl), LR.hidx($SU), s0, 2n, {==}, hs0, i2))
      +G6 = Equal.trans(Array<U32> & U32, Array.get(U32, AR.thaw(U32, mT), 6), (AR.thaw(U32, mT), W32.nth0($ML, 6n)), (AR.thaw(U32, mT), CY.msk(k)), UT.uget(5n, {==}, mT, $G1(cpm), 6, {==}), Equal.cong(U32, Array<U32> & U32, z => (AR.thaw(U32, mT), z), W32.nth0($ML, 6n), CY.msk(k), A.eq_of(W32.nth0($ML, 6n), CY.msk(k), $G1(cmask))))
      +E1 = Equal.cong(Array<U32> & U32, LR.LRU<&2, V> & Maybe<&2, V>, r => LR.dl_m(&2, V, cap, n, head, tail, free, AR.thaw(U32, tabT), AR.thaw(String, ksT), AR.thaw(Maybe<&2, V>, eT), AR.thaw(U32, lkT), $SU, 1, r), Array.get(U32, AR.thaw(U32, mT), 6), (AR.thaw(U32, mT), CY.msk(k)), G6)
      +E = Equal.trans(LR.LRU<&2, V> & Maybe<&2, V>, $RS(1), LR.dl_h(&2, V, cap, n, head, tail, free, AR.thaw(U32, tabT), AR.thaw(String, ksT), AR.thaw(Maybe<&2, V>, eT), $SU, 1, CY.msk(k), AR.thaw(U32, mT), Array.get(U32, AR.thaw(U32, lkT), LR.hidx($SU))), LR.drop_slot(&2, V, $FT($DL0), $SU, 1), E1, E2)
      L.subst(LR.LRU<&2, V> & Maybe<&2, V>, z => BS.CountOK(~V, $SPX_ev, LR.drop_v(&2, V, z)), LR.drop_slot(&2, V, $FT($DL0), $SU, 1), $RS(1), Equal.sym(LR.LRU<&2, V> & Maybe<&2, V>, $RS(1), LR.drop_slot(&2, V, $FT($DL0), $SU, 1), E), ok)

# THEOREM: the oldest entry removed (c_ev counted); the model's tail
def old_ev(~V: Data, $SHF0, +hg: {ST.good(~V, $SH0) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}) -> BS.CountOK(~V, $SPX_ev, LR.drop_v(&2, V, $RS(1))):
  +hsd = RD.f_hsd(~V, $SHA0, hg)
  +hs0 = RD.f_s0(~V, $SHA0, hg, s0, UL.self_in(s0, t))
  +eh = A.eq_of(head, LK.lnk(s0), $G1(chead))
  +hsv = Equal.trans(Nat, UD.v($SU), UD.v(H.slot(LK.lnk(s0))), s0, Equal.cong(U32, Nat, z => UD.v(H.slot(z)), head, LK.lnk(s0), eh), UL.ix_o(one, h1, s0, sd, hsd, hs0))
  +hls = L.and_left(Bool.and(Nat.is_lt(s0, $FR), ST.live(~V, $EL, s0)), ST.slok(~V, t, $FR, $EL), $G1(csl))
  ev_m_ev(~V, $SHA0x, hg, one, h1, HT.nthm(~V, $EL, s0), {==}, L.and_right(Nat.is_lt(s0, $FR), ST.live(~V, $EL, s0), hls), hsv)

%def DTe H.del_at(AR.thaw(U32, tabT), CY.msk(k), U32.from_nat(e))

%def SPX_rm SP.L{cap, $M3, $W4, SP.tail(~V, $ES0($S0L)), SP.c_rm($CTR)}
%def SPD_rm (SP.L{cap, $M3, $W4, SP.drop(~V, $ES0($S0L), ST.skey($LLo, $KL, s0)), SP.c_rm($CTR)}, Some{v})

def dv_rm(~V: Data, $SHF0, +v: V, +hm: {HT.nthm(~V, $EL, s0) == Some{v} : Maybe<&2, V>}, -r: LR.LRU<&2, V> & Maybe<&2, V>, pk: RM.POK(~V, Maybe<&2, V>, $SPD_rm, r)) -> BS.CountOK(~V, $SPX_rm, LR.drop_v(&2, V, r)):
  match pk:
    case Tuple{+sh2, Tuple{+x, Tuple{+er, Tuple{+es, g2}}}}:
      +hm2 = L.pair_fst(SP.Lru<V>, Maybe<&2, V>, SP.L{cap, $M3, $W4, SP.drop(~V, $ES0($S0L), ST.skey($LLo, $KL, s0)), SP.c_rm($CTR)}, Some{v}, ST.model(~V, sh2), x, es)
      +ed = Equal.cong(List<&2, SP.Ent<V>>, SP.Lru<V>, z => SP.L{cap, $M3, $W4, z, SP.c_rm($CTR)}, SP.drop(~V, $ES0($S0L), ST.skey($LLo, $KL, s0)), SP.tail(~V, $ES0($S0L)), drop_first(~V, $LLo, $KL, $EL, s0, t, v, hm))
      +em = Equal.trans(SP.Lru<V>, ST.model(~V, sh2), SP.L{cap, $M3, $W4, SP.drop(~V, $ES0($S0L), ST.skey($LLo, $KL, s0)), SP.c_rm($CTR)}, $SPX_rm, Equal.sym(SP.Lru<V>, SP.L{cap, $M3, $W4, SP.drop(~V, $ES0($S0L), ST.skey($LLo, $KL, s0)), SP.c_rm($CTR)}, ST.model(~V, sh2), hm2), ed)
      (sh2, (Equal.cong(LR.LRU<&2, V> & Maybe<&2, V>, LR.LRU<&2, V>, z => LR.drop_v(&2, V, z), r, (ST.real(~V, sh2), x), er), (em, g2)))


def eb_rm(~V: Data, $SHF0, +hg: {ST.good(~V, $SH0) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +v: V, +hm: {HT.nthm(~V, $EL, s0) == Some{v} : Maybe<&2, V>}, +hsv: {UD.v($SU) == s0 : Nat}, +e: Nat, +he: {Nat.is_lt(e, $NN) == True{} : Bool}, +b: B.Bk, +hbe0: {B.at($BS, e) == b : B.Bk}, +hb: {ST.isbf(b, $W0, LK.lnk(s0)) == True{} : Bool}, +hk31: {Nat.is_lt(k, 31n) == True{} : Bool}, +el: {H.link($SU) == LK.lnk(s0) : U32}) -> BS.CountOK(~V, $SPX_rm, LR.drop_v(&2, V, LR.drop_slot(&2, V, $FT($DL0), $SU, 2))):
  match b:
    case B.BE{}:
      Empty.absurd(BS.CountOK(~V, $SPX_rm, LR.drop_v(&2, V, LR.drop_slot(&2, V, $FT($DL0), $SU, 2))), L.false_true(hb))
    case B.BF{+w2, +l2, +k2}:
      +ew = A.eq_of(w2, $W0, L.and_left(U32.is_eq(w2, $W0), U32.is_eq(l2, LK.lnk(s0)), hb))
      +elk = A.eq_of(l2, LK.lnk(s0), L.and_right(U32.is_eq(w2, $W0), U32.is_eq(l2, LK.lnk(s0)), hb))
      +hbe = Equal.trans(B.Bk, B.at($BS, e), B.BF{w2, l2, k2}, B.BF{$W0, LK.lnk(s0), k2}, hbe0, Equal.trans(B.Bk, B.BF{w2, l2, k2}, B.BF{$W0, l2, k2}, B.BF{$W0, LK.lnk(s0), k2}, Equal.cong(U32, B.Bk, z => B.BF{z, l2, k2}, w2, $W0, ew), Equal.cong(U32, B.Bk, z => B.BF{$W0, z, k2}, l2, LK.lnk(s0), elk)))
      +hoi = L.subst(B.Bk, z => {B.occ(z) == True{} : Bool}, B.BF{$W0, LK.lnk(s0), k2}, B.at($BS, e), Equal.sym(B.Bk, B.at($BS, e), B.BF{$W0, LK.lnk(s0), k2}, hbe), {==})
      +hsd = RD.f_hsd(~V, $SHA0, hg)
      +hs0 = RD.f_s0(~V, $SHA0, hg, s0, UL.self_in(s0, t))
      +hsi = Equal.trans(Nat, UD.v(H.slot(B.lnk(B.at($BS, e)))), UD.v(H.slot(LK.lnk(s0))), s0, Equal.cong(B.Bk, Nat, z => UD.v(H.slot(B.lnk(z))), B.at($BS, e), B.BF{$W0, LK.lnk(s0), k2}, hbe), UL.ix_o(one, h1, s0, sd, hsd, hs0))
      +edl = Equal.trans(Array<U32>, $DL0, LR.del_link(AR.thaw(U32, tabT), CY.msk(k), $W0, LK.lnk(s0)), $DTe, Equal.cong(U32, Array<U32>, z => LR.del_link(AR.thaw(U32, tabT), CY.msk(k), $W0, z), H.link($SU), LK.lnk(s0), el), DK.del_link_ok(one, h1, k, hk31, tabT, $G1(cpt), $KL, $G1(cclus), $G1(cuniq), e, he, $W0, LK.lnk(s0), k2, hbe))
      ok = dv_rm(~V, $SHA0x, v, hm, LR.drop_slot(&2, V, $FT($DTe), $SU, 2), RM.rm_at_rm(~V, cap, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, $S0L, fl, hg, s0, UL.self_in(s0, t), one, h1, e, he, hoi, hsi, $SU, hsv, v, hm, ST.skey($LLo, $KL, s0), K.str_refl(ST.skey($LLo, $KL, s0))))
      L.subst(Array<U32>, z => BS.CountOK(~V, $SPX_rm, LR.drop_v(&2, V, LR.drop_slot(&2, V, $FT(z), $SU, 2))), $DTe, $DL0, Equal.sym(Array<U32>, $DL0, $DTe, edl), ok)

%def RS(c) LR.remove_slot(&2, V, $F1, $SU, c)

def ek_rm(~V: Data, $SHF0, +hg: {ST.good(~V, $SH0) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +v: V, +hm: {HT.nthm(~V, $EL, s0) == Some{v} : Maybe<&2, V>}, +hsv: {UD.v($SU) == s0 : Nat}, ea: TS.AnybAt($BS, $NN, LK.lnk(s0), $W0)) -> BS.CountOK(~V, $SPX_rm, LR.drop_v(&2, V, LR.drop_slot(&2, V, $FT($DL0), $SU, 2))):
  match ea:
    case Tuple{+e, Tuple{+he, hb}}:
      +hsd = RD.f_hsd(~V, $SHA0, hg)
      +hs0 = RD.f_s0(~V, $SHA0, hg, s0, UL.self_in(s0, t))
      +el = LT.lnk_su($SU, s0, sd, hsd, hsv, hs0)
      +hk31 = N.lt_trans(k, 30n, 31n, L.and_left(Nat.is_lt(k, 30n), Nat.is_lt(0n, k), $G1(ck)), {==})
      eb_rm(~V, $SHA0x, hg, one, h1, v, hm, hsv, e, he, B.at($BS, e), {==}, hb, hk31, el)

def ev_m_rm(~V: Data, $SHF0, +hg: {ST.good(~V, $SH0) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +m: Maybe<&2, V>, +hmm: {HT.nthm(~V, $EL, s0) == m : Maybe<&2, V>}, +hsm: {HT.some_b(~V, m) == True{} : Bool}, +hsv: {UD.v($SU) == s0 : Nat}) -> BS.CountOK(~V, $SPX_rm, LR.drop_v(&2, V, $RS(2))):
  match m:
    case None{}:
      Empty.absurd(BS.CountOK(~V, $SPX_rm, LR.drop_v(&2, V, $RS(2))), L.false_true(hsm))
    case Some{+v}:
      +hm = {hmm : {HT.nthm(~V, $EL, s0) == Some{v} : Maybe<&2, V>}}
      +hsd = RD.f_hsd(~V, $SHA0, hg)
      +hs0 = RD.f_s0(~V, $SHA0, hg, s0, UL.self_in(s0, t))
      +hk31 = N.lt_trans(k, 30n, 31n, L.and_left(Nat.is_lt(k, 30n), Nat.is_lt(0n, k), $G1(ck)), {==})
      +ha = L.and_left(ST.anyb($BS, $NN, LK.lnk(s0), $W0), ST.hasall(~V, $BS, $NN, $LLo, t), $G1(chas))
      ok = ek_rm(~V, $SHA0x, hg, one, h1, v, hm, hsv, TS.find_anyb($BS, $NN, LK.lnk(s0), $W0, ha))
      +hsu = GO.su_lt($SU, s0, sd, hsv, hs0)
      +i2 = Equal.trans(Nat, UD.v(LR.hidx($SU)), ST.off(UD.v($SU), 2n), ST.off(s0, 2n), ID.w2(one, h1, $SU, sd, UL.sd3(sd, hsd), hsu), Equal.cong(Nat, Nat, z => ST.off(z, 2n), UD.v($SU), s0, hsv))
      +E2 = Equal.cong(Array<U32> & U32, LR.LRU<&2, V> & Maybe<&2, V>, r => LR.dl_h(&2, V, cap, n, head, tail, free, AR.thaw(U32, tabT), AR.thaw(String, ksT), AR.thaw(Maybe<&2, V>, eT), $SU, 2, CY.msk(k), AR.thaw(U32, mT), r), Array.get(U32, AR.thaw(U32, lkT), LR.hidx($SU)), (AR.thaw(U32, lkT), $W0), GO.rd(one, h1, lkT, sd, hsd, $G1(cpl), LR.hidx($SU), s0, 2n, {==}, hs0, i2))
      +G6 = Equal.trans(Array<U32> & U32, Array.get(U32, AR.thaw(U32, mT), 6), (AR.thaw(U32, mT), W32.nth0($ML, 6n)), (AR.thaw(U32, mT), CY.msk(k)), UT.uget(5n, {==}, mT, $G1(cpm), 6, {==}), Equal.cong(U32, Array<U32> & U32, z => (AR.thaw(U32, mT), z), W32.nth0($ML, 6n), CY.msk(k), A.eq_of(W32.nth0($ML, 6n), CY.msk(k), $G1(cmask))))
      +E1 = Equal.cong(Array<U32> & U32, LR.LRU<&2, V> & Maybe<&2, V>, r => LR.dl_m(&2, V, cap, n, head, tail, free, AR.thaw(U32, tabT), AR.thaw(String, ksT), AR.thaw(Maybe<&2, V>, eT), AR.thaw(U32, lkT), $SU, 2, r), Array.get(U32, AR.thaw(U32, mT), 6), (AR.thaw(U32, mT), CY.msk(k)), G6)
      +E = Equal.trans(LR.LRU<&2, V> & Maybe<&2, V>, $RS(2), LR.dl_h(&2, V, cap, n, head, tail, free, AR.thaw(U32, tabT), AR.thaw(String, ksT), AR.thaw(Maybe<&2, V>, eT), $SU, 2, CY.msk(k), AR.thaw(U32, mT), Array.get(U32, AR.thaw(U32, lkT), LR.hidx($SU))), LR.drop_slot(&2, V, $FT($DL0), $SU, 2), E1, E2)
      L.subst(LR.LRU<&2, V> & Maybe<&2, V>, z => BS.CountOK(~V, $SPX_rm, LR.drop_v(&2, V, z)), LR.drop_slot(&2, V, $FT($DL0), $SU, 2), $RS(2), Equal.sym(LR.LRU<&2, V> & Maybe<&2, V>, $RS(2), LR.drop_slot(&2, V, $FT($DL0), $SU, 2), E), ok)

# THEOREM: the oldest entry removed (c_rm counted); the model's tail
def old_rm(~V: Data, $SHF0, +hg: {ST.good(~V, $SH0) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}) -> BS.CountOK(~V, $SPX_rm, LR.drop_v(&2, V, $RS(2))):
  +hsd = RD.f_hsd(~V, $SHA0, hg)
  +hs0 = RD.f_s0(~V, $SHA0, hg, s0, UL.self_in(s0, t))
  +eh = A.eq_of(head, LK.lnk(s0), $G1(chead))
  +hsv = Equal.trans(Nat, UD.v($SU), UD.v(H.slot(LK.lnk(s0))), s0, Equal.cong(U32, Nat, z => UD.v(H.slot(z)), head, LK.lnk(s0), eh), UL.ix_o(one, h1, s0, sd, hsd, hs0))
  +hls = L.and_left(Bool.and(Nat.is_lt(s0, $FR), ST.live(~V, $EL, s0)), ST.slok(~V, t, $FR, $EL), $G1(csl))
  ev_m_rm(~V, $SHA0x, hg, one, h1, HT.nthm(~V, $EL, s0), {==}, L.and_right(Nat.is_lt(s0, $FR), ST.live(~V, $EL, s0), hls), hsv)
