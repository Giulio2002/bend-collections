  UT.uset_p(5n, AR.upd(U32, 5n, AR.upd(U32, 5n, AR.upd(U32, 5n, AR.upd(U32, 5n, AR.upd(U32, 5n, AR.upd(U32, 5n, AR.upd(U32, 5n, AR.upd(U32, 5n, AR.upd(U32, 5n, AR.upd(U32, 5n, mT, 0n, 0), 16n, 0), 17n, 0), 18n, 0), 19n, 0), 20n, 0), 21n, 0), 22n, 0), 23n, 0), 24n, 0), p10, 25n, 0)

