%def Z(j) W32.nth0($MLZ, j)
%def TE AR.trep(U32, 1n+k, 0)
%def BSZ TB.buckets(AR.slots(U32, $TE), $KL, $NN)
%def GBZ cap, 0, 0, 0, 0, $Z(0n), $Z(1n), $Z(2n), $Z(6n), $Z(7n), AR.perfect(U32, 5n, $TZ), k, sd, $TE, $KL, AR.perfect(String, sd, ksT), eT, lkT, Nil{}, Nil{}
%def SHZ ST.LS{cap, 0, 0, 0, 0, $TZ, k, sd, $TE, ksT, eT, lkT, Nil{}, Nil{}}

def good_z(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}) -> {ST.good(~V, $SHZ) == True{} : Bool}:
  +pm = $G(cpm)
  +z0 = zw0(mT, pm)
  +hmask = L.subst(U32, z => {U32.is_eq(z, CY.msk(k)) == True{} : Bool}, W32.nth0($ML, 6n), $Z(6n), Equal.sym(U32, $Z(6n), W32.nth0($ML, 6n), zw6(mT, pm)), $G(cmask))
  +hbits = L.subst(U32, z => {Nat.is_eq(UD.v(z), k) == True{} : Bool}, W32.nth0($ML, 7n), $Z(7n), Equal.sym(U32, $Z(7n), W32.nth0($ML, 7n), zw7(mT, pm)), $G(cbits))
  +hsize = L.subst(U32, z => {Nat.is_eq(UD.v(z), SC.pow2(sd)) == True{} : Bool}, W32.nth0($ML, 1n), $Z(1n), Equal.sym(U32, $Z(1n), W32.nth0($ML, 1n), zw1(mT, pm)), $G(csize))
  +hdepth = L.subst(U32, z => {Nat.is_eq(UD.v(z), sd) == True{} : Bool}, W32.nth0($ML, 2n), $Z(2n), Equal.sym(U32, $Z(2n), W32.nth0($ML, 2n), zw2(mT, pm)), $G(cdepth))
  +hfresh = L.subst(U32, z => {Nat.is_le(UD.v(z), SC.pow2(sd)) == True{} : Bool}, 0, $Z(0n), Equal.sym(U32, $Z(0n), 0, z0), N.zero_le(SC.pow2(sd)))
  +hn = L.subst(Nat, z => {Nat.is_eq(0n, z) == True{} : Bool}, 0n, IV.occn($BSZ, $NN), Equal.sym(Nat, IV.occn($BSZ, $NN), 0n, GR.z_occn(1n+k, $KL, $NN, $NN, N.le_refl($NN))), {==})
  +hcnt = L.subst(U32, z => {Nat.is_eq(0n, UD.v(z)) == True{} : Bool}, 0, $Z(0n), Equal.sym(U32, $Z(0n), 0, z0), {==})
  ST.good_intro(~V, $GBZ, $G(ck), $G(csdk), AR.trep_perfect(U32, 1n+k, 0), $G(cpk), $G(cpe), $G(cpl), zp(mT, pm), hmask, hbits, hsize, hdepth, hfresh, GR.z_well(1n+k, $KL, $NN, sd, $NN, N.le_refl($NN)), GR.z_clus(1n+k, $KL, $NN, CY.msk(k), $NN, N.le_refl($NN)), GR.z_uniq(1n+k, $KL, $NN, $NN, N.le_refl($NN)), hn, N.zero_le($NN), $G(ccap), z_bsl(1n+k, $KL, $NN, Nil{}, AR.slots(U32, lkT), $NN, N.le_refl($NN)), {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, hcnt)

def model_z(~V: Data, $SHF, +pm: {AR.perfect(U32, 5n, mT) == True{} : Bool}) -> {ST.model(~V, $SHZ) == SP.L{cap, $M3, $W4, Nil{}, SP.zero_ctr()} : SP.Lru<V>}:
  +e4 = BA.w64_eq($MLZ, $ML, 4n, zw4(mT, pm), zw5(mT, pm))
  +ec = BA.ct5(ST.w64($MLZ, 16n), ST.w64($MLZ, 18n), ST.w64($MLZ, 20n), ST.w64($MLZ, 22n), ST.w64($MLZ, 24n), W.zero(), W.zero(), W.zero(), W.zero(), W.zero(), BA.w64_eq_l($MLZ, 16n, 0, 0, zw16(mT, pm), zw17(mT, pm)), BA.w64_eq_l($MLZ, 18n, 0, 0, zw18(mT, pm), zw19(mT, pm)), BA.w64_eq_l($MLZ, 20n, 0, 0, zw20(mT, pm), zw21(mT, pm)), BA.w64_eq_l($MLZ, 22n, 0, 0, zw22(mT, pm), zw23(mT, pm)), BA.w64_eq_l($MLZ, 24n, 0, 0, zw24(mT, pm), zw25(mT, pm)))
  BA.lru_eq(~V, cap, $Z(3n), $M3, ST.w64($MLZ, 4n), $W4, Nil{}, Nil{}, ST.ctr($MLZ), SP.zero_ctr(), zw3(mT, pm), e4, {==}, ec)

def pow2_gt(+k: Nat) -> {Nat.is_lt(k, SC.pow2(k)) == True{} : Bool}:
  match k:
    case 0n:
      {==}
    case 1n+p:
      N.le_lt_trans(1n+p, SC.pow2(p), SC.pow2(1n+p), N.lt_succ_le_succ(p, SC.pow2(p), pow2_gt(p)), N.pow2_lt_succ(p))

# THEOREM (purge): the specification's purge
def purge_sh(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}) -> RM.POK(~V, U32, SP.purge(~V, ST.model(~V, $SH)), LR.purge(&2, V, $F)):
  +pm = $G(cpm)
  +g7 = UT.uget(5n, {==}, mT, pm, 7, {==})
  +ek = N.eq_from_is_eq(UD.v(W32.nth0($ML, 7n)), k, $G(cbits))
  +hk = L.and_left(Nat.is_lt(k, 30n), Nat.is_lt(0n, k), $G(ck))
  +hb = L.subst(Nat, z => {Nat.is_lt(1n+z, WD.sc(32n, one)) == True{} : Bool}, k, UD.v(W32.nth0($ML, 7n)), Equal.sym(Nat, UD.v(W32.nth0($ML, 7n)), k, ek), N.le_lt_trans(1n+k, SC.pow2(k), WD.sc(32n, one), N.lt_succ_le_succ(k, SC.pow2(k), pow2_gt(k)), N.lt_le_trans(SC.pow2(k), SC.pow2(1n+k), WD.sc(32n, one), N.pow2_lt_succ(k), W32.pow_le32(one, h1, 1n+k, N.lt_trans(k, 30n, 31n, hk, {==})))))
  +eb = Equal.trans(Nat, U32.to_nat(U32.inc(W32.nth0($ML, 7n))), 1n+UD.v(W32.nth0($ML, 7n)), 1n+k, W32.inc_val(one, h1, W32.nth0($ML, 7n), hb), Equal.cong(Nat, Nat, z => 1n+z, UD.v(W32.nth0($ML, 7n)), k, ek))
  +en = Equal.trans(Array<U32>, Array.new(U32, U32.to_nat(U32.inc(W32.nth0($ML, 7n))), 0), Array.new(U32, 1n+k, 0), AR.thaw(U32, $TE), Equal.cong(Nat, Array<U32>, z => Array.new(U32, z, 0), U32.to_nat(U32.inc(W32.nth0($ML, 7n))), 1n+k, eb), AR.new(U32, 1n+k, 0))
  +E1 = Equal.cong(Array<U32> & U32, LR.LRU<&2, V> & U32, r => LR.purge_b(&2, V, cap, n, AR.thaw(String, ksT), AR.thaw(Maybe<&2, V>, eT), AR.thaw(U32, lkT), r), Array.get(U32, AR.thaw(U32, mT), 7), (AR.thaw(U32, mT), W32.nth0($ML, 7n)), g7)
  +E2 = Equal.cong(Array<U32>, LR.LRU<&2, V> & U32, z => (LR.F{cap, 0, 0, 0, 0, z, Array.new(U32, U32.to_nat(U32.inc(W32.nth0($ML, 7n))), 0), AR.thaw(String, ksT), AR.thaw(Maybe<&2, V>, eT), AR.thaw(U32, lkT)}, n), LR.zero_ctrs(AR.thaw(U32, mT)), AR.thaw(U32, $TZ), za(mT, pm))
  +E3 = Equal.cong(Array<U32>, LR.LRU<&2, V> & U32, z => (LR.F{cap, 0, 0, 0, 0, AR.thaw(U32, $TZ), z, AR.thaw(String, ksT), AR.thaw(Maybe<&2, V>, eT), AR.thaw(U32, lkT)}, n), Array.new(U32, U32.to_nat(U32.inc(W32.nth0($ML, 7n))), 0), AR.thaw(U32, $TE), en)
  +E = Equal.trans(LR.LRU<&2, V> & U32, LR.purge(&2, V, $F), (LR.F{cap, 0, 0, 0, 0, LR.zero_ctrs(AR.thaw(U32, mT)), Array.new(U32, U32.to_nat(U32.inc(W32.nth0($ML, 7n))), 0), AR.thaw(String, ksT), AR.thaw(Maybe<&2, V>, eT), AR.thaw(U32, lkT)}, n), (ST.real(~V, $SHZ), n), E1, Equal.trans(LR.LRU<&2, V> & U32, (LR.F{cap, 0, 0, 0, 0, LR.zero_ctrs(AR.thaw(U32, mT)), Array.new(U32, U32.to_nat(U32.inc(W32.nth0($ML, 7n))), 0), AR.thaw(String, ksT), AR.thaw(Maybe<&2, V>, eT), AR.thaw(U32, lkT)}, n), (LR.F{cap, 0, 0, 0, 0, AR.thaw(U32, $TZ), Array.new(U32, U32.to_nat(U32.inc(W32.nth0($ML, 7n))), 0), AR.thaw(String, ksT), AR.thaw(Maybe<&2, V>, eT), AR.thaw(U32, lkT)}, n), (ST.real(~V, $SHZ), n), E2, E3))
  +es = Equal.trans(SP.Lru<V> & U32, SP.purge(~V, ST.model(~V, $SH)), (SP.L{cap, $M3, $W4, Nil{}, SP.zero_ctr()}, n), (ST.model(~V, $SHZ), n), Equal.cong(U32, SP.Lru<V> & U32, z => (SP.L{cap, $M3, $W4, Nil{}, SP.zero_ctr()}, z), U32.from_nat(SP.length(~V, $ES)), n, RZ.n_len(~V, $SHA, hg)), Equal.cong(SP.Lru<V>, SP.Lru<V> & U32, z => (z, n), SP.L{cap, $M3, $W4, Nil{}, SP.zero_ctr()}, ST.model(~V, $SHZ), Equal.sym(SP.Lru<V>, ST.model(~V, $SHZ), SP.L{cap, $M3, $W4, Nil{}, SP.zero_ctr()}, model_z(~V, $SHA, pm))))
  ($SHZ, (n, (E, (es, good_z(~V, $SHA, hg)))))

def purge_ok(~V: Data, +one: Nat, +h1: {one == 1n : Nat}, +sh: ST.Sh<V>, +hg: {ST.good(~V, sh) == True{} : Bool}) -> RM.POK(~V, U32, SP.purge(~V, ST.model(~V, sh)), LR.purge(&2, V, ST.real(~V, sh))):
  match sh:
    case ST.LS{$SHA}:
      purge_sh(~V, $SHA, hg, one, h1)
