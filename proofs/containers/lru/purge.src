  +p2 = UT.uset_p(5n, AR.upd(U32, 5n, mT, 0n, 0), p1, 16n, 0)
  +p3 = UT.uset_p(5n, AR.upd(U32, 5n, AR.upd(U32, 5n, mT, 0n, 0), 16n, 0), p2, 17n, 0)
