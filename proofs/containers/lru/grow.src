def ip_grow(~V: Data, $BASE, +free2: U32, +hf2: {U32.is_eq(free2, 0) == True{} : Bool}, +hfz: {U32.is_eq(free, 0) == True{} : Bool}, +hr: {U32.is_lt($M0, $M1) == False{} : Bool}) -> BS.CountOK(~V, $SPEC, $FRM(AR.thaw(U32, mT), False{})):
