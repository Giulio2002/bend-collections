# add, a new key, a full arena: the arena doubles (a blank second half) and
# the new entry takes the next fresh slot.

%include read.src

%def KW K.kword(key)
%def KS PA.stored(key)
%def FE U32.from_nat(e)
%def T2(l) AR.upd(U32, 1n+k, AR.upd(U32, 1n+k, tabT, UD.v(U32.shl($FE)), $KW), UD.v(U32.inc(U32.shl($FE))), l)
%def EN SP.LE{key, v, t, W.U64{lo, hi}}
%def SPEC SP.L{cap, $M3, $W4, SP.snoc(~V, $ES, $EN), SP.c_ins($CTR)}
%def E LR.E{v, t, lo, hi}
%def M0 W32.nth0($ML, 0n)
%def M1 W32.nth0($ML, 1n)
%def M2 W32.nth0($ML, 2n)
%def SHFn +cap: U32, +n: U32, +head: U32, +tail: U32, +free: U32, +mT: AR.Tree<U32>, +k: Nat, +sd: Nat, +tabT: AR.Tree<U32>, +ksT: AR.Tree<String>, +eT: AR.Tree<Maybe<&2, V>>, +lkT: AR.Tree<U32>, +sl: List<&2, Nat>
%def SHAn cap, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, sl
%def SHN ST.LS{cap, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, sl, Nil{}}
%def GN(c) ST.g_$c(~V, cap, n, head, tail, free, W32.nth0($ML, 0n), W32.nth0($ML, 1n), W32.nth0($ML, 2n), W32.nth0($ML, 6n), W32.nth0($ML, 7n), AR.perfect(U32, 5n, mT), k, sd, tabT, $KL, AR.perfect(String, sd, ksT), eT, lkT, sl, Nil{}, hg)
%def RK AR.trep(String, sd, "")
%def RE AR.trep(Maybe<&2, V>, sd, None{})
%def RL AR.trep(U32, 3n+sd, 0)
%def KTG AR.TNode{ksT, $RK}
%def ETG AR.TNode{eT, $RE}
%def LTG AR.TNode{lkT, $RL}
%def MG1 AR.upd(U32, 5n, mT, 1n, U32.shl($M1))
%def MG AR.upd(U32, 5n, $MG1, 2n, U32.inc($M2))
%def MGL AR.slots(U32, $MG)
%def SHG ST.LS{cap, n, head, tail, free, $MG, k, 1n+sd, tabT, $KTG, $ETG, $LTG, sl, Nil{}}
%def KLG SC.append(String, $KL, AR.slots(String, $RK))
%def ELG SC.append(Maybe<&2, V>, $EL, AR.slots(Maybe<&2, V>, $RE))
%def LLG SC.append(U32, $LLo, AR.slots(U32, $RL))
%def BSG TB.buckets(AR.slots(U32, tabT), $KLG, $NN)
%def ESG ST.es(~V, $LLG, $KLG, $ELG, sl)
%def GW $SHFn, +hg: {ST.good(~V, $SHN) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +hroom: {Nat.is_le(Nat.double(1n+UD.v(n)), $NN) == True{} : Bool}, +hr: {U32.is_lt($M0, $M1) == False{} : Bool}
%def GWA $SHAn, hg, one, h1, hroom, hr
%def HS1 UT.uset_s(5n, mT, $GN(cpm), 1n, {==}, U32.shl($M1))
%def HS2 UT.uset_s(5n, $MG1, UT.uset_p(5n, mT, $GN(cpm), 1n, U32.shl($M1)), 2n, {==}, U32.inc($M2))
%def OG(j) Equal.trans(U32, W32.nth0($MGL, j), W32.nth0(AR.slots(U32, $MG1), j), W32.nth0($ML, j), MT.nth_other($MG1, 2n, U32.inc($M2), $MG, $HS2, j, {==}), MT.nth_other(mT, 1n, U32.shl($M1), $MG1, $HS1, j, {==}))

# THEOREM: the doubled arena keeps the invariant
def gw_good(~V: Data, $GW) -> {ST.good(~V, $SHG) == True{} : Bool}:
  +hsd = RD.f_hsd(~V, $SHAn, Nil{}, hg)
  +hsd1 = UL.sd1(sd, hsd)
  +hsd32 = N.lt_trans(sd, 1n+sd, 32n, N.lt_succ(sd), hsd1)
  +hk30 = L.and_left(Nat.is_lt(k, 30n), Nat.is_lt(0n, k), $GN(ck))
  +ehs = N.eq_from_is_eq(UD.v($M1), SC.pow2(sd), $GN(csize))
  +hle1 = L.subst(Nat, z => {Nat.is_le($FR, z) == True{} : Bool}, SC.pow2(sd), UD.v($M1), Equal.sym(Nat, UD.v($M1), SC.pow2(sd), ehs), $GN(cfresh))
  +hle2 = N.not_lt_le($FR, UD.v($M1), Equal.trans(Bool, Nat.is_lt($FR, UD.v($M1)), U32.is_lt($M0, $M1), False{}, Equal.sym(Bool, U32.is_lt($M0, $M1), Nat.is_lt($FR, UD.v($M1)), U.is_lt_nat($M0, $M1)), hr))
  +efp = Equal.trans(Nat, $FR, UD.v($M1), SC.pow2(sd), N.le_antisym($FR, UD.v($M1), hle1, hle2), ehs)
  +eln = Equal.trans(Nat, SC.length(Nat, sl), Nat.add(SC.length(Nat, sl), 0n), $FR, Equal.sym(Nat, Nat.add(SC.length(Nat, sl), 0n), SC.length(Nat, sl), N.add_zero(SC.length(Nat, sl))), N.eq_from_is_eq(Nat.add(SC.length(Nat, sl), 0n), $FR, $GN(cfcnt)))
  +env = Equal.trans(Nat, UD.v(n), SC.length(Nat, sl), SC.pow2(sd), Equal.sym(Nat, SC.length(Nat, sl), UD.v(n), N.eq_from_is_eq(SC.length(Nat, sl), UD.v(n), $GN(clen))), Equal.trans(Nat, SC.length(Nat, sl), $FR, SC.pow2(sd), eln, efp))
  +hrm = L.subst(Nat, z => {Nat.is_le(Nat.double(1n+z), $NN) == True{} : Bool}, UD.v(n), SC.pow2(sd), env, hroom)
  +hsdk2 = IG.pow2_lt_inv(1n+sd, k, N.lt_le_trans(SC.pow2(1n+sd), Nat.double(1n+SC.pow2(sd)), $NN, N.double_lt(SC.pow2(sd), 1n+SC.pow2(sd), N.lt_succ(SC.pow2(sd))), hrm))
  +hlk = AR.slots_length(String, sd, ksT, $GN(cpk))
  +hle = AR.slots_length(Maybe<&2, V>, sd, eT, $GN(cpe))
  +hll = AR.slots_length(U32, 3n+sd, lkT, $GN(cpl))
  +ebs = AN.bs_app(AR.slots(U32, tabT), $KL, AR.slots(String, $RK), sd, hlk, $NN, $GN(cwell))
  +esg = PR.es_pre(~V, $LLo, AR.slots(U32, $RL), sd, hll, $KL, AR.slots(String, $RK), hlk, $EL, AR.slots(Maybe<&2, V>, $RE), hle, $FR, $GN(cfresh), sl, $GN(csl))
  +esz = Equal.trans(Nat, UD.v(U32.shl($M1)), Nat.double(UD.v($M1)), SC.pow2(1n+sd), U.shl_value($M1, k, N.lt_le(k, 32n, N.lt_trans(k, 30n, 32n, hk30, {==})), L.subst(Nat, z => {Nat.is_lt(Nat.double(z), SC.pow2(k)) == True{} : Bool}, SC.pow2(sd), UD.v($M1), Equal.sym(Nat, UD.v($M1), SC.pow2(sd), ehs), N.pow2_strict(1n+sd, k, hsdk2))), Equal.cong(Nat, Nat, z => Nat.double(z), UD.v($M1), SC.pow2(sd), ehs))
  +edp0 = N.eq_from_is_eq(UD.v($M2), sd, $GN(cdepth))
  +hm5 = L.subst(Nat, z => {Nat.is_lt(z, SC.pow2(5n)) == True{} : Bool}, sd, UD.v($M2), Equal.sym(Nat, UD.v($M2), sd, edp0), hsd32)
  +edp = Equal.trans(Nat, UD.v(U32.inc($M2)), 1n+UD.v($M2), 1n+sd, W32.inc_val(one, h1, $M2, W32.bound32(one, h1, UD.v($M2), 5n, {==}, hm5)), Equal.cong(Nat, Nat, z => 1n+z, UD.v($M2), sd, edp0))
  +gx = ST.good_intro(~V, cap, n, head, tail, free, $M0, U32.shl($M1), U32.inc($M2), W32.nth0($ML, 6n), W32.nth0($ML, 7n), True{}, k, 1n+sd, tabT, $KLG, AR.perfect(String, 1n+sd, $KTG), $ETG, $LTG, sl, Nil{}, $GN(ck), hsdk2, $GN(cpt), L.and_intro(AR.perfect(String, sd, ksT), AR.perfect(String, sd, $RK), $GN(cpk), AR.trep_perfect(String, sd, "")), L.and_intro(AR.perfect(Maybe<&2, V>, sd, eT), AR.perfect(Maybe<&2, V>, sd, $RE), $GN(cpe), AR.trep_perfect(Maybe<&2, V>, sd, None{})), L.and_intro(AR.perfect(U32, 3n+sd, lkT), AR.perfect(U32, 3n+sd, $RL), $GN(cpl), AR.trep_perfect(U32, 3n+sd, 0)), {==}, $GN(cmask), $GN(cbits), IS.eq_is_eq(UD.v(U32.shl($M1)), SC.pow2(1n+sd), esz), IS.eq_is_eq(UD.v(U32.inc($M2)), 1n+sd, edp), N.le_trans($FR, SC.pow2(sd), SC.pow2(1n+sd), $GN(cfresh), N.lt_le(SC.pow2(sd), SC.pow2(1n+sd), N.pow2_lt_succ(sd))), L.subst(List<&2, B.Bk>, z => {B.all_lt(B.PWell{z, 1n+sd}, $NN) == True{} : Bool}, $BS, $BSG, Equal.sym(List<&2, B.Bk>, $BSG, $BS, ebs), AN.well_mono($BS, sd, 1n+sd, N.lt_le(SC.pow2(sd), SC.pow2(1n+sd), N.pow2_lt_succ(sd)), $NN, $GN(cwell), $NN, N.le_refl($NN))), L.subst(List<&2, B.Bk>, z => {B.cluster(z, $NN, CY.msk(k)) == True{} : Bool}, $BS, $BSG, Equal.sym(List<&2, B.Bk>, $BSG, $BS, ebs), $GN(cclus)), L.subst(List<&2, B.Bk>, z => {B.all_lt(B.PUniq{z}, $NN) == True{} : Bool}, $BS, $BSG, Equal.sym(List<&2, B.Bk>, $BSG, $BS, ebs), $GN(cuniq)), L.subst(List<&2, B.Bk>, z => {Nat.is_eq(UD.v(n), IV.occn(z, $NN)) == True{} : Bool}, $BS, $BSG, Equal.sym(List<&2, B.Bk>, $BSG, $BS, ebs), $GN(cn)), $GN(cload), $GN(ccap), L.subst(List<&2, B.Bk>, z => {ST.bsl(z, sl, $LLG, $NN) == True{} : Bool}, $BS, $BSG, Equal.sym(List<&2, B.Bk>, $BSG, $BS, ebs), Equal.trans(Bool, ST.bsl($BS, sl, $LLG, $NN), ST.bsl($BS, sl, $LLo, $NN), True{}, PR.bsl_pre($BS, sl, $LLo, AR.slots(U32, $RL), sd, hll, $NN, $GN(cwell)), $GN(cbsl))), L.subst(List<&2, B.Bk>, z => {ST.hasall(~V, z, $NN, $LLG, sl) == True{} : Bool}, $BS, $BSG, Equal.sym(List<&2, B.Bk>, $BSG, $BS, ebs), Equal.trans(Bool, ST.hasall(~V, $BS, $NN, $LLG, sl), ST.hasall(~V, $BS, $NN, $LLo, sl), True{}, PR.has_pre(~V, $BS, $NN, $LLo, AR.slots(U32, $RL), sd, hll, $EL, $FR, $GN(cfresh), sl, $GN(csl)), $GN(chas))), PR.slok_pre(~V, sd, $EL, AR.slots(Maybe<&2, V>, $RE), hle, $FR, $GN(cfresh), sl, $GN(csl)), $GN(cnd), $GN(clen), $GN(chead), $GN(ctail), Equal.trans(Bool, ST.seg($LLG, sl, 0, 0), ST.seg($LLo, sl, 0, 0), True{}, PR.seg_pre(~V, $LLo, AR.slots(U32, $RL), sd, hll, $EL, $FR, $GN(cfresh), sl, $GN(csl), 0, 0), $GN(cdll)), L.subst(List<&2, SP.Ent<V>>, z => {S.nodup(SP.keys_of(~V, z)) == True{} : Bool}, $ES, $ESG, Equal.sym(List<&2, SP.Ent<V>>, $ESG, $ES, esg), $GN(ckeys)), $GN(cfree), {==}, {==}, {==}, $GN(cfcnt))
  +p1 = UT.uset_p(5n, mT, $GN(cpm), 1n, U32.shl($M1))
  +e1 = Equal.trans(U32, W32.nth0($MGL, 1n), W32.nth0(AR.slots(U32, $MG1), 1n), U32.shl($M1), MT.nth_other($MG1, 2n, U32.inc($M2), $MG, $HS2, 1n, {==}), MT.nth_same(5n, mT, $GN(cpm), 1n, {==}, U32.shl($M1), $MG1, $HS1))
  +e2 = MT.nth_same(5n, $MG1, p1, 2n, {==}, U32.inc($M2), $MG, $HS2)
  RO.good_mk(~V, cap, n, head, tail, free, $MG, $M0, U32.shl($M1), U32.inc($M2), W32.nth0($ML, 6n), W32.nth0($ML, 7n), k, 1n+sd, tabT, $KTG, $ETG, $LTG, sl, Nil{}, gx, $OG(0n), e1, e2, $OG(6n), $OG(7n), UT.uset_p(5n, $MG1, p1, 2n, U32.inc($M2)))

# ... and the model's entries
def gw_es(~V: Data, $GW) -> {$ESG == $ES : List<&2, SP.Ent<V>>}:
  +hsd = RD.f_hsd(~V, $SHAn, Nil{}, hg)
  +hsd1 = UL.sd1(sd, hsd)
  +hsd32 = N.lt_trans(sd, 1n+sd, 32n, N.lt_succ(sd), hsd1)
  +hk30 = L.and_left(Nat.is_lt(k, 30n), Nat.is_lt(0n, k), $GN(ck))
  +ehs = N.eq_from_is_eq(UD.v($M1), SC.pow2(sd), $GN(csize))
  +hle1 = L.subst(Nat, z => {Nat.is_le($FR, z) == True{} : Bool}, SC.pow2(sd), UD.v($M1), Equal.sym(Nat, UD.v($M1), SC.pow2(sd), ehs), $GN(cfresh))
  +hle2 = N.not_lt_le($FR, UD.v($M1), Equal.trans(Bool, Nat.is_lt($FR, UD.v($M1)), U32.is_lt($M0, $M1), False{}, Equal.sym(Bool, U32.is_lt($M0, $M1), Nat.is_lt($FR, UD.v($M1)), U.is_lt_nat($M0, $M1)), hr))
  +efp = Equal.trans(Nat, $FR, UD.v($M1), SC.pow2(sd), N.le_antisym($FR, UD.v($M1), hle1, hle2), ehs)
  +eln = Equal.trans(Nat, SC.length(Nat, sl), Nat.add(SC.length(Nat, sl), 0n), $FR, Equal.sym(Nat, Nat.add(SC.length(Nat, sl), 0n), SC.length(Nat, sl), N.add_zero(SC.length(Nat, sl))), N.eq_from_is_eq(Nat.add(SC.length(Nat, sl), 0n), $FR, $GN(cfcnt)))
  +env = Equal.trans(Nat, UD.v(n), SC.length(Nat, sl), SC.pow2(sd), Equal.sym(Nat, SC.length(Nat, sl), UD.v(n), N.eq_from_is_eq(SC.length(Nat, sl), UD.v(n), $GN(clen))), Equal.trans(Nat, SC.length(Nat, sl), $FR, SC.pow2(sd), eln, efp))
  +hrm = L.subst(Nat, z => {Nat.is_le(Nat.double(1n+z), $NN) == True{} : Bool}, UD.v(n), SC.pow2(sd), env, hroom)
  +hsdk2 = IG.pow2_lt_inv(1n+sd, k, N.lt_le_trans(SC.pow2(1n+sd), Nat.double(1n+SC.pow2(sd)), $NN, N.double_lt(SC.pow2(sd), 1n+SC.pow2(sd), N.lt_succ(SC.pow2(sd))), hrm))
  +hlk = AR.slots_length(String, sd, ksT, $GN(cpk))
  +hle = AR.slots_length(Maybe<&2, V>, sd, eT, $GN(cpe))
  +hll = AR.slots_length(U32, 3n+sd, lkT, $GN(cpl))
  +ebs = AN.bs_app(AR.slots(U32, tabT), $KL, AR.slots(String, $RK), sd, hlk, $NN, $GN(cwell))
  +esg = PR.es_pre(~V, $LLo, AR.slots(U32, $RL), sd, hll, $KL, AR.slots(String, $RK), hlk, $EL, AR.slots(Maybe<&2, V>, $RE), hle, $FR, $GN(cfresh), sl, $GN(csl))
  esg

%def MA AR.upd(U32, 5n, mT, 0n, U32.inc($M0))
%def MB AR.upd(U32, 5n, $MA, 1n, U32.shl($M1))
%def MFX AR.upd(U32, 5n, $MB, 2n, U32.inc($M2))
%def UP(xs, i, x) SC.update(U32, xs, i, x)
%def A0 U32.inc($M0)
%def B0 U32.shl($M1)
%def C0 U32.inc($M2)
%def FRM(r, b) LR.fresh_room(&2, V, cap, n, head, tail, free2, r, AR.thaw(U32, $T2(H.link($M0))), AR.thaw(String, ksT), AR.thaw(Maybe<&2, V>, eT), AR.thaw(U32, lkT), $KS, $KW, $E, $M0, $M1, b)
%def GZ(r) LR.grow_sz(&2, V, cap, n, head, tail, free2, AR.thaw(U32, $T2(H.link($M0))), AR.thaw(String, ksT), AR.thaw(Maybe<&2, V>, eT), AR.thaw(U32, lkT), $KS, $KW, $E, $M0, $M1, r)
%def PS(m, ks, es, lk) LR.put_slot(&2, V, cap, n, head, tail, free2, m, AR.thaw(U32, $T2(H.link($M0))), ks, es, lk, $M0, $KS, $KW, $E)
%def SS3 Array.set(U32, Array.set(U32, Array.set(U32, AR.thaw(U32, mT), 0, $A0), 1, $B0), 2, $C0)
%def K0 ANode{AR.thaw(String, ksT), Array.new(String, UD.v($M2), "")}
%def E0 ANode{AR.thaw(Maybe<&2, V>, eT), LR.vac(&2, V, UD.v($M2))}
%def L0 ANode{AR.thaw(U32, lkT), Array.new(U32, Nat.add(UD.v($M2), 3n), 0)}
%def TMF AR.thaw(U32, $MFX)
%def TKG AR.thaw(String, $KTG)
%def TEG AR.thaw(Maybe<&2, V>, $ETG)
%def TLG AR.thaw(U32, $LTG)
%def ENG SP.LE{key, v, t, W.U64{lo, hi}}
%def SPECG SP.L{cap, W32.nth0($MGL, 3n), ST.w64($MGL, 4n), SP.snoc(~V, $ESG, $EN), SP.c_ins(ST.ctr($MGL))}
%def BASEn $SHFn, +hg: {ST.good(~V, $SHN) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +key: String, +hno: {B.all_lt(B.PNo{$BS, key}, $NN) == True{} : Bool}, +e: Nat, +he: {Nat.is_lt(e, $NN) == True{} : Bool}, +hz: {B.at($BS, e) == B.BE{} : B.Bk}, +hp: {B.occpath($BS, $NN, $HOME, M.dist($NN, $HOME, e)) == True{} : Bool}, +hroom: {Nat.is_le(Nat.double(1n+UD.v(n)), $NN) == True{} : Bool}, +v: V, +t: U32, +lo: U32, +hi: U32
%def BASnA $SHAn, hg, one, h1, key, hno, e, he, hz, hp, hroom, v, t, lo, hi
%def BASE $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +key: String, +hno: {B.all_lt(B.PNo{$BS, key}, $NN) == True{} : Bool}, +e: Nat, +he: {Nat.is_lt(e, $NN) == True{} : Bool}, +hz: {B.at($BS, e) == B.BE{} : B.Bk}, +hp: {B.occpath($BS, $NN, $HOME, M.dist($NN, $HOME, e)) == True{} : Bool}, +hroom: {Nat.is_le(Nat.double(1n+UD.v(n)), $NN) == True{} : Bool}, +v: V, +t: U32, +lo: U32, +hi: U32
%def GC(c) ST.g_$c(~V, cap, n, head, tail, free, W32.nth0($ML, 0n), W32.nth0($ML, 1n), W32.nth0($ML, 2n), W32.nth0($ML, 6n), W32.nth0($ML, 7n), AR.perfect(U32, 5n, mT), k, sd, tabT, $KL, AR.perfect(String, sd, ksT), eT, lkT, sl, Con{s0, tl}, hg)

def igr_n(~V: Data, $BASEn, +free2: U32, +hf2: {U32.is_eq(free2, 0) == True{} : Bool}, +hr: {U32.is_lt($M0, $M1) == False{} : Bool}) -> BS.CountOK(~V, $SPEC, $FRM(AR.thaw(U32, mT), False{})):
  +hsd = RD.f_hsd(~V, $SHAn, Nil{}, hg)
  +hsd1 = UL.sd1(sd, hsd)
  +hsd32 = N.lt_trans(sd, 1n+sd, 32n, N.lt_succ(sd), hsd1)
  +hk30 = L.and_left(Nat.is_lt(k, 30n), Nat.is_lt(0n, k), $GN(ck))
