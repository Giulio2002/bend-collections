import ./touch.bend as TO
import ../../lib/nat_list.bend as NL

# The recency list a ++ [s] ++ b against (a ++ b) ++ [s]: same slots, same
# length, both duplicate-free, both with unique keys.

%def APN(a, b) SC.append(Nat, a, b)
%def APS(a, b) SC.append(String, a, b)
%def APE(a, b) SC.append(SP.Ent<V>, a, b)
%def X $APN(a, Con{s, b})
%def T $APN($APN(a, b), Con{s, Nil{}})
%def ES(x) ST.es(~V, ll, kl, el, x)
%def KA SP.keys_of(~V, $ES(a))
%def KB SP.keys_of(~V, $ES(b))
%def SK ST.skey(ll, kl, s)
%def LKE +ll: List<&2, U32>, +kl: List<&2, String>, +el: List<&2, Maybe<&2, V>>

def sub_xt(+a: List<&2, Nat>, +s: Nat, +b: List<&2, Nat>) -> {IF.subl($X, $T) == True{} : Bool}:
  +sa = RB.subl_ml(a, $APN(a, b), Con{s, Nil{}}, RB.subl_ml(a, a, b, RB.subl_refl(a)))
  +ssb = L.and_intro(NL.memn(s, $T), IF.subl(b, $T), NL.mem_app_r(s, $APN(a, b), Con{s, Nil{}}, UL.self_in(s, Nil{})), RB.subl_ml(b, $APN(a, b), Con{s, Nil{}}, RB.subl_mr(b, a, b, RB.subl_refl(b))))
  RB.subl_app(a, Con{s, b}, $T, sa, ssb)

def sub_tx(+a: List<&2, Nat>, +s: Nat, +b: List<&2, Nat>) -> {IF.subl($T, $X) == True{} : Bool}:
  +sab = RB.subl_app(a, b, $X, RB.subl_ml(a, a, Con{s, b}, RB.subl_refl(a)), RB.subl_mr(b, a, Con{s, b}, IF.subl_cons(b, b, s, RB.subl_refl(b))))
  RB.subl_app($APN(a, b), Con{s, Nil{}}, $X, sab, L.and_intro(NL.memn(s, $X), True{}, NL.mem_app_r(s, a, Con{s, b}, UL.self_in(s, b)), {==}))

def trin_sub(+tr: TR.Tr, +xs: List<&2, Nat>, +ys: List<&2, Nat>, +h: {TR.trin(tr, xs) == True{} : Bool}, +sub: {IF.subl(xs, ys) == True{} : Bool}) -> {TR.trin(tr, ys) == True{} : Bool}:
  match tr:
    case TR.TNil{}:
      {==}
    case TR.TW{+y, +o, +v, +t}:
      L.and_intro(NL.memn(y, ys), TR.trin(t, ys), IF.memn_sub(y, xs, ys, sub, L.and_left(NL.memn(y, xs), TR.trin(t, xs), h)), trin_sub(t, xs, ys, L.and_right(NL.memn(y, xs), TR.trin(t, xs), h), sub))

# x ++ [s]: duplicate-free when x is and s is not in it
def nd_snoc(+x: List<&2, Nat>, +s: Nat) -> {NL.nodupn($APN(x, Con{s, Nil{}})) == Bool.and(NL.nodupn(x), Bool.not(NL.memn(s, x))) : Bool}:
  +e = NL.nd_mid(x, s, Nil{})
  +an = LL.append_nil(Nat, x)
  L.subst(List<&2, Nat>, z => {NL.nodupn($APN(x, Con{s, Nil{}})) == Bool.and(NL.nodupn(z), Bool.not(NL.memn(s, z))) : Bool}, $APN(x, Nil{}), x, an, e)

def nd_xt(+a: List<&2, Nat>, +s: Nat, +b: List<&2, Nat>, +h: {NL.nodupn($X) == True{} : Bool}) -> {NL.nodupn($T) == True{} : Bool}:
  Equal.trans(Bool, NL.nodupn($T), Bool.and(NL.nodupn($APN(a, b)), Bool.not(NL.memn(s, $APN(a, b)))), True{}, nd_snoc($APN(a, b), s), Equal.trans(Bool, Bool.and(NL.nodupn($APN(a, b)), Bool.not(NL.memn(s, $APN(a, b)))), NL.nodupn($X), True{}, Equal.sym(Bool, NL.nodupn($X), Bool.and(NL.nodupn($APN(a, b)), Bool.not(NL.memn(s, $APN(a, b)))), NL.nd_mid(a, s, b)), h))

def len_xt(+a: List<&2, Nat>, +s: Nat, +b: List<&2, Nat>) -> {SC.length(Nat, $T) == SC.length(Nat, $X) : Nat}:
  +e1 = Equal.trans(Nat, SC.length(Nat, $T), Nat.add(SC.length(Nat, $APN(a, b)), 1n), Nat.add(Nat.add(SC.length(Nat, a), SC.length(Nat, b)), 1n), LL.length_append(Nat, $APN(a, b), Con{s, Nil{}}), Equal.cong(Nat, Nat, z => Nat.add(z, 1n), SC.length(Nat, $APN(a, b)), Nat.add(SC.length(Nat, a), SC.length(Nat, b)), LL.length_append(Nat, a, b)))
  +e2 = Equal.trans(Nat, Nat.add(Nat.add(SC.length(Nat, a), SC.length(Nat, b)), 1n), Nat.add(SC.length(Nat, a), Nat.add(SC.length(Nat, b), 1n)), Nat.add(SC.length(Nat, a), 1n+SC.length(Nat, b)), N.add_assoc(SC.length(Nat, a), SC.length(Nat, b), 1n), Equal.cong(Nat, Nat, z => Nat.add(SC.length(Nat, a), z), Nat.add(SC.length(Nat, b), 1n), 1n+SC.length(Nat, b), Equal.trans(Nat, Nat.add(SC.length(Nat, b), 1n), 1n+Nat.add(SC.length(Nat, b), 0n), 1n+SC.length(Nat, b), N.add_succ(SC.length(Nat, b), 0n), Equal.cong(Nat, Nat, z => 1n+z, Nat.add(SC.length(Nat, b), 0n), SC.length(Nat, b), N.add_zero(SC.length(Nat, b))))))
  Equal.trans(Nat, SC.length(Nat, $T), Nat.add(SC.length(Nat, a), 1n+SC.length(Nat, b)), SC.length(Nat, $X), Equal.trans(Nat, SC.length(Nat, $T), Nat.add(Nat.add(SC.length(Nat, a), SC.length(Nat, b)), 1n), Nat.add(SC.length(Nat, a), 1n+SC.length(Nat, b)), e1, e2), Equal.sym(Nat, SC.length(Nat, $X), Nat.add(SC.length(Nat, a), 1n+SC.length(Nat, b)), LL.length_append(Nat, a, Con{s, b})))

# ---- keys ----

def keys_x(~V: Data, $LKE, +a: List<&2, Nat>, +s: Nat, +b: List<&2, Nat>, +v: V, +hm: {HT.nthm(~V, el, s) == Some{v} : Maybe<&2, V>}) -> {SP.keys_of(~V, $ES($X)) == $APS($KA, Con{$SK, $KB}) : List<&2, String>}:
  +e1 = Equal.trans(List<&2, SP.Ent<V>>, $ES($X), $APE($ES(a), $ES(Con{s, b})), $APE($ES(a), Con{TO.ev(~V, ll, kl, s, v), $ES(b)}), LS.es_app(~V, ll, kl, el, a, Con{s, b}), Equal.cong(List<&2, SP.Ent<V>>, List<&2, SP.Ent<V>>, z => $APE($ES(a), z), $ES(Con{s, b}), Con{TO.ev(~V, ll, kl, s, v), $ES(b)}, TO.es_cons(~V, ll, kl, el, s, v, hm, b)))
  Equal.trans(List<&2, String>, SP.keys_of(~V, $ES($X)), SP.keys_of(~V, $APE($ES(a), Con{TO.ev(~V, ll, kl, s, v), $ES(b)})), $APS($KA, Con{$SK, $KB}), Equal.cong(List<&2, SP.Ent<V>>, List<&2, String>, z => SP.keys_of(~V, z), $ES($X), $APE($ES(a), Con{TO.ev(~V, ll, kl, s, v), $ES(b)}), e1), LS.keys_app(~V, $ES(a), Con{TO.ev(~V, ll, kl, s, v), $ES(b)}))

def keys_t(~V: Data, $LKE, +a: List<&2, Nat>, +s: Nat, +b: List<&2, Nat>, +v: V, +hm: {HT.nthm(~V, el, s) == Some{v} : Maybe<&2, V>}) -> {SP.keys_of(~V, $ES($T)) == $APS($APS($KA, $KB), Con{$SK, Nil{}}) : List<&2, String>}:
  +e1 = Equal.trans(List<&2, SP.Ent<V>>, $ES($T), $APE($ES($APN(a, b)), $ES(Con{s, Nil{}})), $APE($APE($ES(a), $ES(b)), Con{TO.ev(~V, ll, kl, s, v), Nil{}}), LS.es_app(~V, ll, kl, el, $APN(a, b), Con{s, Nil{}}), Equal.trans(List<&2, SP.Ent<V>>, $APE($ES($APN(a, b)), $ES(Con{s, Nil{}})), $APE($APE($ES(a), $ES(b)), $ES(Con{s, Nil{}})), $APE($APE($ES(a), $ES(b)), Con{TO.ev(~V, ll, kl, s, v), Nil{}}), Equal.cong(List<&2, SP.Ent<V>>, List<&2, SP.Ent<V>>, z => $APE(z, $ES(Con{s, Nil{}})), $ES($APN(a, b)), $APE($ES(a), $ES(b)), LS.es_app(~V, ll, kl, el, a, b)), Equal.cong(List<&2, SP.Ent<V>>, List<&2, SP.Ent<V>>, z => $APE($APE($ES(a), $ES(b)), z), $ES(Con{s, Nil{}}), Con{TO.ev(~V, ll, kl, s, v), Nil{}}, TO.es_cons(~V, ll, kl, el, s, v, hm, Nil{}))))
  +e2 = Equal.trans(List<&2, String>, SP.keys_of(~V, $APE($APE($ES(a), $ES(b)), Con{TO.ev(~V, ll, kl, s, v), Nil{}})), $APS(SP.keys_of(~V, $APE($ES(a), $ES(b))), Con{$SK, Nil{}}), $APS($APS($KA, $KB), Con{$SK, Nil{}}), LS.keys_app(~V, $APE($ES(a), $ES(b)), Con{TO.ev(~V, ll, kl, s, v), Nil{}}), Equal.cong(List<&2, String>, List<&2, String>, z => $APS(z, Con{$SK, Nil{}}), SP.keys_of(~V, $APE($ES(a), $ES(b))), $APS($KA, $KB), LS.keys_app(~V, $ES(a), $ES(b))))
  Equal.trans(List<&2, String>, SP.keys_of(~V, $ES($T)), SP.keys_of(~V, $APE($APE($ES(a), $ES(b)), Con{TO.ev(~V, ll, kl, s, v), Nil{}})), $APS($APS($KA, $KB), Con{$SK, Nil{}}), Equal.cong(List<&2, SP.Ent<V>>, List<&2, String>, z => SP.keys_of(~V, z), $ES($T), $APE($APE($ES(a), $ES(b)), Con{TO.ev(~V, ll, kl, s, v), Nil{}}), e1), e2)

def nd_snoc_s(+x: List<&2, String>, +k: String) -> {S.nodup($APS(x, Con{k, Nil{}})) == Bool.and(S.nodup(x), Bool.not(S.mem(k, x))) : Bool}:
  L.subst(List<&2, String>, z => {S.nodup($APS(x, Con{k, Nil{}})) == Bool.and(S.nodup(z), Bool.not(S.mem(k, z))) : Bool}, $APS(x, Nil{}), x, LL.append_nil(String, x), LS.nd_mid_s(x, k, Nil{}))

def keys_xt(~V: Data, $LKE, +a: List<&2, Nat>, +s: Nat, +b: List<&2, Nat>, +v: V, +hm: {HT.nthm(~V, el, s) == Some{v} : Maybe<&2, V>}, +h: {S.nodup(SP.keys_of(~V, $ES($X))) == True{} : Bool}) -> {S.nodup(SP.keys_of(~V, $ES($T))) == True{} : Bool}:
  +h1 = L.subst(List<&2, String>, z => {S.nodup(z) == True{} : Bool}, SP.keys_of(~V, $ES($X)), $APS($KA, Con{$SK, $KB}), keys_x(~V, ll, kl, el, a, s, b, v, hm), h)
  +h2 = Equal.trans(Bool, S.nodup($APS($APS($KA, $KB), Con{$SK, Nil{}})), Bool.and(S.nodup($APS($KA, $KB)), Bool.not(S.mem($SK, $APS($KA, $KB)))), True{}, nd_snoc_s($APS($KA, $KB), $SK), Equal.trans(Bool, Bool.and(S.nodup($APS($KA, $KB)), Bool.not(S.mem($SK, $APS($KA, $KB)))), S.nodup($APS($KA, Con{$SK, $KB})), True{}, Equal.sym(Bool, S.nodup($APS($KA, Con{$SK, $KB})), Bool.and(S.nodup($APS($KA, $KB)), Bool.not(S.mem($SK, $APS($KA, $KB)))), LS.nd_mid_s($KA, $SK, $KB)), h1))
  L.subst(List<&2, String>, z => {S.nodup(z) == True{} : Bool}, $APS($APS($KA, $KB), Con{$SK, Nil{}}), SP.keys_of(~V, $ES($T)), Equal.sym(List<&2, String>, SP.keys_of(~V, $ES($T)), $APS($APS($KA, $KB), Con{$SK, Nil{}}), keys_t(~V, ll, kl, el, a, s, b, v, hm)), h2)
