# the new model's entries are the old ones of a ++ b
def f_es(~V: Data, $HYP) -> {ST.es(~V, $LUS, $KL, $EUS, $Y) == ST.es(~V, $LLo, $KL, $EL, $Y) : List<&2, SP.Ent<V>>}:
