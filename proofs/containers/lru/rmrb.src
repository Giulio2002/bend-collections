def c_keys(~V: Data, $HYP) -> {S.nodup(SP.keys_of(~V, ST.es(~V, $LUS, $KL, $EUS, $Y))) == True{} : Bool}:
  +KA = SP.keys_of(~V, ST.es(~V, $LLo, $KL, $EL, a))
  +KB = SP.keys_of(~V, ST.es(~V, $LLo, $KL, $EL, b))
  +SK = ST.skey($LLo, $KL, s)
