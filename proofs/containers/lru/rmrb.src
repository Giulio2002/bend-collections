# The invariant after a removal: slot s's bucket is deleted from the table,
# s is taken off the recency list, its value cell vacated and s pushed on the
# free list.

%def APN(a, b) SC.append(Nat, a, b)
%def X $APN(a, Con{s, b})
%def Y $APN(a, b)
%def M0 W32.nth0(AR.slots(U32, mT), 0n)
%def M1 W32.nth0(AR.slots(U32, mT), 1n)
%def M2 W32.nth0(AR.slots(U32, mT), 2n)
%def M6 W32.nth0(AR.slots(U32, mT), 6n)
%def M7 W32.nth0(AR.slots(U32, mT), 7n)
%def PM AR.perfect(U32, 5n, mT)
%def KL AR.slots(String, ksT)
%def PK AR.perfect(String, sd, ksT)
%def LLo AR.slots(U32, lkT)
%def EL AR.slots(Maybe<&2, V>, eT)
%def FR UD.v($M0)
%def NN SC.pow2(k)
%def BS TB.buckets(AR.slots(U32, tabT), $KL, $NN)
%def BS2 TB.buckets(AR.slots(U32, tabT2), $KL, $NN)
%def V0 IM.bupd($BS, i, B.BE{})
%def GA cap, n, head, tail, free, $M0, $M1, $M2, $M6, $M7, $PM, k, sd, tabT, $KL, $PK, eT, lkT, $X, fl
%def G(c) ST.g_$c(~V, $GA, hg)
%def EU AR.upd(Maybe<&2, V>, sd, eT, UD.v(su), None{})
%def LU AR.upd(U32, 3n+sd, t2, UD.v(LR.nidx(su)), free)
%def ELU SC.update(Maybe<&2, V>, $EL, s, None{})
%def TRU TR.TW{s, 1n, free, tr}
%def LLU TR.app($LLo, $TRU)
%def N1 U32.sub(n, 1)
%def GB cap, $N1, LK.fst_or($Y, 0), LK.last_or($Y, 0), H.link(su), $M0, $M1, $M2, $M6, $M7, $PM, k, sd, tabT2, $KL, $PK, $EU, $LU, $Y, Con{s, fl}
%def SH2 ST.LS{cap, $N1, LK.fst_or($Y, 0), LK.last_or($Y, 0), H.link(su), mT, k, sd, tabT2, ksT, $EU, $LU, $Y, Con{s, fl}}
%def D(j) DW.dfin2($KL, k, $V0, tabT2)
%def HYP +cap: U32, +n: U32, +head: U32, +tail: U32, +free: U32, +mT: AR.Tree<U32>, +k: Nat, +sd: Nat, +tabT: AR.Tree<U32>, +ksT: AR.Tree<String>, +eT: AR.Tree<Maybe<&2, V>>, +lkT: AR.Tree<U32>, +a: List<&2, Nat>, +s: Nat, +b: List<&2, Nat>, +fl: List<&2, Nat>, +hg: {ST.good(~V, ST.LS{cap, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, $X, fl}) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +i: Nat, +hi: {Nat.is_lt(i, $NN) == True{} : Bool}, +hoi: {B.occ(B.at($BS, i)) == True{} : Bool}, +hsi: {UD.v(H.slot(B.lnk(B.at($BS, i)))) == s : Nat}, +tabT2: AR.Tree<U32>, +hd: {DW.dfin2($KL, k, $V0, tabT2) == True{} : Bool}, +t2: AR.Tree<U32>, +tr: TR.Tr, +hp2: {AR.perfect(U32, 3n+sd, t2) == True{} : Bool}, +hs2: {AR.slots(U32, t2) == TR.app($LLo, tr) : List<&2, U32>}, +hlo: {TR.trlo(tr) == True{} : Bool}, +hin: {TR.trin(tr, $X) == True{} : Bool}, +hseg: {ST.seg(AR.slots(U32, t2), $Y, 0, 0) == True{} : Bool}, +su: U32, +hsv: {UD.v(su) == s : Nat}, +v: V, +hm: {HT.nthm(~V, $EL, s) == Some{v} : Maybe<&2, V>}
%def HYA cap, n, head, tail, free, mT, k, sd, tabT, ksT, eT, lkT, a, s, b, fl, hg, one, h1, i, hi, hoi, hsi, tabT2, hd, t2, tr, hp2, hs2, hlo, hin, hseg, su, hsv, v, hm

# ---- derived facts ----

def f_sd(~V: Data, $HYP) -> {Nat.is_lt(3n+sd, 32n) == True{} : Bool}:
  TSH.sd29(k, sd, L.and_left(Nat.is_lt(k, 30n), Nat.is_lt(0n, k), $G(ck)), $G(csdk))

def f_mid(~V: Data, $HYP) -> {Bool.and(NL.nodupn($Y), Bool.not(NL.memn(s, $Y))) == True{} : Bool}:
  L.subst(Bool, z => {z == True{} : Bool}, NL.nodupn($X), Bool.and(NL.nodupn($Y), Bool.not(NL.memn(s, $Y))), NL.nd_mid(a, s, b), $G(cnd))

def f_ndY(~V: Data, $HYP) -> {NL.nodupn($Y) == True{} : Bool}:
  L.and_left(NL.nodupn($Y), Bool.not(NL.memn(s, $Y)), f_mid(~V, $HYA))

def f_sn(~V: Data, $HYP) -> {NL.memn(s, $Y) == False{} : Bool}:
  L.not_true(NL.memn(s, $Y), L.and_right(NL.nodupn($Y), Bool.not(NL.memn(s, $Y)), f_mid(~V, $HYA)))

def f_sX(~V: Data, $HYP) -> {NL.memn(s, $X) == True{} : Bool}:
  NL.mem_app_r(s, a, Con{s, b}, UL.self_in(s, b))

def f_sub(~V: Data, $HYP) -> {IF.subl($Y, $X) == True{} : Bool}:
  RB.subl_app(a, b, $X, RB.subl_ml(a, a, Con{s, b}, RB.subl_refl(a)), RB.subl_mr(b, a, Con{s, b}, IF.subl_cons(b, b, s, RB.subl_refl(b))))

def f_bY(~V: Data, $HYP) -> {ST.sall(~V, ST.PLive{$FR, $EL}, $Y) == True{} : Bool}:
  RB.sall_sub(~V, ST.PLive{$FR, $EL}, $X, $Y, $G(csl), f_sub(~V, $HYA))

def f_ls(~V: Data, $HYP) -> {Bool.and(Nat.is_lt(s, $FR), ST.live(~V, $EL, s)) == True{} : Bool}:
  LS.sall_mem(~V, ST.PLive{$FR, $EL}, s, $X, $G(csl), f_sX(~V, $HYA))

def f_s0(~V: Data, $HYP) -> {Nat.is_lt(s, SC.pow2(sd)) == True{} : Bool}:
  N.lt_le_trans(s, $FR, SC.pow2(sd), L.and_left(Nat.is_lt(s, $FR), ST.live(~V, $EL, s), f_ls(~V, $HYA)), $G(cfresh))

def f_sf(~V: Data, $HYP) -> {NL.memn(s, fl) == False{} : Bool}:
  L.not_true(NL.memn(s, fl), TR.not_vac(~V, s, fl, $FR, $EL, L.and_right(Nat.is_lt(s, $FR), ST.live(~V, $EL, s), f_ls(~V, $HYA)), $G(cfl), NL.memn(s, fl), {==}))

def f_su(~V: Data, $HYP) -> {Nat.is_lt(UD.v(su), SC.pow2(sd)) == True{} : Bool}:
  L.subst(Nat, z => {Nat.is_lt(z, SC.pow2(sd)) == True{} : Bool}, s, UD.v(su), Equal.sym(Nat, UD.v(su), s, hsv), f_s0(~V, $HYA))

def f_sd32(~V: Data, $HYP) -> {Nat.is_lt(sd, 32n) == True{} : Bool}:
  N.lt_trans(sd, 3n+sd, 32n, N.lt_le_trans(sd, 1n+sd, 3n+sd, N.lt_succ(sd), N.le_trans(1n+sd, 2n+sd, 3n+sd, N.le_succ(1n+sd), N.le_succ(2n+sd))), f_sd(~V, $HYA))

# the vacated value cells
def f_eu(~V: Data, $HYP) -> {AR.slots(Maybe<&2, V>, $EU) == $ELU : List<&2, Maybe<&2, V>>}:
  Equal.trans(List<&2, Maybe<&2, V>>, AR.slots(Maybe<&2, V>, $EU), SC.update(Maybe<&2, V>, $EL, UD.v(su), None{}), $ELU, AR.upd_slots(Maybe<&2, V>, sd, eT, UD.v(su), None{}, f_su(~V, $HYA), $G(cpe)), Equal.cong(Nat, List<&2, Maybe<&2, V>>, z => SC.update(Maybe<&2, V>, $EL, z, None{}), UD.v(su), s, hsv))

# the free-list push
def f_lu(~V: Data, $HYP) -> {AR.slots(U32, $LU) == $LLU : List<&2, U32>}:
  +iN = Equal.trans(Nat, UD.v(LR.nidx(su)), ST.off(UD.v(su), 1n), ST.off(s, 1n), ID.w1(one, h1, su, sd, UL.sd3(sd, f_sd(~V, $HYA)), f_su(~V, $HYA)), Equal.cong(Nat, Nat, z => ST.off(z, 1n), UD.v(su), s, hsv))
  Equal.trans(List<&2, U32>, AR.slots(U32, $LU), SC.update(U32, AR.slots(U32, t2), ST.off(s, 1n), free), $LLU, UL.wr_s(t2, sd, hp2, LR.nidx(su), s, 1n, {==}, f_s0(~V, $HYA), iN, free), Equal.cong(List<&2, U32>, List<&2, U32>, z => SC.update(U32, z, ST.off(s, 1n), free), AR.slots(U32, t2), TR.app($LLo, tr), hs2))

def f_tlo(~V: Data, $HYP) -> {TR.trlo($TRU) == True{} : Bool}:
  L.and_intro(Nat.is_lt(1n, 2n), TR.trlo(tr), {==}, hlo)

def f_len(~V: Data, $HYP) -> {SC.length(Nat, $X) == 1n+SC.length(Nat, $Y) : Nat}:
  Equal.trans(Nat, SC.length(Nat, $X), Nat.add(SC.length(Nat, a), 1n+SC.length(Nat, b)), 1n+SC.length(Nat, $Y), LL.length_append(Nat, a, Con{s, b}), Equal.trans(Nat, Nat.add(SC.length(Nat, a), 1n+SC.length(Nat, b)), 1n+Nat.add(SC.length(Nat, a), SC.length(Nat, b)), 1n+SC.length(Nat, $Y), N.add_succ(SC.length(Nat, a), SC.length(Nat, b)), Equal.cong(Nat, Nat, z => 1n+z, Nat.add(SC.length(Nat, a), SC.length(Nat, b)), SC.length(Nat, $Y), Equal.sym(Nat, SC.length(Nat, $Y), Nat.add(SC.length(Nat, a), SC.length(Nat, b)), LL.length_append(Nat, a, b)))))

# the count, one lower
def f_n(~V: Data, $HYP) -> {UD.v(n) == 1n+SC.length(Nat, $Y) : Nat}:
  Equal.trans(Nat, UD.v(n), SC.length(Nat, $X), 1n+SC.length(Nat, $Y), Equal.sym(Nat, SC.length(Nat, $X), UD.v(n), N.eq_from_is_eq(SC.length(Nat, $X), UD.v(n), $G(clen))), f_len(~V, $HYA))

def f_n1(~V: Data, $HYP) -> {UD.v($N1) == SC.length(Nat, $Y) : Nat}:
  +en = f_n(~V, $HYA)
  +hle = L.subst(Nat, z => {Nat.is_le(1n, z) == True{} : Bool}, 1n+SC.length(Nat, $Y), UD.v(n), Equal.sym(Nat, UD.v(n), 1n+SC.length(Nat, $Y), en), N.lt_succ_le_succ(0n, 1n+SC.length(Nat, $Y), {==}))
  Equal.trans(Nat, UD.v($N1), Nat.sub(UD.v(n), 1n), SC.length(Nat, $Y), U.sub_nat(n, 1, hle), Equal.trans(Nat, Nat.sub(UD.v(n), 1n), Nat.sub(1n+SC.length(Nat, $Y), 1n), SC.length(Nat, $Y), Equal.cong(Nat, Nat, z => Nat.sub(z, 1n), UD.v(n), 1n+SC.length(Nat, $Y), en), N.sub_zero(SC.length(Nat, $Y))))

# ---- the deleted bucket ----

%def P1 AR.perfect(U32, 1n+k, tabT2)
%def P2 B.cluster($BS2, $NN, CY.msk(k))
%def P3 B.all_lt(B.PUniq{$BS2}, $NN)
%def P4 B.all_lt(B.PFrom{$BS2, $V0, $NN}, $NN)
%def P5 B.all_lt(B.PTo{$V0, $BS2, $NN}, $NN)
%def P6 Nat.is_eq(IV.occn($BS2, $NN), IV.occn($V0, $NN))
%def R2 Bool.and($P2, Bool.and($P3, Bool.and($P4, Bool.and($P5, $P6))))
%def R3 Bool.and($P3, Bool.and($P4, Bool.and($P5, $P6)))
%def R4 Bool.and($P4, Bool.and($P5, $P6))
%def R5 Bool.and($P5, $P6)

def d1(~V: Data, $HYP) -> {$P1 == True{} : Bool}:
  L.and_left($P1, $R2, hd)
def d2(~V: Data, $HYP) -> {$P2 == True{} : Bool}:
  L.and_left($P2, $R3, L.and_right($P1, $R2, hd))
def d3(~V: Data, $HYP) -> {$P3 == True{} : Bool}:
  L.and_left($P3, $R4, L.and_right($P2, $R3, L.and_right($P1, $R2, hd)))
def d4(~V: Data, $HYP) -> {$P4 == True{} : Bool}:
  L.and_left($P4, $R5, L.and_right($P3, $R4, L.and_right($P2, $R3, L.and_right($P1, $R2, hd))))
def d5(~V: Data, $HYP) -> {$P5 == True{} : Bool}:
  L.and_left($P5, $P6, L.and_right($P4, $R5, L.and_right($P3, $R4, L.and_right($P2, $R3, L.and_right($P1, $R2, hd)))))
def d6(~V: Data, $HYP) -> {$P6 == True{} : Bool}:
  L.and_right($P5, $P6, L.and_right($P4, $R5, L.and_right($P3, $R4, L.and_right($P2, $R3, L.and_right($P1, $R2, hd)))))

def f_blen(~V: Data, $HYP) -> {Nat.is_lt(i, SC.length(B.Bk, $BS)) == True{} : Bool}:
  L.subst(Nat, z => {Nat.is_lt(i, z) == True{} : Bool}, $NN, SC.length(B.Bk, $BS), Equal.sym(Nat, SC.length(B.Bk, $BS), $NN, IA.len_dlist(AR.slots(U32, tabT), $KL, $NN, 0n)), hi)

def c_well(~V: Data, $HYP) -> {B.all_lt(B.PWell{$BS2, sd}, $NN) == True{} : Bool}:
  PL.well_from($BS2, $V0, $NN, $NN, d4(~V, $HYA), sd, PL.well_rm($BS, $NN, i, hi, f_blen(~V, $HYA), sd, $G(cwell), $NN, N.le_refl($NN)), $NN, N.le_refl($NN))

def c_n(~V: Data, $HYP) -> {Nat.is_eq(UD.v($N1), IV.occn($BS2, $NN)) == True{} : Bool}:
  +e1 = N.eq_from_is_eq(IV.occn($BS2, $NN), IV.occn($V0, $NN), d6(~V, $HYA))
  +e2 = DM.occn_rm($BS, $NN, i, hi, f_blen(~V, $HYA), hoi)
  +e3 = N.eq_from_is_eq(UD.v(n), IV.occn($BS, $NN), $G(cn))
  +e4 = Equal.trans(Nat, 1n+SC.length(Nat, $Y), UD.v(n), 1n+IV.occn($V0, $NN), Equal.sym(Nat, UD.v(n), 1n+SC.length(Nat, $Y), f_n(~V, $HYA)), Equal.trans(Nat, UD.v(n), IV.occn($BS, $NN), 1n+IV.occn($V0, $NN), e3, e2))
  +e5 = Equal.trans(Nat, UD.v($N1), SC.length(Nat, $Y), IV.occn($BS2, $NN), f_n1(~V, $HYA), Equal.trans(Nat, SC.length(Nat, $Y), IV.occn($V0, $NN), IV.occn($BS2, $NN), N.succ_inj(SC.length(Nat, $Y), IV.occn($V0, $NN), e4), Equal.sym(Nat, IV.occn($BS2, $NN), IV.occn($V0, $NN), e1)))
  L.subst(Nat, z => {Nat.is_eq(UD.v($N1), z) == True{} : Bool}, UD.v($N1), IV.occn($BS2, $NN), e5, N.is_eq_refl(UD.v($N1)))

def f_n1le(~V: Data, $HYP) -> {Nat.is_le(UD.v($N1), UD.v(n)) == True{} : Bool}:
  L.subst(Nat, z => {Nat.is_le(UD.v($N1), z) == True{} : Bool}, 1n+UD.v($N1), UD.v(n), Equal.sym(Nat, UD.v(n), 1n+UD.v($N1), Equal.trans(Nat, UD.v(n), 1n+SC.length(Nat, $Y), 1n+UD.v($N1), f_n(~V, $HYA), Equal.cong(Nat, Nat, z => 1n+z, SC.length(Nat, $Y), UD.v($N1), Equal.sym(Nat, UD.v($N1), SC.length(Nat, $Y), f_n1(~V, $HYA))))), N.le_succ(UD.v($N1)))

def c_load(~V: Data, $HYP) -> {Nat.is_le(Nat.double(UD.v($N1)), $NN) == True{} : Bool}:
  N.le_trans(Nat.double(UD.v($N1)), Nat.double(UD.v(n)), $NN, N.double_le(UD.v($N1), UD.v(n), f_n1le(~V, $HYA)), $G(cload))


# ---- the slot correspondence ----

def c_bsl(~V: Data, $HYP) -> {ST.bsl($BS2, $Y, AR.slots(U32, $LU), $NN) == True{} : Bool}:
  +b1 = TS.bsl_rm($BS, $NN, $G(cuniq), i, hi, f_blen(~V, $HYA), hoi, a, s, b, hsi, $LLo, $G(cbsl), $NN, N.le_refl($NN))
  +b2 = TS.bsl_from($BS2, $V0, $NN, $NN, d4(~V, $HYA), $Y, $LLo, b1)
  +b3 = RB.tr_eq_bool(ST.bsl($BS2, $Y, $LLU, $NN), ST.bsl($BS2, $Y, $LLo, $NN), TR.bsl_tr($LLo, $TRU, f_tlo(~V, $HYA), $BS2, $Y, $NN), b2)
  L.subst(List<&2, U32>, z => {ST.bsl($BS2, $Y, z, $NN) == True{} : Bool}, $LLU, AR.slots(U32, $LU), Equal.sym(List<&2, U32>, AR.slots(U32, $LU), $LLU, f_lu(~V, $HYA)), b3)

def c_has(~V: Data, $HYP) -> {ST.hasall(~V, $BS2, $NN, AR.slots(U32, $LU), $Y) == True{} : Bool}:
  +h0 = RB.sall_sub(~V, ST.PHas{$BS, $NN, $LLo}, $X, $Y, $G(chas), f_sub(~V, $HYA))
  +h1b = TS.has_rm(~V, one, h1, sd, f_sd(~V, $HYA), $FR, $EL, $G(cfresh), $BS, $NN, i, f_blen(~V, $HYA), s, hsi, $LLo, $Y, f_sn(~V, $HYA), f_bY(~V, $HYA), h0)
  +h2 = TS.has_to(~V, $V0, $BS2, $NN, $NN, d5(~V, $HYA), $LLo, $Y, h1b)
  +h3 = RB.tr_eq_bool(ST.hasall(~V, $BS2, $NN, $LLU, $Y), ST.hasall(~V, $BS2, $NN, $LLo, $Y), TR.has_tr(~V, $LLo, $TRU, f_tlo(~V, $HYA), $BS2, $NN, $Y), h2)
  L.subst(List<&2, U32>, z => {ST.hasall(~V, $BS2, $NN, z, $Y) == True{} : Bool}, $LLU, AR.slots(U32, $LU), Equal.sym(List<&2, U32>, AR.slots(U32, $LU), $LLU, f_lu(~V, $HYA)), h3)

# ---- lists ----

%def EUS AR.slots(Maybe<&2, V>, $EU)
%def LUS AR.slots(U32, $LU)
%def TOEU(motive, pf) L.subst(List<&2, Maybe<&2, V>>, z => {motive == True{} : Bool}, $ELU, $EUS, Equal.sym(List<&2, Maybe<&2, V>>, $EUS, $ELU, f_eu(~V, $HYA)), pf)
%def TOLU(motive, pf) L.subst(List<&2, U32>, z => {motive == True{} : Bool}, $LLU, $LUS, Equal.sym(List<&2, U32>, $LUS, $LLU, f_lu(~V, $HYA)), pf)

def c_sl(~V: Data, $HYP) -> {ST.slok(~V, $Y, $FR, $EUS) == True{} : Bool}:
  $TOEU(ST.slok(~V, $Y, $FR, z), RB.tr_eq_bool(ST.slok(~V, $Y, $FR, $ELU), ST.slok(~V, $Y, $FR, $EL), EF.slok_el(~V, $EL, s, None{}, $FR, $Y, f_sn(~V, $HYA)), f_bY(~V, $HYA)))

def c_len(~V: Data, $HYP) -> {Nat.is_eq(SC.length(Nat, $Y), UD.v($N1)) == True{} : Bool}:
  L.subst(Nat, z => {Nat.is_eq(SC.length(Nat, $Y), z) == True{} : Bool}, SC.length(Nat, $Y), UD.v($N1), Equal.sym(Nat, UD.v($N1), SC.length(Nat, $Y), f_n1(~V, $HYA)), N.is_eq_refl(SC.length(Nat, $Y)))

def c_dll(~V: Data, $HYP) -> {ST.seg($LUS, $Y, 0, 0) == True{} : Bool}:
  +e = Equal.cong(List<&2, U32>, List<&2, U32>, z => SC.update(U32, z, ST.off(s, 1n), free), AR.slots(U32, t2), TR.app($LLo, tr), hs2)
  +l1 = RB.tr_eq_bool(ST.seg(SC.update(U32, AR.slots(U32, t2), ST.off(s, 1n), free), $Y, 0, 0), ST.seg(AR.slots(U32, t2), $Y, 0, 0), DL.seg_fs(AR.slots(U32, t2), s, 1n, free, {==}, $Y, 0, 0, f_sn(~V, $HYA)), hseg)
