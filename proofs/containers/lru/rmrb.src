  +h2 = L.and_left(S.nodup(SC.append(String, KA, KB)), Bool.not(S.mem(SK, SC.append(String, KA, KB))), L.subst(Bool, z => {z == True{} : Bool}, S.nodup(SC.append(String, KA, Con{SK, KB})), Bool.and(S.nodup(SC.append(String, KA, KB)), Bool.not(S.mem(SK, SC.append(String, KA, KB)))), LS.nd_mid_s(KA, SK, KB), h1b))
  +ek = Equal.trans(List<&2, String>, SP.keys_of(~V, ST.es(~V, $LLo, $KL, $EL, $Y)), SP.keys_of(~V, SC.append(SP.Ent<V>, ST.es(~V, $LLo, $KL, $EL, a), ST.es(~V, $LLo, $KL, $EL, b))), SC.append(String, KA, KB), Equal.cong(List<&2, SP.Ent<V>>, List<&2, String>, z => SP.keys_of(~V, z), ST.es(~V, $LLo, $KL, $EL, $Y), SC.append(SP.Ent<V>, ST.es(~V, $LLo, $KL, $EL, a), ST.es(~V, $LLo, $KL, $EL, b)), LS.es_app(~V, $LLo, $KL, $EL, a, b)), LS.keys_app(~V, ST.es(~V, $LLo, $KL, $EL, a), ST.es(~V, $LLo, $KL, $EL, b)))
  +h3 = L.subst(List<&2, String>, z => {S.nodup(z) == True{} : Bool}, SC.append(String, KA, KB), SP.keys_of(~V, ST.es(~V, $LLo, $KL, $EL, $Y)), Equal.sym(List<&2, String>, SP.keys_of(~V, ST.es(~V, $LLo, $KL, $EL, $Y)), SC.append(String, KA, KB), ek), h2)
