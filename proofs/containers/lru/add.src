# add: room for one more, then the probe; a present key is replaced, a
# missing one placed (after an eviction when the cache is full).

%include read.src

%def KW K.kword(key)
%def KS PA.stored(key)
%def EN SP.LE{key, v, t, W.U64{lo, hi}}
%def E LR.E{v, t, lo, hi}
%def RL LR.LRU<&2, V>
%def TM AR.thaw(U32, mT)
%def TT AR.thaw(U32, tabT)
%def TK AR.thaw(String, ksT)
%def TE AR.thaw(Maybe<&2, V>, eT)
%def TL AR.thaw(U32, lkT)
%def AF(m) SP.add_found(~V, cap, $M3, $W4, $ES, $CTR, key, $EN, m)
%def APK(at, l, b) LR.add_pick(&2, V, $F, $KS, at, $KW, l, $E, b)
%def ENTP +v: V, +t: U32, +lo: U32, +hi: U32

# a count with a flag is an operation with that result
def co2p(~V: Data, +spec: SP.Lru<V>, -r: $RL, +x: Bool, co: BS.CountOK(~V, spec, r)) -> RM.POK(~V, Bool, (spec, x), (r, x)):
  match co:
    case Tuple{+sh2, Tuple{+e1, Tuple{+em, g}}}:
      (sh2, (x, (Equal.cong($RL, $RL & Bool, z => (z, x), r, ST.real(~V, sh2), e1), (Equal.cong(SP.Lru<V>, SP.Lru<V> & Bool, z => (z, x), spec, ST.model(~V, sh2), Equal.sym(SP.Lru<V>, ST.model(~V, sh2), spec, em)), g))))

%def MISS +key: String, +hno: {B.all_lt(B.PNo{$BS, key}, $NN) == True{} : Bool}, +e: Nat, +he: {Nat.is_lt(e, $NN) == True{} : Bool}, +hz: {B.at($BS, e) == B.BE{} : B.Bk}, +hp: {B.occpath($BS, $NN, $HOME, M.dist($NN, $HOME, e)) == True{} : Bool}, +hroom: {Nat.is_le(Nat.double(1n+UD.v(n)), $NN) == True{} : Bool}, $ENTP
%def MISA key, hno, e, he, hz, hp, hroom, v, t, lo, hi
%def FE U32.from_nat(e)

def ad_full(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, $MISS, +hnk: {ST.nokey(~V, $LLo, $KL, sl, key) == True{} : Bool}, +b: Bool, +hb: {U32.is_le(cap, n) == b : Bool}) -> RM.POK(~V, Bool, SP.add_absent(~V, cap, $M3, $W4, $ES, $CTR, $EN, b), LR.add_miss(&2, V, $F, $KS, $FE, $KW, $E, b)):
  match b:
    case False{}:
      co2p(~V, SP.L{cap, $M3, $W4, SP.snoc(~V, $ES, $EN), SP.c_ins($CTR)}, LR.miss_room(&2, V, $F, $KS, $FE, $KW, $E), False{}, MS.mr_ok(~V, $SHA, hg, one, h1, $MISA))
    case True{}:
      co2p(~V, SP.L{cap, $M3, $W4, SP.snoc(~V, SP.tail(~V, $ES), $EN), SP.c_ins(SP.c_ev($CTR))}, LR.miss_full(&2, V, LR.evict_oldest(&2, V, $F), $KS, $KW, $E), True{}, MS.mf_ok(~V, $SHA, hg, one, h1, key, hnk, hroom, hb, v, t, lo, hi))

# a missing key: placed, after an eviction when the cache is full
def ad_end(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, $MISS) -> RM.POK(~V, Bool, $AF(SP.find(~V, $ES, key)), $APK($FE, 0, True{})):
  +hsd1 = UL.sd1(sd, RD.f_hsd(~V, $SHA, hg))
  +hnk = TF.nokey_of(~V, one, h1, AR.slots(U32, tabT), $KL, $NN, key, hno, $LLo, $EL, sd, hsd1, $FR, $G(cfresh), sl, $G(csl), $G(chas))
  ok = ad_full(~V, $SHA, hg, one, h1, $MISA, hnk, U32.is_le(cap, n), {==})
  ok2 = L.subst(U32, z => RM.POK(~V, Bool, SP.add_absent(~V, cap, $M3, $W4, $ES, $CTR, $EN, U32.is_le(cap, z)), LR.add_miss(&2, V, $F, $KS, $FE, $KW, $E, U32.is_le(cap, n))), n, U32.from_nat(SP.length(~V, $ES)), Equal.sym(U32, U32.from_nat(SP.length(~V, $ES)), n, RZ.n_len(~V, $SHA, hg)), ok)
  L.subst(Maybe<&2, SP.Ent<V>>, z => RM.POK(~V, Bool, $AF(z), $APK($FE, 0, True{})), None{}, SP.find(~V, $ES, key), Equal.sym(Maybe<&2, SP.Ent<V>>, SP.find(~V, $ES, key), None{}, FD.find_miss(~V, $LLo, $KL, $EL, key, sl, hnk)), ok2)

%def EVS TO.ev(~V, $LLo, $KL, s, v0)

def ad_v0(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +key: String, $ENTP, +l: U32, +s: Nat, +hsv: {UD.v(H.slot(l)) == s : Nat}, +hmem: {NL.memn(s, sl) == True{} : Bool}, +hk: {S.str_eq(ST.skey($LLo, $KL, s), key) == True{} : Bool}, +m: Maybe<&2, V>, +hmm: {HT.nthm(~V, $EL, s) == m : Maybe<&2, V>}, +hsm: {HT.some_b(~V, m) == True{} : Bool}) -> RM.POK(~V, Bool, $AF(SP.find(~V, $ES, key)), (LR.replace(&2, V, $F, H.slot(l), $E), False{})):
  match m:
    case None{}:
      Empty.absurd(RM.POK(~V, Bool, $AF(SP.find(~V, $ES, key)), (LR.replace(&2, V, $F, H.slot(l), $E), False{})), L.false_true(hsm))
    case Some{+v0}:
      +hm = {hmm : {HT.nthm(~V, $EL, s) == Some{v0} : Maybe<&2, V>}}
      +hlv = L.subst(Maybe<&2, V>, z => {HT.some_b(~V, z) == True{} : Bool}, Some{v0}, HT.nthm(~V, $EL, s), Equal.sym(Maybe<&2, V>, HT.nthm(~V, $EL, s), Some{v0}, hm), {==})
      +hf = Equal.trans(Maybe<&2, SP.Ent<V>>, SP.find(~V, $ES, key), FD.fnd(~V, $LLo, $KL, s, HT.nthm(~V, $EL, s)), Some{$EVS}, FD.find_hit(~V, $LLo, $KL, $EL, s, hlv, key, hk, sl, hmem, $G(ckeys)), Equal.cong(Maybe<&2, V>, Maybe<&2, SP.Ent<V>>, z => FD.fnd(~V, $LLo, $KL, s, z), HT.nthm(~V, $EL, s), Some{v0}, hm))
      ok = RP.repl_ok(~V, $SHA, hg, one, h1, s, hmem, H.slot(l), hsv, v0, hm, key, hk, v, t, lo, hi)
      L.subst(Maybe<&2, SP.Ent<V>>, z => RM.POK(~V, Bool, $AF(z), (LR.replace(&2, V, $F, H.slot(l), $E), False{})), Some{$EVS}, SP.find(~V, $ES, key), Equal.sym(Maybe<&2, SP.Ent<V>>, SP.find(~V, $ES, key), Some{$EVS}, hf), ok)

%def Bi B.at($BS, i)
%def Si UD.v(H.slot(l))

# a present key: replaced in place
def ad_hi(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +key: String, $ENTP, +i: Nat, +l: U32, +hi0: {Nat.is_lt(i, $NN) == True{} : Bool}, +hk0: {B.hold(key, $Bi) == True{} : Bool}, +hl: {B.lnk($Bi) == l : U32}) -> RM.POK(~V, Bool, $AF(SP.find(~V, $ES, key)), $APK(U32.from_nat(i), l, U32.is_eq(l, 0))):
  +hwb = B.all_inst(B.PWell{$BS, sd}, $NN, $G(cwell), i, hi0)
  +hz = L.subst(U32, z => {U32.is_eq(z, 0) == False{} : Bool}, B.lnk($Bi), l, hl, RD.lnz(sd, key, $Bi, hwb, hk0))
  +hsi = Equal.cong(U32, Nat, z => UD.v(H.slot(z)), B.lnk($Bi), l, hl)
  +hbl = TF.bsl_inst($BS, sl, $LLo, $NN, $G(cbsl), i, hi0)
  +hmem = L.subst(Nat, z => {NL.memn(z, sl) == True{} : Bool}, UD.v(H.slot(B.lnk($Bi))), $Si, hsi, TF.hit_mem(sl, $LLo, key, $Bi, hk0, hbl))
  +hk = L.subst(Nat, z => {S.str_eq(ST.skey($LLo, $KL, z), key) == True{} : Bool}, UD.v(H.slot(B.lnk($Bi))), $Si, hsi, TF.hit_key(sl, $LLo, $KL, key, $Bi, hk0, hbl, TF.bkok_at(AR.slots(U32, tabT), $KL, $NN, i, hi0)))
  +hls = TF.slok_mem(~V, $EL, $FR, $Si, sl, $G(csl), hmem)
  ok = ad_v0(~V, $SHA, hg, one, h1, key, v, t, lo, hi, l, $Si, {==}, hmem, hk, HT.nthm(~V, $EL, $Si), {==}, L.and_right(Nat.is_lt($Si, $FR), ST.live(~V, $EL, $Si), hls))
  L.subst(Bool, z => RM.POK(~V, Bool, $AF(SP.find(~V, $ES, key)), $APK(U32.from_nat(i), l, z)), False{}, U32.is_eq(l, 0), Equal.sym(Bool, U32.is_eq(l, 0), False{}, hz), ok)

%def AFD(fd) LR.add_fd(&2, V, cap, n, head, tail, free, $TM, $TE, $TL, v, now, $KW, fd)
%def FDO(r0) PI.fd_of(r0, $TT, $TK, $KS)
%def AE(at, l, x) LR.add_e(&2, V, cap, n, head, tail, free, $TT, $TK, $TE, $TL, $KS, at, $KW, l, x)
%def EOQ {LR.entry_of(&2, V, $TM, v, now) == ($TM, $E) : Array<U32> & LR.Ent<&2, V>}

def ad_x(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +key: String, $ENTP, +now: W.U64, +eo: $EOQ, +hroom: {Nat.is_le(Nat.double(1n+UD.v(n)), $NN) == True{} : Bool}, +r0: B.Res, hres: B.ResOK($BS, $NN, $HOME, key, r0)) -> RM.POK(~V, Bool, $AF(SP.find(~V, $ES, key)), $AFD($FDO(r0))):
  match r0:
    case B.RHit{+i, +l}:
      (+hi0, rest) = hres
      (+hk0, hl) = rest
      +E1 = Equal.cong(Array<U32> & LR.Ent<&2, V>, LR.LRU<&2, V> & Bool, x => $AE(U32.from_nat(i), l, x), LR.entry_of(&2, V, $TM, v, now), ($TM, $E), eo)
      L.subst(LR.LRU<&2, V> & Bool, z => RM.POK(~V, Bool, $AF(SP.find(~V, $ES, key)), z), $APK(U32.from_nat(i), l, U32.is_eq(l, 0)), $AFD($FDO(B.RHit{i, l})), Equal.sym(LR.LRU<&2, V> & Bool, $AFD($FDO(B.RHit{i, l})), $APK(U32.from_nat(i), l, U32.is_eq(l, 0)), E1), ad_hi(~V, $SHA, hg, one, h1, key, v, t, lo, hi, i, l, hi0, hk0, hl))
    case B.REnd{+e0}:
      (+he, rest) = hres
      (+hz, rest2) = rest
      (+hp, hno) = rest2
      +E1 = Equal.cong(Array<U32> & LR.Ent<&2, V>, LR.LRU<&2, V> & Bool, x => $AE(U32.from_nat(e0), 0, x), LR.entry_of(&2, V, $TM, v, now), ($TM, $E), eo)
      L.subst(LR.LRU<&2, V> & Bool, z => RM.POK(~V, Bool, $AF(SP.find(~V, $ES, key)), z), $APK(U32.from_nat(e0), 0, True{}), $AFD($FDO(B.REnd{e0})), Equal.sym(LR.LRU<&2, V> & Bool, $AFD($FDO(B.REnd{e0})), $APK(U32.from_nat(e0), 0, True{}), E1), ad_end(~V, $SHA, hg, one, h1, key, hno, e0, he, hz, hp, hroom, v, t, lo, hi))

%def K2L AR.slots(String, K2)
%def PB H.probe($TT, $TK, CY.msk(k), key)
%def AFN(x) LR.add_found(&2, V, cap, n, head, tail, free, $TM, $TE, $TL, v, now, x)
%def ESz(z) ST.es(~V, $LLo, z, $EL, sl)
%def AFz(z, e2) SP.add_found(~V, cap, $M3, $W4, $ESz(z), $CTR, key, e2, SP.find(~V, $ESz(z), key))
%def GFz(z, p) ST.goodF(~V, cap, n, head, tail, free, W32.nth0($ML, 0n), W32.nth0($ML, 1n), W32.nth0($ML, 2n), W32.nth0($ML, 6n), W32.nth0($ML, 7n), AR.perfect(U32, 5n, mT), k, sd, tabT, z, p, eT, lkT, sl, fl)
%def MK SP.mk(~V, $M3, $W4, key, v, now)
%def FDK(r0) PI.fd_of(r0, $TT, AR.thaw(String, K2), $KS)

def ad_po(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +key: String, $ENTP, +now: W.U64, +eo: $EOQ, +esp: {$EN == $MK : SP.Ent<V>}, +hroom: {Nat.is_le(Nat.double(1n+UD.v(n)), $NN) == True{} : Bool}, +r0: B.Res, hres: B.ResOK($BS, $NN, $HOME, key, r0), po: PA.ProbeOK(tabT, sd, $KL, $KS, $KW, r0, $PB)) -> RM.POK(~V, Bool, $AFz($KL, $MK), $AFN($PB)):
  match po:
    case Tuple{+K2, Tuple{+e, Tuple{+hsl, pk2}}}:
      +pk = $G(cpk)
      +g1 = L.subst(List<&2, String>, z => {$GFz(z, AR.perfect(String, sd, ksT)) == True{} : Bool}, $KL, $K2L, Equal.sym(List<&2, String>, $K2L, $KL, hsl), hg)
      +hg2 = L.subst(Bool, z => {$GFz($K2L, z) == True{} : Bool}, AR.perfect(String, sd, ksT), AR.perfect(String, sd, K2), Equal.trans(Bool, AR.perfect(String, sd, ksT), True{}, AR.perfect(String, sd, K2), pk, Equal.sym(Bool, AR.perfect(String, sd, K2), True{}, pk2)), g1)
      hres2 = L.subst(List<&2, String>, z => B.ResOK(TB.buckets(AR.slots(U32, tabT), z, $NN), $NN, $HOME, key, r0), $KL, $K2L, Equal.sym(List<&2, String>, $K2L, $KL, hsl), hres)
      ok = ad_x(~V, cap, n, head, tail, free, mT, k, sd, tabT, K2, eT, lkT, sl, fl, hg2, one, h1, key, v, t, lo, hi, now, eo, hroom, r0, hres2)
      ok2 = L.subst(List<&2, String>, z => RM.POK(~V, Bool, $AFz(z, $EN), $AFD($FDK(r0))), $K2L, $KL, hsl, ok)
      ok3 = L.subst(SP.Ent<V>, z => RM.POK(~V, Bool, $AFz($KL, z), $AFD($FDK(r0))), $EN, $MK, esp, ok2)
      +E = Equal.cong(H.Found & U32, LR.LRU<&2, V> & Bool, x => $AFN(x), $PB, ($FDK(r0), $KW), e)
      L.subst(LR.LRU<&2, V> & Bool, z => RM.POK(~V, Bool, $AFz($KL, $MK), z), $AFN(($FDK(r0), $KW)), $AFN($PB), Equal.sym(LR.LRU<&2, V> & Bool, $AFN($PB), $AFN(($FDK(r0), $KW)), E), ok3)

%def R0 B.pf(key, $BS, $NN, $NN, B.mstep(key, B.at($BS, $HOME)), $HOME)
%def ADM(r) LR.add_m(&2, V, cap, n, head, tail, free, $TT, $TK, $TE, $TL, key, v, now, r)

def ad_ent(~V: Data, $SHF, +hg: {ST.good(~V, $SH) == True{} : Bool}, +one: Nat, +h1: {one == 1n : Nat}, +key: String, +v: V, +now: W.U64, +hroom: {Nat.is_le(Nat.double(1n+UD.v(n)), $NN) == True{} : Bool}, eok: ENT.EntOK(~V, mT, $G(cpm), v, now, key)) -> RM.POK(~V, Bool, SP.add(~V, ST.model(~V, $SH), key, v, now), LR.add_go(&2, V, $F, key, v, now)):
  match eok:
    case Tuple{+t, Tuple{+lo, Tuple{+hi, Tuple{+eo, esp}}}}:
      +es2 = {esp : {$EN == $MK : SP.Ent<V>}}
      +hk30 = L.and_left(Nat.is_lt(k, 30n), Nat.is_lt(0n, k), $G(ck))
      +hk31 = N.lt_trans(k, 30n, 31n, hk30, {==})
      +hsd32 = N.lt_trans(sd, 3n+sd, 32n, N.lt_le_trans(sd, 1n+sd, 3n+sd, N.lt_succ(sd), N.le_trans(1n+sd, 2n+sd, 3n+sd, N.le_succ(1n+sd), N.le_succ(2n+sd))), RD.f_hsd(~V, $SHA, hg))
      +hn = N.succ_le_lt(0n, $NN, N.pow2_pos(k))
      +cn = N.eq_from_is_eq(UD.v(n), IV.occn($BS, $NN), $G(cn))
      +hocc = L.subst(Nat, z => {Nat.is_lt(z, $NN) == True{} : Bool}, UD.v(n), IV.occn($BS, $NN), cn, BA.n_lt(~V, $SHA, hg))
      hres = G.res_e0($BS, $NN, hn, CY.msk(k), key, $HOME, PA.home_lt($KW, k), $G(cclus), IV.home_all($BS, sd, CY.msk(k), key, $NN, $G(cwell), $NN, N.le_refl($NN)), IV.find_empty($BS, $NN, hocc))
      ok = ad_po(~V, $SHA, hg, one, h1, key, v, t, lo, hi, now, eo, es2, hroom, $R0, hres, PA.probe_ok(one, h1, k, hk31, tabT, $G(cpt), sd, hsd32, $KL, ksT, {==}, $G(cpk), $G(cwell), key))
      +g6 = Equal.trans(Array<U32> & U32, Array.get(U32, $TM, 6), ($TM, W32.nth0($ML, 6n)), ($TM, CY.msk(k)), UT.uget(5n, {==}, mT, $G(cpm), 6, {==}), Equal.cong(U32, Array<U32> & U32, z => ($TM, z), W32.nth0($ML, 6n), CY.msk(k), A.eq_of(W32.nth0($ML, 6n), CY.msk(k), $G(cmask))))
      +E = Equal.cong(Array<U32> & U32, LR.LRU<&2, V> & Bool, r => $ADM(r), Array.get(U32, $TM, 6), ($TM, CY.msk(k)), g6)
      L.subst(LR.LRU<&2, V> & Bool, z => RM.POK(~V, Bool, SP.add(~V, ST.model(~V, $SH), key, v, now), z), $AFN($PB), LR.add_go(&2, V, $F, key, v, now), Equal.sym(LR.LRU<&2, V> & Bool, LR.add_go(&2, V, $F, key, v, now), $AFN($PB), E), ok)

def ad_sh(~V: Data, +one: Nat, +h1: {one == 1n : Nat}, +sh: ST.Sh<V>, +hg: {ST.good(~V, sh) == True{} : Bool}, +hr: {RO.roomy(~V, sh) == True{} : Bool}, +key: String, +v: V, +now: W.U64) -> RM.POK(~V, Bool, SP.add(~V, ST.model(~V, sh), key, v, now), LR.add_go(&2, V, ST.real(~V, sh), key, v, now)):
  match sh:
    case ST.LS{$SHA}:
      ad_ent(~V, $SHA, hg, one, h1, key, v, now, hr, ENT.ent_ok(~V, mT, $G(cpm), v, now, key))

%def ROK RO.RoomOK(~V, sh, LR.room(&2, V, ST.real(~V, sh)))

def ad_room(~V: Data, +one: Nat, +h1: {one == 1n : Nat}, +sh: ST.Sh<V>, +key: String, +v: V, +now: W.U64, ro: $ROK) -> RM.POK(~V, Bool, SP.add(~V, ST.model(~V, sh), key, v, now), LR.add(&2, V, ST.real(~V, sh), key, v, now)):
  match ro:
    case Tuple{+sh2, Tuple{+e1, Tuple{+em, Tuple{+g2, hr2}}}}:
      ok = ad_sh(~V, one, h1, sh2, g2, hr2, key, v, now)
      ok2 = L.subst(SP.Lru<V>, z => RM.POK(~V, Bool, SP.add(~V, z, key, v, now), LR.add_go(&2, V, ST.real(~V, sh2), key, v, now)), ST.model(~V, sh2), ST.model(~V, sh), em, ok)
      L.subst($RL, z => RM.POK(~V, Bool, SP.add(~V, ST.model(~V, sh), key, v, now), LR.add_go(&2, V, z, key, v, now)), ST.real(~V, sh2), LR.room(&2, V, ST.real(~V, sh)), Equal.sym($RL, LR.room(&2, V, ST.real(~V, sh)), ST.real(~V, sh2), e1), ok2)

# THEOREM (add): add refines the specification (inserting or replacing,
# evicting the oldest entry when full), for caches of fewer than 2^28 entries
def add_ok(~V: Data, +one: Nat, +h1: {one == 1n : Nat}, +cz: Nat, +hcz: {cz == 29n : Nat}, +sh: ST.Sh<V>, +hg: {ST.good(~V, sh) == True{} : Bool}, +hcap: {RO.capok(~V, sh, cz) == True{} : Bool}, +key: String, +v: V, +now: W.U64) -> RM.POK(~V, Bool, SP.add(~V, ST.model(~V, sh), key, v, now), LR.add(&2, V, ST.real(~V, sh), key, v, now)):
  ad_room(~V, one, h1, sh, key, v, now, RO.room_ok(~V, one, h1, sh, hg, cz, hcz, hcap))

%def LEN SP.length(~V, ST.lru_es(~V, ST.model(~V, sh)))

def capok_of(~V: Data, +cz: Nat, +sh: ST.Sh<V>, +hg: {ST.good(~V, sh) == True{} : Bool}, +h: {Nat.is_le(Nat.double(1n+$LEN), SC.pow2(cz)) == True{} : Bool}) -> {RO.capok(~V, sh, cz) == True{} : Bool}:
  match sh:
    case ST.LS{$SHA}:
      L.subst(Nat, z => {Nat.is_le(Nat.double(1n+z), SC.pow2(cz)) == True{} : Bool}, SP.length(~V, $ES), UD.v(n), BA.len_model(~V, $SHA, hg), h)

# THEOREM (add), the precondition on the model: 2 (len + 1) <= 2^29
def add_spec_ok(~V: Data, +one: Nat, +h1: {one == 1n : Nat}, +cz: Nat, +hcz: {cz == 29n : Nat}, +sh: ST.Sh<V>, +hg: {ST.good(~V, sh) == True{} : Bool}, +h: {Nat.is_le(Nat.double(1n+$LEN), SC.pow2(cz)) == True{} : Bool}, +key: String, +v: V, +now: W.U64) -> RM.POK(~V, Bool, SP.add(~V, ST.model(~V, sh), key, v, now), LR.add(&2, V, ST.real(~V, sh), key, v, now)):
  add_ok(~V, one, h1, cz, hcz, sh, hg, capok_of(~V, cz, sh, hg, h), key, v, now)
