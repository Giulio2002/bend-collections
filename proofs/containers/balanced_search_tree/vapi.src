%def SPB Sigma<&1, &1, $ES, xa => Sigma<&1, &1, $ES, xb => {$EST == $EAPP(xa, xb) : $ES} & ({VS.allbu($AK, hi2, xa) == True{} : Bool} & ({S.within($AK, lo2, hi2, xb) == Nil{} : $ES} & {VS.lbu($AK, hi2, $EST, None{}) == OR.orm($E, S.last($E, xa), None{}) : $ME}))>>

def vcb2($TO, $FT, +hg: $GF, $VB, +j: Nat, +h1: {MI.range_start($AK, $SH, hi2, False{}) == ($SH, j) : $SHT & Nat}, +h2: {$CK(j) == S.start($AK, hi2, False{}, $EST) : $MK}, +h3: $IDK(j), sp: $SPB) -> $VCG(True{}):
  match sp:
    case Tuple{+xa, Tuple{+xb, Tuple{+hab, r}}}:
      vcb3($AO, $F, hg, $VBA, j, h1, h2, h3, xa, xb, hab, r)

def vcb1($TO, $FT, +hg: $GF, $VB, +j: Nat, +h1: {MI.range_start($AK, $SH, hi2, False{}) == ($SH, j) : $SHT & Nat}, r: {$CK(j) == S.start($AK, hi2, False{}, $EST) : $MK} & $IDK(j)) -> $VCG(True{}):
  match r:
    case Tuple{h2, h3}:
      vcb2($AO, $F, hg, $VBA, j, h1, h2, h3, VS.split_lbu($AO, lo2, hi2, $EST, None{}, $ORDH))

def vcb($TO, $FT, +hg: $GF, $VB, r: $RSID(hi2, False{})) -> $VCG(True{}):
  match r:
    case Tuple{+j, Tuple{+h1, r2}}:
      vcb1($AO, $F, hg, $VBA, j, h1, r2)

def vclr_m($TO, $FT, +hg: $GF, $VB, +d2: Bool) -> $VCG(d2):
  match d2:
    case True{}:
      vcb($AO, $F, hg, $VBA, VI.rsid($AO, $F, hg, hi2, False{}))
    case False{}:
      vcf($AO, $F, hg, $VBA, VI.rsid($AO, $F, hg, lo2, True{}))

def view_clear_ok($TO, $HW) -> VD.VOK($AK, S.view_clear($AK, VD.vmod($AK, w)), M.view_clear($AK, MI.rv($AK, w))):
  match w:
    case MI.MV{ST.SH{$FP}, +lo2, +hi2, +d2}:
      vclr_m($AO, $F, hw, lo2, hi2, d2)
