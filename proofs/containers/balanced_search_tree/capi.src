# The implementation's cursors refine the specification's: from a good
# cursor (a good shadow, its ids 0 or in the tree), each operation gives the
# real cursor of a good cursor whose model is the specification's result.
# (source: tools/generators/tm_hand/capi.src)

%def E M.Entry<K, V>
%def ME Maybe<&2, $E>
%def MV Maybe<&2, V>
%def TK ~K: Data, ~V: Data, ~cmp: K -> K -> Cmp
%def TO ~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, ~o: O.Order(~K, ~cmp)
%def AK ~K, ~V, ~cmp
%def AO ~K, ~V, ~cmp, ~o
%def FP +n, +root, +lo, +hi, +free, +l, +d, +nl, +pl, +tg, +fl
%def F n, root, lo, hi, free, l, d, nl, pl, tg, fl
%def SH ST.SH{$F}
%def SHT ST.Sh<K, V>
%def TMT M.TreeMap<K, V, cmp>
%def MCT MI.MCursor<K, V>
%def CUR MI.MC{$SH, nx, cu, lo2, hi2, fw}
%def CPT +c: $MCT, +hc: {CU.cgood($AK, c) == True{} : Bool}
%def REST Bool.and(CU.idok(ST.ids(tg), nx), Bool.and(CU.idok(ST.ids(tg), cu), Bool.or(Nat.is_eq(nx, 0n), Bool.not(Nat.is_eq(nx, cu)))))
%def HG L.and_left(ST.goodF($AK, $F), $REST, hc)
%def DGC OK.dg_good($AK, $SH, $HG)
%def CURP MI.MC{ST.SH{$FP}, +nx, +cu, +lo2, +hi2, +fw}
%def RC(c) MI.rc($AK, c)
%def CM(c) CU.cmod($AK, c)

# ---- starting ----

%def CST(sp, r) Sigma<&1, &1, $MCT, c2 => {r == MI.rc($AK, c2) : M.Cursor<K, V, cmp>} & ({sp == CU.cmod($AK, c2) : S.Cursor<K, V>} & {CU.cgood($AK, c2) == True{} : Bool})>
%def CIT(sp, mc) Sigma<&1, &1, $MCT, c2 => {MI.rc($AK, mc) == MI.rc($AK, c2) : M.Cursor<K, V, cmp>} & ({sp == CU.cmod($AK, c2) : S.Cursor<K, V>} & {CU.cgood($AK, c2) == True{} : Bool})>

def cst_up($TK, -sp: S.Cursor<K, V>, -mc: $MCT, -r: M.Cursor<K, V, cmp>, +hs: {r == MI.rc($AK, mc) : M.Cursor<K, V, cmp>}, p: $CIT(sp, mc)) -> $CST(sp, r):
  match p:
    case Tuple{+c2, Tuple{+h1, rest}}:
      (c2, (Equal.trans(M.Cursor<K, V, cmp>, r, MI.rc($AK, mc), MI.rc($AK, c2), hs, h1), rest))

def iterator_ok($TK, +sh: $SHT, +hg: {ST.good($AK, sh) == True{} : Bool}) -> $CST(S.iterator(K, V, ST.model($AK, sh)), M.iterator($AK, ST.real($AK, sh))):
  match sh:
    case ST.SH{$FP}:
      cst_up($AK, S.iterator(K, V, ST.model($AK, $SH)), MI.iterator($AK, $SH), M.iterator($AK, ST.real($AK, $SH)), SM.iterator_s($AK, $SH, OK.dg_good($AK, $SH, hg)), CU.iterator_m($AK, $F, hg))

def descending_iterator_ok($TK, +sh: $SHT, +hg: {ST.good($AK, sh) == True{} : Bool}) -> $CST(S.descending_iterator(K, V, ST.model($AK, sh)), M.descending_iterator($AK, ST.real($AK, sh))):
  match sh:
    case ST.SH{$FP}:
      cst_up($AK, S.descending_iterator(K, V, ST.model($AK, $SH)), MI.descending_iterator($AK, $SH), M.descending_iterator($AK, ST.real($AK, $SH)), SM.descending_iterator_s($AK, $SH, OK.dg_good($AK, $SH, hg)), CU.descending_iterator_m($AK, $F, hg))

# ---- stepping ----

def iterator_has_next_ok($TK, $CPT) -> CU.CPOK($AK, Bool, S.iterator_has_next($AK, $CM(c)), M.iterator_has_next($AK, $RC(c))):
  match c:
    case $CURP:
      CU.cok_cpok($AK, Bool, S.iterator_has_next($AK, $CM($CUR)), MI.iterator_has_next($AK, $CUR), M.iterator_has_next($AK, $RC($CUR)), SM.iterator_has_next_s($AK, $CUR, $DGC), CU.has_next_m($AK, $F, nx, cu, lo2, hi2, fw, hc))

def iterator_next_ok($TO, $CPT) -> CU.CPOK($AK, $ME, S.iterator_next($AK, $CM(c)), M.iterator_next($AK, $RC(c))):
  match c:
    case $CURP:
      CU.cok_cpok($AK, $ME, S.iterator_next($AK, $CM($CUR)), MI.iterator_next($AK, $CUR), M.iterator_next($AK, $RC($CUR)), SM.iterator_next_s($AK, $CUR, $DGC), CU.cstep_cok($AK, $ME, S.iterator_next($AK, $CM($CUR)), MI.iterator_next($AK, $CUR), $SH, lo2, hi2, fw, CX.next_m($AO, $F, nx, cu, lo2, hi2, fw, hc)))

def iterator_next_key_ok($TO, $CPT) -> CU.CPOK($AK, Maybe<&2, K>, S.iterator_next_key($AK, $CM(c)), M.iterator_next_key($AK, $RC(c))):
  match c:
    case $CURP:
      CU.cok_cpok($AK, Maybe<&2, K>, S.iterator_next_key($AK, $CM($CUR)), MI.iterator_next_key($AK, $CUR), M.iterator_next_key($AK, $RC($CUR)), SM.iterator_next_key_s($AK, $CUR, $DGC), CX.next_key_m($AO, $F, nx, cu, lo2, hi2, fw, hc))

def iterator_next_value_ok($TO, $CPT) -> CU.CPOK($AK, $MV, S.iterator_next_value($AK, $CM(c)), M.iterator_next_value($AK, $RC(c))):
  match c:
    case $CURP:
      CU.cok_cpok($AK, $MV, S.iterator_next_value($AK, $CM($CUR)), MI.iterator_next_value($AK, $CUR), M.iterator_next_value($AK, $RC($CUR)), SM.iterator_next_value_s($AK, $CUR, $DGC), CX.next_value_m($AO, $F, nx, cu, lo2, hi2, fw, hc))

# ---- changing the map through the cursor ----

%def RES Result<&2, &2, M.Error, V>

def iterator_set_value_ok($TO, $CPT, +v: V) -> CU.CPOK($AK, $RES, S.iterator_set_value($AK, $CM(c), v), M.iterator_set_value($AK, $RC(c), v)):
  match c:
    case $CURP:
      CU.cok_cpok($AK, $RES, S.iterator_set_value($AK, $CM($CUR), v), MI.iterator_set_value($AK, $CUR, v), M.iterator_set_value($AK, $RC($CUR), v), SM.iterator_set_value_s($AK, $CUR, v, $DGC), CS.set_value_m($AO, $F, cu, nx, lo2, hi2, fw, v, hc))

%def U 1n+j
%def CURZ MI.MC{$SH, nx, 0n, lo2, hi2, fw}
%def CURU MI.MC{$SH, nx, $U, lo2, hi2, fw}
%def AM MI.unlink_target($AK, MI.delete_target($AK, $U, (ST.SH{n, root, lo, hi, free, l, d, nl, PR.ex_pl(V, pl, $U, None{}), tg, fl}, ST.nd(K, nl, $U))))
%def RESTZ Bool.and(CU.idok(ST.ids(tg), nx), Bool.and(CU.idok(ST.ids(tg), 0n), Bool.or(Nat.is_eq(nx, 0n), Bool.not(Nat.is_eq(nx, 0n)))))
%def RESTU Bool.and(CU.idok(ST.ids(tg), nx), Bool.and(CU.idok(ST.ids(tg), $U), Bool.or(Nat.is_eq(nx, 0n), Bool.not(Nat.is_eq(nx, $U)))))
%def HGU L.and_left(ST.goodF($AK, $F), $RESTU, hc)
%def DGU OK.dg_good($AK, $SH, $HGU)
%def RMS(cc) CU.CPOK($AK, $MV, S.iterator_remove($AK, $CM(cc)), M.iterator_remove($AK, $RC(cc)))

def iterator_remove_ok($TO, $CPT) -> CU.CPOK($AK, $MV, S.iterator_remove($AK, $CM(c)), M.iterator_remove($AK, $RC(c))):
  match c:
    case MI.MC{ST.SH{$FP}, +nx, 0n, +lo2, +hi2, +fw}:
      CU.cok_cpok($AK, $MV, S.iterator_remove($AK, $CM($CURZ)), MI.iterator_remove($AK, $CURZ), M.iterator_remove($AK, $RC($CURZ)), SM.iterator_remove_s($AK, $CURZ, OK.dg_good($AK, $SH, L.and_left(ST.goodF($AK, $F), $RESTZ, hc))), CR.rmz($AO, $F, lo2, hi2, fw, nx, hc))
    case MI.MC{ST.SH{$FP}, +nx, 1n+ +j, +lo2, +hi2, +fw}:
      CU.cok_cpok($AK, $MV, S.iterator_remove($AK, $CM($CURU)), MI.iterator_remove($AK, $CURU), M.iterator_remove($AK, $RC($CURU)), SM.iterator_remove_s($AK, $CURU, $DGU), CR.rmu($AO, $F, lo2, hi2, fw, nx, j, hc, kk => pc => pa => pb => hbc => hplug => hr => hok => hfin => RV.rm_x($AO, $F, $HGU, kk, pc, j, pa, pb, hbc, hplug, hr, hok, hfin, ST.nd(K, nl, $U), {==}), kk => s2 => e => hd => Equal.trans($TMT & M.Search, MI.rp($AK, M.Search, MI.search($AK, $AM, kk)), M.search($AK, ST.real($AK, $AM), kk), MI.rp($AK, M.Search, MI.search($AK, s2, kk)), Equal.sym($TMT & M.Search, M.search($AK, ST.real($AK, $AM), kk), MI.rp($AK, M.Search, MI.search($AK, $AM, kk)), SM.search_s($AK, $AM, kk, SM.remove_id_g($AK, $SH, $U, $DGU))), Equal.trans($TMT & M.Search, M.search($AK, ST.real($AK, $AM), kk), M.search($AK, ST.real($AK, s2), kk), MI.rp($AK, M.Search, MI.search($AK, s2, kk)), L.subst($TMT, z => {M.search($AK, ST.real($AK, $AM), kk) == M.search($AK, z, kk) : $TMT & M.Search}, ST.real($AK, $AM), ST.real($AK, s2), e, {==}), SM.search_s($AK, s2, kk, hd)))))

# ---- finishing ----

def iterator_finish_ok($TK, $CPT) -> Sigma<&1, &1, $SHT, s2 => {M.iterator_finish($AK, $RC(c)) == ST.real($AK, s2) : $TMT} & ({S.iterator_finish(K, V, $CM(c)) == ST.model($AK, s2) : S.Model<K, V>} & {ST.good($AK, s2) == True{} : Bool})>:
  match c:
    case $CURP:
      ($SH, (SM.iterator_finish_s($AK, $CUR, $DGC), ({==}, $HG)))

# ---- contains_value: the walk over the entries ----

%def TQ ~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, ~o: O.Order(~K, ~cmp), ~eq: V -> V -> Bool
%def AQ ~K, ~V, ~cmp, ~o, ~eq
%def EST ST.ents(~K, ~V, ST.ids(tg), nl, pl)

def via_cv($TK, -impl: $TMT & Bool, -mir: $SHT & Bool, +s: $SHT, +o: Bool, +hs: {impl == MI.rp($AK, Bool, mir) : $TMT & Bool}, +hm: {mir == (s, o) : $SHT & Bool}) -> {impl == (ST.real($AK, s), o) : $TMT & Bool}:
  L.subst($SHT & Bool, z => {impl == MI.rp($AK, Bool, z) : $TMT & Bool}, mir, (s, o), hm, hs)

def contains_value_ok($TQ, +sh: $SHT, +hg: {ST.good($AK, sh) == True{} : Bool}, +w: V) -> OK.POK($AK, Bool, S.contains_value(~K, ~V, ~eq, ST.model($AK, sh), w), M.contains_value($AK, ~eq, ST.real($AK, sh), w)):
  match sh:
    case ST.SH{$FP}:
      OK.pok_read($AK, Bool, $SH, hg, S.any_value(~K, ~V, ~eq, w, $EST), S.contains_value(~K, ~V, ~eq, ST.model($AK, $SH), w), M.contains_value($AK, ~eq, ST.real($AK, $SH), w), {==}, via_cv($AK, M.contains_value($AK, ~eq, ST.real($AK, $SH), w), MI.contains_value($AK, ~eq, $SH, w), $SH, S.any_value(~K, ~V, ~eq, w, $EST), SM.contains_value_s($AK, ~eq, $SH, w, OK.dg_good($AK, $SH, hg)), CV.contains_value_m($AQ, $F, hg, w)))
