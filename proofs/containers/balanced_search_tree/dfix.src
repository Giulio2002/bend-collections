import Base
import ../../lib/logic.bend as L
import ../../lib/nat.bend as N
import ../../lib/order.bend as O
import ../../../spec/lib/common.bend as SC
import ../../../src/containers/balanced_search_tree.bend as M
import ./state.bend as ST
import ./mirror.bend as MI
import ./tree.bend as TR
import ./ends.bend as EN
import ./path.bend as P
import ./plug.bend as PG
import ./setters.bend as SE
import ./rotm.bend as RM
import ./rotp.bend as RP
import ./nbr.bend as NB
import ./dj.bend as DJ
import ./spath.bend as SP
import ./fix.bend as FX
import ../../lib/nat_list.bend as NL


# The deletion fix-up: from the position x the unlinked node's child took
# (its subtree possibly empty) under its parent, the loop recolours and
# rotates on either side; whatever it does and however far its fuel goes, it
# ends with a black root over a linked tree of the same ids, entries and free
# chain. (source: tools/generators/tm_hand/dfix.src)

%include fix.src
%def DFIX(f, st) MI.delete_fix_loop($AK, f, st)
%def DIH(c, t) +i1: $REPN(t, P.top(c), nl), +i2: $COKN(c, ST.rid(t), nl), +i3: $NDL($WH(c, t)), +i4: {$WH(c, t) == i0 : $LN}, +i5: {root == ST.rid(PG.plug(c, t)) : Nat}
%def DIA i1, i2, i3, i4, i5
%def HA h4, h5, h6, h7
%def DKONT(gf) @+kr_: Nat -> @+kn_: $NL -> @+kc_: $CT -> @+kt_: ST.Tr -> @+ki1: $REPN(kt_, P.top(kc_), kn_) -> @+ki2: $COKN(kc_, ST.rid(kt_), kn_) -> @+ki3: $NDL($WH(kc_, kt_)) -> @+ki4: {$WH(kc_, kt_) == i0 : $LN} -> @+ki5: {kr_ == ST.rid(PG.plug(kc_, kt_)) : Nat} -> @+kh4: {ST.ents(~K, ~V, i0, kn_, pl) == e0 : $ES} -> @+kh5: {EN.oks(~K, ~V, i0, kn_, pl) == True{} : Bool} -> @+kh6: {ST.fll(~K, kn_, fx) == True{} : Bool} -> @+kh7: {SC.length($ND, kn_) == l0 : Nat} -> $FP($DFIX(gf, ($SHR(kr_, kn_), M.DF{ST.rid(kt_), P.top(kc_), True{}})))

# recolouring keeps the links, the entries, the free chain and the length
%def SETC(x, id, v) SE.setc(K, x, id, v)
%def RSC(t, q, x, id, v, h) Equal.trans(Bool, ST.rep(~K, t, q, $SETC(x, id, v)), ST.rep(~K, t, q, x), True{}, SE.rep_setc(~K, t, q, x, id, v), h)
%def CSC(c, z, x, id, v, h) Equal.trans(Bool, P.ctxok(~K, c, z, $SETC(x, id, v)), P.ctxok(~K, c, z, x), True{}, SE.ctx_setc(~K, c, z, x, id, v), h)
%def E4(x, id, v, h) Equal.trans($ES, ST.ents(~K, ~V, i0, $SETC(x, id, v), pl), ST.ents(~K, ~V, i0, x, pl), e0, SE.ents_setc(~K, ~V, i0, x, pl, id, v), h)
%def E5(x, id, v, h) Equal.trans(Bool, EN.oks(~K, ~V, i0, $SETC(x, id, v), pl), EN.oks(~K, ~V, i0, x, pl), True{}, SE.oks_setc(~K, ~V, i0, x, pl, id, v), h)
%def E6(x, id, v, h) Equal.trans(Bool, ST.fll(~K, $SETC(x, id, v), fx), ST.fll(~K, x, fx), True{}, SE.fll_setc(~K, fx, x, id, v), h)
%def E7(x, id, v, h) Equal.trans(Nat, SC.length($ND, $SETC(x, id, v)), SC.length($ND, x), l0, SE.setc_len(K, x, id, v), h)
%def EALL(x, id, v, a4, a5, a6, a7) $E4(x, id, v, a4), $E5(x, id, v, a5), $E6(x, id, v, a6), $E7(x, id, v, a7)
%def SRM(r, x, id, v) SE.set_red_m($AK, n, r, lo, hi, free, l, d, x, pl, tg, fl, id, v)

# so do rotations
%def ROTL(x, a, b, bb, q, dr) RM.rotl_nl(K, x, a, b, bb, q, dr)
%def ROTR(x, a, b, bb, q, dr) RM.rotr_nl(K, x, a, b, bb, q, dr)
%def LALL(x, a, b, bb, q, dr, a4, a5, a6, a7) Equal.trans($ES, ST.ents(~K, ~V, i0, $ROTL(x, a, b, bb, q, dr), pl), ST.ents(~K, ~V, i0, x, pl), e0, RP.rotl_ents(~K, ~V, i0, pl, x, a, b, bb, q, dr), a4), Equal.trans(Bool, EN.oks(~K, ~V, i0, $ROTL(x, a, b, bb, q, dr), pl), EN.oks(~K, ~V, i0, x, pl), True{}, RP.rotl_oks(~K, ~V, i0, pl, x, a, b, bb, q, dr), a5), Equal.trans(Bool, ST.fll(~K, $ROTL(x, a, b, bb, q, dr), fx), ST.fll(~K, x, fx), True{}, RP.rotl_fll(~K, fx, x, a, b, bb, q, dr), a6), Equal.trans(Nat, SC.length($ND, $ROTL(x, a, b, bb, q, dr)), SC.length($ND, x), l0, RP.rotl_len(~K, x, a, b, bb, q, dr), a7)
%def RALL(x, a, b, bb, q, dr, a4, a5, a6, a7) Equal.trans($ES, ST.ents(~K, ~V, i0, $ROTR(x, a, b, bb, q, dr), pl), ST.ents(~K, ~V, i0, x, pl), e0, RP.rotr_ents(~K, ~V, i0, pl, x, a, b, bb, q, dr), a4), Equal.trans(Bool, EN.oks(~K, ~V, i0, $ROTR(x, a, b, bb, q, dr), pl), EN.oks(~K, ~V, i0, x, pl), True{}, RP.rotr_oks(~K, ~V, i0, pl, x, a, b, bb, q, dr), a5), Equal.trans(Bool, ST.fll(~K, $ROTR(x, a, b, bb, q, dr), fx), ST.fll(~K, x, fx), True{}, RP.rotr_fll(~K, fx, x, a, b, bb, q, dr), a6), Equal.trans(Nat, SC.length($ND, $ROTR(x, a, b, bb, q, dr)), SC.length($ND, x), l0, RP.rotr_len(~K, x, a, b, bb, q, dr), a7)

# a frame's facts: its parent's check, the frames above, the parent's node
# and the sibling's links
%def COK1(p, lft, s, z, c1, x, h) L.and_left(P.cok1(~K, P.FR{p, lft, s}, z, P.top(c1), x), P.ctxok(~K, c1, p, x), h)
%def COKT(p, lft, s, z, c1, x, h) L.and_right(P.cok1(~K, P.FR{p, lft, s}, z, P.top(c1), x), P.ctxok(~K, c1, p, x), h)
%def ISNB(p, lft, s, z, q, x) Bool.and(ST.is_node(K, ST.nd(K, x, p), ST.pk(Nat, lft, z, ST.rid(s)), ST.pk(Nat, lft, ST.rid(s), z), q), ST.rep(~K, s, p, x))
%def CISN(p, lft, s, z, q, x, h) L.and_left(ST.is_node(K, ST.nd(K, x, p), ST.pk(Nat, lft, z, ST.rid(s)), ST.pk(Nat, lft, ST.rid(s), z), q), ST.rep(~K, s, p, x), L.and_right(Nat.is_lt(0n, p), $ISNB(p, lft, s, z, q, x), h))
%def CSRP(p, lft, s, z, q, x, h) L.and_right(ST.is_node(K, ST.nd(K, x, p), ST.pk(Nat, lft, z, ST.rid(s)), ST.pk(Nat, lft, ST.rid(s), z), q), ST.rep(~K, s, p, x), L.and_right(Nat.is_lt(0n, p), $ISNB(p, lft, s, z, q, x), h))

# ---- the end ----

# a linked tree of the ids and a step that stopped: the loop blackens the root
def dstop($TO, $FX, +gf: Nat, +root: Nat, +nl: $NL, $TH, $IVH(nl)) -> $FP($DFIX(gf, ($SHR(root, nl), M.DF{0n, 0n, False{}}))):
  match gf:
    case 0n:
      FX.fin($AO, $FXA, root, nl, t, h1, h2, h3, $HA)
    case 1n+g:
      FX.fin($AO, $FXA, root, nl, t, h1, h2, h3, $HA)

# the path invariant gives the whole tree
def dfin($TO, $FX, +root: Nat, +nl: $NL, +c: $CT, +t: ST.Tr, $DIH(c, t), $IVH(nl)) -> $FP(MI.black_root($AK, $SHR(root, nl))):
  FX.fin($AO, $FXA, root, nl, PG.plug(c, t), PG.rep_plug(~K, nl, c, t, i1, i2), i5, Equal.trans($LN, $IDS(PG.plug(c, t)), $WH(c, t), i0, PG.ids_plug(c, t), i4), $HA)

# ---- the left side: x under p on the left, its sibling s on the right ----

%def CL Con{P.FR{p, True{}, s}, c1}
%def CR Con{P.FR{p, False{}, s}, c1}

# both nephews black: the sibling red, then on from the parent
def dup_l($TO, $FX, +gf: Nat, +root: Nat, +nl: $NL, +c1: $CT, +p: Nat, +s: ST.Tr, +t: ST.Tr, $DIH($CL, t), $IVH(nl), kont: $DKONT(gf)) -> $FP($DFIX(gf, (MI.set_red($AK, $SHR(root, nl), ST.rid(s), True{}), M.DF{p, M.node_parent(~K, ST.nd(K, nl, p)), True{}}))):
  +hk = $COK1(p, True{}, s, ST.rid(t), c1, nl, i2)
  %Equal.sym(Nat, M.node_parent(~K, ST.nd(K, nl, p)), P.top(c1), NB.parent_eq(~K, ST.nd(K, nl, p), ST.rid(t), ST.rid(s), P.top(c1), $CISN(p, True{}, s, ST.rid(t), P.top(c1), nl, hk))) : $FP($DFIX(gf, (MI.set_red($AK, $SHR(root, nl), ST.rid(s), True{}), M.DF{p, _, True{}})))
  %Equal.sym($SHT, MI.set_red($AK, $SHR(root, nl), ST.rid(s), True{}), $SHR(root, $SETC(nl, ST.rid(s), True{})), $SRM(root, nl, ST.rid(s), True{})) : $FP($DFIX(gf, (_, M.DF{p, P.top(c1), True{}})))
  kont(root, $SETC(nl, ST.rid(s), True{}), c1, $TN(p, t, s), $RSC($TN(p, t, s), P.top(c1), nl, ST.rid(s), True{}, FX.up_t(~K, nl, p, s, t, P.top(c1), i1, hk)), $CSC(c1, p, nl, ST.rid(s), True{}, $COKT(p, True{}, s, ST.rid(t), c1, nl, i2)), L.subst($LN, z => $NDL(z), $WH($CL, t), $WH(c1, $TN(p, t, s)), Equal.sym($LN, $WH(c1, $TN(p, t, s)), $WH($CL, t), P.ids_l(c1, p, t, s)), i3), Equal.trans($LN, $WH(c1, $TN(p, t, s)), $WH($CL, t), i0, P.ids_l(c1, p, t, s), i4), i5, $EALL(nl, ST.rid(s), True{}, h4, h5, h6, h7))

# the far nephew red: three recolourings and a rotation at the parent end it
%def BS $TN(p, t, $TN(w, sa, sb))
%def BS2 $TN(w, $TN(p, t, sa), sb)
%def BH +hr: $REPN($BS, P.top(c1), nl), +hok: $COKN(c1, p, nl), +hnd: $NDL($WH(c1, $BS)), +hroot: {root == ST.rid(PG.plug(c1, $BS)) : Nat}, +hids: {$WH(c1, $BS) == i0 : $LN}
%def N1 $SETC(nl, w, M.node_red(~K, ST.nd(K, nl, p)))
%def N2 $SETC($N1, p, False{})
%def N3 $SETC($N2, ST.rid(sb), False{})
%def RL3 $ROTL($N3, p, w, ST.rid(sa), P.top(c1), SP.dir(c1))
%def RQL RM.rootq(P.top(c1), root, w)

def dborrow_l($TO, $FX, +gf: Nat, +root: Nat, +nl: $NL, +c1: $CT, +p: Nat, +t: ST.Tr, +w: Nat, +sa: ST.Tr, +sb: ST.Tr, $BH, $IVH(nl)) -> $FP($DFIX(gf, MI.delete_borrow_left($AK, $SHR(root, nl), p, w, ST.nd(K, nl, p), ST.nd(K, nl, w)))):
  +hw = TR.rep_node(~K, w, sa, sb, p, nl, TR.rep_r(~K, p, t, $TN(w, sa, sb), P.top(c1), nl, hr))
  %Equal.sym(Nat, M.node_right(~K, ST.nd(K, nl, w)), ST.rid(sb), NB.child_eq(~K, ST.nd(K, nl, w), ST.rid(sa), ST.rid(sb), p, True{}, hw)) : $FP($DFIX(gf, (MI.rotate_left($AK, MI.set_red($AK, MI.set_red($AK, MI.set_red($AK, $SHR(root, nl), w, M.node_red(~K, ST.nd(K, nl, p))), p, False{}), _, False{}), p), M.DF{0n, 0n, False{}})))
  %Equal.sym($SHT, MI.set_red($AK, $SHR(root, nl), w, M.node_red(~K, ST.nd(K, nl, p))), $SHR(root, $N1), $SRM(root, nl, w, M.node_red(~K, ST.nd(K, nl, p)))) : $FP($DFIX(gf, (MI.rotate_left($AK, MI.set_red($AK, MI.set_red($AK, _, p, False{}), ST.rid(sb), False{}), p), M.DF{0n, 0n, False{}})))
  %Equal.sym($SHT, MI.set_red($AK, $SHR(root, $N1), p, False{}), $SHR(root, $N2), $SRM(root, $N1, p, False{})) : $FP($DFIX(gf, (MI.rotate_left($AK, MI.set_red($AK, _, ST.rid(sb), False{}), p), M.DF{0n, 0n, False{}})))
  %Equal.sym($SHT, MI.set_red($AK, $SHR(root, $N2), ST.rid(sb), False{}), $SHR(root, $N3), $SRM(root, $N2, ST.rid(sb), False{})) : $FP($DFIX(gf, (MI.rotate_left($AK, _, p), M.DF{0n, 0n, False{}})))
  +hr3 = $RSC($BS, P.top(c1), $N2, ST.rid(sb), False{}, $RSC($BS, P.top(c1), $N1, p, False{}, $RSC($BS, P.top(c1), nl, w, M.node_red(~K, ST.nd(K, nl, p)), hr)))
  +hok3 = $CSC(c1, p, $N2, ST.rid(sb), False{}, $CSC(c1, p, $N1, p, False{}, $CSC(c1, p, nl, w, M.node_red(~K, ST.nd(K, nl, p)), hok)))
  %Equal.sym($SHT, MI.rotate_left($AK, $SHR(root, $N3), p), $SHR($RQL, $RL3), RP.rotl_path_eq($AO, n, root, lo, hi, free, l, d, $N3, pl, tg, fl, c1, p, t, w, sa, sb, hr3, hok3, hnd)) : $FP($DFIX(gf, (_, M.DF{0n, 0n, False{}})))
  +hrr = PG.rep_plug(~K, $RL3, c1, $BS2, RP.rotl_path_rep($AO3, $N3, c1, p, t, w, sa, sb, hr3, hok3, hnd), RP.rotl_path_ctx($AO3, $N3, c1, p, t, w, sa, sb, hr3, hok3, hnd))
  +hq = RP.root_rot(~K, $N3, c1, p, w, $BS, $BS2, root, {==}, {==}, hok3, hroot)
  +ho = Equal.trans($LN, $IDS(PG.plug(c1, $BS2)), $WH(c1, $BS2), i0, PG.ids_plug(c1, $BS2), Equal.trans($LN, $WH(c1, $BS2), $WH(c1, $BS), i0, RP.wh_eq(c1, $BS2, $BS, RP.ids_rl(p, t, w, sa, sb)), hids))
  +g4 = $E4($N2, ST.rid(sb), False{}, $E4($N1, p, False{}, $E4(nl, w, M.node_red(~K, ST.nd(K, nl, p)), h4)))
  +g5 = $E5($N2, ST.rid(sb), False{}, $E5($N1, p, False{}, $E5(nl, w, M.node_red(~K, ST.nd(K, nl, p)), h5)))
  +g6 = $E6($N2, ST.rid(sb), False{}, $E6($N1, p, False{}, $E6(nl, w, M.node_red(~K, ST.nd(K, nl, p)), h6)))
  +g7 = $E7($N2, ST.rid(sb), False{}, $E7($N1, p, False{}, $E7(nl, w, M.node_red(~K, ST.nd(K, nl, p)), h7)))
  dstop($AO, $FXA, gf, $RQL, $RL3, PG.plug(c1, $BS2), hrr, hq, ho, $LALL($N3, p, w, ST.rid(sa), P.top(c1), SP.dir(c1), g4, g5, g6, g7))

# only the near nephew red: it goes black, the sibling red, a rotation at
# the sibling makes the nephew the sibling, whose far child is now red
%def SW $TN(w, $TN(y, ya, yb), sb)
%def SW2 $TN(y, ya, $TN(w, yb, sb))
%def FS $TN(p, t, $SW)
%def FS2 $TN(p, t, $SW2)
%def CW Con{P.FR{p, False{}, t}, c1}
%def FH +hr: $REPN($FS, P.top(c1), nl), +hok: $COKN(c1, p, nl), +hnd: $NDL($WH(c1, $FS)), +hroot: {root == ST.rid(PG.plug(c1, $FS)) : Nat}, +hids: {$WH(c1, $FS) == i0 : $LN}
%def M1 $SETC(nl, y, False{})
%def M2 $SETC($M1, w, True{})
%def RRW $ROTR($M2, w, y, ST.rid(yb), p, SP.dir($CW))
%def RQW RM.rootq(p, root, y)

def dfar_l($TO, $FX, +gf: Nat, +root: Nat, +nl: $NL, +c1: $CT, +p: Nat, +t: ST.Tr, +w: Nat, +y: Nat, +ya: ST.Tr, +yb: ST.Tr, +sb: ST.Tr, $FH, $IVH(nl)) -> $FP($DFIX(gf, MI.delete_far_left($AK, $SHR(root, nl), p, w, ST.nd(K, nl, p), ST.nd(K, nl, w), False{}))):
  +hsw = TR.rep_r(~K, p, t, $SW, P.top(c1), nl, hr)
  +hw = TR.rep_node(~K, w, $TN(y, ya, yb), sb, p, nl, hsw)
  %Equal.sym(Nat, M.node_left(~K, ST.nd(K, nl, w)), y, NB.child_eq(~K, ST.nd(K, nl, w), y, ST.rid(sb), p, False{}, hw)) : $FP($DFIX(gf, MI.delete_borrow_read_left($AK, MI.rotate_right($AK, MI.set_red($AK, MI.set_red($AK, $SHR(root, nl), _, False{}), w, True{}), w), p)))
  %Equal.sym($SHT, MI.set_red($AK, $SHR(root, nl), y, False{}), $SHR(root, $M1), $SRM(root, nl, y, False{})) : $FP($DFIX(gf, MI.delete_borrow_read_left($AK, MI.rotate_right($AK, MI.set_red($AK, _, w, True{}), w), p)))
  %Equal.sym($SHT, MI.set_red($AK, $SHR(root, $M1), w, True{}), $SHR(root, $M2), $SRM(root, $M1, w, True{})) : $FP($DFIX(gf, MI.delete_borrow_read_left($AK, MI.rotate_right($AK, _, w), p)))
  okr = P.ok_r(~K, nl, c1, p, t, $SW, hr, hok)
  +hrw = $RSC($SW, p, $M1, w, True{}, $RSC($SW, p, nl, y, False{}, hsw))
  +hcw = $CSC($CW, w, $M1, w, True{}, $CSC($CW, w, nl, y, False{}, Pair.fst($COKN($CW, w, nl), $REPN($SW, p, nl), okr)))
  +ew = P.ids_r(c1, p, t, $SW)
  +hndw = L.subst($LN, z => $NDL(z), $WH(c1, $FS), $WH($CW, $SW), ew, hnd)
  %Equal.sym($SHT, MI.rotate_right($AK, $SHR(root, $M2), w), $SHR($RQW, $RRW), RP.rotr_path_eq($AO, n, root, lo, hi, free, l, d, $M2, pl, tg, fl, $CW, w, ya, y, yb, sb, hrw, hcw, hndw)) : $FP($DFIX(gf, MI.delete_borrow_read_left($AK, _, p)))
  +hr2 = RP.rotr_path_rep($AO3, $M2, $CW, w, ya, y, yb, sb, hrw, hcw, hndw)
  +hc2 = RP.rotr_path_ctx($AO3, $M2, $CW, w, ya, y, yb, sb, hrw, hcw, hndw)
  +hk2 = $COK1(p, False{}, t, y, c1, $RRW, hc2)
  %Equal.sym(Nat, M.node_right(~K, ST.nd(K, $RRW, p)), y, NB.child_eq(~K, ST.nd(K, $RRW, p), ST.rid(t), y, P.top(c1), True{}, $CISN(p, False{}, t, y, P.top(c1), $RRW, hk2))) : $FP($DFIX(gf, MI.delete_borrow_left($AK, $SHR($RQW, $RRW), p, _, ST.nd(K, $RRW, p), ST.nd(K, $RRW, _))))
  +eW = Equal.trans($LN, $WH(c1, $FS2), $WH($CW, $SW2), $WH(c1, $FS), P.ids_r(c1, p, t, $SW2), Equal.trans($LN, $WH($CW, $SW2), $WH($CW, $SW), $WH(c1, $FS), RP.wh_eq($CW, $SW2, $SW, RP.ids_rr(w, y, ya, yb, sb)), Equal.sym($LN, $WH(c1, $FS), $WH($CW, $SW), ew)))
  +hq = RP.root_rot(~K, $M2, $CW, w, y, $SW, $SW2, root, {==}, {==}, hcw, hroot)
  dborrow_l($AO, $FXA, gf, $RQW, $RRW, c1, p, t, y, ya, $TN(w, yb, sb), FX.up_f(~K, $RRW, p, t, $SW2, P.top(c1), hr2, hk2), $COKT(p, False{}, t, y, c1, $RRW, hc2), L.subst($LN, z => $NDL(z), $WH(c1, $FS), $WH(c1, $FS2), Equal.sym($LN, $WH(c1, $FS2), $WH(c1, $FS), eW), hnd), hq, Equal.trans($LN, $WH(c1, $FS2), $WH(c1, $FS), i0, eW, hids), $RALL($M2, w, y, ST.rid(yb), p, SP.dir($CW), $E4($M1, w, True{}, $E4(nl, y, False{}, h4)), $E5($M1, w, True{}, $E5(nl, y, False{}, h5)), $E6($M1, w, True{}, $E6(nl, y, False{}, h6)), $E7($M1, w, True{}, $E7(nl, y, False{}, h7))))

# a red near nephew is a node
%def SWG $TN(w, sa, sb)
def dfar0_l($TO, $FX, +gf: Nat, +root: Nat, +nl: $NL, +c1: $CT, +p: Nat, +t: ST.Tr, +w: Nat, +sa: ST.Tr, +sb: ST.Tr, +hnr: {M.node_red(~K, ST.nd(K, nl, ST.rid(sa))) == True{} : Bool}, $BH, $IVH(nl)) -> $FP($DFIX(gf, MI.delete_far_left($AK, $SHR(root, nl), p, w, ST.nd(K, nl, p), ST.nd(K, nl, w), False{}))):
  match sa:
    case ST.TE{}:
      Empty.absurd($FP($DFIX(gf, MI.delete_far_left($AK, $SHR(root, nl), p, w, ST.nd(K, nl, p), ST.nd(K, nl, w), False{}))), L.false_true(hnr))
    case ST.TN{+y, +ya, +yb}:
      dfar_l($AO, $FXA, gf, root, nl, c1, p, t, w, y, ya, yb, sb, hr, hok, hnd, hroot, hids, $HA)

%def CLW Con{P.FR{p, True{}, $SWG}, c1}
%def KH +nr: Bool, +hnr: {M.node_red(~K, ST.nd(K, nl, ST.rid(sa))) == nr : Bool}, +fr: Bool, +hfr: {M.node_red(~K, ST.nd(K, nl, ST.rid(sb))) == fr : Bool}

# the nephews' colours
def dkids_l($TO, $FX, +gf: Nat, +root: Nat, +nl: $NL, +c1: $CT, +p: Nat, +w: Nat, +sa: ST.Tr, +sb: ST.Tr, +t: ST.Tr, $DIH($CLW, t), $IVH(nl), kont: $DKONT(gf), $KH) -> $FP($DFIX(gf, MI.delete_children_left($AK, $SHR(root, nl), p, w, ST.nd(K, nl, p), ST.nd(K, nl, w), nr, fr))):
  match nr fr:
    case False{} False{}:
      dup_l($AO, $FXA, gf, root, nl, c1, p, $SWG, t, $DIA, $HA, kont)
    case True{} True{}:
      dborrow_l($AO, $FXA, gf, root, nl, c1, p, t, w, sa, sb, FX.up_t(~K, nl, p, $SWG, t, P.top(c1), i1, $COK1(p, True{}, $SWG, ST.rid(t), c1, nl, i2)), $COKT(p, True{}, $SWG, ST.rid(t), c1, nl, i2), L.subst($LN, z => $NDL(z), $WH($CLW, t), $WH(c1, $BS), Equal.sym($LN, $WH(c1, $BS), $WH($CLW, t), P.ids_l(c1, p, t, $SWG)), i3), i5, Equal.trans($LN, $WH(c1, $BS), $WH($CLW, t), i0, P.ids_l(c1, p, t, $SWG), i4), $HA)
    case False{} True{}:
      dborrow_l($AO, $FXA, gf, root, nl, c1, p, t, w, sa, sb, FX.up_t(~K, nl, p, $SWG, t, P.top(c1), i1, $COK1(p, True{}, $SWG, ST.rid(t), c1, nl, i2)), $COKT(p, True{}, $SWG, ST.rid(t), c1, nl, i2), L.subst($LN, z => $NDL(z), $WH($CLW, t), $WH(c1, $BS), Equal.sym($LN, $WH(c1, $BS), $WH($CLW, t), P.ids_l(c1, p, t, $SWG)), i3), i5, Equal.trans($LN, $WH(c1, $BS), $WH($CLW, t), i0, P.ids_l(c1, p, t, $SWG), i4), $HA)
    case True{} False{}:
      dfar0_l($AO, $FXA, gf, root, nl, c1, p, t, w, sa, sb, hnr, FX.up_t(~K, nl, p, $SWG, t, P.top(c1), i1, $COK1(p, True{}, $SWG, ST.rid(t), c1, nl, i2)), $COKT(p, True{}, $SWG, ST.rid(t), c1, nl, i2), L.subst($LN, z => $NDL(z), $WH($CLW, t), $WH(c1, $BS), Equal.sym($LN, $WH(c1, $BS), $WH($CLW, t), P.ids_l(c1, p, t, $SWG)), i3), i5, Equal.trans($LN, $WH(c1, $BS), $WH($CLW, t), i0, P.ids_l(c1, p, t, $SWG), i4), $HA)

%def KIDS(sw) MI.delete_children_left($AK, $SHR(root, nl), p, ST.rid(sw), ST.nd(K, nl, p), ST.nd(K, nl, ST.rid(sw)), M.node_red(~K, ST.nd(K, nl, M.node_left(~K, ST.nd(K, nl, ST.rid(sw))))), M.node_red(~K, ST.nd(K, nl, M.node_right(~K, ST.nd(K, nl, ST.rid(sw))))))

# the sibling's children
def dsib2_l($TO, $FX, +gf: Nat, +root: Nat, +nl: $NL, +c1: $CT, +p: Nat, +s: ST.Tr, +t: ST.Tr, $DIH($CL, t), $IVH(nl), kont: $DKONT(gf)) -> $FP($DFIX(gf, $KIDS(s))):
  match s:
    case ST.TE{}:
      dup_l($AO, $FXA, gf, root, nl, c1, p, ST.TE{}, t, $DIA, $HA, kont)
    case ST.TN{+w, +sa, +sb}:
      +hw = TR.rep_node(~K, w, sa, sb, p, nl, $CSRP(p, True{}, $SWG, ST.rid(t), P.top(c1), nl, $COK1(p, True{}, $SWG, ST.rid(t), c1, nl, i2)))
      %Equal.sym(Nat, M.node_left(~K, ST.nd(K, nl, w)), ST.rid(sa), NB.child_eq(~K, ST.nd(K, nl, w), ST.rid(sa), ST.rid(sb), p, False{}, hw)) : $FP($DFIX(gf, MI.delete_children_left($AK, $SHR(root, nl), p, w, ST.nd(K, nl, p), ST.nd(K, nl, w), M.node_red(~K, ST.nd(K, nl, _)), M.node_red(~K, ST.nd(K, nl, M.node_right(~K, ST.nd(K, nl, w)))))))
      %Equal.sym(Nat, M.node_right(~K, ST.nd(K, nl, w)), ST.rid(sb), NB.child_eq(~K, ST.nd(K, nl, w), ST.rid(sa), ST.rid(sb), p, True{}, hw)) : $FP($DFIX(gf, MI.delete_children_left($AK, $SHR(root, nl), p, w, ST.nd(K, nl, p), ST.nd(K, nl, w), M.node_red(~K, ST.nd(K, nl, ST.rid(sa))), M.node_red(~K, ST.nd(K, nl, _)))))
      dkids_l($AO, $FXA, gf, root, nl, c1, p, w, sa, sb, t, $DIA, $HA, kont, M.node_red(~K, ST.nd(K, nl, ST.rid(sa))), {==}, M.node_red(~K, ST.nd(K, nl, ST.rid(sb))), {==})

# reading the parent and the sibling
def dsib_l($TO, $FX, +gf: Nat, +root: Nat, +nl: $NL, +c1: $CT, +p: Nat, +s: ST.Tr, +t: ST.Tr, $DIH($CL, t), $IVH(nl), kont: $DKONT(gf)) -> $FP($DFIX(gf, MI.delete_sibling_left($AK, $SHR(root, nl), p))):
  +hk = $COK1(p, True{}, s, ST.rid(t), c1, nl, i2)
  %Equal.sym(Nat, M.node_right(~K, ST.nd(K, nl, p)), ST.rid(s), NB.child_eq(~K, ST.nd(K, nl, p), ST.rid(t), ST.rid(s), P.top(c1), True{}, $CISN(p, True{}, s, ST.rid(t), P.top(c1), nl, hk))) : $FP($DFIX(gf, MI.delete_children_left($AK, $SHR(root, nl), p, _, ST.nd(K, nl, p), ST.nd(K, nl, _), M.node_red(~K, ST.nd(K, nl, M.node_left(~K, ST.nd(K, nl, _)))), M.node_red(~K, ST.nd(K, nl, M.node_right(~K, ST.nd(K, nl, _)))))))
  dsib2_l($AO, $FXA, gf, root, nl, c1, p, s, t, $DIA, $HA, kont)

# a red sibling: it goes black, the parent red, a rotation at the parent
# gives x the sibling's near child as its new sibling
%def P1 $SETC(nl, w, False{})
%def P2 $SETC($P1, p, True{})
%def RLP $ROTL($P2, p, w, ST.rid(sa), P.top(c1), SP.dir(c1))
%def C1W Con{P.FR{w, True{}, sb}, c1}
%def CLA Con{P.FR{p, True{}, sa}, $C1W}
%def OL1 P.ok_l(~K, $RLP, c1, w, $TN(p, t, sa), sb, RP.rotl_path_rep($AO3, $P2, c1, p, t, w, sa, sb, hr2, hok2, hnd), RP.rotl_path_ctx($AO3, $P2, c1, p, t, w, sa, sb, hr2, hok2, hnd))
%def OL1T {P.ctxok(~K, $C1W, p, $RLP) == True{} : Bool} & $REPN($TN(p, t, sa), w, $RLP)
%def OL2 P.ok_l(~K, $RLP, $C1W, p, t, sa, Pair.snd({P.ctxok(~K, $C1W, p, $RLP) == True{} : Bool}, $REPN($TN(p, t, sa), w, $RLP), $OL1), Pair.fst({P.ctxok(~K, $C1W, p, $RLP) == True{} : Bool}, $REPN($TN(p, t, sa), w, $RLP), $OL1))
%def OL2A {P.ctxok(~K, $CLA, ST.rid(t), $RLP) == True{} : Bool}
%def OL2B $REPN(t, p, $RLP)

def dred_l($TO, $FX, +gf: Nat, +root: Nat, +nl: $NL, +c1: $CT, +p: Nat, +s: ST.Tr, +t: ST.Tr, $DIH($CL, t), $IVH(nl), kont: $DKONT(gf), +b: Bool, +hb: {M.node_red(~K, ST.nd(K, nl, ST.rid(s))) == b : Bool}) -> $FP($DFIX(gf, MI.delete_red_sibling_left($AK, $SHR(root, nl), p, ST.rid(s), b))):
  match s b:
    case ST.TE{} False{}:
      dsib_l($AO, $FXA, gf, root, nl, c1, p, ST.TE{}, t, $DIA, $HA, kont)
    case ST.TE{} True{}:
      Empty.absurd($FP($DFIX(gf, MI.delete_red_sibling_left($AK, $SHR(root, nl), p, 0n, True{}))), L.false_true(hb))
    case ST.TN{+w, +sa, +sb} False{}:
      dsib_l($AO, $FXA, gf, root, nl, c1, p, $SWG, t, $DIA, $HA, kont)
    case ST.TN{+w, +sa, +sb} True{}:
      %Equal.sym($SHT, MI.set_red($AK, $SHR(root, nl), w, False{}), $SHR(root, $P1), $SRM(root, nl, w, False{})) : $FP($DFIX(gf, MI.delete_sibling_left($AK, MI.rotate_left($AK, MI.set_red($AK, _, p, True{}), p), p)))
      %Equal.sym($SHT, MI.set_red($AK, $SHR(root, $P1), p, True{}), $SHR(root, $P2), $SRM(root, $P1, p, True{})) : $FP($DFIX(gf, MI.delete_sibling_left($AK, MI.rotate_left($AK, _, p), p)))
      +hr2 = $RSC($BS, P.top(c1), $P1, p, True{}, $RSC($BS, P.top(c1), nl, w, False{}, FX.up_t(~K, nl, p, $SWG, t, P.top(c1), i1, $COK1(p, True{}, $SWG, ST.rid(t), c1, nl, i2))))
      +hok2 = $CSC(c1, p, $P1, p, True{}, $CSC(c1, p, nl, w, False{}, $COKT(p, True{}, $SWG, ST.rid(t), c1, nl, i2)))
      +hnd = L.subst($LN, z => $NDL(z), $WH($CLW, t), $WH(c1, $BS), Equal.sym($LN, $WH(c1, $BS), $WH($CLW, t), P.ids_l(c1, p, t, $SWG)), i3)
      %Equal.sym($SHT, MI.rotate_left($AK, $SHR(root, $P2), p), $SHR($RQL, $RLP), RP.rotl_path_eq($AO, n, root, lo, hi, free, l, d, $P2, pl, tg, fl, c1, p, t, w, sa, sb, hr2, hok2, hnd)) : $FP($DFIX(gf, MI.delete_sibling_left($AK, _, p)))
      +eW = Equal.trans($LN, $WH($CLA, t), $WH($C1W, $TN(p, t, sa)), $WH($CLW, t), Equal.sym($LN, $WH($C1W, $TN(p, t, sa)), $WH($CLA, t), P.ids_l($C1W, p, t, sa)), Equal.trans($LN, $WH($C1W, $TN(p, t, sa)), $WH(c1, $BS2), $WH($CLW, t), Equal.sym($LN, $WH(c1, $BS2), $WH($C1W, $TN(p, t, sa)), P.ids_l(c1, w, $TN(p, t, sa), sb)), Equal.trans($LN, $WH(c1, $BS2), $WH(c1, $BS), $WH($CLW, t), RP.wh_eq(c1, $BS2, $BS, RP.ids_rl(p, t, w, sa, sb)), P.ids_l(c1, p, t, $SWG))))
      dsib_l($AO, $FXA, gf, $RQL, $RLP, $C1W, p, sa, t, Pair.snd($OL2A, $OL2B, $OL2), Pair.fst($OL2A, $OL2B, $OL2), L.subst($LN, z => $NDL(z), $WH($CLW, t), $WH($CLA, t), Equal.sym($LN, $WH($CLA, t), $WH($CLW, t), eW), i3), Equal.trans($LN, $WH($CLA, t), $WH($CLW, t), i0, eW, i4), RP.root_rot(~K, $P2, c1, p, w, $BS, $BS2, root, {==}, {==}, hok2, i5), $LALL($P2, p, w, ST.rid(sa), P.top(c1), SP.dir(c1), $E4($P1, p, True{}, $E4(nl, w, False{}, h4)), $E5($P1, p, True{}, $E5(nl, w, False{}, h5)), $E6($P1, p, True{}, $E6(nl, w, False{}, h6)), $E7($P1, p, True{}, $E7(nl, w, False{}, h7))), kont)

# x on the left: read the sibling
def dside_l($TO, $FX, +gf: Nat, +root: Nat, +nl: $NL, +c1: $CT, +p: Nat, +s: ST.Tr, +t: ST.Tr, $DIH($CL, t), $IVH(nl), kont: $DKONT(gf)) -> $FP($DFIX(gf, MI.delete_side_left($AK, $SHR(root, nl), p, ST.nd(K, nl, p)))):
  +hk = $COK1(p, True{}, s, ST.rid(t), c1, nl, i2)
  %Equal.sym(Nat, M.node_right(~K, ST.nd(K, nl, p)), ST.rid(s), NB.child_eq(~K, ST.nd(K, nl, p), ST.rid(t), ST.rid(s), P.top(c1), True{}, $CISN(p, True{}, s, ST.rid(t), P.top(c1), nl, hk))) : $FP($DFIX(gf, MI.delete_red_sibling_left($AK, $SHR(root, nl), p, _, M.node_red(~K, ST.nd(K, nl, _)))))
  dred_l($AO, $FXA, gf, root, nl, c1, p, s, t, $DIA, $HA, kont, M.node_red(~K, ST.nd(K, nl, ST.rid(s))), {==})

# ---- the right side: x under p on the right, its sibling s on the left ----

def dup_r($TO, $FX, +gf: Nat, +root: Nat, +nl: $NL, +c1: $CT, +p: Nat, +s: ST.Tr, +t: ST.Tr, $DIH($CR, t), $IVH(nl), kont: $DKONT(gf)) -> $FP($DFIX(gf, (MI.set_red($AK, $SHR(root, nl), ST.rid(s), True{}), M.DF{p, M.node_parent(~K, ST.nd(K, nl, p)), True{}}))):
  +hk = $COK1(p, False{}, s, ST.rid(t), c1, nl, i2)
  %Equal.sym(Nat, M.node_parent(~K, ST.nd(K, nl, p)), P.top(c1), NB.parent_eq(~K, ST.nd(K, nl, p), ST.rid(s), ST.rid(t), P.top(c1), $CISN(p, False{}, s, ST.rid(t), P.top(c1), nl, hk))) : $FP($DFIX(gf, (MI.set_red($AK, $SHR(root, nl), ST.rid(s), True{}), M.DF{p, _, True{}})))
  %Equal.sym($SHT, MI.set_red($AK, $SHR(root, nl), ST.rid(s), True{}), $SHR(root, $SETC(nl, ST.rid(s), True{})), $SRM(root, nl, ST.rid(s), True{})) : $FP($DFIX(gf, (_, M.DF{p, P.top(c1), True{}})))
  kont(root, $SETC(nl, ST.rid(s), True{}), c1, $TN(p, s, t), $RSC($TN(p, s, t), P.top(c1), nl, ST.rid(s), True{}, FX.up_f(~K, nl, p, s, t, P.top(c1), i1, hk)), $CSC(c1, p, nl, ST.rid(s), True{}, $COKT(p, False{}, s, ST.rid(t), c1, nl, i2)), L.subst($LN, z => $NDL(z), $WH($CR, t), $WH(c1, $TN(p, s, t)), Equal.sym($LN, $WH(c1, $TN(p, s, t)), $WH($CR, t), P.ids_r(c1, p, s, t)), i3), Equal.trans($LN, $WH(c1, $TN(p, s, t)), $WH($CR, t), i0, P.ids_r(c1, p, s, t), i4), i5, $EALL(nl, ST.rid(s), True{}, h4, h5, h6, h7))

%def BSR $TN(p, $TN(w, sa, sb), t)
%def BSR2 $TN(w, sa, $TN(p, sb, t))
%def BHR +hr: $REPN($BSR, P.top(c1), nl), +hok: $COKN(c1, p, nl), +hnd: $NDL($WH(c1, $BSR)), +hroot: {root == ST.rid(PG.plug(c1, $BSR)) : Nat}, +hids: {$WH(c1, $BSR) == i0 : $LN}
%def N3R $SETC($N2, ST.rid(sa), False{})
%def RR3 $ROTR($N3R, p, w, ST.rid(sb), P.top(c1), SP.dir(c1))

def dborrow_r($TO, $FX, +gf: Nat, +root: Nat, +nl: $NL, +c1: $CT, +p: Nat, +t: ST.Tr, +w: Nat, +sa: ST.Tr, +sb: ST.Tr, $BHR, $IVH(nl)) -> $FP($DFIX(gf, MI.delete_borrow_right($AK, $SHR(root, nl), p, w, ST.nd(K, nl, p), ST.nd(K, nl, w)))):
  +hw = TR.rep_node(~K, w, sa, sb, p, nl, TR.rep_l(~K, p, $TN(w, sa, sb), t, P.top(c1), nl, hr))
  %Equal.sym(Nat, M.node_left(~K, ST.nd(K, nl, w)), ST.rid(sa), NB.child_eq(~K, ST.nd(K, nl, w), ST.rid(sa), ST.rid(sb), p, False{}, hw)) : $FP($DFIX(gf, (MI.rotate_right($AK, MI.set_red($AK, MI.set_red($AK, MI.set_red($AK, $SHR(root, nl), w, M.node_red(~K, ST.nd(K, nl, p))), p, False{}), _, False{}), p), M.DF{0n, 0n, False{}})))
  %Equal.sym($SHT, MI.set_red($AK, $SHR(root, nl), w, M.node_red(~K, ST.nd(K, nl, p))), $SHR(root, $N1), $SRM(root, nl, w, M.node_red(~K, ST.nd(K, nl, p)))) : $FP($DFIX(gf, (MI.rotate_right($AK, MI.set_red($AK, MI.set_red($AK, _, p, False{}), ST.rid(sa), False{}), p), M.DF{0n, 0n, False{}})))
  %Equal.sym($SHT, MI.set_red($AK, $SHR(root, $N1), p, False{}), $SHR(root, $N2), $SRM(root, $N1, p, False{})) : $FP($DFIX(gf, (MI.rotate_right($AK, MI.set_red($AK, _, ST.rid(sa), False{}), p), M.DF{0n, 0n, False{}})))
  %Equal.sym($SHT, MI.set_red($AK, $SHR(root, $N2), ST.rid(sa), False{}), $SHR(root, $N3R), $SRM(root, $N2, ST.rid(sa), False{})) : $FP($DFIX(gf, (MI.rotate_right($AK, _, p), M.DF{0n, 0n, False{}})))
  +hr3 = $RSC($BSR, P.top(c1), $N2, ST.rid(sa), False{}, $RSC($BSR, P.top(c1), $N1, p, False{}, $RSC($BSR, P.top(c1), nl, w, M.node_red(~K, ST.nd(K, nl, p)), hr)))
  +hok3 = $CSC(c1, p, $N2, ST.rid(sa), False{}, $CSC(c1, p, $N1, p, False{}, $CSC(c1, p, nl, w, M.node_red(~K, ST.nd(K, nl, p)), hok)))
  %Equal.sym($SHT, MI.rotate_right($AK, $SHR(root, $N3R), p), $SHR($RQL, $RR3), RP.rotr_path_eq($AO, n, root, lo, hi, free, l, d, $N3R, pl, tg, fl, c1, p, sa, w, sb, t, hr3, hok3, hnd)) : $FP($DFIX(gf, (_, M.DF{0n, 0n, False{}})))
  +hrr = PG.rep_plug(~K, $RR3, c1, $BSR2, RP.rotr_path_rep($AO3, $N3R, c1, p, sa, w, sb, t, hr3, hok3, hnd), RP.rotr_path_ctx($AO3, $N3R, c1, p, sa, w, sb, t, hr3, hok3, hnd))
  +hq = RP.root_rot(~K, $N3R, c1, p, w, $BSR, $BSR2, root, {==}, {==}, hok3, hroot)
  +ho = Equal.trans($LN, $IDS(PG.plug(c1, $BSR2)), $WH(c1, $BSR2), i0, PG.ids_plug(c1, $BSR2), Equal.trans($LN, $WH(c1, $BSR2), $WH(c1, $BSR), i0, RP.wh_eq(c1, $BSR2, $BSR, RP.ids_rr(p, w, sa, sb, t)), hids))
  +g4 = $E4($N2, ST.rid(sa), False{}, $E4($N1, p, False{}, $E4(nl, w, M.node_red(~K, ST.nd(K, nl, p)), h4)))
  +g5 = $E5($N2, ST.rid(sa), False{}, $E5($N1, p, False{}, $E5(nl, w, M.node_red(~K, ST.nd(K, nl, p)), h5)))
  +g6 = $E6($N2, ST.rid(sa), False{}, $E6($N1, p, False{}, $E6(nl, w, M.node_red(~K, ST.nd(K, nl, p)), h6)))
  +g7 = $E7($N2, ST.rid(sa), False{}, $E7($N1, p, False{}, $E7(nl, w, M.node_red(~K, ST.nd(K, nl, p)), h7)))
  dstop($AO, $FXA, gf, $RQL, $RR3, PG.plug(c1, $BSR2), hrr, hq, ho, $RALL($N3R, p, w, ST.rid(sb), P.top(c1), SP.dir(c1), g4, g5, g6, g7))

%def SWR $TN(w, sa, $TN(y, ya, yb))
%def SWR2 $TN(y, $TN(w, sa, ya), yb)
%def FSR $TN(p, $SWR, t)
%def FSR2 $TN(p, $SWR2, t)
%def CWL Con{P.FR{p, True{}, t}, c1}
%def FHR +hr: $REPN($FSR, P.top(c1), nl), +hok: $COKN(c1, p, nl), +hnd: $NDL($WH(c1, $FSR)), +hroot: {root == ST.rid(PG.plug(c1, $FSR)) : Nat}, +hids: {$WH(c1, $FSR) == i0 : $LN}
%def RLW $ROTL($M2, w, y, ST.rid(ya), p, SP.dir($CWL))

def dfar_r($TO, $FX, +gf: Nat, +root: Nat, +nl: $NL, +c1: $CT, +p: Nat, +t: ST.Tr, +w: Nat, +sa: ST.Tr, +y: Nat, +ya: ST.Tr, +yb: ST.Tr, $FHR, $IVH(nl)) -> $FP($DFIX(gf, MI.delete_far_right($AK, $SHR(root, nl), p, w, ST.nd(K, nl, p), ST.nd(K, nl, w), False{}))):
  +hsw = TR.rep_l(~K, p, $SWR, t, P.top(c1), nl, hr)
  +hw = TR.rep_node(~K, w, sa, $TN(y, ya, yb), p, nl, hsw)
  %Equal.sym(Nat, M.node_right(~K, ST.nd(K, nl, w)), y, NB.child_eq(~K, ST.nd(K, nl, w), ST.rid(sa), y, p, True{}, hw)) : $FP($DFIX(gf, MI.delete_borrow_read_right($AK, MI.rotate_left($AK, MI.set_red($AK, MI.set_red($AK, $SHR(root, nl), _, False{}), w, True{}), w), p)))
  %Equal.sym($SHT, MI.set_red($AK, $SHR(root, nl), y, False{}), $SHR(root, $M1), $SRM(root, nl, y, False{})) : $FP($DFIX(gf, MI.delete_borrow_read_right($AK, MI.rotate_left($AK, MI.set_red($AK, _, w, True{}), w), p)))
  %Equal.sym($SHT, MI.set_red($AK, $SHR(root, $M1), w, True{}), $SHR(root, $M2), $SRM(root, $M1, w, True{})) : $FP($DFIX(gf, MI.delete_borrow_read_right($AK, MI.rotate_left($AK, _, w), p)))
  okl = P.ok_l(~K, nl, c1, p, $SWR, t, hr, hok)
  +hrw = $RSC($SWR, p, $M1, w, True{}, $RSC($SWR, p, nl, y, False{}, hsw))
  +hcw = $CSC($CWL, w, $M1, w, True{}, $CSC($CWL, w, nl, y, False{}, Pair.fst($COKN($CWL, w, nl), $REPN($SWR, p, nl), okl)))
  +ew = P.ids_l(c1, p, $SWR, t)
  +hndw = L.subst($LN, z => $NDL(z), $WH(c1, $FSR), $WH($CWL, $SWR), ew, hnd)
  %Equal.sym($SHT, MI.rotate_left($AK, $SHR(root, $M2), w), $SHR($RQW, $RLW), RP.rotl_path_eq($AO, n, root, lo, hi, free, l, d, $M2, pl, tg, fl, $CWL, w, sa, y, ya, yb, hrw, hcw, hndw)) : $FP($DFIX(gf, MI.delete_borrow_read_right($AK, _, p)))
  +hr2 = RP.rotl_path_rep($AO3, $M2, $CWL, w, sa, y, ya, yb, hrw, hcw, hndw)
  +hc2 = RP.rotl_path_ctx($AO3, $M2, $CWL, w, sa, y, ya, yb, hrw, hcw, hndw)
  +hk2 = $COK1(p, True{}, t, y, c1, $RLW, hc2)
  %Equal.sym(Nat, M.node_left(~K, ST.nd(K, $RLW, p)), y, NB.child_eq(~K, ST.nd(K, $RLW, p), y, ST.rid(t), P.top(c1), False{}, $CISN(p, True{}, t, y, P.top(c1), $RLW, hk2))) : $FP($DFIX(gf, MI.delete_borrow_right($AK, $SHR($RQW, $RLW), p, _, ST.nd(K, $RLW, p), ST.nd(K, $RLW, _))))
  +eW = Equal.trans($LN, $WH(c1, $FSR2), $WH($CWL, $SWR2), $WH(c1, $FSR), P.ids_l(c1, p, $SWR2, t), Equal.trans($LN, $WH($CWL, $SWR2), $WH($CWL, $SWR), $WH(c1, $FSR), RP.wh_eq($CWL, $SWR2, $SWR, RP.ids_rl(w, sa, y, ya, yb)), Equal.sym($LN, $WH(c1, $FSR), $WH($CWL, $SWR), ew)))
  +hq = RP.root_rot(~K, $M2, $CWL, w, y, $SWR, $SWR2, root, {==}, {==}, hcw, hroot)
  dborrow_r($AO, $FXA, gf, $RQW, $RLW, c1, p, t, y, $TN(w, sa, ya), yb, FX.up_t(~K, $RLW, p, t, $SWR2, P.top(c1), hr2, hk2), $COKT(p, True{}, t, y, c1, $RLW, hc2), L.subst($LN, z => $NDL(z), $WH(c1, $FSR), $WH(c1, $FSR2), Equal.sym($LN, $WH(c1, $FSR2), $WH(c1, $FSR), eW), hnd), hq, Equal.trans($LN, $WH(c1, $FSR2), $WH(c1, $FSR), i0, eW, hids), $LALL($M2, w, y, ST.rid(ya), p, SP.dir($CWL), $E4($M1, w, True{}, $E4(nl, y, False{}, h4)), $E5($M1, w, True{}, $E5(nl, y, False{}, h5)), $E6($M1, w, True{}, $E6(nl, y, False{}, h6)), $E7($M1, w, True{}, $E7(nl, y, False{}, h7))))

def dfar0_r($TO, $FX, +gf: Nat, +root: Nat, +nl: $NL, +c1: $CT, +p: Nat, +t: ST.Tr, +w: Nat, +sa: ST.Tr, +sb: ST.Tr, +hnr: {M.node_red(~K, ST.nd(K, nl, ST.rid(sb))) == True{} : Bool}, $BHR, $IVH(nl)) -> $FP($DFIX(gf, MI.delete_far_right($AK, $SHR(root, nl), p, w, ST.nd(K, nl, p), ST.nd(K, nl, w), False{}))):
  match sb:
    case ST.TE{}:
      Empty.absurd($FP($DFIX(gf, MI.delete_far_right($AK, $SHR(root, nl), p, w, ST.nd(K, nl, p), ST.nd(K, nl, w), False{}))), L.false_true(hnr))
    case ST.TN{+y, +ya, +yb}:
      dfar_r($AO, $FXA, gf, root, nl, c1, p, t, w, sa, y, ya, yb, hr, hok, hnd, hroot, hids, $HA)

%def CRW Con{P.FR{p, False{}, $SWG}, c1}
%def KHR +nr: Bool, +hnr: {M.node_red(~K, ST.nd(K, nl, ST.rid(sb))) == nr : Bool}, +fr: Bool, +hfr: {M.node_red(~K, ST.nd(K, nl, ST.rid(sa))) == fr : Bool}
%def UPR FX.up_f(~K, nl, p, $SWG, t, P.top(c1), i1, $COK1(p, False{}, $SWG, ST.rid(t), c1, nl, i2)), $COKT(p, False{}, $SWG, ST.rid(t), c1, nl, i2), L.subst($LN, z => $NDL(z), $WH($CRW, t), $WH(c1, $BSR), Equal.sym($LN, $WH(c1, $BSR), $WH($CRW, t), P.ids_r(c1, p, $SWG, t)), i3), i5, Equal.trans($LN, $WH(c1, $BSR), $WH($CRW, t), i0, P.ids_r(c1, p, $SWG, t), i4), $HA

def dkids_r($TO, $FX, +gf: Nat, +root: Nat, +nl: $NL, +c1: $CT, +p: Nat, +w: Nat, +sa: ST.Tr, +sb: ST.Tr, +t: ST.Tr, $DIH($CRW, t), $IVH(nl), kont: $DKONT(gf), $KHR) -> $FP($DFIX(gf, MI.delete_children_right($AK, $SHR(root, nl), p, w, ST.nd(K, nl, p), ST.nd(K, nl, w), nr, fr))):
  match nr fr:
    case False{} False{}:
      dup_r($AO, $FXA, gf, root, nl, c1, p, $SWG, t, $DIA, $HA, kont)
    case True{} True{}:
      dborrow_r($AO, $FXA, gf, root, nl, c1, p, t, w, sa, sb, $UPR)
    case False{} True{}:
      dborrow_r($AO, $FXA, gf, root, nl, c1, p, t, w, sa, sb, $UPR)
    case True{} False{}:
      dfar0_r($AO, $FXA, gf, root, nl, c1, p, t, w, sa, sb, hnr, $UPR)

%def KIDSR(sw) MI.delete_children_right($AK, $SHR(root, nl), p, ST.rid(sw), ST.nd(K, nl, p), ST.nd(K, nl, ST.rid(sw)), M.node_red(~K, ST.nd(K, nl, M.node_right(~K, ST.nd(K, nl, ST.rid(sw))))), M.node_red(~K, ST.nd(K, nl, M.node_left(~K, ST.nd(K, nl, ST.rid(sw))))))

def dsib2_r($TO, $FX, +gf: Nat, +root: Nat, +nl: $NL, +c1: $CT, +p: Nat, +s: ST.Tr, +t: ST.Tr, $DIH($CR, t), $IVH(nl), kont: $DKONT(gf)) -> $FP($DFIX(gf, $KIDSR(s))):
  match s:
    case ST.TE{}:
      dup_r($AO, $FXA, gf, root, nl, c1, p, ST.TE{}, t, $DIA, $HA, kont)
    case ST.TN{+w, +sa, +sb}:
      +hw = TR.rep_node(~K, w, sa, sb, p, nl, $CSRP(p, False{}, $SWG, ST.rid(t), P.top(c1), nl, $COK1(p, False{}, $SWG, ST.rid(t), c1, nl, i2)))
      %Equal.sym(Nat, M.node_right(~K, ST.nd(K, nl, w)), ST.rid(sb), NB.child_eq(~K, ST.nd(K, nl, w), ST.rid(sa), ST.rid(sb), p, True{}, hw)) : $FP($DFIX(gf, MI.delete_children_right($AK, $SHR(root, nl), p, w, ST.nd(K, nl, p), ST.nd(K, nl, w), M.node_red(~K, ST.nd(K, nl, _)), M.node_red(~K, ST.nd(K, nl, M.node_left(~K, ST.nd(K, nl, w)))))))
      %Equal.sym(Nat, M.node_left(~K, ST.nd(K, nl, w)), ST.rid(sa), NB.child_eq(~K, ST.nd(K, nl, w), ST.rid(sa), ST.rid(sb), p, False{}, hw)) : $FP($DFIX(gf, MI.delete_children_right($AK, $SHR(root, nl), p, w, ST.nd(K, nl, p), ST.nd(K, nl, w), M.node_red(~K, ST.nd(K, nl, ST.rid(sb))), M.node_red(~K, ST.nd(K, nl, _)))))
      dkids_r($AO, $FXA, gf, root, nl, c1, p, w, sa, sb, t, $DIA, $HA, kont, M.node_red(~K, ST.nd(K, nl, ST.rid(sb))), {==}, M.node_red(~K, ST.nd(K, nl, ST.rid(sa))), {==})

def dsib_r($TO, $FX, +gf: Nat, +root: Nat, +nl: $NL, +c1: $CT, +p: Nat, +s: ST.Tr, +t: ST.Tr, $DIH($CR, t), $IVH(nl), kont: $DKONT(gf)) -> $FP($DFIX(gf, MI.delete_sibling_right($AK, $SHR(root, nl), p))):
  +hk = $COK1(p, False{}, s, ST.rid(t), c1, nl, i2)
  %Equal.sym(Nat, M.node_left(~K, ST.nd(K, nl, p)), ST.rid(s), NB.child_eq(~K, ST.nd(K, nl, p), ST.rid(s), ST.rid(t), P.top(c1), False{}, $CISN(p, False{}, s, ST.rid(t), P.top(c1), nl, hk))) : $FP($DFIX(gf, MI.delete_children_right($AK, $SHR(root, nl), p, _, ST.nd(K, nl, p), ST.nd(K, nl, _), M.node_red(~K, ST.nd(K, nl, M.node_right(~K, ST.nd(K, nl, _)))), M.node_red(~K, ST.nd(K, nl, M.node_left(~K, ST.nd(K, nl, _)))))))
  dsib2_r($AO, $FXA, gf, root, nl, c1, p, s, t, $DIA, $HA, kont)

%def RRP $ROTR($P2, p, w, ST.rid(sb), P.top(c1), SP.dir(c1))
%def C1WR Con{P.FR{w, False{}, sa}, c1}
%def CRA Con{P.FR{p, False{}, sb}, $C1WR}
%def OR1 P.ok_r(~K, $RRP, c1, w, sa, $TN(p, sb, t), RP.rotr_path_rep($AO3, $P2, c1, p, sa, w, sb, t, hr2, hok2, hnd), RP.rotr_path_ctx($AO3, $P2, c1, p, sa, w, sb, t, hr2, hok2, hnd))
%def OR1A {P.ctxok(~K, $C1WR, p, $RRP) == True{} : Bool}
%def OR1B $REPN($TN(p, sb, t), w, $RRP)
%def OR2 P.ok_r(~K, $RRP, $C1WR, p, sb, t, Pair.snd($OR1A, $OR1B, $OR1), Pair.fst($OR1A, $OR1B, $OR1))
%def OR2A {P.ctxok(~K, $CRA, ST.rid(t), $RRP) == True{} : Bool}
%def OR2B $REPN(t, p, $RRP)

def dred_r($TO, $FX, +gf: Nat, +root: Nat, +nl: $NL, +c1: $CT, +p: Nat, +s: ST.Tr, +t: ST.Tr, $DIH($CR, t), $IVH(nl), kont: $DKONT(gf), +b: Bool, +hb: {M.node_red(~K, ST.nd(K, nl, ST.rid(s))) == b : Bool}) -> $FP($DFIX(gf, MI.delete_red_sibling_right($AK, $SHR(root, nl), p, ST.rid(s), b))):
  match s b:
    case ST.TE{} False{}:
      dsib_r($AO, $FXA, gf, root, nl, c1, p, ST.TE{}, t, $DIA, $HA, kont)
    case ST.TE{} True{}:
      Empty.absurd($FP($DFIX(gf, MI.delete_red_sibling_right($AK, $SHR(root, nl), p, 0n, True{}))), L.false_true(hb))
    case ST.TN{+w, +sa, +sb} False{}:
      dsib_r($AO, $FXA, gf, root, nl, c1, p, $SWG, t, $DIA, $HA, kont)
    case ST.TN{+w, +sa, +sb} True{}:
      %Equal.sym($SHT, MI.set_red($AK, $SHR(root, nl), w, False{}), $SHR(root, $P1), $SRM(root, nl, w, False{})) : $FP($DFIX(gf, MI.delete_sibling_right($AK, MI.rotate_right($AK, MI.set_red($AK, _, p, True{}), p), p)))
      %Equal.sym($SHT, MI.set_red($AK, $SHR(root, $P1), p, True{}), $SHR(root, $P2), $SRM(root, $P1, p, True{})) : $FP($DFIX(gf, MI.delete_sibling_right($AK, MI.rotate_right($AK, _, p), p)))
      +hr2 = $RSC($BSR, P.top(c1), $P1, p, True{}, $RSC($BSR, P.top(c1), nl, w, False{}, FX.up_f(~K, nl, p, $SWG, t, P.top(c1), i1, $COK1(p, False{}, $SWG, ST.rid(t), c1, nl, i2))))
      +hok2 = $CSC(c1, p, $P1, p, True{}, $CSC(c1, p, nl, w, False{}, $COKT(p, False{}, $SWG, ST.rid(t), c1, nl, i2)))
      +hnd = L.subst($LN, z => $NDL(z), $WH($CRW, t), $WH(c1, $BSR), Equal.sym($LN, $WH(c1, $BSR), $WH($CRW, t), P.ids_r(c1, p, $SWG, t)), i3)
      %Equal.sym($SHT, MI.rotate_right($AK, $SHR(root, $P2), p), $SHR($RQL, $RRP), RP.rotr_path_eq($AO, n, root, lo, hi, free, l, d, $P2, pl, tg, fl, c1, p, sa, w, sb, t, hr2, hok2, hnd)) : $FP($DFIX(gf, MI.delete_sibling_right($AK, _, p)))
      +eW = Equal.trans($LN, $WH($CRA, t), $WH($C1WR, $TN(p, sb, t)), $WH($CRW, t), Equal.sym($LN, $WH($C1WR, $TN(p, sb, t)), $WH($CRA, t), P.ids_r($C1WR, p, sb, t)), Equal.trans($LN, $WH($C1WR, $TN(p, sb, t)), $WH(c1, $BSR2), $WH($CRW, t), Equal.sym($LN, $WH(c1, $BSR2), $WH($C1WR, $TN(p, sb, t)), P.ids_r(c1, w, sa, $TN(p, sb, t))), Equal.trans($LN, $WH(c1, $BSR2), $WH(c1, $BSR), $WH($CRW, t), RP.wh_eq(c1, $BSR2, $BSR, RP.ids_rr(p, w, sa, sb, t)), P.ids_r(c1, p, $SWG, t))))
      dsib_r($AO, $FXA, gf, $RQL, $RRP, $C1WR, p, sb, t, Pair.snd($OR2A, $OR2B, $OR2), Pair.fst($OR2A, $OR2B, $OR2), L.subst($LN, z => $NDL(z), $WH($CRW, t), $WH($CRA, t), Equal.sym($LN, $WH($CRA, t), $WH($CRW, t), eW), i3), Equal.trans($LN, $WH($CRA, t), $WH($CRW, t), i0, eW, i4), RP.root_rot(~K, $P2, c1, p, w, $BSR, $BSR2, root, {==}, {==}, hok2, i5), $RALL($P2, p, w, ST.rid(sb), P.top(c1), SP.dir(c1), $E4($P1, p, True{}, $E4(nl, w, False{}, h4)), $E5($P1, p, True{}, $E5(nl, w, False{}, h5)), $E6($P1, p, True{}, $E6(nl, w, False{}, h6)), $E7($P1, p, True{}, $E7(nl, w, False{}, h7))), kont)

def dside_r($TO, $FX, +gf: Nat, +root: Nat, +nl: $NL, +c1: $CT, +p: Nat, +s: ST.Tr, +t: ST.Tr, $DIH($CR, t), $IVH(nl), kont: $DKONT(gf)) -> $FP($DFIX(gf, MI.delete_side_right($AK, $SHR(root, nl), p, ST.nd(K, nl, p)))):
  +hk = $COK1(p, False{}, s, ST.rid(t), c1, nl, i2)
  %Equal.sym(Nat, M.node_left(~K, ST.nd(K, nl, p)), ST.rid(s), NB.child_eq(~K, ST.nd(K, nl, p), ST.rid(s), ST.rid(t), P.top(c1), False{}, $CISN(p, False{}, s, ST.rid(t), P.top(c1), nl, hk))) : $FP($DFIX(gf, MI.delete_red_sibling_right($AK, $SHR(root, nl), p, _, M.node_red(~K, ST.nd(K, nl, _)))))
  dred_r($AO, $FXA, gf, root, nl, c1, p, s, t, $DIA, $HA, kont, M.node_red(~K, ST.nd(K, nl, ST.rid(s))), {==})

# ---- a step, and the loop ----

%def RN0(j, a, b, q) Bool.and(ST.is_node(K, ST.nd(K, nl, j), ST.rid(a), ST.rid(b), q), Bool.and(ST.rep(~K, a, j, nl), ST.rep(~K, b, j, nl)))
%def CX Con{P.FR{p, lft, s}, c1}
%def SIDE(x, q, e) MI.delete_side($AK, $SHR(root, nl), x, q, ST.nd(K, nl, q), e)

# x and its sibling with the same id: both empty, so x may as well be on the left
def dsame($TO, $FX, +gf: Nat, +root: Nat, +nl: $NL, +c1: $CT, +p: Nat, +s: ST.Tr, +t: ST.Tr, $DIH($CR, t), $IVH(nl), kont: $DKONT(gf), +he: {Nat.is_eq(ST.rid(t), ST.rid(s)) == True{} : Bool}) -> $FP($DFIX(gf, $SIDE(ST.rid(t), p, True{}))):
  match s t:
    case ST.TE{} ST.TE{}:
      +ew0 = Equal.trans($LN, $WH(Con{P.FR{p, False{}, ST.TE{}}, c1}, ST.TE{}), $WH(c1, $TN(p, ST.TE{}, ST.TE{})), $WH(Con{P.FR{p, True{}, ST.TE{}}, c1}, ST.TE{}), Equal.sym($LN, $WH(c1, $TN(p, ST.TE{}, ST.TE{})), $WH(Con{P.FR{p, False{}, ST.TE{}}, c1}, ST.TE{}), P.ids_r(c1, p, ST.TE{}, ST.TE{})), P.ids_l(c1, p, ST.TE{}, ST.TE{}))
      dside_l($AO, $FXA, gf, root, nl, c1, p, ST.TE{}, ST.TE{}, i1, i2, L.subst($LN, z => $NDL(z), $WH(Con{P.FR{p, False{}, ST.TE{}}, c1}, ST.TE{}), $WH(Con{P.FR{p, True{}, ST.TE{}}, c1}, ST.TE{}), ew0, i3), Equal.trans($LN, $WH(Con{P.FR{p, True{}, ST.TE{}}, c1}, ST.TE{}), $WH(Con{P.FR{p, False{}, ST.TE{}}, c1}, ST.TE{}), i0, Equal.sym($LN, $WH(Con{P.FR{p, False{}, ST.TE{}}, c1}, ST.TE{}), $WH(Con{P.FR{p, True{}, ST.TE{}}, c1}, ST.TE{}), ew0), i4), i5, $HA, kont)
    case ST.TN{+j, +sa, +sb} ST.TE{}:
      +hs = $CSRP(p, False{}, $TN(j, sa, sb), 0n, P.top(c1), nl, $COK1(p, False{}, $TN(j, sa, sb), 0n, c1, nl, i2))
      +hj = L.and_left(Nat.is_lt(0n, j), $RN0(j, sa, sb, p), hs)
      Empty.absurd($FP($DFIX(gf, $SIDE(0n, p, True{}))), L.false_true(L.subst(Nat, z => {Nat.is_lt(0n, z) == True{} : Bool}, j, 0n, Equal.sym(Nat, 0n, j, N.eq_from_is_eq(0n, j, he)), hj)))
    case ST.TE{} ST.TN{+i, +ta, +tb}:
      +hpi = L.and_left(Nat.is_lt(0n, i), $RN0(i, ta, tb, p), i1)
      Empty.absurd($FP($DFIX(gf, $SIDE(i, p, True{}))), L.false_true(L.subst(Nat, z => {Nat.is_lt(0n, z) == True{} : Bool}, i, 0n, N.eq_from_is_eq(i, 0n, he), hpi)))
    case ST.TN{+j, +sa, +sb} ST.TN{+i, +ta, +tb}:
      +mb = DJ.mem_r(j, P.before(c1), SC.append(Nat, $IDS($TN(j, sa, sb)), Con{p, Nil{}}), DJ.mem_l(j, $IDS($TN(j, sa, sb)), Con{p, Nil{}}, P.mem_root(j, sa, sb)))
      +dj = DJ.dj_r(P.before(Con{P.FR{p, False{}, $TN(j, sa, sb)}, c1}), $APP($IDS($TN(i, ta, tb)), P.after(c1)), i3, j, mb)
      +mt = L.subst(Nat, z => {NL.memn(z, $APP($IDS($TN(i, ta, tb)), P.after(c1))) == True{} : Bool}, i, j, N.eq_from_is_eq(i, j, he), DJ.mem_l(i, $IDS($TN(i, ta, tb)), P.after(c1), P.mem_root(i, ta, tb)))
      Empty.absurd($FP($DFIX(gf, $SIDE(i, p, True{}))), L.false_true(Equal.trans(Bool, False{}, NL.memn(j, $APP($IDS($TN(i, ta, tb)), P.after(c1))), True{}, Equal.sym(Bool, NL.memn(j, $APP($IDS($TN(i, ta, tb)), P.after(c1))), False{}, dj), mt)))

# x on the right: its id against the sibling's
def dsd($TO, $FX, +gf: Nat, +root: Nat, +nl: $NL, +c1: $CT, +p: Nat, +s: ST.Tr, +t: ST.Tr, $DIH($CR, t), $IVH(nl), kont: $DKONT(gf), +e: Bool, +he: {Nat.is_eq(ST.rid(t), ST.rid(s)) == e : Bool}) -> $FP($DFIX(gf, $SIDE(ST.rid(t), p, e))):
  match e:
    case False{}:
      dside_r($AO, $FXA, gf, root, nl, c1, p, s, t, $DIA, $HA, kont)
    case True{}:
      dsame($AO, $FXA, gf, root, nl, c1, p, s, t, $DIA, $HA, kont, he)

# the side x hangs on
def dlft($TO, $FX, +gf: Nat, +root: Nat, +nl: $NL, +c1: $CT, +p: Nat, +lft: Bool, +s: ST.Tr, +t: ST.Tr, $DIH($CX, t), $IVH(nl), kont: $DKONT(gf)) -> $FP($DFIX(gf, $SIDE(ST.rid(t), p, Nat.is_eq(ST.rid(t), ST.pk(Nat, lft, ST.rid(t), ST.rid(s)))))):
  match lft:
    case True{}:
      %Equal.sym(Bool, Nat.is_eq(ST.rid(t), ST.rid(t)), True{}, N.is_eq_refl(ST.rid(t))) : $FP($DFIX(gf, $SIDE(ST.rid(t), p, _)))
      dside_l($AO, $FXA, gf, root, nl, c1, p, s, t, $DIA, $HA, kont)
    case False{}:
      dsd($AO, $FXA, gf, root, nl, c1, p, s, t, $DIA, $HA, kont, Nat.is_eq(ST.rid(t), ST.rid(s)), {==})

%def STOPB Bool.or(Nat.is_eq(ST.rid(t), root), M.node_red(~K, ST.nd(K, nl, ST.rid(t))))

# not stopping: x is not the root, so it has a parent
def dside($TO, $FX, +gf: Nat, +root: Nat, +nl: $NL, +c: $CT, +t: ST.Tr, $DIH(c, t), $IVH(nl), kont: $DKONT(gf), +hb: {$STOPB == False{} : Bool}) -> $FP($DFIX(gf, $SIDE(ST.rid(t), P.top(c), Nat.is_eq(ST.rid(t), M.node_left(~K, ST.nd(K, nl, P.top(c))))))):
  match c:
    case Nil{}:
      +e1 = L.subst(Nat, z => {Nat.is_eq(ST.rid(t), z) == True{} : Bool}, ST.rid(t), root, Equal.sym(Nat, root, ST.rid(t), i5), N.is_eq_refl(ST.rid(t)))
      Empty.absurd($FP($DFIX(gf, $SIDE(ST.rid(t), 0n, Nat.is_eq(ST.rid(t), M.node_left(~K, ST.nd(K, nl, 0n)))))), L.false_true(Equal.trans(Bool, False{}, $STOPB, True{}, Equal.sym(Bool, $STOPB, False{}, hb), FX.or_lt(Nat.is_eq(ST.rid(t), root), M.node_red(~K, ST.nd(K, nl, ST.rid(t))), e1))))
    case Con{P.FR{+p, +lft, +s}, +c1}:
      +hk = $COK1(p, lft, s, ST.rid(t), c1, nl, i2)
      %Equal.sym(Nat, M.node_left(~K, ST.nd(K, nl, p)), ST.pk(Nat, lft, ST.rid(t), ST.rid(s)), NB.child_eq(~K, ST.nd(K, nl, p), ST.pk(Nat, lft, ST.rid(t), ST.rid(s)), ST.pk(Nat, lft, ST.rid(s), ST.rid(t)), P.top(c1), False{}, $CISN(p, lft, s, ST.rid(t), P.top(c1), nl, hk))) : $FP($DFIX(gf, $SIDE(ST.rid(t), p, Nat.is_eq(ST.rid(t), _))))
      dlft($AO, $FXA, gf, root, nl, c1, p, lft, s, t, $DIA, $HA, kont)

# stopping: x goes black, and the loop blackens the root
def dstop2($TO, $FX, +gf: Nat, +root: Nat, +nl: $NL, +c: $CT, +t: ST.Tr, $DIH(c, t), $IVH(nl), kont: $DKONT(gf), +b: Bool, +hb: {$STOPB == b : Bool}) -> $FP($DFIX(gf, MI.delete_stop($AK, $SHR(root, nl), ST.rid(t), P.top(c), ST.nd(K, nl, P.top(c)), b))):
  match b:
    case True{}:
      %Equal.sym($SHT, MI.set_red($AK, $SHR(root, nl), ST.rid(t), False{}), $SHR(root, $SETC(nl, ST.rid(t), False{})), $SRM(root, nl, ST.rid(t), False{})) : $FP($DFIX(gf, (_, M.DF{0n, 0n, False{}})))
      dstop($AO, $FXA, gf, root, $SETC(nl, ST.rid(t), False{}), PG.plug(c, t), PG.rep_plug(~K, $SETC(nl, ST.rid(t), False{}), c, t, $RSC(t, P.top(c), nl, ST.rid(t), False{}, i1), $CSC(c, ST.rid(t), nl, ST.rid(t), False{}, i2)), i5, Equal.trans($LN, $IDS(PG.plug(c, t)), $WH(c, t), i0, PG.ids_plug(c, t), i4), $EALL(nl, ST.rid(t), False{}, h4, h5, h6, h7))
    case False{}:
      dside($AO, $FXA, gf, root, nl, c, t, $DIA, $HA, kont, hb)

def dstep($TO, $FX, +gf: Nat, +root: Nat, +nl: $NL, +c: $CT, +t: ST.Tr, $DIH(c, t), $IVH(nl), kont: $DKONT(gf)) -> $FP($DFIX(1n+gf, ($SHR(root, nl), M.DF{ST.rid(t), P.top(c), True{}}))):
  dstop2($AO, $FXA, gf, root, nl, c, t, $DIA, $HA, kont, $STOPB, {==})

# from the position x under its parent, the loop ends with the ghost tree's
# properties, whatever its fuel and flag
def dloop($TO, $FX, +gf: Nat, +root: Nat, +nl: $NL, +c: $CT, +t: ST.Tr, $DIH(c, t), $IVH(nl), +b: Bool) -> $FP($DFIX(gf, ($SHR(root, nl), M.DF{ST.rid(t), P.top(c), b}))):
  match gf b:
    case 0n +b:
      dfin($AO, $FXA, root, nl, c, t, $DIA, $HA)
    case 1n+g False{}:
      dfin($AO, $FXA, root, nl, c, t, $DIA, $HA)
    case 1n+g True{}:
      dstep($AO, $FXA, g, root, nl, c, t, $DIA, $HA, kr_ => kn_ => kc_ => kt_ => ki1 => ki2 => ki3 => ki4 => ki5 => kh4 => kh5 => kh6 => kh7 => dloop($AO, $FXA, g, kr_, kn_, kc_, kt_, ki1, ki2, ki3, ki4, ki5, kh4, kh5, kh6, kh7, True{}))
