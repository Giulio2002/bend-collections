import Base
import ../../lib/logic.bend as L
import ../../lib/list.bend as LL
import ../../lib/order.bend as O
import ../../lib/spec_common.bend as SC
import ./spec.bend as S
import ../../../src/containers/balanced_search_tree.bend as M
import ./state.bend as ST
import ./mirror.bend as MI
import ./tree.bend as TR
import ./ends.bend as EN
import ./path.bend as P
import ./plug.bend as PG
import ./ord.bend as OR
import ./cur.bend as CU
import ./cnx.bend as CX
import ./prim.bend as PR
import ./putf.bend as PF
import ./find.bend as FI
import ./slot.bend as SL

# iterator_set_value: the current id, when a node, gets the value: the
# specification's set_val of the current key, the old value the answer.
# (source: tools/generators/tm_hand/csv.src)

%def ND M.Node<K>
%def NL List<&2, $ND>
%def LN List<&2, Nat>
%def CT List<&2, P.Fr>
%def E M.Entry<K, V>
%def ES List<&2, $E>
%def ME Maybe<&2, $E>
%def MVV Maybe<&2, V>
%def TK ~K: Data, ~V: Data, ~cmp: K -> K -> Cmp
%def TO ~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, ~o: O.Order(~K, ~cmp)
%def AK ~K, ~V, ~cmp
%def AO ~K, ~V, ~cmp, ~o
%def EAPP(a, b) SC.append($E, a, b)
%def APP(a, b) SC.append(Nat, a, b)
%def IDS(t) ST.ids(t)
%def TN(i, a, b) ST.TN{i, a, b}
%def WH(c, t) $APP(P.before(c), $APP($IDS(t), P.after(c)))
%def REPN(t, p) {ST.rep(~K, t, p, nl) == True{} : Bool}
%def COKN(c, z) {P.ctxok(~K, c, z, nl) == True{} : Bool}
%def FT +n: Nat, +root: Nat, +lo: Nat, +hi: Nat, +free: Nat, +l: Nat, +d: Nat, +nl: $NL, +pl: List<&2, $MVV>, +tg: ST.Tr, +fl: $LN
%def F n, root, lo, hi, free, l, d, nl, pl, tg, fl
%def SH ST.SH{$F}
%def GF {ST.goodF($AK, $F) == True{} : Bool}
%def ENTS(xs) ST.ents(~K, ~V, xs, nl, pl)
%def EST $ENTS($IDS(tg))
%def RES Result<&2, &2, M.Error, V>
%def J 1n+j
%def CH +nx: Nat, +lo2: M.Bound<K>, +hi2: M.Bound<K>, +fw: Bool, +v: V
%def CHA nx, lo2, hi2, fw, v
%def CUJ MI.MC{$SH, nx, $J, lo2, hi2, fw}
%def HCJ {CU.cgood($AK, $CUJ) == True{} : Bool}
%def REST Bool.and(CU.idok($IDS(tg), nx), Bool.and(CU.idok($IDS(tg), $J), Bool.or(Nat.is_eq(nx, 0n), Bool.not(Nat.is_eq(nx, $J)))))
%def HG L.and_left(ST.goodF($AK, $F), $REST, hc)
%def HREST L.and_right(ST.goodF($AK, $F), $REST, hc)
%def HMEM L.and_left(CU.idok($IDS(tg), $J), Bool.or(Nat.is_eq(nx, 0n), Bool.not(Nat.is_eq(nx, $J))), L.and_right(CU.idok($IDS(tg), nx), Bool.and(CU.idok($IDS(tg), $J), Bool.or(Nat.is_eq(nx, 0n), Bool.not(Nat.is_eq(nx, $J)))), $HREST))
%def TJ $TN($J, pa, pb)
%def XS $APP(P.before(pc), $IDS(pa))
%def YS $APP($IDS(pb), P.after(pc))
%def SPL $APP($XS, Con{$J, $YS})
%def PH +pc: $CT, +pa: ST.Tr, +pb: ST.Tr, +hid: {$IDS(tg) == $WH(pc, $TJ) : $LN}, +hw: {$IDS(tg) == $SPL : $LN}, +h3: $REPN($TJ, P.top(pc)), +h4: $COKN(pc, $J)
%def PHA pc, pa, pb, hid, hw, h3, h4
%def PL2 PR.ex_pl(V, pl, $J, Some{v})
%def SH2 ST.SH{n, root, lo, hi, free, l, d, nl, $PL2, tg, fl}
%def CUR2 MI.MC{$SH2, nx, $J, lo2, hi2, fw}
%def SPC S.iterator_set_value($AK, CU.cmod($AK, $CUJ), v)
%def SVG(m) CU.COK($AK, $RES, $SPC, MI.iterator_set_done($AK, nx, $J, lo2, hi2, fw, ($SH2, m)))
%def HEQ {ST.ents(~K, ~V, $IDS(tg), nl, $PL2) == S.set_val($AK, k, v, $EST) : $ES}
%def HG2 {ST.goodF($AK, n, root, lo, hi, free, l, d, nl, $PL2, tg, fl) == True{} : Bool}
%def NU M.N{c0, x1, x2, x3, k}

def sv_w($TO, $FT, +j: Nat, $CH, +hc: $HCJ, $PH, +c0: Bool, +x1: Nat, +x2: Nat, +x3: Nat, +k: K, +ov: V, +hx: {ST.nd(K, nl, $J) == $NU : $ND}, +hm: {ST.pv(V, pl, $J) == Some{ov} : $MVV}, +he: $HEQ, +hg2: $HG2) -> $SVG(Some{ov}):
  +hg = $HG
  +eent = L.subst($MVV, z => {ST.ent(K, V, ST.nd(K, nl, $J), ST.pv(V, pl, $J)) == ST.ent(K, V, $NU, z) : $ME}, ST.pv(V, pl, $J), Some{ov}, hm, L.subst($ND, z => {ST.ent(K, V, ST.nd(K, nl, $J), ST.pv(V, pl, $J)) == ST.ent(K, V, z, ST.pv(V, pl, $J)) : $ME}, ST.nd(K, nl, $J), $NU, hx, {==}))
  +hE = Equal.trans($ES, $EST, $ENTS($SPL), $EAPP($ENTS($XS), Con{M.Entry{k, ov}, $ENTS($YS)}), L.subst($LN, z => {$EST == $ENTS(z) : $ES}, $IDS(tg), $SPL, hw, {==}), Equal.trans($ES, $ENTS($SPL), $EAPP($ENTS($XS), ST.cons_m($E, ST.ent(K, V, ST.nd(K, nl, $J), ST.pv(V, pl, $J)), $ENTS($YS))), $EAPP($ENTS($XS), Con{M.Entry{k, ov}, $ENTS($YS)}), FI.ents_app(~K, ~V, $XS, Con{$J, $YS}, nl, pl), L.subst($ME, z => {$EAPP($ENTS($XS), ST.cons_m($E, ST.ent(K, V, ST.nd(K, nl, $J), ST.pv(V, pl, $J)), $ENTS($YS))) == $EAPP($ENTS($XS), ST.cons_m($E, z, $ENTS($YS))) : $ES}, ST.ent(K, V, ST.nd(K, nl, $J), ST.pv(V, pl, $J)), Some{M.Entry{k, ov}}, eent, {==})))
  +hord = L.subst($ES, z => {ST.ordered($AK, z) == True{} : Bool}, $EST, $EAPP($ENTS($XS), Con{M.Entry{k, ov}, $ENTS($YS)}), hE, ST.g_cord($AK, $F, hg))
  +efe = Equal.trans($ME, S.find_e($AK, k, $EST), S.find_e($AK, k, $EAPP($ENTS($XS), Con{M.Entry{k, ov}, $ENTS($YS)})), Some{M.Entry{k, ov}}, L.subst($ES, z => {S.find_e($AK, k, $EST) == S.find_e($AK, k, z) : $ME}, $EST, $EAPP($ENTS($XS), Con{M.Entry{k, ov}, $ENTS($YS)}), hE, {==}), OR.find_mid_eq($AO, k, $ENTS($XS), M.Entry{k, ov}, $ENTS($YS), hord, O.refl(~K, ~cmp, ~o, k)))
  %Equal.sym($ND, ST.nd(K, nl, $J), $NU, hx) : CU.COK($AK, $RES, S.iterator_set_value($AK, S.CR{S.TM{l, $EST}, CU.ck(~K, nl, nx), M.node_key(~K, _), lo2, hi2, fw}, v), MI.iterator_set_done($AK, nx, $J, lo2, hi2, fw, ($SH2, Some{ov})))
  %Equal.sym($ME, S.find_e($AK, k, $EST), Some{M.Entry{k, ov}}, efe) : CU.COK($AK, $RES, S.set_value_at($AK, l, $EST, CU.ck(~K, nl, nx), k, lo2, hi2, fw, v, S.val_m(K, V, _)), MI.iterator_set_done($AK, nx, $J, lo2, hi2, fw, ($SH2, Some{ov})))
  +ek = Equal.sym(Maybe<&2, K>, CU.ck(~K, nl, $J), Some{k}, L.subst($ND, z => {CU.ck(~K, nl, $J) == M.node_key(~K, z) : Maybe<&2, K>}, ST.nd(K, nl, $J), $NU, hx, {==}))
  +esp = L.subst(Maybe<&2, K>, z => {(S.CR{S.TM{l, S.set_val($AK, k, v, $EST)}, CU.ck(~K, nl, nx), z, lo2, hi2, fw}, Done{ov}) == (S.CR{S.TM{l, ST.ents(~K, ~V, $IDS(tg), nl, $PL2)}, CU.ck(~K, nl, nx), CU.ck(~K, nl, $J), lo2, hi2, fw}, Done{ov}) : S.Cursor<K, V> & $RES}, CU.ck(~K, nl, $J), Some{k}, Equal.sym(Maybe<&2, K>, Some{k}, CU.ck(~K, nl, $J), ek), L.subst($ES, z => {(S.CR{S.TM{l, z}, CU.ck(~K, nl, nx), CU.ck(~K, nl, $J), lo2, hi2, fw}, Done{ov}) == (S.CR{S.TM{l, ST.ents(~K, ~V, $IDS(tg), nl, $PL2)}, CU.ck(~K, nl, nx), CU.ck(~K, nl, $J), lo2, hi2, fw}, Done{ov}) : S.Cursor<K, V> & $RES}, ST.ents(~K, ~V, $IDS(tg), nl, $PL2), S.set_val($AK, k, v, $EST), he, {==}))
  ($CUR2, (Done{ov}, ({==}, (esp, L.and_intro(ST.goodF($AK, n, root, lo, hi, free, l, d, nl, $PL2, tg, fl), $REST, hg2, $HREST)))))

def sv_u($TO, $FT, +j: Nat, $CH, +hc: $HCJ, $PH, +c0: Bool, +x1: Nat, +x2: Nat, +x3: Nat, +k: K, +ov: V, +hx: {ST.nd(K, nl, $J) == $NU : $ND}, +hm: {ST.pv(V, pl, $J) == Some{ov} : $MVV}, hc2: $HEQ & $HG2) -> $SVG(Some{ov}):
  match hc2:
    case Tuple{he, hg2}:
      sv_w($AO, $F, j, $CHA, hc, $PHA, c0, x1, x2, x3, k, ov, hx, hm, he, hg2)

%def HMS FI.pay_node(~V, $J, pa, pb, pl, SL.pay_oks(~K, ~V, $TJ, nl, pl, SL.oks_split_l(~K, ~V, $IDS($TJ), P.after(pc), nl, pl, SL.oks_split_r(~K, ~V, P.before(pc), $APP($IDS($TJ), P.after(pc)), nl, pl, L.subst($LN, z => {EN.oks(~K, ~V, z, nl, pl) == True{} : Bool}, $IDS(tg), $WH(pc, $TJ), hid, EN.oks_tree(~K, ~V, nl, pl, tg, 0n, ST.g_crep($AK, $F, $HG), ST.g_cpay($AK, $F, $HG)))))))
%def ISN TR.rep_node(~K, $J, pa, pb, P.top(pc), nl, h3)

def sv_t($TO, $FT, +j: Nat, $CH, +hc: $HCJ, $PH, +x: $ND, +hx: {ST.nd(K, nl, $J) == x : $ND}, +m: $MVV, +hm: {ST.pv(V, pl, $J) == m : $MVV}) -> $SVG(m):
  match x m:
    case M.Free{f} +m:
      Empty.absurd($SVG(m), L.false_true(L.subst($ND, z => {ST.is_node(K, z, ST.rid(pa), ST.rid(pb), P.top(pc)) == True{} : Bool}, ST.nd(K, nl, $J), M.Free{f}, hx, $ISN)))
    case M.N{c0, x1, x2, x3, k} None{}:
      Empty.absurd($SVG(None{}), L.false_true(L.subst($MVV, z => {ST.some2(V, z) == True{} : Bool}, ST.pv(V, pl, $J), None{}, hm, $HMS)))
    case M.N{+c0, +x1, +x2, +x3, +k} Some{+ov}:
      +hfin = L.subst($ND, z => {S.is_eq(TR.kc(~K, ~cmp, k, z)) == True{} : Bool}, $NU, ST.nd(K, nl, $J), Equal.sym($ND, ST.nd(K, nl, $J), $NU, hx), L.subst(Cmp, w => {S.is_eq(w) == True{} : Bool}, EQ{}, cmp(k, k), Equal.sym(Cmp, cmp(k, k), EQ{}, O.refl(~K, ~cmp, ~o, k)), {==}))
      sv_u($AO, $F, j, $CHA, hc, $PHA, c0, x1, x2, x3, k, ov, hx, hm, PF.hit_core($AO, $F, $HG, pc, $J, pa, pb, k, v, hid, h3, hfin, ST.nd(K, nl, $J), ST.pv(V, pl, $J), {==}, {==}, $ISN, $HMS))

%def SVJ CU.COK($AK, $RES, $SPC, MI.iterator_set_value($AK, $CUJ, v))

def sv_s($TO, $FT, +j: Nat, $CH, +hc: $HCJ, $PH) -> $SVJ:
  sv_t($AO, $F, j, $CHA, hc, $PHA, ST.nd(K, nl, $J), {==}, ST.pv(V, pl, $J), {==})

def sv_r($TO, $FT, +j: Nat, $CH, +hc: $HCJ, +pc: $CT, +pa: ST.Tr, +pb: ST.Tr, +h1: {$WH(pc, $TJ) == $WH(Nil{}, tg) : $LN}, r3: $REPN($TJ, P.top(pc)) & $COKN(pc, $J)) -> $SVJ:
  match r3:
    case Tuple{h3, h4}:
      +hid = Equal.trans($LN, $IDS(tg), $APP($IDS(tg), Nil{}), $WH(pc, $TJ), Equal.sym($LN, $APP($IDS(tg), Nil{}), $IDS(tg), LL.append_nil(Nat, $IDS(tg))), Equal.sym($LN, $WH(pc, $TJ), $WH(Nil{}, tg), h1))
      +e1 = L.subst($LN, z => {$WH(pc, $TJ) == $APP(P.before(pc), z) : $LN}, $APP($APP($IDS(pa), Con{$J, $IDS(pb)}), P.after(pc)), $APP($IDS(pa), Con{$J, $YS}), LL.append_assoc(Nat, $IDS(pa), Con{$J, $IDS(pb)}, P.after(pc)), {==})
      +e2 = Equal.sym($LN, $SPL, $APP(P.before(pc), $APP($IDS(pa), Con{$J, $YS})), LL.append_assoc(Nat, P.before(pc), $IDS(pa), Con{$J, $YS}))
      sv_s($AO, $F, j, $CHA, hc, pc, pa, pb, hid, Equal.trans($LN, $IDS(tg), $WH(pc, $TJ), $SPL, hid, Equal.trans($LN, $WH(pc, $TJ), $APP(P.before(pc), $APP($IDS(pa), Con{$J, $YS})), $SPL, e1, e2)), h3, h4)

def sv_q($TO, $FT, +j: Nat, $CH, +hc: $HCJ, +pc: $CT, +pa: ST.Tr, +pb: ST.Tr, +h1: {$WH(pc, $TJ) == $WH(Nil{}, tg) : $LN}, rest: {PG.plug(pc, $TJ) == PG.plug(Nil{}, tg) : ST.Tr} & ($REPN($TJ, P.top(pc)) & $COKN(pc, $J))) -> $SVJ:
  match rest:
    case Tuple{h2, r3}:
      sv_r($AO, $F, j, $CHA, hc, pc, pa, pb, h1, r3)

%def PTJ(jj, c, t) Sigma<&1, &1, $CT, pc_ => Sigma<&1, &1, ST.Tr, pa_ => Sigma<&1, &1, ST.Tr, pb_ => {$WH(pc_, $TN(jj, pa_, pb_)) == $WH(c, t) : $LN} & ({PG.plug(pc_, $TN(jj, pa_, pb_)) == PG.plug(c, t) : ST.Tr} & ($REPN($TN(jj, pa_, pb_), P.top(pc_)) & $COKN(pc_, jj)))>>>

def sv_p($TO, $FT, +j: Nat, $CH, +hc: $HCJ, pt: $PTJ($J, Nil{}, tg)) -> $SVJ:
  match pt:
    case Tuple{+pc, Tuple{+pa, Tuple{+pb, Tuple{h1, rest}}}}:
      sv_q($AO, $F, j, $CHA, hc, pc, pa, pb, h1, rest)

%def CUX MI.MC{$SH, nx, cu, lo2, hi2, fw}

def set_value_m($TO, $FT, +cu: Nat, $CH, +hc: {CU.cgood($AK, $CUX) == True{} : Bool}) -> CU.COK($AK, $RES, S.iterator_set_value($AK, CU.cmod($AK, $CUX), v), MI.iterator_set_value($AK, $CUX, v)):
  match cu:
    case 0n:
      ($CUX, (Fail{M.NoCurrent{}}, ({==}, ({==}, hc))))
    case 1n+j:
      sv_p($AO, $F, j, $CHA, hc, CX.path_to(~K, ~cmp, ~o, tg, nl, Nil{}, $J, ST.g_crep($AK, $F, $HG), {==}, $HMEM))
