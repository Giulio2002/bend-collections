  %Equal.sym(List<&2, M.Entry<K, V>>, S.del(~K, ~V, ~cmp, k, ST.ents(~K, ~V, ST.ids(tg), nl, pl)), ST.ents(~K, ~V, ST.ids(tg), nl, pl), DO.del_absent(~K, ~V, ~cmp, ~o, k, ST.ents(~K, ~V, ST.ids(tg), nl, pl), Equal.sym(Maybe<&2, V>, None{}, S.find(~K, ~V, ~cmp, k, ST.ents(~K, ~V, ST.ids(tg), nl, pl)), hfd))) : OK.MOK(~K, ~V, ~cmp, Maybe<&2, V>, (S.TM{l, _}, None{}), (ST.SH{n, root, lo, hi, free, l, d, nl, pl, tg, fl}, None{}))
