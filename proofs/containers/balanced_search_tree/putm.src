import Base
import ../../lib/logic.bend as L
import ../../lib/list.bend as LL
import ../../lib/order.bend as O
import ../../../spec/lib/common.bend as SC
import ../../../spec/containers/balanced_search_tree/main.bend as S
import ../../../src/containers/balanced_search_tree.bend as M
import ./state.bend as ST
import ./mirror.bend as MI
import ./ok.bend as OK
import ./reads.bend as RD
import ./find.bend as FI
import ./ends.bend as EN
import ./path.bend as P
import ./plug.bend as PG
import ./ord.bend as OR
import ./slot.bend as SL
import ./prim.bend as PR
import ./tree.bend as TR
import ./spath.bend as SP
import ./alloc.bend as AC
import ./putf.bend as PF

# put, put_if_absent, replace and replace_if_equal over a good shadow: the
# search from the root ends at a path and a subtree (WRAP below, shared by
# every operation); an empty subtree means the key is absent (put allocates,
# appending or reusing a freed slot, and inserts), a node holds it (its
# payload is the lookup, exchanging it is set_val). Each mirror operation
# refines the specification's. (source: tools/generators/tm_hand/putm.src)

%def ND M.Node<K>
%def NL List<&2, $ND>
%def LN List<&2, Nat>
%def MV Maybe<&2, V>
%def PL List<&2, $MV>
%def CT List<&2, P.Fr>
%def TO ~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, ~o: O.Order(~K, ~cmp)
%def AK ~K, ~V, ~cmp
%def AO ~K, ~V, ~cmp, ~o
%def FT +n: Nat, +root: Nat, +lo: Nat, +hi: Nat, +free: Nat, +l: Nat, +d: Nat, +nl: $NL, +pl: $PL, +tg: ST.Tr, +fl: $LN
%def F n, root, lo, hi, free, l, d, nl, pl, tg, fl
%def SH ST.SH{$F}
%def GF {ST.goodF($AK, $F) == True{} : Bool}
%def RES Result<&2, &2, M.Rejected<K, V>, Maybe<&2, V>>
%def SPEC S.put($AK, ST.model($AK, $SH), k, v)
%def APP(a, b) SC.append(Nat, a, b)
%def IDS(t) ST.ids(t)
%def T0 $APP($IDS(tg), Nil{})
%def WH(t) $APP(P.before(c), $APP($IDS(t), P.after(c)))
%def OKS(xs) {EN.oks(~K, ~V, xs, nl, pl) == True{} : Bool}
%def ENTS(xs) ST.ents(~K, ~V, xs, nl, pl)
%def ENTSP(xs, q) ST.ents(~K, ~V, xs, nl, q)
%def ES List<&2, M.Entry<K, V>>
%def PFX +hwh: {$T0 == $WH(t) : $LN}, +hplug: {tg == PG.plug(c, t) : ST.Tr}, +hr: {ST.rep(~K, t, P.top(c), nl) == True{} : Bool}, +hokc: {P.ctxok(~K, c, ST.rid(t), nl) == True{} : Bool}, +hb: {OR.ltall(~K, ~V, ~cmp, k, $ENTS(P.before(c))) == True{} : Bool}, +ha: {OR.gtall(~K, ~V, ~cmp, k, $ENTS(P.after(c))) == True{} : Bool}, +hfin: {SP.fin(~K, ~cmp, k, t, nl) == True{} : Bool}
%def PFA hwh, hplug, hr, hokc, hb, ha, hfin

%include wrap.src

# ---- the node found by the search ----

def tn_zero($TO, $FT, +k: K, +c: $CT, +a: ST.Tr, +b: ST.Tr, +hr: {ST.rep(~K, ST.TN{0n, a, b}, P.top(c), nl) == True{} : Bool}) -> Empty:
  L.false_true(L.and_left(Nat.is_lt(0n, 0n), $RN(0n), hr))

def tn_hx($TO, $FT, +c: $CT, +j: Nat, +a: ST.Tr, +b: ST.Tr, +hr: {ST.rep(~K, ST.TN{1n+j, a, b}, P.top(c), nl) == True{} : Bool}) -> {ST.is_node(K, ST.nd(K, nl, 1n+j), ST.rid(a), ST.rid(b), P.top(c)) == True{} : Bool}:
  L.and_left(ST.is_node(K, ST.nd(K, nl, 1n+j), ST.rid(a), ST.rid(b), P.top(c)), Bool.and(ST.rep(~K, a, 1n+j, nl), ST.rep(~K, b, 1n+j, nl)), L.and_right(Nat.is_lt(0n, 1n+j), $RN(1n+j), hr))

def tn_hm($TO, $FT, +c: $CT, +i: Nat, +a: ST.Tr, +b: ST.Tr, +hk: $OKS($WH(ST.TN{i, a, b}))) -> {ST.some2(V, ST.pv(V, pl, i)) == True{} : Bool}:
  FI.pay_node(~V, i, a, b, pl, SL.pay_oks(~K, ~V, ST.TN{i, a, b}, nl, pl, SL.oks_split_l(~K, ~V, $IDS(ST.TN{i, a, b}), P.after(c), nl, pl, SL.oks_split_r(~K, ~V, P.before(c), $APP($IDS(ST.TN{i, a, b}), P.after(c)), nl, pl, hk))))

def tn_hbc($TO, $FT, +c: $CT, +i: Nat, +a: ST.Tr, +b: ST.Tr, +hwh: {$T0 == $WH(ST.TN{i, a, b}) : $LN}) -> {$IDS(tg) == $WH(ST.TN{i, a, b}) : $LN}:
  Equal.trans($LN, $IDS(tg), $T0, $WH(ST.TN{i, a, b}), Equal.sym($LN, $T0, $IDS(tg), LL.append_nil(Nat, $IDS(tg))), hwh)

# exchanging the found payload for w: the entries set_val(k, w), still good
def tn_core($TO, $FT, +hg: $GF, +k: K, +w: V, +c: $CT, +j: Nat, +a: ST.Tr, +b: ST.Tr, $TNH(1n+j)) -> $HE(1n+j, w) & $HG2(1n+j, w):
  PF.hit_core($AO, $F, hg, c, 1n+j, a, b, k, w, tn_hbc($AO, $F, c, 1n+j, a, b, hwh), hr, hfin, ST.nd(K, nl, 1n+j), ST.pv(V, pl, 1n+j), {==}, {==}, tn_hx($AO, $F, c, j, a, b, hr), tn_hm($AO, $F, c, 1n+j, a, b, hk))

# ---- put ----

%def PUTR(r) OK.MOK($AK, $RES, $SPEC, MI.put_found($AK, k, v, r))

# an empty subtree: allocate by the free chain, then insert
def put_te($TO, $FT, +hg: $GF, +k: K, +v: V, +c: $CT, +t: ST.Tr, +ht: {t == ST.TE{} : ST.Tr}, $PFX) -> $PUTR(($SH, M.Search{0n, P.top(c), SP.dir(c)})):
  match free:
    case 0n:
      +hwh2 = L.subst(ST.Tr, z => {$T0 == $WH(z) : $LN}, t, ST.TE{}, ht, hwh)
      +hbc = Equal.trans($LN, $IDS(tg), $T0, $APP(P.before(c), P.after(c)), Equal.sym($LN, $T0, $IDS(tg), LL.append_nil(Nat, $IDS(tg))), hwh2)
      +hpl = L.subst(ST.Tr, z => {tg == PG.plug(c, z) : ST.Tr}, t, ST.TE{}, ht, hplug)
      +hok = L.subst(ST.Tr, z => {P.ctxok(~K, c, ST.rid(z), nl) == True{} : Bool}, t, ST.TE{}, ht, hokc)
      AC.app_case($AO, n, root, lo, hi, l, d, nl, pl, tg, fl, hg, c, k, v, hbc, hpl, hok, hb, ha, Nat.is_lt(SC.length($ND, nl), SC.pow2(d)), {==}, Nat.is_lt(d, l), {==})
    case 1n+f:
      +hwh2 = L.subst(ST.Tr, z => {$T0 == $WH(z) : $LN}, t, ST.TE{}, ht, hwh)
      +hbc = Equal.trans($LN, $IDS(tg), $T0, $APP(P.before(c), P.after(c)), Equal.sym($LN, $T0, $IDS(tg), LL.append_nil(Nat, $IDS(tg))), hwh2)
      +hpl = L.subst(ST.Tr, z => {tg == PG.plug(c, z) : ST.Tr}, t, ST.TE{}, ht, hplug)
      +hok = L.subst(ST.Tr, z => {P.ctxok(~K, c, ST.rid(z), nl) == True{} : Bool}, t, ST.TE{}, ht, hokc)
      AC.reuse_case($AO, n, root, lo, hi, f, l, d, nl, pl, tg, fl, hg, c, k, v, hbc, hpl, hok, hb, ha, ST.nd(K, nl, 1n+f), {==})

def put_h($TO, $FT, +k: K, +v: V, +c: $CT, +j: Nat, +hfd: {ST.pv(V, pl, 1n+j) == $FIND : $MV}, +m: $MV, +hmi: {ST.pv(V, pl, 1n+j) == m : $MV}, +hm: {ST.some2(V, m) == True{} : Bool}, +he: $HE(1n+j, v), +hgd: $HG2(1n+j, v)) -> $PUTR(($SH, M.Search{1n+j, P.top(c), SP.dir(c)})):
  match m:
    case None{}:
      Empty.absurd($PUTR(($SH, M.Search{1n+j, P.top(c), SP.dir(c)})), L.false_true(hm))
    case Some{+vi}:
      %Equal.sym($MV, $FIND, Some{vi}, Equal.trans($MV, $FIND, ST.pv(V, pl, 1n+j), Some{vi}, Equal.sym($MV, ST.pv(V, pl, 1n+j), $FIND, hfd), hmi)) : OK.MOK($AK, $RES, S.put_at($AK, l, $EST, k, v, _), MI.put_found($AK, k, v, ($SH, M.Search{1n+j, P.top(c), SP.dir(c)})))
      %Equal.sym($ES, S.set_val($AK, k, v, $EST), $ENTSP($IDS(tg), PR.ex_pl(V, pl, 1n+j, Some{v})), Equal.sym($ES, $ENTSP($IDS(tg), PR.ex_pl(V, pl, 1n+j, Some{v})), S.set_val($AK, k, v, $EST), he)) : OK.MOK($AK, $RES, (S.TM{l, _}, Done{Some{vi}}), MI.put_found($AK, k, v, ($SH, M.Search{1n+j, P.top(c), SP.dir(c)})))
      ($SH2(1n+j, v), (Done{Some{vi}}, (L.subst($MV, z => {MI.rp($AK, $RES, ($SH2(1n+j, v), Done{z})) == (ST.real($AK, $SH2(1n+j, v)), Done{Some{vi}}) : M.TreeMap<K, V, cmp> & $RES}, Some{vi}, ST.pv(V, pl, 1n+j), Equal.sym($MV, ST.pv(V, pl, 1n+j), Some{vi}, hmi), {==}), ({==}, hgd))))

def put_hc($TO, $FT, +k: K, +v: V, +c: $CT, +j: Nat, +hfd: {ST.pv(V, pl, 1n+j) == $FIND : $MV}, +hm: {ST.some2(V, ST.pv(V, pl, 1n+j)) == True{} : Bool}, hc: $HE(1n+j, v) & $HG2(1n+j, v)) -> $PUTR(($SH, M.Search{1n+j, P.top(c), SP.dir(c)})):
  match hc:
    case Tuple{he, hgd}:
      put_h($AO, $F, k, v, c, j, hfd, ST.pv(V, pl, 1n+j), {==}, hm, he, hgd)

def put_tn($TO, $FT, +hg: $GF, +k: K, +v: V, +c: $CT, +i: Nat, +a: ST.Tr, +b: ST.Tr, +hfd: {ST.pv(V, pl, i) == $FIND : $MV}, $TNH(i)) -> $PUTR(($SH, M.Search{i, P.top(c), SP.dir(c)})):
  match i:
    case 0n:
      Empty.absurd($PUTR(($SH, M.Search{0n, P.top(c), SP.dir(c)})), tn_zero($AO, $F, k, c, a, b, hr))
    case 1n+j:
      put_hc($AO, $F, k, v, c, j, hfd, tn_hm($AO, $F, c, 1n+j, a, b, hk), tn_core($AO, $F, hg, k, v, c, j, a, b, hk, hwh, hr, hfin))

def put_t($TO, $FT, +hg: $GF, +k: K, +v: V, +hk0: $OKS($T0), +c: $CT, +t: ST.Tr, +hfd: $HFD, $PFX) -> $PUTR(($SH, M.Search{ST.rid(t), P.top(c), SP.dir(c)})):
  match t:
    case ST.TE{}:
      put_te($AO, $F, hg, k, v, c, ST.TE{}, {==}, $PFA)
    case ST.TN{+i, +a, +b}:
      put_tn($AO, $F, hg, k, v, c, i, a, b, hfd, L.subst($LN, z => $OKS(z), $T0, $WH(ST.TN{i, a, b}), hwh, hk0), hwh, hr, hfin)

%use WRAP(<|$TO|>, <|$AO|>, put, <|+k: K, +v: V|>, <|k, v|>, $RES, $SPEC, MI.put($AK, $SH, k, v), $PUTR)

# ---- put_if_absent: a found key is left, an absent one put ----

%def ABS S.put_if_absent($AK, ST.model($AK, $SH), k, v)
%def ABSR(r) OK.MOK($AK, $RES, $ABS, MI.put_absent_found($AK, k, v, r))
%def ALLOC MI.put_allocated($AK, P.top(c), SP.dir(c), MI.allocate($AK, $SH, P.top(c), k, v))

def absent_h($TO, $FT, +hg: $GF, +k: K, +v: V, +c: $CT, +j: Nat, +hfd: {ST.pv(V, pl, 1n+j) == $FIND : $MV}, +m: $MV, +hmi: {ST.pv(V, pl, 1n+j) == m : $MV}, +hm: {ST.some2(V, m) == True{} : Bool}) -> $ABSR(($SH, M.Search{1n+j, P.top(c), SP.dir(c)})):
  match m:
    case None{}:
      Empty.absurd($ABSR(($SH, M.Search{1n+j, P.top(c), SP.dir(c)})), L.false_true(hm))
    case Some{+vi}:
      %Equal.sym($MV, $FIND, Some{vi}, Equal.trans($MV, $FIND, ST.pv(V, pl, 1n+j), Some{vi}, Equal.sym($MV, ST.pv(V, pl, 1n+j), $FIND, hfd), hmi)) : OK.MOK($AK, $RES, S.absent_at($AK, l, $EST, k, v, _), MI.put_absent_found($AK, k, v, ($SH, M.Search{1n+j, P.top(c), SP.dir(c)})))
      ($SH, (Done{Some{vi}}, (L.subst($MV, z => {MI.rp($AK, $RES, ($SH, Done{z})) == (ST.real($AK, $SH), Done{Some{vi}}) : M.TreeMap<K, V, cmp> & $RES}, Some{vi}, ST.pv(V, pl, 1n+j), Equal.sym($MV, ST.pv(V, pl, 1n+j), Some{vi}, hmi), {==}), ({==}, hg))))

def absent_t($TO, $FT, +hg: $GF, +k: K, +v: V, +hk0: $OKS($T0), +c: $CT, +t: ST.Tr, +hfd: $HFD, $PFX) -> $ABSR(($SH, M.Search{ST.rid(t), P.top(c), SP.dir(c)})):
  match t:
    case ST.TE{}:
      %Equal.sym($MV, $FIND, None{}, Equal.sym($MV, None{}, $FIND, hfd)) : OK.MOK($AK, $RES, S.absent_at($AK, l, $EST, k, v, _), $ALLOC)
      L.subst($MV, z => OK.MOK($AK, $RES, S.put_at($AK, l, $EST, k, v, z), $ALLOC), $FIND, None{}, Equal.sym($MV, None{}, $FIND, hfd), put_te($AO, $F, hg, k, v, c, ST.TE{}, {==}, $PFA))
    case ST.TN{+i, +a, +b}:
      match i:
        case 0n:
          Empty.absurd($ABSR(($SH, M.Search{0n, P.top(c), SP.dir(c)})), tn_zero($AO, $F, k, c, a, b, hr))
        case 1n+j:
          absent_h($AO, $F, hg, k, v, c, j, hfd, ST.pv(V, pl, 1n+j), {==}, tn_hm($AO, $F, c, 1n+j, a, b, L.subst($LN, z => $OKS(z), $T0, $WH(ST.TN{1n+j, a, b}), hwh, hk0)))

%use WRAP(<|$TO|>, <|$AO|>, absent, <|+k: K, +v: V|>, <|k, v|>, $RES, $ABS, MI.put_if_absent($AK, $SH, k, v), $ABSR)

# ---- replace: a found key's value exchanged, an absent key left ----

%def RPL S.replace($AK, ST.model($AK, $SH), k, v)
%def RPLR(r) OK.MOK($AK, $MV, $RPL, MI.replace_found($AK, v, r))

def replace_h($TO, $FT, +k: K, +v: V, +c: $CT, +j: Nat, +hfd: {ST.pv(V, pl, 1n+j) == $FIND : $MV}, +m: $MV, +hmi: {ST.pv(V, pl, 1n+j) == m : $MV}, +hm: {ST.some2(V, m) == True{} : Bool}, +he: $HE(1n+j, v), +hgd: $HG2(1n+j, v)) -> $RPLR(($SH, M.Search{1n+j, P.top(c), SP.dir(c)})):
  match m:
    case None{}:
      Empty.absurd($RPLR(($SH, M.Search{1n+j, P.top(c), SP.dir(c)})), L.false_true(hm))
    case Some{+vi}:
      %Equal.sym($MV, $FIND, Some{vi}, Equal.trans($MV, $FIND, ST.pv(V, pl, 1n+j), Some{vi}, Equal.sym($MV, ST.pv(V, pl, 1n+j), $FIND, hfd), hmi)) : OK.MOK($AK, $MV, S.replace_at($AK, l, $EST, k, v, _), MI.replace_found($AK, v, ($SH, M.Search{1n+j, P.top(c), SP.dir(c)})))
      %Equal.sym($ES, S.set_val($AK, k, v, $EST), $ENTSP($IDS(tg), PR.ex_pl(V, pl, 1n+j, Some{v})), Equal.sym($ES, $ENTSP($IDS(tg), PR.ex_pl(V, pl, 1n+j, Some{v})), S.set_val($AK, k, v, $EST), he)) : OK.MOK($AK, $MV, (S.TM{l, _}, Some{vi}), MI.replace_found($AK, v, ($SH, M.Search{1n+j, P.top(c), SP.dir(c)})))
      ($SH2(1n+j, v), (Some{vi}, (L.subst($MV, z => {MI.rp($AK, $MV, ($SH2(1n+j, v), z)) == (ST.real($AK, $SH2(1n+j, v)), Some{vi}) : M.TreeMap<K, V, cmp> & $MV}, Some{vi}, ST.pv(V, pl, 1n+j), Equal.sym($MV, ST.pv(V, pl, 1n+j), Some{vi}, hmi), {==}), ({==}, hgd))))

def replace_hc($TO, $FT, +k: K, +v: V, +c: $CT, +j: Nat, +hfd: {ST.pv(V, pl, 1n+j) == $FIND : $MV}, +hm: {ST.some2(V, ST.pv(V, pl, 1n+j)) == True{} : Bool}, hc: $HE(1n+j, v) & $HG2(1n+j, v)) -> $RPLR(($SH, M.Search{1n+j, P.top(c), SP.dir(c)})):
  match hc:
    case Tuple{he, hgd}:
      replace_h($AO, $F, k, v, c, j, hfd, ST.pv(V, pl, 1n+j), {==}, hm, he, hgd)

def replace_t($TO, $FT, +hg: $GF, +k: K, +v: V, +hk0: $OKS($T0), +c: $CT, +t: ST.Tr, +hfd: $HFD, $PFX) -> $RPLR(($SH, M.Search{ST.rid(t), P.top(c), SP.dir(c)})):
  match t:
    case ST.TE{}:
      %Equal.sym($MV, $FIND, None{}, Equal.sym($MV, None{}, $FIND, hfd)) : OK.MOK($AK, $MV, S.replace_at($AK, l, $EST, k, v, _), ($SH, None{}))
      ($SH, (None{}, ({==}, ({==}, hg))))
    case ST.TN{+i, +a, +b}:
      match i:
        case 0n:
          Empty.absurd($RPLR(($SH, M.Search{0n, P.top(c), SP.dir(c)})), tn_zero($AO, $F, k, c, a, b, hr))
        case 1n+j:
          +hk = L.subst($LN, z => $OKS(z), $T0, $WH(ST.TN{1n+j, a, b}), hwh, hk0)
          replace_hc($AO, $F, k, v, c, j, hfd, tn_hm($AO, $F, c, 1n+j, a, b, hk), tn_core($AO, $F, hg, k, v, c, j, a, b, hk, hwh, hr, hfin))

%use WRAP(<|$TO|>, <|$AO|>, replace, <|+k: K, +v: V|>, <|k, v|>, $MV, $RPL, MI.replace($AK, $SH, k, v), $RPLR)

# ---- replace_if_equal: exchanged when the found value equals expected ----

%def RIE S.replace_if_equal($AK, ~eq, ST.model($AK, $SH), k, e, w)
%def RIER(r) OK.MOK($AK, Bool, $RIE, MI.replace_if_found($AK, ~eq, e, w, r))
%def EQX +k: K, +e: V, +w: V
%def TOE ~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, ~o: O.Order(~K, ~cmp), ~eq: V -> V -> Bool
%def AOE ~K, ~V, ~cmp, ~o, ~eq

def rie_b($TOE, $FT, +hg: $GF, $EQX, +c: $CT, +j: Nat, +vi: V, +hmi: {ST.pv(V, pl, 1n+j) == Some{vi} : $MV}, +he: $HE(1n+j, w), +hgd: $HG2(1n+j, w), +bq: Bool) -> OK.MOK($AK, Bool, S.pick(S.Model<K, V> & Bool, bq, (S.TM{l, S.set_val($AK, k, w, $EST)}, True{}), (S.TM{l, $EST}, False{})), MI.replace_if_apply($AK, $SH, 1n+j, w, bq)):
  match bq:
    case True{}:
      %Equal.sym($ES, S.set_val($AK, k, w, $EST), $ENTSP($IDS(tg), PR.ex_pl(V, pl, 1n+j, Some{w})), Equal.sym($ES, $ENTSP($IDS(tg), PR.ex_pl(V, pl, 1n+j, Some{w})), S.set_val($AK, k, w, $EST), he)) : OK.MOK($AK, Bool, (S.TM{l, _}, True{}), MI.replace_if_apply($AK, $SH, 1n+j, w, True{}))
      ($SH2(1n+j, w), (True{}, (L.subst($MV, z => {MI.rp($AK, Bool, MI.changed_value($AK, ($SH2(1n+j, w), z))) == (ST.real($AK, $SH2(1n+j, w)), True{}) : M.TreeMap<K, V, cmp> & Bool}, Some{vi}, ST.pv(V, pl, 1n+j), Equal.sym($MV, ST.pv(V, pl, 1n+j), Some{vi}, hmi), {==}), ({==}, hgd))))
    case False{}:
      ($SH, (False{}, ({==}, ({==}, hg))))

def rie_h($TOE, $FT, +hg: $GF, $EQX, +c: $CT, +j: Nat, +hfd: {ST.pv(V, pl, 1n+j) == $FIND : $MV}, +m: $MV, +hmi: {ST.pv(V, pl, 1n+j) == m : $MV}, +hm: {ST.some2(V, m) == True{} : Bool}, +he: $HE(1n+j, w), +hgd: $HG2(1n+j, w)) -> $RIER(($SH, M.Search{1n+j, P.top(c), SP.dir(c)})):
  match m:
    case None{}:
      Empty.absurd($RIER(($SH, M.Search{1n+j, P.top(c), SP.dir(c)})), L.false_true(hm))
    case Some{+vi}:
      %Equal.sym($MV, $FIND, Some{vi}, Equal.trans($MV, $FIND, ST.pv(V, pl, 1n+j), Some{vi}, Equal.sym($MV, ST.pv(V, pl, 1n+j), $FIND, hfd), hmi)) : OK.MOK($AK, Bool, S.replace_if_at($AK, ~eq, l, $EST, k, e, w, _), MI.replace_if_found($AK, ~eq, e, w, ($SH, M.Search{1n+j, P.top(c), SP.dir(c)})))
      %Equal.sym($MV, ST.pv(V, pl, 1n+j), Some{vi}, hmi) : OK.MOK($AK, Bool, S.replace_if_at($AK, ~eq, l, $EST, k, e, w, Some{vi}), MI.replace_if_value($AK, ~eq, 1n+j, e, w, ($SH, _)))
      rie_b($AOE, $F, hg, k, e, w, c, j, vi, hmi, he, hgd, eq(vi, e))

def rie_hc($TOE, $FT, +hg: $GF, $EQX, +c: $CT, +j: Nat, +hfd: {ST.pv(V, pl, 1n+j) == $FIND : $MV}, +hm: {ST.some2(V, ST.pv(V, pl, 1n+j)) == True{} : Bool}, hc: $HE(1n+j, w) & $HG2(1n+j, w)) -> $RIER(($SH, M.Search{1n+j, P.top(c), SP.dir(c)})):
  match hc:
    case Tuple{he, hgd}:
      rie_h($AOE, $F, hg, k, e, w, c, j, hfd, ST.pv(V, pl, 1n+j), {==}, hm, he, hgd)

def rie_t($TOE, $FT, +hg: $GF, $EQX, +hk0: $OKS($T0), +c: $CT, +t: ST.Tr, +hfd: $HFD, $PFX) -> $RIER(($SH, M.Search{ST.rid(t), P.top(c), SP.dir(c)})):
  match t:
    case ST.TE{}:
      %Equal.sym($MV, $FIND, None{}, Equal.sym($MV, None{}, $FIND, hfd)) : OK.MOK($AK, Bool, S.replace_if_at($AK, ~eq, l, $EST, k, e, w, _), ($SH, False{}))
      ($SH, (False{}, ({==}, ({==}, hg))))
    case ST.TN{+i, +a, +b}:
      match i:
        case 0n:
          Empty.absurd($RIER(($SH, M.Search{0n, P.top(c), SP.dir(c)})), tn_zero($AO, $F, k, c, a, b, hr))
        case 1n+j:
          +hk = L.subst($LN, z => $OKS(z), $T0, $WH(ST.TN{1n+j, a, b}), hwh, hk0)
          rie_hc($AOE, $F, hg, k, e, w, c, j, hfd, tn_hm($AO, $F, c, 1n+j, a, b, hk), tn_core($AO, $F, hg, k, w, c, j, a, b, hk, hwh, hr, hfin))

%use WRAP(<|$TOE|>, <|$AOE|>, rie, <|$EQX|>, <|k, e, w|>, Bool, $RIE, MI.replace_if_equal($AK, ~eq, $SH, k, e, w), $RIER)
