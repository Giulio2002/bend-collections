import Base
import ../../lib/logic.bend as L
import ../../lib/list.bend as LL
import ../../lib/order.bend as O
import ../../../spec/lib/common.bend as SC
import ../../../spec/containers/balanced_search_tree/main.bend as S
import ../../../src/containers/balanced_search_tree.bend as M
import ./state.bend as ST
import ./mirror.bend as MI
import ./ok.bend as OK
import ./find.bend as FI
import ./ends.bend as EN
import ./path.bend as P
import ./plug.bend as PG
import ./ord.bend as OR
import ./slot.bend as SL
import ./prim.bend as PR
import ./tree.bend as TR
import ../../lib/nat.bend as N
import ./succ.bend as SU
import ./rmv.bend as RV
import ./mokx.bend as MX
import ./dord.bend as DO
import ./slot.bend as SL

# The polls: the first (last) id of the header is the leftmost (rightmost)
# node, reached from the root by a path of left (right) turns; it is removed
# as remove removes it, with its own key, and its entry is the answer: the
# specification's poll. (source: tools/generators/tm_hand/rmp.src)

%include putm.src
%def ME Maybe<&2, M.Entry<K, V>>
%def U 1n+ui
%def TN(i, a, b) ST.TN{i, a, b}
%def TEE ST.TE{}
%def W2(cc, t) $APP(P.before(cc), $APP($IDS(t), P.after(cc)))
%def P1 PR.ex_pl(V, pl, $U, None{})
%def SH1 ST.SH{n, root, lo, hi, free, l, d, nl, $P1, tg, fl}
%def RDT(x) MI.unlink_target($AK, MI.delete_target($AK, $U, ($SH1, x)))
%def NU M.N{c0, x1, x2, x3, kU}
%def EU M.Entry{kU, vU}
%def MOD S.Model<K, V>
%def OKT EN.oks_tree(~K, ~V, nl, pl, tg, 0n, ST.g_crep($AK, $F, hg), ST.g_cpay($AK, $F, hg))
%def FINK(z) L.subst($ND, z => {S.is_eq(TR.kc(~K, ~cmp, kU, z)) == True{} : Bool}, $NU, ST.nd(K, nl, $U), Equal.sym($ND, ST.nd(K, nl, $U), $NU, hy), L.subst(Cmp, w => {S.is_eq(w) == True{} : Bool}, EQ{}, cmp(kU, kU), Equal.sym(Cmp, cmp(kU, kU), EQ{}, O.refl(~K, ~cmp, ~o, kU)), {==}))
%def DLK S.del($AK, kU, $EST)
%def REMK(sp) L.subst($MOD & $ME, z => OK.MOK($AK, $ME, z, MI.entry_value($AK, Some{kU}, ($RDT($NU), Some{vU}))), ($MOK0), sp
%def EVM(a0, b0) MX.ev_mok($AK, S.TM{l, $DLK}, $RDT($NU), kU, vU, L.subst($MV, z => OK.MOK($AK, $MV, (S.TM{l, $DLK}, z), ($RDT($NU), z)), ST.pv(V, pl, $U), Some{vU}, hmi, RV.rm_x(~K, ~V, ~cmp, ~o, $F, hg, kU, cs, ui, a0, b0, hbc, hplug, hlr, hlc, $FINK(z), $NU, hy)))

# ---- poll_first ----

%def RR $APP($IDS(sb), P.after(cs))
%def TSF $TN($U, $TEE, sb)
%def PFS S.poll_first_entry(K, V, ST.model($AK, $SH))
%def FH +cs: $CT, +ui: Nat, +sb: ST.Tr, +hlw: {$W2(cs, $TSF) == $W2(Nil{}, tg) : $LN}, +hlp: {PG.plug(cs, $TSF) == tg : ST.Tr}, +hlb: {P.before(cs) == Nil{} : $LN}, +hlr: {ST.rep(~K, $TSF, P.top(cs), nl) == True{} : Bool}, +hlc: {P.ctxok(~K, cs, $U, nl) == True{} : Bool}
%def FHA cs, ui, sb, hlw, hlp, hlb, hlr, hlc
%def HBCF Equal.trans($LN, $IDS(tg), $APP($IDS(tg), Nil{}), $W2(cs, $TSF), Equal.sym($LN, $APP($IDS(tg), Nil{}), $IDS(tg), LL.append_nil(Nat, $IDS(tg))), Equal.sym($LN, $W2(cs, $TSF), $W2(Nil{}, tg), hlw))
%def EIDF L.subst($LN, z => {$IDS(tg) == $APP(z, Con{$U, $RR}) : $LN}, P.before(cs), Nil{}, hlb, $HBCF)

# the entries: the node's first
def pf_est($TO, $FT, $FH, +c0: Bool, +x1: Nat, +x2: Nat, +x3: Nat, +kU: K, +vU: V, +hy: {ST.nd(K, nl, $U) == $NU : $ND}, +hmi: {ST.pv(V, pl, $U) == Some{vU} : $MV}) -> {$EST == Con{$EU, $ENTS($RR)} : $ES}:
  +e2 = L.subst($MV, z => {$ENTS(Con{$U, $RR}) == ST.cons_m(M.Entry<K, V>, ST.ent(K, V, $NU, z), $ENTS($RR)) : $ES}, ST.pv(V, pl, $U), Some{vU}, hmi, L.subst($ND, z => {$ENTS(Con{$U, $RR}) == ST.cons_m(M.Entry<K, V>, ST.ent(K, V, z, ST.pv(V, pl, $U)), $ENTS($RR)) : $ES}, ST.nd(K, nl, $U), $NU, hy, {==}))
  Equal.trans($ES, $EST, $ENTS(Con{$U, $RR}), Con{$EU, $ENTS($RR)}, L.subst($LN, z => {$EST == $ENTS(z) : $ES}, $IDS(tg), Con{$U, $RR}, $EIDF, {==}), e2)

# the specification's poll: the first entry, the rest
def pf_sp($TO, $FT, $FH, +c0: Bool, +x1: Nat, +x2: Nat, +x3: Nat, +kU: K, +vU: V, +hy: {ST.nd(K, nl, $U) == $NU : $ND}, +hmi: {ST.pv(V, pl, $U) == Some{vU} : $MV}) -> {(S.TM{l, $DLK}, Some{$EU}) == $PFS : $MOD & $ME}:
  %Equal.sym($ES, $EST, Con{$EU, $ENTS($RR)}, pf_est($AO, $F, $FHA, c0, x1, x2, x3, kU, vU, hy, hmi)) : {(S.TM{l, S.del($AK, kU, _)}, Some{$EU}) == S.poll_first_entry(K, V, S.TM{l, _}) : $MOD & $ME}
  %Equal.sym(Cmp, cmp(kU, kU), EQ{}, O.refl(~K, ~cmp, ~o, kU)) : {(S.TM{l, S.pick($ES, S.is_eq(_), $ENTS($RR), Con{$EU, S.del($AK, kU, $ENTS($RR))})}, Some{$EU}) == (S.TM{l, $ENTS($RR)}, Some{$EU}) : $MOD & $ME}
  {==}

%def RFG(x, m) OK.MOK($AK, $ME, $PFS, MI.entry_value($AK, M.node_key(~K, x), ($RDT(x), m)))

def pf_r($TO, $FT, +hg: $GF, $FH, +c0: Bool, +x1: Nat, +x2: Nat, +x3: Nat, +kU: K, +hy: {ST.nd(K, nl, $U) == $NU : $ND}, +m: $MV, +hmi: {ST.pv(V, pl, $U) == m : $MV}, +hs: {S.is_some(M.Entry<K, V>, ST.ent(K, V, $NU, m)) == True{} : Bool}) -> $RFG($NU, m):
  match m:
    case None{}:
      Empty.absurd($RFG($NU, None{}), L.false_true(hs))
    case Some{+vU}:
      +hbc = $HBCF
      +hplug = Equal.sym(ST.Tr, PG.plug(cs, $TSF), tg, hlp)
      L.subst($MOD & $ME, z => OK.MOK($AK, $ME, z, MI.entry_value($AK, Some{kU}, ($RDT($NU), Some{vU}))), (S.TM{l, $DLK}, Some{$EU}), $PFS, pf_sp($AO, $F, $FHA, c0, x1, x2, x3, kU, vU, hy, hmi), $EVM($TEE, sb))

def pf_q($TO, $FT, +hg: $GF, $FH, +y: $ND, +hy: {ST.nd(K, nl, $U) == y : $ND}) -> $RFG(y, ST.pv(V, pl, $U)):
  match y:
    case M.Free{f}:
      Empty.absurd($RFG(M.Free{f}, ST.pv(V, pl, $U)), L.false_true(L.subst($ND, z => {ST.is_node(K, z, 0n, ST.rid(sb), P.top(cs)) == True{} : Bool}, ST.nd(K, nl, $U), M.Free{f}, hy, TR.rep_node(~K, $U, $TEE, sb, P.top(cs), nl, hlr))))
    case M.N{+c0, +x1, +x2, +x3, +kU}:
      +hk = L.subst($LN, z => {EN.oks(~K, ~V, z, nl, pl) == True{} : Bool}, $IDS(tg), Con{$U, $RR}, $EIDF, $OKT)
      +hs0 = L.and_left(S.is_some(M.Entry<K, V>, ST.ent(K, V, ST.nd(K, nl, $U), ST.pv(V, pl, $U))), EN.oks(~K, ~V, $RR, nl, pl), hk)
      pf_r($AO, $F, hg, $FHA, c0, x1, x2, x3, kU, hy, ST.pv(V, pl, $U), {==}, L.subst($ND, z => {S.is_some(M.Entry<K, V>, ST.ent(K, V, z, ST.pv(V, pl, $U))) == True{} : Bool}, ST.nd(K, nl, $U), $NU, hy, hs0))

%def PFG(x) OK.MOK($AK, $ME, $PFS, MI.remove_entry_id($AK, $SH, x))
%def LMF(s) {$W2(cs, $TN(s, $TEE, sb)) == $W2(Nil{}, tg) : $LN}
%def LRF(s) {PG.plug(cs, $TN(s, $TEE, sb)) == tg : ST.Tr} & ({P.before(cs) == Nil{} : $LN} & ({ST.rep(~K, $TN(s, $TEE, sb), P.top(cs), nl) == True{} : Bool} & {P.ctxok(~K, cs, s, nl) == True{} : Bool}))
%def LR2(s) {ST.rep(~K, $TN(s, $TEE, sb), P.top(cs), nl) == True{} : Bool} & {P.ctxok(~K, cs, s, nl) == True{} : Bool}

def pf_o($TO, $FT, +hg: $GF, +cs: $CT, +s: Nat, +sb: ST.Tr, +hlw: $LMF(s), +hs0: {s == ST.fst0($IDS(tg)) : Nat}, +hlp: {PG.plug(cs, $TN(s, $TEE, sb)) == tg : ST.Tr}, +hlb: {P.before(cs) == Nil{} : $LN}, +hlr: {ST.rep(~K, $TN(s, $TEE, sb), P.top(cs), nl) == True{} : Bool}, +hlc: {P.ctxok(~K, cs, s, nl) == True{} : Bool}) -> $PFG(ST.fst0($IDS(tg))):
  match s:
    case 0n:
      Empty.absurd($PFG(ST.fst0($IDS(tg))), L.false_true(L.and_left(Nat.is_lt(0n, 0n), Bool.and(ST.is_node(K, ST.nd(K, nl, 0n), 0n, ST.rid(sb), P.top(cs)), Bool.and(True{}, ST.rep(~K, sb, 0n, nl))), hlr)))
    case 1n+ui:
      %Equal.sym(Nat, ST.fst0($IDS(tg)), $U, Equal.sym(Nat, $U, ST.fst0($IDS(tg)), hs0)) : $PFG(_)
      pf_q($AO, $F, hg, cs, ui, sb, hlw, hlp, hlb, hlr, hlc, ST.nd(K, nl, $U), {==})

def pf_n($TO, $FT, +hg: $GF, +cs: $CT, +s: Nat, +sb: ST.Tr, +hlw: $LMF(s), +hs0: {s == ST.fst0($IDS(tg)) : Nat}, +hlp: {PG.plug(cs, $TN(s, $TEE, sb)) == tg : ST.Tr}, +hlb: {P.before(cs) == Nil{} : $LN}, r2: $LR2(s)) -> $PFG(ST.fst0($IDS(tg))):
  match r2:
    case Tuple{hlr, hlc}:
      pf_o($AO, $F, hg, cs, s, sb, hlw, hs0, hlp, hlb, hlr, hlc)

def pf_mm($TO, $FT, +hg: $GF, +cs: $CT, +s: Nat, +sb: ST.Tr, +hlw: $LMF(s), +hs0: {s == ST.fst0($IDS(tg)) : Nat}, rest: $LRF(s)) -> $PFG(ST.fst0($IDS(tg))):
  match rest:
    case Tuple{hlp, Tuple{hlb, r2}}:
      pf_n($AO, $F, hg, cs, s, sb, hlw, hs0, hlp, hlb, r2)

%def LMTF Sigma<&1, &1, $CT, lc_ => Sigma<&1, &1, Nat, ls_ => Sigma<&1, &1, ST.Tr, lb_ => {$W2(lc_, $TN(ls_, $TEE, lb_)) == $W2(Nil{}, tg) : $LN} & ({ls_ == ST.fst0($IDS(tg)) : Nat} & ({PG.plug(lc_, $TN(ls_, $TEE, lb_)) == tg : ST.Tr} & ({P.before(lc_) == Nil{} : $LN} & ({ST.rep(~K, $TN(ls_, $TEE, lb_), P.top(lc_), nl) == True{} : Bool} & {P.ctxok(~K, lc_, ls_, nl) == True{} : Bool}))))>>>

def pf_l($TO, $FT, +hg: $GF, lm: $LMTF) -> $PFG(ST.fst0($IDS(tg))):
  match lm:
    case Tuple{+cs, Tuple{+s, Tuple{+sb, Tuple{hlw, Tuple{hs0, rest}}}}}:
      pf_mm($AO, $F, hg, cs, s, sb, hlw, hs0, rest)

def pf_t($TO, $FT, +hg: $GF) -> $PFG(ST.fst0($IDS(tg))):
  match tg:
    case ST.TE{}:
      (ST.SH{n, root, lo, hi, free, l, d, nl, pl, ST.TE{}, fl}, (None{}, ({==}, ({==}, hg))))
    case ST.TN{+j, +a, +b}:
      pf_l($AO, n, root, lo, hi, free, l, d, nl, pl, ST.TN{j, a, b}, fl, hg, SU.lmost(~K, ~cmp, ~o, a, nl, Nil{}, j, b, ST.g_crep($AK, n, root, lo, hi, free, l, d, nl, pl, ST.TN{j, a, b}, fl, hg), {==}))

def pf_m($TO, $FT, +hg: $GF) -> OK.MOK($AK, $ME, $PFS, MI.poll_first_entry($AK, $SH)):
  %Equal.sym(Nat, lo, ST.fst0($IDS(tg)), N.eq_from_is_eq(lo, ST.fst0($IDS(tg)), ST.g_clo($AK, $F, hg))) : OK.MOK($AK, $ME, $PFS, MI.remove_entry_id($AK, $SH, _))
  pf_t($AO, $F, hg)

# ---- poll_last ----

%def TSL $TN($U, sa, $TEE)
%def XL $APP(P.before(cs), $IDS(sa))
%def EL SC.append(M.Entry<K, V>, $ENTS($XL), Con{$EU, Nil{}})
%def PLS S.poll_last_entry(K, V, ST.model($AK, $SH))
%def LH +cs: $CT, +ui: Nat, +sa: ST.Tr, +hlw: {$W2(cs, $TSL) == $W2(Nil{}, tg) : $LN}, +hlp: {PG.plug(cs, $TSL) == tg : ST.Tr}, +hla: {P.after(cs) == Nil{} : $LN}, +hlr: {ST.rep(~K, $TSL, P.top(cs), nl) == True{} : Bool}, +hlc: {P.ctxok(~K, cs, $U, nl) == True{} : Bool}
%def LHA cs, ui, sa, hlw, hlp, hla, hlr, hlc
%def HBCL Equal.trans($LN, $IDS(tg), $APP($IDS(tg), Nil{}), $W2(cs, $TSL), Equal.sym($LN, $APP($IDS(tg), Nil{}), $IDS(tg), LL.append_nil(Nat, $IDS(tg))), Equal.sym($LN, $W2(cs, $TSL), $W2(Nil{}, tg), hlw))
%def PBC P.before(cs)
%def TSLI $IDS($TSL)

def pl_eid($TO, $FT, $LH) -> {$IDS(tg) == $APP($XL, Con{$U, Nil{}}) : $LN}:
  +ea = L.subst($LN, z => {$W2(cs, $TSL) == $APP($PBC, $APP($TSLI, z)) : $LN}, P.after(cs), Nil{}, hla, {==})
  +eb = L.subst($LN, z => {$APP($PBC, $APP($TSLI, Nil{})) == $APP($PBC, z) : $LN}, $APP($TSLI, Nil{}), $TSLI, LL.append_nil(Nat, $TSLI), {==})
  +ec = Equal.sym($LN, $APP($XL, Con{$U, Nil{}}), $APP($PBC, $TSLI), LL.append_assoc(Nat, $PBC, $IDS(sa), Con{$U, Nil{}}))
  Equal.trans($LN, $IDS(tg), $W2(cs, $TSL), $APP($XL, Con{$U, Nil{}}), $HBCL, Equal.trans($LN, $W2(cs, $TSL), $APP($PBC, $APP($TSLI, Nil{})), $APP($XL, Con{$U, Nil{}}), ea, Equal.trans($LN, $APP($PBC, $APP($TSLI, Nil{})), $APP($PBC, $TSLI), $APP($XL, Con{$U, Nil{}}), eb, ec)))

# the entries: the node's last
def pl_est($TO, $FT, $LH, +c0: Bool, +x1: Nat, +x2: Nat, +x3: Nat, +kU: K, +vU: V, +hy: {ST.nd(K, nl, $U) == $NU : $ND}, +hmi: {ST.pv(V, pl, $U) == Some{vU} : $MV}) -> {$EST == $EL : $ES}:
  +e2 = L.subst($MV, z => {$ENTS(Con{$U, Nil{}}) == ST.cons_m(M.Entry<K, V>, ST.ent(K, V, $NU, z), Nil{}) : $ES}, ST.pv(V, pl, $U), Some{vU}, hmi, L.subst($ND, z => {$ENTS(Con{$U, Nil{}}) == ST.cons_m(M.Entry<K, V>, ST.ent(K, V, z, ST.pv(V, pl, $U)), Nil{}) : $ES}, ST.nd(K, nl, $U), $NU, hy, {==}))
  +e1 = L.subst($LN, z => {$EST == $ENTS(z) : $ES}, $IDS(tg), $APP($XL, Con{$U, Nil{}}), pl_eid($AO, $F, $LHA), {==})
  +e3 = FI.ents_app(~K, ~V, $XL, Con{$U, Nil{}}, nl, pl)
  +e4 = L.subst($ES, z => {SC.append(M.Entry<K, V>, $ENTS($XL), $ENTS(Con{$U, Nil{}})) == SC.append(M.Entry<K, V>, $ENTS($XL), z) : $ES}, $ENTS(Con{$U, Nil{}}), Con{$EU, Nil{}}, e2, {==})
  Equal.trans($ES, $EST, $ENTS($APP($XL, Con{$U, Nil{}})), $EL, e1, Equal.trans($ES, $ENTS($APP($XL, Con{$U, Nil{}})), SC.append(M.Entry<K, V>, $ENTS($XL), $ENTS(Con{$U, Nil{}})), $EL, e3, e4))

# the specification's poll: the last entry, the ones before
def pl_sp($TO, $FT, +hg: $GF, $LH, +c0: Bool, +x1: Nat, +x2: Nat, +x3: Nat, +kU: K, +vU: V, +hy: {ST.nd(K, nl, $U) == $NU : $ND}, +hmi: {ST.pv(V, pl, $U) == Some{vU} : $MV}) -> {(S.TM{l, $DLK}, Some{$EU}) == $PLS : $MOD & $ME}:
  +eE = pl_est($AO, $F, $LHA, c0, x1, x2, x3, kU, vU, hy, hmi)
  +hord = L.subst($ES, z => {ST.ordered($AK, z) == True{} : Bool}, $EST, $EL, eE, ST.g_cord($AK, $F, hg))
  +eL = Equal.trans($ES, S.del($AK, kU, $EL), SC.append(M.Entry<K, V>, $ENTS($XL), Nil{}), $ENTS($XL), DO.del_mid($AO, kU, $ENTS($XL), $EU, Nil{}, OR.ord_mid_l($AO, $ENTS($XL), $EU, Nil{}, hord), O.refl(~K, ~cmp, ~o, kU)), LL.append_nil(M.Entry<K, V>, $ENTS($XL)))
  +eI = L.subst($ES, z => {SC.init(M.Entry<K, V>, z) == $ENTS($XL) : $ES}, SC.snoc(M.Entry<K, V>, $ENTS($XL), $EU), $EL, LL.snoc_append(M.Entry<K, V>, $ENTS($XL), $EU), LL.init_snoc(M.Entry<K, V>, $ENTS($XL), $EU))
  +eLa = L.subst($ES, z => {SC.last(M.Entry<K, V>, z) == Some{$EU} : $ME}, SC.snoc(M.Entry<K, V>, $ENTS($XL), $EU), $EL, LL.snoc_append(M.Entry<K, V>, $ENTS($XL), $EU), LL.last_snoc(M.Entry<K, V>, $ENTS($XL), $EU))
  %Equal.sym($ES, $EST, $EL, eE) : {(S.TM{l, S.del($AK, kU, _)}, Some{$EU}) == S.poll_last_entry(K, V, S.TM{l, _}) : $MOD & $ME}
  %Equal.sym($ES, S.del($AK, kU, $EL), $ENTS($XL), eL) : {(S.TM{l, _}, Some{$EU}) == (S.TM{l, SC.init(M.Entry<K, V>, $EL)}, S.last(M.Entry<K, V>, $EL)) : $MOD & $ME}
  %Equal.sym($ES, SC.init(M.Entry<K, V>, $EL), $ENTS($XL), eI) : {(S.TM{l, $ENTS($XL)}, Some{$EU}) == (S.TM{l, _}, S.last(M.Entry<K, V>, $EL)) : $MOD & $ME}
  %Equal.sym($ME, S.last(M.Entry<K, V>, $EL), Some{$EU}, eLa) : {(S.TM{l, $ENTS($XL)}, Some{$EU}) == (S.TM{l, $ENTS($XL)}, _) : $MOD & $ME}
  {==}

%def RLG(x, m) OK.MOK($AK, $ME, $PLS, MI.entry_value($AK, M.node_key(~K, x), ($RDT(x), m)))

def pl_r($TO, $FT, +hg: $GF, $LH, +c0: Bool, +x1: Nat, +x2: Nat, +x3: Nat, +kU: K, +hy: {ST.nd(K, nl, $U) == $NU : $ND}, +m: $MV, +hmi: {ST.pv(V, pl, $U) == m : $MV}, +hs: {S.is_some(M.Entry<K, V>, ST.ent(K, V, $NU, m)) == True{} : Bool}) -> $RLG($NU, m):
  match m:
    case None{}:
      Empty.absurd($RLG($NU, None{}), L.false_true(hs))
    case Some{+vU}:
      +hbc = $HBCL
      +hplug = Equal.sym(ST.Tr, PG.plug(cs, $TSL), tg, hlp)
      L.subst($MOD & $ME, z => OK.MOK($AK, $ME, z, MI.entry_value($AK, Some{kU}, ($RDT($NU), Some{vU}))), (S.TM{l, $DLK}, Some{$EU}), $PLS, pl_sp($AO, $F, hg, $LHA, c0, x1, x2, x3, kU, vU, hy, hmi), $EVM(sa, $TEE))

def pl_q($TO, $FT, +hg: $GF, $LH, +y: $ND, +hy: {ST.nd(K, nl, $U) == y : $ND}) -> $RLG(y, ST.pv(V, pl, $U)):
  match y:
    case M.Free{f}:
      Empty.absurd($RLG(M.Free{f}, ST.pv(V, pl, $U)), L.false_true(L.subst($ND, z => {ST.is_node(K, z, ST.rid(sa), 0n, P.top(cs)) == True{} : Bool}, ST.nd(K, nl, $U), M.Free{f}, hy, TR.rep_node(~K, $U, sa, $TEE, P.top(cs), nl, hlr))))
    case M.N{+c0, +x1, +x2, +x3, +kU}:
      +hk = L.subst($LN, z => {EN.oks(~K, ~V, z, nl, pl) == True{} : Bool}, $IDS(tg), $APP($XL, Con{$U, Nil{}}), pl_eid($AO, $F, $LHA), $OKT)
      +hs0 = L.and_left(S.is_some(M.Entry<K, V>, ST.ent(K, V, ST.nd(K, nl, $U), ST.pv(V, pl, $U))), EN.oks(~K, ~V, Nil{}, nl, pl), SL.oks_split_r(~K, ~V, $XL, Con{$U, Nil{}}, nl, pl, hk))
      pl_r($AO, $F, hg, $LHA, c0, x1, x2, x3, kU, hy, ST.pv(V, pl, $U), {==}, L.subst($ND, z => {S.is_some(M.Entry<K, V>, ST.ent(K, V, z, ST.pv(V, pl, $U))) == True{} : Bool}, ST.nd(K, nl, $U), $NU, hy, hs0))

%def PLG(x) OK.MOK($AK, $ME, $PLS, MI.remove_entry_id($AK, $SH, x))
%def LML(s) {$W2(cs, $TN(s, sa, $TEE)) == $W2(Nil{}, tg) : $LN}
%def LRL(s) {PG.plug(cs, $TN(s, sa, $TEE)) == tg : ST.Tr} & ({P.after(cs) == Nil{} : $LN} & ({ST.rep(~K, $TN(s, sa, $TEE), P.top(cs), nl) == True{} : Bool} & {P.ctxok(~K, cs, s, nl) == True{} : Bool}))
%def LRL2(s) {ST.rep(~K, $TN(s, sa, $TEE), P.top(cs), nl) == True{} : Bool} & {P.ctxok(~K, cs, s, nl) == True{} : Bool}

def pl_o($TO, $FT, +hg: $GF, +cs: $CT, +s: Nat, +sa: ST.Tr, +hlw: $LML(s), +hs0: {s == ST.last0($IDS(tg)) : Nat}, +hlp: {PG.plug(cs, $TN(s, sa, $TEE)) == tg : ST.Tr}, +hla: {P.after(cs) == Nil{} : $LN}, +hlr: {ST.rep(~K, $TN(s, sa, $TEE), P.top(cs), nl) == True{} : Bool}, +hlc: {P.ctxok(~K, cs, s, nl) == True{} : Bool}) -> $PLG(ST.last0($IDS(tg))):
  match s:
    case 0n:
      Empty.absurd($PLG(ST.last0($IDS(tg))), L.false_true(L.and_left(Nat.is_lt(0n, 0n), Bool.and(ST.is_node(K, ST.nd(K, nl, 0n), ST.rid(sa), 0n, P.top(cs)), Bool.and(ST.rep(~K, sa, 0n, nl), True{})), hlr)))
    case 1n+ui:
      %Equal.sym(Nat, ST.last0($IDS(tg)), $U, Equal.sym(Nat, $U, ST.last0($IDS(tg)), hs0)) : $PLG(_)
      pl_q($AO, $F, hg, cs, ui, sa, hlw, hlp, hla, hlr, hlc, ST.nd(K, nl, $U), {==})

def pl_n($TO, $FT, +hg: $GF, +cs: $CT, +s: Nat, +sa: ST.Tr, +hlw: $LML(s), +hs0: {s == ST.last0($IDS(tg)) : Nat}, +hlp: {PG.plug(cs, $TN(s, sa, $TEE)) == tg : ST.Tr}, +hla: {P.after(cs) == Nil{} : $LN}, r2: $LRL2(s)) -> $PLG(ST.last0($IDS(tg))):
  match r2:
    case Tuple{hlr, hlc}:
      pl_o($AO, $F, hg, cs, s, sa, hlw, hs0, hlp, hla, hlr, hlc)

def pl_mm($TO, $FT, +hg: $GF, +cs: $CT, +s: Nat, +sa: ST.Tr, +hlw: $LML(s), +hs0: {s == ST.last0($IDS(tg)) : Nat}, rest: $LRL(s)) -> $PLG(ST.last0($IDS(tg))):
  match rest:
    case Tuple{hlp, Tuple{hla, r2}}:
      pl_n($AO, $F, hg, cs, s, sa, hlw, hs0, hlp, hla, r2)

%def RMTL Sigma<&1, &1, $CT, rc_ => Sigma<&1, &1, Nat, rs_ => Sigma<&1, &1, ST.Tr, ra_ => {$W2(rc_, $TN(rs_, ra_, $TEE)) == $W2(Nil{}, tg) : $LN} & ({rs_ == ST.last0($IDS(tg)) : Nat} & ({PG.plug(rc_, $TN(rs_, ra_, $TEE)) == tg : ST.Tr} & ({P.after(rc_) == Nil{} : $LN} & ({ST.rep(~K, $TN(rs_, ra_, $TEE), P.top(rc_), nl) == True{} : Bool} & {P.ctxok(~K, rc_, rs_, nl) == True{} : Bool}))))>>>

def pl_l($TO, $FT, +hg: $GF, lm: $RMTL) -> $PLG(ST.last0($IDS(tg))):
  match lm:
    case Tuple{+cs, Tuple{+s, Tuple{+sa, Tuple{hlw, Tuple{hs0, rest}}}}}:
      pl_mm($AO, $F, hg, cs, s, sa, hlw, hs0, rest)

def pl_t($TO, $FT, +hg: $GF) -> $PLG(ST.last0($IDS(tg))):
  match tg:
    case ST.TE{}:
      (ST.SH{n, root, lo, hi, free, l, d, nl, pl, ST.TE{}, fl}, (None{}, ({==}, ({==}, hg))))
    case ST.TN{+j, +a, +b}:
      pl_l($AO, n, root, lo, hi, free, l, d, nl, pl, ST.TN{j, a, b}, fl, hg, SU.rmost(~K, ~cmp, ~o, b, nl, Nil{}, j, a, ST.g_crep($AK, n, root, lo, hi, free, l, d, nl, pl, ST.TN{j, a, b}, fl, hg), {==}))

def pl_m($TO, $FT, +hg: $GF) -> OK.MOK($AK, $ME, $PLS, MI.poll_last_entry($AK, $SH)):
  %Equal.sym(Nat, hi, ST.last0($IDS(tg)), N.eq_from_is_eq(hi, ST.last0($IDS(tg)), ST.g_chi($AK, $F, hg))) : OK.MOK($AK, $ME, $PLS, MI.remove_entry_id($AK, $SH, _))
  pl_t($AO, $F, hg)
