import Base
import ../../lib/logic.bend as L
import ../../lib/nat.bend as N
import ../../lib/list.bend as LL
import ../../lib/spec_common.bend as SC
import ./state.bend as ST
import ./path.bend as P
import ./dj.bend as DJ
import ../../lib/nat_list.bend as NL

# Id lists under an insertion: bounds, lengths and repeats with a new id put
# between the ids before and after the gap, and a free id moved out of the
# free list. (source: tools/generators/tm_hand/alls.src)

%def LN List<&2, Nat>
%def APP(a, b) SC.append(Nat, a, b)
%def LEN(xs) SC.length(Nat, xs)
%def ALLIN(xs, n) {ST.allin(xs, n) == True{} : Bool}
%def NDL(xs) {NL.nodupn(xs) == True{} : Bool}
%def NMEM(y, xs) {NL.memn(y, xs) == False{} : Bool}
%def INB(x, n) Bool.and(Nat.is_lt(0n, x), Nat.is_le(x, n))

def allin_l(+a: $LN, +b: $LN, +n: Nat, +h: $ALLIN($APP(a, b), n)) -> $ALLIN(a, n):
  match a:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      L.and_intro($INB(x, n), ST.allin(t, n), L.and_left($INB(x, n), ST.allin($APP(t, b), n), h), allin_l(t, b, n, L.and_right($INB(x, n), ST.allin($APP(t, b), n), h)))

def allin_r(+a: $LN, +b: $LN, +n: Nat, +h: $ALLIN($APP(a, b), n)) -> $ALLIN(b, n):
  match a:
    case Nil{}:
      h
    case Con{+x, +t}:
      allin_r(t, b, n, L.and_right($INB(x, n), ST.allin($APP(t, b), n), h))

def allin_app(+a: $LN, +b: $LN, +n: Nat, +ha: $ALLIN(a, n), +hb: $ALLIN(b, n)) -> $ALLIN($APP(a, b), n):
  match a:
    case Nil{}:
      hb
    case Con{+x, +t}:
      L.and_intro($INB(x, n), ST.allin($APP(t, b), n), L.and_left($INB(x, n), ST.allin(t, n), ha), allin_app(t, b, n, L.and_right($INB(x, n), ST.allin(t, n), ha), hb))

def inb_up(+x: Nat, +n: Nat, +h: {$INB(x, n) == True{} : Bool}) -> {$INB(x, 1n+n) == True{} : Bool}:
  L.and_intro(Nat.is_lt(0n, x), Nat.is_le(x, 1n+n), L.and_left(Nat.is_lt(0n, x), Nat.is_le(x, n), h), N.le_trans(x, n, 1n+n, L.and_right(Nat.is_lt(0n, x), Nat.is_le(x, n), h), N.le_succ(n)))

def allin_up(+xs: $LN, +n: Nat, +h: $ALLIN(xs, n)) -> $ALLIN(xs, 1n+n):
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      L.and_intro($INB(x, 1n+n), ST.allin(t, 1n+n), inb_up(x, n, L.and_left($INB(x, n), ST.allin(t, n), h)), allin_up(t, n, L.and_right($INB(x, n), ST.allin(t, n), h)))

# an id past the bound is absent
def allin_out(+xs: $LN, +n: Nat, +h: $ALLIN(xs, n)) -> $NMEM(1n+n, xs):
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      +hx = L.and_right(Nat.is_lt(0n, x), Nat.is_le(x, n), L.and_left($INB(x, n), ST.allin(t, n), h))
      DJ.nm_cons(1n+n, x, t, N.is_eq_lt(x, 1n+n, N.le_lt_succ(x, n, hx)), allin_out(t, n, L.and_right($INB(x, n), ST.allin(t, n), h)))

def am_c(+x: Nat, +t: $LN, +n: Nat, +y: Nat, +h: $ALLIN(Con{x, t}, n), +hm: {NL.memn(y, Con{x, t}) == True{} : Bool}, +e: Bool, +he: {Nat.is_eq(x, y) == e : Bool}, ih: @+hmt: {NL.memn(y, t) == True{} : Bool} -> {$INB(y, n) == True{} : Bool}) -> {$INB(y, n) == True{} : Bool}:
  match e:
    case True{}:
      L.subst(Nat, z => {$INB(z, n) == True{} : Bool}, x, y, N.eq_from_is_eq(x, y, he), L.and_left($INB(x, n), ST.allin(t, n), h))
    case False{}:
      ih(L.subst(Bool, z => {Bool.or(z, NL.memn(y, t)) == True{} : Bool}, Nat.is_eq(x, y), False{}, he, hm))

# ---- the new id between before and after ----

def nd_put(+b: $LN, +x: Nat, +a: $LN, +h: $NDL($APP(b, a)), +hx: $NMEM(x, $APP(b, a))) -> $NDL($APP(b, Con{x, a})):
  L.subst(Bool, w => {w == True{} : Bool}, Bool.and(NL.nodupn($APP(b, a)), Bool.not(NL.memn(x, $APP(b, a)))), NL.nodupn($APP(b, Con{x, a})), Equal.sym(Bool, NL.nodupn($APP(b, Con{x, a})), Bool.and(NL.nodupn($APP(b, a)), Bool.not(NL.memn(x, $APP(b, a)))), NL.nd_mid(b, x, a)), L.and_intro(NL.nodupn($APP(b, a)), Bool.not(NL.memn(x, $APP(b, a))), h, L.subst(Bool, w => {Bool.not(w) == True{} : Bool}, False{}, NL.memn(x, $APP(b, a)), Equal.sym(Bool, NL.memn(x, $APP(b, a)), False{}, hx), {==})))

def len_put(+b: $LN, +x: Nat, +a: $LN) -> {$LEN($APP(b, Con{x, a})) == 1n+$LEN($APP(b, a)) : Nat}:
  P.cons_len(b, x, a)

# a member is within the bound
def allin_mem(+xs: $LN, +n: Nat, +y: Nat, +h: $ALLIN(xs, n), +hm: {NL.memn(y, xs) == True{} : Bool}) -> {$INB(y, n) == True{} : Bool}:
  match xs:
    case Nil{}:
      Empty.absurd({$INB(y, n) == True{} : Bool}, L.false_true(hm))
    case Con{+x, +t}:
      am_c(x, t, n, y, h, hm, Nat.is_eq(x, y), {==}, hmt => allin_mem(t, n, y, L.and_right($INB(x, n), ST.allin(t, n), h), hmt))


# ---- a free id moved between before and after ----

%def MV0 $APP($APP(b, a), Con{x, t})
%def MV1 $APP($APP(b, Con{x, a}), t)

def mv_eq(+b: $LN, +a: $LN, +x: Nat, +t: $LN) -> {$MV1 == $APP(b, Con{x, $APP(a, t)}) : $LN}:
  LL.append_assoc(Nat, b, Con{x, a}, t)

def nd_move(+b: $LN, +a: $LN, +x: Nat, +t: $LN, +h: $NDL($MV0)) -> $NDL($MV1):
  +e0 = NL.nd_mid($APP(b, a), x, t)
  +h0 = L.subst(Bool, w => {w == True{} : Bool}, NL.nodupn($MV0), Bool.and(NL.nodupn($APP($APP(b, a), t)), Bool.not(NL.memn(x, $APP($APP(b, a), t)))), e0, h)
  +ea = LL.append_assoc(Nat, b, a, t)
  +h1 = L.subst($LN, z => {Bool.and(NL.nodupn(z), Bool.not(NL.memn(x, z))) == True{} : Bool}, $APP($APP(b, a), t), $APP(b, $APP(a, t)), ea, h0)
  +h2 = L.subst(Bool, w => {w == True{} : Bool}, Bool.and(NL.nodupn($APP(b, $APP(a, t))), Bool.not(NL.memn(x, $APP(b, $APP(a, t))))), NL.nodupn($APP(b, Con{x, $APP(a, t)})), Equal.sym(Bool, NL.nodupn($APP(b, Con{x, $APP(a, t)})), Bool.and(NL.nodupn($APP(b, $APP(a, t))), Bool.not(NL.memn(x, $APP(b, $APP(a, t))))), NL.nd_mid(b, x, $APP(a, t))), h1)
  L.subst($LN, z => $NDL(z), $APP(b, Con{x, $APP(a, t)}), $MV1, Equal.sym($LN, $MV1, $APP(b, Con{x, $APP(a, t)}), mv_eq(b, a, x, t)), h2)

def len_move(+b: $LN, +a: $LN, +x: Nat, +t: $LN) -> {$LEN($MV1) == $LEN($MV0) : Nat}:
  +e1 = L.subst($LN, z => {$LEN($MV1) == $LEN(z) : Nat}, $MV1, $APP(b, Con{x, $APP(a, t)}), mv_eq(b, a, x, t), {==})
  +e2 = P.cons_len(b, x, $APP(a, t))
  +e3 = P.cons_len($APP(b, a), x, t)
  +e4 = L.subst($LN, z => {1n+$LEN($APP(b, $APP(a, t))) == 1n+$LEN(z) : Nat}, $APP(b, $APP(a, t)), $APP($APP(b, a), t), Equal.sym($LN, $APP($APP(b, a), t), $APP(b, $APP(a, t)), LL.append_assoc(Nat, b, a, t)), {==})
  Equal.trans(Nat, $LEN($MV1), $LEN($APP(b, Con{x, $APP(a, t)})), $LEN($MV0), e1, Equal.trans(Nat, $LEN($APP(b, Con{x, $APP(a, t)})), 1n+$LEN($APP(b, $APP(a, t))), $LEN($MV0), e2, Equal.trans(Nat, 1n+$LEN($APP(b, $APP(a, t))), 1n+$LEN($APP($APP(b, a), t)), $LEN($MV0), e4, Equal.sym(Nat, $LEN($MV0), 1n+$LEN($APP($APP(b, a), t)), e3))))

def allin_move(+b: $LN, +a: $LN, +x: Nat, +t: $LN, +n: Nat, +h: $ALLIN($MV0, n)) -> $ALLIN($MV1, n):
  +hba = allin_l($APP(b, a), Con{x, t}, n, h)
  +hxt = allin_r($APP(b, a), Con{x, t}, n, h)
  +hx = L.and_left($INB(x, n), ST.allin(t, n), hxt)
  +ht = L.and_right($INB(x, n), ST.allin(t, n), hxt)
  allin_app($APP(b, Con{x, a}), t, n, allin_app(b, Con{x, a}, n, allin_l(b, a, n, hba), L.and_intro($INB(x, n), ST.allin(a, n), hx, allin_r(b, a, n, hba))), ht)
