import Base
import ../../lib/logic.bend as L
import ../../lib/order.bend as O
import ../../lib/list.bend as LL
import ../../lib/spec_common.bend as SC
import ./spec.bend as S
import ../../../src/containers/balanced_search_tree.bend as M
import ./state.bend as ST
import ./ord.bend as OR
import ./find.bend as FI
import ./ends.bend as EN
import ./tree.bend as TR
import ./path.bend as P
import ./nav.bend as NV
import ./navl.bend as NL

# The ghost navigation answers the specification: along a path whose ids
# before the subtree have keys below k and after it above k, the entry at
# gnav's id is nav's (the first entry at or above k upward, the last at or
# below it downward). (source: tools/generators/tm_hand/navs.src)

%def ND M.Node<K>
%def E M.Entry<K, V>
%def ES List<&2, M.Entry<K, V>>
%def ME Maybe<&2, M.Entry<K, V>>
%def MV Maybe<&2, V>
%def NLT List<&2, $ND>
%def PLT List<&2, $MV>
%def LN List<&2, Nat>
%def APP(a, b) SC.append(Nat, a, b)
%def EAPP(a, b) SC.append($E, a, b)
%def IDS(t) ST.ids(t)
%def TN(i, a, b) ST.TN{i, a, b}
%def CT List<&2, P.Fr>
%def PK(fw, a, b) ST.pk(Nat, fw, a, b)
%def TO ~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, ~o: O.Order(~K, ~cmp)
%def TK ~K: Data, ~V: Data, ~cmp: K -> K -> Cmp
%def AK ~K, ~V, ~cmp
%def AO ~K, ~V, ~cmp, ~o
%def WH(c, t) $APP(P.before(c), $APP($IDS(t), P.after(c)))
%def CL(i, r, c) Con{P.FR{i, True{}, r}, c}
%def CR(i, l, c) Con{P.FR{i, False{}, l}, c}
%def ENT(x) ST.ent(K, V, ST.nd(K, nl, x), ST.pv(V, pl, x))
%def ENTS(xs) ST.ents(~K, ~V, xs, nl, pl)
%def ORD(x) {ST.ordered($AK, x) == True{} : Bool}
%def OKS(xs) {EN.oks(~K, ~V, xs, nl, pl) == True{} : Bool}
%def GTA(k, es) {OR.gtall($AK, k, es) == True{} : Bool}
%def LTA(k, es) {OR.ltall($AK, k, es) == True{} : Bool}
%def REP(t, p) {ST.rep(~K, t, p, nl) == True{} : Bool}
%def PAY(t) {ST.pay(~V, t, pl) == True{} : Bool}
%def GN(t, c) NV.gnav(~K, ~cmp, t, c, nl, k, h, incl)
%def NAV(xs) S.nav($AK, k, h, incl, $ENTS(xs))
%def GOAL(t, c) {$ENT($GN(t, c)) == $NAV($WH(c, t)) : $ME}

def oks_l(~K: Data, ~V: Data, +nl: $NLT, +pl: $PLT, +xs: $LN, +ys: $LN, +h: $OKS($APP(xs, ys))) -> $OKS(xs):
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      L.and_intro(S.is_some($E, $ENT(x)), EN.oks(~K, ~V, t, nl, pl), L.and_left(S.is_some($E, $ENT(x)), EN.oks(~K, ~V, $APP(t, ys), nl, pl), h), oks_l(~K, ~V, nl, pl, t, ys, L.and_right(S.is_some($E, $ENT(x)), EN.oks(~K, ~V, $APP(t, ys), nl, pl), h)))

def oks_r(~K: Data, ~V: Data, +nl: $NLT, +pl: $PLT, +xs: $LN, +ys: $LN, +h: $OKS($APP(xs, ys))) -> $OKS(ys):
  match xs:
    case Nil{}:
      h
    case Con{+x, +t}:
      oks_r(~K, ~V, nl, pl, t, ys, L.and_right(S.is_some($E, $ENT(x)), EN.oks(~K, ~V, $APP(t, ys), nl, pl), h))

# ---- at the end of the path ----

def nav_te($TO, +nl: $NLT, +pl: $PLT, +c: $CT, +k: K, +h: Bool, +incl: Bool, +hk: $OKS($WH(c, ST.TE{})), +hb: $LTA(k, $ENTS(P.before(c))), +ha: $GTA(k, $ENTS(P.after(c)))) -> $GOAL(ST.TE{}, c):
  match h:
    case True{}:
      %Equal.sym($ES, $ENTS($APP(P.before(c), P.after(c))), $EAPP($ENTS(P.before(c)), $ENTS(P.after(c))), FI.ents_app(~K, ~V, P.before(c), P.after(c), nl, pl)) : {$ENT(ST.fst0(P.after(c))) == S.first_where($AK, k, incl, _) : $ME}
      %Equal.sym($ME, S.first_where($AK, k, incl, $EAPP($ENTS(P.before(c)), $ENTS(P.after(c)))), OR.orm($E, S.first_where($AK, k, incl, $ENTS(P.before(c))), S.first_where($AK, k, incl, $ENTS(P.after(c)))), NL.fw_app($AK, k, incl, $ENTS(P.before(c)), $ENTS(P.after(c)))) : {$ENT(ST.fst0(P.after(c))) == _ : $ME}
      %Equal.sym($ME, S.first_where($AK, k, incl, $ENTS(P.before(c))), None{}, NL.fw_none($AO, k, incl, $ENTS(P.before(c)), hb)) : {$ENT(ST.fst0(P.after(c))) == OR.orm($E, _, S.first_where($AK, k, incl, $ENTS(P.after(c)))) : $ME}
      %Equal.sym($ME, S.first_where($AK, k, incl, $ENTS(P.after(c))), S.head($E, $ENTS(P.after(c))), NL.fw_head($AK, k, incl, $ENTS(P.after(c)), ha)) : {$ENT(ST.fst0(P.after(c))) == _ : $ME}
      Equal.sym($ME, S.head($E, $ENTS(P.after(c))), $ENT(ST.fst0(P.after(c))), EN.head_ents(~K, ~V, nl, pl, P.after(c), oks_r(~K, ~V, nl, pl, P.before(c), P.after(c), hk)))
    case False{}:
      %Equal.sym($ES, $ENTS($APP(P.before(c), P.after(c))), $EAPP($ENTS(P.before(c)), $ENTS(P.after(c))), FI.ents_app(~K, ~V, P.before(c), P.after(c), nl, pl)) : {$ENT(ST.last0(P.before(c))) == S.last_where($AK, k, incl, _, None{}) : $ME}
      %Equal.sym($ME, S.last_where($AK, k, incl, $EAPP($ENTS(P.before(c)), $ENTS(P.after(c))), None{}), S.last_where($AK, k, incl, $ENTS(P.after(c)), S.last_where($AK, k, incl, $ENTS(P.before(c)), None{})), NL.lw_app($AK, k, incl, $ENTS(P.before(c)), $ENTS(P.after(c)), None{})) : {$ENT(ST.last0(P.before(c))) == _ : $ME}
      %Equal.sym($ME, S.last_where($AK, k, incl, $ENTS(P.before(c)), None{}), OR.orm($E, S.last($E, $ENTS(P.before(c))), None{}), NL.lw_all($AK, k, incl, $ENTS(P.before(c)), None{}, hb)) : {$ENT(ST.last0(P.before(c))) == S.last_where($AK, k, incl, $ENTS(P.after(c)), _) : $ME}
      %Equal.sym($ME, OR.orm($E, S.last($E, $ENTS(P.before(c))), None{}), S.last($E, $ENTS(P.before(c))), OR.orm_none($E, S.last($E, $ENTS(P.before(c))))) : {$ENT(ST.last0(P.before(c))) == S.last_where($AK, k, incl, $ENTS(P.after(c)), _) : $ME}
      %Equal.sym($ME, S.last_where($AK, k, incl, $ENTS(P.after(c)), S.last($E, $ENTS(P.before(c)))), S.last($E, $ENTS(P.before(c))), NL.lw_none($AO, k, incl, $ENTS(P.after(c)), S.last($E, $ENTS(P.before(c))), ha)) : {$ENT(ST.last0(P.before(c))) == _ : $ME}
      Equal.sym($ME, S.last($E, $ENTS(P.before(c))), $ENT(ST.last0(P.before(c))), EN.last_ents_all(~K, ~V, nl, pl, P.before(c), oks_l(~K, ~V, nl, pl, P.before(c), P.after(c), hk)))

# ---- at a node ----

%def X $APP(P.before(c), $IDS(l))
%def Y $APP($IDS(r), P.after(c))
%def EX $ENTS($X)
%def EY $ENTS($Y)
%def EE M.Entry{key, v}
%def SPL $EAPP($EX, Con{$EE, $EY})
%def FWS(inc, es) S.first_where($AK, k, inc, es)
%def LWS(inc, es, b) S.last_where($AK, k, inc, es, b)
%def NODEH +nl: $NLT, +pl: $PLT, +c: $CT, +i: Nat, +l: ST.Tr, +r: ST.Tr, +k: K
%def NODEA nl, pl, c, i, l, r, k

def geq($TO, $NODEH, +h: Bool, +incl: Bool, +key: K, +v: V, +hE: {$ENT(i) == Some{$EE} : $ME}, +hc: {cmp(k, key) == EQ{} : Cmp}, +ho: $ORD($SPL), +hkx: $OKS($X), +hky: $OKS($Y)) -> {$ENT($PK(incl, i, $PK(h, ST.fst0($Y), ST.last0($X)))) == S.nav($AK, k, h, incl, $SPL) : $ME}:
  match h incl:
    case True{} True{}:
      +ek = O.antisym(~K, ~cmp, o, k, key, hc)
      +hl = L.subst(K, z => $LTA(z, $EX), key, k, Equal.sym(K, k, key, ek), OR.ord_mid_l($AO, $EX, $EE, $EY, ho))
      %Equal.sym($ME, $FWS(True{}, $SPL), OR.orm($E, $FWS(True{}, $EX), $FWS(True{}, Con{$EE, $EY})), NL.fw_app($AK, k, True{}, $EX, Con{$EE, $EY})) : {$ENT(i) == _ : $ME}
      %Equal.sym($ME, $FWS(True{}, $EX), None{}, NL.fw_none($AO, k, True{}, $EX, hl)) : {$ENT(i) == OR.orm($E, _, $FWS(True{}, Con{$EE, $EY})) : $ME}
      %Equal.sym(Cmp, cmp(k, key), EQ{}, hc) : {$ENT(i) == S.pick($ME, S.ordering_ok(_, True{}), Some{$EE}, $FWS(True{}, $EY)) : $ME}
      hE
    case False{} True{}:
      +ek = O.antisym(~K, ~cmp, o, k, key, hc)
      +hl = L.subst(K, z => $LTA(z, $EX), key, k, Equal.sym(K, k, key, ek), OR.ord_mid_l($AO, $EX, $EE, $EY, ho))
      +hg = L.subst(K, z => $GTA(z, $EY), key, k, Equal.sym(K, k, key, ek), OR.ord_mid_r($AO, $EX, $EE, $EY, ho))
      %Equal.sym($ME, $LWS(True{}, $SPL, None{}), $LWS(True{}, Con{$EE, $EY}, $LWS(True{}, $EX, None{})), NL.lw_app($AK, k, True{}, $EX, Con{$EE, $EY}, None{})) : {$ENT(i) == _ : $ME}
      %Equal.sym($ME, $LWS(True{}, $EX, None{}), OR.orm($E, S.last($E, $EX), None{}), NL.lw_all($AK, k, True{}, $EX, None{}, hl)) : {$ENT(i) == $LWS(True{}, Con{$EE, $EY}, _) : $ME}
      %Equal.sym(K, k, key, ek) : {$ENT(i) == $LWS(True{}, $EY, S.pick($ME, S.ordering_ok(cmp(key, _), True{}), Some{$EE}, OR.orm($E, S.last($E, $EX), None{}))) : $ME}
      %Equal.sym(Cmp, cmp(key, key), EQ{}, O.refl(~K, ~cmp, ~o, key)) : {$ENT(i) == $LWS(True{}, $EY, S.pick($ME, S.ordering_ok(_, True{}), Some{$EE}, OR.orm($E, S.last($E, $EX), None{}))) : $ME}
      %Equal.sym($ME, $LWS(True{}, $EY, Some{$EE}), Some{$EE}, NL.lw_none($AO, k, True{}, $EY, Some{$EE}, hg)) : {$ENT(i) == _ : $ME}
      hE
    case True{} False{}:
      +ek = O.antisym(~K, ~cmp, o, k, key, hc)
      +hl = L.subst(K, z => $LTA(z, $EX), key, k, Equal.sym(K, k, key, ek), OR.ord_mid_l($AO, $EX, $EE, $EY, ho))
      +hg = L.subst(K, z => $GTA(z, $EY), key, k, Equal.sym(K, k, key, ek), OR.ord_mid_r($AO, $EX, $EE, $EY, ho))
      %Equal.sym($ME, $FWS(False{}, $SPL), OR.orm($E, $FWS(False{}, $EX), $FWS(False{}, Con{$EE, $EY})), NL.fw_app($AK, k, False{}, $EX, Con{$EE, $EY})) : {$ENT(ST.fst0($Y)) == _ : $ME}
      %Equal.sym($ME, $FWS(False{}, $EX), None{}, NL.fw_none($AO, k, False{}, $EX, hl)) : {$ENT(ST.fst0($Y)) == OR.orm($E, _, $FWS(False{}, Con{$EE, $EY})) : $ME}
      %Equal.sym(Cmp, cmp(k, key), EQ{}, hc) : {$ENT(ST.fst0($Y)) == S.pick($ME, S.ordering_ok(_, False{}), Some{$EE}, $FWS(False{}, $EY)) : $ME}
      %Equal.sym($ME, $FWS(False{}, $EY), S.head($E, $EY), NL.fw_head($AK, k, False{}, $EY, hg)) : {$ENT(ST.fst0($Y)) == _ : $ME}
      Equal.sym($ME, S.head($E, $EY), $ENT(ST.fst0($Y)), EN.head_ents(~K, ~V, nl, pl, $Y, hky))
    case False{} False{}:
      +ek = O.antisym(~K, ~cmp, o, k, key, hc)
      +hl = L.subst(K, z => $LTA(z, $EX), key, k, Equal.sym(K, k, key, ek), OR.ord_mid_l($AO, $EX, $EE, $EY, ho))
      +hg = L.subst(K, z => $GTA(z, $EY), key, k, Equal.sym(K, k, key, ek), OR.ord_mid_r($AO, $EX, $EE, $EY, ho))
      %Equal.sym($ME, $LWS(False{}, $SPL, None{}), $LWS(False{}, Con{$EE, $EY}, $LWS(False{}, $EX, None{})), NL.lw_app($AK, k, False{}, $EX, Con{$EE, $EY}, None{})) : {$ENT(ST.last0($X)) == _ : $ME}
      %Equal.sym($ME, $LWS(False{}, $EX, None{}), OR.orm($E, S.last($E, $EX), None{}), NL.lw_all($AK, k, False{}, $EX, None{}, hl)) : {$ENT(ST.last0($X)) == $LWS(False{}, Con{$EE, $EY}, _) : $ME}
      %Equal.sym($ME, OR.orm($E, S.last($E, $EX), None{}), S.last($E, $EX), OR.orm_none($E, S.last($E, $EX))) : {$ENT(ST.last0($X)) == $LWS(False{}, Con{$EE, $EY}, _) : $ME}
      %Equal.sym(K, k, key, ek) : {$ENT(ST.last0($X)) == $LWS(False{}, $EY, S.pick($ME, S.ordering_ok(cmp(key, _), False{}), Some{$EE}, S.last($E, $EX))) : $ME}
      %Equal.sym(Cmp, cmp(key, key), EQ{}, O.refl(~K, ~cmp, ~o, key)) : {$ENT(ST.last0($X)) == $LWS(False{}, $EY, S.pick($ME, S.ordering_ok(_, False{}), Some{$EE}, S.last($E, $EX))) : $ME}
      %Equal.sym($ME, $LWS(False{}, $EY, S.last($E, $EX)), S.last($E, $EX), NL.lw_none($AO, k, False{}, $EY, S.last($E, $EX), hg)) : {$ENT(ST.last0($X)) == _ : $ME}
      Equal.sym($ME, S.last($E, $EX), $ENT(ST.last0($X)), EN.last_ents_all(~K, ~V, nl, pl, $X, hkx))

%def KL @+hl: $GTA(k, $ENTS(P.after($CL(i, r, c)))) -> $GOAL(l, $CL(i, r, c))
%def KR @+hr2: $LTA(k, $ENTS(P.before($CR(i, l, c)))) -> $GOAL(r, $CR(i, l, c))
%def WHT $WH(c, $TN(i, l, r))

def gcase($TO, $NODEH, +h: Bool, +incl: Bool, +key: K, +v: V, +hE: {$ENT(i) == Some{$EE} : $ME}, +hW: {$ENTS($WHT) == $SPL : $ES}, +ho: $ORD($SPL), +hkx: $OKS($X), +hky: $OKS($Y), +eqL: {$WHT == $WH($CL(i, r, c), l) : $LN}, +eqR: {$WHT == $WH($CR(i, l, c), r) : $LN}, kl: $KL, kr: $KR, +cc: Cmp, +hc: {cmp(k, key) == cc : Cmp}) -> {$ENT(TR.pk3(Nat, cc, $GN(l, $CL(i, r, c)), $GN(r, $CR(i, l, c)), $PK(incl, i, $PK(h, ST.fst0($Y), ST.last0($X))))) == $NAV($WHT) : $ME}:
  match cc:
    case LT{}:
      +hkl = L.subst(Cmp, z => {Cmp.is_lt(z) == True{} : Bool}, LT{}, cmp(k, key), Equal.sym(Cmp, cmp(k, key), LT{}, hc), {==})
      +hg = L.and_intro(Cmp.is_lt(cmp(k, key)), OR.gtall($AK, k, $EY), hkl, OR.gtall_mono($AO, k, key, hkl, $EY, OR.ord_mid_r($AO, $EX, $EE, $EY, ho)))
      +hl = L.subst($ME, z => $GTA(k, ST.cons_m($E, z, $EY)), Some{$EE}, $ENT(i), Equal.sym($ME, $ENT(i), Some{$EE}, hE), hg)
      %Equal.sym($LN, $WHT, $WH($CL(i, r, c), l), eqL) : {$ENT($GN(l, $CL(i, r, c))) == $NAV(_) : $ME}
      kl(hl)
    case GT{}:
      +hlk = OR.gt_lt(~K, ~cmp, ~o, k, key, hc)
      +hx = NL.ltall_app($AK, k, $EX, Con{$EE, Nil{}}, OR.ltall_mono($AO, key, k, hlk, $EX, OR.ord_mid_l($AO, $EX, $EE, $EY, ho)), L.and_intro(Cmp.is_lt(cmp(key, k)), True{}, hlk, {==}))
      +hx2 = L.subst($ME, z => $LTA(k, $EAPP($EX, ST.cons_m($E, z, Nil{}))), Some{$EE}, $ENT(i), Equal.sym($ME, $ENT(i), Some{$EE}, hE), hx)
      +hx3 = L.subst($ES, z => $LTA(k, z), $EAPP($EX, $ENTS(Con{i, Nil{}})), $ENTS($APP($X, Con{i, Nil{}})), Equal.sym($ES, $ENTS($APP($X, Con{i, Nil{}})), $EAPP($EX, $ENTS(Con{i, Nil{}})), FI.ents_app(~K, ~V, $X, Con{i, Nil{}}, nl, pl)), hx2)
      +hr2 = L.subst($LN, z => $LTA(k, $ENTS(z)), $APP($X, Con{i, Nil{}}), P.before($CR(i, l, c)), LL.append_assoc(Nat, P.before(c), $IDS(l), Con{i, Nil{}}), hx3)
      %Equal.sym($LN, $WHT, $WH($CR(i, l, c), r), eqR) : {$ENT($GN(r, $CR(i, l, c))) == $NAV(_) : $ME}
      kr(hr2)
    case EQ{}:
      %Equal.sym($ES, $ENTS($WHT), $SPL, hW) : {$ENT($PK(incl, i, $PK(h, ST.fst0($Y), ST.last0($X)))) == S.nav($AK, k, h, incl, _) : $ME}
      geq($AO, $NODEA, h, incl, key, v, hE, hc, ho, hkx, hky)

def gnode($TO, $NODEH, +h: Bool, +incl: Bool, +x: $ND, +m: $MV, +hx: {ST.is_node(K, x, ST.rid(l), ST.rid(r), P.top(c)) == True{} : Bool}, +hm: {ST.some2(V, m) == True{} : Bool}, +hxi: {ST.nd(K, nl, i) == x : $ND}, +hEg: {$ENT(i) == ST.ent(K, V, x, m) : $ME}, +hW0: {$ENTS($WHT) == $EAPP($EX, ST.cons_m($E, $ENT(i), $EY)) : $ES}, +ho: $ORD($ENTS($WHT)), +hkx: $OKS($X), +hky: $OKS($Y), +eqL: {$WHT == $WH($CL(i, r, c), l) : $LN}, +eqR: {$WHT == $WH($CR(i, l, c), r) : $LN}, kl: $KL, kr: $KR) -> $GOAL($TN(i, l, r), c):
  match x m:
    case M.Free{f} +m:
      Empty.absurd($GOAL($TN(i, l, r), c), L.false_true(hx))
    case M.N{cc, a, b, q, +key} None{}:
      Empty.absurd($GOAL($TN(i, l, r), c), L.false_true(hm))
    case M.N{+cc, +a, +b, +q, +key} Some{+v}:
      +hW = Equal.trans($ES, $ENTS($WHT), $EAPP($EX, ST.cons_m($E, $ENT(i), $EY)), $SPL, hW0, L.subst($ME, z => {$EAPP($EX, ST.cons_m($E, $ENT(i), $EY)) == $EAPP($EX, ST.cons_m($E, z, $EY)) : $ES}, $ENT(i), Some{$EE}, hEg, {==}))
      +ho2 = L.subst($ES, z => $ORD(z), $ENTS($WHT), $SPL, hW, ho)
      %Equal.sym($ND, ST.nd(K, nl, i), M.N{cc, a, b, q, key}, hxi) : {$ENT(TR.pk3(Nat, TR.kc(~K, ~cmp, k, _), $GN(l, $CL(i, r, c)), $GN(r, $CR(i, l, c)), $PK(incl, i, $PK(h, ST.fst0($Y), ST.last0($X))))) == $NAV($WHT) : $ME}
      gcase($AO, $NODEA, h, incl, key, v, hEg, hW, ho2, hkx, hky, eqL, eqR, kl, kr, cmp(k, key), {==})

# the ids split around a node: before and its left ids, the node, its right
# ids and after
def wh_node(+c: $CT, +i: Nat, +l: ST.Tr, +r: ST.Tr) -> {$WH(c, $TN(i, l, r)) == $APP($APP(P.before(c), $IDS(l)), Con{i, $APP($IDS(r), P.after(c))}) : $LN}:
  %Equal.sym($LN, $APP($APP(P.before(c), $IDS(l)), Con{i, $APP($IDS(r), P.after(c))}), $APP(P.before(c), $APP($IDS(l), Con{i, $APP($IDS(r), P.after(c))})), LL.append_assoc(Nat, P.before(c), $IDS(l), Con{i, $APP($IDS(r), P.after(c))})) : {$WH(c, $TN(i, l, r)) == _ : $LN}
  P.eq_l(P.before(c), P.after(c), i, $IDS(l), $IDS(r))

# the entry at the ghost navigation's id is the specification's answer
def gspec($TO, +nl: $NLT, +pl: $PLT, +t: ST.Tr, +c: $CT, +k: K, +h: Bool, +incl: Bool, +hr: $REP(t, P.top(c)), +hp: $PAY(t), +ho: $ORD($ENTS($WH(c, t))), +hk: $OKS($WH(c, t)), +hb: $LTA(k, $ENTS(P.before(c))), +ha: $GTA(k, $ENTS(P.after(c)))) -> $GOAL(t, c):
  match t:
    case ST.TE{}:
      nav_te($AO, nl, pl, c, k, h, incl, hk, hb, ha)
    case ST.TN{+i, +l, +r}:
      +eqW = wh_node(c, i, l, r)
      +hk2 = L.subst($LN, z => $OKS(z), $WHT, $APP($X, Con{i, $Y}), eqW, hk)
      +hkx = oks_l(~K, ~V, nl, pl, $X, Con{i, $Y}, hk2)
      +hky = L.and_right(S.is_some($E, $ENT(i)), EN.oks(~K, ~V, $Y, nl, pl), oks_r(~K, ~V, nl, pl, $X, Con{i, $Y}, hk2))
      +hW0 = Equal.trans($ES, $ENTS($WHT), $ENTS($APP($X, Con{i, $Y})), $EAPP($EX, ST.cons_m($E, $ENT(i), $EY)), L.subst($LN, z => {$ENTS($WHT) == $ENTS(z) : $ES}, $WHT, $APP($X, Con{i, $Y}), eqW, {==}), FI.ents_app(~K, ~V, $X, Con{i, $Y}, nl, pl))
