import Base
import ../../lib/logic.bend as L
import ../../lib/nat.bend as N
import ../../../spec/lib/common.bend as SC
import ../../../spec/containers/balanced_search_tree/main.bend as S
import ../../../src/containers/balanced_search_tree.bend as M
import ./state.bend as ST
import ./mirror.bend as MI
import ./tree.bend as TR
import ./find.bend as FI

# The first and last entries: the header's first and last ids are the ends
# of the ghost order, and every id of the tree has an entry, so the entry
# (or key) at them is the head (or last) of the specification's entries.
# (source: tools/generators/tm_hand/ends.src)

%def ND M.Node<K>
%def E M.Entry<K, V>
%def ES List<&2, M.Entry<K, V>>
%def ME Maybe<&2, M.Entry<K, V>>
%def MV Maybe<&2, V>
%def NL List<&2, $ND>
%def PL List<&2, $MV>
%def TK ~K: Data, ~V: Data, ~cmp: K -> K -> Cmp
%def AK ~K, ~V, ~cmp
%def FT +n: Nat, +root: Nat, +lo: Nat, +hi: Nat, +free: Nat, +l: Nat, +d: Nat, +nl: $NL, +pl: $PL, +tg: ST.Tr, +fl: List<&2, Nat>
%def F n, root, lo, hi, free, l, d, nl, pl, tg, fl
%def SH ST.SH{$F}
%def SHT ST.Sh<K, V>
%def GF {ST.goodF($AK, $F) == True{} : Bool}
%def ENTS(ix) ST.ents(~K, ~V, ix, nl, pl)
%def EST $ENTS(ST.ids(tg))
%def ENTI(x) ST.ent(K, V, ST.nd(K, nl, x), ST.pv(V, pl, x))
%def ISS(m) {S.is_some($E, m) == True{} : Bool}
%def REP(t, p) {ST.rep(~K, t, p, nl) == True{} : Bool}
%def PAY(t) {ST.pay(~V, t, pl) == True{} : Bool}

# every id has an entry
def oks(~K: Data, ~V: Data, xs: List<&2, Nat>, +nl: $NL, +pl: $PL) -> Bool:
  match xs:
    case Nil{}:
      True{}
    case Con{+x, t}:
      Bool.and(S.is_some($E, $ENTI(x)), oks(~K, ~V, t, nl, pl))

%def OKS(xs) {oks(~K, ~V, xs, nl, pl) == True{} : Bool}

def oks_app(~K: Data, ~V: Data, +nl: $NL, +pl: $PL, +xs: List<&2, Nat>, +ys: List<&2, Nat>, +hx: $OKS(xs), +hy: $OKS(ys)) -> $OKS(SC.append(Nat, xs, ys)):
  match xs:
    case Nil{}:
      hy
    case Con{+x, +t}:
      L.and_intro(S.is_some($E, $ENTI(x)), oks(~K, ~V, SC.append(Nat, t, ys), nl, pl), L.and_left(S.is_some($E, $ENTI(x)), oks(~K, ~V, t, nl, pl), hx), oks_app(~K, ~V, nl, pl, t, ys, L.and_right(S.is_some($E, $ENTI(x)), oks(~K, ~V, t, nl, pl), hx), hy))

def ent_some(-K: Data, -V: Data, +x: $ND, +m: $MV, +a: Nat, +b: Nat, +q: Nat, +hx: {ST.is_node(K, x, a, b, q) == True{} : Bool}, +hm: {ST.some2(V, m) == True{} : Bool}) -> $ISS(ST.ent(K, V, x, m)):
  match x m:
    case M.Free{f} _:
      Empty.absurd($ISS(ST.ent(K, V, M.Free{f}, m)), L.false_true(hx))
    case M.N{c, x1, x2, x3, key} None{}:
      Empty.absurd($ISS(ST.ent(K, V, M.N{c, x1, x2, x3, key}, None{})), L.false_true(hm))
    case M.N{c, x1, x2, x3, key} Some{v}:
      {==}

def oks_tree(~K: Data, ~V: Data, +nl: $NL, +pl: $PL, +t: ST.Tr, +p: Nat, +hr: $REP(t, p), +hp: $PAY(t)) -> $OKS(ST.ids(t)):
  match t:
    case ST.TE{}:
      {==}
    case ST.TN{+i, +tl, +tr}:
      oks_app(~K, ~V, nl, pl, ST.ids(tl), Con{i, ST.ids(tr)}, oks_tree(~K, ~V, nl, pl, tl, i, TR.rep_l(~K, i, tl, tr, p, nl, hr), FI.pay_l(~V, i, tl, tr, pl, hp)), L.and_intro(S.is_some($E, $ENTI(i)), oks(~K, ~V, ST.ids(tr), nl, pl), ent_some(K, V, ST.nd(K, nl, i), ST.pv(V, pl, i), ST.rid(tl), ST.rid(tr), p, TR.rep_node(~K, i, tl, tr, p, nl, hr), FI.pay_node(~V, i, tl, tr, pl, hp)), oks_tree(~K, ~V, nl, pl, tr, i, TR.rep_r(~K, i, tl, tr, p, nl, hr), FI.pay_r(~V, i, tl, tr, pl, hp))))

# ---- ends of the entries ----

def hd_cm(-K: Data, -V: Data, +m: $ME, +r: $ES, +hm: $ISS(m)) -> {S.head($E, ST.cons_m($E, m, r)) == m : $ME}:
  match m:
    case None{}:
      Empty.absurd({S.head($E, ST.cons_m($E, None{}, r)) == None{} : $ME}, L.false_true(hm))
    case Some{e}:
      {==}

def head_ents(~K: Data, ~V: Data, +nl: $NL, +pl: $PL, +xs: List<&2, Nat>, +h: $OKS(xs)) -> {S.head($E, $ENTS(xs)) == $ENTI(ST.fst0(xs)) : $ME}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      hd_cm(K, V, $ENTI(x), $ENTS(t), L.and_left(S.is_some($E, $ENTI(x)), oks(~K, ~V, t, nl, pl), h))

def last_cm1(-K: Data, -V: Data, +m: $ME, +hm: $ISS(m)) -> {S.last($E, ST.cons_m($E, m, Nil{})) == m : $ME}:
  match m:
    case None{}:
      Empty.absurd({S.last($E, ST.cons_m($E, None{}, Nil{})) == None{} : $ME}, L.false_true(hm))
    case Some{e}:
      {==}

def last_cm2(-K: Data, -V: Data, +m1: $ME, +m2: $ME, +r: $ES, +h1: $ISS(m1), +h2: $ISS(m2)) -> {S.last($E, ST.cons_m($E, m1, ST.cons_m($E, m2, r))) == S.last($E, ST.cons_m($E, m2, r)) : $ME}:
  match m1 m2:
    case None{} _:
      Empty.absurd({S.last($E, ST.cons_m($E, None{}, ST.cons_m($E, m2, r))) == S.last($E, ST.cons_m($E, m2, r)) : $ME}, L.false_true(h1))
    case Some{e} None{}:
      Empty.absurd({S.last($E, ST.cons_m($E, Some{e}, ST.cons_m($E, None{}, r))) == S.last($E, ST.cons_m($E, None{}, r)) : $ME}, L.false_true(h2))
    case Some{e} Some{e2}:
      {==}

def last_ents(~K: Data, ~V: Data, +nl: $NL, +pl: $PL, +t: List<&2, Nat>, +x: Nat, +h: $OKS(Con{x, t})) -> {S.last($E, $ENTS(Con{x, t})) == $ENTI(ST.last0(Con{x, t})) : $ME}:
  match t:
    case Nil{}:
      last_cm1(K, V, $ENTI(x), L.and_left(S.is_some($E, $ENTI(x)), True{}, h))
    case Con{+y, +u}:
      +h2 = L.and_right(S.is_some($E, $ENTI(x)), oks(~K, ~V, Con{y, u}, nl, pl), h)
      %Equal.sym($ME, S.last($E, ST.cons_m($E, $ENTI(x), ST.cons_m($E, $ENTI(y), $ENTS(u)))), S.last($E, ST.cons_m($E, $ENTI(y), $ENTS(u))), last_cm2(K, V, $ENTI(x), $ENTI(y), $ENTS(u), L.and_left(S.is_some($E, $ENTI(x)), oks(~K, ~V, Con{y, u}, nl, pl), h), L.and_left(S.is_some($E, $ENTI(y)), oks(~K, ~V, u, nl, pl), h2))) : {_ == $ENTI(ST.last0(Con{y, u})) : $ME}
      last_ents(~K, ~V, nl, pl, u, y, h2)

def last0_some(~K: Data, ~V: Data, +nl: $NL, +pl: $PL, +t: List<&2, Nat>, +x: Nat, +h: $OKS(Con{x, t})) -> $ISS($ENTI(ST.last0(Con{x, t}))):
  match t:
    case Nil{}:
      L.and_left(S.is_some($E, $ENTI(x)), True{}, h)
    case Con{+y, +u}:
      last0_some(~K, ~V, nl, pl, u, y, L.and_right(S.is_some($E, $ENTI(x)), oks(~K, ~V, Con{y, u}, nl, pl), h))

def km_some(-K: Data, -V: Data, +x: $ND, +m: $MV, +h: $ISS(ST.ent(K, V, x, m))) -> {S.key_m(K, V, ST.ent(K, V, x, m)) == M.node_key(~K, x) : Maybe<&2, K>}:
  match x m:
    case M.Free{f} _:
      Empty.absurd({S.key_m(K, V, ST.ent(K, V, M.Free{f}, m)) == M.node_key(~K, M.Free{f}) : Maybe<&2, K>}, L.false_true(h))
    case M.N{c, x1, x2, x3, key} None{}:
      Empty.absurd({S.key_m(K, V, ST.ent(K, V, M.N{c, x1, x2, x3, key}, None{})) == M.node_key(~K, M.N{c, x1, x2, x3, key}) : Maybe<&2, K>}, L.false_true(h))
    case M.N{c, x1, x2, x3, key} Some{v}:
      {==}

def first_key_eq(~K: Data, ~V: Data, +nl: $NL, +pl: $PL, +xs: List<&2, Nat>, +h: $OKS(xs)) -> {S.key_m(K, V, S.head($E, $ENTS(xs))) == M.node_key(~K, ST.nd(K, nl, ST.fst0(xs))) : Maybe<&2, K>}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      %Equal.sym($ME, S.head($E, $ENTS(Con{x, t})), $ENTI(x), head_ents(~K, ~V, nl, pl, Con{x, t}, h)) : {S.key_m(K, V, _) == M.node_key(~K, ST.nd(K, nl, x)) : Maybe<&2, K>}
      km_some(K, V, ST.nd(K, nl, x), ST.pv(V, pl, x), L.and_left(S.is_some($E, $ENTI(x)), oks(~K, ~V, t, nl, pl), h))

def last_key_eq(~K: Data, ~V: Data, +nl: $NL, +pl: $PL, +xs: List<&2, Nat>, +h: $OKS(xs)) -> {S.key_m(K, V, S.last($E, $ENTS(xs))) == M.node_key(~K, ST.nd(K, nl, ST.last0(xs))) : Maybe<&2, K>}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      %Equal.sym($ME, S.last($E, $ENTS(Con{x, t})), $ENTI(ST.last0(Con{x, t})), last_ents(~K, ~V, nl, pl, t, x, h)) : {S.key_m(K, V, _) == M.node_key(~K, ST.nd(K, nl, ST.last0(Con{x, t}))) : Maybe<&2, K>}
      km_some(K, V, ST.nd(K, nl, ST.last0(Con{x, t})), ST.pv(V, pl, ST.last0(Con{x, t})), last0_some(~K, ~V, nl, pl, t, x, h))

def last_ents_all(~K: Data, ~V: Data, +nl: $NL, +pl: $PL, +xs: List<&2, Nat>, +h: $OKS(xs)) -> {S.last($E, $ENTS(xs)) == $ENTI(ST.last0(xs)) : $ME}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      last_ents(~K, ~V, nl, pl, t, x, h)

# ---- the mirror's reads at an id ----

def ev_m($TK, $FT, +x: $ND, +m: $MV) -> {MI.entry_value($AK, M.node_key(~K, x), ($SH, m)) == ($SH, ST.ent(K, V, x, m)) : $SHT & $ME}:
  match x m:
    case M.Free{f} None{}:
      {==}
    case M.Free{f} Some{v}:
      {==}
    case M.N{c, x1, x2, x3, key} None{}:
      {==}
    case M.N{c, x1, x2, x3, key} Some{v}:
      {==}

%def OKT oks_tree(~K, ~V, nl, pl, tg, 0n, ST.g_crep($AK, $F, hg), ST.g_cpay($AK, $F, hg))

def first_entry_m($TK, $FT, +hg: $GF) -> {MI.first_entry($AK, $SH) == ($SH, S.head($E, $EST)) : $SHT & $ME}:
  +e = N.eq_from_is_eq(lo, ST.fst0(ST.ids(tg)), ST.g_clo($AK, $F, hg))
  %Equal.sym($SHT & $ME, MI.entry_snapshot($AK, ($SH, lo)), ($SH, $ENTI(lo)), ev_m($AK, $F, ST.nd(K, nl, lo), ST.pv(V, pl, lo))) : {_ == ($SH, S.head($E, $EST)) : $SHT & $ME}
  %Equal.sym(Nat, lo, ST.fst0(ST.ids(tg)), e) : {($SH, ST.ent(K, V, ST.nd(K, nl, _), ST.pv(V, pl, _))) == ($SH, S.head($E, $EST)) : $SHT & $ME}
  %Equal.sym($ME, S.head($E, $EST), $ENTI(ST.fst0(ST.ids(tg))), head_ents(~K, ~V, nl, pl, ST.ids(tg), $OKT)) : {($SH, $ENTI(ST.fst0(ST.ids(tg)))) == ($SH, _) : $SHT & $ME}
  {==}

def last_entry_m($TK, $FT, +hg: $GF) -> {MI.last_entry($AK, $SH) == ($SH, S.last($E, $EST)) : $SHT & $ME}:
  +e = N.eq_from_is_eq(hi, ST.last0(ST.ids(tg)), ST.g_chi($AK, $F, hg))
  %Equal.sym($SHT & $ME, MI.entry_snapshot($AK, ($SH, hi)), ($SH, $ENTI(hi)), ev_m($AK, $F, ST.nd(K, nl, hi), ST.pv(V, pl, hi))) : {_ == ($SH, S.last($E, $EST)) : $SHT & $ME}
  %Equal.sym(Nat, hi, ST.last0(ST.ids(tg)), e) : {($SH, ST.ent(K, V, ST.nd(K, nl, _), ST.pv(V, pl, _))) == ($SH, S.last($E, $EST)) : $SHT & $ME}
  %Equal.sym($ME, S.last($E, $EST), $ENTI(ST.last0(ST.ids(tg))), last_ents_all(~K, ~V, nl, pl, ST.ids(tg), $OKT)) : {($SH, $ENTI(ST.last0(ST.ids(tg)))) == ($SH, _) : $SHT & $ME}
  {==}

def first_key_m($TK, $FT, +hg: $GF) -> {MI.first_key($AK, $SH) == ($SH, S.key_m(K, V, S.head($E, $EST))) : $SHT & Maybe<&2, K>}:
  +e = N.eq_from_is_eq(lo, ST.fst0(ST.ids(tg)), ST.g_clo($AK, $F, hg))
  %Equal.sym(Nat, lo, ST.fst0(ST.ids(tg)), e) : {($SH, M.node_key(~K, ST.nd(K, nl, _))) == ($SH, S.key_m(K, V, S.head($E, $EST))) : $SHT & Maybe<&2, K>}
  %Equal.sym(Maybe<&2, K>, S.key_m(K, V, S.head($E, $EST)), M.node_key(~K, ST.nd(K, nl, ST.fst0(ST.ids(tg)))), first_key_eq(~K, ~V, nl, pl, ST.ids(tg), $OKT)) : {($SH, M.node_key(~K, ST.nd(K, nl, ST.fst0(ST.ids(tg))))) == ($SH, _) : $SHT & Maybe<&2, K>}
  {==}

def last_key_m($TK, $FT, +hg: $GF) -> {MI.last_key($AK, $SH) == ($SH, S.key_m(K, V, S.last($E, $EST))) : $SHT & Maybe<&2, K>}:
  +e = N.eq_from_is_eq(hi, ST.last0(ST.ids(tg)), ST.g_chi($AK, $F, hg))
  %Equal.sym(Nat, hi, ST.last0(ST.ids(tg)), e) : {($SH, M.node_key(~K, ST.nd(K, nl, _))) == ($SH, S.key_m(K, V, S.last($E, $EST))) : $SHT & Maybe<&2, K>}
  %Equal.sym(Maybe<&2, K>, S.key_m(K, V, S.last($E, $EST)), M.node_key(~K, ST.nd(K, nl, ST.last0(ST.ids(tg)))), last_key_eq(~K, ~V, nl, pl, ST.ids(tg), $OKT)) : {($SH, M.node_key(~K, ST.nd(K, nl, ST.last0(ST.ids(tg))))) == ($SH, _) : $SHT & Maybe<&2, K>}
  {==}
