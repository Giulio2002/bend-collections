# The in-order walk (M.walk, M.fold_range, M.fold): on the realization of a
# good shadow it leaves the map as it was and answers the specification's
# fold of f over the entries within the bounds, in key order. The proof
# follows the walk with a ghost stack of frames (a slot and the subtree to
# its right): the ids of the current subtree followed by those of the frames
# are the ids still to visit, in order.


# ---- bounds along the order ----

def ok_le(+c: Cmp) -> {S.ordering_ok(c, True{}) == Cmp.is_le(c) : Bool}:
  match c:
    case LT{}:
      {==}
    case EQ{}:
      {==}
    case GT{}:
      {==}

def ok_lt(+c: Cmp) -> {S.ordering_ok(c, False{}) == Cmp.is_lt(c) : Bool}:
  match c:
    case LT{}:
      {==}
    case EQ{}:
      {==}
    case GT{}:
      {==}

def tr_to(+a: Bool, +b: Bool, +e: {a == b : Bool}, +h: {a == True{} : Bool}) -> {b == True{} : Bool}:
  L.subst(Bool, z => {z == True{} : Bool}, a, b, e, h)

def tr_of(+a: Bool, +b: Bool, +e: {a == b : Bool}, +h: {b == True{} : Bool}) -> {a == True{} : Bool}:
  L.subst(Bool, z => {z == True{} : Bool}, b, a, Equal.sym(Bool, a, b, e), h)

# a key above the lower bound: so is every greater key
def al_mono(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, ~o: O.Order(~K, ~cmp), +k: K, +k2: K, +lb: M.Bound<K>, +h: {S.above_lower(~K, ~cmp, k, lb) == True{} : Bool}, +hlt: {Cmp.is_lt(cmp(k, k2)) == True{} : Bool}) -> {S.above_lower(~K, ~cmp, k2, lb) == True{} : Bool}:
  match lb:
    case M.Unbounded{}:
      {==}
    case M.Inclusive{+lo}:
      tr_of(S.ordering_ok(cmp(lo, k2), True{}), Cmp.is_le(cmp(lo, k2)), ok_le(cmp(lo, k2)), O.trans(~K, ~cmp, o, lo, k, k2, tr_to(S.ordering_ok(cmp(lo, k), True{}), Cmp.is_le(cmp(lo, k)), ok_le(cmp(lo, k)), h), OR.lt_le(cmp(k, k2), hlt)))
    case M.Exclusive{+lo}:
      tr_of(S.ordering_ok(cmp(lo, k2), False{}), Cmp.is_lt(cmp(lo, k2)), ok_lt(cmp(lo, k2)), OR.slt_trans(~K, ~cmp, ~o, lo, k, k2, tr_to(S.ordering_ok(cmp(lo, k), False{}), Cmp.is_lt(cmp(lo, k)), ok_lt(cmp(lo, k)), h), hlt))

# a key below the upper bound: so is every smaller key
def bu_mono(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, ~o: O.Order(~K, ~cmp), +k: K, +k2: K, +ub: M.Bound<K>, +h: {S.below_upper(~K, ~cmp, k2, ub) == True{} : Bool}, +hlt: {Cmp.is_lt(cmp(k, k2)) == True{} : Bool}) -> {S.below_upper(~K, ~cmp, k, ub) == True{} : Bool}:
  match ub:
    case M.Unbounded{}:
      {==}
    case M.Inclusive{+hi}:
      tr_of(S.ordering_ok(cmp(k, hi), True{}), Cmp.is_le(cmp(k, hi)), ok_le(cmp(k, hi)), O.trans(~K, ~cmp, o, k, k2, hi, OR.lt_le(cmp(k, k2), hlt), tr_to(S.ordering_ok(cmp(k2, hi), True{}), Cmp.is_le(cmp(k2, hi)), ok_le(cmp(k2, hi)), h)))
    case M.Exclusive{+hi}:
      tr_of(S.ordering_ok(cmp(k, hi), False{}), Cmp.is_lt(cmp(k, hi)), ok_lt(cmp(k, hi)), OR.slt_trans(~K, ~cmp, ~o, k, k2, hi, hlt, tr_to(S.ordering_ok(cmp(k2, hi), False{}), Cmp.is_lt(cmp(k2, hi)), ok_lt(cmp(k2, hi)), h)))

def al_not(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, ~o: O.Order(~K, ~cmp), +k: K, +k2: K, +lb: M.Bound<K>, +hn: {S.above_lower(~K, ~cmp, k2, lb) == False{} : Bool}, +hlt: {Cmp.is_lt(cmp(k, k2)) == True{} : Bool}, +b: Bool, +hb: {S.above_lower(~K, ~cmp, k, lb) == b : Bool}) -> {b == False{} : Bool}:
  match b:
    case False{}:
      {==}
    case True{}:
      Empty.absurd({True{} == False{} : Bool}, L.true_not_false(S.above_lower(~K, ~cmp, k2, lb), al_mono(~K, ~V, ~cmp, ~o, k, k2, lb, hb, hlt), hn))

def bu_not(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, ~o: O.Order(~K, ~cmp), +k: K, +k2: K, +ub: M.Bound<K>, +hn: {S.below_upper(~K, ~cmp, k, ub) == False{} : Bool}, +hlt: {Cmp.is_lt(cmp(k, k2)) == True{} : Bool}, +b: Bool, +hb: {S.below_upper(~K, ~cmp, k2, ub) == b : Bool}) -> {b == False{} : Bool}:
  match b:
    case False{}:
      {==}
    case True{}:
      Empty.absurd({True{} == False{} : Bool}, L.true_not_false(S.below_upper(~K, ~cmp, k, ub), bu_mono(~K, ~V, ~cmp, ~o, k, k2, ub, hb, hlt), hn))

def andf(+x: Bool) -> {Bool.and(x, False{}) == False{} : Bool}:
  match x:
    case True{}:
      {==}
    case False{}:
      {==}

# ---- the entries within the bounds of an ordered list ----

# past a key that is not below the upper bound: none
def past(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, ~o: O.Order(~K, ~cmp), +k: K, +es: List<&2, M.Entry<K, V>>, +lb: M.Bound<K>, +ub: M.Bound<K>, +hg: {OR.gtall(~K, ~V, ~cmp, k, es) == True{} : Bool}, +hb: {S.below_upper(~K, ~cmp, k, ub) == False{} : Bool}) -> {S.within(~K, ~V, ~cmp, lb, ub, es) == Nil{} : List<&2, M.Entry<K, V>>}:
  match es:
    case Nil{}:
      {==}
    case Con{+e, +t}:
      +hlt = L.and_left(Cmp.is_lt(cmp(k, S.key(K, V, e))), OR.gtall(~K, ~V, ~cmp, k, t), hg)
      +hg2 = L.and_right(Cmp.is_lt(cmp(k, S.key(K, V, e))), OR.gtall(~K, ~V, ~cmp, k, t), hg)
      %Equal.sym(Bool, S.below_upper(~K, ~cmp, S.key(K, V, e), ub), False{}, bu_not(~K, ~V, ~cmp, ~o, k, S.key(K, V, e), ub, hb, hlt, S.below_upper(~K, ~cmp, S.key(K, V, e), ub), {==})) : {S.pick(List<&2, M.Entry<K, V>>, Bool.and(S.above_lower(~K, ~cmp, S.key(K, V, e), lb), _), Con{e, S.within(~K, ~V, ~cmp, lb, ub, t)}, S.within(~K, ~V, ~cmp, lb, ub, t)) == Nil{} : List<&2, M.Entry<K, V>>}
      %Equal.sym(Bool, Bool.and(S.above_lower(~K, ~cmp, S.key(K, V, e), lb), False{}), False{}, andf(S.above_lower(~K, ~cmp, S.key(K, V, e), lb))) : {S.pick(List<&2, M.Entry<K, V>>, _, Con{e, S.within(~K, ~V, ~cmp, lb, ub, t)}, S.within(~K, ~V, ~cmp, lb, ub, t)) == Nil{} : List<&2, M.Entry<K, V>>}
      past(~K, ~V, ~cmp, ~o, k, t, lb, ub, hg2, hb)

# past a key above the lower bound: the lower bound no longer matters
def tail(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, ~o: O.Order(~K, ~cmp), +k: K, +es: List<&2, M.Entry<K, V>>, +lb: M.Bound<K>, +ub: M.Bound<K>, +hg: {OR.gtall(~K, ~V, ~cmp, k, es) == True{} : Bool}, +ha: {S.above_lower(~K, ~cmp, k, lb) == True{} : Bool}) -> {S.within(~K, ~V, ~cmp, lb, ub, es) == S.within(~K, ~V, ~cmp, M.Unbounded{}, ub, es) : List<&2, M.Entry<K, V>>}:
  match es:
    case Nil{}:
      {==}
    case Con{+e, +t}:
      +hlt = L.and_left(Cmp.is_lt(cmp(k, S.key(K, V, e))), OR.gtall(~K, ~V, ~cmp, k, t), hg)
      +hg2 = L.and_right(Cmp.is_lt(cmp(k, S.key(K, V, e))), OR.gtall(~K, ~V, ~cmp, k, t), hg)
      %Equal.sym(Bool, S.above_lower(~K, ~cmp, S.key(K, V, e), lb), True{}, al_mono(~K, ~V, ~cmp, ~o, k, S.key(K, V, e), lb, ha, hlt)) : {S.pick(List<&2, M.Entry<K, V>>, Bool.and(_, S.below_upper(~K, ~cmp, S.key(K, V, e), ub)), Con{e, S.within(~K, ~V, ~cmp, lb, ub, t)}, S.within(~K, ~V, ~cmp, lb, ub, t)) == S.within(~K, ~V, ~cmp, M.Unbounded{}, ub, Con{e, t}) : List<&2, M.Entry<K, V>>}
      %Equal.sym(List<&2, M.Entry<K, V>>, S.within(~K, ~V, ~cmp, lb, ub, t), S.within(~K, ~V, ~cmp, M.Unbounded{}, ub, t), tail(~K, ~V, ~cmp, ~o, k, t, lb, ub, hg2, ha)) : {S.pick(List<&2, M.Entry<K, V>>, S.below_upper(~K, ~cmp, S.key(K, V, e), ub), Con{e, _}, _) == S.within(~K, ~V, ~cmp, M.Unbounded{}, ub, Con{e, t}) : List<&2, M.Entry<K, V>>}
      {==}

# before a key that is not above the lower bound: none
def skip(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, ~o: O.Order(~K, ~cmp), +k: K, +pre: List<&2, M.Entry<K, V>>, +rest: List<&2, M.Entry<K, V>>, +lb: M.Bound<K>, +ub: M.Bound<K>, +hl: {OR.ltall(~K, ~V, ~cmp, k, pre) == True{} : Bool}, +hna: {S.above_lower(~K, ~cmp, k, lb) == False{} : Bool}) -> {S.within(~K, ~V, ~cmp, lb, ub, SC.append(M.Entry<K, V>, pre, rest)) == S.within(~K, ~V, ~cmp, lb, ub, rest) : List<&2, M.Entry<K, V>>}:
  match pre:
    case Nil{}:
      {==}
    case Con{+e, +t}:
      +hlt = L.and_left(Cmp.is_lt(cmp(S.key(K, V, e), k)), OR.ltall(~K, ~V, ~cmp, k, t), hl)
      +hl2 = L.and_right(Cmp.is_lt(cmp(S.key(K, V, e), k)), OR.ltall(~K, ~V, ~cmp, k, t), hl)
      %Equal.sym(Bool, S.above_lower(~K, ~cmp, S.key(K, V, e), lb), False{}, al_not(~K, ~V, ~cmp, ~o, S.key(K, V, e), k, lb, hna, hlt, S.above_lower(~K, ~cmp, S.key(K, V, e), lb), {==})) : {S.pick(List<&2, M.Entry<K, V>>, Bool.and(_, S.below_upper(~K, ~cmp, S.key(K, V, e), ub)), Con{e, S.within(~K, ~V, ~cmp, lb, ub, SC.append(M.Entry<K, V>, t, rest))}, S.within(~K, ~V, ~cmp, lb, ub, SC.append(M.Entry<K, V>, t, rest))) == S.within(~K, ~V, ~cmp, lb, ub, rest) : List<&2, M.Entry<K, V>>}
      skip(~K, ~V, ~cmp, ~o, k, t, rest, lb, ub, hl2, hna)

# without bounds: every entry
def win_all(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +es: List<&2, M.Entry<K, V>>) -> {S.within(~K, ~V, ~cmp, M.Unbounded{}, M.Unbounded{}, es) == es : List<&2, M.Entry<K, V>>}:
  match es:
    case Nil{}:
      {==}
    case Con{+e, +t}:
      LL.cons_cong(M.Entry<K, V>, e, S.within(~K, ~V, ~cmp, M.Unbounded{}, M.Unbounded{}, t), t, win_all(~K, ~V, ~cmp, t))

# ---- taking a slot's item out of an array and putting it back ----


def upd_upd(-T: Data, +xs: List<&2, T>, +j: Nat, +a: T, +x: T, +h: {SC.nth(T, xs, j) == Some{x} : Maybe<&2, T>}) -> {SC.update(T, SC.update(T, xs, j, a), j, x) == xs : List<&2, T>}:
  match xs j:
    case Nil{} _:
      {==}
    case Con{+y, +r} 0n:
      Equal.cong(T, List<&2, T>, z => Con{z, r}, x, y, Equal.sym(T, y, x, L.some_inj(T, y, x, h)))
    case Con{+y, +r} 1n+q:
      LL.cons_cong(T, y, SC.update(T, SC.update(T, r, q, a), q, x), r, upd_upd(T, r, q, a, x, h))

def sw_out(-T: Data, +d: Nat, +t: AR.Tree<T>, +j: Nat, +a: T, +x: T, +hd: {Nat.is_lt(d, 32n) == True{} : Bool}, +pf: {AR.perfect(T, d, t) == True{} : Bool}, +hj: {Nat.is_lt(j, SC.pow2(d)) == True{} : Bool}, +hx: {SC.nth(T, AR.slots(T, t), j) == Some{x} : Maybe<&2, T>}) -> {Array.swap(T, AR.thaw(T, t), U32.from_nat(j), a) == (AR.thaw(T, AR.upd(T, d, t, j, a)), x) : Array<T> & T}:
  +eu = U.to_nat_from_nat(j, d, N.lt_le(d, 32n, hd), hj)
  +hxu = L.subst(Nat, z => {SC.nth(T, AR.slots(T, t), z) == Some{x} : Maybe<&2, T>}, j, U32.to_nat(U32.from_nat(j)), Equal.sym(Nat, U32.to_nat(U32.from_nat(j)), j, eu), hx)
  +hju = L.subst(Nat, z => {Nat.is_lt(z, SC.pow2(d)) == True{} : Bool}, j, U32.to_nat(U32.from_nat(j)), Equal.sym(Nat, U32.to_nat(U32.from_nat(j)), j, eu), hj)
  L.subst(Nat, z => {Array.swap(T, AR.thaw(T, t), U32.from_nat(j), a) == (AR.thaw(T, AR.upd(T, d, t, z, a)), x) : Array<T> & T}, U32.to_nat(U32.from_nat(j)), j, eu, AR.swap(T, d, t, U32.from_nat(j), a, x, hd, hju, hxu, pf))

def sw_back(-T: Data, +d: Nat, +t: AR.Tree<T>, +j: Nat, +a: T, +x: T, +hd: {Nat.is_lt(d, 32n) == True{} : Bool}, +pf: {AR.perfect(T, d, t) == True{} : Bool}, +hj: {Nat.is_lt(j, SC.pow2(d)) == True{} : Bool}, +hx: {SC.nth(T, AR.slots(T, t), j) == Some{x} : Maybe<&2, T>}) -> {Array.set(T, AR.thaw(T, AR.upd(T, d, t, j, a)), U32.from_nat(j), x) == AR.thaw(T, t) : Array<T>}:
  +t1 = AR.upd(T, d, t, j, a)
  +pf1 = AR.upd_perfect(T, d, t, j, a, pf)
  +eu = U.to_nat_from_nat(j, d, N.lt_le(d, 32n, hd), hj)
  +hs1 = L.subst(List<&2, T>, z => {SC.nth(T, z, j) == Some{a} : Maybe<&2, T>}, SC.update(T, AR.slots(T, t), j, a), AR.slots(T, t1), Equal.sym(List<&2, T>, AR.slots(T, t1), SC.update(T, AR.slots(T, t), j, a), AR.upd_slots(T, d, t, j, a, hj, pf)), LL.nth_update_same(T, AR.slots(T, t), j, a, AR.len_lt(T, d, t, j, pf, hj)))
  +hxu = L.subst(Nat, z => {SC.nth(T, AR.slots(T, t1), z) == Some{a} : Maybe<&2, T>}, j, U32.to_nat(U32.from_nat(j)), Equal.sym(Nat, U32.to_nat(U32.from_nat(j)), j, eu), hs1)
  +hju = L.subst(Nat, z => {Nat.is_lt(z, SC.pow2(d)) == True{} : Bool}, j, U32.to_nat(U32.from_nat(j)), Equal.sym(Nat, U32.to_nat(U32.from_nat(j)), j, eu), hj)
  +e1 = L.subst(Nat, z => {Array.set(T, AR.thaw(T, t1), U32.from_nat(j), x) == AR.thaw(T, AR.upd(T, d, t1, z, x)) : Array<T>}, U32.to_nat(U32.from_nat(j)), j, eu, AR.set(T, d, t1, U32.from_nat(j), x, a, hd, hju, hxu, pf1))
  +es = Equal.trans(List<&2, T>, AR.slots(T, AR.upd(T, d, t1, j, x)), SC.update(T, AR.slots(T, t1), j, x), AR.slots(T, t), AR.upd_slots(T, d, t1, j, x, hj, pf1), Equal.trans(List<&2, T>, SC.update(T, AR.slots(T, t1), j, x), SC.update(T, SC.update(T, AR.slots(T, t), j, a), j, x), AR.slots(T, t), Equal.cong(List<&2, T>, List<&2, T>, z => SC.update(T, z, j, x), AR.slots(T, t1), SC.update(T, AR.slots(T, t), j, a), AR.upd_slots(T, d, t, j, a, hj, pf)), upd_upd(T, AR.slots(T, t), j, a, x, hx)))
  Equal.trans(Array<T>, Array.set(T, AR.thaw(T, t1), U32.from_nat(j), x), AR.thaw(T, AR.upd(T, d, t1, j, x)), AR.thaw(T, t), e1, Equal.cong(AR.Tree<T>, Array<T>, z => AR.thaw(T, z), AR.upd(T, d, t1, j, x), t, AX.tree_ext(T, d, AR.upd(T, d, t1, j, x), t, AR.upd_perfect(T, d, t1, j, x, pf1), pf, es)))

# the slot of an item of a payload block
def fill_some(-T: Data, +k: Nat, +xs: List<&2, T>, +j: Nat, +x: T, +h: {SC.nth(T, xs, j) == Some{x} : Maybe<&2, T>}, +hk: {Nat.is_le(SC.length(T, xs), k) == True{} : Bool}) -> {SC.nth(Maybe<&2, T>, MK.fill(T, k, xs), j) == Some{Some{x}} : Maybe<&2, Maybe<&2, T>>}:
  match k xs j:
    case 0n Nil{} _:
      Empty.absurd({SC.nth(Maybe<&2, T>, Nil{}, j) == Some{Some{x}} : Maybe<&2, Maybe<&2, T>>}, L.none_some(T, x, h))
    case 0n Con{y, r} _:
      Empty.absurd({SC.nth(Maybe<&2, T>, Nil{}, j) == Some{Some{x}} : Maybe<&2, Maybe<&2, T>>}, L.false_true(hk))
    case 1n+k2 Nil{} _:
      Empty.absurd({SC.nth(Maybe<&2, T>, MK.fill(T, 1n+k2, Nil{}), j) == Some{Some{x}} : Maybe<&2, Maybe<&2, T>>}, L.none_some(T, x, h))
    case 1n+k2 Con{+y, r} 0n:
      Equal.cong(Maybe<&2, T>, Maybe<&2, Maybe<&2, T>>, z => Some{z}, Some{y}, Some{x}, h)
    case 1n+k2 Con{y, +r} 1n+q:
      fill_some(T, k2, r, q, x, h, hk)

# ---- the node and the value of an id ----


# a node whose right child is b
def isr(~K: Data, x: M.Node<K>, +b: Nat) -> Bool:
  match x:
    case M.Free{f}:
      False{}
    case M.N{c, lf, +rt, pa, k}:
      Nat.is_eq(rt, b)

# a node's key is above the lower bound
def nab(~K: Data, ~cmp: K -> K -> Cmp, x: M.Node<K>, +lb: M.Bound<K>) -> Bool:
  match x:
    case M.Free{f}:
      True{}
    case M.N{c, lf, rt, pa, +k}:
      S.above_lower(~K, ~cmp, k, lb)

def nab_unb(~K: Data, ~cmp: K -> K -> Cmp, +x: M.Node<K>) -> {nab(~K, ~cmp, x, M.Unbounded{}) == True{} : Bool}:
  match x:
    case M.Free{f}:
      {==}
    case M.N{c, lf, rt, pa, k}:
      {==}

def node_l(~K: Data, +x: M.Node<K>, +a: Nat, +b: Nat, +p: Nat, +h: {ST.is_node(K, x, a, b, p) == True{} : Bool}) -> {M.nleft(~K, x) == a : Nat}:
  match x:
    case M.Free{f}:
      Empty.absurd({M.nleft(~K, M.Free{f}) == a : Nat}, L.false_true(h))
    case M.N{c, +lf, +rt, +pa, k}:
      N.eq_from_is_eq(lf, a, L.and_left(Nat.is_eq(lf, a), Bool.and(Nat.is_eq(rt, b), Nat.is_eq(pa, p)), h))

def node_r(~K: Data, +x: M.Node<K>, +a: Nat, +b: Nat, +p: Nat, +h: {ST.is_node(K, x, a, b, p) == True{} : Bool}) -> {M.nright(~K, x) == b : Nat}:
  match x:
    case M.Free{f}:
      Empty.absurd({M.nright(~K, M.Free{f}) == b : Nat}, L.false_true(h))
    case M.N{c, +lf, +rt, +pa, k}:
      N.eq_from_is_eq(rt, b, L.and_left(Nat.is_eq(rt, b), Nat.is_eq(pa, p), L.and_right(Nat.is_eq(lf, a), Bool.and(Nat.is_eq(rt, b), Nat.is_eq(pa, p)), h)))

def node_isr(~K: Data, +x: M.Node<K>, +a: Nat, +b: Nat, +p: Nat, +h: {ST.is_node(K, x, a, b, p) == True{} : Bool}) -> {isr(~K, x, b) == True{} : Bool}:
  match x:
    case M.Free{f}:
      Empty.absurd({False{} == True{} : Bool}, L.false_true(h))
    case M.N{c, +lf, +rt, +pa, k}:
      L.and_left(Nat.is_eq(rt, b), Nat.is_eq(pa, p), L.and_right(Nat.is_eq(lf, a), Bool.and(Nat.is_eq(rt, b), Nat.is_eq(pa, p)), h))

def node_isn(~K: Data, +x: M.Node<K>, +a: Nat, +b: Nat, +p: Nat, +h: {ST.is_node(K, x, a, b, p) == True{} : Bool}) -> {NSL.isn(~K, x) == True{} : Bool}:
  match x:
    case M.Free{f}:
      Empty.absurd({False{} == True{} : Bool}, L.false_true(h))
    case M.N{c, lf, rt, pa, k}:
      {==}

def isr_r(~K: Data, +x: M.Node<K>, +b: Nat, +h: {isr(~K, x, b) == True{} : Bool}) -> {M.nright(~K, x) == b : Nat}:
  match x:
    case M.Free{f}:
      Empty.absurd({M.nright(~K, M.Free{f}) == b : Nat}, L.false_true(h))
    case M.N{c, lf, +rt, pa, k}:
      N.eq_from_is_eq(rt, b, h)

def isr_isn(~K: Data, +x: M.Node<K>, +b: Nat, +h: {isr(~K, x, b) == True{} : Bool}) -> {NSL.isn(~K, x) == True{} : Bool}:
  match x:
    case M.Free{f}:
      Empty.absurd({False{} == True{} : Bool}, L.false_true(h))
    case M.N{c, lf, rt, pa, k}:
      {==}

# a live node is its slot's
def node_nth(~K: Data, +nl: List<&2, M.Node<K>>, +j: Nat, +h: {NSL.isn(~K, ST.nd(K, nl, 1n+j)) == True{} : Bool}) -> {SC.nth(M.Node<K>, nl, j) == Some{ST.nd(K, nl, 1n+j)} : Maybe<&2, M.Node<K>>}:
  NSL.nth_of_or(M.Node<K>, nl, j, M.Free{0n}, NSL.nth_or_lt(~K, nl, j, ST.nd(K, nl, 1n+j), h, {==}))

# a value is its slot's
def pay_nth(-V: Data, +pl: List<&2, Maybe<&2, V>>, +j: Nat, +h: {ST.some2(V, ST.nth_or(Maybe<&2, V>, pl, j, None{})) == True{} : Bool}) -> {SC.nth(Maybe<&2, V>, pl, j) == Some{ST.nth_or(Maybe<&2, V>, pl, j, None{})} : Maybe<&2, Maybe<&2, V>>}:
  match pl j:
    case Nil{} _:
      Empty.absurd({SC.nth(Maybe<&2, V>, Nil{}, j) == Some{None{}} : Maybe<&2, Maybe<&2, V>>}, L.false_true(h))
    case Con{x, r} 0n:
      {==}
    case Con{x, +r} 1n+q:
      pay_nth(V, r, q, h)

# ---- the ghost stack ----

type Fr is Data:
  F{i: Nat, rt: ST.Tr}


# the walk's stack: the frames' slots
def slots(fr: List<&2, Fr>) -> List<&2, Nat>:
  match fr:
    case Nil{}:
      Nil{}
    case Con{F{i, b}, r}:
      Con{i, slots(r)}

# the ids still to visit after the current subtree, in order
def fids(fr: List<&2, Fr>) -> List<&2, Nat>:
  match fr:
    case Nil{}:
      Nil{}
    case Con{F{i, b}, r}:
      Con{1n+i, SC.append(Nat, ST.ids(b), fids(r))}

# every frame's node is live with a value, its right child the frame's subtree
def frs_wf(~K: Data, ~V: Data, fr: List<&2, Fr>, +nl: List<&2, M.Node<K>>, +pl: List<&2, Maybe<&2, V>>) -> Bool:
  match fr:
    case Nil{}:
      True{}
    case Con{F{+i, +b}, r}:
      Bool.and(isr(~K, ST.nd(K, nl, 1n+i), ST.rid(b)), Bool.and(ST.some2(V, ST.pv(V, pl, 1n+i)), Bool.and(ST.rep(~K, b, 1n+i, nl), Bool.and(ST.pay(~V, b, pl), frs_wf(~K, ~V, r, nl, pl)))))

# every frame's key is above the lower bound
def frs_lb(~K: Data, ~cmp: K -> K -> Cmp, fr: List<&2, Fr>, +nl: List<&2, M.Node<K>>, +lb: M.Bound<K>) -> Bool:
  match fr:
    case Nil{}:
      True{}
    case Con{F{+i, b}, r}:
      Bool.and(nab(~K, ~cmp, ST.nd(K, nl, 1n+i), lb), frs_lb(~K, ~cmp, r, nl, lb))

def frs_unb(~K: Data, ~cmp: K -> K -> Cmp, +fr: List<&2, Fr>, +nl: List<&2, M.Node<K>>) -> {frs_lb(~K, ~cmp, fr, nl, M.Unbounded{}) == True{} : Bool}:
  match fr:
    case Nil{}:
      {==}
    case Con{F{+i, b}, +r}:
      L.and_intro(nab(~K, ~cmp, ST.nd(K, nl, 1n+i), M.Unbounded{}), frs_lb(~K, ~cmp, r, nl, M.Unbounded{}), nab_unb(~K, ~cmp, ST.nd(K, nl, 1n+i)), frs_unb(~K, ~cmp, r, nl))

# ---- the walk's steps: four per node of the current subtree, two per frame ----

def wt(t: ST.Tr) -> Nat:
  match t:
    case ST.TE{}:
      0n
    case ST.TN{i, l, r}:
      4n+Nat.add(wt(l), wt(r))

def cf(fr: List<&2, Fr>) -> Nat:
  match fr:
    case Nil{}:
      0n
    case Con{F{i, b}, r}:
      2n+Nat.add(wt(b), cf(r))

def mu(tc: ST.Tr, fr: List<&2, Fr>) -> Nat:
  1n+Nat.add(wt(tc), cf(fr))


def mu_eq(+a: Nat, +b: Nat, +c: Nat) -> {Nat.add(a, 2n+Nat.add(b, c)) == 2n+Nat.add(Nat.add(a, b), c) : Nat}:
  Equal.trans(Nat, Nat.add(a, 2n+Nat.add(b, c)), 1n+Nat.add(a, 1n+Nat.add(b, c)), 2n+Nat.add(Nat.add(a, b), c), N.add_succ(a, 1n+Nat.add(b, c)), N.succ_cong(Nat.add(a, 1n+Nat.add(b, c)), 1n+Nat.add(Nat.add(a, b), c), Equal.trans(Nat, Nat.add(a, 1n+Nat.add(b, c)), 1n+Nat.add(a, Nat.add(b, c)), 1n+Nat.add(Nat.add(a, b), c), N.add_succ(a, Nat.add(b, c)), N.succ_cong(Nat.add(a, Nat.add(b, c)), Nat.add(Nat.add(a, b), c), Equal.sym(Nat, Nat.add(Nat.add(a, b), c), Nat.add(a, Nat.add(b, c)), N.add_assoc(a, b, c))))))

def le_r(+a: Nat, +b: Nat, +c: Nat) -> {Nat.is_le(Nat.add(b, c), Nat.add(Nat.add(a, b), c)) == True{} : Bool}:
  %Equal.sym(Nat, Nat.add(Nat.add(a, b), c), Nat.add(a, Nat.add(b, c)), N.add_assoc(a, b, c)) : {Nat.is_le(Nat.add(b, c), _) == True{} : Bool}
  %N.add_comm(Nat.add(b, c), a) : {Nat.is_le(Nat.add(b, c), _) == True{} : Bool}
  N.le_add_right(Nat.add(b, c), a)

# the fuel left after a step
def fu_push(+a: Nat, +b: Nat, +c: Nat, +g: Nat, +h: {Nat.is_le(3n+Nat.add(Nat.add(a, b), c), g) == True{} : Bool}) -> {Nat.is_le(1n+Nat.add(a, 2n+Nat.add(b, c)), 1n+g) == True{} : Bool}:
  %Equal.sym(Nat, Nat.add(a, 2n+Nat.add(b, c)), 2n+Nat.add(Nat.add(a, b), c), mu_eq(a, b, c)) : {Nat.is_le(_, g) == True{} : Bool}
  N.le_trans(2n+Nat.add(Nat.add(a, b), c), 3n+Nat.add(Nat.add(a, b), c), g, N.le_succ(2n+Nat.add(Nat.add(a, b), c)), h)

def fu_left(+a: Nat, +b: Nat, +c: Nat, +g: Nat, +h: {Nat.is_le(3n+Nat.add(Nat.add(a, b), c), g) == True{} : Bool}) -> {Nat.is_le(1n+Nat.add(a, 2n+Nat.add(b, c)), g) == True{} : Bool}:
  %Equal.sym(Nat, Nat.add(a, 2n+Nat.add(b, c)), 2n+Nat.add(Nat.add(a, b), c), mu_eq(a, b, c)) : {Nat.is_le(1n+_, g) == True{} : Bool}
  h

def fu_right(+a: Nat, +b: Nat, +c: Nat, +g: Nat, +h: {Nat.is_le(3n+Nat.add(Nat.add(a, b), c), g) == True{} : Bool}) -> {Nat.is_le(1n+Nat.add(b, c), g) == True{} : Bool}:
  N.le_trans(1n+Nat.add(b, c), 3n+Nat.add(Nat.add(a, b), c), g, N.le_trans(Nat.add(b, c), Nat.add(Nat.add(a, b), c), 2n+Nat.add(Nat.add(a, b), c), le_r(a, b, c), N.le_trans(Nat.add(Nat.add(a, b), c), 1n+Nat.add(Nat.add(a, b), c), 2n+Nat.add(Nat.add(a, b), c), N.le_succ(Nat.add(Nat.add(a, b), c)), N.le_succ(1n+Nat.add(Nat.add(a, b), c)))), h)


# four steps per node
def w_size(+t: ST.Tr) -> {wt(t) == Nat.double(Nat.double(SC.length(Nat, ST.ids(t)))) : Nat}:
  match t:
    case ST.TE{}:
      {==}
    case ST.TN{+i, +l, +r}:
      +e_len = Equal.trans(Nat, SC.length(Nat, SC.append(Nat, ST.ids(l), Con{i, ST.ids(r)})), Nat.add(SC.length(Nat, ST.ids(l)), 1n+SC.length(Nat, ST.ids(r))), 1n+Nat.add(SC.length(Nat, ST.ids(l)), SC.length(Nat, ST.ids(r))), LL.length_append(Nat, ST.ids(l), Con{i, ST.ids(r)}), N.add_succ(SC.length(Nat, ST.ids(l)), SC.length(Nat, ST.ids(r))))
      +e_dd = Equal.trans(Nat, Nat.add(Nat.double(Nat.double(SC.length(Nat, ST.ids(l)))), Nat.double(Nat.double(SC.length(Nat, ST.ids(r))))), Nat.double(Nat.add(Nat.double(SC.length(Nat, ST.ids(l))), Nat.double(SC.length(Nat, ST.ids(r))))), Nat.double(Nat.double(Nat.add(SC.length(Nat, ST.ids(l)), SC.length(Nat, ST.ids(r))))), N.add_double(Nat.double(SC.length(Nat, ST.ids(l))), Nat.double(SC.length(Nat, ST.ids(r)))), Equal.cong(Nat, Nat, z => Nat.double(z), Nat.add(Nat.double(SC.length(Nat, ST.ids(l))), Nat.double(SC.length(Nat, ST.ids(r)))), Nat.double(Nat.add(SC.length(Nat, ST.ids(l)), SC.length(Nat, ST.ids(r)))), N.add_double(SC.length(Nat, ST.ids(l)), SC.length(Nat, ST.ids(r)))))
      %Equal.sym(Nat, SC.length(Nat, SC.append(Nat, ST.ids(l), Con{i, ST.ids(r)})), 1n+Nat.add(SC.length(Nat, ST.ids(l)), SC.length(Nat, ST.ids(r))), e_len) : {4n+Nat.add(wt(l), wt(r)) == Nat.double(Nat.double(_)) : Nat}
      %e_dd : {4n+Nat.add(wt(l), wt(r)) == 4n+_ : Nat}
      %w_size(l) : {4n+Nat.add(wt(l), wt(r)) == 4n+Nat.add(_, Nat.double(Nat.double(SC.length(Nat, ST.ids(r))))) : Nat}
      %w_size(r) : {4n+Nat.add(wt(l), wt(r)) == 4n+Nat.add(wt(l), _) : Nat}
      {==}

# ---- the walk on the realization ----


# f applied to an entry
def ape(~K: Data, ~V: Data, ~A: Data, ~f: A -> K -> V -> A, a: A, me: Maybe<&2, M.Entry<K, V>>) -> A:
  match me:
    case None{}:
      a
    case Some{M.Entry{k, v}}:
      f(a, k, v)

def ord_consm(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +m: Maybe<&2, M.Entry<K, V>>, +es: List<&2, M.Entry<K, V>>, +h: {ST.ordered(~K, ~V, ~cmp, ST.cons_m(M.Entry<K, V>, m, es)) == True{} : Bool}) -> {ST.ordered(~K, ~V, ~cmp, es) == True{} : Bool}:
  match m:
    case None{}:
      h
    case Some{+e}:
      OR.ord_tail(~K, ~V, ~cmp, e, es, h)

def d32(+l: Nat, +d: Nat, +hl: {Nat.is_le(l, 29n) == True{} : Bool}, +hd: {Nat.is_le(d, l) == True{} : Bool}) -> {Nat.is_lt(d, 32n) == True{} : Bool}:
  DAS.lt32(d, l, hd, N.le_trans(l, 29n, 31n, hl, {==}))

# the node of a slot and its value, from the node and the value of its id
def nth_nd(~K: Data, +nl: List<&2, M.Node<K>>, +j: Nat, +c: Bool, +lf: Nat, +rt: Nat, +pa: Nat, +k: K, +hx: {ST.nd(K, nl, 1n+j) == M.N{c, lf, rt, pa, k} : M.Node<K>}) -> {SC.nth(M.Node<K>, nl, j) == Some{M.N{c, lf, rt, pa, k}} : Maybe<&2, M.Node<K>>}:
  Equal.trans(Maybe<&2, M.Node<K>>, SC.nth(M.Node<K>, nl, j), Some{ST.nd(K, nl, 1n+j)}, Some{M.N{c, lf, rt, pa, k}}, NSL.nth_of_or(M.Node<K>, nl, j, M.Free{0n}, NSL.nth_or_lt(~K, nl, j, M.N{c, lf, rt, pa, k}, {==}, hx)), Equal.cong(M.Node<K>, Maybe<&2, M.Node<K>>, z => Some{z}, ST.nd(K, nl, 1n+j), M.N{c, lf, rt, pa, k}, hx))

def nth_pv(-V: Data, +pl: List<&2, Maybe<&2, V>>, +j: Nat, +v: V, +hmv: {ST.pv(V, pl, 1n+j) == Some{v} : Maybe<&2, V>}) -> {SC.nth(Maybe<&2, V>, pl, j) == Some{Some{v}} : Maybe<&2, Maybe<&2, V>>}:
  Equal.trans(Maybe<&2, Maybe<&2, V>>, SC.nth(Maybe<&2, V>, pl, j), Some{ST.pv(V, pl, 1n+j)}, Some{Some{v}}, pay_nth(V, pl, j, L.subst(Maybe<&2, V>, z => {ST.some2(V, z) == True{} : Bool}, Some{v}, ST.pv(V, pl, 1n+j), Equal.sym(Maybe<&2, V>, ST.pv(V, pl, 1n+j), Some{v}, hmv), {==})), Equal.cong(Maybe<&2, V>, Maybe<&2, Maybe<&2, V>>, z => Some{z}, ST.pv(V, pl, 1n+j), Some{v}, hmv))

# the payload slot of a value
def pslot(-V: Data, +d: Nat, +pl: List<&2, Maybe<&2, V>>, +j: Nat, +v: V, +hv: {SC.nth(Maybe<&2, V>, pl, j) == Some{Some{v}} : Maybe<&2, Maybe<&2, V>>}, +hpc: {Nat.is_le(SC.length(Maybe<&2, V>, pl), SC.pow2(d)) == True{} : Bool}) -> {SC.nth(Maybe<&2, Maybe<&2, V>>, AR.slots(Maybe<&2, Maybe<&2, V>>, MK.mk(Maybe<&2, V>, d, pl)), j) == Some{Some{Some{v}}} : Maybe<&2, Maybe<&2, Maybe<&2, V>>>}:
  %Equal.sym(List<&2, Maybe<&2, Maybe<&2, V>>>, AR.slots(Maybe<&2, Maybe<&2, V>>, MK.mk(Maybe<&2, V>, d, pl)), MK.fill(Maybe<&2, V>, SC.pow2(d), pl), MK.mk_slots(Maybe<&2, V>, d, pl)) : {SC.nth(Maybe<&2, Maybe<&2, V>>, _, j) == Some{Some{Some{v}}} : Maybe<&2, Maybe<&2, Maybe<&2, V>>>}
  fill_some(Maybe<&2, V>, SC.pow2(d), pl, j, Some{v}, hv, hpc)

def plt(-V: Data, +d: Nat, +pl: List<&2, Maybe<&2, V>>, +j: Nat, +v: V, +hv: {SC.nth(Maybe<&2, V>, pl, j) == Some{Some{v}} : Maybe<&2, Maybe<&2, V>>}, +hpc: {Nat.is_le(SC.length(Maybe<&2, V>, pl), SC.pow2(d)) == True{} : Bool}) -> {Nat.is_lt(j, SC.pow2(d)) == True{} : Bool}:
  N.lt_le_trans(j, SC.length(Maybe<&2, V>, pl), SC.pow2(d), LL.nth_lt_length(Maybe<&2, V>, pl, j, Some{v}, hv), hpc)

