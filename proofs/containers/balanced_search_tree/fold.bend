# fold: f folded over every entry; the map unchanged
def fold_ok(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, ~o: O.Order(~K, ~cmp), ~A: Data, ~f: A -> K -> V -> A, +sh: ST.Sh<K, V>, +hg: {ST.good(~K, ~V, ~cmp, sh) == True{} : Bool}, +a: A) -> OK.POK(~K, ~V, ~cmp, A, S.fold(~K, ~V, ~A, ~f, ST.model(~K, ~V, ~cmp, sh), a), M.fold(~K, ~V, ~cmp, ~A, ~f, ST.real(~K, ~V, ~cmp, sh), a)):
  match sh:
    case ST.SH{+n, +root, +lo, +hi, +free, +l, +d, +nl, +pl, +t, +fl}:
      OK.pok_read(~K, ~V, ~cmp, A, ST.SH{n, root, lo, hi, free, l, d, nl, pl, t, fl}, hg, S.fold_entries(~K, ~V, ~A, ~f, ST.ents(~K, ~V, ST.ids(t), nl, pl), a), S.fold(~K, ~V, ~A, ~f, ST.model(~K, ~V, ~cmp, ST.SH{n, root, lo, hi, free, l, d, nl, pl, t, fl}), a), M.fold(~K, ~V, ~cmp, ~A, ~f, ST.real(~K, ~V, ~cmp, ST.SH{n, root, lo, hi, free, l, d, nl, pl, t, fl}), a), {==}, L.subst(List<&2, M.Entry<K, V>>, zz => {M.fold_range(~K, ~V, ~cmp, ~A, ~f, ST.real(~K, ~V, ~cmp, ST.SH{n, root, lo, hi, free, l, d, nl, pl, t, fl}), M.Unbounded{}, M.Unbounded{}, a) == (ST.real(~K, ~V, ~cmp, ST.SH{n, root, lo, hi, free, l, d, nl, pl, t, fl}), S.fold_entries(~K, ~V, ~A, ~f, zz, a)) : M.TreeMap<K, V, cmp> & A}, S.within(~K, ~V, ~cmp, M.Unbounded{}, M.Unbounded{}, ST.ents(~K, ~V, ST.ids(t), nl, pl)), ST.ents(~K, ~V, ST.ids(t), nl, pl), win_all(~K, ~V, ~cmp, ST.ents(~K, ~V, ST.ids(t), nl, pl)), fr_c(~K, ~V, ~cmp, ~o, ~A, ~f, n, root, lo, hi, free, l, d, nl, pl, t, fl, hg, M.Unbounded{}, M.Unbounded{}, a)))
