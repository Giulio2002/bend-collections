# ---- the walk from a subtree and a stack of frames ----


# The walk from the root of a subtree tc with the frames fr stacked, the
# remaining ids in order and enough fuel: the map is left as it was and the
# answer is f folded over the remaining entries within the bounds.
def d_walk(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, ~o: O.Order(~K, ~cmp), ~A: Data, ~f: A -> K -> V -> A, +n: Nat, +root: Nat, +lo: Nat, +hi: Nat, +free: Nat, +l: Nat, +d: Nat, +nl: List<&2, M.Node<K>>, +pl: List<&2, Maybe<&2, V>>, +ub: M.Bound<K>, +hl: {Nat.is_le(l, 29n) == True{} : Bool}, +hd: {Nat.is_le(d, l) == True{} : Bool}, +hc: {Nat.is_le(SC.length(M.Node<K>, nl), SC.pow2(d)) == True{} : Bool}, +hpc: {Nat.is_le(SC.length(Maybe<&2, V>, pl), SC.pow2(d)) == True{} : Bool}, +fuel: Nat, +lb: M.Bound<K>, +tc: ST.Tr, +fr: List<&2, Fr>, +a: A, +y: Maybe<&2, K>, +z: Maybe<&2, Maybe<&2, V>>, +p: Nat, +hrep: {ST.rep(~K, tc, p, nl) == True{} : Bool}, +hpay: {ST.pay(~V, tc, pl) == True{} : Bool}, +hfr: {frs_wf(~K, ~V, fr, nl, pl) == True{} : Bool}, +hlb: {frs_lb(~K, ~cmp, fr, nl, lb) == True{} : Bool}, +hord: {ST.ordered(~K, ~V, ~cmp, ST.ents(~K, ~V, SC.append(Nat, ST.ids(tc), fids(fr)), nl, pl)) == True{} : Bool}, +hfu: {Nat.is_le(mu(tc, fr), fuel) == True{} : Bool}) -> {M.walk_fin(~K, ~V, ~cmp, ~A, n, root, lo, hi, free, l, d, SC.pow2(d), SC.length(M.Node<K>, nl), l, d, SC.pow2(d), SC.length(Maybe<&2, V>, pl), M.walk(~K, ~V, ~cmp, ~A, ~f, fuel, lb, ub, M.WDown{}, 0n, True{}, (AR.thaw(Nat, AR.TNode{BK.bk(Nat, 1n+d, NR.lrs(~K, nl), 0n), BK.bk(Nat, 1n+d, NR.tps(~K, nl), 0n)}), ST.rid(tc)), slots(fr), a, (AR.thaw(Maybe<&2, K>, BK.bk(Maybe<&2, K>, d, NR.keys(~K, nl), None{})), y), (AR.thaw(Maybe<&2, Maybe<&2, V>>, MK.mk(Maybe<&2, V>, d, pl)), z))) == (M.TM{n, root, lo, hi, free, NR.real(~K, l, d, nl), DAS.real(Maybe<&2, V>, DAS.Sh{l, d, SC.length(Maybe<&2, V>, pl), MK.mk(Maybe<&2, V>, d, pl)})}, S.fold_entries(~K, ~V, ~A, ~f, S.within(~K, ~V, ~cmp, lb, ub, ST.ents(~K, ~V, SC.append(Nat, ST.ids(tc), fids(fr)), nl, pl)), a)) : M.TreeMap<K, V, cmp> & A}:
  match fuel lb tc fr:
    case 0n lb tc fr:
      Empty.absurd({M.walk_fin(~K, ~V, ~cmp, ~A, n, root, lo, hi, free, l, d, SC.pow2(d), SC.length(M.Node<K>, nl), l, d, SC.pow2(d), SC.length(Maybe<&2, V>, pl), M.walk(~K, ~V, ~cmp, ~A, ~f, 0n, lb, ub, M.WDown{}, 0n, True{}, (AR.thaw(Nat, AR.TNode{BK.bk(Nat, 1n+d, NR.lrs(~K, nl), 0n), BK.bk(Nat, 1n+d, NR.tps(~K, nl), 0n)}), ST.rid(tc)), slots(fr), a, (AR.thaw(Maybe<&2, K>, BK.bk(Maybe<&2, K>, d, NR.keys(~K, nl), None{})), y), (AR.thaw(Maybe<&2, Maybe<&2, V>>, MK.mk(Maybe<&2, V>, d, pl)), z))) == (M.TM{n, root, lo, hi, free, NR.real(~K, l, d, nl), DAS.real(Maybe<&2, V>, DAS.Sh{l, d, SC.length(Maybe<&2, V>, pl), MK.mk(Maybe<&2, V>, d, pl)})}, S.fold_entries(~K, ~V, ~A, ~f, S.within(~K, ~V, ~cmp, lb, ub, ST.ents(~K, ~V, SC.append(Nat, ST.ids(tc), fids(fr)), nl, pl)), a)) : M.TreeMap<K, V, cmp> & A}, L.false_true(hfu))
    case 1n M.Unbounded{} ST.TE{} Nil{}:
