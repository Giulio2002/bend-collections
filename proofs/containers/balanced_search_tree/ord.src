import Base
import ../../lib/logic.bend as L
import ../../lib/order.bend as O
import ../../../spec/lib/common.bend as SC
import ../../../spec/containers/balanced_search_tree/main.bend as S
import ../../../src/containers/balanced_search_tree.bend as M
import ./state.bend as ST

# Order facts over entry lists for a lawful comparator (O.Order): the keys
# of a sorted list split around each entry, and the specification's lookup
# of a key decided by one comparison. (source: tools/generators/tm_hand/ord.src)

%def E M.Entry<K, V>
%def ES List<&2, M.Entry<K, V>>
%def KY(e) S.key(K, V, e)
%def TK ~K: Data, ~V: Data, ~cmp: K -> K -> Cmp
%def TO ~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, ~o: O.Order(~K, ~cmp)
%def AK ~K, ~V, ~cmp
%def AO ~K, ~V, ~cmp, ~o
%def LTB(a, b) {Cmp.is_lt(cmp(a, b)) == True{} : Bool}
%def ORD(x) {ST.ordered(~K, ~V, ~cmp, x) == True{} : Bool}
%def APP(a, b) SC.append($E, a, b)
%def FE(k, es) S.find_e(~K, ~V, ~cmp, k, es)
%def ME Maybe<&2, $E>

# ---- strict order ----

def lt_le(+c: Cmp, +h: {Cmp.is_lt(c) == True{} : Bool}) -> {Cmp.is_le(c) == True{} : Bool}:
  match c:
    case LT{}:
      {==}
    case EQ{}:
      Empty.absurd({Cmp.is_le(EQ{}) == True{} : Bool}, L.false_true(h))
    case GT{}:
      Empty.absurd({Cmp.is_le(GT{}) == True{} : Bool}, L.false_true(h))

def lt_flip(+c: Cmp, +h: {Cmp.is_lt(c) == True{} : Bool}) -> {Cmp.is_lt(O.flipc(c)) == False{} : Bool}:
  match c:
    case LT{}:
      {==}
    case EQ{}:
      Empty.absurd({Cmp.is_lt(O.flipc(EQ{})) == False{} : Bool}, L.false_true(h))
    case GT{}:
      Empty.absurd({Cmp.is_lt(O.flipc(GT{})) == False{} : Bool}, L.false_true(h))

def slt_c(~K: Data, ~cmp: K -> K -> Cmp, ~o: O.Order(~K, ~cmp), +a: K, +b: K, +c: K, +hab: $LTB(a, b), +hbc: $LTB(b, c), +x: Cmp, +hx: {cmp(a, c) == x : Cmp}) -> {Cmp.is_lt(x) == True{} : Bool}:
  match x:
    case LT{}:
      {==}
    case GT{}:
      +le = O.trans(~K, ~cmp, o, a, b, c, lt_le(cmp(a, b), hab), lt_le(cmp(b, c), hbc))
      Empty.absurd({Cmp.is_lt(GT{}) == True{} : Bool}, L.false_true(L.subst(Cmp, z => {Cmp.is_le(z) == True{} : Bool}, cmp(a, c), GT{}, hx, le)))
    case EQ{}:
      +e = O.antisym(~K, ~cmp, o, a, c, hx)
      +hba = L.subst(K, z => {Cmp.is_lt(cmp(b, z)) == True{} : Bool}, c, a, Equal.sym(K, a, c, e), hbc)
      +hf = L.subst(Cmp, z => {Cmp.is_lt(z) == True{} : Bool}, cmp(b, a), O.flipc(cmp(a, b)), O.flip(~K, ~cmp, o, a, b), hba)
      Empty.absurd({Cmp.is_lt(EQ{}) == True{} : Bool}, L.true_not_false(Cmp.is_lt(O.flipc(cmp(a, b))), hf, lt_flip(cmp(a, b), hab)))

def slt_trans(~K: Data, ~cmp: K -> K -> Cmp, ~o: O.Order(~K, ~cmp), +a: K, +b: K, +c: K, +hab: $LTB(a, b), +hbc: $LTB(b, c)) -> $LTB(a, c):
  slt_c(~K, ~cmp, ~o, a, b, c, hab, hbc, cmp(a, c), {==})

# a > b as b < a
def gt_lt(~K: Data, ~cmp: K -> K -> Cmp, ~o: O.Order(~K, ~cmp), +a: K, +b: K, +h: {cmp(a, b) == GT{} : Cmp}) -> $LTB(b, a):
  %Equal.sym(Cmp, cmp(b, a), O.flipc(cmp(a, b)), O.flip(~K, ~cmp, o, a, b)) : {Cmp.is_lt(_) == True{} : Bool}
  %Equal.sym(Cmp, cmp(a, b), GT{}, h) : {Cmp.is_lt(O.flipc(_)) == True{} : Bool}
  {==}

# a < b gives cmp(b, a) = GT
def lt_gt(~K: Data, ~cmp: K -> K -> Cmp, ~o: O.Order(~K, ~cmp), +a: K, +b: K, +h: $LTB(a, b)) -> {cmp(b, a) == GT{} : Cmp}:
  %Equal.sym(Cmp, cmp(b, a), O.flipc(cmp(a, b)), O.flip(~K, ~cmp, o, a, b)) : {_ == GT{} : Cmp}
  %Equal.sym(Cmp, cmp(a, b), LT{}, O.lt_is(cmp(a, b), h)) : {O.flipc(_) == GT{} : Cmp}
  {==}

# ---- all keys above / below a key ----

# k below every key
def gtall($TK, +k: K, es: $ES) -> Bool:
  match es:
    case Nil{}:
      True{}
    case Con{+e, t}:
      Bool.and(Cmp.is_lt(cmp(k, $KY(e))), gtall($AK, k, t))

# k above every key
def ltall($TK, +k: K, es: $ES) -> Bool:
  match es:
    case Nil{}:
      True{}
    case Con{+e, t}:
      Bool.and(Cmp.is_lt(cmp($KY(e), k)), ltall($AK, k, t))

%def GTA(k, es) {gtall($AK, k, es) == True{} : Bool}
%def LTA(k, es) {ltall($AK, k, es) == True{} : Bool}

def gtall_mono($TO, +a: K, +b: K, +hab: $LTB(a, b), +es: $ES, +h: $GTA(b, es)) -> $GTA(a, es):
  match es:
    case Nil{}:
      {==}
    case Con{+e, +t}:
      +h1 = L.and_left(Cmp.is_lt(cmp(b, $KY(e))), gtall($AK, b, t), h)
      +h2 = L.and_right(Cmp.is_lt(cmp(b, $KY(e))), gtall($AK, b, t), h)
      L.and_intro(Cmp.is_lt(cmp(a, $KY(e))), gtall($AK, a, t), slt_trans(~K, ~cmp, ~o, a, b, $KY(e), hab, h1), gtall_mono($AO, a, b, hab, t, h2))

def ltall_mono($TO, +a: K, +b: K, +hab: $LTB(a, b), +es: $ES, +h: $LTA(a, es)) -> $LTA(b, es):
  match es:
    case Nil{}:
      {==}
    case Con{+e, +t}:
      +h1 = L.and_left(Cmp.is_lt(cmp($KY(e), a)), ltall($AK, a, t), h)
      +h2 = L.and_right(Cmp.is_lt(cmp($KY(e), a)), ltall($AK, a, t), h)
      L.and_intro(Cmp.is_lt(cmp($KY(e), b)), ltall($AK, b, t), slt_trans(~K, ~cmp, ~o, $KY(e), a, b, h1, hab), ltall_mono($AO, a, b, hab, t, h2))

def gtall_r($TK, +k: K, +xs: $ES, +ys: $ES, +h: $GTA(k, $APP(xs, ys))) -> $GTA(k, ys):
  match xs:
    case Nil{}:
      h
    case Con{+e, +t}:
      gtall_r($AK, k, t, ys, L.and_right(Cmp.is_lt(cmp(k, $KY(e))), gtall($AK, k, $APP(t, ys)), h))

def ltall_r($TK, +k: K, +xs: $ES, +ys: $ES, +h: $LTA(k, $APP(xs, ys))) -> $LTA(k, ys):
  match xs:
    case Nil{}:
      h
    case Con{+e, +t}:
      ltall_r($AK, k, t, ys, L.and_right(Cmp.is_lt(cmp($KY(e), k)), ltall($AK, k, $APP(t, ys)), h))

def gtall_l($TK, +k: K, +xs: $ES, +ys: $ES, +h: $GTA(k, $APP(xs, ys))) -> $GTA(k, xs):
  match xs:
    case Nil{}:
      {==}
    case Con{+e, +t}:
      L.and_intro(Cmp.is_lt(cmp(k, $KY(e))), gtall($AK, k, t), L.and_left(Cmp.is_lt(cmp(k, $KY(e))), gtall($AK, k, $APP(t, ys)), h), gtall_l($AK, k, t, ys, L.and_right(Cmp.is_lt(cmp(k, $KY(e))), gtall($AK, k, $APP(t, ys)), h)))

def ltall_l($TK, +k: K, +xs: $ES, +ys: $ES, +h: $LTA(k, $APP(xs, ys))) -> $LTA(k, xs):
  match xs:
    case Nil{}:
      {==}
    case Con{+e, +t}:
      L.and_intro(Cmp.is_lt(cmp($KY(e), k)), ltall($AK, k, t), L.and_left(Cmp.is_lt(cmp($KY(e), k)), ltall($AK, k, $APP(t, ys)), h), ltall_l($AK, k, t, ys, L.and_right(Cmp.is_lt(cmp($KY(e), k)), ltall($AK, k, $APP(t, ys)), h)))

# ---- sorted lists ----

def ord_tail($TK, +e: $E, +t: $ES, +h: $ORD(Con{e, t})) -> $ORD(t):
  match t:
    case Nil{}:
      {==}
    case Con{+e2, +u}:
      L.and_right(Cmp.is_lt(cmp($KY(e), $KY(e2))), ST.ordered($AK, Con{e2, u}), h)

def ord_gt($TO, +t: $ES, +e: $E, +h: $ORD(Con{e, t})) -> $GTA($KY(e), t):
  match t:
    case Nil{}:
      {==}
    case Con{+e2, +u}:
      +h1 = L.and_left(Cmp.is_lt(cmp($KY(e), $KY(e2))), ST.ordered($AK, Con{e2, u}), h)
      +h2 = L.and_right(Cmp.is_lt(cmp($KY(e), $KY(e2))), ST.ordered($AK, Con{e2, u}), h)
      L.and_intro(Cmp.is_lt(cmp($KY(e), $KY(e2))), gtall($AK, $KY(e), u), h1, gtall_mono($AO, $KY(e), $KY(e2), h1, u, ord_gt($AO, u, e2, h2)))

def ord_app_r($TK, +xs: $ES, +ys: $ES, +h: $ORD($APP(xs, ys))) -> $ORD(ys):
  match xs:
    case Nil{}:
      h
    case Con{+e, +t}:
      ord_app_r($AK, t, ys, ord_tail($AK, e, $APP(t, ys), h))

# the entries before e are below it
def ord_mid_l($TO, +xs: $ES, +e: $E, +ys: $ES, +h: $ORD($APP(xs, Con{e, ys}))) -> $LTA($KY(e), xs):
  match xs:
    case Nil{}:
      {==}
    case Con{+a, +t}:
      +g = gtall_r($AK, $KY(a), t, Con{e, ys}, ord_gt($AO, $APP(t, Con{e, ys}), a, h))
      L.and_intro(Cmp.is_lt(cmp($KY(a), $KY(e))), ltall($AK, $KY(e), t), L.and_left(Cmp.is_lt(cmp($KY(a), $KY(e))), gtall($AK, $KY(a), ys), g), ord_mid_l($AO, t, e, ys, ord_tail($AK, a, $APP(t, Con{e, ys}), h)))

# the entries after e are above it
def ord_mid_r($TO, +xs: $ES, +e: $E, +ys: $ES, +h: $ORD($APP(xs, Con{e, ys}))) -> $GTA($KY(e), ys):
  ord_gt($AO, ys, e, ord_app_r($AK, xs, Con{e, ys}, h))

# ---- lookup ----

def orm(-X: Data, m: Maybe<&2, X>, n: Maybe<&2, X>) -> Maybe<&2, X>:
  match m:
    case None{}:
      n
    case Some{x}:
      Some{x}

def orm_none(-X: Data, +m: Maybe<&2, X>) -> {orm(X, m, None{}) == m : Maybe<&2, X>}:
  match m:
    case None{}:
      {==}
    case Some{x}:
      {==}

def find_app_c($TK, +k: K, +e: $E, +t: $ES, +ys: $ES, +b: Bool, +hb: {S.is_eq(cmp(k, $KY(e))) == b : Bool}, +ih: {$FE(k, $APP(t, ys)) == orm($E, $FE(k, t), $FE(k, ys)) : $ME}) -> {$FE(k, $APP(Con{e, t}, ys)) == orm($E, $FE(k, Con{e, t}), $FE(k, ys)) : $ME}:
  match b:
    case True{}:
      %Equal.sym(Bool, S.is_eq(cmp(k, $KY(e))), True{}, hb) : {S.pick($ME, _, Some{e}, $FE(k, $APP(t, ys))) == orm($E, S.pick($ME, _, Some{e}, $FE(k, t)), $FE(k, ys)) : $ME}
      {==}
    case False{}:
      %Equal.sym(Bool, S.is_eq(cmp(k, $KY(e))), False{}, hb) : {S.pick($ME, _, Some{e}, $FE(k, $APP(t, ys))) == orm($E, S.pick($ME, _, Some{e}, $FE(k, t)), $FE(k, ys)) : $ME}
      ih

def find_app($TK, +k: K, +xs: $ES, +ys: $ES) -> {$FE(k, $APP(xs, ys)) == orm($E, $FE(k, xs), $FE(k, ys)) : $ME}:
  match xs:
    case Nil{}:
      {==}
    case Con{+e, +t}:
      find_app_c($AK, k, e, t, ys, S.is_eq(cmp(k, $KY(e))), {==}, find_app($AK, k, t, ys))

def gt_none($TK, +k: K, +es: $ES, +h: $GTA(k, es)) -> {$FE(k, es) == None{} : $ME}:
  match es:
    case Nil{}:
      {==}
    case Con{+e, +t}:
      %Equal.sym(Cmp, cmp(k, $KY(e)), LT{}, O.lt_is(cmp(k, $KY(e)), L.and_left(Cmp.is_lt(cmp(k, $KY(e))), gtall($AK, k, t), h))) : {S.pick($ME, S.is_eq(_), Some{e}, $FE(k, t)) == None{} : $ME}
      gt_none($AK, k, t, L.and_right(Cmp.is_lt(cmp(k, $KY(e))), gtall($AK, k, t), h))

def lt_none($TO, +k: K, +es: $ES, +h: $LTA(k, es)) -> {$FE(k, es) == None{} : $ME}:
  match es:
    case Nil{}:
      {==}
    case Con{+e, +t}:
      %Equal.sym(Cmp, cmp(k, $KY(e)), GT{}, lt_gt(~K, ~cmp, ~o, $KY(e), k, L.and_left(Cmp.is_lt(cmp($KY(e), k)), ltall($AK, k, t), h))) : {S.pick($ME, S.is_eq(_), Some{e}, $FE(k, t)) == None{} : $ME}
      lt_none($AO, k, t, L.and_right(Cmp.is_lt(cmp($KY(e), k)), ltall($AK, k, t), h))

# the lookup of k around an entry e of a sorted list, by cmp(k, e.key)
def find_mid_lt($TO, +k: K, +xs: $ES, +e: $E, +ys: $ES, +h: $ORD($APP(xs, Con{e, ys})), +hc: {cmp(k, $KY(e)) == LT{} : Cmp}) -> {$FE(k, $APP(xs, Con{e, ys})) == $FE(k, xs) : $ME}:
  %Equal.sym($ME, $FE(k, $APP(xs, Con{e, ys})), orm($E, $FE(k, xs), $FE(k, Con{e, ys})), find_app($AK, k, xs, Con{e, ys})) : {_ == $FE(k, xs) : $ME}
  %Equal.sym(Cmp, cmp(k, $KY(e)), LT{}, hc) : {orm($E, $FE(k, xs), S.pick($ME, S.is_eq(_), Some{e}, $FE(k, ys))) == $FE(k, xs) : $ME}
  +hlt = L.subst(Cmp, z => {Cmp.is_lt(z) == True{} : Bool}, LT{}, cmp(k, $KY(e)), Equal.sym(Cmp, cmp(k, $KY(e)), LT{}, hc), {==})
  %Equal.sym($ME, $FE(k, ys), None{}, gt_none($AK, k, ys, gtall_mono($AO, k, $KY(e), hlt, ys, ord_mid_r($AO, xs, e, ys, h)))) : {orm($E, $FE(k, xs), _) == $FE(k, xs) : $ME}
  orm_none($E, $FE(k, xs))

def find_mid_gt($TO, +k: K, +xs: $ES, +e: $E, +ys: $ES, +h: $ORD($APP(xs, Con{e, ys})), +hc: {cmp(k, $KY(e)) == GT{} : Cmp}) -> {$FE(k, $APP(xs, Con{e, ys})) == $FE(k, ys) : $ME}:
  %Equal.sym($ME, $FE(k, $APP(xs, Con{e, ys})), orm($E, $FE(k, xs), $FE(k, Con{e, ys})), find_app($AK, k, xs, Con{e, ys})) : {_ == $FE(k, ys) : $ME}
  %Equal.sym(Cmp, cmp(k, $KY(e)), GT{}, hc) : {orm($E, $FE(k, xs), S.pick($ME, S.is_eq(_), Some{e}, $FE(k, ys))) == $FE(k, ys) : $ME}
  %Equal.sym($ME, $FE(k, xs), None{}, lt_none($AO, k, xs, ltall_mono($AO, $KY(e), k, gt_lt(~K, ~cmp, ~o, k, $KY(e), hc), xs, ord_mid_l($AO, xs, e, ys, h)))) : {orm($E, _, $FE(k, ys)) == $FE(k, ys) : $ME}
  {==}

def find_mid_eq($TO, +k: K, +xs: $ES, +e: $E, +ys: $ES, +h: $ORD($APP(xs, Con{e, ys})), +hc: {cmp(k, $KY(e)) == EQ{} : Cmp}) -> {$FE(k, $APP(xs, Con{e, ys})) == Some{e} : $ME}:
  %Equal.sym($ME, $FE(k, $APP(xs, Con{e, ys})), orm($E, $FE(k, xs), $FE(k, Con{e, ys})), find_app($AK, k, xs, Con{e, ys})) : {_ == Some{e} : $ME}
  %Equal.sym(Cmp, cmp(k, $KY(e)), EQ{}, hc) : {orm($E, $FE(k, xs), S.pick($ME, S.is_eq(_), Some{e}, $FE(k, ys))) == Some{e} : $ME}
  +ek = O.antisym(~K, ~cmp, o, k, $KY(e), hc)
  +hl = L.subst(K, z => $LTA(z, xs), $KY(e), k, Equal.sym(K, k, $KY(e), ek), ord_mid_l($AO, xs, e, ys, h))
  %Equal.sym($ME, $FE(k, xs), None{}, lt_none($AO, k, xs, hl)) : {orm($E, _, Some{e}) == Some{e} : $ME}
  {==}
