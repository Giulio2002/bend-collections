import Base
import ../../lib/logic.bend as L
import ../../lib/nat.bend as N
import ../../lib/list.bend as LL
import ../../lib/array.bend as AR
import ../../../spec/lib/common.bend as SC
import ../../../src/containers/balanced_search_tree.bend as M
import ../../../src/containers/types/dynamic_array.bend as DE
import ./bk.bend as BK
import ./nsr.bend as NR
import ./nsf.bend as NF
import ./lk.bend as LKB
import ./da.bend as DA
import ./state.bend as ST

# The TreeMap's node store (the ns_* functions of the implementation) on the
# realization of a node list xs of length at most 2^d, d <= l <= 29: a read
# returns the list's node, a write in range updates the list, an append
# snocs it (doubling the capacity when full and below the limit), clear
# empties it. These are the statements the dynamic-array lemmas of arr.bend
# make for a dynamic array of nodes.

%def ND M.Node<K>
%def NSK M.NodeStore<K>
%def RES Result<&2, &2, DE.Error, $ND>
%def RU Result<&2, &2, DE.Error, Unit>
%def NL List<&2, Nat>
%def AN Array<Nat>
%def NRL(d, xs) NR.real(~K, l, d, xs)
%def LRL(xs) NR.lrs(~K, xs)
%def TPL(xs) NR.tps(~K, xs)
%def LKL(d, fl, gl) AR.thaw(Nat, AR.TNode{BK.bk(Nat, 1n+d, fl, 0n), BK.bk(Nat, 1n+d, gl, 0n)})
%def LK(d, xs) $LKL(d, $LRL(xs), $TPL(xs))
%def KB(d, xs) AR.thaw(Maybe<&2, K>, BK.bk(Maybe<&2, K>, d, NR.keys(~K, xs), None{}))
%def ARRS(d, xs) $LK(d, xs), $KB(d, xs)
%def GP +l: Nat, +d: Nat, +xs: List<&2, $ND>, +hl: {Nat.is_le(l, 29n) == True{} : Bool}, +hd: {Nat.is_le(d, l) == True{} : Bool}, +hc: {Nat.is_le(SC.length($ND, xs), SC.pow2(d)) == True{} : Bool}
%def GA l, d, xs, hl, hd, hc
%def N0 SC.length($ND, xs)
%def P0 SC.pow2(d)
%def HE he2(l, d, hl, hd)
%def LRC NF.lrs_cap(~K, d, xs, hc)
%def TPC NF.tps_cap(~K, d, xs, hc)
%def IL(i) Nat.double(i)
%def IR(i) 1n+Nat.double(i)
%def IT(i) Nat.double(Nat.add($P0, i))
%def IP(i) 1n+Nat.double(Nat.add($P0, i))
%def HL(i) Nat.add(Nat.double($P0), Nat.double(i))
%def HR(i) Nat.add(Nat.double($P0), 1n+Nat.double(i))
%def UN(j) U32.from_nat(j)
%def LA(fl, gl, cf, cg) Nat, 1n+d, fl, gl, 0n, $HE, cf, cg
%def SET4(a, ia, va, ib, vb, ic, vc, id, vd) Array.set(Nat, Array.set(Nat, Array.set(Nat, Array.set(Nat, a, $UN(ia), va), $UN(ib), vb), $UN(ic), vc), $UN(id), vd)
%def SET2(a, ic, vc, id, vd) Array.set(Nat, Array.set(Nat, a, $UN(ic), vc), $UN(id), vd)

def isj(-A: Data, m: Maybe<&2, A>) -> Bool:
  match m:
    case None{}:
      False{}
    case Some{x}:
      True{}

# a slot below the length holds something
def nth_isj(-A: Data, +xs: List<&2, A>, +i: Nat, +h: {Nat.is_lt(i, SC.length(A, xs)) == True{} : Bool}) -> {isj(A, SC.nth(A, xs, i)) == True{} : Bool}:
  match xs i:
    case Nil{} _:
      Empty.absurd({isj(A, SC.nth(A, Nil{}, i)) == True{} : Bool}, N.lt_zero_absurd(i, h))
    case Con{x, r} 0n:
      {==}
    case Con{x, +r} 1n+q:
      nth_isj(A, r, q, h)

def len_init(-A: Data, +xs: List<&2, A>, +m: Nat, +h: {SC.length(A, xs) == 1n+m : Nat}) -> {SC.length(A, SC.init(A, xs)) == m : Nat}:
  match xs m:
    case Nil{} _:
      Empty.absurd({SC.length(A, SC.init(A, Nil{})) == m : Nat}, N.zero_succ(m, h))
    case Con{x, Nil{}} 0n:
      {==}
    case Con{x, Nil{}} 1n+q:
      Empty.absurd({SC.length(A, SC.init(A, Con{x, Nil{}})) == 1n+q : Nat}, N.zero_succ(q, N.succ_inj(0n, 1n+q, h)))
    case Con{x, Con{y, t}} 0n:
      Empty.absurd({SC.length(A, SC.init(A, Con{x, Con{y, t}})) == 0n : Nat}, N.succ_zero(SC.length(A, t), N.succ_inj(1n+SC.length(A, t), 0n, h)))
    case Con{x, Con{+y, +t}} 1n+q:
      N.succ_cong(SC.length(A, SC.init(A, Con{y, t})), q, len_init(A, Con{y, t}, q, N.succ_inj(1n+SC.length(A, t), 1n+q, h)))

# a node is its encoding read back
def mk_enc(~K: Data, +y: $ND) -> {M.mk_node(~K, M.ntag(~K, y), M.nleft(~K, y), M.nright(~K, y), M.nparent(~K, y), M.nkey(~K, y)) == y : $ND}:
  match y:
    case M.Free{x}:
      {==}
    case M.N{True{}, lf, rt, pa, k}:
      {==}
    case M.N{False{}, lf, rt, pa, k}:
      {==}

# ---- length ----

def ns_length_ok(~K: Data, $GP) -> {M.ns_length(~K, $NRL(d, xs)) == ($NRL(d, xs), $N0) : $NSK & Nat}:
  {==}

# ---- the links array: indices and bounds ----

# the depth of the links array's halves is below 31
def he2(+l: Nat, +d: Nat, +hl: {Nat.is_le(l, 29n) == True{} : Bool}, +hd: {Nat.is_le(d, l) == True{} : Bool}) -> {Nat.is_lt(1n+(1n+d), 32n) == True{} : Bool}:
  N.le_lt_succ(d, 29n, N.le_trans(d, l, 29n, hd, hl))

# slot 2(p+i) of the array is slot 2i of its high half, 2(p+i)+1 slot 2i+1
def ixt(+p: Nat, +i: Nat) -> {Nat.add(Nat.double(p), Nat.double(i)) == Nat.double(Nat.add(p, i)) : Nat}:
  N.add_double(p, i)

def ixp(+p: Nat, +i: Nat) -> {Nat.add(Nat.double(p), 1n+Nat.double(i)) == 1n+Nat.double(Nat.add(p, i)) : Nat}:
  Equal.trans(Nat, Nat.add(Nat.double(p), 1n+Nat.double(i)), 1n+Nat.add(Nat.double(p), Nat.double(i)), 1n+Nat.double(Nat.add(p, i)), N.add_succ(Nat.double(p), Nat.double(i)), N.succ_cong(Nat.add(Nat.double(p), Nat.double(i)), Nat.double(Nat.add(p, i)), N.add_double(p, i)))

# both slots of node i are below the length of a pair list of n nodes
def dl0(+n: Nat, +i: Nat, +pl: $NL, +hlen: {SC.length(Nat, pl) == Nat.double(n) : Nat}, +hi: {Nat.is_lt(i, n) == True{} : Bool}) -> {Nat.is_lt(Nat.double(i), SC.length(Nat, pl)) == True{} : Bool}:
  %Equal.sym(Nat, SC.length(Nat, pl), Nat.double(n), hlen) : {Nat.is_lt(Nat.double(i), _) == True{} : Bool}
  N.double_lt(i, n, hi)

def dl1(+n: Nat, +i: Nat, +pl: $NL, +hlen: {SC.length(Nat, pl) == Nat.double(n) : Nat}, +hi: {Nat.is_lt(i, n) == True{} : Bool}) -> {Nat.is_lt(1n+Nat.double(i), SC.length(Nat, pl)) == True{} : Bool}:
  %Equal.sym(Nat, SC.length(Nat, pl), Nat.double(n), hlen) : {Nat.is_lt(1n+Nat.double(i), _) == True{} : Bool}
  N.succ_le_lt(1n+Nat.double(i), Nat.double(n), N.double_le(1n+i, n, N.lt_succ_le_succ(i, n, hi)))

# ---- the links array: reading a field of a node ----

%def HY +i: Nat, +y: $ND, +hy: {SC.nth($ND, xs, i) == Some{y} : Maybe<&2, $ND>}

def left_get(~K: Data, $GP, $HY) -> {Array.get(Nat, $LK(d, xs), $UN($IL(i))) == ($LK(d, xs), M.nleft(~K, y)) : $AN & Nat}:
  LKB.get_lo($LA($LRL(xs), $TPL(xs), $LRC, $TPC), $IL(i), M.nleft(~K, y), NF.lrs_nth0(~K, xs, i, y, hy))

def right_get(~K: Data, $GP, $HY) -> {Array.get(Nat, $LK(d, xs), $UN($IR(i))) == ($LK(d, xs), M.nright(~K, y)) : $AN & Nat}:
  LKB.get_lo($LA($LRL(xs), $TPL(xs), $LRC, $TPC), $IR(i), M.nright(~K, y), NF.lrs_nth1(~K, xs, i, y, hy))

def tag_get(~K: Data, $GP, $HY) -> {Array.get(Nat, $LK(d, xs), $UN($IT(i))) == ($LK(d, xs), M.ntag(~K, y)) : $AN & Nat}:
  %ixt($P0, i) : {Array.get(Nat, $LK(d, xs), $UN(_)) == ($LK(d, xs), M.ntag(~K, y)) : $AN & Nat}
  LKB.get_hi($LA($LRL(xs), $TPL(xs), $LRC, $TPC), $IL(i), M.ntag(~K, y), NF.tps_nth0(~K, xs, i, y, hy))

def parent_get(~K: Data, $GP, $HY) -> {Array.get(Nat, $LK(d, xs), $UN($IP(i))) == ($LK(d, xs), M.nparent(~K, y)) : $AN & Nat}:
  %ixp($P0, i) : {Array.get(Nat, $LK(d, xs), $UN(_)) == ($LK(d, xs), M.nparent(~K, y)) : $AN & Nat}
  LKB.get_hi($LA($LRL(xs), $TPL(xs), $LRC, $TPC), $IR(i), M.nparent(~K, y), NF.tps_nth1(~K, xs, i, y, hy))

# ---- the links array: writing one field of a node (the others kept) ----

%def UY SC.update($ND, xs, i, y)
%def HY0 +i: Nat, +y0: $ND, +y: $ND, +hy0: {SC.nth($ND, xs, i) == Some{y0} : Maybe<&2, $ND>}
%def EL +el: {M.nleft(~K, y0) == M.nleft(~K, y) : Nat}
%def ER +er: {M.nright(~K, y0) == M.nright(~K, y) : Nat}
%def ET +et: {M.ntag(~K, y0) == M.ntag(~K, y) : Nat}
%def EP +ep: {M.nparent(~K, y0) == M.nparent(~K, y) : Nat}
%def HI0 LL.nth_lt_length($ND, xs, i, y0, hy0)

def left_aset(~K: Data, $GP, $HY0, $ER, $ET, $EP) -> {Array.set(Nat, $LK(d, xs), $UN($IL(i)), M.nleft(~K, y)) == $LK(d, $UY) : $AN}:
  %Equal.sym($AN, Array.set(Nat, $LK(d, xs), $UN($IL(i)), M.nleft(~K, y)), $LKL(d, SC.update(Nat, $LRL(xs), $IL(i), M.nleft(~K, y)), $TPL(xs)), LKB.set_lo($LA($LRL(xs), $TPL(xs), $LRC, $TPC), $IL(i), M.nleft(~K, y), dl0($N0, i, $LRL(xs), NF.lrs_len(~K, xs), $HI0))) : {_ == $LK(d, $UY) : $AN}
  %Equal.sym($NL, SC.update(Nat, $LRL(xs), $IL(i), M.nleft(~K, y)), $LRL($UY), NF.lrs_upd0(~K, xs, i, y0, y, hy0, er)) : {$LKL(d, _, $TPL(xs)) == $LK(d, $UY) : $AN}
  %Equal.sym($NL, $TPL($UY), $TPL(xs), NF.tps_keep(~K, xs, i, y0, y, hy0, et, ep)) : {$LKL(d, $LRL($UY), $TPL(xs)) == $LKL(d, $LRL($UY), _) : $AN}
  {==}

def right_aset(~K: Data, $GP, $HY0, $EL, $ET, $EP) -> {Array.set(Nat, $LK(d, xs), $UN($IR(i)), M.nright(~K, y)) == $LK(d, $UY) : $AN}:
  %Equal.sym($AN, Array.set(Nat, $LK(d, xs), $UN($IR(i)), M.nright(~K, y)), $LKL(d, SC.update(Nat, $LRL(xs), $IR(i), M.nright(~K, y)), $TPL(xs)), LKB.set_lo($LA($LRL(xs), $TPL(xs), $LRC, $TPC), $IR(i), M.nright(~K, y), dl1($N0, i, $LRL(xs), NF.lrs_len(~K, xs), $HI0))) : {_ == $LK(d, $UY) : $AN}
  %Equal.sym($NL, SC.update(Nat, $LRL(xs), $IR(i), M.nright(~K, y)), $LRL($UY), NF.lrs_upd1(~K, xs, i, y0, y, hy0, el)) : {$LKL(d, _, $TPL(xs)) == $LK(d, $UY) : $AN}
  %Equal.sym($NL, $TPL($UY), $TPL(xs), NF.tps_keep(~K, xs, i, y0, y, hy0, et, ep)) : {$LKL(d, $LRL($UY), $TPL(xs)) == $LKL(d, $LRL($UY), _) : $AN}
  {==}

def tag_aset(~K: Data, $GP, $HY0, $EL, $ER, $EP) -> {Array.set(Nat, $LK(d, xs), $UN($IT(i)), M.ntag(~K, y)) == $LK(d, $UY) : $AN}:
  %ixt($P0, i) : {Array.set(Nat, $LK(d, xs), $UN(_), M.ntag(~K, y)) == $LK(d, $UY) : $AN}
  %Equal.sym($AN, Array.set(Nat, $LK(d, xs), $UN($HL(i)), M.ntag(~K, y)), $LKL(d, $LRL(xs), SC.update(Nat, $TPL(xs), $IL(i), M.ntag(~K, y))), LKB.set_hi($LA($LRL(xs), $TPL(xs), $LRC, $TPC), $IL(i), M.ntag(~K, y), dl0($N0, i, $TPL(xs), NF.tps_len(~K, xs), $HI0))) : {_ == $LK(d, $UY) : $AN}
  %Equal.sym($NL, SC.update(Nat, $TPL(xs), $IL(i), M.ntag(~K, y)), $TPL($UY), NF.tps_upd0(~K, xs, i, y0, y, hy0, ep)) : {$LKL(d, $LRL(xs), _) == $LK(d, $UY) : $AN}
  %Equal.sym($NL, $LRL($UY), $LRL(xs), NF.lrs_keep(~K, xs, i, y0, y, hy0, el, er)) : {$LKL(d, $LRL(xs), $TPL($UY)) == $LKL(d, _, $TPL($UY)) : $AN}
  {==}

def parent_aset(~K: Data, $GP, $HY0, $EL, $ER, $ET) -> {Array.set(Nat, $LK(d, xs), $UN($IP(i)), M.nparent(~K, y)) == $LK(d, $UY) : $AN}:
  %ixp($P0, i) : {Array.set(Nat, $LK(d, xs), $UN(_), M.nparent(~K, y)) == $LK(d, $UY) : $AN}
  %Equal.sym($AN, Array.set(Nat, $LK(d, xs), $UN($HR(i)), M.nparent(~K, y)), $LKL(d, $LRL(xs), SC.update(Nat, $TPL(xs), $IR(i), M.nparent(~K, y))), LKB.set_hi($LA($LRL(xs), $TPL(xs), $LRC, $TPC), $IR(i), M.nparent(~K, y), dl1($N0, i, $TPL(xs), NF.tps_len(~K, xs), $HI0))) : {_ == $LK(d, $UY) : $AN}
  %Equal.sym($NL, SC.update(Nat, $TPL(xs), $IR(i), M.nparent(~K, y)), $TPL($UY), NF.tps_upd1(~K, xs, i, y0, y, hy0, et)) : {$LKL(d, $LRL(xs), _) == $LK(d, $UY) : $AN}
  %Equal.sym($NL, $LRL($UY), $LRL(xs), NF.lrs_keep(~K, xs, i, y0, y, hy0, el, er)) : {$LKL(d, $LRL(xs), $TPL($UY)) == $LKL(d, _, $TPL($UY)) : $AN}
  {==}

# ---- read ----

def get_some(~K: Data, $GP, +i: Nat, +y: $ND, +hy: {SC.nth($ND, xs, i) == Some{y} : Maybe<&2, $ND>}) -> {M.ns_get_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, True{}) == ($NRL(d, xs), DA.item($ND, Some{y})) : $NSK & $RES}:
  %Equal.sym($AN & Nat, Array.get(Nat, $LK(d, xs), $UN($IT(i))), ($LK(d, xs), M.ntag(~K, y)), tag_get(~K, $GA, i, y, hy)) : {M.ns_rt(~K, l, d, $P0, $N0, $KB(d, xs), i, _) == ($NRL(d, xs), DA.item($ND, Some{y})) : $NSK & $RES}
  %Equal.sym($AN & Nat, Array.get(Nat, $LK(d, xs), $UN($IL(i))), ($LK(d, xs), M.nleft(~K, y)), left_get(~K, $GA, i, y, hy)) : {M.ns_rl(~K, l, d, $P0, $N0, $KB(d, xs), i, M.ntag(~K, y), _) == ($NRL(d, xs), DA.item($ND, Some{y})) : $NSK & $RES}
  %Equal.sym($AN & Nat, Array.get(Nat, $LK(d, xs), $UN($IR(i))), ($LK(d, xs), M.nright(~K, y)), right_get(~K, $GA, i, y, hy)) : {M.ns_rr(~K, l, d, $P0, $N0, $KB(d, xs), i, M.ntag(~K, y), M.nleft(~K, y), _) == ($NRL(d, xs), DA.item($ND, Some{y})) : $NSK & $RES}
  %Equal.sym($AN & Nat, Array.get(Nat, $LK(d, xs), $UN($IP(i))), ($LK(d, xs), M.nparent(~K, y)), parent_get(~K, $GA, i, y, hy)) : {M.ns_rp(~K, l, d, $P0, $N0, $KB(d, xs), i, M.ntag(~K, y), M.nleft(~K, y), M.nright(~K, y), _) == ($NRL(d, xs), DA.item($ND, Some{y})) : $NSK & $RES}
  %Equal.sym(Array<Maybe<&2, K>> & Maybe<&2, K>, Array.get(Maybe<&2, K>, $KB(d, xs), U32.from_nat(i)), ($KB(d, xs), M.nkey(~K, y)), NF.key_get(~K, $GA, i, y, hy)) : {M.ns_rk(~K, l, d, $P0, $N0, $LK(d, xs), M.ntag(~K, y), M.nleft(~K, y), M.nright(~K, y), M.nparent(~K, y), _) == ($NRL(d, xs), DA.item($ND, Some{y})) : $NSK & $RES}
  %Equal.sym($ND, M.mk_node(~K, M.ntag(~K, y), M.nleft(~K, y), M.nright(~K, y), M.nparent(~K, y), M.nkey(~K, y)), y, mk_enc(~K, y)) : {(M.NS{l, d, $P0, $N0, $ARRS(d, xs)}, Done{_}) == ($NRL(d, xs), DA.item($ND, Some{y})) : $NSK & $RES}
  {==}

def gs(~K: Data, $GP, +i: Nat, +mv: Maybe<&2, $ND>, +hmv: {SC.nth($ND, xs, i) == mv : Maybe<&2, $ND>}, +hi: {Nat.is_lt(i, $N0) == True{} : Bool}) -> {M.ns_get_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, True{}) == ($NRL(d, xs), DA.item($ND, mv)) : $NSK & $RES}:
  match mv:
    case None{}:
      Empty.absurd({M.ns_get_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, True{}) == ($NRL(d, xs), DA.item($ND, None{})) : $NSK & $RES}, L.false_true(L.subst(Maybe<&2, $ND>, z => {isj($ND, z) == True{} : Bool}, SC.nth($ND, xs, i), None{}, hmv, nth_isj($ND, xs, i, hi))))
    case Some{+y}:
      get_some(~K, $GA, i, y, hmv)

def gc(~K: Data, $GP, +i: Nat, +b: Bool, +hb: {Nat.is_lt(i, $N0) == b : Bool}) -> {M.ns_get_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, b) == ($NRL(d, xs), DA.item($ND, SC.nth($ND, xs, i))) : $NSK & $RES}:
  match b:
    case True{}:
      gs(~K, $GA, i, SC.nth($ND, xs, i), {==}, hb)
    case False{}:
      %Equal.sym(Maybe<&2, $ND>, SC.nth($ND, xs, i), None{}, LL.nth_none($ND, xs, i, N.not_lt_le(i, $N0, hb))) : {M.ns_get_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, False{}) == ($NRL(d, xs), DA.item($ND, _)) : $NSK & $RES}
      {==}

# a read returns the list's node (IndexOutOfRange past the length)
def ns_get_ok(~K: Data, $GP, +i: Nat) -> {M.ns_get(~K, $NRL(d, xs), i) == ($NRL(d, xs), DA.item($ND, SC.nth($ND, xs, i))) : $NSK & $RES}:
  gc(~K, $GA, i, Nat.is_lt(i, $N0), {==})

# ---- write ----

%def UPD SC.update($ND, xs, i, x)
%def VL M.nleft(~K, x)
%def VR M.nright(~K, x)
%def VT M.ntag(~K, x)
%def VP M.nparent(~K, x)

# the four link slots of a node below the length written: the node replaced
def links_put(~K: Data, $GP, +i: Nat, +x: $ND, +hi: {Nat.is_lt(i, $N0) == True{} : Bool}) -> {$SET4($LK(d, xs), $IL(i), $VL, $IR(i), $VR, $IT(i), $VT, $IP(i), $VP) == $LK(d, $UPD) : $AN}:
  +cu = NF.lrs_cap(~K, d, $UPD, LKB.cap_upd($ND, $P0, xs, i, x, hc))
  %Equal.sym($AN, $SET2($LK(d, xs), $IL(i), $VL, $IR(i), $VR), $LKL(d, SC.update(Nat, SC.update(Nat, $LRL(xs), $IL(i), $VL), $IR(i), $VR), $TPL(xs)), LKB.set2_lo($LA($LRL(xs), $TPL(xs), $LRC, $TPC), $IL(i), $VL, $IR(i), $VR, dl0($N0, i, $LRL(xs), NF.lrs_len(~K, xs), hi), dl1($N0, i, $LRL(xs), NF.lrs_len(~K, xs), hi))) : {$SET2(_, $IT(i), $VT, $IP(i), $VP) == $LK(d, $UPD) : $AN}
  %Equal.sym($NL, SC.update(Nat, SC.update(Nat, $LRL(xs), $IL(i), $VL), $IR(i), $VR), $LRL($UPD), NF.lrs_put(~K, xs, i, x)) : {$SET2($LKL(d, _, $TPL(xs)), $IT(i), $VT, $IP(i), $VP) == $LK(d, $UPD) : $AN}
  %ixt($P0, i) : {$SET2($LKL(d, $LRL($UPD), $TPL(xs)), _, $VT, $IP(i), $VP) == $LK(d, $UPD) : $AN}
  %ixp($P0, i) : {$SET2($LKL(d, $LRL($UPD), $TPL(xs)), $HL(i), $VT, _, $VP) == $LK(d, $UPD) : $AN}
  %Equal.sym($AN, $SET2($LKL(d, $LRL($UPD), $TPL(xs)), $HL(i), $VT, $HR(i), $VP), $LKL(d, $LRL($UPD), SC.update(Nat, SC.update(Nat, $TPL(xs), $IL(i), $VT), $IR(i), $VP)), LKB.set2_hi($LA($LRL($UPD), $TPL(xs), cu, $TPC), $IL(i), $VT, $IR(i), $VP, dl0($N0, i, $TPL(xs), NF.tps_len(~K, xs), hi), dl1($N0, i, $TPL(xs), NF.tps_len(~K, xs), hi))) : {_ == $LK(d, $UPD) : $AN}
  %Equal.sym($NL, SC.update(Nat, SC.update(Nat, $TPL(xs), $IL(i), $VT), $IR(i), $VP), $TPL($UPD), NF.tps_put(~K, xs, i, x)) : {$LKL(d, $LRL($UPD), _) == $LK(d, $UPD) : $AN}
  {==}

def set_some(~K: Data, $GP, +i: Nat, +x: $ND, +y0: $ND, +hy0: {SC.nth($ND, xs, i) == Some{y0} : Maybe<&2, $ND>}) -> {M.ns_set_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, x, True{}) == ($NRL(d, $UPD), Done{Unit{}}) : $NSK & $RU}:
  %Equal.sym($AN, $SET4($LK(d, xs), $IL(i), $VL, $IR(i), $VR, $IT(i), $VT, $IP(i), $VP), $LK(d, $UPD), links_put(~K, $GA, i, x, LL.nth_lt_length($ND, xs, i, y0, hy0))) : {(M.NS{l, d, $P0, $N0, _, Array.set(Maybe<&2, K>, $KB(d, xs), U32.from_nat(i), M.nkey(~K, x))}, Done{Unit{}}) == ($NRL(d, $UPD), Done{Unit{}}) : $NSK & $RU}
  %Equal.sym(Array<Maybe<&2, K>>, Array.set(Maybe<&2, K>, $KB(d, xs), U32.from_nat(i), M.nkey(~K, x)), $KB(d, $UPD), NF.key_set(~K, $GA, i, y0, hy0, x)) : {(M.NS{l, d, $P0, $N0, $LK(d, $UPD), _}, Done{Unit{}}) == ($NRL(d, $UPD), Done{Unit{}}) : $NSK & $RU}
  %Equal.sym(Nat, SC.length($ND, $UPD), $N0, LL.length_update($ND, xs, i, x)) : {(M.NS{l, d, $P0, $N0, $ARRS(d, $UPD)}, Done{Unit{}}) == (M.NS{l, d, $P0, _, $ARRS(d, $UPD)}, Done{Unit{}}) : $NSK & $RU}
  {==}

def ws(~K: Data, $GP, +i: Nat, +x: $ND, +mv: Maybe<&2, $ND>, +hmv: {SC.nth($ND, xs, i) == mv : Maybe<&2, $ND>}, +hi: {Nat.is_lt(i, $N0) == True{} : Bool}) -> {M.ns_set_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, x, True{}) == ($NRL(d, $UPD), Done{Unit{}}) : $NSK & $RU}:
  match mv:
    case None{}:
      Empty.absurd({M.ns_set_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, x, True{}) == ($NRL(d, $UPD), Done{Unit{}}) : $NSK & $RU}, L.false_true(L.subst(Maybe<&2, $ND>, z => {isj($ND, z) == True{} : Bool}, SC.nth($ND, xs, i), None{}, hmv, nth_isj($ND, xs, i, hi))))
    case Some{+y0}:
      set_some(~K, $GA, i, x, y0, hmv)

# a write below the length updates the list
def ns_set_in(~K: Data, $GP, +i: Nat, +x: $ND, +h: {Nat.is_lt(i, $N0) == True{} : Bool}) -> {M.ns_set(~K, $NRL(d, xs), i, x) == ($NRL(d, $UPD), Done{Unit{}}) : $NSK & $RU}:
  %Equal.sym(Bool, Nat.is_lt(i, $N0), True{}, h) : {M.ns_set_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, x, _) == ($NRL(d, $UPD), Done{Unit{}}) : $NSK & $RU}
  ws(~K, $GA, i, x, SC.nth($ND, xs, i), {==}, h)

# a write past the length changes nothing
def ns_set_out(~K: Data, $GP, +i: Nat, +x: $ND, +h: {Nat.is_lt(i, $N0) == False{} : Bool}) -> {M.ns_set(~K, $NRL(d, xs), i, x) == ($NRL(d, xs), Fail{DE.IndexOutOfRange{}}) : $NSK & $RU}:
  %Equal.sym(Bool, Nat.is_lt(i, $N0), False{}, h) : {M.ns_set_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, x, _) == ($NRL(d, xs), Fail{DE.IndexOutOfRange{}}) : $NSK & $RU}
  {==}


# ---- append ----

%def SN SC.snoc($ND, xs, x)
%def HN +hn: {Nat.is_lt($N0, $P0) == True{} : Bool}
%def DN Nat.double($N0)

# room for both slots of a node past the length of a pair list
def dn1(+n: Nat, +p: Nat, +pl: $NL, +hlen: {SC.length(Nat, pl) == Nat.double(n) : Nat}, +h: {Nat.is_lt(n, p) == True{} : Bool}) -> {Nat.is_lt(1n+SC.length(Nat, pl), Nat.double(p)) == True{} : Bool}:
  %Equal.sym(Nat, SC.length(Nat, pl), Nat.double(n), hlen) : {Nat.is_lt(1n+_, Nat.double(p)) == True{} : Bool}
  N.succ_le_lt(1n+Nat.double(n), Nat.double(p), N.double_le(1n+n, p, N.lt_succ_le_succ(n, p, h)))

def cap_sn(~K: Data, +d: Nat, +xs: List<&2, $ND>, +x: $ND, $HN) -> {Nat.is_le(SC.length($ND, $SN), $P0) == True{} : Bool}:
  %Equal.sym(Nat, SC.length($ND, $SN), 1n+$N0, LL.length_snoc($ND, xs, x)) : {Nat.is_le(_, $P0) == True{} : Bool}
  N.lt_succ_le_succ($N0, $P0, hn)

# the four link slots at the length written: the node appended
def links_push(~K: Data, $GP, +x: $ND, $HN) -> {$SET4($LK(d, xs), $IL($N0), $VL, $IR($N0), $VR, $IT($N0), $VT, $IP($N0), $VP) == $LK(d, $SN) : $AN}:
  +cs = NF.lrs_cap(~K, d, $SN, cap_sn(~K, d, xs, x, hn))
  %NF.lrs_len(~K, xs) : {$SET4($LK(d, xs), _, $VL, 1n+_, $VR, $IT($N0), $VT, $IP($N0), $VP) == $LK(d, $SN) : $AN}
  %Equal.sym($AN, $SET2($LK(d, xs), SC.length(Nat, $LRL(xs)), $VL, 1n+SC.length(Nat, $LRL(xs)), $VR), $LKL(d, SC.snoc(Nat, SC.snoc(Nat, $LRL(xs), $VL), $VR), $TPL(xs)), LKB.push2_lo($LA($LRL(xs), $TPL(xs), $LRC, $TPC), $VL, $VR, dn1($N0, $P0, $LRL(xs), NF.lrs_len(~K, xs), hn))) : {$SET2(_, $IT($N0), $VT, $IP($N0), $VP) == $LK(d, $SN) : $AN}
  %Equal.sym($NL, SC.snoc(Nat, SC.snoc(Nat, $LRL(xs), $VL), $VR), $LRL($SN), NF.lrs_snoc(~K, xs, x)) : {$SET2($LKL(d, _, $TPL(xs)), $IT($N0), $VT, $IP($N0), $VP) == $LK(d, $SN) : $AN}
  %ixt($P0, $N0) : {$SET2($LKL(d, $LRL($SN), $TPL(xs)), _, $VT, $IP($N0), $VP) == $LK(d, $SN) : $AN}
  %ixp($P0, $N0) : {$SET2($LKL(d, $LRL($SN), $TPL(xs)), $HL($N0), $VT, _, $VP) == $LK(d, $SN) : $AN}
  %NF.tps_len(~K, xs) : {$SET2($LKL(d, $LRL($SN), $TPL(xs)), Nat.add(Nat.double($P0), _), $VT, Nat.add(Nat.double($P0), 1n+_), $VP) == $LK(d, $SN) : $AN}
  %Equal.sym($AN, $SET2($LKL(d, $LRL($SN), $TPL(xs)), Nat.add(Nat.double($P0), SC.length(Nat, $TPL(xs))), $VT, Nat.add(Nat.double($P0), 1n+SC.length(Nat, $TPL(xs))), $VP), $LKL(d, $LRL($SN), SC.snoc(Nat, SC.snoc(Nat, $TPL(xs), $VT), $VP)), LKB.push2_hi($LA($LRL($SN), $TPL(xs), cs, $TPC), $VT, $VP, dn1($N0, $P0, $TPL(xs), NF.tps_len(~K, xs), hn))) : {_ == $LK(d, $SN) : $AN}
  %Equal.sym($NL, SC.snoc(Nat, SC.snoc(Nat, $TPL(xs), $VT), $VP), $TPL($SN), NF.tps_snoc(~K, xs, x)) : {$LKL(d, $LRL($SN), _) == $LK(d, $SN) : $AN}
  {==}

def push_at(~K: Data, $GP, +x: $ND, $HN) -> {M.ns_put(~K, l, d, $P0, 1n+$N0, $ARRS(d, xs), $N0, x) == $NRL(d, $SN) : $NSK}:
  %Equal.sym($AN, $SET4($LK(d, xs), $IL($N0), $VL, $IR($N0), $VR, $IT($N0), $VT, $IP($N0), $VP), $LK(d, $SN), links_push(~K, $GA, x, hn)) : {M.NS{l, d, $P0, 1n+$N0, _, Array.set(Maybe<&2, K>, $KB(d, xs), U32.from_nat($N0), M.nkey(~K, x))} == $NRL(d, $SN) : $NSK}
  %Equal.sym(Array<Maybe<&2, K>>, Array.set(Maybe<&2, K>, $KB(d, xs), U32.from_nat($N0), M.nkey(~K, x)), $KB(d, $SN), NF.key_push(~K, $GA, x, hn)) : {M.NS{l, d, $P0, 1n+$N0, $LK(d, $SN), _} == $NRL(d, $SN) : $NSK}
  %Equal.sym(Nat, SC.length($ND, $SN), 1n+$N0, LL.length_snoc($ND, xs, x)) : {M.NS{l, d, $P0, 1n+$N0, $ARRS(d, $SN)} == M.NS{l, d, $P0, _, $ARRS(d, $SN)} : $NSK}
  {==}

# with room: the node appended
def ns_push_room(~K: Data, $GP, +x: $ND, $HN) -> {M.ns_push(~K, $NRL(d, xs), x) == ($NRL(d, $SN), Done{Unit{}}) : $NSK & $RU}:
  %Equal.sym(Bool, Nat.is_lt($N0, $P0), True{}, hn) : {M.ns_push_room(~K, l, d, $P0, $N0, $ARRS(d, xs), x, _, Nat.is_lt(d, l)) == ($NRL(d, $SN), Done{Unit{}}) : $NSK & $RU}
  Equal.cong($NSK, $NSK & $RU, z => (z, Done{Unit{}}), M.ns_put(~K, l, d, $P0, 1n+$N0, $ARRS(d, xs), $N0, x), $NRL(d, $SN), push_at(~K, $GA, x, hn))

# full and below the limit: the blocks doubled, then the node appended
def ns_push_grow(~K: Data, $GP, +x: $ND, +hn: {Nat.is_lt($N0, $P0) == False{} : Bool}, +hdl: {Nat.is_lt(d, l) == True{} : Bool}) -> {M.ns_push(~K, $NRL(d, xs), x) == ($NRL(1n+d, $SN), Done{Unit{}}) : $NSK & $RU}:
  +hd1 = N.lt_succ_le_succ(d, l, hdl)
  +hc1 = N.le_trans($N0, $P0, SC.pow2(1n+d), hc, N.lt_le($P0, SC.pow2(1n+d), N.pow2_lt_succ(d)))
  +hn1 = N.le_lt_trans($N0, $P0, SC.pow2(1n+d), hc, N.pow2_lt_succ(d))
  %Equal.sym(Bool, Nat.is_lt($N0, $P0), False{}, hn) : {M.ns_push_room(~K, l, d, $P0, $N0, $ARRS(d, xs), x, _, Nat.is_lt(d, l)) == ($NRL(1n+d, $SN), Done{Unit{}}) : $NSK & $RU}
  %Equal.sym(Bool, Nat.is_lt(d, l), True{}, hdl) : {M.ns_push_room(~K, l, d, $P0, $N0, $ARRS(d, xs), x, False{}, _) == ($NRL(1n+d, $SN), Done{Unit{}}) : $NSK & $RU}
  %Equal.sym($AN, ANode{ANode{AR.thaw(Nat, BK.bk(Nat, 1n+d, $LRL(xs), 0n)), Array.new(Nat, 1n+d, 0n)}, ANode{AR.thaw(Nat, BK.bk(Nat, 1n+d, $TPL(xs), 0n)), Array.new(Nat, 1n+d, 0n)}}, $LK(1n+d, xs), LKB.grow($LA($LRL(xs), $TPL(xs), $LRC, $TPC))) : {(M.ns_put(~K, l, 1n+d, Nat.double($P0), 1n+$N0, _, M.ns_grow_keys(~K, d, $KB(d, xs)), $N0, x), Done{Unit{}}) == ($NRL(1n+d, $SN), Done{Unit{}}) : $NSK & $RU}
  %Equal.sym(Array<Maybe<&2, K>>, ANode{$KB(d, xs), Array.new(Maybe<&2, K>, d, None{})}, $KB(1n+d, xs), NF.key_grow(~K, $GA)) : {(M.ns_put(~K, l, 1n+d, Nat.double($P0), 1n+$N0, $LK(1n+d, xs), _, $N0, x), Done{Unit{}}) == ($NRL(1n+d, $SN), Done{Unit{}}) : $NSK & $RU}
  Equal.cong($NSK, $NSK & $RU, z => (z, Done{Unit{}}), M.ns_put(~K, l, 1n+d, SC.pow2(1n+d), 1n+$N0, $ARRS(1n+d, xs), $N0, x), $NRL(1n+d, $SN), push_at(~K, l, 1n+d, xs, hl, hd1, hc1, x, hn1))

# full at the limit: nothing changes
def ns_push_full(~K: Data, $GP, +x: $ND, +hn: {Nat.is_lt($N0, $P0) == False{} : Bool}, +hdl: {Nat.is_lt(d, l) == False{} : Bool}) -> {M.ns_push(~K, $NRL(d, xs), x) == ($NRL(d, xs), Fail{DE.CapacityExceeded{}}) : $NSK & $RU}:
  %Equal.sym(Bool, Nat.is_lt($N0, $P0), False{}, hn) : {M.ns_push_room(~K, l, d, $P0, $N0, $ARRS(d, xs), x, _, Nat.is_lt(d, l)) == ($NRL(d, xs), Fail{DE.CapacityExceeded{}}) : $NSK & $RU}
  %Equal.sym(Bool, Nat.is_lt(d, l), False{}, hdl) : {M.ns_push_room(~K, l, d, $P0, $N0, $ARRS(d, xs), x, False{}, _) == ($NRL(d, xs), Fail{DE.CapacityExceeded{}}) : $NSK & $RU}
  {==}


# ---- clear ----

%def IN SC.init($ND, xs)
%def HM +m: Nat, +hm: {$N0 == 1n+m : Nat}

def len2(+n: Nat, +m: Nat, +pl: $NL, +hlen: {SC.length(Nat, pl) == Nat.double(n) : Nat}, +hm: {n == 1n+m : Nat}) -> {SC.length(Nat, pl) == 1n+(1n+Nat.double(m)) : Nat}:
  L.subst(Nat, z => {SC.length(Nat, pl) == Nat.double(z) : Nat}, n, 1n+m, hm, hlen)

# the four link slots of the last node zeroed: the node dropped
def links_wipe(~K: Data, $GP, $HM) -> {$SET4($LK(d, xs), $IR(m), 0n, $IL(m), 0n, $IP(m), 0n, $IT(m), 0n) == $LK(d, $IN) : $AN}:
  +ci = NF.lrs_cap(~K, d, $IN, LKB.cap_init($ND, $P0, xs, m, hm, hc))
  %Equal.sym($AN, $SET2($LK(d, xs), $IR(m), 0n, $IL(m), 0n), $LKL(d, SC.init(Nat, SC.init(Nat, $LRL(xs))), $TPL(xs)), LKB.pop2_lo($LA($LRL(xs), $TPL(xs), $LRC, $TPC), $IL(m), len2($N0, m, $LRL(xs), NF.lrs_len(~K, xs), hm))) : {$SET2(_, $IP(m), 0n, $IT(m), 0n) == $LK(d, $IN) : $AN}
  %Equal.sym($NL, SC.init(Nat, SC.init(Nat, $LRL(xs))), $LRL($IN), NF.lrs_init(~K, xs)) : {$SET2($LKL(d, _, $TPL(xs)), $IP(m), 0n, $IT(m), 0n) == $LK(d, $IN) : $AN}
  %ixp($P0, m) : {$SET2($LKL(d, $LRL($IN), $TPL(xs)), _, 0n, $IT(m), 0n) == $LK(d, $IN) : $AN}
  %ixt($P0, m) : {$SET2($LKL(d, $LRL($IN), $TPL(xs)), $HR(m), 0n, _, 0n) == $LK(d, $IN) : $AN}
  %Equal.sym($AN, $SET2($LKL(d, $LRL($IN), $TPL(xs)), $HR(m), 0n, $HL(m), 0n), $LKL(d, $LRL($IN), SC.init(Nat, SC.init(Nat, $TPL(xs)))), LKB.pop2_hi($LA($LRL($IN), $TPL(xs), ci, $TPC), $IL(m), len2($N0, m, $TPL(xs), NF.tps_len(~K, xs), hm))) : {_ == $LK(d, $IN) : $AN}
  %Equal.sym($NL, SC.init(Nat, SC.init(Nat, $TPL(xs))), $TPL($IN), NF.tps_init(~K, xs)) : {$LKL(d, $LRL($IN), _) == $LK(d, $IN) : $AN}
  {==}

def drop_some(~K: Data, $GP, $HM, +y0: $ND, +hy0: {SC.nth($ND, xs, m) == Some{y0} : Maybe<&2, $ND>}) -> {M.ns_drop(~K, $NRL(d, xs), m) == $NRL(d, $IN) : $NSK}:
  %Equal.sym($AN, $SET4($LK(d, xs), $IR(m), 0n, $IL(m), 0n, $IP(m), 0n, $IT(m), 0n), $LK(d, $IN), links_wipe(~K, $GA, m, hm)) : {M.NS{l, d, $P0, m, _, Array.set(Maybe<&2, K>, $KB(d, xs), U32.from_nat(m), None{})} == $NRL(d, $IN) : $NSK}
  %Equal.sym(Array<Maybe<&2, K>>, Array.set(Maybe<&2, K>, $KB(d, xs), U32.from_nat(m), M.nkey(~K, M.Free{0n})), $KB(d, $IN), NF.key_drop(~K, $GA, m, hm, y0, hy0)) : {M.NS{l, d, $P0, m, $LK(d, $IN), _} == $NRL(d, $IN) : $NSK}
  %Equal.sym(Nat, SC.length($ND, $IN), m, len_init($ND, xs, m, hm)) : {M.NS{l, d, $P0, m, $ARRS(d, $IN)} == M.NS{l, d, $P0, _, $ARRS(d, $IN)} : $NSK}
  {==}

def dr(~K: Data, $GP, +m: Nat, +hm: {$N0 == 1n+m : Nat}, +mv: Maybe<&2, $ND>, +hmv: {SC.nth($ND, xs, m) == mv : Maybe<&2, $ND>}) -> {M.ns_drop(~K, $NRL(d, xs), m) == $NRL(d, $IN) : $NSK}:
  match mv:
    case None{}:
      +hi = L.subst(Nat, z => {Nat.is_lt(m, z) == True{} : Bool}, 1n+m, $N0, Equal.sym(Nat, $N0, 1n+m, hm), N.lt_succ(m))
      Empty.absurd({M.ns_drop(~K, $NRL(d, xs), m) == $NRL(d, $IN) : $NSK}, L.false_true(L.subst(Maybe<&2, $ND>, z => {isj($ND, z) == True{} : Bool}, SC.nth($ND, xs, m), None{}, hmv, nth_isj($ND, xs, m, hi))))
    case Some{+y0}:
      drop_some(~K, $GA, m, hm, y0, hmv)

# dropping the last live slot: the list without its last node
def ns_drop_ok(~K: Data, $GP, +m: Nat, +hm: {$N0 == 1n+m : Nat}) -> {M.ns_drop(~K, $NRL(d, xs), m) == $NRL(d, $IN) : $NSK}:
  dr(~K, $GA, m, hm, SC.nth($ND, xs, m), {==})

def clr(~K: Data, +k: Nat, $GP, +hk: {$N0 == k : Nat}) -> {M.ns_clear_go(~K, k, $NRL(d, xs)) == $NRL(d, Nil{}) : $NSK}:
  match k:
    case 0n:
      Equal.cong(List<&2, $ND>, $NSK, z => $NRL(d, z), xs, Nil{}, LL.length_zero_nil($ND, xs, hk))
    case 1n+ +m:
      +hm2 = len_init($ND, xs, m, hk)
      %Equal.sym($NSK, M.ns_drop(~K, $NRL(d, xs), m), $NRL(d, $IN), ns_drop_ok(~K, $GA, m, hk)) : {M.ns_clear_go(~K, m, _) == $NRL(d, Nil{}) : $NSK}
      clr(~K, m, l, d, $IN, hl, hd, N.le_trans(SC.length($ND, $IN), 1n+m, $P0, L.subst(Nat, z => {Nat.is_le(z, 1n+m) == True{} : Bool}, m, SC.length($ND, $IN), Equal.sym(Nat, SC.length($ND, $IN), m, hm2), N.le_succ(m)), L.subst(Nat, z => {Nat.is_le(z, $P0) == True{} : Bool}, $N0, 1n+m, hk, hc)), hm2)

# clear empties the list, keeping the capacity
def ns_clear_ok(~K: Data, $GP) -> {M.ns_clear(~K, $NRL(d, xs)) == $NRL(d, Nil{}) : $NSK}:
  clr(~K, $N0, $GA, {==})

# ---- reading one field of a slot ----

%def NI ST.nth_or($ND, xs, i, M.Free{0n})

def ors(-X: Data, m: Maybe<&2, X>, +dv: X) -> X:
  match m:
    case None{}:
      dv
    case Some{x}:
      x

def nth_or_some(-X: Data, +xs: List<&2, X>, +i: Nat, +y: X, +dv: X, +h: {SC.nth(X, xs, i) == Some{y} : Maybe<&2, X>}) -> {ST.nth_or(X, xs, i, dv) == y : X}:
  match xs i:
    case Nil{} _:
      Empty.absurd({dv == y : X}, L.false_true(Equal.cong(Maybe<&2, X>, Bool, z => isj(X, z), None{}, Some{y}, h)))
    case Con{+x, r} 0n:
      Equal.cong(Maybe<&2, X>, X, z => ors(X, z, x), Some{x}, Some{y}, h)
    case Con{x, +r} 1n+q:
      nth_or_some(X, r, q, y, dv, h)

def nth_or_hi(-X: Data, +xs: List<&2, X>, +i: Nat, +dv: X, +h: {Nat.is_lt(i, SC.length(X, xs)) == False{} : Bool}) -> {ST.nth_or(X, xs, i, dv) == dv : X}:
  match xs i:
    case Nil{} _:
      {==}
    case Con{x, t} 0n:
      Empty.absurd({x == dv : X}, L.true_false(h))
    case Con{x, +t} 1n+q:
      nth_or_hi(X, t, q, dv, h)

%tmpl FAT(QN, QF, QIX)
def QN##_ats(~K: Data, $GP, +i: Nat, +mv: Maybe<&2, $ND>, +hmv: {SC.nth($ND, xs, i) == mv : Maybe<&2, $ND>}, +hi: {Nat.is_lt(i, $N0) == True{} : Bool}) -> {M.ns_##QN##_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, True{}) == ($NRL(d, xs), QF(~K, $NI)) : $NSK & Nat}:
  match mv:
    case None{}:
      Empty.absurd({M.ns_##QN##_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, True{}) == ($NRL(d, xs), QF(~K, $NI)) : $NSK & Nat}, L.false_true(L.subst(Maybe<&2, $ND>, z => {isj($ND, z) == True{} : Bool}, SC.nth($ND, xs, i), None{}, hmv, nth_isj($ND, xs, i, hi))))
    case Some{+y}:
      %Equal.sym($ND, $NI, y, nth_or_some($ND, xs, i, y, M.Free{0n}, hmv)) : {M.ns_##QN##_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, True{}) == ($NRL(d, xs), QF(~K, _)) : $NSK & Nat}
      %Equal.sym($AN & Nat, Array.get(Nat, $LK(d, xs), $UN(QIX)), ($LK(d, xs), QF(~K, y)), QN##_get(~K, $GA, i, y, hmv)) : {M.ns_field_fin(~K, l, d, $P0, $N0, $KB(d, xs), _) == ($NRL(d, xs), QF(~K, y)) : $NSK & Nat}
      {==}

def QN##_atc(~K: Data, $GP, +i: Nat, +b: Bool, +hb: {Nat.is_lt(i, $N0) == b : Bool}) -> {M.ns_##QN##_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, b) == ($NRL(d, xs), QF(~K, $NI)) : $NSK & Nat}:
  match b:
    case True{}:
      QN##_ats(~K, $GA, i, SC.nth($ND, xs, i), {==}, hb)
    case False{}:
      %Equal.sym($ND, $NI, M.Free{0n}, nth_or_hi($ND, xs, i, M.Free{0n}, hb)) : {M.ns_##QN##_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, False{}) == ($NRL(d, xs), QF(~K, _)) : $NSK & Nat}
      {==}

# the field of the list's node (of Free{0} past the length)
def QN##_at_ok(~K: Data, $GP, +i: Nat) -> {M.ns_##QN##_at(~K, $NRL(d, xs), i) == ($NRL(d, xs), QF(~K, $NI)) : $NSK & Nat}:
  QN##_atc(~K, $GA, i, Nat.is_lt(i, $N0), {==})

%end
%use FAT(tag, M.ntag, $IT(i))
%use FAT(left, M.nleft, $IL(i))
%use FAT(right, M.nright, $IR(i))
%use FAT(parent, M.nparent, $IP(i))

# ---- writing one field of a slot ----

def isn(~K: Data, n: $ND) -> Bool:
  match n:
    case M.Free{x}:
      False{}
    case M.N{c, lf, rt, pa, k}:
      True{}

# a live node is below the length
def nth_or_lt(~K: Data, +xs: List<&2, $ND>, +i: Nat, +y: $ND, +hn: {isn(~K, y) == True{} : Bool}, +h: {ST.nth_or($ND, xs, i, M.Free{0n}) == y : $ND}) -> {Nat.is_lt(i, SC.length($ND, xs)) == True{} : Bool}:
  match xs i:
    case Nil{} _:
      Empty.absurd({Nat.is_lt(i, 0n) == True{} : Bool}, L.false_true(L.subst($ND, z => {isn(~K, z) == True{} : Bool}, y, M.Free{0n}, Equal.sym($ND, M.Free{0n}, y, h), hn)))
    case Con{x, r} 0n:
      {==}
    case Con{x, +r} 1n+q:
      nth_or_lt(~K, r, q, y, hn, h)

def nth_of_or(-X: Data, +xs: List<&2, X>, +i: Nat, +dv: X, +h: {Nat.is_lt(i, SC.length(X, xs)) == True{} : Bool}) -> {SC.nth(X, xs, i) == Some{ST.nth_or(X, xs, i, dv)} : Maybe<&2, X>}:
  match xs i:
    case Nil{} _:
      Empty.absurd({SC.nth(X, Nil{}, i) == Some{dv} : Maybe<&2, X>}, N.lt_zero_absurd(i, h))
    case Con{x, r} 0n:
      {==}
    case Con{x, +r} 1n+q:
      nth_of_or(X, r, q, dv, h)

def red_tag_eq(~K: Data, +v: Bool, +lf: Nat, +rt: Nat, +q: Nat, +k: K) -> {M.ns_red_tag(v) == M.ntag(~K, M.N{v, lf, rt, q, k}) : Nat}:
  match v:
    case True{}:
      {==}
    case False{}:
      {==}


%def HK +hk: {M.nkey(~K, y) == M.nkey(~K, y0) : Maybe<&2, K>}
%def HT0 +t: Nat, +ht0: {M.ntag(~K, y0) == 1n+t : Nat}

# QN: the field; QT: the written value's type; QV: the value written; QF: the
# field of a node; QIX: its slot; QAS: the links lemma; QHD, QHU: the fields
# kept; QNEW(c): the node written over N{c, lf, rt, q, k}; QHV: its field is
# the value written
%tmpl SETF(QN, QT, QV, QF, QIX, QAS, QHD, QHU, QNEW, QHV)
def QN##_set_k(~K: Data, $GP, $HY0, +v: QT, $HT0, +hv: {QF(~K, y) == QV : Nat}, $HK, QHD) -> {M.ns_set_##QN##_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, v, True{}) == $NRL(d, $UY) : $NSK}:
  %Equal.sym($AN & Nat, Array.get(Nat, $LK(d, xs), $UN($IT(i))), ($LK(d, xs), M.ntag(~K, y0)), tag_get(~K, $GA, i, y0, hy0)) : {M.ns_set_##QN##_tag(~K, l, d, $P0, $N0, $KB(d, xs), i, v, _) == $NRL(d, $UY) : $NSK}
  %Equal.sym(Nat, M.ntag(~K, y0), 1n+t, ht0) : {M.ns_set_##QN##_tag(~K, l, d, $P0, $N0, $KB(d, xs), i, v, ($LK(d, xs), _)) == $NRL(d, $UY) : $NSK}
  %hv : {M.NS{l, d, $P0, $N0, Array.set(Nat, $LK(d, xs), $UN(QIX), _), $KB(d, xs)} == $NRL(d, $UY) : $NSK}
  %Equal.sym($AN, Array.set(Nat, $LK(d, xs), $UN(QIX), QF(~K, y)), $LK(d, $UY), QAS(~K, $GA, i, y0, y, hy0, QHU)) : {M.NS{l, d, $P0, $N0, _, $KB(d, xs)} == $NRL(d, $UY) : $NSK}
  %Equal.sym(List<&2, Maybe<&2, K>>, NR.keys(~K, $UY), NR.keys(~K, xs), NF.keys_keep(~K, xs, i, y0, y, hy0, hk)) : {M.NS{l, d, $P0, $N0, $LK(d, $UY), $KB(d, xs)} == M.NS{l, d, $P0, SC.length($ND, $UY), $LK(d, $UY), AR.thaw(Maybe<&2, K>, BK.bk(Maybe<&2, K>, d, _, None{}))} : $NSK}
  %Equal.sym(Nat, SC.length($ND, $UY), $N0, LL.length_update($ND, xs, i, y)) : {M.NS{l, d, $P0, $N0, $LK(d, $UY), $KB(d, xs)} == M.NS{l, d, $P0, _, $LK(d, $UY), $KB(d, xs)} : $NSK}
  {==}

def QN##_set_c(~K: Data, $GP, +i: Nat, +v: QT, +c: Bool, +lf: Nat, +rt: Nat, +q: Nat, +k: K, +hy2: {SC.nth($ND, xs, i) == Some{M.N{c, lf, rt, q, k}} : Maybe<&2, $ND>}) -> {M.ns_set_##QN##_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, v, True{}) == $NRL(d, SC.update($ND, xs, i, QNEW(c))) : $NSK}:
  match c:
    case True{}:
      QN##_set_k(~K, $GA, i, M.N{True{}, lf, rt, q, k}, QNEW(True{}), hy2, v, 1n, {==}, QHV, {==}, {==}, {==}, {==})
    case False{}:
      QN##_set_k(~K, $GA, i, M.N{False{}, lf, rt, q, k}, QNEW(False{}), hy2, v, 0n, {==}, QHV, {==}, {==}, {==}, {==})

# writing the field of a live node: the list with that field replaced
def QN##_set_node(~K: Data, $GP, +i: Nat, +v: QT, +c: Bool, +lf: Nat, +rt: Nat, +q: Nat, +k: K, +hy: {$NI == M.N{c, lf, rt, q, k} : $ND}) -> {M.ns_set_##QN(~K, $NRL(d, xs), i, v) == $NRL(d, SC.update($ND, xs, i, QNEW(c))) : $NSK}:
  +hlt = nth_or_lt(~K, xs, i, M.N{c, lf, rt, q, k}, {==}, hy)
  +hy2 = Equal.trans(Maybe<&2, $ND>, SC.nth($ND, xs, i), Some{$NI}, Some{M.N{c, lf, rt, q, k}}, nth_of_or($ND, xs, i, M.Free{0n}, hlt), Equal.cong($ND, Maybe<&2, $ND>, z => Some{z}, $NI, M.N{c, lf, rt, q, k}, hy))
  %Equal.sym(Bool, Nat.is_lt(i, $N0), True{}, hlt) : {M.ns_set_##QN##_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, v, _) == $NRL(d, SC.update($ND, xs, i, QNEW(c))) : $NSK}
  QN##_set_c(~K, $GA, i, v, c, lf, rt, q, k, hy2)

def QN##_set_fc(~K: Data, $GP, +i: Nat, +v: QT, +z: Nat, +hy: {$NI == M.Free{z} : $ND}, +b: Bool, +hb: {Nat.is_lt(i, $N0) == b : Bool}) -> {M.ns_set_##QN##_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, v, b) == $NRL(d, xs) : $NSK}:
  match b:
    case False{}:
      {==}
    case True{}:
      +hy2 = Equal.trans(Maybe<&2, $ND>, SC.nth($ND, xs, i), Some{$NI}, Some{M.Free{z}}, nth_of_or($ND, xs, i, M.Free{0n}, hb), Equal.cong($ND, Maybe<&2, $ND>, w => Some{w}, $NI, M.Free{z}, hy))
      %Equal.sym($AN & Nat, Array.get(Nat, $LK(d, xs), $UN($IT(i))), ($LK(d, xs), M.ntag(~K, M.Free{z})), tag_get(~K, $GA, i, M.Free{z}, hy2)) : {M.ns_set_##QN##_tag(~K, l, d, $P0, $N0, $KB(d, xs), i, v, _) == $NRL(d, xs) : $NSK}
      {==}

# writing the field of a free slot (or past the length) changes nothing
def QN##_set_free(~K: Data, $GP, +i: Nat, +v: QT, +z: Nat, +hy: {$NI == M.Free{z} : $ND}) -> {M.ns_set_##QN(~K, $NRL(d, xs), i, v) == $NRL(d, xs) : $NSK}:
  QN##_set_fc(~K, $GA, i, v, z, hy, Nat.is_lt(i, $N0), {==})

%end
%def NWL(c) M.N{c, v, rt, q, k}
%def NWR(c) M.N{c, lf, v, q, k}
%def NWP(c) M.N{c, lf, rt, v, k}
%def NWC(c) M.N{v, lf, rt, q, k}
%use SETF(left, Nat, v, M.nleft, $IL(i), left_aset, <|$ER, $ET, $EP|>, <|er, et, ep|>, $NWL, {==})
%use SETF(right, Nat, v, M.nright, $IR(i), right_aset, <|$EL, $ET, $EP|>, <|el, et, ep|>, $NWR, {==})
%use SETF(parent, Nat, v, M.nparent, $IP(i), parent_aset, <|$EL, $ER, $ET|>, <|el, er, et|>, $NWP, {==})
%use SETF(red, Bool, M.ns_red_tag(v), M.ntag, $IT(i), tag_aset, <|$EL, $ER, $EP|>, <|el, er, ep|>, $NWC, <|Equal.sym(Nat, M.ns_red_tag(v), M.ntag(~K, M.N{v, lf, rt, q, k}), red_tag_eq(~K, v, lf, rt, q, k))|>)

# ---- reading a slot's key ----

def key_ats(~K: Data, $GP, +i: Nat, +mv: Maybe<&2, $ND>, +hmv: {SC.nth($ND, xs, i) == mv : Maybe<&2, $ND>}, +hi: {Nat.is_lt(i, $N0) == True{} : Bool}) -> {M.ns_key_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, True{}) == ($NRL(d, xs), M.nkey(~K, $NI)) : $NSK & Maybe<&2, K>}:
  match mv:
    case None{}:
      Empty.absurd({M.ns_key_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, True{}) == ($NRL(d, xs), M.nkey(~K, $NI)) : $NSK & Maybe<&2, K>}, L.false_true(L.subst(Maybe<&2, $ND>, z => {isj($ND, z) == True{} : Bool}, SC.nth($ND, xs, i), None{}, hmv, nth_isj($ND, xs, i, hi))))
    case Some{+y}:
      %Equal.sym($ND, $NI, y, nth_or_some($ND, xs, i, y, M.Free{0n}, hmv)) : {M.ns_key_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, True{}) == ($NRL(d, xs), M.nkey(~K, _)) : $NSK & Maybe<&2, K>}
      %Equal.sym(Array<Maybe<&2, K>> & Maybe<&2, K>, Array.get(Maybe<&2, K>, $KB(d, xs), U32.from_nat(i)), ($KB(d, xs), M.nkey(~K, y)), NF.key_get(~K, $GA, i, y, hmv)) : {M.ns_key_fin(~K, l, d, $P0, $N0, $LK(d, xs), _) == ($NRL(d, xs), M.nkey(~K, y)) : $NSK & Maybe<&2, K>}
      {==}

def key_atc(~K: Data, $GP, +i: Nat, +b: Bool, +hb: {Nat.is_lt(i, $N0) == b : Bool}) -> {M.ns_key_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, b) == ($NRL(d, xs), M.nkey(~K, $NI)) : $NSK & Maybe<&2, K>}:
  match b:
    case True{}:
      key_ats(~K, $GA, i, SC.nth($ND, xs, i), {==}, hb)
    case False{}:
      %Equal.sym($ND, $NI, M.Free{0n}, nth_or_hi($ND, xs, i, M.Free{0n}, hb)) : {M.ns_key_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, False{}) == ($NRL(d, xs), M.nkey(~K, _)) : $NSK & Maybe<&2, K>}
      {==}

# the key of the list's node (None for a free slot or past the length)
def key_at_ok(~K: Data, $GP, +i: Nat) -> {M.ns_key_at(~K, $NRL(d, xs), i) == ($NRL(d, xs), M.nkey(~K, $NI)) : $NSK & Maybe<&2, K>}:
  key_atc(~K, $GA, i, Nat.is_lt(i, $N0), {==})
