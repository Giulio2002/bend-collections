      %Equal.sym(List<&2, Nat>, NR.lefts(~K, SC.update($ND, xs, i, M.N{True{}, lf, v, q, k})), NR.lefts(~K, xs), NF.lefts_keep(~K, xs, i, M.N{True{}, lf, rt, q, k}, M.N{True{}, lf, v, q, k}, hy2, {==})) : {M.NS{l, d, $P0, $N0, $TB(d, xs), $LB(d, xs), $RB(d, SC.update($ND, xs, i, M.N{True{}, lf, v, q, k})), $PB(d, xs), $KB(d, xs)} == M.NS{l, d, $P0, SC.length($ND, SC.update($ND, xs, i, M.N{True{}, lf, v, q, k})), $TB(d, xs), AR.thaw(Nat, BK.bk(Nat, d, _, 0n)), $RB(d, SC.update($ND, xs, i, M.N{True{}, lf, v, q, k})), $PB(d, SC.update($ND, xs, i, M.N{True{}, lf, v, q, k})), $KB(d, SC.update($ND, xs, i, M.N{True{}, lf, v, q, k}))} : $NSK}
      %Equal.sym(List<&2, Nat>, NR.parents(~K, SC.update($ND, xs, i, M.N{True{}, lf, v, q, k})), NR.parents(~K, xs), NF.parents_keep(~K, xs, i, M.N{True{}, lf, rt, q, k}, M.N{True{}, lf, v, q, k}, hy2, {==})) : {M.NS{l, d, $P0, $N0, $TB(d, xs), $LB(d, xs), $RB(d, SC.update($ND, xs, i, M.N{True{}, lf, v, q, k})), $PB(d, xs), $KB(d, xs)} == M.NS{l, d, $P0, SC.length($ND, SC.update($ND, xs, i, M.N{True{}, lf, v, q, k})), $TB(d, xs), $LB(d, xs), $RB(d, SC.update($ND, xs, i, M.N{True{}, lf, v, q, k})), AR.thaw(Nat, BK.bk(Nat, d, _, 0n)), $KB(d, SC.update($ND, xs, i, M.N{True{}, lf, v, q, k}))} : $NSK}
