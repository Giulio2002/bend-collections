# writing the field of a live node: the list with that field replaced
def right_set_node(~K: Data, $GP, +i: Nat, +v: Nat, +c: Bool, +lf: Nat, +rt: Nat, +q: Nat, +k: K, +hy: {$NI == M.N{c, lf, rt, q, k} : $ND}) -> {M.ns_set_right(~K, $NRL(d, xs), i, v) == $NRL(d, SC.update($ND, xs, i, M.N{c, lf, v, q, k})) : $NSK}:
  +hlt = nth_or_lt(~K, xs, i, M.N{c, lf, rt, q, k}, {==}, hy)
  +hy2 = Equal.trans(Maybe<&2, $ND>, SC.nth($ND, xs, i), Some{$NI}, Some{M.N{c, lf, rt, q, k}}, nth_of_or($ND, xs, i, M.Free{0n}, hlt), Equal.cong($ND, Maybe<&2, $ND>, z => Some{z}, $NI, M.N{c, lf, rt, q, k}, hy))
  %Equal.sym(Bool, Nat.is_lt(i, $N0), True{}, hlt) : {M.ns_set_right_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, v, _) == $NRL(d, SC.update($ND, xs, i, M.N{c, lf, v, q, k})) : $NSK}
  right_set_c(~K, $GA, i, v, c, lf, rt, q, k, hy2)

def right_set_fc(~K: Data, $GP, +i: Nat, +v: Nat, +z: Nat, +hy: {$NI == M.Free{z} : $ND}, +b: Bool, +hb: {Nat.is_lt(i, $N0) == b : Bool}) -> {M.ns_set_right_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, v, b) == $NRL(d, xs) : $NSK}:
  match b:
    case False{}:
      {==}
    case True{}:
      +hy2 = Equal.trans(Maybe<&2, $ND>, SC.nth($ND, xs, i), Some{$NI}, Some{M.Free{z}}, nth_of_or($ND, xs, i, M.Free{0n}, hb), Equal.cong($ND, Maybe<&2, $ND>, w => Some{w}, $NI, M.Free{z}, hy))
      %Equal.sym(Array<Nat> & Nat, Array.get(Nat, $TB(d, xs), U32.from_nat(i)), ($TB(d, xs), M.ntag(~K, M.Free{z})), NF.tag_get(~K, $GA, i, M.Free{z}, hy2)) : {M.ns_set_right_tag(~K, l, d, $P0, $N0, $LB(d, xs), $RB(d, xs), $PB(d, xs), $KB(d, xs), i, v, _) == $NRL(d, xs) : $NSK}
      {==}

# writing the field of a free slot (or past the length) changes nothing
def right_set_free(~K: Data, $GP, +i: Nat, +v: Nat, +z: Nat, +hy: {$NI == M.Free{z} : $ND}) -> {M.ns_set_right(~K, $NRL(d, xs), i, v) == $NRL(d, xs) : $NSK}:
  right_set_fc(~K, $GA, i, v, z, hy, Nat.is_lt(i, $N0), {==})

def parent_set_c(~K: Data, $GP, +i: Nat, +v: Nat, +c: Bool, +lf: Nat, +rt: Nat, +q: Nat, +k: K, +hy2: {SC.nth($ND, xs, i) == Some{M.N{c, lf, rt, q, k}} : Maybe<&2, $ND>}) -> {M.ns_set_parent_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, v, True{}) == $NRL(d, SC.update($ND, xs, i, M.N{c, lf, rt, v, k})) : $NSK}:
  match c:
    case True{}:
      %Equal.sym(Array<Nat> & Nat, Array.get(Nat, $TB(d, xs), U32.from_nat(i)), ($TB(d, xs), M.ntag(~K, M.N{True{}, lf, rt, q, k})), NF.tag_get(~K, $GA, i, M.N{True{}, lf, rt, q, k}, hy2)) : {M.ns_set_parent_tag(~K, l, d, $P0, $N0, $LB(d, xs), $RB(d, xs), $PB(d, xs), $KB(d, xs), i, v, _) == $NRL(d, SC.update($ND, xs, i, M.N{True{}, lf, rt, v, k})) : $NSK}
      %Equal.sym(Array<Nat>, Array.set(Nat, $PB(d, xs), U32.from_nat(i), v), $PB(d, SC.update($ND, xs, i, M.N{True{}, lf, rt, v, k})), NF.parent_set(~K, $GA, i, M.N{True{}, lf, rt, q, k}, hy2, M.N{True{}, lf, rt, v, k})) : {M.NS{l, d, $P0, $N0, $TB(d, xs), $LB(d, xs), $RB(d, xs), _, $KB(d, xs)} == $NRL(d, SC.update($ND, xs, i, M.N{True{}, lf, rt, v, k})) : $NSK}
      %Equal.sym(List<&2, Nat>, NR.tags(~K, SC.update($ND, xs, i, M.N{True{}, lf, rt, v, k})), NR.tags(~K, xs), NF.tags_keep(~K, xs, i, M.N{True{}, lf, rt, q, k}, M.N{True{}, lf, rt, v, k}, hy2, {==})) : {M.NS{l, d, $P0, $N0, $TB(d, xs), $LB(d, xs), $RB(d, xs), $PB(d, SC.update($ND, xs, i, M.N{True{}, lf, rt, v, k})), $KB(d, xs)} == M.NS{l, d, $P0, SC.length($ND, SC.update($ND, xs, i, M.N{True{}, lf, rt, v, k})), AR.thaw(Nat, BK.bk(Nat, d, _, 0n)), $LB(d, SC.update($ND, xs, i, M.N{True{}, lf, rt, v, k})), $RB(d, SC.update($ND, xs, i, M.N{True{}, lf, rt, v, k})), $PB(d, SC.update($ND, xs, i, M.N{True{}, lf, rt, v, k})), $KB(d, SC.update($ND, xs, i, M.N{True{}, lf, rt, v, k}))} : $NSK}
      %Equal.sym(List<&2, Nat>, NR.lefts(~K, SC.update($ND, xs, i, M.N{True{}, lf, rt, v, k})), NR.lefts(~K, xs), NF.lefts_keep(~K, xs, i, M.N{True{}, lf, rt, q, k}, M.N{True{}, lf, rt, v, k}, hy2, {==})) : {M.NS{l, d, $P0, $N0, $TB(d, xs), $LB(d, xs), $RB(d, xs), $PB(d, SC.update($ND, xs, i, M.N{True{}, lf, rt, v, k})), $KB(d, xs)} == M.NS{l, d, $P0, SC.length($ND, SC.update($ND, xs, i, M.N{True{}, lf, rt, v, k})), $TB(d, xs), AR.thaw(Nat, BK.bk(Nat, d, _, 0n)), $RB(d, SC.update($ND, xs, i, M.N{True{}, lf, rt, v, k})), $PB(d, SC.update($ND, xs, i, M.N{True{}, lf, rt, v, k})), $KB(d, SC.update($ND, xs, i, M.N{True{}, lf, rt, v, k}))} : $NSK}
      %Equal.sym(List<&2, Nat>, NR.rights(~K, SC.update($ND, xs, i, M.N{True{}, lf, rt, v, k})), NR.rights(~K, xs), NF.rights_keep(~K, xs, i, M.N{True{}, lf, rt, q, k}, M.N{True{}, lf, rt, v, k}, hy2, {==})) : {M.NS{l, d, $P0, $N0, $TB(d, xs), $LB(d, xs), $RB(d, xs), $PB(d, SC.update($ND, xs, i, M.N{True{}, lf, rt, v, k})), $KB(d, xs)} == M.NS{l, d, $P0, SC.length($ND, SC.update($ND, xs, i, M.N{True{}, lf, rt, v, k})), $TB(d, xs), $LB(d, xs), AR.thaw(Nat, BK.bk(Nat, d, _, 0n)), $PB(d, SC.update($ND, xs, i, M.N{True{}, lf, rt, v, k})), $KB(d, SC.update($ND, xs, i, M.N{True{}, lf, rt, v, k}))} : $NSK}
      %Equal.sym(List<&2, Maybe<&2, K>>, NR.keys(~K, SC.update($ND, xs, i, M.N{True{}, lf, rt, v, k})), NR.keys(~K, xs), NF.keys_keep(~K, xs, i, M.N{True{}, lf, rt, q, k}, M.N{True{}, lf, rt, v, k}, hy2, {==})) : {M.NS{l, d, $P0, $N0, $TB(d, xs), $LB(d, xs), $RB(d, xs), $PB(d, SC.update($ND, xs, i, M.N{True{}, lf, rt, v, k})), $KB(d, xs)} == M.NS{l, d, $P0, SC.length($ND, SC.update($ND, xs, i, M.N{True{}, lf, rt, v, k})), $TB(d, xs), $LB(d, xs), $RB(d, xs), $PB(d, SC.update($ND, xs, i, M.N{True{}, lf, rt, v, k})), AR.thaw(Maybe<&2, K>, BK.bk(Maybe<&2, K>, d, _, None{}))} : $NSK}
      %Equal.sym(Nat, SC.length($ND, SC.update($ND, xs, i, M.N{True{}, lf, rt, v, k})), $N0, LL.length_update($ND, xs, i, M.N{True{}, lf, rt, v, k})) : {M.NS{l, d, $P0, $N0, $TB(d, xs), $LB(d, xs), $RB(d, xs), $PB(d, SC.update($ND, xs, i, M.N{True{}, lf, rt, v, k})), $KB(d, xs)} == M.NS{l, d, $P0, _, $TB(d, xs), $LB(d, xs), $RB(d, xs), $PB(d, SC.update($ND, xs, i, M.N{True{}, lf, rt, v, k})), $KB(d, xs)} : $NSK}
      {==}
    case False{}:
      %Equal.sym(Array<Nat> & Nat, Array.get(Nat, $TB(d, xs), U32.from_nat(i)), ($TB(d, xs), M.ntag(~K, M.N{False{}, lf, rt, q, k})), NF.tag_get(~K, $GA, i, M.N{False{}, lf, rt, q, k}, hy2)) : {M.ns_set_parent_tag(~K, l, d, $P0, $N0, $LB(d, xs), $RB(d, xs), $PB(d, xs), $KB(d, xs), i, v, _) == $NRL(d, SC.update($ND, xs, i, M.N{False{}, lf, rt, v, k})) : $NSK}
      %Equal.sym(Array<Nat>, Array.set(Nat, $PB(d, xs), U32.from_nat(i), v), $PB(d, SC.update($ND, xs, i, M.N{False{}, lf, rt, v, k})), NF.parent_set(~K, $GA, i, M.N{False{}, lf, rt, q, k}, hy2, M.N{False{}, lf, rt, v, k})) : {M.NS{l, d, $P0, $N0, $TB(d, xs), $LB(d, xs), $RB(d, xs), _, $KB(d, xs)} == $NRL(d, SC.update($ND, xs, i, M.N{False{}, lf, rt, v, k})) : $NSK}
      %Equal.sym(List<&2, Nat>, NR.tags(~K, SC.update($ND, xs, i, M.N{False{}, lf, rt, v, k})), NR.tags(~K, xs), NF.tags_keep(~K, xs, i, M.N{False{}, lf, rt, q, k}, M.N{False{}, lf, rt, v, k}, hy2, {==})) : {M.NS{l, d, $P0, $N0, $TB(d, xs), $LB(d, xs), $RB(d, xs), $PB(d, SC.update($ND, xs, i, M.N{False{}, lf, rt, v, k})), $KB(d, xs)} == M.NS{l, d, $P0, SC.length($ND, SC.update($ND, xs, i, M.N{False{}, lf, rt, v, k})), AR.thaw(Nat, BK.bk(Nat, d, _, 0n)), $LB(d, SC.update($ND, xs, i, M.N{False{}, lf, rt, v, k})), $RB(d, SC.update($ND, xs, i, M.N{False{}, lf, rt, v, k})), $PB(d, SC.update($ND, xs, i, M.N{False{}, lf, rt, v, k})), $KB(d, SC.update($ND, xs, i, M.N{False{}, lf, rt, v, k}))} : $NSK}
      %Equal.sym(List<&2, Nat>, NR.lefts(~K, SC.update($ND, xs, i, M.N{False{}, lf, rt, v, k})), NR.lefts(~K, xs), NF.lefts_keep(~K, xs, i, M.N{False{}, lf, rt, q, k}, M.N{False{}, lf, rt, v, k}, hy2, {==})) : {M.NS{l, d, $P0, $N0, $TB(d, xs), $LB(d, xs), $RB(d, xs), $PB(d, SC.update($ND, xs, i, M.N{False{}, lf, rt, v, k})), $KB(d, xs)} == M.NS{l, d, $P0, SC.length($ND, SC.update($ND, xs, i, M.N{False{}, lf, rt, v, k})), $TB(d, xs), AR.thaw(Nat, BK.bk(Nat, d, _, 0n)), $RB(d, SC.update($ND, xs, i, M.N{False{}, lf, rt, v, k})), $PB(d, SC.update($ND, xs, i, M.N{False{}, lf, rt, v, k})), $KB(d, SC.update($ND, xs, i, M.N{False{}, lf, rt, v, k}))} : $NSK}
      %Equal.sym(List<&2, Nat>, NR.rights(~K, SC.update($ND, xs, i, M.N{False{}, lf, rt, v, k})), NR.rights(~K, xs), NF.rights_keep(~K, xs, i, M.N{False{}, lf, rt, q, k}, M.N{False{}, lf, rt, v, k}, hy2, {==})) : {M.NS{l, d, $P0, $N0, $TB(d, xs), $LB(d, xs), $RB(d, xs), $PB(d, SC.update($ND, xs, i, M.N{False{}, lf, rt, v, k})), $KB(d, xs)} == M.NS{l, d, $P0, SC.length($ND, SC.update($ND, xs, i, M.N{False{}, lf, rt, v, k})), $TB(d, xs), $LB(d, xs), AR.thaw(Nat, BK.bk(Nat, d, _, 0n)), $PB(d, SC.update($ND, xs, i, M.N{False{}, lf, rt, v, k})), $KB(d, SC.update($ND, xs, i, M.N{False{}, lf, rt, v, k}))} : $NSK}
      %Equal.sym(List<&2, Maybe<&2, K>>, NR.keys(~K, SC.update($ND, xs, i, M.N{False{}, lf, rt, v, k})), NR.keys(~K, xs), NF.keys_keep(~K, xs, i, M.N{False{}, lf, rt, q, k}, M.N{False{}, lf, rt, v, k}, hy2, {==})) : {M.NS{l, d, $P0, $N0, $TB(d, xs), $LB(d, xs), $RB(d, xs), $PB(d, SC.update($ND, xs, i, M.N{False{}, lf, rt, v, k})), $KB(d, xs)} == M.NS{l, d, $P0, SC.length($ND, SC.update($ND, xs, i, M.N{False{}, lf, rt, v, k})), $TB(d, xs), $LB(d, xs), $RB(d, xs), $PB(d, SC.update($ND, xs, i, M.N{False{}, lf, rt, v, k})), AR.thaw(Maybe<&2, K>, BK.bk(Maybe<&2, K>, d, _, None{}))} : $NSK}
      %Equal.sym(Nat, SC.length($ND, SC.update($ND, xs, i, M.N{False{}, lf, rt, v, k})), $N0, LL.length_update($ND, xs, i, M.N{False{}, lf, rt, v, k})) : {M.NS{l, d, $P0, $N0, $TB(d, xs), $LB(d, xs), $RB(d, xs), $PB(d, SC.update($ND, xs, i, M.N{False{}, lf, rt, v, k})), $KB(d, xs)} == M.NS{l, d, $P0, _, $TB(d, xs), $LB(d, xs), $RB(d, xs), $PB(d, SC.update($ND, xs, i, M.N{False{}, lf, rt, v, k})), $KB(d, xs)} : $NSK}
      {==}

# writing the field of a live node: the list with that field replaced
def parent_set_node(~K: Data, $GP, +i: Nat, +v: Nat, +c: Bool, +lf: Nat, +rt: Nat, +q: Nat, +k: K, +hy: {$NI == M.N{c, lf, rt, q, k} : $ND}) -> {M.ns_set_parent(~K, $NRL(d, xs), i, v) == $NRL(d, SC.update($ND, xs, i, M.N{c, lf, rt, v, k})) : $NSK}:
  +hlt = nth_or_lt(~K, xs, i, M.N{c, lf, rt, q, k}, {==}, hy)
  +hy2 = Equal.trans(Maybe<&2, $ND>, SC.nth($ND, xs, i), Some{$NI}, Some{M.N{c, lf, rt, q, k}}, nth_of_or($ND, xs, i, M.Free{0n}, hlt), Equal.cong($ND, Maybe<&2, $ND>, z => Some{z}, $NI, M.N{c, lf, rt, q, k}, hy))
  %Equal.sym(Bool, Nat.is_lt(i, $N0), True{}, hlt) : {M.ns_set_parent_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, v, _) == $NRL(d, SC.update($ND, xs, i, M.N{c, lf, rt, v, k})) : $NSK}
  parent_set_c(~K, $GA, i, v, c, lf, rt, q, k, hy2)

def parent_set_fc(~K: Data, $GP, +i: Nat, +v: Nat, +z: Nat, +hy: {$NI == M.Free{z} : $ND}, +b: Bool, +hb: {Nat.is_lt(i, $N0) == b : Bool}) -> {M.ns_set_parent_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, v, b) == $NRL(d, xs) : $NSK}:
  match b:
    case False{}:
      {==}
    case True{}:
      +hy2 = Equal.trans(Maybe<&2, $ND>, SC.nth($ND, xs, i), Some{$NI}, Some{M.Free{z}}, nth_of_or($ND, xs, i, M.Free{0n}, hb), Equal.cong($ND, Maybe<&2, $ND>, w => Some{w}, $NI, M.Free{z}, hy))
      %Equal.sym(Array<Nat> & Nat, Array.get(Nat, $TB(d, xs), U32.from_nat(i)), ($TB(d, xs), M.ntag(~K, M.Free{z})), NF.tag_get(~K, $GA, i, M.Free{z}, hy2)) : {M.ns_set_parent_tag(~K, l, d, $P0, $N0, $LB(d, xs), $RB(d, xs), $PB(d, xs), $KB(d, xs), i, v, _) == $NRL(d, xs) : $NSK}
      {==}

# writing the field of a free slot (or past the length) changes nothing
def parent_set_free(~K: Data, $GP, +i: Nat, +v: Nat, +z: Nat, +hy: {$NI == M.Free{z} : $ND}) -> {M.ns_set_parent(~K, $NRL(d, xs), i, v) == $NRL(d, xs) : $NSK}:
  parent_set_fc(~K, $GA, i, v, z, hy, Nat.is_lt(i, $N0), {==})

def red_set_c(~K: Data, $GP, +i: Nat, +v: Bool, +c: Bool, +lf: Nat, +rt: Nat, +q: Nat, +k: K, +hy2: {SC.nth($ND, xs, i) == Some{M.N{c, lf, rt, q, k}} : Maybe<&2, $ND>}) -> {M.ns_set_red_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, v, True{}) == $NRL(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})) : $NSK}:
  match c:
    case True{}:
      %Equal.sym(Array<Nat> & Nat, Array.get(Nat, $TB(d, xs), U32.from_nat(i)), ($TB(d, xs), M.ntag(~K, M.N{True{}, lf, rt, q, k})), NF.tag_get(~K, $GA, i, M.N{True{}, lf, rt, q, k}, hy2)) : {M.ns_set_red_tag(~K, l, d, $P0, $N0, $LB(d, xs), $RB(d, xs), $PB(d, xs), $KB(d, xs), i, v, _) == $NRL(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})) : $NSK}
      %Equal.sym(Nat, M.ns_red_tag(v), M.ntag(~K, M.N{v, lf, rt, q, k}), red_tag_eq(~K, v, lf, rt, q, k)) : {M.NS{l, d, $P0, $N0, Array.set(Nat, $TB(d, xs), U32.from_nat(i), _), $LB(d, xs), $RB(d, xs), $PB(d, xs), $KB(d, xs)} == $NRL(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})) : $NSK}
      %Equal.sym(Array<Nat>, Array.set(Nat, $TB(d, xs), U32.from_nat(i), M.ntag(~K, M.N{v, lf, rt, q, k})), $TB(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), NF.tag_set(~K, $GA, i, M.N{True{}, lf, rt, q, k}, hy2, M.N{v, lf, rt, q, k})) : {M.NS{l, d, $P0, $N0, _, $LB(d, xs), $RB(d, xs), $PB(d, xs), $KB(d, xs)} == $NRL(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})) : $NSK}
      %Equal.sym(List<&2, Nat>, NR.lefts(~K, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), NR.lefts(~K, xs), NF.lefts_keep(~K, xs, i, M.N{True{}, lf, rt, q, k}, M.N{v, lf, rt, q, k}, hy2, {==})) : {M.NS{l, d, $P0, $N0, $TB(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), $LB(d, xs), $RB(d, xs), $PB(d, xs), $KB(d, xs)} == M.NS{l, d, $P0, SC.length($ND, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), $TB(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), AR.thaw(Nat, BK.bk(Nat, d, _, 0n)), $RB(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), $PB(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), $KB(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k}))} : $NSK}
      %Equal.sym(List<&2, Nat>, NR.rights(~K, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), NR.rights(~K, xs), NF.rights_keep(~K, xs, i, M.N{True{}, lf, rt, q, k}, M.N{v, lf, rt, q, k}, hy2, {==})) : {M.NS{l, d, $P0, $N0, $TB(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), $LB(d, xs), $RB(d, xs), $PB(d, xs), $KB(d, xs)} == M.NS{l, d, $P0, SC.length($ND, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), $TB(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), $LB(d, xs), AR.thaw(Nat, BK.bk(Nat, d, _, 0n)), $PB(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), $KB(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k}))} : $NSK}
      %Equal.sym(List<&2, Nat>, NR.parents(~K, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), NR.parents(~K, xs), NF.parents_keep(~K, xs, i, M.N{True{}, lf, rt, q, k}, M.N{v, lf, rt, q, k}, hy2, {==})) : {M.NS{l, d, $P0, $N0, $TB(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), $LB(d, xs), $RB(d, xs), $PB(d, xs), $KB(d, xs)} == M.NS{l, d, $P0, SC.length($ND, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), $TB(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), $LB(d, xs), $RB(d, xs), AR.thaw(Nat, BK.bk(Nat, d, _, 0n)), $KB(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k}))} : $NSK}
      %Equal.sym(List<&2, Maybe<&2, K>>, NR.keys(~K, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), NR.keys(~K, xs), NF.keys_keep(~K, xs, i, M.N{True{}, lf, rt, q, k}, M.N{v, lf, rt, q, k}, hy2, {==})) : {M.NS{l, d, $P0, $N0, $TB(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), $LB(d, xs), $RB(d, xs), $PB(d, xs), $KB(d, xs)} == M.NS{l, d, $P0, SC.length($ND, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), $TB(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), $LB(d, xs), $RB(d, xs), $PB(d, xs), AR.thaw(Maybe<&2, K>, BK.bk(Maybe<&2, K>, d, _, None{}))} : $NSK}
      %Equal.sym(Nat, SC.length($ND, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), $N0, LL.length_update($ND, xs, i, M.N{v, lf, rt, q, k})) : {M.NS{l, d, $P0, $N0, $TB(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), $LB(d, xs), $RB(d, xs), $PB(d, xs), $KB(d, xs)} == M.NS{l, d, $P0, _, $TB(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), $LB(d, xs), $RB(d, xs), $PB(d, xs), $KB(d, xs)} : $NSK}
      {==}
    case False{}:
      %Equal.sym(Array<Nat> & Nat, Array.get(Nat, $TB(d, xs), U32.from_nat(i)), ($TB(d, xs), M.ntag(~K, M.N{False{}, lf, rt, q, k})), NF.tag_get(~K, $GA, i, M.N{False{}, lf, rt, q, k}, hy2)) : {M.ns_set_red_tag(~K, l, d, $P0, $N0, $LB(d, xs), $RB(d, xs), $PB(d, xs), $KB(d, xs), i, v, _) == $NRL(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})) : $NSK}
      %Equal.sym(Nat, M.ns_red_tag(v), M.ntag(~K, M.N{v, lf, rt, q, k}), red_tag_eq(~K, v, lf, rt, q, k)) : {M.NS{l, d, $P0, $N0, Array.set(Nat, $TB(d, xs), U32.from_nat(i), _), $LB(d, xs), $RB(d, xs), $PB(d, xs), $KB(d, xs)} == $NRL(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})) : $NSK}
      %Equal.sym(Array<Nat>, Array.set(Nat, $TB(d, xs), U32.from_nat(i), M.ntag(~K, M.N{v, lf, rt, q, k})), $TB(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), NF.tag_set(~K, $GA, i, M.N{False{}, lf, rt, q, k}, hy2, M.N{v, lf, rt, q, k})) : {M.NS{l, d, $P0, $N0, _, $LB(d, xs), $RB(d, xs), $PB(d, xs), $KB(d, xs)} == $NRL(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})) : $NSK}
      %Equal.sym(List<&2, Nat>, NR.lefts(~K, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), NR.lefts(~K, xs), NF.lefts_keep(~K, xs, i, M.N{False{}, lf, rt, q, k}, M.N{v, lf, rt, q, k}, hy2, {==})) : {M.NS{l, d, $P0, $N0, $TB(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), $LB(d, xs), $RB(d, xs), $PB(d, xs), $KB(d, xs)} == M.NS{l, d, $P0, SC.length($ND, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), $TB(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), AR.thaw(Nat, BK.bk(Nat, d, _, 0n)), $RB(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), $PB(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), $KB(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k}))} : $NSK}
      %Equal.sym(List<&2, Nat>, NR.rights(~K, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), NR.rights(~K, xs), NF.rights_keep(~K, xs, i, M.N{False{}, lf, rt, q, k}, M.N{v, lf, rt, q, k}, hy2, {==})) : {M.NS{l, d, $P0, $N0, $TB(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), $LB(d, xs), $RB(d, xs), $PB(d, xs), $KB(d, xs)} == M.NS{l, d, $P0, SC.length($ND, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), $TB(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), $LB(d, xs), AR.thaw(Nat, BK.bk(Nat, d, _, 0n)), $PB(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), $KB(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k}))} : $NSK}
      %Equal.sym(List<&2, Nat>, NR.parents(~K, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), NR.parents(~K, xs), NF.parents_keep(~K, xs, i, M.N{False{}, lf, rt, q, k}, M.N{v, lf, rt, q, k}, hy2, {==})) : {M.NS{l, d, $P0, $N0, $TB(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), $LB(d, xs), $RB(d, xs), $PB(d, xs), $KB(d, xs)} == M.NS{l, d, $P0, SC.length($ND, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), $TB(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), $LB(d, xs), $RB(d, xs), AR.thaw(Nat, BK.bk(Nat, d, _, 0n)), $KB(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k}))} : $NSK}
      %Equal.sym(List<&2, Maybe<&2, K>>, NR.keys(~K, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), NR.keys(~K, xs), NF.keys_keep(~K, xs, i, M.N{False{}, lf, rt, q, k}, M.N{v, lf, rt, q, k}, hy2, {==})) : {M.NS{l, d, $P0, $N0, $TB(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), $LB(d, xs), $RB(d, xs), $PB(d, xs), $KB(d, xs)} == M.NS{l, d, $P0, SC.length($ND, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), $TB(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), $LB(d, xs), $RB(d, xs), $PB(d, xs), AR.thaw(Maybe<&2, K>, BK.bk(Maybe<&2, K>, d, _, None{}))} : $NSK}
      %Equal.sym(Nat, SC.length($ND, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), $N0, LL.length_update($ND, xs, i, M.N{v, lf, rt, q, k})) : {M.NS{l, d, $P0, $N0, $TB(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), $LB(d, xs), $RB(d, xs), $PB(d, xs), $KB(d, xs)} == M.NS{l, d, $P0, _, $TB(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})), $LB(d, xs), $RB(d, xs), $PB(d, xs), $KB(d, xs)} : $NSK}
      {==}

# writing the field of a live node: the list with that field replaced
def red_set_node(~K: Data, $GP, +i: Nat, +v: Bool, +c: Bool, +lf: Nat, +rt: Nat, +q: Nat, +k: K, +hy: {$NI == M.N{c, lf, rt, q, k} : $ND}) -> {M.ns_set_red(~K, $NRL(d, xs), i, v) == $NRL(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})) : $NSK}:
  +hlt = nth_or_lt(~K, xs, i, M.N{c, lf, rt, q, k}, {==}, hy)
  +hy2 = Equal.trans(Maybe<&2, $ND>, SC.nth($ND, xs, i), Some{$NI}, Some{M.N{c, lf, rt, q, k}}, nth_of_or($ND, xs, i, M.Free{0n}, hlt), Equal.cong($ND, Maybe<&2, $ND>, z => Some{z}, $NI, M.N{c, lf, rt, q, k}, hy))
  %Equal.sym(Bool, Nat.is_lt(i, $N0), True{}, hlt) : {M.ns_set_red_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, v, _) == $NRL(d, SC.update($ND, xs, i, M.N{v, lf, rt, q, k})) : $NSK}
  red_set_c(~K, $GA, i, v, c, lf, rt, q, k, hy2)

def red_set_fc(~K: Data, $GP, +i: Nat, +v: Bool, +z: Nat, +hy: {$NI == M.Free{z} : $ND}, +b: Bool, +hb: {Nat.is_lt(i, $N0) == b : Bool}) -> {M.ns_set_red_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, v, b) == $NRL(d, xs) : $NSK}:
  match b:
    case False{}:
      {==}
    case True{}:
      +hy2 = Equal.trans(Maybe<&2, $ND>, SC.nth($ND, xs, i), Some{$NI}, Some{M.Free{z}}, nth_of_or($ND, xs, i, M.Free{0n}, hb), Equal.cong($ND, Maybe<&2, $ND>, w => Some{w}, $NI, M.Free{z}, hy))
      %Equal.sym(Array<Nat> & Nat, Array.get(Nat, $TB(d, xs), U32.from_nat(i)), ($TB(d, xs), M.ntag(~K, M.Free{z})), NF.tag_get(~K, $GA, i, M.Free{z}, hy2)) : {M.ns_set_red_tag(~K, l, d, $P0, $N0, $LB(d, xs), $RB(d, xs), $PB(d, xs), $KB(d, xs), i, v, _) == $NRL(d, xs) : $NSK}
      {==}

# writing the field of a free slot (or past the length) changes nothing
def red_set_free(~K: Data, $GP, +i: Nat, +v: Bool, +z: Nat, +hy: {$NI == M.Free{z} : $ND}) -> {M.ns_set_red(~K, $NRL(d, xs), i, v) == $NRL(d, xs) : $NSK}:
  red_set_fc(~K, $GA, i, v, z, hy, Nat.is_lt(i, $N0), {==})

# ---- reading a slot's key ----

def key_ats(~K: Data, $GP, +i: Nat, +mv: Maybe<&2, $ND>, +hmv: {SC.nth($ND, xs, i) == mv : Maybe<&2, $ND>}, +hi: {Nat.is_lt(i, $N0) == True{} : Bool}) -> {M.ns_key_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, True{}) == ($NRL(d, xs), M.nkey(~K, $NI)) : $NSK & Maybe<&2, K>}:
  match mv:
    case None{}:
      Empty.absurd({M.ns_key_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, True{}) == ($NRL(d, xs), M.nkey(~K, $NI)) : $NSK & Maybe<&2, K>}, L.false_true(L.subst(Maybe<&2, $ND>, z => {isj($ND, z) == True{} : Bool}, SC.nth($ND, xs, i), None{}, hmv, nth_isj($ND, xs, i, hi))))
    case Some{+y}:
      %Equal.sym($ND, $NI, y, nth_or_some($ND, xs, i, y, M.Free{0n}, hmv)) : {M.ns_key_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, True{}) == ($NRL(d, xs), M.nkey(~K, _)) : $NSK & Maybe<&2, K>}
      %Equal.sym(Array<Maybe<&2, K>> & Maybe<&2, K>, Array.get(Maybe<&2, K>, $KB(d, xs), U32.from_nat(i)), ($KB(d, xs), M.nkey(~K, y)), NF.key_get(~K, $GA, i, y, hmv)) : {M.ns_key_fin(~K, l, d, $P0, $N0, $TB(d, xs), $LB(d, xs), $RB(d, xs), $PB(d, xs), _) == ($NRL(d, xs), M.nkey(~K, y)) : $NSK & Maybe<&2, K>}
      {==}

def key_atc(~K: Data, $GP, +i: Nat, +b: Bool, +hb: {Nat.is_lt(i, $N0) == b : Bool}) -> {M.ns_key_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, b) == ($NRL(d, xs), M.nkey(~K, $NI)) : $NSK & Maybe<&2, K>}:
  match b:
    case True{}:
      key_ats(~K, $GA, i, SC.nth($ND, xs, i), {==}, hb)
    case False{}:
      %Equal.sym($ND, $NI, M.Free{0n}, nth_or_hi($ND, xs, i, M.Free{0n}, hb)) : {M.ns_key_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, False{}) == ($NRL(d, xs), M.nkey(~K, _)) : $NSK & Maybe<&2, K>}
      {==}

# the key of the list's node (None for a free slot or past the length)
def key_at_ok(~K: Data, $GP, +i: Nat) -> {M.ns_key_at(~K, $NRL(d, xs), i) == ($NRL(d, xs), M.nkey(~K, $NI)) : $NSK & Maybe<&2, K>}:
  key_atc(~K, $GA, i, Nat.is_lt(i, $N0), {==})
