      {==}

# writing the field of a live node: the list with that field replaced
def left_set_node(~K: Data, $GP, +i: Nat, +v: Nat, +c: Bool, +lf: Nat, +rt: Nat, +q: Nat, +k: K, +hy: {$NI == M.N{c, lf, rt, q, k} : $ND}) -> {M.ns_set_left(~K, $NRL(d, xs), i, v) == $NRL(d, SC.update($ND, xs, i, M.N{c, v, rt, q, k})) : $NSK}:
  +hlt = nth_or_lt(~K, xs, i, M.N{c, lf, rt, q, k}, {==}, hy)
  +hy2 = Equal.trans(Maybe<&2, $ND>, SC.nth($ND, xs, i), Some{$NI}, Some{M.N{c, lf, rt, q, k}}, nth_of_or($ND, xs, i, M.Free{0n}, hlt), Equal.cong($ND, Maybe<&2, $ND>, z => Some{z}, $NI, M.N{c, lf, rt, q, k}, hy))
  %Equal.sym(Bool, Nat.is_lt(i, $N0), True{}, hlt) : {M.ns_set_left_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, v, _) == $NRL(d, SC.update($ND, xs, i, M.N{c, v, rt, q, k})) : $NSK}
  left_set_c(~K, $GA, i, v, c, lf, rt, q, k, hy2)

def left_set_fc(~K: Data, $GP, +i: Nat, +v: Nat, +z: Nat, +hy: {$NI == M.Free{z} : $ND}, +b: Bool, +hb: {Nat.is_lt(i, $N0) == b : Bool}) -> {M.ns_set_left_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, v, b) == $NRL(d, xs) : $NSK}:
  match b:
    case False{}:
      {==}
    case True{}:
      +hy2 = Equal.trans(Maybe<&2, $ND>, SC.nth($ND, xs, i), Some{$NI}, Some{M.Free{z}}, nth_of_or($ND, xs, i, M.Free{0n}, hb), Equal.cong($ND, Maybe<&2, $ND>, w => Some{w}, $NI, M.Free{z}, hy))
      %Equal.sym(Array<Nat> & Nat, Array.get(Nat, $TB(d, xs), U32.from_nat(i)), ($TB(d, xs), M.ntag(~K, M.Free{z})), NF.tag_get(~K, $GA, i, M.Free{z}, hy2)) : {M.ns_set_left_tag(~K, l, d, $P0, $N0, $LB(d, xs), $RB(d, xs), $PB(d, xs), $KB(d, xs), i, v, _) == $NRL(d, xs) : $NSK}
      {==}

# writing the field of a free slot (or past the length) changes nothing
def left_set_free(~K: Data, $GP, +i: Nat, +v: Nat, +z: Nat, +hy: {$NI == M.Free{z} : $ND}) -> {M.ns_set_left(~K, $NRL(d, xs), i, v) == $NRL(d, xs) : $NSK}:
  left_set_fc(~K, $GA, i, v, z, hy, Nat.is_lt(i, $N0), {==})

def right_set_c(~K: Data, $GP, +i: Nat, +v: Nat, +c: Bool, +lf: Nat, +rt: Nat, +q: Nat, +k: K, +hy2: {SC.nth($ND, xs, i) == Some{M.N{c, lf, rt, q, k}} : Maybe<&2, $ND>}) -> {M.ns_set_right_ok(~K, l, d, $P0, $N0, $ARRS(d, xs), i, v, True{}) == $NRL(d, SC.update($ND, xs, i, M.N{c, lf, v, q, k})) : $NSK}:
