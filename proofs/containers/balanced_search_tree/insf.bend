# ---- after allocating: attach, header, fix-up ----


def ent_new(-K: Data, -V: Data, +nla: List<&2, M.Node<K>>, +pla: List<&2, Maybe<&2, V>>, +x: Nat, +q: Nat, +k: K, +v: V, +hxn: {ST.nd(K, nla, x) == M.N{True{}, 0n, 0n, q, k} : M.Node<K>}, +hpx: {ST.pv(V, pla, x) == Some{v} : Maybe<&2, V>}) -> {ST.ent(K, V, ST.nd(K, nla, x), ST.pv(V, pla, x)) == Some{M.Entry{k, v}} : Maybe<&2, M.Entry<K, V>>}:
  %Equal.sym(M.Node<K>, ST.nd(K, nla, x), M.N{True{}, 0n, 0n, q, k}, hxn) : {ST.ent(K, V, _, ST.pv(V, pla, x)) == Some{M.Entry{k, v}} : Maybe<&2, M.Entry<K, V>>}
  %Equal.sym(Maybe<&2, V>, ST.pv(V, pla, x), Some{v}, hpx) : {ST.ent(K, V, M.N{True{}, 0n, 0n, q, k}, _) == Some{M.Entry{k, v}} : Maybe<&2, M.Entry<K, V>>}
  {==}

# the entries after attaching: the new one in the gap
