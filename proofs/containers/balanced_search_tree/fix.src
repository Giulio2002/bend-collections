import Base
import ../../lib/logic.bend as L
import ../../lib/nat.bend as N
import ../../lib/order.bend as O
import ../../../spec/lib/common.bend as SC
import ../../../src/containers/balanced_search_tree.bend as M
import ./state.bend as ST
import ./mirror.bend as MI
import ./tree.bend as TR
import ./ends.bend as EN
import ./path.bend as P
import ./plug.bend as PG
import ./setters.bend as SE
import ./rotm.bend as RM
import ./rotn.bend as RN
import ./rot.bend as RT
import ./rotp.bend as RP
import ./nbr.bend as NB
import ./dj.bend as DJ
import ./spath.bend as SP
import ../../lib/nat_list.bend as NL

# The insertion fix-up: from a red node z the path leads to, the loop
# recolours and rotates; whatever it does and however far its fuel goes, it
# ends with a black root over a linked tree of the same ids, entries and free
# chain. (source: tools/generators/tm_hand/fix.src)

%def ND M.Node<K>
%def NL List<&2, $ND>
%def LN List<&2, Nat>
%def MV Maybe<&2, V>
%def E M.Entry<K, V>
%def ES List<&2, $E>
%def CT List<&2, P.Fr>
%def APP(a, b) SC.append(Nat, a, b)
%def IDS(t) ST.ids(t)
%def TN(i, a, b) ST.TN{i, a, b}
%def TO ~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, ~o: O.Order(~K, ~cmp)
%def AK ~K, ~V, ~cmp
%def AO ~K, ~V, ~cmp, ~o
%def AO3 ~K, ~cmp, ~o
%def FX +n: Nat, +lo: Nat, +hi: Nat, +free: Nat, +l: Nat, +d: Nat, +pl: List<&2, $MV>, +tg: ST.Tr, +fl: $LN, +fx: $LN, +i0: $LN, +e0: $ES, +l0: Nat
%def FXA n, lo, hi, free, l, d, pl, tg, fl, fx, i0, e0, l0
%def SHR(r, x) ST.SH{n, r, lo, hi, free, l, d, x, pl, tg, fl}
%def SHT ST.Sh<K, V>
%def FIX(f, st) MI.insert_fix_loop($AK, f, st)
%def NDX(nl, j) ST.nd(K, nl, j)
%def REPN(t, p, x) {ST.rep(~K, t, p, x) == True{} : Bool}
%def COKN(c, z, x) {P.ctxok(~K, c, z, x) == True{} : Bool}
%def NDL(xs) {NL.nodupn(xs) == True{} : Bool}
%def WH(c, t) $APP(P.before(c), $APP($IDS(t), P.after(c)))
%def INV(x) {ST.ents(~K, ~V, i0, x, pl) == e0 : $ES} & ({EN.oks(~K, ~V, i0, x, pl) == True{} : Bool} & ({ST.fll(~K, x, fx) == True{} : Bool} & {SC.length($ND, x) == l0 : Nat}))
%def IVH(x) +h4: {ST.ents(~K, ~V, i0, x, pl) == e0 : $ES}, +h5: {EN.oks(~K, ~V, i0, x, pl) == True{} : Bool}, +h6: {ST.fll(~K, x, fx) == True{} : Bool}, +h7: {SC.length($ND, x) == l0 : Nat}
%def TPR(r, x, t) $REPN(t, 0n, x) & ({r == ST.rid(t) : Nat} & ({$IDS(t) == i0 : $LN} & ({ST.root_black(~K, t, x) == True{} : Bool} & $INV(x))))
%def FP(res) Sigma<&1, &1, Nat, fr_ => Sigma<&1, &1, $NL, fn_ => Sigma<&1, &1, ST.Tr, ft_ => {res == $SHR(fr_, fn_) : $SHT} & $TPR(fr_, fn_, ft_)>>>

# ---- the end: the root blackened ----

def rb_set(~K: Data, +nl: $NL, +t: ST.Tr, +r: Nat, +hr: {r == ST.rid(t) : Nat}) -> {ST.root_black(~K, t, SE.setc(K, nl, r, False{})) == True{} : Bool}:
  match t:
    case ST.TE{}:
      {==}
    case ST.TN{+i, +a, +b}:
      %Equal.sym(Nat, r, i, hr) : {Bool.not(ST.is_red(K, $NDX(SE.setc(K, nl, _, False{}), i))) == True{} : Bool}
      %Equal.sym($ND, $NDX(SE.setc(K, nl, i, False{}), i), SE.modc(K, $NDX(nl, i), False{}), RN.hitc(K, nl, i, False{})) : {Bool.not(ST.is_red(K, _)) == True{} : Bool}
      %Equal.sym(Bool, ST.is_red(K, SE.modc(K, $NDX(nl, i), False{})), False{}, SE.red_modc(K, $NDX(nl, i), False{}, {==})) : {Bool.not(_) == True{} : Bool}
      {==}

def inv_setc(~K: Data, ~V: Data, +pl: List<&2, $MV>, +fx: $LN, +i0: $LN, +e0: $ES, +l0: Nat, +nl: $NL, +id: Nat, +v: Bool, $IVH(nl)) -> $INV(SE.setc(K, nl, id, v)):
  (Equal.trans($ES, ST.ents(~K, ~V, i0, SE.setc(K, nl, id, v), pl), ST.ents(~K, ~V, i0, nl, pl), e0, SE.ents_setc(~K, ~V, i0, nl, pl, id, v), h4), (Equal.trans(Bool, EN.oks(~K, ~V, i0, SE.setc(K, nl, id, v), pl), EN.oks(~K, ~V, i0, nl, pl), True{}, SE.oks_setc(~K, ~V, i0, nl, pl, id, v), h5), (Equal.trans(Bool, ST.fll(~K, SE.setc(K, nl, id, v), fx), ST.fll(~K, nl, fx), True{}, SE.fll_setc(~K, fx, nl, id, v), h6), Equal.trans(Nat, SC.length($ND, SE.setc(K, nl, id, v)), SC.length($ND, nl), l0, SE.setc_len(K, nl, id, v), h7))))

%def TH +t: ST.Tr, +h1: $REPN(t, 0n, nl), +h2: {root == ST.rid(t) : Nat}, +h3: {$IDS(t) == i0 : $LN}

# a linked tree of the ids: blackening the root finishes
def fin($TO, $FX, +root: Nat, +nl: $NL, $TH, $IVH(nl)) -> $FP(MI.black_root($AK, $SHR(root, nl))):
  %Equal.sym($SHT, MI.black_root($AK, $SHR(root, nl)), $SHR(root, SE.setc(K, nl, root, False{})), SE.set_red_m($AK, n, root, lo, hi, free, l, d, nl, pl, tg, fl, root, False{})) : $FP(_)
  (root, (SE.setc(K, nl, root, False{}), (t, ({==}, (Equal.trans(Bool, ST.rep(~K, t, 0n, SE.setc(K, nl, root, False{})), ST.rep(~K, t, 0n, nl), True{}, SE.rep_setc(~K, t, 0n, nl, root, False{}), h1), (h2, (h3, (rb_set(~K, nl, t, root, h2), inv_setc(~K, ~V, pl, fx, i0, e0, l0, nl, root, False{}, h4, h5, h6, h7)))))))))

# the loop after a step that stops
def stop($TO, $FX, +f: Nat, +root: Nat, +nl: $NL, $TH, $IVH(nl)) -> $FP($FIX(f, ($SHR(root, nl), M.Fix{0n, False{}}))):
  match f:
    case 0n:
      fin($AO, $FXA, root, nl, t, h1, h2, h3, h4, h5, h6, h7)
    case 1n+g:
      fin($AO, $FXA, root, nl, t, h1, h2, h3, h4, h5, h6, h7)

# ---- from the path invariant ----

def isnil(c: $CT) -> Bool:
  match c:
    case Nil{}:
      True{}
    case Con{f, u}:
      False{}

%def FRM(p, lft, s) P.FR{p, lft, s}
%def CK(f, x, q, m) P.cok1(~K, f, x, q, m)

# a subtree under its parent, the parent's frame: the parent's subtree
def up_t(~K: Data, +nl: $NL, +p: Nat, +s: ST.Tr, +t: ST.Tr, +q: Nat, +hr: $REPN(t, p, nl), +hk: {$CK($FRM(p, True{}, s), ST.rid(t), q, nl) == True{} : Bool}) -> $REPN($TN(p, t, s), q, nl):
  +h0 = L.and_left(Nat.is_lt(0n, p), Bool.and(ST.is_node(K, $NDX(nl, p), ST.rid(t), ST.rid(s), q), ST.rep(~K, s, p, nl)), hk)
  +h12 = L.and_right(Nat.is_lt(0n, p), Bool.and(ST.is_node(K, $NDX(nl, p), ST.rid(t), ST.rid(s), q), ST.rep(~K, s, p, nl)), hk)
  RT.rep_intro(~K, nl, p, t, s, q, h0, L.and_left(ST.is_node(K, $NDX(nl, p), ST.rid(t), ST.rid(s), q), ST.rep(~K, s, p, nl), h12), hr, L.and_right(ST.is_node(K, $NDX(nl, p), ST.rid(t), ST.rid(s), q), ST.rep(~K, s, p, nl), h12))

def up_f(~K: Data, +nl: $NL, +p: Nat, +s: ST.Tr, +t: ST.Tr, +q: Nat, +hr: $REPN(t, p, nl), +hk: {$CK($FRM(p, False{}, s), ST.rid(t), q, nl) == True{} : Bool}) -> $REPN($TN(p, s, t), q, nl):
  +h0 = L.and_left(Nat.is_lt(0n, p), Bool.and(ST.is_node(K, $NDX(nl, p), ST.rid(s), ST.rid(t), q), ST.rep(~K, s, p, nl)), hk)
  +h12 = L.and_right(Nat.is_lt(0n, p), Bool.and(ST.is_node(K, $NDX(nl, p), ST.rid(s), ST.rid(t), q), ST.rep(~K, s, p, nl)), hk)
  RT.rep_intro(~K, nl, p, s, t, q, h0, L.and_left(ST.is_node(K, $NDX(nl, p), ST.rid(s), ST.rid(t), q), ST.rep(~K, s, p, nl), h12), L.and_right(ST.is_node(K, $NDX(nl, p), ST.rid(s), ST.rid(t), q), ST.rep(~K, s, p, nl), h12), hr)

%def ZT $TN(z, zl, zr)
%def FIH +c: $CT, +z: Nat, +zl: ST.Tr, +zr: ST.Tr, +i1: $REPN($ZT, P.top(c), nl), +i2: $COKN(c, z, nl), +i3: $NDL($WH(c, $ZT)), +i4: {$WH(c, $ZT) == i0 : $LN}, +i5: {root == ST.rid(PG.plug(c, $ZT)) : Nat}, +i6: {Bool.or(ST.root_black(~K, PG.plug(c, $ZT), nl), isnil(c)) == True{} : Bool}
%def FIA c, z, zl, zr, i1, i2, i3, i4, i5, i6

# the path invariant gives the whole tree
def fi_stop($TO, $FX, +f: Nat, +root: Nat, +nl: $NL, $FIH, $IVH(nl)) -> $FP($FIX(f, ($SHR(root, nl), M.Fix{0n, False{}}))):
  stop($AO, $FXA, f, root, nl, PG.plug(c, $ZT), PG.rep_plug(~K, nl, c, $ZT, i1, i2), i5, Equal.trans($LN, $IDS(PG.plug(c, $ZT)), $WH(c, $ZT), i0, PG.ids_plug(c, $ZT), i4), h4, h5, h6, h7)

def rb_rid(~K: Data, +t: ST.Tr, +x: $NL) -> {ST.root_black(~K, t, x) == Bool.not(ST.is_red(K, $NDX(x, ST.rid(t)))) : Bool}:
  match t:
    case ST.TE{}:
      {==}
    case ST.TN{+i, a, b}:
      {==}

def red_eq(-K: Data, +x: $ND) -> {M.node_red(~K, x) == ST.is_red(K, x) : Bool}:
  match x:
    case M.Free{f}:
      {==}
    case M.N{c, a, b, q, k}:
      {==}

# ---- the root is on the path, away from the subtree ----

%def BA(c) $APP(P.before(c), P.after(c))
%def MEM(y, xs) {NL.memn(y, xs) == True{} : Bool}
%def NMEM(y, xs) {NL.memn(y, xs) == False{} : Bool}

# a member of the frames above is a member of the frames
def ba_up_c(+w: Nat, +q: Nat, +lft: Bool, +s: ST.Tr, +u: $CT, +b: Bool, +hb: {NL.memn(w, P.before(u)) == b : Bool}, +h: $MEM(w, $BA(u))) -> $MEM(w, $BA(Con{$FRM(q, lft, s), u})):
  match lft b:
    case True{} True{}:
      DJ.mem_l(w, P.before(u), Con{q, $APP($IDS(s), P.after(u))}, hb)
    case False{} True{}:
      DJ.mem_l(w, $APP(P.before(u), $APP($IDS(s), Con{q, Nil{}})), P.after(u), DJ.mem_l(w, P.before(u), $APP($IDS(s), Con{q, Nil{}}), hb))
    case True{} False{}:
      +ha = L.subst(Bool, z => {Bool.or(z, NL.memn(w, P.after(u))) == True{} : Bool}, NL.memn(w, P.before(u)), False{}, hb, L.subst(Bool, z => {z == True{} : Bool}, NL.memn(w, $BA(u)), Bool.or(NL.memn(w, P.before(u)), NL.memn(w, P.after(u))), NL.memn_app(w, P.before(u), P.after(u)), h))
      DJ.mem_r(w, P.before(u), Con{q, $APP($IDS(s), P.after(u))}, DJ.mem_tl(w, q, $APP($IDS(s), P.after(u)), DJ.mem_r(w, $IDS(s), P.after(u), ha)))
    case False{} False{}:
      +ha = L.subst(Bool, z => {Bool.or(z, NL.memn(w, P.after(u))) == True{} : Bool}, NL.memn(w, P.before(u)), False{}, hb, L.subst(Bool, z => {z == True{} : Bool}, NL.memn(w, $BA(u)), Bool.or(NL.memn(w, P.before(u)), NL.memn(w, P.after(u))), NL.memn_app(w, P.before(u), P.after(u)), h))
      DJ.mem_r(w, $APP(P.before(u), $APP($IDS(s), Con{q, Nil{}})), P.after(u), ha)

def q_in(+q: Nat, +lft: Bool, +s: ST.Tr, +u: $CT) -> $MEM(q, $BA(Con{$FRM(q, lft, s), u})):
  match lft:
    case True{}:
      DJ.mem_r(q, P.before(u), Con{q, $APP($IDS(s), P.after(u))}, DJ.mem_hd(q, $APP($IDS(s), P.after(u))))
    case False{}:
      DJ.mem_l(q, $APP(P.before(u), $APP($IDS(s), Con{q, Nil{}})), P.after(u), DJ.mem_r(q, P.before(u), $APP($IDS(s), Con{q, Nil{}}), DJ.mem_r(q, $IDS(s), Con{q, Nil{}}, DJ.mem_hd(q, Nil{}))))

# a nonempty path's plugged root is one of its frames' parents
def rid_in(+u: $CT, +q: Nat, +lft: Bool, +s: ST.Tr, +t: ST.Tr) -> $MEM(ST.rid(PG.plug(Con{$FRM(q, lft, s), u}, t)), $BA(Con{$FRM(q, lft, s), u})):
  match u lft:
    case Nil{} True{}:
      q_in(q, True{}, s, Nil{})
    case Nil{} False{}:
      q_in(q, False{}, s, Nil{})
    case Con{P.FR{+q2, +l2, +s2}, +u2} True{}:
      +ih = rid_in(u2, q2, l2, s2, $TN(q, t, s))
      ba_up_c(ST.rid(PG.plug(Con{$FRM(q2, l2, s2), u2}, $TN(q, t, s))), q, True{}, s, Con{$FRM(q2, l2, s2), u2}, NL.memn(ST.rid(PG.plug(Con{$FRM(q2, l2, s2), u2}, $TN(q, t, s))), P.before(Con{$FRM(q2, l2, s2), u2})), {==}, ih)
    case Con{P.FR{+q2, +l2, +s2}, +u2} False{}:
      +ih = rid_in(u2, q2, l2, s2, $TN(q, s, t))
      ba_up_c(ST.rid(PG.plug(Con{$FRM(q2, l2, s2), u2}, $TN(q, s, t))), q, False{}, s, Con{$FRM(q2, l2, s2), u2}, NL.memn(ST.rid(PG.plug(Con{$FRM(q2, l2, s2), u2}, $TN(q, s, t))), P.before(Con{$FRM(q2, l2, s2), u2})), {==}, ih)

%def N1C SE.setc(K, nl, p, False{})
%def N2C SE.setc(K, $N1C, u, False{})
%def N3C SE.setc(K, $N2C, g, True{})
%def RID(c, t) ST.rid(PG.plug(c, t))

# three recolourings away from the root keep it black
def rb_keep3(~K: Data, +nl: $NL, +c: $CT, +t: ST.Tr, +p: Nat, +u: Nat, +g: Nat, +hn: $NDL($WH(c, t)), +mp: $MEM(p, $IDS(t)), +mu: $MEM(u, $IDS(t)), +mg: $MEM(g, $IDS(t)), +h: {Bool.or(ST.root_black(~K, PG.plug(c, t), nl), isnil(c)) == True{} : Bool}) -> {Bool.or(ST.root_black(~K, PG.plug(c, t), $N3C), isnil(c)) == True{} : Bool}:
  match c:
    case Nil{}:
      NL.or_true_b(ST.root_black(~K, t, $N3C))
    case Con{P.FR{+q, +lft, +s}, +w}:
      +mr = rid_in(w, q, lft, s, t)
      +np = RP.w_notin(Con{$FRM(q, lft, s), w}, t, hn, p, mp)
      +nu = RP.w_notin(Con{$FRM(q, lft, s), w}, t, hn, u, mu)
      +ng = RP.w_notin(Con{$FRM(q, lft, s), w}, t, hn, g, mg)
      +R = $RID(Con{$FRM(q, lft, s), w}, t)
      %Equal.sym(Bool, ST.root_black(~K, PG.plug(Con{$FRM(q, lft, s), w}, t), $N3C), Bool.not(ST.is_red(K, $NDX($N3C, R))), rb_rid(~K, PG.plug(Con{$FRM(q, lft, s), w}, t), $N3C)) : {Bool.or(_, False{}) == True{} : Bool}
      %Equal.sym($ND, $NDX($N3C, R), $NDX($N2C, R), RN.skipc(K, $N2C, g, True{}, R, DJ.ne_nm(g, R, $BA(Con{$FRM(q, lft, s), w}), ng, mr))) : {Bool.or(Bool.not(ST.is_red(K, _)), False{}) == True{} : Bool}
      %Equal.sym($ND, $NDX($N2C, R), $NDX($N1C, R), RN.skipc(K, $N1C, u, False{}, R, DJ.ne_nm(u, R, $BA(Con{$FRM(q, lft, s), w}), nu, mr))) : {Bool.or(Bool.not(ST.is_red(K, _)), False{}) == True{} : Bool}
      %Equal.sym($ND, $NDX($N1C, R), $NDX(nl, R), RN.skipc(K, nl, p, False{}, R, DJ.ne_nm(p, R, $BA(Con{$FRM(q, lft, s), w}), np, mr))) : {Bool.or(Bool.not(ST.is_red(K, _)), False{}) == True{} : Bool}
      %Equal.sym(Bool, Bool.not(ST.is_red(K, $NDX(nl, R))), ST.root_black(~K, PG.plug(Con{$FRM(q, lft, s), w}, t), nl), Equal.sym(Bool, ST.root_black(~K, PG.plug(Con{$FRM(q, lft, s), w}, t), nl), Bool.not(ST.is_red(K, $NDX(nl, R))), rb_rid(~K, PG.plug(Con{$FRM(q, lft, s), w}, t), nl))) : {Bool.or(_, False{}) == True{} : Bool}
      h

# ---- the loop's continuation ----

%def KT(t) $TN(kz_, kzl_, kzr_)
%def KONT(gf) @+kr_: Nat -> @+kn_: $NL -> @+kc_: $CT -> @+kz_: Nat -> @+kzl_: ST.Tr -> @+kzr_: ST.Tr -> @+ki1: $REPN($KT(0), P.top(kc_), kn_) -> @+ki2: $COKN(kc_, kz_, kn_) -> @+ki3: $NDL($WH(kc_, $KT(0))) -> @+ki4: {$WH(kc_, $KT(0)) == i0 : $LN} -> @+ki5: {kr_ == ST.rid(PG.plug(kc_, $KT(0))) : Nat} -> @+ki6: {Bool.or(ST.root_black(~K, PG.plug(kc_, $KT(0)), kn_), isnil(kc_)) == True{} : Bool} -> @+kh4: {ST.ents(~K, ~V, i0, kn_, pl) == e0 : $ES} -> @+kh5: {EN.oks(~K, ~V, i0, kn_, pl) == True{} : Bool} -> @+kh6: {ST.fll(~K, kn_, fx) == True{} : Bool} -> @+kh7: {SC.length($ND, kn_) == l0 : Nat} -> $FP($FIX(gf, ($SHR(kr_, kn_), M.Fix{kz_, True{}})))

%def GT $TN(g, ga, gb)
%def SR3 MI.set_red($AK, MI.set_red($AK, MI.set_red($AK, $SHR(root, nl), p, False{}), u, False{}), g, True{})
%def C3(f, x) f(K, $N2C, g, True{}, x)
%def TRB(a, b, c, ea, eb) Equal.trans(Bool, a, b, c, ea, eb)

# recolouring the parent, the uncle black and the grandparent red, then
# going on from the grandparent
def rc_go($TO, $FX, +gf: Nat, +root: Nat, +nl: $NL, +c2: $CT, +g: Nat, +ga: ST.Tr, +gb: ST.Tr, +p: Nat, +u: Nat, +i1: $REPN($GT, P.top(c2), nl), +i2: $COKN(c2, g, nl), +i3: $NDL($WH(c2, $GT)), +i4: {$WH(c2, $GT) == i0 : $LN}, +i5: {root == ST.rid(PG.plug(c2, $GT)) : Nat}, +i6: {Bool.or(ST.root_black(~K, PG.plug(c2, $GT), nl), isnil(c2)) == True{} : Bool}, +mp: $MEM(p, $IDS($GT)), +mu: $MEM(u, $IDS($GT)), $IVH(nl), kont: $KONT(gf)) -> $FP($FIX(gf, ($SR3, M.Fix{g, True{}}))):
  %Equal.sym($SHT, MI.set_red($AK, $SHR(root, nl), p, False{}), $SHR(root, $N1C), SE.set_red_m($AK, n, root, lo, hi, free, l, d, nl, pl, tg, fl, p, False{})) : $FP($FIX(gf, (MI.set_red($AK, MI.set_red($AK, _, u, False{}), g, True{}), M.Fix{g, True{}})))
  %Equal.sym($SHT, MI.set_red($AK, $SHR(root, $N1C), u, False{}), $SHR(root, $N2C), SE.set_red_m($AK, n, root, lo, hi, free, l, d, $N1C, pl, tg, fl, u, False{})) : $FP($FIX(gf, (MI.set_red($AK, _, g, True{}), M.Fix{g, True{}})))
  %Equal.sym($SHT, MI.set_red($AK, $SHR(root, $N2C), g, True{}), $SHR(root, $N3C), SE.set_red_m($AK, n, root, lo, hi, free, l, d, $N2C, pl, tg, fl, g, True{})) : $FP($FIX(gf, (_, M.Fix{g, True{}})))
  +r1 = $TRB(ST.rep(~K, $GT, P.top(c2), $N3C), ST.rep(~K, $GT, P.top(c2), $N2C), True{}, SE.rep_setc(~K, $GT, P.top(c2), $N2C, g, True{}), $TRB(ST.rep(~K, $GT, P.top(c2), $N2C), ST.rep(~K, $GT, P.top(c2), $N1C), True{}, SE.rep_setc(~K, $GT, P.top(c2), $N1C, u, False{}), $TRB(ST.rep(~K, $GT, P.top(c2), $N1C), ST.rep(~K, $GT, P.top(c2), nl), True{}, SE.rep_setc(~K, $GT, P.top(c2), nl, p, False{}), i1)))
