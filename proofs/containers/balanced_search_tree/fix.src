# ---- the parent's colour ----

def rid_p1(+p: Nat, +l1: Bool, +s1: ST.Tr, +t: ST.Tr) -> {ST.rid(PG.plug(Con{$FRM(p, l1, s1), Nil{}}, t)) == p : Nat}:
  match l1:
    case True{}:
      {==}
    case False{}:
      {==}

%def C1P Con{$FRM(p, l1, s1), c1}

def parent($TO, $FX, +gf: Nat, +root: Nat, +nl: $NL, +p: Nat, +l1: Bool, +s1: ST.Tr, +c1: $CT, +z: Nat, +zl: ST.Tr, +zr: ST.Tr, +i1: $REPN($ZT, p, nl), +i2: $COKN($C1P, z, nl), +i3: $NDL($WH($C1P, $ZT)), +i4: {$WH($C1P, $ZT) == i0 : $LN}, +i5: {root == ST.rid(PG.plug($C1P, $ZT)) : Nat}, +i6: {Bool.or(ST.root_black(~K, PG.plug($C1P, $ZT), nl), False{}) == True{} : Bool}, $IVH(nl), kont: $KONT(gf), +b: Bool, +hb: {M.node_red(~K, $NDX(nl, p)) == b : Bool}) -> $FP($FIX(gf, MI.insert_parent($AK, $SHR(root, nl), z, p, $NDX(nl, p), b))):
  match c1 b:
    case +c1 False{}:
      fi_stop($AO, $FXA, gf, root, nl, $C1P, z, zl, zr, i1, i2, i3, i4, i5, i6, h4, h5, h6, h7)
    case Nil{} True{}:
      +er = rid_p1(p, l1, s1, $ZT)
      +e1 = Equal.trans(Bool, ST.root_black(~K, PG.plug(Con{$FRM(p, l1, s1), Nil{}}, $ZT), nl), Bool.not(ST.is_red(K, $NDX(nl, ST.rid(PG.plug(Con{$FRM(p, l1, s1), Nil{}}, $ZT))))), Bool.not(ST.is_red(K, $NDX(nl, p))), rb_rid(~K, PG.plug(Con{$FRM(p, l1, s1), Nil{}}, $ZT), nl), L.subst(Nat, w => {Bool.not(ST.is_red(K, $NDX(nl, ST.rid(PG.plug(Con{$FRM(p, l1, s1), Nil{}}, $ZT))))) == Bool.not(ST.is_red(K, $NDX(nl, w))) : Bool}, ST.rid(PG.plug(Con{$FRM(p, l1, s1), Nil{}}, $ZT)), p, er, {==}))
      +e2 = Equal.trans(Bool, ST.is_red(K, $NDX(nl, p)), M.node_red(~K, $NDX(nl, p)), True{}, Equal.sym(Bool, M.node_red(~K, $NDX(nl, p)), ST.is_red(K, $NDX(nl, p)), red_eq(K, $NDX(nl, p))), hb)
      +e3 = L.subst(Bool, w => {ST.root_black(~K, PG.plug(Con{$FRM(p, l1, s1), Nil{}}, $ZT), nl) == Bool.not(w) : Bool}, ST.is_red(K, $NDX(nl, p)), True{}, e2, e1)
      Empty.absurd($FP($FIX(gf, MI.insert_parent($AK, $SHR(root, nl), z, p, $NDX(nl, p), True{}))), L.false_true(L.subst(Bool, w => {Bool.or(w, False{}) == True{} : Bool}, ST.root_black(~K, PG.plug(Con{$FRM(p, l1, s1), Nil{}}, $ZT), nl), False{}, e3, i6)))
    case Con{P.FR{+g, +l2, +s2}, +c2} True{}:
      grand($AO, $FXA, gf, root, nl, c2, p, l1, s1, g, l2, s2, z, zl, zr, i1, i2, i3, i4, i5, i6, h4, h5, h6, h7, kont)

# ---- a step, and the loop ----

def step($TO, $FX, +gf: Nat, +root: Nat, +nl: $NL, $FIH, $IVH(nl), kont: $KONT(gf)) -> $FP($FIX(1n+gf, ($SHR(root, nl), M.Fix{z, True{}}))):
  match c:
    case Nil{}:
      %Equal.sym(Nat, M.node_parent(~K, $NDX(nl, z)), 0n, NB.parent_eq(~K, $NDX(nl, z), ST.rid(zl), ST.rid(zr), 0n, TR.rep_node(~K, z, zl, zr, 0n, nl, i1))) : $FP($FIX(gf, MI.insert_parent($AK, $SHR(root, nl), z, _, $NDX(nl, _), M.node_red(~K, $NDX(nl, _)))))
      fi_stop($AO, $FXA, gf, root, nl, Nil{}, z, zl, zr, i1, i2, i3, i4, i5, i6, h4, h5, h6, h7)
    case Con{P.FR{+p, +l1, +s1}, +c1}:
      %Equal.sym(Nat, M.node_parent(~K, $NDX(nl, z)), p, NB.parent_eq(~K, $NDX(nl, z), ST.rid(zl), ST.rid(zr), p, TR.rep_node(~K, z, zl, zr, p, nl, i1))) : $FP($FIX(gf, MI.insert_parent($AK, $SHR(root, nl), z, _, $NDX(nl, _), M.node_red(~K, $NDX(nl, _)))))
      parent($AO, $FXA, gf, root, nl, p, l1, s1, c1, z, zl, zr, i1, i2, i3, i4, i5, i6, h4, h5, h6, h7, kont, M.node_red(~K, $NDX(nl, p)), {==})

# from a red node the path leads to, the loop ends with the ghost tree's
# properties, whatever its fuel
def loop($TO, $FX, +gf: Nat, +root: Nat, +nl: $NL, $FIH, $IVH(nl)) -> $FP($FIX(gf, ($SHR(root, nl), M.Fix{z, True{}}))):
  match gf:
    case 0n:
      fin($AO, $FXA, root, nl, PG.plug(c, $ZT), PG.rep_plug(~K, nl, c, $ZT, i1, i2), i5, Equal.trans($LN, $IDS(PG.plug(c, $ZT)), $WH(c, $ZT), i0, PG.ids_plug(c, $ZT), i4), h4, h5, h6, h7)
    case 1n+g:
      step($AO, $FXA, g, root, nl, c, z, zl, zr, i1, i2, i3, i4, i5, i6, h4, h5, h6, h7, kr_ => kn_ => kc_ => kz_ => kzl_ => kzr_ => ki1 => ki2 => ki3 => ki4 => ki5 => ki6 => kh4 => kh5 => kh6 => kh7 => loop($AO, $FXA, g, kr_, kn_, kc_, kz_, kzl_, kzr_, ki1, ki2, ki3, ki4, ki5, ki6, kh4, kh5, kh6, kh7))
