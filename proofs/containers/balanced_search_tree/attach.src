      +v1 = L.subst(Nat, z => {$RB(PG.plug($FRC(q, True{}, s, u), $XT), SE.setp(K, RM.attn(K, nla, q, x, True{}), x, q)) == Bool.not(ST.is_red(K, $NDX(SE.setp(K, RM.attn(K, nla, q, x, True{}), x, q), z))) : Bool}, ST.rid(PG.plug($FRC(q, True{}, s, u), $XT)), ST.rid(PG.plug($FRC(q, True{}, s, u), $TE)), RP.rid_plug_tn(u, q, $XT, s, $TE, s), FX.rb_rid(~K, PG.plug($FRC(q, True{}, s, u), $XT), SE.setp(K, RM.attn(K, nla, q, x, True{}), x, q)))
      +v2 = L.subst(Bool, z => {$RB(PG.plug($FRC(q, True{}, s, u), $XT), SE.setp(K, RM.attn(K, nla, q, x, True{}), x, q)) == Bool.not(z) : Bool}, ST.is_red(K, $NDX(SE.setp(K, RM.attn(K, nla, q, x, True{}), x, q), ST.rid(PG.plug($FRC(q, True{}, s, u), $TE)))), ST.is_red(K, $NDX(nl, ST.rid(PG.plug($FRC(q, True{}, s, u), $TE)))), e1, v1)
      +v3 = Equal.trans(Bool, $RB(PG.plug($FRC(q, True{}, s, u), $XT), SE.setp(K, RM.attn(K, nla, q, x, True{}), x, q)), Bool.not(ST.is_red(K, $NDX(nl, ST.rid(PG.plug($FRC(q, True{}, s, u), $TE))))), True{}, v2, Equal.trans(Bool, Bool.not(ST.is_red(K, $NDX(nl, ST.rid(PG.plug($FRC(q, True{}, s, u), $TE))))), $RB(PG.plug($FRC(q, True{}, s, u), $TE), nl), True{}, Equal.sym(Bool, $RB(PG.plug($FRC(q, True{}, s, u), $TE), nl), Bool.not(ST.is_red(K, $NDX(nl, ST.rid(PG.plug($FRC(q, True{}, s, u), $TE))))), FX.rb_rid(~K, PG.plug($FRC(q, True{}, s, u), $TE), nl)), hrb))
      FX.or_lt($RB(PG.plug($FRC(q, True{}, s, u), $XT), SE.setp(K, RM.attn(K, nla, q, x, True{}), x, q)), False{}, v3)
    case Con{P.FR{+q, False{}, +s}, +u}:
      +mR = FX.rid_in(u, q, False{}, s, $TE)
