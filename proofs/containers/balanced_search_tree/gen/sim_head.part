def set_red_sc(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, $FT, $PT, +i: Nat, +v: Bool, +y: $ND, +hy: {ST.nth_or($ND, nl, i, M.Free{0n}) == y : $ND}) -> {M.TM{n, root, lo, hi, free, M.ns_set_red(~K, ST.nodes(~K, l, d, nl), i, v), ST.pays(~V, l, d, pl)} == ST.real(~K, ~V, ~cmp, MI.set_red_node(~K, ~V, ~cmp, $SH0, 1n+i, v, y)) : $TMT}:
