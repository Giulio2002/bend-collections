import Base
import ../../lib/logic.bend as L
import ../../lib/nat.bend as N
import ../../lib/u32.bend as U
import ../../lib/array.bend as AR
import ../../lib/list.bend as LL
import ../../../spec/lib/common.bend as SC
import ../../../src/containers/balanced_search_tree.bend as M
import ../../../src/containers/dynamic_array.bend as D
import ../../../src/containers/types/dynamic_array.bend as DE
import ../dynamic_array/layout.bend as LY
import ../dynamic_array/state.bend as DAS
import ../dynamic_array/steps.bend as DST
import ./state.bend as ST
import ./mk.bend as MK
import ./da.bend as DA
import ./arr.bend as AB
import ./prim.bend as PR
import ./nsl.bend as NSL
import ./mirror.bend as MI

# The simulation: every implementation function applied to realizations of
# mirror values is the realization of the mirror's result, whenever the
# arrays have their layout (MI.dg). (generated by
# tools/generators/tm_mirror.py; the primitives are hand-written in
# tools/generators/tm_hand/sim_head.bend)

%def ND M.Node<K>
%def MV Maybe<&2, V>
%def SHV ST.Sh<K, V>
%def TMT M.TreeMap<K, V, cmp>
%def F n, root, lo, hi, free, l, d, nl, pl, t, fl
%def FP +n, +root, +lo, +hi, +free, +l, +d, +nl, +pl, +t, +fl
%def SH0 ST.SH{n, root, lo, hi, free, l, d, nl, pl, t, fl}
%def B1 Nat.is_le(l, 31n)
%def B2 Nat.is_le(d, l)
%def B3 Nat.is_le(SC.length($ND, nl), SC.pow2(d))
%def B4 Nat.is_eq(SC.length($MV, pl), SC.length($ND, nl))
%def HL(g) L.and_left($B1, Bool.and($B2, Bool.and($B3, $B4)), g)
%def HD(g) L.and_left($B2, Bool.and($B3, $B4), L.and_right($B1, Bool.and($B2, Bool.and($B3, $B4)), g))
%def HC(g) L.and_left($B3, $B4, L.and_right($B2, Bool.and($B3, $B4), L.and_right($B1, Bool.and($B2, Bool.and($B3, $B4)), g)))
%def HP(g) L.and_right($B3, $B4, L.and_right($B2, Bool.and($B3, $B4), L.and_right($B1, Bool.and($B2, Bool.and($B3, $B4)), g)))
%def DGS(g) $HL(g), $HD(g), $HC(g), $HP(g)

# ---- reads ----

def read_g(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +m: $SHV, +id: Nat, +g_m: {MI.dg(K, V, m) == True{} : Bool}) -> {MI.dgp(K, V, $ND, MI.read(~K, ~V, ~cmp, m, id)) == True{} : Bool}:
  g_m

def read_s(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +m: $SHV, +id: Nat, +g_m: {MI.dg(K, V, m) == True{} : Bool}) -> {M.read(~K, ~V, ~cmp, ST.real(~K, ~V, ~cmp, m), id) == MI.rp(~K, ~V, ~cmp, $ND, MI.read(~K, ~V, ~cmp, m, id)) : $TMT & $ND}:
  match m:
    case ST.SH{$FP}:
      PR.read_c(~K, ~V, ~cmp, $F, $DGS(g_m), id)

def get_id_g(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +m: $SHV, +id: Nat, +g_m: {MI.dg(K, V, m) == True{} : Bool}) -> {MI.dgp(K, V, $MV, MI.get_id(~K, ~V, ~cmp, m, id)) == True{} : Bool}:
  g_m

def get_id_s(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +m: $SHV, +id: Nat, +g_m: {MI.dg(K, V, m) == True{} : Bool}) -> {M.get_id(~K, ~V, ~cmp, ST.real(~K, ~V, ~cmp, m), id) == MI.rp(~K, ~V, ~cmp, $MV, MI.get_id(~K, ~V, ~cmp, m, id)) : $TMT & $MV}:
  match m:
    case ST.SH{$FP}:
      PR.get_id_c(~K, ~V, ~cmp, $F, $DGS(g_m), id)

# ---- writes ----

def len_wr_c(-K: Data, +nl: List<&2, $ND>, +i: Nat, +x: $ND, +b: Bool) -> {SC.length($ND, ST.pk(List<&2, $ND>, b, SC.update($ND, nl, i, x), nl)) == SC.length($ND, nl) : Nat}:
  match b:
    case True{}:
      LL.length_update($ND, nl, i, x)
    case False{}:
      {==}

def len_wr(-K: Data, +nl: List<&2, $ND>, +id: Nat, +x: $ND) -> {SC.length($ND, PR.wr_nl(K, nl, id, x)) == SC.length($ND, nl) : Nat}:
  match id:
    case 0n:
      {==}
    case 1n+i:
      len_wr_c(K, nl, i, x, Nat.is_lt(i, SC.length($ND, nl)))


def len_ex_c(-V: Data, +pl: List<&2, $MV>, +i: Nat, +v: $MV, +b: Bool) -> {SC.length($MV, ST.pk(List<&2, $MV>, b, SC.update($MV, pl, i, v), pl)) == SC.length($MV, pl) : Nat}:
  match b:
    case True{}:
      LL.length_update($MV, pl, i, v)
    case False{}:
      {==}

def len_ex(-V: Data, +pl: List<&2, $MV>, +id: Nat, +v: $MV) -> {SC.length($MV, PR.ex_pl(V, pl, id, v)) == SC.length($MV, pl) : Nat}:
  match id:
    case 0n:
      {==}
    case 1n+i:
      len_ex_c(V, pl, i, v, Nat.is_lt(i, SC.length($MV, pl)))

%def WNL PR.wr_nl(K, nl, id, node)
%def EPL PR.ex_pl(V, pl, id, value)

def write_g(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +m: $SHV, +id: Nat, +node: $ND, +g_m: {MI.dg(K, V, m) == True{} : Bool}) -> {MI.dg(K, V, MI.write(~K, ~V, ~cmp, m, id, node)) == True{} : Bool}:
  match m:
    case ST.SH{$FP}:
      %Equal.sym(Nat, SC.length($ND, $WNL), SC.length($ND, nl), len_wr(K, nl, id, node)) : {Bool.and($B1, Bool.and($B2, Bool.and(Nat.is_le(_, SC.pow2(d)), Nat.is_eq(SC.length($MV, pl), SC.length($ND, $WNL))))) == True{} : Bool}
      %Equal.sym(Nat, SC.length($ND, $WNL), SC.length($ND, nl), len_wr(K, nl, id, node)) : {Bool.and($B1, Bool.and($B2, Bool.and($B3, Nat.is_eq(SC.length($MV, pl), _)))) == True{} : Bool}
      g_m

def write_s(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +m: $SHV, +id: Nat, +node: $ND, +g_m: {MI.dg(K, V, m) == True{} : Bool}) -> {M.write(~K, ~V, ~cmp, ST.real(~K, ~V, ~cmp, m), id, node) == ST.real(~K, ~V, ~cmp, MI.write(~K, ~V, ~cmp, m, id, node)) : $TMT}:
  match m:
    case ST.SH{$FP}:
      PR.write_c(~K, ~V, ~cmp, $F, $DGS(g_m), id, node)

def exchange_g(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +m: $SHV, +id: Nat, +value: $MV, +g_m: {MI.dg(K, V, m) == True{} : Bool}) -> {MI.dgp(K, V, $MV, MI.exchange(~K, ~V, ~cmp, m, id, value)) == True{} : Bool}:
  match m:
    case ST.SH{$FP}:
      %Equal.sym(Nat, SC.length($MV, $EPL), SC.length($MV, pl), len_ex(V, pl, id, value)) : {Bool.and($B1, Bool.and($B2, Bool.and($B3, Nat.is_eq(_, SC.length($ND, nl))))) == True{} : Bool}
      g_m

def exchange_s(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +m: $SHV, +id: Nat, +value: $MV, +g_m: {MI.dg(K, V, m) == True{} : Bool}) -> {M.exchange(~K, ~V, ~cmp, ST.real(~K, ~V, ~cmp, m), id, value) == MI.rp(~K, ~V, ~cmp, $MV, MI.exchange(~K, ~V, ~cmp, m, id, value)) : $TMT & $MV}:
  match m:
    case ST.SH{$FP}:
      PR.exchange_c(~K, ~V, ~cmp, $F, $DGS(g_m), id, value)

def clear_g(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +m: $SHV, +g_m: {MI.dg(K, V, m) == True{} : Bool}) -> {MI.dg(K, V, MI.clear(~K, ~V, ~cmp, m)) == True{} : Bool}:
  match m:
    case ST.SH{$FP}:
      L.and_intro($B1, Bool.and($B2, Bool.and(Nat.is_le(0n, SC.pow2(d)), True{})), $HL(g_m), L.and_intro($B2, Bool.and(Nat.is_le(0n, SC.pow2(d)), True{}), $HD(g_m), L.and_intro(Nat.is_le(0n, SC.pow2(d)), True{}, N.zero_le(SC.pow2(d)), {==})))

def clear_s(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +m: $SHV, +g_m: {MI.dg(K, V, m) == True{} : Bool}) -> {M.clear(~K, ~V, ~cmp, ST.real(~K, ~V, ~cmp, m)) == ST.real(~K, ~V, ~cmp, MI.clear(~K, ~V, ~cmp, m)) : $TMT}:
  match m:
    case ST.SH{$FP}:
      %Equal.sym(M.NodeStore<K>, M.ns_clear(~K, ST.nodes(~K, l, d, nl)), ST.nodes(~K, l, d, Nil{}), NSL.ns_clear_ok(~K, l, d, nl, $HL(g_m), $HD(g_m), $HC(g_m))) : {M.TM{0n, 0n, 0n, 0n, 0n, _, D.clear_at(~$MV, ST.pays(~V, l, d, pl))} == ST.real(~K, ~V, ~cmp, ST.SH{0n, 0n, 0n, 0n, 0n, l, d, Nil{}, Nil{}, t, fl}) : $TMT}
      %Equal.sym(D.DynArray<&2, $MV>, D.clear_at(~$MV, ST.pays(~V, l, d, pl)), DAS.real($MV, DAS.Sh{l, d, 0n, MK.mk($MV, d, Nil{})}), AB.blk_clear(~$MV, l, d, pl, $HL(g_m), $HD(g_m), L.subst(Nat, z => {Nat.is_le(z, SC.pow2(d)) == True{} : Bool}, SC.length($ND, nl), SC.length($MV, pl), Equal.sym(Nat, SC.length($MV, pl), SC.length($ND, nl), N.eq_from_is_eq(SC.length($MV, pl), SC.length($ND, nl), $HP(g_m))), $HC(g_m)))) : {M.TM{0n, 0n, 0n, 0n, 0n, ST.nodes(~K, l, d, Nil{}), _} == ST.real(~K, ~V, ~cmp, ST.SH{0n, 0n, 0n, 0n, 0n, l, d, Nil{}, Nil{}, t, fl}) : $TMT}
      {==}

# ---- append ----

%def FT +n: Nat, +root: Nat, +lo: Nat, +hi: Nat, +free: Nat, +l: Nat, +d: Nat, +nl: List<&2, $ND>, +pl: List<&2, $MV>, +t: ST.Tr, +fl: List<&2, Nat>
%def NN M.N{True{}, 0n, 0n, p, k}
%def PT +hl: {$B1 == True{} : Bool}, +hd: {$B2 == True{} : Bool}, +hc: {$B3 == True{} : Bool}, +hp: {$B4 == True{} : Bool}
%def PA hl, hd, hc, hp
%def APP(room, grow) MI.app_room(~K, ~V, n, root, lo, hi, free, l, d, nl, pl, t, fl, k, v, p, room, grow)

def lt_pl(~K: Data, ~V: Data, +nl: List<&2, $ND>, +pl: List<&2, $MV>, +x: Nat, +b: Bool, +hp: {$B4 == True{} : Bool}, +h: {Nat.is_lt(SC.length($ND, nl), x) == b : Bool}) -> {Nat.is_lt(SC.length($MV, pl), x) == b : Bool}:
  L.subst(Nat, z => {Nat.is_lt(z, x) == b : Bool}, SC.length($ND, nl), SC.length($MV, pl), Equal.sym(Nat, SC.length($MV, pl), SC.length($ND, nl), N.eq_from_is_eq(SC.length($MV, pl), SC.length($ND, nl), hp)), h)

def le_pl(~K: Data, ~V: Data, +nl: List<&2, $ND>, +pl: List<&2, $MV>, +x: Nat, +hp: {$B4 == True{} : Bool}, +h: {Nat.is_le(SC.length($ND, nl), x) == True{} : Bool}) -> {Nat.is_le(SC.length($MV, pl), x) == True{} : Bool}:
  L.subst(Nat, z => {Nat.is_le(z, x) == True{} : Bool}, SC.length($ND, nl), SC.length($MV, pl), Equal.sym(Nat, SC.length($MV, pl), SC.length($ND, nl), N.eq_from_is_eq(SC.length($MV, pl), SC.length($ND, nl), hp)), h)

def app_g(~K: Data, ~V: Data, $FT, +k: K, +v: V, +p: Nat, $PT, +room: Bool, +hr: {Nat.is_lt(SC.length($ND, nl), SC.pow2(d)) == room : Bool}, +grow: Bool, +hgr: {Nat.is_lt(d, l) == grow : Bool}) -> {MI.dgp(K, V, Result<&2, &2, M.Rejected<K, V>, Nat>, $APP(room, grow)) == True{} : Bool}:
  match room grow:
    case True{} _:
      %Equal.sym(Nat, SC.length($ND, SC.snoc($ND, nl, $NN)), 1n+SC.length($ND, nl), LL.length_snoc($ND, nl, $NN)) : {Bool.and($B1, Bool.and($B2, Bool.and(Nat.is_le(_, SC.pow2(d)), Nat.is_eq(SC.length($MV, SC.snoc($MV, pl, Some{v})), SC.length($ND, SC.snoc($ND, nl, $NN)))))) == True{} : Bool}
      %Equal.sym(Nat, SC.length($ND, SC.snoc($ND, nl, $NN)), 1n+SC.length($ND, nl), LL.length_snoc($ND, nl, $NN)) : {Bool.and($B1, Bool.and($B2, Bool.and(Nat.is_le(1n+SC.length($ND, nl), SC.pow2(d)), Nat.is_eq(SC.length($MV, SC.snoc($MV, pl, Some{v})), _)))) == True{} : Bool}
      %Equal.sym(Nat, SC.length($MV, SC.snoc($MV, pl, Some{v})), 1n+SC.length($MV, pl), LL.length_snoc($MV, pl, Some{v})) : {Bool.and($B1, Bool.and($B2, Bool.and(Nat.is_le(1n+SC.length($ND, nl), SC.pow2(d)), Nat.is_eq(_, 1n+SC.length($ND, nl))))) == True{} : Bool}
      L.and_intro($B1, Bool.and($B2, Bool.and(Nat.is_le(1n+SC.length($ND, nl), SC.pow2(d)), $B4)), hl, L.and_intro($B2, Bool.and(Nat.is_le(1n+SC.length($ND, nl), SC.pow2(d)), $B4), hd, L.and_intro(Nat.is_le(1n+SC.length($ND, nl), SC.pow2(d)), $B4, N.lt_succ_le_succ(SC.length($ND, nl), SC.pow2(d), hr), hp)))
    case False{} True{}:
      %Equal.sym(Nat, SC.length($ND, SC.snoc($ND, nl, $NN)), 1n+SC.length($ND, nl), LL.length_snoc($ND, nl, $NN)) : {Bool.and($B1, Bool.and(Nat.is_le(1n+d, l), Bool.and(Nat.is_le(_, SC.pow2(1n+d)), Nat.is_eq(SC.length($MV, SC.snoc($MV, pl, Some{v})), SC.length($ND, SC.snoc($ND, nl, $NN)))))) == True{} : Bool}
      %Equal.sym(Nat, SC.length($ND, SC.snoc($ND, nl, $NN)), 1n+SC.length($ND, nl), LL.length_snoc($ND, nl, $NN)) : {Bool.and($B1, Bool.and(Nat.is_le(1n+d, l), Bool.and(Nat.is_le(1n+SC.length($ND, nl), SC.pow2(1n+d)), Nat.is_eq(SC.length($MV, SC.snoc($MV, pl, Some{v})), _)))) == True{} : Bool}
      %Equal.sym(Nat, SC.length($MV, SC.snoc($MV, pl, Some{v})), 1n+SC.length($MV, pl), LL.length_snoc($MV, pl, Some{v})) : {Bool.and($B1, Bool.and(Nat.is_le(1n+d, l), Bool.and(Nat.is_le(1n+SC.length($ND, nl), SC.pow2(1n+d)), Nat.is_eq(_, 1n+SC.length($ND, nl))))) == True{} : Bool}
      +h3 = N.lt_succ_le_succ(SC.length($ND, nl), SC.pow2(1n+d), N.le_lt_trans(SC.length($ND, nl), SC.pow2(d), SC.pow2(1n+d), hc, N.pow2_lt_succ(d)))
      L.and_intro($B1, Bool.and(Nat.is_le(1n+d, l), Bool.and(Nat.is_le(1n+SC.length($ND, nl), SC.pow2(1n+d)), $B4)), hl, L.and_intro(Nat.is_le(1n+d, l), Bool.and(Nat.is_le(1n+SC.length($ND, nl), SC.pow2(1n+d)), $B4), N.lt_succ_le_succ(d, l, hgr), L.and_intro(Nat.is_le(1n+SC.length($ND, nl), SC.pow2(1n+d)), $B4, h3, hp)))
    case False{} False{}:
      L.and_intro($B1, Bool.and($B2, Bool.and($B3, $B4)), hl, L.and_intro($B2, Bool.and($B3, $B4), hd, L.and_intro($B3, $B4, hc, hp)))

%def AR0 ST.real(~K, ~V, ~cmp, $SH0)
%def NS ST.nodes(~K, l, d, nl)
%def PS ST.pays(~V, l, d, pl)
%def RJ Result<&2, &2, M.Rejected<K, V>, Nat>
%def DRU(T) D.DynArray<&2, T> & Result<&2, &2, DE.Error, Unit>
%def NRU M.NodeStore<K> & Result<&2, &2, DE.Error, Unit>

def app_s(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, $FT, +k: K, +v: V, +p: Nat, $PT, +room: Bool, +hr: {Nat.is_lt(SC.length($ND, nl), SC.pow2(d)) == room : Bool}, +grow: Bool, +hgr: {Nat.is_lt(d, l) == grow : Bool}) -> {M.append_nodes(~K, ~V, ~cmp, n, root, lo, hi, free, $PS, k, v, 1n+SC.length($ND, nl), M.ns_push(~K, $NS, $NN)) == MI.rp(~K, ~V, ~cmp, $RJ, $APP(room, grow)) : $TMT & $RJ}:
  match room grow:
    case True{} _:
      %Equal.sym($NRU, M.ns_push(~K, $NS, $NN), (ST.nodes(~K, l, d, SC.snoc($ND, nl, $NN)), Done{Unit{}}), NSL.ns_push_room(~K, l, d, nl, hl, hd, hc, $NN, hr)) : {M.append_nodes(~K, ~V, ~cmp, n, root, lo, hi, free, $PS, k, v, 1n+SC.length($ND, nl), _) == MI.rp(~K, ~V, ~cmp, $RJ, $APP(True{}, grow)) : $TMT & $RJ}
      %Equal.sym($DRU($MV), D.push_at(~$MV, $PS, Some{v}), (ST.pays(~V, l, d, SC.snoc($MV, pl, Some{v})), Done{Unit{}}), AB.blk_push_room(~$MV, l, d, pl, hl, hd, le_pl(~K, ~V, nl, pl, SC.pow2(d), hp, hc), Some{v}, lt_pl(~K, ~V, nl, pl, SC.pow2(d), True{}, hp, hr))) : {M.append_values(~K, ~V, ~cmp, n, root, lo, hi, free, ST.nodes(~K, l, d, SC.snoc($ND, nl, $NN)), k, v, 1n+SC.length($ND, nl), _) == MI.rp(~K, ~V, ~cmp, $RJ, $APP(True{}, grow)) : $TMT & $RJ}
      {==}
    case False{} True{}:
      %Equal.sym($NRU, M.ns_push(~K, $NS, $NN), (ST.nodes(~K, l, 1n+d, SC.snoc($ND, nl, $NN)), Done{Unit{}}), NSL.ns_push_grow(~K, l, d, nl, hl, hd, hc, $NN, hr, hgr)) : {M.append_nodes(~K, ~V, ~cmp, n, root, lo, hi, free, $PS, k, v, 1n+SC.length($ND, nl), _) == MI.rp(~K, ~V, ~cmp, $RJ, $APP(False{}, True{})) : $TMT & $RJ}
      %Equal.sym($DRU($MV), D.push_at(~$MV, $PS, Some{v}), (ST.pays(~V, l, 1n+d, SC.snoc($MV, pl, Some{v})), Done{Unit{}}), AB.blk_push_grow(~$MV, l, d, pl, hl, hd, le_pl(~K, ~V, nl, pl, SC.pow2(d), hp, hc), Some{v}, lt_pl(~K, ~V, nl, pl, SC.pow2(d), False{}, hp, hr), hgr)) : {M.append_values(~K, ~V, ~cmp, n, root, lo, hi, free, ST.nodes(~K, l, 1n+d, SC.snoc($ND, nl, $NN)), k, v, 1n+SC.length($ND, nl), _) == MI.rp(~K, ~V, ~cmp, $RJ, $APP(False{}, True{})) : $TMT & $RJ}
      {==}
    case False{} False{}:
      %Equal.sym($NRU, M.ns_push(~K, $NS, $NN), ($NS, Fail{DE.CapacityExceeded{}}), NSL.ns_push_full(~K, l, d, nl, hl, hd, hc, $NN, hr, hgr)) : {M.append_nodes(~K, ~V, ~cmp, n, root, lo, hi, free, $PS, k, v, 1n+SC.length($ND, nl), _) == MI.rp(~K, ~V, ~cmp, $RJ, $APP(False{}, False{})) : $TMT & $RJ}
      {==}

def append_g(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +m: $SHV, +k: K, +v: V, +p: Nat, +g_m: {MI.dg(K, V, m) == True{} : Bool}) -> {MI.dgp(K, V, $RJ, MI.append(~K, ~V, ~cmp, m, k, v, p)) == True{} : Bool}:
  match m:
    case ST.SH{$FP}:
      app_g(~K, ~V, $F, k, v, p, $DGS(g_m), Nat.is_lt(SC.length($ND, nl), SC.pow2(d)), {==}, Nat.is_lt(d, l), {==})

def append_s(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +m: $SHV, +k: K, +v: V, +p: Nat, +g_m: {MI.dg(K, V, m) == True{} : Bool}) -> {M.append(~K, ~V, ~cmp, ST.real(~K, ~V, ~cmp, m), k, v, p) == MI.rp(~K, ~V, ~cmp, $RJ, MI.append(~K, ~V, ~cmp, m, k, v, p)) : $TMT & $RJ}:
  match m:
    case ST.SH{$FP}:
      app_s(~K, ~V, ~cmp, $F, k, v, p, $DGS(g_m), Nat.is_lt(SC.length($ND, nl), SC.pow2(d)), {==}, Nat.is_lt(d, l), {==})


# ---- field writes: the mirror keeps the layout ----

def set_left_node_g(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +m: ST.Sh<K, V>, +id: Nat, +v: Nat, +node: M.Node<K>, +g_m: {MI.dg(K, V, m) == True{} : Bool}) -> {MI.dg(K, V, MI.set_left_node(~K, ~V, ~cmp, m, id, v, node)) == True{} : Bool}:
  match node:
    case M.Free{+px2}:
      g_m
    case M.N{+px3, +px4, +px5, +px6, +px7}:
      write_g(~K, ~V, ~cmp, m, id, M.N{px3, v, px5, px6, px7}, g_m)

def set_left_1_g(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +id: Nat, +v: Nat, pair_result: ST.Sh<K, V> & M.Node<K>, +g_pair_result: {MI.dgp(K, V, M.Node<K>, pair_result) == True{} : Bool}) -> {MI.dg(K, V, MI.set_left_1(~K, ~V, ~cmp, id, v, pair_result)) == True{} : Bool}:
  match pair_result:
    case Tuple{+m1, +node}:
      set_left_node_g(~K, ~V, ~cmp, m1, id, v, node, g_pair_result)

def set_left_g(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +m: ST.Sh<K, V>, +id: Nat, +v: Nat, +g_m: {MI.dg(K, V, m) == True{} : Bool}) -> {MI.dg(K, V, MI.set_left(~K, ~V, ~cmp, m, id, v)) == True{} : Bool}:
  set_left_1_g(~K, ~V, ~cmp, id, v, MI.read(~K, ~V, ~cmp, m, id), read_g(~K, ~V, ~cmp, m, id, g_m))

def set_right_node_g(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +m: ST.Sh<K, V>, +id: Nat, +v: Nat, +node: M.Node<K>, +g_m: {MI.dg(K, V, m) == True{} : Bool}) -> {MI.dg(K, V, MI.set_right_node(~K, ~V, ~cmp, m, id, v, node)) == True{} : Bool}:
  match node:
    case M.Free{+px2}:
      g_m
    case M.N{+px3, +px4, +px5, +px6, +px7}:
      write_g(~K, ~V, ~cmp, m, id, M.N{px3, px4, v, px6, px7}, g_m)

def set_right_1_g(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +id: Nat, +v: Nat, pair_result: ST.Sh<K, V> & M.Node<K>, +g_pair_result: {MI.dgp(K, V, M.Node<K>, pair_result) == True{} : Bool}) -> {MI.dg(K, V, MI.set_right_1(~K, ~V, ~cmp, id, v, pair_result)) == True{} : Bool}:
