def set_parent_sc(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, $FT, $PT, +i: Nat, +v: Nat, +y: $ND, +hy: {ST.nth_or($ND, nl, i, M.Free{0n}) == y : $ND}) -> {M.TM{n, root, lo, hi, free, M.ns_set_parent(~K, ST.nodes(~K, l, d, nl), i, v), ST.pays(~V, l, d, pl)} == ST.real(~K, ~V, ~cmp, MI.set_parent_node(~K, ~V, ~cmp, $SH0, 1n+i, v, y)) : $TMT}:
