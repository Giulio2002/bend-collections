# ---- field writes: one array written is the node written ----

def set_left_sc(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, $FT, $PT, +i: Nat, +v: Nat, +y: $ND, +hy: {ST.nth_or($ND, nl, i, M.Free{0n}) == y : $ND}) -> {M.TM{n, root, lo, hi, free, M.ns_set_left(~K, ST.nodes(~K, l, d, nl), i, v), ST.pays(~V, l, d, pl)} == ST.real(~K, ~V, ~cmp, MI.set_left_node(~K, ~V, ~cmp, $SH0, 1n+i, v, y)) : $TMT}:
  match y:
    case M.Free{+z}:
      %Equal.sym(M.NodeStore<K>, M.ns_set_left(~K, ST.nodes(~K, l, d, nl), i, v), ST.nodes(~K, l, d, nl), NSL.left_set_free(~K, l, d, nl, hl, hd, hc, i, v, z, hy)) : {M.TM{n, root, lo, hi, free, _, ST.pays(~V, l, d, pl)} == ST.real(~K, ~V, ~cmp, MI.set_left_node(~K, ~V, ~cmp, $SH0, 1n+i, v, M.Free{z})) : $TMT}
      {==}
    case M.N{+c, +lf, +rt, +q, +k}:
      +hlt = NSL.nth_or_lt(~K, nl, i, M.N{c, lf, rt, q, k}, {==}, hy)
      %Equal.sym(M.NodeStore<K>, M.ns_set_left(~K, ST.nodes(~K, l, d, nl), i, v), ST.nodes(~K, l, d, SC.update($ND, nl, i, M.N{c, v, rt, q, k})), NSL.left_set_node(~K, l, d, nl, hl, hd, hc, i, v, c, lf, rt, q, k, hy)) : {M.TM{n, root, lo, hi, free, _, ST.pays(~V, l, d, pl)} == ST.real(~K, ~V, ~cmp, MI.set_left_node(~K, ~V, ~cmp, $SH0, 1n+i, v, M.N{c, lf, rt, q, k})) : $TMT}
      %Equal.sym(Bool, Nat.is_lt(i, SC.length($ND, nl)), True{}, hlt) : {M.TM{n, root, lo, hi, free, ST.nodes(~K, l, d, SC.update($ND, nl, i, M.N{c, v, rt, q, k})), ST.pays(~V, l, d, pl)} == ST.real(~K, ~V, ~cmp, ST.SH{n, root, lo, hi, free, l, d, ST.pk(List<&2, $ND>, _, SC.update($ND, nl, i, M.N{c, v, rt, q, k}), nl), pl, t, fl}) : $TMT}
      {==}

def set_left_s(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +m: $SHV, +id: Nat, +v: Nat, +g_m: {MI.dg(K, V, m) == True{} : Bool}) -> {M.set_left(~K, ~V, ~cmp, ST.real(~K, ~V, ~cmp, m), id, v) == ST.real(~K, ~V, ~cmp, MI.set_left(~K, ~V, ~cmp, m, id, v)) : $TMT}:
  match m id:
    case ST.SH{$FP} 0n:
      {==}
    case ST.SH{$FP} 1n+ +i:
      set_left_sc(~K, ~V, ~cmp, $F, $DGS(g_m), i, v, ST.nth_or($ND, nl, i, M.Free{0n}), {==})

def set_right_sc(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, $FT, $PT, +i: Nat, +v: Nat, +y: $ND, +hy: {ST.nth_or($ND, nl, i, M.Free{0n}) == y : $ND}) -> {M.TM{n, root, lo, hi, free, M.ns_set_right(~K, ST.nodes(~K, l, d, nl), i, v), ST.pays(~V, l, d, pl)} == ST.real(~K, ~V, ~cmp, MI.set_right_node(~K, ~V, ~cmp, $SH0, 1n+i, v, y)) : $TMT}:
  match y:
    case M.Free{+z}:
      %Equal.sym(M.NodeStore<K>, M.ns_set_right(~K, ST.nodes(~K, l, d, nl), i, v), ST.nodes(~K, l, d, nl), NSL.right_set_free(~K, l, d, nl, hl, hd, hc, i, v, z, hy)) : {M.TM{n, root, lo, hi, free, _, ST.pays(~V, l, d, pl)} == ST.real(~K, ~V, ~cmp, MI.set_right_node(~K, ~V, ~cmp, $SH0, 1n+i, v, M.Free{z})) : $TMT}
      {==}
    case M.N{+c, +lf, +rt, +q, +k}:
      +hlt = NSL.nth_or_lt(~K, nl, i, M.N{c, lf, rt, q, k}, {==}, hy)
      %Equal.sym(M.NodeStore<K>, M.ns_set_right(~K, ST.nodes(~K, l, d, nl), i, v), ST.nodes(~K, l, d, SC.update($ND, nl, i, M.N{c, lf, v, q, k})), NSL.right_set_node(~K, l, d, nl, hl, hd, hc, i, v, c, lf, rt, q, k, hy)) : {M.TM{n, root, lo, hi, free, _, ST.pays(~V, l, d, pl)} == ST.real(~K, ~V, ~cmp, MI.set_right_node(~K, ~V, ~cmp, $SH0, 1n+i, v, M.N{c, lf, rt, q, k})) : $TMT}
      %Equal.sym(Bool, Nat.is_lt(i, SC.length($ND, nl)), True{}, hlt) : {M.TM{n, root, lo, hi, free, ST.nodes(~K, l, d, SC.update($ND, nl, i, M.N{c, lf, v, q, k})), ST.pays(~V, l, d, pl)} == ST.real(~K, ~V, ~cmp, ST.SH{n, root, lo, hi, free, l, d, ST.pk(List<&2, $ND>, _, SC.update($ND, nl, i, M.N{c, lf, v, q, k}), nl), pl, t, fl}) : $TMT}
      {==}

def set_right_s(~K: Data, ~V: Data, ~cmp: K -> K -> Cmp, +m: $SHV, +id: Nat, +v: Nat, +g_m: {MI.dg(K, V, m) == True{} : Bool}) -> {M.set_right(~K, ~V, ~cmp, ST.real(~K, ~V, ~cmp, m), id, v) == ST.real(~K, ~V, ~cmp, MI.set_right(~K, ~V, ~cmp, m, id, v)) : $TMT}:
  match m id:
