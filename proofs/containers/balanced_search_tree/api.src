# ---- clear ----

%def ESH(l, d) ST.SH{0n, 0n, 0n, 0n, 0n, l, d, Nil{}, Nil{}, ST.TE{}, Nil{}}
%def CLT(s) Sigma<&1, &1, $SHT, s2_ => {M.clear($AK, $RL(s)) == $RL(s2_) : $TMT} & ({S.clear(K, V, $MD(s)) == $MD(s2_) : S.Model<K, V>} & $GD(s2_))>
%def CLA {ST.real($AK, MI.clear($AK, $SH)) == ST.real($AK, $ESH(l, d)) : $TMT}
%def CLB {S.clear(K, V, ST.model($AK, $SH)) == ST.model($AK, $ESH(l, d)) : S.Model<K, V>} & $GD($ESH(l, d))

def clear_ok($TK, +sh: $SHT, +hg: $GD(sh)) -> $CLT(sh):
  match sh:
    case ST.SH{$FP}:
      ($ESH(l, d), (Equal.trans($TMT, M.clear($AK, $RL($SH)), ST.real($AK, MI.clear($AK, $SH)), $RL($ESH(l, d)), SM.clear_s($AK, $SH, OK.dg_good($AK, $SH, hg)), Pair.fst($CLA, $CLB, LF.clear_ok($AK, $F, hg))), Pair.snd($CLA, $CLB, LF.clear_ok($AK, $F, hg))))
