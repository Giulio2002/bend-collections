# Facts for pop: after emptying the bucket i that holds key, the other keys
# look up as before, key is held nowhere, the model's keys have no repeats,
# and the vacated slot is free.

%def TT == True{} : Bool}
%def FF == False{} : Bool}
%def V0 IM.bupd(O, i, B.BE{})
%def SV UD.v(H.slot(B.lnk(B.at(O, i))))
%def RP +O: List<&2, B.Bk>, +n: Nat, +i: Nat, +hi: {Nat.is_lt(i, n) $TT, +hlen: {Nat.is_lt(i, SC.length(B.Bk, O)) $TT
%def RA O, n, i, hi, hlen

# ---- the emptied bucket, for a property true of every empty bucket ----

def at_v0(+O: List<&2, B.Bk>, +i: Nat, +hlen: {Nat.is_lt(i, SC.length(B.Bk, O)) $TT, +j: Nat, +c: Bool, +hc: {Nat.is_eq(i, j) == c : Bool}) -> {B.at($V0, j) == Bool.pick(B.Bk, c, B.BE{}, B.at(O, j)) : B.Bk}:
  match c:
    case True{}:
      IM.at_bu_eq(O, i, B.BE{}, hlen, j, hc)
    case False{}:
      IM.at_bupd_other(O, i, B.BE{}, j, hc)

def well_rm_i($RP, +sd: Nat, +hw: {B.all_lt(B.PWell{O, sd}, n) $TT, +j: Nat, +hj: {Nat.is_lt(j, n) $TT, +c: Bool, +hc: {Nat.is_eq(i, j) == c : Bool}) -> {B.wb(sd, B.at($V0, j)) $TT:
  match c:
    case True{}:
      L.subst(B.Bk, y => {B.wb(sd, y) $TT, B.BE{}, B.at($V0, j), Equal.sym(B.Bk, B.at($V0, j), B.BE{}, IM.at_bu_eq(O, i, B.BE{}, hlen, j, hc)), {==})
    case False{}:
      L.subst(B.Bk, y => {B.wb(sd, y) $TT, B.at(O, j), B.at($V0, j), Equal.sym(B.Bk, B.at($V0, j), B.at(O, j), IM.at_bupd_other(O, i, B.BE{}, j, hc)), B.all_inst(B.PWell{O, sd}, n, hw, j, hj))

def well_rm($RP, +sd: Nat, +hw: {B.all_lt(B.PWell{O, sd}, n) $TT, +m: Nat, +hm: {Nat.is_le(m, n) $TT) -> {B.all_lt(B.PWell{$V0, sd}, m) $TT:
  match m:
    case 0n:
      {==}
    case 1n+q:
      +hq = N.succ_le_lt(q, n, hm)
      L.and_intro(B.wb(sd, B.at($V0, q)), B.all_lt(B.PWell{$V0, sd}, q), well_rm_i($RA, sd, hw, q, hq, Nat.is_eq(i, q), {==}), well_rm($RA, sd, hw, q, N.lt_le(q, n, hq)))

def wl_at(+obs: List<&2, B.Bk>, +sd: Nat, +j: Nat, +hw: {B.all_lt(B.PWell{obs, sd}, j) $TT, +b: B.Bk, e: RH.EqAt(obs, j, b)) -> {B.wb(sd, b) $TT:
  match e:
    case Tuple{+x, Tuple{+hx, +hb}}:
      L.subst(B.Bk, y => {B.wb(sd, y) $TT, B.at(obs, x), b, hb, B.all_inst(B.PWell{obs, sd}, j, hw, x, hx))

def wb_empty(+sd: Nat, +b: B.Bk, +h: {B.occ(b) $FF) -> {B.wb(sd, b) $TT:
  match b:
    case B.BE{}:
      {==}
    case B.BF{w, l, k}:
      Empty.absurd({B.wb(sd, B.BF{w, l, k}) $TT, L.true_false(h))

def wlf_c(+nbs: List<&2, B.Bk>, +obs: List<&2, B.Bk>, +j: Nat, +n2: Nat, +hf: {B.all_lt(B.PFrom{nbs, obs, j}, n2) $TT, +sd: Nat, +hw: {B.all_lt(B.PWell{obs, sd}, j) $TT, +x: Nat, +hx: {Nat.is_lt(x, n2) $TT, +c: Bool, +hc: {B.occ(B.at(nbs, x)) == c : Bool}) -> {B.wb(sd, B.at(nbs, x)) $TT:
  match c:
    case False{}:
      wb_empty(sd, B.at(nbs, x), hc)
    case True{}:
      wl_at(obs, sd, j, hw, B.at(nbs, x), RH.from_at(nbs, obs, j, n2, hf, x, hx, hc))

# THEOREM: copies of well-formed buckets are well formed
def well_from(+nbs: List<&2, B.Bk>, +obs: List<&2, B.Bk>, +j: Nat, +n2: Nat, +hf: {B.all_lt(B.PFrom{nbs, obs, j}, n2) $TT, +sd: Nat, +hw: {B.all_lt(B.PWell{obs, sd}, j) $TT, +m: Nat, +hm: {Nat.is_le(m, n2) $TT) -> {B.all_lt(B.PWell{nbs, sd}, m) $TT:
  match m:
    case 0n:
      {==}
    case 1n+q:
      +hq = N.succ_le_lt(q, n2, hm)
      L.and_intro(B.wb(sd, B.at(nbs, q)), B.all_lt(B.PWell{nbs, sd}, q), wlf_c(nbs, obs, j, n2, hf, sd, hw, q, hq, B.occ(B.at(nbs, q)), {==}), well_from(nbs, obs, j, n2, hf, sd, hw, q, N.lt_le(q, n2, hq)))

# ---- slots ----

def nsb_i($RP, +t: Nat, +h: {ST.noslot(O, t, n) $TT, +j: Nat, +hj: {Nat.is_lt(j, n) $TT, +c: Bool, +hc: {Nat.is_eq(i, j) == c : Bool}) -> {Bool.not(Bool.and(B.occ(B.at($V0, j)), Nat.is_eq(UD.v(H.slot(B.lnk(B.at($V0, j)))), t))) $TT:
  match c:
    case True{}:
      L.subst(B.Bk, y => {Bool.not(Bool.and(B.occ(y), Nat.is_eq(UD.v(H.slot(B.lnk(y))), t))) $TT, B.BE{}, B.at($V0, j), Equal.sym(B.Bk, B.at($V0, j), B.BE{}, IM.at_bu_eq(O, i, B.BE{}, hlen, j, hc)), {==})
    case False{}:
      L.subst(B.Bk, y => {Bool.not(Bool.and(B.occ(y), Nat.is_eq(UD.v(H.slot(B.lnk(y))), t))) $TT, B.at(O, j), B.at($V0, j), Equal.sym(B.Bk, B.at($V0, j), B.at(O, j), IM.at_bupd_other(O, i, B.BE{}, j, hc)), IM.noslot_inst(O, t, n, h, j, hj))

# THEOREM: emptying a bucket frees no slot another bucket was using
def ns_be($RP, +t: Nat, +h: {ST.noslot(O, t, n) $TT, +m: Nat, +hm: {Nat.is_le(m, n) $TT) -> {ST.noslot($V0, t, m) $TT:
  match m:
    case 0n:
      {==}
    case 1n+q:
      +hq = N.succ_le_lt(q, n, hm)
      L.and_intro(Bool.not(Bool.and(B.occ(B.at($V0, q)), Nat.is_eq(UD.v(H.slot(B.lnk(B.at($V0, q)))), t))), ST.noslot($V0, t, q), nsb_i($RA, t, h, q, hq, Nat.is_eq(i, q), {==}), ns_be($RA, t, h, q, N.lt_le(q, n, hq)))

%def HP +huq: {B.all_lt(B.PUniq{O}, n) $TT, +key: String, +hk: {B.hold(key, B.at(O, i)) $TT
%def HPA huq, key, hk
%def VS2 SC.update(Maybe<&2, V>, vsl, $SV, mm)

def pno_be_i($RP, +q: String, +hno: {B.all_lt(B.PNo{O, q}, n) $TT, +j: Nat, +hj: {Nat.is_lt(j, n) $TT, +c: Bool, +hc: {Nat.is_eq(i, j) == c : Bool}) -> {Bool.not(B.hold(q, B.at($V0, j))) $TT:
  match c:
    case True{}:
      L.subst(B.Bk, y => {Bool.not(B.hold(q, y)) $TT, B.BE{}, B.at($V0, j), Equal.sym(B.Bk, B.at($V0, j), B.BE{}, IM.at_bu_eq(O, i, B.BE{}, hlen, j, hc)), {==})
    case False{}:
      L.subst(B.Bk, y => {Bool.not(B.hold(q, y)) $TT, B.at(O, j), B.at($V0, j), Equal.sym(B.Bk, B.at($V0, j), B.at(O, j), IM.at_bupd_other(O, i, B.BE{}, j, hc)), B.all_inst(B.PNo{O, q}, n, hno, j, hj))

def pno_be($RP, +q: String, +hno: {B.all_lt(B.PNo{O, q}, n) $TT, +m: Nat, +hm: {Nat.is_le(m, n) $TT) -> {B.all_lt(B.PNo{$V0, q}, m) $TT:
  match m:
    case 0n:
      {==}
    case 1n+p:
      +hp = N.succ_le_lt(p, n, hm)
      L.and_intro(Bool.not(B.hold(q, B.at($V0, p))), B.all_lt(B.PNo{$V0, q}, p), pno_be_i($RA, q, hno, p, hp, Nat.is_eq(i, p), {==}), pno_be($RA, q, hno, p, N.lt_le(p, n, hp)))

def hold_eqk(+b: B.Bk, +key: String, +q: String, +hq: {S.str_eq(key, q) $TT) -> {B.hold(key, b) == B.hold(q, b) : Bool}:
  match b:
    case B.BE{}:
      {==}
    case B.BF{w, l, +k}:
      SL.eq_tr2(k, key, q, hq)

def pnq_i($RP, $HP, +q: String, +hq: {S.str_eq(key, q) $TT, +j: Nat, +hj: {Nat.is_lt(j, n) $TT, +c: Bool, +hc: {Nat.is_eq(i, j) == c : Bool}) -> {Bool.not(B.hold(q, B.at($V0, j))) $TT:
  match c:
    case True{}:
      L.subst(B.Bk, y => {Bool.not(B.hold(q, y)) $TT, B.BE{}, B.at($V0, j), Equal.sym(B.Bk, B.at($V0, j), B.BE{}, IM.at_bu_eq(O, i, B.BE{}, hlen, j, hc)), {==})
    case False{}:
      +o = LK.other(O, n, key, huq, i, hi, hk, j, hj, N.is_eq_sym_false(i, j, hc))
      L.subst(B.Bk, y => {Bool.not(B.hold(q, y)) $TT, B.at(O, j), B.at($V0, j), Equal.sym(B.Bk, B.at($V0, j), B.at(O, j), IM.at_bupd_other(O, i, B.BE{}, j, hc)), L.subst(Bool, x => {Bool.not(x) $TT, B.hold(key, B.at(O, j)), B.hold(q, B.at(O, j)), hold_eqk(B.at(O, j), key, q, hq), o))

# THEOREM: once its bucket is emptied, the removed key is held nowhere
def pno_rmq($RP, $HP, +q: String, +hq: {S.str_eq(key, q) $TT, +m: Nat, +hm: {Nat.is_le(m, n) $TT) -> {B.all_lt(B.PNo{$V0, q}, m) $TT:
  match m:
    case 0n:
      {==}
    case 1n+p:
      +hp = N.succ_le_lt(p, n, hm)
      L.and_intro(Bool.not(B.hold(q, B.at($V0, p))), B.all_lt(B.PNo{$V0, q}, p), pnq_i($RA, $HPA, q, hq, p, hp, Nat.is_eq(i, p), {==}), pno_rmq($RA, $HPA, q, hq, p, N.lt_le(p, n, hp)))

def lkr_h(~V: Data, $RP, $HP, +vsl: List<&2, Maybe<&2, V>>, +mm: Maybe<&2, V>, +q: String, +hq: {S.str_eq(key, q) $FF, e0: T.Holder(O, q, n)) -> {S.lookup(~V, ST.absm(~V, $V0, $VS2, n, 0n), q) == S.lookup(~V, ST.absm(~V, O, vsl, n, 0n), q) : Maybe<&2, V>}:
  match e0:
    case Tuple{+j, Tuple{+hj, +hkj}}:
      +hji = SV.neq_hold(O, key, q, i, j, hk, hq, hkj, Nat.is_eq(j, i), {==})
      +eat = IM.at_bupd_other(O, i, B.BE{}, j, N.is_eq_sym_false(j, i, hji))
      +hkj2 = L.subst(B.Bk, y => {B.hold(q, y) $TT, B.at(O, j), B.at($V0, j), Equal.sym(B.Bk, B.at($V0, j), B.at(O, j), eat), hkj)
      +sj = UD.v(H.slot(B.lnk(B.at(O, j))))
      +hne = N.is_eq_sym_false(sj, $SV, T.slot_ne(O, n, huq, i, j, hi, hj, hji, B.hold_occ(key, B.at(O, i), hk), B.hold_occ(q, B.at(O, j), hkj)))
      Equal.trans(Maybe<&2, V>, S.lookup(~V, ST.absm(~V, $V0, $VS2, n, 0n), q), ST.nthm(~V, $VS2, UD.v(H.slot(B.lnk(B.at($V0, j))))), S.lookup(~V, ST.absm(~V, O, vsl, n, 0n), q), LK.lookup_hit(~V, $V0, $VS2, q, n, DM.uq_rm(O, i, hlen, n, huq, n, N.le_refl(n)), j, hj, hkj2), Equal.trans(Maybe<&2, V>, ST.nthm(~V, $VS2, UD.v(H.slot(B.lnk(B.at($V0, j))))), ST.nthm(~V, $VS2, sj), S.lookup(~V, ST.absm(~V, O, vsl, n, 0n), q), Equal.cong(B.Bk, Maybe<&2, V>, y => ST.nthm(~V, $VS2, UD.v(H.slot(B.lnk(y)))), B.at($V0, j), B.at(O, j), eat), Equal.trans(Maybe<&2, V>, ST.nthm(~V, $VS2, sj), ST.nthm(~V, vsl, sj), S.lookup(~V, ST.absm(~V, O, vsl, n, 0n), q), T.nthm_upd_other(~V, vsl, $SV, sj, mm, hne), Equal.sym(Maybe<&2, V>, S.lookup(~V, ST.absm(~V, O, vsl, n, 0n), q), ST.nthm(~V, vsl, sj), LK.lookup_hit(~V, O, vsl, q, n, huq, j, hj, hkj)))))

def lkr_c(~V: Data, $RP, $HP, +vsl: List<&2, Maybe<&2, V>>, +mm: Maybe<&2, V>, +q: String, +hq: {S.str_eq(key, q) $FF, +d: Bool, +hd: {B.all_lt(B.PNo{O, q}, n) == d : Bool}) -> {S.lookup(~V, ST.absm(~V, $V0, $VS2, n, 0n), q) == S.lookup(~V, ST.absm(~V, O, vsl, n, 0n), q) : Maybe<&2, V>}:
  match d:
    case True{}:
      Equal.trans(Maybe<&2, V>, S.lookup(~V, ST.absm(~V, $V0, $VS2, n, 0n), q), None{}, S.lookup(~V, ST.absm(~V, O, vsl, n, 0n), q), LK.lookup_none(~V, $V0, $VS2, q, n, pno_be($RA, q, hd, n, N.le_refl(n))), Equal.sym(Maybe<&2, V>, S.lookup(~V, ST.absm(~V, O, vsl, n, 0n), q), None{}, LK.lookup_none(~V, O, vsl, q, n, hd)))
    case False{}:
      lkr_h(~V, $RA, $HPA, vsl, mm, q, hq, T.find_hold(O, q, n, hd))

# THEOREM: emptying key's bucket and its slot leaves every other key's lookup
def lk_rm(~V: Data, $RP, $HP, +vsl: List<&2, Maybe<&2, V>>, +mm: Maybe<&2, V>, +q: String, +hq: {S.str_eq(key, q) $FF) -> {S.lookup(~V, ST.absm(~V, $V0, $VS2, n, 0n), q) == S.lookup(~V, ST.absm(~V, O, vsl, n, 0n), q) : Maybe<&2, V>}:
  lkr_c(~V, $RA, $HPA, vsl, mm, q, hq, B.all_lt(B.PNo{O, q}, n), {==})

# ---- liveness with the slot vacated ----

def lvr_b(~V: Data, +vsl: List<&2, Maybe<&2, V>>, +s: Nat, +fr: Nat, +b: B.Bk, +h: {B.live_b(ST.lvs(~V, vsl), fr, b) $TT, +hne: {Bool.not(Bool.and(B.occ(b), Nat.is_eq(UD.v(H.slot(B.lnk(b))), s))) $TT) -> {B.live_b(ST.lvs(~V, SC.update(Maybe<&2, V>, vsl, s, None{})), fr, b) $TT:
  match b:
    case B.BE{}:
      {==}
    case B.BF{w, +l, k}:
      +t = UD.v(H.slot(l))
      +ne = N.is_eq_sym_false(t, s, K.not_true_eq(Nat.is_eq(t, s), hne))
      +e = Equal.trans(Bool, B.nthb(ST.lvs(~V, SC.update(Maybe<&2, V>, vsl, s, None{})), t), ST.some_b(~V, ST.nthm(~V, SC.update(Maybe<&2, V>, vsl, s, None{}), t)), B.nthb(ST.lvs(~V, vsl), t), ST.lvs_nth(~V, SC.update(Maybe<&2, V>, vsl, s, None{}), t), Equal.trans(Bool, ST.some_b(~V, ST.nthm(~V, SC.update(Maybe<&2, V>, vsl, s, None{}), t)), ST.some_b(~V, ST.nthm(~V, vsl, t)), B.nthb(ST.lvs(~V, vsl), t), Equal.cong(Maybe<&2, V>, Bool, m => ST.some_b(~V, m), ST.nthm(~V, SC.update(Maybe<&2, V>, vsl, s, None{}), t), ST.nthm(~V, vsl, t), T.nthm_upd_other(~V, vsl, s, t, None{}, ne)), Equal.sym(Bool, B.nthb(ST.lvs(~V, vsl), t), ST.some_b(~V, ST.nthm(~V, vsl, t)), ST.lvs_nth(~V, vsl, t))))
      L.and_intro(B.nthb(ST.lvs(~V, SC.update(Maybe<&2, V>, vsl, s, None{})), t), Nat.is_lt(t, fr), Equal.trans(Bool, B.nthb(ST.lvs(~V, SC.update(Maybe<&2, V>, vsl, s, None{})), t), B.nthb(ST.lvs(~V, vsl), t), True{}, e, L.and_left(B.nthb(ST.lvs(~V, vsl), t), Nat.is_lt(t, fr), h)), L.and_right(B.nthb(ST.lvs(~V, vsl), t), Nat.is_lt(t, fr), h))

def lvr_i(~V: Data, $RP, +vsl: List<&2, Maybe<&2, V>>, +fr: Nat, +hl: {B.all_lt(B.PLive{O, ST.lvs(~V, vsl), fr}, n) $TT, +s: Nat, +hns: {ST.noslot($V0, s, n) $TT, +j: Nat, +hj: {Nat.is_lt(j, n) $TT, +c: Bool, +hc: {Nat.is_eq(i, j) == c : Bool}) -> {B.live_b(ST.lvs(~V, SC.update(Maybe<&2, V>, vsl, s, None{})), fr, B.at($V0, j)) $TT:
  match c:
    case True{}:
      L.subst(B.Bk, y => {B.live_b(ST.lvs(~V, SC.update(Maybe<&2, V>, vsl, s, None{})), fr, y) $TT, B.BE{}, B.at($V0, j), Equal.sym(B.Bk, B.at($V0, j), B.BE{}, IM.at_bu_eq(O, i, B.BE{}, hlen, j, hc)), {==})
    case False{}:
      +eat = IM.at_bupd_other(O, i, B.BE{}, j, hc)
      +hne = L.subst(B.Bk, y => {Bool.not(Bool.and(B.occ(y), Nat.is_eq(UD.v(H.slot(B.lnk(y))), s))) $TT, B.at($V0, j), B.at(O, j), eat, IM.noslot_inst($V0, s, n, hns, j, hj))
      L.subst(B.Bk, y => {B.live_b(ST.lvs(~V, SC.update(Maybe<&2, V>, vsl, s, None{})), fr, y) $TT, B.at(O, j), B.at($V0, j), Equal.sym(B.Bk, B.at($V0, j), B.at(O, j), eat), lvr_b(~V, vsl, s, fr, B.at(O, j), B.all_inst(B.PLive{O, ST.lvs(~V, vsl), fr}, n, hl, j, hj), hne))

# THEOREM: the other buckets stay live once the removed slot is vacant
def live_rm(~V: Data, $RP, +vsl: List<&2, Maybe<&2, V>>, +fr: Nat, +hl: {B.all_lt(B.PLive{O, ST.lvs(~V, vsl), fr}, n) $TT, +s: Nat, +hns: {ST.noslot($V0, s, n) $TT, +m: Nat, +hm: {Nat.is_le(m, n) $TT) -> {B.all_lt(B.PLive{$V0, ST.lvs(~V, SC.update(Maybe<&2, V>, vsl, s, None{})), fr}, m) $TT:
  match m:
    case 0n:
      {==}
    case 1n+q:
      +hq = N.succ_le_lt(q, n, hm)
      L.and_intro(B.live_b(ST.lvs(~V, SC.update(Maybe<&2, V>, vsl, s, None{})), fr, B.at($V0, q)), B.all_lt(B.PLive{$V0, ST.lvs(~V, SC.update(Maybe<&2, V>, vsl, s, None{})), fr}, q), lvr_i(~V, $RA, vsl, fr, hl, s, hns, q, hq, Nat.is_eq(i, q), {==}), live_rm(~V, $RA, vsl, fr, hl, s, hns, q, N.lt_le(q, n, hq)))

# ---- the free list after pushing the vacated slot ----

def subl_refl(+xs: List<&2, Nat>) -> {IF.subl(xs, xs) $TT:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      L.and_intro(NL.memn(x, Con{x, t}), IF.subl(t, Con{x, t}), L.subst(Bool, b => {Bool.or(b, NL.memn(x, t)) $TT, True{}, Nat.is_eq(x, x), Equal.sym(Bool, Nat.is_eq(x, x), True{}, N.is_eq_refl(x)), {==}), IF.subl_cons(t, t, x, subl_refl(t)))

def mem_self(+t: Nat, +xs: List<&2, Nat>) -> {NL.memn(t, Con{t, xs}) $TT:
  L.subst(Bool, b => {Bool.or(b, NL.memn(t, xs)) $TT, True{}, Nat.is_eq(t, t), Equal.sym(Bool, Nat.is_eq(t, t), True{}, N.is_eq_refl(t)), {==})

%def XS Con{s, Con{t, seen}}

# the two orders of visiting s and t
def subl_sw(+s: Nat, +t: Nat, +seen: List<&2, Nat>) -> {IF.subl(Con{t, Con{s, seen}}, Con{s, Con{t, seen}}) $TT:
  L.and_intro(NL.memn(t, $XS), IF.subl(Con{s, seen}, $XS), IF.mem_cons(t, s, Con{t, seen}, mem_self(t, seen)), L.and_intro(NL.memn(s, $XS), IF.subl(seen, $XS), mem_self(s, Con{t, seen}), IF.subl_cons(seen, Con{t, seen}, s, IF.subl_cons(seen, seen, t, subl_refl(seen)))))

%def TF UD.v(H.slot(f))
%def NX2 SC.update(U32, nxl, $SV, fv)
%def FLP +Vf: List<&2, B.Bk>, +hf: {B.all_lt(B.PFrom{Vf, $V0, n}, n) $TT, +hoi: {B.occ(B.at(O, i)) $TT, +nxl: List<&2, U32>, +fv: U32
%def FLA Vf, hf, hoi, nxl, fv

# THEOREM: the old free list is still valid after pushing the vacated slot
def fl_pr($RP, $FLP, +cnt: Nat, +f: U32, +fr: Nat, +seen: List<&2, Nat>, +h: {ST.fl_ok(O, n, nxl, cnt, f, fr, seen) $TT) -> {ST.fl_ok(Vf, n, $NX2, cnt, f, fr, Con{$SV, seen}) $TT:
  match cnt:
    case 0n:
      h
    case 1n+p:
      +x1 = Bool.not(U32.is_eq(f, 0))
      +y = Bool.and(Nat.is_lt($TF, fr), Bool.and(ST.noslot(O, $TF, n), Bool.not(NL.memn($TF, seen))))
      +tl = ST.fl_ok(O, n, nxl, p, W32.nth0(nxl, $TF), fr, Con{$TF, seen})
      +z = Bool.and(ST.noslot(O, $TF, n), Bool.not(NL.memn($TF, seen)))
      +a2 = L.and_left(y, tl, L.and_right(x1, Bool.and(y, tl), h))
      +a5 = L.and_right(y, tl, L.and_right(x1, Bool.and(y, tl), h))
      +ns = L.and_left(ST.noslot(O, $TF, n), Bool.not(NL.memn($TF, seen)), L.and_right(Nat.is_lt($TF, fr), z, a2))
      +nm = L.and_right(ST.noslot(O, $TF, n), Bool.not(NL.memn($TF, seen)), L.and_right(Nat.is_lt($TF, fr), z, a2))
      +ne = IM.slot_other(B.at(O, i), $TF, hoi, IM.noslot_inst(O, $TF, n, ns, i, hi))
      +ns2 = RH.ns_from(Vf, $V0, n, n, hf, $TF, ns_be($RA, $TF, ns, n, N.le_refl(n)), n, N.le_refl(n))
      +nm2 = L.subst(Bool, b => {Bool.not(Bool.or(b, NL.memn($TF, seen))) $TT, False{}, Nat.is_eq($SV, $TF), Equal.sym(Bool, Nat.is_eq($SV, $TF), False{}, ne), nm)
      +enx = W32.nth0_upd_other(nxl, $SV, $TF, fv, ne)
      +r0 = fl_pr($RA, $FLA, p, W32.nth0(nxl, $TF), fr, Con{$TF, seen}, a5)
      +r1 = L.subst(U32, g => {ST.fl_ok(Vf, n, $NX2, p, g, fr, Con{$SV, Con{$TF, seen}}) $TT, W32.nth0(nxl, $TF), W32.nth0($NX2, $TF), Equal.sym(U32, W32.nth0($NX2, $TF), W32.nth0(nxl, $TF), enx), r0)
      +r2 = IF.fl_weak(Vf, n, $NX2, p, W32.nth0($NX2, $TF), fr, Con{$SV, Con{$TF, seen}}, Con{$TF, Con{$SV, seen}}, subl_sw($SV, $TF, seen), r1)
      +y2 = Bool.and(Nat.is_lt($TF, fr), Bool.and(ST.noslot(Vf, $TF, n), Bool.not(NL.memn($TF, Con{$SV, seen}))))
      +tl2 = ST.fl_ok(Vf, n, $NX2, p, W32.nth0($NX2, $TF), fr, Con{$TF, Con{$SV, seen}})
      L.and_intro(x1, Bool.and(y2, tl2), L.and_left(x1, Bool.and(y, tl), h), L.and_intro(y2, tl2, L.and_intro(Nat.is_lt($TF, fr), Bool.and(ST.noslot(Vf, $TF, n), Bool.not(NL.memn($TF, Con{$SV, seen}))), L.and_left(Nat.is_lt($TF, fr), z, a2), L.and_intro(ST.noslot(Vf, $TF, n), Bool.not(NL.memn($TF, Con{$SV, seen})), ns2, nm2)), r2))

# ---- the model's keys have no repeats ----

def mk_b(+key: String, +b: B.Bk, +r: List<&2, String>, +hnh: {Bool.not(B.hold(key, b)) $TT, +hr: {S.mem(key, r) $FF) -> {S.mem(key, SC.append(String, KW.kof(b), r)) $FF:
  match b:
    case B.BE{}:
      hr
    case B.BF{w, l, +k}:
      L.subst(Bool, x => {Bool.or(x, S.mem(key, r)) $FF, False{}, S.str_eq(k, key), Equal.sym(Bool, S.str_eq(k, key), False{}, K.not_true_eq(S.str_eq(k, key), hnh)), hr)

def mem_kb(+bs: List<&2, B.Bk>, +key: String, +m: Nat, +j: Nat, +h: {LK.nob(bs, key, m, j) $TT) -> {S.mem(key, KW.kb(bs, m, j)) $FF:
  match m:
    case 0n:
      {==}
    case 1n+p:
      mk_b(key, B.at(bs, j), KW.kb(bs, p, 1n+j), L.and_left(Bool.not(B.hold(key, B.at(bs, j))), LK.nob(bs, key, p, 1n+j), h), mem_kb(bs, key, p, 1n+j, L.and_right(Bool.not(B.hold(key, B.at(bs, j))), LK.nob(bs, key, p, 1n+j), h)))

def nd_b(+bs: List<&2, B.Bk>, +n: Nat, +huq: {B.all_lt(B.PUniq{bs}, n) $TT, +j: Nat, +hj: {Nat.is_lt(j, n) $TT, +p: Nat, +hjm: {Nat.is_le(Nat.add(1n+j, p), n) $TT, +b: B.Bk, +hb: {B.at(bs, j) == b : B.Bk}, +hr: {S.nodup(KW.kb(bs, p, 1n+j)) $TT) -> {S.nodup(SC.append(String, KW.kof(b), KW.kb(bs, p, 1n+j))) $TT:
  match b:
    case B.BE{}:
      hr
    case B.BF{w, l, +k}:
      +hk = L.subst(B.Bk, y => {B.hold(k, y) $TT, B.BF{w, l, k}, B.at(bs, j), Equal.sym(B.Bk, B.at(bs, j), B.BF{w, l, k}, hb), K.str_refl(k))
      +nm = mem_kb(bs, k, p, 1n+j, LK.nob_past(bs, n, k, huq, j, hj, hk, p, 1n+j, hjm, N.lt_succ(j)))
      L.and_intro(Bool.not(S.mem(k, KW.kb(bs, p, 1n+j))), S.nodup(KW.kb(bs, p, 1n+j)), IM.not_f(S.mem(k, KW.kb(bs, p, 1n+j)), nm), hr)

def nodup_kb(+bs: List<&2, B.Bk>, +n: Nat, +huq: {B.all_lt(B.PUniq{bs}, n) $TT, +m: Nat, +j: Nat, +hjm: {Nat.is_le(Nat.add(j, m), n) $TT) -> {S.nodup(KW.kb(bs, m, j)) $TT:
  match m:
    case 0n:
      {==}
    case 1n+p:
      +hj = IA.idx_lt(j, p, n, hjm)
      +hjm2 = IA.idx_next(j, p, n, hjm)
      nd_b(bs, n, huq, j, hj, p, hjm2, B.at(bs, j), {==}, nodup_kb(bs, n, huq, p, 1n+j, hjm2))

# THEOREM: the model of a table with unique keys has no repeated key
def nodup_model(~V: Data, +bs: List<&2, B.Bk>, +vsl: List<&2, Maybe<&2, V>>, +fr: Nat, +n: Nat, +hl: {B.all_lt(B.PLive{bs, ST.lvs(~V, vsl), fr}, n) $TT, +huq: {B.all_lt(B.PUniq{bs}, n) $TT) -> {S.nodup(S.keys(~V, ST.absm(~V, bs, vsl, n, 0n))) $TT:
  L.subst(List<&2, String>, z => {S.nodup(z) $TT, KW.kb(bs, n, 0n), S.keys(~V, ST.absm(~V, bs, vsl, n, 0n)), Equal.sym(List<&2, String>, S.keys(~V, ST.absm(~V, bs, vsl, n, 0n)), KW.kb(bs, n, 0n), KW.keys_absm(~V, bs, vsl, fr, n, hl, n, 0n, N.le_refl(n))), nodup_kb(bs, n, huq, n, 0n, N.le_refl(n)))

# ---- a key cell no bucket uses ----

def kd_i(+tb: List<&2, U32>, +kl: List<&2, String>, +s: Nat, +n: Nat, +hns: {ST.noslot(TB.buckets(tb, kl, n), s, n) $TT, +i: Nat, +hi: {Nat.is_lt(i, n) $TT) -> {Bool.not(Bool.and(B.occ(TB.dec(tb, kl, i)), Nat.is_eq(UD.v(H.slot(B.lnk(TB.dec(tb, kl, i)))), s))) $TT:
  L.subst(B.Bk, y => {Bool.not(Bool.and(B.occ(y), Nat.is_eq(UD.v(H.slot(B.lnk(y))), s))) $TT, B.at(TB.buckets(tb, kl, n), i), TB.dec(tb, kl, i), TB.at_buckets(tb, kl, n, i, hi), IM.noslot_inst(TB.buckets(tb, kl, n), s, n, hns, i, hi))

def kd(+tb: List<&2, U32>, +kl: List<&2, String>, +s: Nat, +sk: String, +n: Nat, +hns: {ST.noslot(TB.buckets(tb, kl, n), s, n) $TT, +m: Nat, +i: Nat, +hmi: {Nat.is_le(Nat.add(i, m), n) $TT) -> {TB.dlist(tb, SC.update(String, kl, s, sk), m, i) == TB.dlist(tb, kl, m, i) : List<&2, B.Bk>}:
  match m:
    case 0n:
      {==}
    case 1n+p:
      +hi = IA.idx_lt(i, p, n, hmi)
      IA.con_eq(TB.dec(tb, SC.update(String, kl, s, sk), i), TB.dec(tb, kl, i), TB.dlist(tb, SC.update(String, kl, s, sk), p, 1n+i), TB.dlist(tb, kl, p, 1n+i), IA.dec_same_c(W32.nth0(tb, Nat.double(i)), W32.nth0(tb, 1n+Nat.double(i)), kl, s, sk, U32.is_eq(W32.nth0(tb, Nat.double(i)), 0), kd_i(tb, kl, s, n, hns, i, hi)), kd(tb, kl, s, sk, n, hns, p, 1n+i, IA.idx_next(i, p, n, hmi)))

# THEOREM: rewriting a key cell no bucket uses leaves every bucket
def bs_key(+tb: List<&2, U32>, +kl: List<&2, String>, +s: Nat, +sk: String, +n: Nat, +hns: {ST.noslot(TB.buckets(tb, kl, n), s, n) $TT) -> {TB.buckets(tb, SC.update(String, kl, s, sk), n) == TB.buckets(tb, kl, n) : List<&2, B.Bk>}:
  kd(tb, kl, s, sk, n, hns, n, 0n, N.le_refl(n))
