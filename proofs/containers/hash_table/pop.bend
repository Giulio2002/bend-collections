      +nz2 = L.subst(U32, z => {Bool.not(U32.is_eq(z, 0)) == True{} : Bool}, B.lnk(B.at(TB.buckets(AR.slots(U32, tabT), AR.slots(String, ksT), SC.pow2(k)), i)), l, hl, nz)
      (hr, (hlv, K.not_true_eq(U32.is_eq(l, 0), nz2)))

