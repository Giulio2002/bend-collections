# THEOREM set_ok: for any key and value, the implementation's set is the
# specification's set: every lookup and the size agree, and the invariant is
# kept. (Precondition: after the insertion the map has at most 2^cap - 1
# entries, cap <= 30, so the table stays below 2^31 buckets.)

%def TT == True{} : Bool}
%def FF == False{} : Bool}
%def O +one: Nat, +h1: {one == 1n : Nat}
%def FLD n, k, td, fresh, sz, sd, sdU, free, tabT, ksT, vsT, nxT
%def FP +n: U32, +k: Nat, +td: U32, +fresh: U32, +sz: U32, +sd: Nat, +sdU: U32, +free: U32, +tabT: AR.Tree<U32>, +ksT: AR.Tree<String>, +vsT: AR.Tree<Maybe<&2, V>>, +nxT: AR.Tree<U32>
%def SH ST.HS{n, k, td, fresh, sz, sd, sdU, free, tabT, ksT, vsT, nxT}
%def KL AR.slots(String, ksT)
%def TBL AR.slots(U32, tabT)
%def VSL AR.slots(Maybe<&2, V>, vsT)
%def NN SC.pow2(k)
%def BS TB.buckets($TBL, $KL, $NN)
%def BS2 TB.buckets($TBL, AR.slots(String, K2), $NN)
%def W K.kword(key)
%def SK PA.stored(key)
%def HOME UD.v(HS.bucket($W, CY.msk(k)))
%def GF ~V, n, k, td, fresh, sz, sd, sdU, free, tabT, $KL, AR.perfect(String, sd, ksT), vsT, nxT, hg
%def CAP +cap: Nat, +hc30: {Nat.is_le(cap, 30n) $TT, +hcap: {Nat.is_le(Nat.double(1n+UD.v(n)), SC.pow2(cap)) $TT
%def CA cap, hc30, hcap
%def SETF H.set_f(&2, V, n, CY.msk(k), td, fresh, sz, sdU, free, AR.thaw(Maybe<&2, V>, vsT), AR.thaw(U32, nxT), x, (PI.fd_of(r, AR.thaw(U32, tabT), AR.thaw(String, K2), $SK), $W))
%def NEWK H.ins_new(&2, V, n, CY.msk(k), td, fresh, sz, sdU, free, AR.thaw(U32, tabT), AR.thaw(String, K2), AR.thaw(Maybe<&2, V>, vsT), AR.thaw(U32, nxT), U32.from_nat(e), $W, $SK, x
%def M2 ST.absm(~V, $BS2, $VSL, $NN, 0n)
%def HG2 ~V, n, k, td, fresh, sz, sd, sdU, free, tabT, AR.slots(String, K2), AR.perfect(String, sd, K2), vsT, nxT, hg2
%def MP ~V: Data, $O, $FP, +hg: {ST.good(~V, $SH) $TT, $CAP, +key: String, +x: V, +K2: AR.Tree<String>, +hsl2: {AR.slots(String, K2) == $KL : List<&2, String>}, +pk2: {AR.perfect(String, sd, K2) $TT
%def MA ~V, one, h1, $FLD, hg, $CA, key, x, K2, hsl2, pk2
%def TO L.subst(List<&2, String>, z =>
%def FROM , $KL, AR.slots(String, K2), Equal.sym(List<&2, String>, AR.slots(String, K2), $KL, hsl2),

# the invariant for the probe's copy of the key tree
def hg2($MP) -> {ST.goodF(~V, n, k, td, fresh, sz, sd, sdU, free, tabT, AR.slots(String, K2), AR.perfect(String, sd, K2), vsT, nxT) $TT:
  +pkT = ST.g_cpk($GF)
  +hgT = L.subst(Bool, b => {ST.goodF(~V, n, k, td, fresh, sz, sd, sdU, free, tabT, $KL, b, vsT, nxT) $TT, AR.perfect(String, sd, ksT), True{}, pkT, hg)
  $TO {ST.goodF(~V, n, k, td, fresh, sz, sd, sdU, free, tabT, z, AR.perfect(String, sd, K2), vsT, nxT) $TT $FROM L.subst(Bool, b => {ST.goodF(~V, n, k, td, fresh, sz, sd, sdU, free, tabT, $KL, b, vsT, nxT) $TT, True{}, AR.perfect(String, sd, K2), Equal.sym(Bool, AR.perfect(String, sd, K2), True{}, pk2), hgT))

# a new key: it was absent, so the key-preservation clause holds vacuously
def keep_miss($MP, +hno: {B.all_lt(B.PNo{$BS2, key}, $NN) $TT, +sh2: ST.Sh<V>, +hp: {S.has(~V, ST.model(~V, $SH), key) $TT) -> {S.keys(~V, ST.model(~V, sh2)) == S.keys(~V, ST.model(~V, $SH)) : List<&2, String>}:
  +ln = $TO {S.lookup(~V, ST.absm(~V, TB.buckets($TBL, z, $NN), $VSL, $NN, 0n), key) == None{} : Maybe<&2, V>}, AR.slots(String, K2), $KL, hsl2, LK.lookup_none(~V, $BS2, $VSL, key, $NN, hno))
  Empty.absurd({S.keys(~V, ST.model(~V, sh2)) == S.keys(~V, ST.model(~V, $SH)) : List<&2, String>}, L.false_true(L.subst(Maybe<&2, V>, z => {S.is_some(~V, z) $TT, S.lookup(~V, ST.absm(~V, $BS, $VSL, $NN, 0n), key), None{}, ln, hp)))

def to_sh2($MP, -r: H.HashMap<&2, V>, +hno: {B.all_lt(B.PNo{$BS2, key}, $NN) $TT, sm: IS.SetM(~V, ST.model(~V, $SH), key, x, r)) -> ST2.SetOK(~V, $SH, key, x, r):
  match sm:
    case Tuple{+sh2, Tuple{+e, rest}}:
      (sh2, (e, (rest, hp => keep_miss($MA, hno, sh2, hp))))

def to_sh($MP, -r: H.HashMap<&2, V>, +hno: {B.all_lt(B.PNo{$BS2, key}, $NN) $TT, sm: IS.SetM(~V, $M2, key, x, r)) -> ST2.SetOK(~V, $SH, key, x, r):
  to_sh2($MA, r, hno, L.subst(List<&2, String>, z => IS.SetM(~V, ST.absm(~V, TB.buckets($TBL, z, $NN), $VSL, $NN, 0n), key, x, r), AR.slots(String, K2), $KL, hsl2, sm))

%def EP +e: Nat, +he: {Nat.is_lt(e, $NN) $TT, +hz: {B.at($BS2, e) == B.BE{} : B.Bk}, +hp: {B.occpath($BS2, $NN, $HOME, M.dist($NN, $HOME, e)) $TT, +hno: {B.all_lt(B.PNo{$BS2, key}, $NN) $TT
%def SIA ~V, one, h1, n, k, td, fresh, sz, sd, sdU, free, tabT, K2, vsT, nxT, hg2($MA), key, x, e, he, hz, hp, hno

def miss_room($MP, $EP, +hf: {U32.is_eq(free, 0) $TT, +c: Bool, +hc: {U32.is_lt(fresh, sz) == c : Bool}) -> IS.SetM(~V, $M2, key, x, $NEWK, True{})):
  match c:
    case True{}:
      SI.set_room($SIA, hf, hc, $CA)
    case False{}:
      SI.set_arena($SIA, hf, hc, $CA)

def miss_c($MP, $EP, +c: Bool, +hc: {U32.is_eq(free, 0) == c : Bool}) -> IS.SetM(~V, $M2, key, x, $NEWK, c)):
  match c:
    case False{}:
      SI.set_free($SIA, hc, $CA)
    case True{}:
      miss_room($MA, e, he, hz, hp, hno, hc, U32.is_lt(fresh, sz), {==})

# a new key: one of the three ways of choosing its slot
def set_miss($MP, $EP) -> ST2.SetOK(~V, $SH, key, x, $NEWK, U32.is_eq(free, 0))):
  to_sh($MA, $NEWK, U32.is_eq(free, 0)), hno, miss_c($MA, e, he, hz, hp, hno, U32.is_eq(free, 0), {==}))

%def HITS H.HM{n, CY.msk(k), td, fresh, sz, sdU, free, AR.thaw(U32, tabT), AR.thaw(String, K2), Array.set(Maybe<&2, V>, AR.thaw(Maybe<&2, V>, vsT), H.slot(l), Some{x}), AR.thaw(U32, nxT)}

def set_hitb($MP, +i: Nat, +l: U32, +hi: {Nat.is_lt(i, $NN) $TT, +hk: {B.hold(key, B.at($BS, i)) $TT, +hl: {B.lnk(B.at($BS, i)) == l : U32}, bf: {Bool.not(U32.is_eq(B.lnk(B.at($BS, i)), 0)) $TT & ({Nat.is_lt(UD.v(H.slot(B.lnk(B.at($BS, i)))), SC.pow2(sd)) $TT & {B.nthb(ST.lvs(~V, $VSL), UD.v(H.slot(B.lnk(B.at($BS, i))))) $TT)) -> ST2.SetOK(~V, $SH, key, x, H.set_hit(&2, V, n, CY.msk(k), td, fresh, sz, sdU, free, AR.thaw(U32, tabT), AR.thaw(String, K2), AR.thaw(Maybe<&2, V>, vsT), AR.thaw(U32, nxT), U32.from_nat(i), l, $W, $SK, x, U32.is_eq(l, 0))):
  match bf:
    case Tuple{nz, Tuple{hr0, hlv0}}:
      +nz2 = L.subst(U32, zz => {Bool.not(U32.is_eq(zz, 0)) $TT, B.lnk(B.at($BS, i)), l, hl, nz)
      +hr = L.subst(U32, zz => {Nat.is_lt(UD.v(H.slot(zz)), SC.pow2(sd)) $TT, B.lnk(B.at($BS, i)), l, hl, hr0)
      +hlv = L.subst(U32, zz => {B.nthb(ST.lvs(~V, $VSL), UD.v(H.slot(zz))) $TT, B.lnk(B.at($BS, i)), l, hl, hlv0)
      +e0 = Equal.cong(Bool, H.HashMap<&2, V>, b => H.set_hit(&2, V, n, CY.msk(k), td, fresh, sz, sdU, free, AR.thaw(U32, tabT), AR.thaw(String, K2), AR.thaw(Maybe<&2, V>, vsT), AR.thaw(U32, nxT), U32.from_nat(i), l, $W, $SK, x, b), U32.is_eq(l, 0), False{}, K.not_true_eq(U32.is_eq(l, 0), nz2))
      L.subst(H.HashMap<&2, V>, rr => ST2.SetOK(~V, $SH, key, x, rr), $HITS, H.set_hit(&2, V, n, CY.msk(k), td, fresh, sz, sdU, free, AR.thaw(U32, tabT), AR.thaw(String, K2), AR.thaw(Maybe<&2, V>, vsT), AR.thaw(U32, nxT), U32.from_nat(i), l, $W, $SK, x, U32.is_eq(l, 0)), Equal.sym(H.HashMap<&2, V>, H.set_hit(&2, V, n, CY.msk(k), td, fresh, sz, sdU, free, AR.thaw(U32, tabT), AR.thaw(String, K2), AR.thaw(Maybe<&2, V>, vsT), AR.thaw(U32, nxT), U32.from_nat(i), l, $W, $SK, x, U32.is_eq(l, 0)), $HITS, e0), ST2.set_hit_case(~V, $FLD, hg, key, x, K2, hsl2, pk2, i, l, hi, hk, hl, hr, hlv))

def set_r($MP, +r: B.Res, hres: B.ResOK($BS, $NN, $HOME, key, r)) -> ST2.SetOK(~V, $SH, key, x, $SETF):
  match r:
    case B.RHit{+i, +l}:
      (+hi, rest) = hres
      (+hk, hl) = rest
      set_hitb($MA, i, l, hi, hk, hl, G.bf_ok(sd, ST.lvs(~V, $VSL), UD.v(fresh), key, B.at($BS, i), B.all_inst(B.PWell{$BS, sd}, $NN, ST.g_cwell($GF), i, hi), B.all_inst(B.PLive{$BS, ST.lvs(~V, $VSL), UD.v(fresh)}, $NN, ST.g_clive($GF), i, hi), hk))
    case B.REnd{+e}:
      (he, rest) = hres
      (hz, rest2) = rest
      (hp, hno) = rest2
      set_miss($MA, e, he, $TO {B.at(TB.buckets($TBL, z, $NN), e) == B.BE{} : B.Bk} $FROM hz), $TO {B.occpath(TB.buckets($TBL, z, $NN), $NN, $HOME, M.dist($NN, $HOME, e)) $TT $FROM hp), $TO {B.all_lt(B.PNo{TB.buckets($TBL, z, $NN), key}, $NN) $TT $FROM hno))

%def RR B.pf(key, $BS, $NN, $NN, B.mstep(key, B.at($BS, $HOME)), $HOME)

def set_po(~V: Data, $O, $FP, +hg: {ST.good(~V, $SH) $TT, $CAP, +key: String, +x: V, +r: B.Res, hres: B.ResOK($BS, $NN, $HOME, key, r), po: PA.ProbeOK(tabT, sd, $KL, $SK, $W, r, H.probe(AR.thaw(U32, tabT), AR.thaw(String, ksT), CY.msk(k), key))) -> ST2.SetOK(~V, $SH, key, x, H.set(&2, V, ST.real(~V, $SH), key, x)):
  match po:
    case Tuple{+K2, Tuple{+e, rest}}:
      (+hsl2, pk2) = rest
      +eq = Equal.cong(H.Found & U32, H.HashMap<&2, V>, pr => H.set_f(&2, V, n, CY.msk(k), td, fresh, sz, sdU, free, AR.thaw(Maybe<&2, V>, vsT), AR.thaw(U32, nxT), x, pr), H.probe(AR.thaw(U32, tabT), AR.thaw(String, ksT), CY.msk(k), key), (PI.fd_of(r, AR.thaw(U32, tabT), AR.thaw(String, K2), $SK), $W), e)
      L.subst(H.HashMap<&2, V>, rr => ST2.SetOK(~V, $SH, key, x, rr), $SETF, H.set(&2, V, ST.real(~V, $SH), key, x), Equal.sym(H.HashMap<&2, V>, H.set(&2, V, ST.real(~V, $SH), key, x), $SETF, eq), set_r($MA, r, hres))

# THEOREM: set refines the specification's set
def set_ok(~V: Data, +sh: ST.Sh<V>, +hg: {ST.good(~V, sh) $TT, +cap: Nat, +hc30: {Nat.is_le(cap, 30n) $TT, +hcap: {Nat.is_le(Nat.double(1n+S.size(~V, ST.model(~V, sh))), SC.pow2(cap)) $TT, +key: String, +x: V) -> ST2.SetOK(~V, sh, key, x, H.set(&2, V, ST.real(~V, sh), key, x)):
  match sh:
    case ST.HS{+n, +k, +td, +fresh, +sz, +sd, +sdU, +free, +tabT, +ksT, +vsT, +nxT}:
      +kl = $KL
      +pk = AR.perfect(String, sd, ksT)
      +hk31 = L.and_left(Nat.is_lt(k, 31n), Nat.is_lt(0n, k), ST.g_ck($GF))
      +esz = Equal.trans(Nat, S.size(~V, ST.absm(~V, $BS, $VSL, $NN, 0n)), IV.occn($BS, $NN), UD.v(n), SZ.size_absm(~V, $BS, $VSL, UD.v(fresh), $NN, ST.g_clive($GF), $NN, N.le_refl($NN)), Equal.sym(Nat, UD.v(n), IV.occn($BS, $NN), N.eq_from_is_eq(UD.v(n), IV.occn($BS, $NN), ST.g_cn($GF))))
      +hcap2 = L.subst(Nat, z => {Nat.is_le(Nat.double(1n+z), SC.pow2(cap)) $TT, S.size(~V, ST.absm(~V, $BS, $VSL, $NN, 0n)), UD.v(n), esz, hcap)
      set_po(~V, 1n, {==}, $FLD, hg, cap, hc30, hcap2, key, x, $RR, G.res_of(~V, n, k, td, fresh, sz, sd, sdU, free, tabT, kl, pk, vsT, nxT, hg, key), PA.probe_ok(1n, {==}, k, hk31, tabT, ST.g_cpt($GF), sd, ST.g_csd($GF), kl, ksT, {==}, ST.g_cpk($GF), ST.g_cwell($GF), key))
