import Base
import ../../lib/logic.bend as L
import ../../lib/nat.bend as N
import ../../../spec/lib/common.bend as SC
import ../../lib/u32div.bend as UD
import ../../../src/containers/hash_table.bend as H
import ./buckets.bend as B
import ./inv.bend as IV
import ./state.bend as ST
import ./lookup.bend as LK
import ./tools.bend as T
import ./insm.bend as IM
import ./rehash.bend as RH
import ./ring.bend as RG
import ./keys.bend as K2

# Moving the scanned bucket b from k into the empty gap h keeps the table a
# set of copies of the original buckets, keys and links unique, and the
# number of full buckets.

%def TT == True{} : Bool}
%def FF == False{} : Bool}
%def RKV IM.bupd(V, k, B.BE{})
%def VP IM.bupd($RKV, h, b)
%def MP +V: List<&2, B.Bk>, +n: Nat, +h: Nat, +k: Nat, +b: B.Bk, +hbk: {B.at(V, k) == b : B.Bk}, +hbo: {B.occ(b) $TT, +hzh: {B.at(V, h) == B.BE{} : B.Bk}, +hhk: {Nat.is_eq(h, k) $FF, +hlh: {Nat.is_lt(h, SC.length(B.Bk, V)) $TT, +hlk: {Nat.is_lt(k, SC.length(B.Bk, V)) $TT
%def MA V, n, h, k, b, hbk, hbo, hzh, hhk, hlh, hlk

def hlen2($MP) -> {Nat.is_lt(h, SC.length(B.Bk, $RKV)) $TT:
  L.subst(Nat, z => {Nat.is_lt(h, z) $TT, SC.length(B.Bk, V), SC.length(B.Bk, $RKV), Equal.sym(Nat, SC.length(B.Bk, $RKV), SC.length(B.Bk, V), RG.len_bupd(V, k, B.BE{})), hlh)

def at_vh($MP) -> {B.at($VP, h) == b : B.Bk}:
  IM.at_bupd_same($RKV, h, b, hlen2($MA))

def at_vk($MP) -> {B.at($VP, k) == B.BE{} : B.Bk}:
  Equal.trans(B.Bk, B.at($VP, k), B.at($RKV, k), B.BE{}, IM.at_bupd_other($RKV, h, b, k, hhk), IM.at_bupd_same(V, k, B.BE{}, hlk))

def at_vo($MP, +j: Nat, +hh: {Nat.is_eq(h, j) $FF, +hk: {Nat.is_eq(k, j) $FF) -> {B.at($VP, j) == B.at(V, j) : B.Bk}:
  Equal.trans(B.Bk, B.at($VP, j), B.at($RKV, j), B.at(V, j), IM.at_bupd_other($RKV, h, b, j, hh), IM.at_bupd_other(V, k, B.BE{}, j, hk))

# ---- copies ----

%def FRO B.implies(B.occ(y), B.anyeq(src, m, y))

def fm_o($MP, +src: List<&2, B.Bk>, +m: Nat, +hf: {B.all_lt(B.PFrom{V, src, m}, n) $TT, +j: Nat, +hj: {Nat.is_lt(j, n) $TT, +hch: {Nat.is_eq(h, j) $FF, +ck: Bool, +hck: {Nat.is_eq(k, j) == ck : Bool}) -> {B.eval(B.PFrom{$VP, src, m}, j) $TT:
  match ck:
    case True{}:
      +e = Equal.trans(B.Bk, B.at($VP, j), B.at($VP, k), B.BE{}, Equal.cong(Nat, B.Bk, z => B.at($VP, z), j, k, Equal.sym(Nat, k, j, N.eq_from_is_eq(k, j, hck))), at_vk($MA))
      L.subst(B.Bk, y => {$FRO $TT, B.BE{}, B.at($VP, j), Equal.sym(B.Bk, B.at($VP, j), B.BE{}, e), {==})
    case False{}:
      L.subst(B.Bk, y => {$FRO $TT, B.at(V, j), B.at($VP, j), Equal.sym(B.Bk, B.at($VP, j), B.at(V, j), at_vo($MA, j, hch, hck)), B.all_inst(B.PFrom{V, src, m}, n, hf, j, hj))

def fm_k($MP, +src: List<&2, B.Bk>, +m: Nat, +hf: {B.all_lt(B.PFrom{V, src, m}, n) $TT, +j: Nat, +hj: {Nat.is_lt(j, n) $TT, +ch: Bool, +hch: {Nat.is_eq(h, j) == ch : Bool}, +hkn: {Nat.is_lt(k, n) $TT) -> {B.eval(B.PFrom{$VP, src, m}, j) $TT:
  match ch:
    case True{}:
      +e = Equal.trans(B.Bk, B.at($VP, j), B.at($VP, h), b, Equal.cong(Nat, B.Bk, z => B.at($VP, z), j, h, Equal.sym(Nat, h, j, N.eq_from_is_eq(h, j, hch))), at_vh($MA))
      L.subst(B.Bk, y => {$FRO $TT, b, B.at($VP, j), Equal.sym(B.Bk, B.at($VP, j), b, e), L.subst(B.Bk, y => {$FRO $TT, B.at(V, k), b, hbk, B.all_inst(B.PFrom{V, src, m}, n, hf, k, hkn)))
    case False{}:
      fm_o($MA, src, m, hf, j, hj, hch, Nat.is_eq(k, j), {==})

def from_move_m($MP, +src: List<&2, B.Bk>, +m: Nat, +hf: {B.all_lt(B.PFrom{V, src, m}, n) $TT, +hkn: {Nat.is_lt(k, n) $TT, +q: Nat, +hq: {Nat.is_le(q, n) $TT) -> {B.all_lt(B.PFrom{$VP, src, m}, q) $TT:
  match q:
    case 0n:
      {==}
    case 1n+j:
      +hj = N.succ_le_lt(j, n, hq)
      L.and_intro(B.eval(B.PFrom{$VP, src, m}, j), B.all_lt(B.PFrom{$VP, src, m}, j), fm_k($MA, src, m, hf, j, hj, Nat.is_eq(h, j), {==}, hkn), from_move_m($MA, src, m, hf, hkn, j, N.lt_le(j, n, hj)))

# THEOREM: after the move every full bucket is still a copy
def from_move($MP, +src: List<&2, B.Bk>, +m: Nat, +hf: {B.all_lt(B.PFrom{V, src, m}, n) $TT, +hkn: {Nat.is_lt(k, n) $TT) -> {B.all_lt(B.PFrom{$VP, src, m}, n) $TT:
  from_move_m($MA, src, m, hf, hkn, n, N.le_refl(n))

def tw_c($MP, +x: B.Bk, +hox: {B.occ(x) $TT, +p: Nat, +hp: {Nat.is_lt(p, n) $TT, +hat: {B.at(V, p) == x : B.Bk}, +hhn: {Nat.is_lt(h, n) $TT, +c: Bool, +hc: {Nat.is_eq(k, p) == c : Bool}) -> {B.anyeq($VP, n, x) $TT:
  match c:
    case True{}:
      +ebx = Equal.trans(B.Bk, b, B.at(V, k), x, Equal.sym(B.Bk, B.at(V, k), b, hbk), Equal.trans(B.Bk, B.at(V, k), B.at(V, p), x, Equal.cong(Nat, B.Bk, z => B.at(V, z), k, p, N.eq_from_is_eq(k, p, hc)), hat))
      RH.anyeq_intro($VP, n, x, h, hhn, L.subst(B.Bk, y => {B.bk_eq(y, x) $TT, x, B.at($VP, h), Equal.sym(B.Bk, B.at($VP, h), x, Equal.trans(B.Bk, B.at($VP, h), b, x, at_vh($MA), ebx)), RH.bk_refl(x)))
    case False{}:
      +hpo = L.subst(B.Bk, y => {B.occ(y) $TT, x, B.at(V, p), Equal.sym(B.Bk, B.at(V, p), x, hat), hox)
      +hhp = RH.ne_occ(V, h, hzh, p, hpo, Nat.is_eq(h, p), {==})
      RH.anyeq_intro($VP, n, x, p, hp, L.subst(B.Bk, y => {B.bk_eq(y, x) $TT, x, B.at($VP, p), Equal.sym(B.Bk, B.at($VP, p), x, Equal.trans(B.Bk, B.at($VP, p), B.at(V, p), x, at_vo($MA, p, hhp, hc), hat)), RH.bk_refl(x)))

def tw($MP, +x: B.Bk, +hox: {B.occ(x) $TT, +hhn: {Nat.is_lt(h, n) $TT, w0: RH.EqAt(V, n, x)) -> {B.anyeq($VP, n, x) $TT:
  match w0:
    case Tuple{+p, Tuple{+hp, +hat}}:
      tw_c($MA, x, hox, p, hp, hat, hhn, Nat.is_eq(k, p), {==})

def tm_i($MP, +hhn: {Nat.is_lt(h, n) $TT, +x: B.Bk, +hx: {B.implies(B.occ(x), B.anyeq(V, n, x)) $TT, +c: Bool, +hc: {B.occ(x) == c : Bool}) -> {B.implies(c, B.anyeq($VP, n, x)) $TT:
  match c:
    case False{}:
      {==}
    case True{}:
      tw($MA, x, hc, hhn, RH.find_eq(V, n, x, B.imp_elim(B.occ(x), B.anyeq(V, n, x), hx, hc)))

def to_move_m($MP, +src: List<&2, B.Bk>, +ms: Nat, +ht: {B.all_lt(B.PTo{src, V, n}, ms) $TT, +hhn: {Nat.is_lt(h, n) $TT, +q: Nat, +hq: {Nat.is_le(q, ms) $TT) -> {B.all_lt(B.PTo{src, $VP, n}, q) $TT:
  match q:
    case 0n:
      {==}
    case 1n+j:
      +hj = N.succ_le_lt(j, ms, hq)
      +x = B.at(src, j)
      L.and_intro(B.eval(B.PTo{src, $VP, n}, j), B.all_lt(B.PTo{src, $VP, n}, j), L.subst(Bool, c => {B.implies(c, B.anyeq($VP, n, x)) $TT, B.occ(x), B.occ(x), {==}, tm_i($MA, hhn, x, B.all_inst(B.PTo{src, V, n}, ms, ht, j, hj), B.occ(x), {==})), to_move_m($MA, src, ms, ht, hhn, j, N.lt_le(j, ms, hj)))

# THEOREM: after the move every original bucket still has a copy
def to_move($MP, +src: List<&2, B.Bk>, +ms: Nat, +ht: {B.all_lt(B.PTo{src, V, n}, ms) $TT, +hhn: {Nat.is_lt(h, n) $TT) -> {B.all_lt(B.PTo{src, $VP, n}, ms) $TT:
  to_move_m($MA, src, ms, ht, hhn, ms, N.le_refl(ms))

# ---- uniqueness ----

def uqr_b(+bs: List<&2, B.Bk>, +k: Nat, +hlk: {Nat.is_lt(k, SC.length(B.Bk, bs)) $TT, +j: Nat, +x: B.Bk, +hu: {B.uq_b(bs, j, x) $TT) -> {B.uq_b(IM.bupd(bs, k, B.BE{}), j, x) $TT:
  match x:
    case B.BE{}:
      {==}
    case B.BF{w, +l, +key}:
      L.and_intro(B.nohb(IM.bupd(bs, k, B.BE{}), key, j), B.nolb(IM.bupd(bs, k, B.BE{}), l, j), IM.nohb_up(bs, k, B.BE{}, hlk, key, {==}, j, L.and_left(B.nohb(bs, key, j), B.nolb(bs, l, j), hu)), IM.nolb_up(bs, k, B.BE{}, hlk, l, {==}, j, L.and_right(B.nohb(bs, key, j), B.nolb(bs, l, j), hu)))

def uqr_i(+bs: List<&2, B.Bk>, +k: Nat, +hlk: {Nat.is_lt(k, SC.length(B.Bk, bs)) $TT, +n: Nat, +huq: {B.all_lt(B.PUniq{bs}, n) $TT, +j: Nat, +hj: {Nat.is_lt(j, n) $TT, +c: Bool, +hc: {Nat.is_eq(k, j) == c : Bool}) -> {B.eval(B.PUniq{IM.bupd(bs, k, B.BE{})}, j) $TT:
  match c:
    case True{}:
      L.subst(B.Bk, y => {B.uq_b(IM.bupd(bs, k, B.BE{}), j, y) $TT, B.BE{}, B.at(IM.bupd(bs, k, B.BE{}), j), Equal.sym(B.Bk, B.at(IM.bupd(bs, k, B.BE{}), j), B.BE{}, IM.at_bu_eq(bs, k, B.BE{}, hlk, j, hc)), {==})
    case False{}:
      L.subst(B.Bk, y => {B.uq_b(IM.bupd(bs, k, B.BE{}), j, y) $TT, B.at(bs, j), B.at(IM.bupd(bs, k, B.BE{}), j), Equal.sym(B.Bk, B.at(IM.bupd(bs, k, B.BE{}), j), B.at(bs, j), IM.at_bupd_other(bs, k, B.BE{}, j, hc)), uqr_b(bs, k, hlk, j, B.at(bs, j), B.all_inst(B.PUniq{bs}, n, huq, j, hj)))

# THEOREM: emptying a bucket keeps keys and links unique
def uq_rm(+bs: List<&2, B.Bk>, +k: Nat, +hlk: {Nat.is_lt(k, SC.length(B.Bk, bs)) $TT, +n: Nat, +huq: {B.all_lt(B.PUniq{bs}, n) $TT, +m: Nat, +hm: {Nat.is_le(m, n) $TT) -> {B.all_lt(B.PUniq{IM.bupd(bs, k, B.BE{})}, m) $TT:
  match m:
    case 0n:
      {==}
    case 1n+j:
      +hj = N.succ_le_lt(j, n, hm)
      L.and_intro(B.eval(B.PUniq{IM.bupd(bs, k, B.BE{})}, j), B.all_lt(B.PUniq{IM.bupd(bs, k, B.BE{})}, j), uqr_i(bs, k, hlk, n, huq, j, hj, Nat.is_eq(k, j), {==}), uq_rm(bs, k, hlk, n, huq, j, N.lt_le(j, n, hj)))

%def RP +V: List<&2, B.Bk>, +n: Nat, +k: Nat, +hkn: {Nat.is_lt(k, n) $TT, +hlk: {Nat.is_lt(k, SC.length(B.Bk, V)) $TT, +huq: {B.all_lt(B.PUniq{V}, n) $TT, +w: U32, +l: U32, +key: String, +hbk: {B.at(V, k) == B.BF{w, l, key} : B.Bk}
%def RA V, n, k, hkn, hlk, huq, w, l, key, hbk

def pno_rm_i($RP, +j: Nat, +hj: {Nat.is_lt(j, n) $TT, +c: Bool, +hc: {Nat.is_eq(k, j) == c : Bool}) -> {B.eval(B.PNo{$RKV, key}, j) $TT:
  match c:
    case True{}:
      L.subst(B.Bk, y => {Bool.not(B.hold(key, y)) $TT, B.BE{}, B.at($RKV, j), Equal.sym(B.Bk, B.at($RKV, j), B.BE{}, IM.at_bu_eq(V, k, B.BE{}, hlk, j, hc)), {==})
    case False{}:
      +hk = L.subst(B.Bk, y => {B.hold(key, y) $TT, B.BF{w, l, key}, B.at(V, k), Equal.sym(B.Bk, B.at(V, k), B.BF{w, l, key}, hbk), K2.str_refl(key))
      L.subst(B.Bk, y => {Bool.not(B.hold(key, y)) $TT, B.at(V, j), B.at($RKV, j), Equal.sym(B.Bk, B.at($RKV, j), B.at(V, j), IM.at_bupd_other(V, k, B.BE{}, j, hc)), LK.other(V, n, key, huq, k, hkn, hk, j, hj, N.is_eq_sym_false(k, j, hc)))

def pno_rm($RP, +m: Nat, +hm: {Nat.is_le(m, n) $TT) -> {B.all_lt(B.PNo{$RKV, key}, m) $TT:
  match m:
    case 0n:
      {==}
    case 1n+j:
      +hj = N.succ_le_lt(j, n, hm)
      L.and_intro(B.eval(B.PNo{$RKV, key}, j), B.all_lt(B.PNo{$RKV, key}, j), pno_rm_i($RA, j, hj, Nat.is_eq(k, j), {==}), pno_rm($RA, j, N.lt_le(j, n, hj)))

def nsr_o($RP, +j: Nat, +hj: {Nat.is_lt(j, n) $TT, +hc: {Nat.is_eq(k, j) $FF, +o: Bool, +ho: {B.occ(B.at(V, j)) == o : Bool}) -> {Bool.not(Bool.and(o, Nat.is_eq(UD.v(H.slot(B.lnk(B.at(V, j)))), UD.v(H.slot(l))))) $TT:
  match o:
    case False{}:
      {==}
    case True{}:
      +ok = L.subst(B.Bk, y => {B.occ(y) $TT, B.BF{w, l, key}, B.at(V, k), Equal.sym(B.Bk, B.at(V, k), B.BF{w, l, key}, hbk), {==})
      +ne = T.slot_ne(V, n, huq, k, j, hkn, hj, N.is_eq_sym_false(k, j, hc), ok, ho)
      +ne2 = L.subst(B.Bk, y => {Nat.is_eq(UD.v(H.slot(B.lnk(B.at(V, j)))), UD.v(H.slot(B.lnk(y)))) $FF, B.at(V, k), B.BF{w, l, key}, hbk, ne)
      IM.not_f(Nat.is_eq(UD.v(H.slot(B.lnk(B.at(V, j)))), UD.v(H.slot(l))), ne2)

def nsr_i($RP, +j: Nat, +hj: {Nat.is_lt(j, n) $TT, +c: Bool, +hc: {Nat.is_eq(k, j) == c : Bool}) -> {Bool.not(Bool.and(B.occ(B.at($RKV, j)), Nat.is_eq(UD.v(H.slot(B.lnk(B.at($RKV, j)))), UD.v(H.slot(l))))) $TT:
  match c:
    case True{}:
      L.subst(B.Bk, y => {Bool.not(Bool.and(B.occ(y), Nat.is_eq(UD.v(H.slot(B.lnk(y))), UD.v(H.slot(l))))) $TT, B.BE{}, B.at($RKV, j), Equal.sym(B.Bk, B.at($RKV, j), B.BE{}, IM.at_bu_eq(V, k, B.BE{}, hlk, j, hc)), {==})
    case False{}:
      L.subst(B.Bk, y => {Bool.not(Bool.and(B.occ(y), Nat.is_eq(UD.v(H.slot(B.lnk(y))), UD.v(H.slot(l))))) $TT, B.at(V, j), B.at($RKV, j), Equal.sym(B.Bk, B.at($RKV, j), B.at(V, j), IM.at_bupd_other(V, k, B.BE{}, j, hc)), nsr_o($RA, j, hj, hc, B.occ(B.at(V, j)), {==}))

def ns_rm($RP, +m: Nat, +hm: {Nat.is_le(m, n) $TT) -> {ST.noslot($RKV, UD.v(H.slot(l)), m) $TT:
  match m:
    case 0n:
      {==}
    case 1n+j:
      +hj = N.succ_le_lt(j, n, hm)
      L.and_intro(Bool.not(Bool.and(B.occ(B.at($RKV, j)), Nat.is_eq(UD.v(H.slot(B.lnk(B.at($RKV, j)))), UD.v(H.slot(l))))), ST.noslot($RKV, UD.v(H.slot(l)), j), nsr_i($RA, j, hj, Nat.is_eq(k, j), {==}), ns_rm($RA, j, N.lt_le(j, n, hj)))

%def NBF B.BF{w, l, key}
%def VPF IM.bupd($RKV, h, $NBF)

# THEOREM: moving a bucket into an empty bucket keeps keys and links unique
def uq_move($RP, +h: Nat, +hhn: {Nat.is_lt(h, n) $TT, +hlh: {Nat.is_lt(h, SC.length(B.Bk, V)) $TT) -> {B.all_lt(B.PUniq{$VPF}, n) $TT:
  +hl2 = L.subst(Nat, z => {Nat.is_lt(h, z) $TT, SC.length(B.Bk, V), SC.length(B.Bk, $RKV), Equal.sym(Nat, SC.length(B.Bk, $RKV), SC.length(B.Bk, V), RG.len_bupd(V, k, B.BE{})), hlh)
  IM.uq_up($RKV, h, hl2, w, l, key, n, hhn, uq_rm(V, k, hlk, n, huq, n, N.le_refl(n)), pno_rm($RA, n, N.le_refl(n)), ns_rm($RA, n, N.le_refl(n)))

# ---- the count ----

def bupd_self(+xs: List<&2, B.Bk>, +k: Nat) -> {IM.bupd(xs, k, B.at(xs, k)) == xs : List<&2, B.Bk>}:
  match xs k:
    case Nil{} _:
      {==}
    case Con{c, t} 0n:
      {==}
    case Con{c, t} 1n+p:
      Equal.cong(List<&2, B.Bk>, List<&2, B.Bk>, z => Con{c, z}, IM.bupd(t, p, B.at(t, p)), t, bupd_self(t, p))

# emptying a full bucket k < n: one fewer full bucket
def occn_rm(+V: List<&2, B.Bk>, +n: Nat, +k: Nat, +hkn: {Nat.is_lt(k, n) $TT, +hlk: {Nat.is_lt(k, SC.length(B.Bk, V)) $TT, +hok: {B.occ(B.at(V, k)) $TT) -> {IV.occn(V, n) == 1n+IV.occn($RKV, n) : Nat}:
  +hl2 = L.subst(Nat, z => {Nat.is_lt(k, z) $TT, SC.length(B.Bk, V), SC.length(B.Bk, $RKV), Equal.sym(Nat, SC.length(B.Bk, $RKV), SC.length(B.Bk, V), RG.len_bupd(V, k, B.BE{})), hlk)
  +ev = Equal.trans(List<&2, B.Bk>, IM.bupd($RKV, k, B.at(V, k)), IM.bupd(V, k, B.at(V, k)), V, RG.bupd_over(V, k, B.BE{}, B.at(V, k)), bupd_self(V, k))
  Equal.trans(Nat, IV.occn(V, n), IV.occn(IM.bupd($RKV, k, B.at(V, k)), n), 1n+IV.occn($RKV, n), Equal.cong(List<&2, B.Bk>, Nat, z => IV.occn(z, n), V, IM.bupd($RKV, k, B.at(V, k)), Equal.sym(List<&2, B.Bk>, IM.bupd($RKV, k, B.at(V, k)), V, ev)), IM.occn_up($RKV, k, B.at(V, k), hok, hl2, IM.at_bupd_same(V, k, B.BE{}, hlk), n, hkn))

# THEOREM: the move keeps the number of full buckets
def occn_move($MP, +hkn: {Nat.is_lt(k, n) $TT, +hhn: {Nat.is_lt(h, n) $TT) -> {IV.occn($VP, n) == IV.occn(V, n) : Nat}:
  +hok = L.subst(B.Bk, y => {B.occ(y) $TT, b, B.at(V, k), Equal.sym(B.Bk, B.at(V, k), b, hbk), hbo)
  +hzr = Equal.trans(B.Bk, B.at($RKV, h), B.at(V, h), B.BE{}, IM.at_bupd_other(V, k, B.BE{}, h, N.is_eq_sym_false(h, k, hhk)), hzh)
  Equal.trans(Nat, IV.occn($VP, n), 1n+IV.occn($RKV, n), IV.occn(V, n), IM.occn_up($RKV, h, b, hbo, hlen2($MA), hzr, n, hhn), Equal.sym(Nat, IV.occn(V, n), 1n+IV.occn($RKV, n), occn_rm(V, n, k, hkn, hlk, hok)))
