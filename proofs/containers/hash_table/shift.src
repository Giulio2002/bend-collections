# del_at: the implementation's backward shift is the bucket-level one.

%def TT == True{} : Bool}
%def FF == False{} : Bool}
%def TB2 SC.update(U32, SC.update(U32, tb, Nat.double(e), w), 1n+Nat.double(e), l)

# ---- writing one bucket, the key arena unchanged ----

def d_other(+tb: List<&2, U32>, +kl: List<&2, String>, +e: Nat, +w: U32, +l: U32, +j: Nat, +hne: {Nat.is_eq(e, j) $FF) -> {TB.dec($TB2, kl, j) == TB.dec(tb, kl, j) : B.Bk}:
  +wj = W32.nth0(tb, Nat.double(j))
  Equal.trans(B.Bk, TB.dec($TB2, kl, j), TB.dec_c(wj, W32.nth0($TB2, 1n+Nat.double(j)), kl, U32.is_eq(wj, 0)), TB.dec(tb, kl, j), Equal.cong(U32, B.Bk, a => TB.dec_c(a, W32.nth0($TB2, 1n+Nat.double(j)), kl, U32.is_eq(a, 0)), W32.nth0($TB2, Nat.double(j)), wj, IA.w_other(tb, e, w, l, j, hne)), Equal.cong(U32, B.Bk, a => TB.dec_c(wj, a, kl, U32.is_eq(wj, 0)), W32.nth0($TB2, 1n+Nat.double(j)), W32.nth0(tb, 1n+Nat.double(j)), IA.l_other(tb, e, w, l, j, hne)))

def d_at(+tb: List<&2, U32>, +kl: List<&2, String>, +e: Nat, +w: U32, +l: U32, +htb: {Nat.is_lt(1n+Nat.double(e), SC.length(U32, tb)) $TT) -> {TB.dec($TB2, kl, e) == TB.dec_c(w, l, kl, U32.is_eq(w, 0)) : B.Bk}:
  Equal.trans(B.Bk, TB.dec($TB2, kl, e), TB.dec_c(w, W32.nth0($TB2, 1n+Nat.double(e)), kl, U32.is_eq(w, 0)), TB.dec_c(w, l, kl, U32.is_eq(w, 0)), Equal.cong(U32, B.Bk, a => TB.dec_c(a, W32.nth0($TB2, 1n+Nat.double(e)), kl, U32.is_eq(a, 0)), W32.nth0($TB2, Nat.double(e)), w, IA.w_same(tb, e, w, l, htb)), Equal.cong(U32, B.Bk, a => TB.dec_c(w, a, kl, U32.is_eq(w, 0)), W32.nth0($TB2, 1n+Nat.double(e)), l, IA.l_same(tb, e, w, l, htb)))

%def DP +tb: List<&2, U32>, +kl: List<&2, String>, +e: Nat, +w: U32, +l: U32, +n: Nat
%def DA tb, kl, e, w, l, n

def d_same($DP, +m: Nat, +i: Nat, +hei: {Nat.is_lt(e, i) $TT) -> {TB.dlist($TB2, kl, m, i) == TB.dlist(tb, kl, m, i) : List<&2, B.Bk>}:
  match m:
    case 0n:
      {==}
    case 1n+p:
      IA.con_eq(TB.dec($TB2, kl, i), TB.dec(tb, kl, i), TB.dlist($TB2, kl, p, 1n+i), TB.dlist(tb, kl, p, 1n+i), d_other(tb, kl, e, w, l, i, N.is_eq_lt(e, i, hei)), d_same($DA, p, 1n+i, N.lt_trans(e, i, 1n+i, hei, N.lt_succ(i))))

def d_ins($DP, +htb: {Nat.is_lt(1n+Nat.double(e), SC.length(U32, tb)) $TT, +m: Nat, +i: Nat, +d: Nat, +hed: {Nat.add(i, d) == e : Nat}) -> {TB.dlist($TB2, kl, m, i) == IM.bupd(TB.dlist(tb, kl, m, i), d, TB.dec_c(w, l, kl, U32.is_eq(w, 0))) : List<&2, B.Bk>}:
  match m d:
    case 0n _:
      {==}
    case 1n+p 0n:
      +hie = Equal.trans(Nat, i, Nat.add(i, 0n), e, Equal.sym(Nat, Nat.add(i, 0n), i, N.add_zero(i)), hed)
      +h0 = L.subst(Nat, z => {TB.dec($TB2, kl, z) == TB.dec_c(w, l, kl, U32.is_eq(w, 0)) : B.Bk}, e, i, Equal.sym(Nat, i, e, hie), d_at(tb, kl, e, w, l, htb))
      +hei = L.subst(Nat, z => {Nat.is_lt(z, 1n+i) $TT, i, e, hie, N.lt_succ(i))
      IA.con_eq(TB.dec($TB2, kl, i), TB.dec_c(w, l, kl, U32.is_eq(w, 0)), TB.dlist($TB2, kl, p, 1n+i), TB.dlist(tb, kl, p, 1n+i), h0, d_same($DA, p, 1n+i, hei))
    case 1n+p 1n+q:
      +he1 = Equal.trans(Nat, Nat.add(1n+i, q), Nat.add(i, 1n+q), e, Equal.sym(Nat, Nat.add(i, 1n+q), 1n+Nat.add(i, q), N.add_succ(i, q)), hed)
      +hlt = L.subst(Nat, z => {Nat.is_lt(i, z) $TT, Nat.add(1n+i, q), e, he1, N.le_lt_succ(i, Nat.add(i, q), N.le_add_right(i, q)))
      IA.con_eq(TB.dec($TB2, kl, i), TB.dec(tb, kl, i), TB.dlist($TB2, kl, p, 1n+i), IM.bupd(TB.dlist(tb, kl, p, 1n+i), q, TB.dec_c(w, l, kl, U32.is_eq(w, 0))), d_other(tb, kl, e, w, l, i, N.is_eq_sym_false(i, e, N.is_eq_lt(i, e, hlt))), d_ins($DA, htb, p, 1n+i, q, he1))

# THEOREM: writing (w, l) into bucket e decodes as bucket e replaced
def put_dec($DP, +htb: {Nat.is_lt(1n+Nat.double(e), SC.length(U32, tb)) $TT) -> {TB.buckets($TB2, kl, n) == IM.bupd(TB.buckets(tb, kl, n), e, TB.dec_c(w, l, kl, U32.is_eq(w, 0))) : List<&2, B.Bk>}:
  d_ins($DA, htb, n, 0n, e, {==})

