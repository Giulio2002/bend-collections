def dinv($FP, st: DSt) -> Bool:
  match st:
    case DS{+iU, +h, +kU, +dk, +T}:
      dinvF($FA, iU, h, kU, dk, T)

def dfuel(+bp: Nat, +e0: Nat, +f: Nat, st: DSt) -> Bool:
  match st:
    case DS{iU, +h, kU, +dk, T}:
      Nat.is_lt(M.dist($NR, h, e0), Nat.add(dk, f))

%def VF TB.buckets(AR.slots(U32, Tf), kl, $NR)

