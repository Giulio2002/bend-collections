# THEOREM: deleting bucket i of a clustered table with a free bucket leaves a
# clustered table of copies of the other buckets
def del_ok($DP0, +hem: {Nat.is_lt(IV.occn($OB, $NR), $NR) $TT) -> DelAt(kl, K, bp, OT, i):
  d_e0($DA0, IV.find_empty($OB, $NR, hem))
