%def OB TB.buckets(AR.slots(U32, OT), kl, $NR)
%def V0B IM.bupd($OB, i, B.BE{})
%def IU U32.from_nat(i)
%def KU H.bnext($IU, $MK)
%def DP0 $O, +K: Nat, +hK: {Nat.is_lt(K, 31n) $TT, +bp: Nat, +hN: {1n+bp == SC.pow2(K) : Nat}, +kl: List<&2, String>, +OT: AR.Tree<U32>, +pot: {AR.perfect(U32, 1n+K, OT) $TT, +i: Nat, +hi: {Nat.is_lt(i, $NR) $TT, +cl: {B.cluster($OB, $NR, $MK) $TT, +huo: {B.all_lt(B.PUniq{$OB}, $NR) $TT, +hoi: {B.occ(B.at($OB, i)) $TT
%def DA0 one, h1, K, hK, bp, hN, kl, OT, pot, i, hi, cl, huo, hoi

def DelAt(+kl: List<&2, String>, +K: Nat, +bp: Nat, +OT: AR.Tree<U32>, +i: Nat) -> Type:
  Sigma<&1, &1, AR.Tree<U32>, Tf => {H.del_at(AR.thaw(U32, OT), $MK, $IU) == AR.thaw(U32, Tf) : Array<U32>} & {dfin(kl, K, bp, $V0B, Tf) $TT>

def d_hiK($DP0) -> {Nat.is_lt(i, SC.pow2(K)) $TT:
  L.subst(Nat, z => {Nat.is_lt(i, z) $TT, $NR, SC.pow2(K), hN, hi)

def d_ev($DP0) -> {UD.v($IU) == i : Nat}:
  U.to_nat_from_nat(i, K, N.lt_le(K, 32n, N.lt_trans(K, 31n, 32n, hK, {==})), d_hiK($DA0))

def d_hlen($DP0) -> {Nat.is_lt(i, SC.length(B.Bk, $OB)) $TT:
  L.subst(Nat, z => {Nat.is_lt(i, z) $TT, $NR, SC.length(B.Bk, $OB), Equal.sym(Nat, SC.length(B.Bk, $OB), $NR, IA.len_dlist(AR.slots(U32, OT), kl, $NR, 0n)), hi)

def d_kv($DP0) -> {UD.v($KU) == M.pos($NR, i, 1n) : Nat}:
