  Equal.trans(Nat, UD.v($KU), Nat.mod(1n+UD.v($IU), WD.sc(K, one)), M.pos($NR, i, 1n), CY.next_val(one, h1, K, $IU, hks, hil), Equal.trans(Nat, Nat.mod(1n+UD.v($IU), WD.sc(K, one)), Nat.mod(1n+i, $NR), M.pos($NR, i, 1n), Equal.trans(Nat, Nat.mod(1n+UD.v($IU), WD.sc(K, one)), Nat.mod(1n+UD.v($IU), $NR), Nat.mod(1n+i, $NR), Equal.cong(Nat, Nat, z => Nat.mod(1n+UD.v($IU), z), WD.sc(K, one), $NR, scn), Equal.cong(Nat, Nat, z => Nat.mod(1n+z, $NR), UD.v($IU), i, d_ev($DA0))), Equal.cong(Nat, Nat, z => Nat.mod(z, $NR), 1n+i, Nat.add(i, 1n), Equal.sym(Nat, Nat.add(i, 1n), 1n+i, N.add_comm(i, 1n)))))

def z0_c(+O: List<&2, B.Bk>, +i: Nat, +e0: Nat, +hz0: {B.at(O, e0) == B.BE{} : B.Bk}, +hlen: {Nat.is_lt(i, SC.length(B.Bk, O)) $TT, +c: Bool, +hc: {Nat.is_eq(i, e0) == c : Bool}) -> {Bool.not(B.occ(B.at(IM.bupd(O, i, B.BE{}), e0))) $TT:
