# ---- dispatch and loop ----

def step_mvc($GP, $SI, +p: Nat, $FU, $HCF, +m: Bool, +hm: {$MVB == m : Bool}, $REC) -> DelOK(kl, K, bp, V0, 1n+p, iU, kU, T):
  match m:
    case True{}:
      step_move($GA, $SIA, p, hfu, hc, hm, rec)
    case False{}:
      step_skip($GA, $SIA, p, hfu, hc, hm, rec)

def step_c($GP, $SI, +p: Nat, $FU, +c: Bool, +hc: {U32.is_eq($W, 0) == c : Bool}, $REC) -> DelOK(kl, K, bp, V0, 1n+p, iU, kU, T):
  match c:
    case True{}:
      step_end($GA, $SIA, p, hc)
    case False{}:
      step_mvc($GA, $SIA, p, hfu, hc, $MVB, {==}, rec)

# THEOREM: the backward shift, run with enough fuel, ends with whole clusters
def loop($GP, +f: Nat, +st: DSt, +hi: {dinv($FA, st) $TT, +hfu: {dfuel(bp, e0, f, st) $TT) -> DelOKs(kl, K, bp, V0, f, st):
