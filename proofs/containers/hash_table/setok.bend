      SI.set_room(~V, one, h1, n, k, td, fresh, sz, sd, sdU, free, tabT, K2, vsT, nxT, hg2(~V, one, h1, n, k, td, fresh, sz, sd, sdU, free, tabT, ksT, vsT, nxT, hg, cap, hc30, hcap, key, x, K2, hsl2, pk2), key, x, e, he, hz, hp, hno, hf, hc, cap, hc30, hcap)
    case False{}:
      SI.set_arena(~V, one, h1, n, k, td, fresh, sz, sd, sdU, free, tabT, K2, vsT, nxT, hg2(~V, one, h1, n, k, td, fresh, sz, sd, sdU, free, tabT, ksT, vsT, nxT, hg, cap, hc30, hcap, key, x, K2, hsl2, pk2), key, x, e, he, hz, hp, hno, hf, hc, cap, hc30, hcap)

