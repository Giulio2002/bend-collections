# Backward-shift deletion at the bucket level. While the gap left by the
# removed bucket travels forward, every full bucket's path is full except
# possibly at the gap h, and only buckets at least dk past h have paths
# through h. When the scan meets an empty bucket, no path goes through the
# gap, so the clusters are whole again.

%def TT == True{} : Bool}
%def FF == False{} : Bool}
%def NR 1n+bp
%def KP +K: Nat, +bp: Nat, +hN: {1n+bp == SC.pow2(K) : Nat}
%def KA K, bp, hN
%def MK CY.msk(K)

def hb_lt($KP, +b: B.Bk) -> {Nat.is_lt(B.hb($MK, b), $NR) $TT:
  match b:
    case B.BE{}:
      N.succ_le_lt(0n, $NR, N.zero_le(bp))
    case B.BF{+w, l, k}:
      L.subst(Nat, z => {Nat.is_lt(UD.v(HS.bucket(w, $MK)), z) $TT, SC.pow2(K), $NR, Equal.sym(Nat, $NR, SC.pow2(K), hN), PA.home_lt(w, K))

# ---- paths full except at h ----

def ox_c(+bs: List<&2, B.Bk>, +n: Nat, +a: Nat, +h: Nat, +q: Nat, +hp: {Bool.and(Bool.or(Nat.is_eq(h, M.pos(n, a, q)), B.occ(B.at(bs, M.pos(n, a, q)))), B.opx(bs, n, a, q, h)) $TT, +t: Nat, +ht: {Nat.is_lt(t, 1n+q) $TT, +c: Bool, +hc: {Nat.is_eq(t, q) == c : Bool}, rec: @hlt: {Nat.is_lt(t, q) $TT -> {Bool.or(Nat.is_eq(h, M.pos(n, a, t)), B.occ(B.at(bs, M.pos(n, a, t)))) $TT) -> {Bool.or(Nat.is_eq(h, M.pos(n, a, t)), B.occ(B.at(bs, M.pos(n, a, t)))) $TT:
  match c:
    case True{}:
      L.subst(Nat, z => {Bool.or(Nat.is_eq(h, M.pos(n, a, z)), B.occ(B.at(bs, M.pos(n, a, z)))) $TT, q, t, Equal.sym(Nat, t, q, N.eq_from_is_eq(t, q, hc)), L.and_left(Bool.or(Nat.is_eq(h, M.pos(n, a, q)), B.occ(B.at(bs, M.pos(n, a, q)))), B.opx(bs, n, a, q, h), hp))
    case False{}:
      rec(N.lt_or_eq(t, q, N.lt_succ_le(t, q, ht), hc))

def opx_inst(+bs: List<&2, B.Bk>, +n: Nat, +a: Nat, +m: Nat, +h: Nat, +hp: {B.opx(bs, n, a, m, h) $TT, +t: Nat, +ht: {Nat.is_lt(t, m) $TT) -> {Bool.or(Nat.is_eq(h, M.pos(n, a, t)), B.occ(B.at(bs, M.pos(n, a, t)))) $TT:
  match m:
    case 0n:
      Empty.absurd({Bool.or(Nat.is_eq(h, M.pos(n, a, t)), B.occ(B.at(bs, M.pos(n, a, t)))) $TT, N.lt_zero_absurd(t, ht))
    case 1n+q:
      ox_c(bs, n, a, h, q, hp, t, ht, Nat.is_eq(t, q), {==}, hlt => opx_inst(bs, n, a, q, h, L.and_right(Bool.or(Nat.is_eq(h, M.pos(n, a, q)), B.occ(B.at(bs, M.pos(n, a, q)))), B.opx(bs, n, a, q, h), hp), t, hlt))

def opx_pre(+bs: List<&2, B.Bk>, +n: Nat, +a: Nat, +m: Nat, +h: Nat, +hp: {B.opx(bs, n, a, m, h) $TT, +m2: Nat, +hm: {Nat.is_le(m2, m) $TT) -> {B.opx(bs, n, a, m2, h) $TT:
  match m2:
    case 0n:
      {==}
    case 1n+s:
      +hs = N.succ_le_lt(s, m, hm)
      L.and_intro(Bool.or(Nat.is_eq(h, M.pos(n, a, s)), B.occ(B.at(bs, M.pos(n, a, s)))), B.opx(bs, n, a, s, h), opx_inst(bs, n, a, m, h, hp, s, hs), opx_pre(bs, n, a, m, h, hp, s, N.lt_le(s, m, hs)))

def or_f(+x: Bool, +y: Bool, +h: {Bool.or(x, y) $TT, +hx: {x $FF) -> {y $TT:
  L.subst(Bool, z => {Bool.or(z, y) $TT, x, False{}, hx, h)

# a path that does not reach h is full
def occ_of_opx(+bs: List<&2, B.Bk>, +bp: Nat, +a: Nat, +ha: {Nat.is_lt(a, $NR) $TT, +h: Nat, +m: Nat, +hm: {Nat.is_le(m, $NR) $TT, +hp: {B.opx(bs, $NR, a, m, h) $TT, +hn: {Nat.is_lt(M.dist($NR, a, h), m) $FF) -> {B.occpath(bs, $NR, a, m) $TT:
  match m:
    case 0n:
      {==}
    case 1n+s:
      +d = M.dist($NR, a, h)
      +hd = N.not_lt_le(d, 1n+s, hn)
      +hsd = N.lt_le_trans(s, 1n+s, d, N.lt_succ(s), hd)
      +hne = N.is_eq_sym_false(M.pos($NR, a, s), h, RG.pos_ne(bp, a, s, h, ha, N.lt_le_trans(s, 1n+s, $NR, N.lt_succ(s), hm), N.is_eq_lt(s, d, hsd)))
      +x = Bool.or(Nat.is_eq(h, M.pos($NR, a, s)), B.occ(B.at(bs, M.pos($NR, a, s))))
      L.and_intro(B.occ(B.at(bs, M.pos($NR, a, s))), B.occpath(bs, $NR, a, s), or_f(Nat.is_eq(h, M.pos($NR, a, s)), B.occ(B.at(bs, M.pos($NR, a, s))), L.and_left(x, B.opx(bs, $NR, a, s, h), hp), hne), occ_of_opx(bs, bp, a, ha, h, s, N.lt_le(s, $NR, N.lt_le_trans(s, 1n+s, $NR, N.lt_succ(s), hm)), L.and_right(x, B.opx(bs, $NR, a, s, h), hp), N.le_not_lt(d, s, N.lt_le(s, d, hsd))))

def ooc_bit(+bs: List<&2, B.Bk>, +i: Nat, +p: Nat, +ho: {B.occ(B.at(bs, p)) $TT, +c: Bool, +hc: {Nat.is_eq(i, p) == c : Bool}) -> {Bool.or(c, B.occ(B.at(IM.bupd(bs, i, B.BE{}), p))) $TT:
  match c:
    case True{}:
      {==}
    case False{}:
      L.subst(B.Bk, y => {Bool.or(False{}, B.occ(y)) $TT, B.at(bs, p), B.at(IM.bupd(bs, i, B.BE{}), p), Equal.sym(B.Bk, B.at(IM.bupd(bs, i, B.BE{}), p), B.at(bs, p), IM.at_bupd_other(bs, i, B.BE{}, p, hc)), ho)

# emptying bucket i leaves every full path full except at i
def opx_of_occ(+bs: List<&2, B.Bk>, +i: Nat, +n: Nat, +a: Nat, +m: Nat, +hp: {B.occpath(bs, n, a, m) $TT) -> {B.opx(IM.bupd(bs, i, B.BE{}), n, a, m, i) $TT:
  match m:
    case 0n:
      {==}
    case 1n+s:
      +p = M.pos(n, a, s)
      L.and_intro(Bool.or(Nat.is_eq(i, p), B.occ(B.at(IM.bupd(bs, i, B.BE{}), p))), B.opx(IM.bupd(bs, i, B.BE{}), n, a, s, i), L.subst(Bool, c => {Bool.or(c, B.occ(B.at(IM.bupd(bs, i, B.BE{}), p))) $TT, Nat.is_eq(i, p), Nat.is_eq(i, p), {==}, ooc_bit(bs, i, p, L.and_left(B.occ(B.at(bs, p)), B.occpath(bs, n, a, s), hp), Nat.is_eq(i, p), {==})), opx_of_occ(bs, i, n, a, s, L.and_right(B.occ(B.at(bs, p)), B.occpath(bs, n, a, s), hp)))

# ---- moving bucket k into the gap h ----

%def VM IM.bupd(IM.bupd(V, k, B.BE{}), h, b)
%def MVP +V: List<&2, B.Bk>, +h: Nat, +k: Nat, +b: B.Bk, +hbo: {B.occ(b) $TT, +hlen: {Nat.is_lt(h, SC.length(B.Bk, V)) $TT
%def MVA V, h, k, b, hbo, hlen

def hlen2($MVP) -> {Nat.is_lt(h, SC.length(B.Bk, IM.bupd(V, k, B.BE{}))) $TT:
  L.subst(Nat, z => {Nat.is_lt(h, z) $TT, SC.length(B.Bk, V), SC.length(B.Bk, IM.bupd(V, k, B.BE{})), Equal.sym(Nat, SC.length(B.Bk, IM.bupd(V, k, B.BE{})), SC.length(B.Bk, V), RG.len_bupd(V, k, B.BE{})), hlen)

def mv_h2($MVP, +p: Nat, +c: Bool, +hc: {Nat.is_eq(h, p) == c : Bool}, +hold: {Bool.or(c, B.occ(B.at(V, p))) $TT, +hck: {Nat.is_eq(k, p) $FF) -> {Bool.or(False{}, B.occ(B.at($VM, p))) $TT:
  match c:
    case True{}:
      L.subst(B.Bk, y => {B.occ(y) $TT, b, B.at($VM, p), Equal.sym(B.Bk, B.at($VM, p), b, IM.at_bu_eq(IM.bupd(V, k, B.BE{}), h, b, hlen2($MVA), p, hc)), hbo)
    case False{}:
      L.subst(B.Bk, y => {B.occ(y) $TT, B.at(V, p), B.at($VM, p), Equal.sym(B.Bk, B.at($VM, p), B.at(V, p), Equal.trans(B.Bk, B.at($VM, p), B.at(IM.bupd(V, k, B.BE{}), p), B.at(V, p), IM.at_bupd_other(IM.bupd(V, k, B.BE{}), h, b, p, hc), IM.at_bupd_other(V, k, B.BE{}, p, hck))), hold)

def mv_h($MVP, +p: Nat, +c: Bool, +hc: {Nat.is_eq(h, p) == c : Bool}, +hold: {Bool.or(c, B.occ(B.at(V, p))) $TT, +ck: Bool, +hck: {Nat.is_eq(k, p) == ck : Bool}) -> {Bool.or(ck, B.occ(B.at($VM, p))) $TT:
  match ck:
    case True{}:
      {==}
    case False{}:
      mv_h2($MVA, p, c, hc, hold, hck)

# THEOREM: after the move, paths are full except at the new gap k
def opx_move($MVP, +n: Nat, +a: Nat, +m: Nat, +hp: {B.opx(V, n, a, m, h) $TT) -> {B.opx($VM, n, a, m, k) $TT:
  match m:
    case 0n:
      {==}
    case 1n+s:
      +p = M.pos(n, a, s)
      +x = Bool.or(Nat.is_eq(h, p), B.occ(B.at(V, p)))
      L.and_intro(Bool.or(Nat.is_eq(k, p), B.occ(B.at($VM, p))), B.opx($VM, n, a, s, k), mv_h($MVA, p, Nat.is_eq(h, p), {==}, L.and_left(x, B.opx(V, n, a, s, h), hp), Nat.is_eq(k, p), {==}), opx_move($MVA, n, a, s, L.and_right(x, B.opx(V, n, a, s, h), hp)))

# ---- more ring facts ----

# a path from a through h to j: its length splits at h
def dist_split2(+bp: Nat, +a: Nat, +h: Nat, +j: Nat, +ha: {Nat.is_lt(a, $NR) $TT, +hh: {Nat.is_lt(h, $NR) $TT, +hj: {Nat.is_lt(j, $NR) $TT, +hlt: {Nat.is_lt(M.dist($NR, a, h), M.dist($NR, a, j)) $TT) -> {Nat.add(M.dist($NR, a, h), M.dist($NR, h, j)) == M.dist($NR, a, j) : Nat}:
  +x = M.dist($NR, a, h)
  +m = M.dist($NR, a, j)
  +r = Nat.sub(m, x)
  +exr = N.sub_add(m, x, N.lt_le(x, m, hlt))
  +hr = N.le_lt_trans(r, m, $NR, L.subst(Nat, z => {Nat.is_le(r, z) $TT, Nat.add(r, x), m, Equal.trans(Nat, Nat.add(r, x), Nat.add(x, r), m, N.add_comm(r, x), exr), N.le_add_right(r, x)), M.dist_lt(bp, a, j))
  +pj = Equal.trans(Nat, M.pos($NR, h, r), M.pos($NR, M.pos($NR, a, x), r), j, Equal.cong(Nat, Nat, z => M.pos($NR, z, r), h, M.pos($NR, a, x), Equal.sym(Nat, M.pos($NR, a, x), h, M.pos_dist(bp, a, h, ha, hh))), Equal.trans(Nat, M.pos($NR, M.pos($NR, a, x), r), M.pos($NR, a, Nat.add(x, r)), j, RG.pos_add(bp, a, x, r), Equal.trans(Nat, M.pos($NR, a, Nat.add(x, r)), M.pos($NR, a, m), j, Equal.cong(Nat, Nat, z => M.pos($NR, a, z), Nat.add(x, r), m, exr), M.pos_dist(bp, a, j, ha, hj))))
  +dr = Equal.trans(Nat, M.dist($NR, h, j), M.dist($NR, h, M.pos($NR, h, r)), r, Equal.cong(Nat, Nat, z => M.dist($NR, h, z), j, M.pos($NR, h, r), Equal.sym(Nat, M.pos($NR, h, r), j, pj)), M.dist_pos(bp, h, r, hh, hr))
  Equal.trans(Nat, Nat.add(x, M.dist($NR, h, j)), Nat.add(x, r), m, Equal.cong(Nat, Nat, z => Nat.add(x, z), M.dist($NR, h, j), r, dr), exr)

def dp_c(+bp: Nat, +i: Nat, +j: Nat, +hi: {Nat.is_lt(i, $NR) $TT, +hj: {Nat.is_lt(j, $NR) $TT, +hne: {Nat.is_eq(i, j) $FF, +d: Nat, +hd: {M.dist($NR, i, j) == d : Nat}) -> {Nat.is_le(1n, d) $TT:
  match d:
    case 0n:
      +e = RG.eq_of_dist0(bp, i, j, hi, hj, hd)
      Empty.absurd({Nat.is_le(1n, 0n) $TT, L.true_false(Equal.trans(Bool, True{}, Nat.is_eq(i, j), False{}, Equal.sym(Bool, Nat.is_eq(i, j), True{}, IS.eq_is_eq(i, j, e)), hne)))
    case 1n+p:
      N.zero_le(p)

# distinct buckets are at least one step apart
def dist_pos1(+bp: Nat, +i: Nat, +j: Nat, +hi: {Nat.is_lt(i, $NR) $TT, +hj: {Nat.is_lt(j, $NR) $TT, +hne: {Nat.is_eq(i, j) $FF) -> {Nat.is_le(1n, M.dist($NR, i, j)) $TT:
  dp_c(bp, i, j, hi, hj, hne, M.dist($NR, i, j), {==})

# ---- the hole invariant: start ----

%def HOLEB B.implies(B.occ(x), Bool.and(B.opx(V, $NR, B.hb($MK, x), M.dist($NR, B.hb($MK, x), j), h), B.implies(Nat.is_lt(M.dist($NR, B.hb($MK, x), h), M.dist($NR, B.hb($MK, x), j)), Nat.is_le(dk, M.dist($NR, h, j)))))

def h0_o(+O: List<&2, B.Bk>, $KP, +i: Nat, +hi: {Nat.is_lt(i, $NR) $TT, +j: Nat, +hj: {Nat.is_lt(j, $NR) $TT, +hij: {Nat.is_eq(i, j) $FF, +x: B.Bk, +hx: {B.implies(B.occ(x), B.occpath(O, $NR, B.hb($MK, x), M.dist($NR, B.hb($MK, x), j))) $TT, +o: Bool, +ho: {B.occ(x) == o : Bool}) -> {B.implies(o, Bool.and(B.opx(IM.bupd(O, i, B.BE{}), $NR, B.hb($MK, x), M.dist($NR, B.hb($MK, x), j), i), B.implies(Nat.is_lt(M.dist($NR, B.hb($MK, x), i), M.dist($NR, B.hb($MK, x), j)), Nat.is_le(1n, M.dist($NR, i, j))))) $TT:
  match o:
    case False{}:
      {==}
    case True{}:
      +op = B.imp_elim(B.occ(x), B.occpath(O, $NR, B.hb($MK, x), M.dist($NR, B.hb($MK, x), j)), hx, ho)
      L.and_intro(B.opx(IM.bupd(O, i, B.BE{}), $NR, B.hb($MK, x), M.dist($NR, B.hb($MK, x), j), i), B.implies(Nat.is_lt(M.dist($NR, B.hb($MK, x), i), M.dist($NR, B.hb($MK, x), j)), Nat.is_le(1n, M.dist($NR, i, j))), opx_of_occ(O, i, $NR, B.hb($MK, x), M.dist($NR, B.hb($MK, x), j), op), RH.imp_true(Nat.is_lt(M.dist($NR, B.hb($MK, x), i), M.dist($NR, B.hb($MK, x), j)), Nat.is_le(1n, M.dist($NR, i, j)), dist_pos1(bp, i, j, hi, hj, hij)))

%def V0 IM.bupd(O, i, B.BE{})

def h0_i(+O: List<&2, B.Bk>, $KP, +i: Nat, +hi: {Nat.is_lt(i, $NR) $TT, +hlen: {Nat.is_lt(i, SC.length(B.Bk, O)) $TT, +cl: {B.cluster(O, $NR, $MK) $TT, +j: Nat, +hj: {Nat.is_lt(j, $NR) $TT, +c: Bool, +hc: {Nat.is_eq(i, j) == c : Bool}) -> {B.eval(B.PHole{$V0, $NR, $MK, i, 1n}, j) $TT:
  match c:
    case True{}:
      L.subst(B.Bk, y => {B.implies(B.occ(y), Bool.and(B.opx($V0, $NR, B.hb($MK, y), M.dist($NR, B.hb($MK, y), j), i), B.implies(Nat.is_lt(M.dist($NR, B.hb($MK, y), i), M.dist($NR, B.hb($MK, y), j)), Nat.is_le(1n, M.dist($NR, i, j))))) $TT, B.BE{}, B.at($V0, j), Equal.sym(B.Bk, B.at($V0, j), B.BE{}, IM.at_bu_eq(O, i, B.BE{}, hlen, j, hc)), {==})
    case False{}:
      +x = B.at(O, j)
      L.subst(B.Bk, y => {B.implies(B.occ(y), Bool.and(B.opx($V0, $NR, B.hb($MK, y), M.dist($NR, B.hb($MK, y), j), i), B.implies(Nat.is_lt(M.dist($NR, B.hb($MK, y), i), M.dist($NR, B.hb($MK, y), j)), Nat.is_le(1n, M.dist($NR, i, j))))) $TT, x, B.at($V0, j), Equal.sym(B.Bk, B.at($V0, j), x, IM.at_bupd_other(O, i, B.BE{}, j, hc)), L.subst(Bool, o => {B.implies(o, Bool.and(B.opx($V0, $NR, B.hb($MK, x), M.dist($NR, B.hb($MK, x), j), i), B.implies(Nat.is_lt(M.dist($NR, B.hb($MK, x), i), M.dist($NR, B.hb($MK, x), j)), Nat.is_le(1n, M.dist($NR, i, j))))) $TT, B.occ(x), B.occ(x), {==}, h0_o(O, $KA, i, hi, j, hj, hc, x, B.all_inst(B.PClus{O, $NR, $MK}, $NR, cl, j, hj), B.occ(x), {==})))

# THEOREM: emptying a bucket of a clustered table starts the invariant
def hole_init(+O: List<&2, B.Bk>, $KP, +i: Nat, +hi: {Nat.is_lt(i, $NR) $TT, +hlen: {Nat.is_lt(i, SC.length(B.Bk, O)) $TT, +cl: {B.cluster(O, $NR, $MK) $TT, +m: Nat, +hm: {Nat.is_le(m, $NR) $TT) -> {B.all_lt(B.PHole{$V0, $NR, $MK, i, 1n}, m) $TT:
  match m:
    case 0n:
      {==}
    case 1n+q:
      +hq = N.succ_le_lt(q, $NR, hm)
      L.and_intro(B.eval(B.PHole{$V0, $NR, $MK, i, 1n}, q), B.all_lt(B.PHole{$V0, $NR, $MK, i, 1n}, q), h0_i(O, $KA, i, hi, hlen, cl, q, hq, Nat.is_eq(i, q), {==}), hole_init(O, $KA, i, hi, hlen, cl, q, N.lt_le(q, $NR, hq)))

# ---- the scan position ----

%def KK M.pos($NR, h, dk)
%def SCP $KP, +V: List<&2, B.Bk>, +h: Nat, +hh: {Nat.is_lt(h, $NR) $TT, +dk: Nat, +hd1: {Nat.is_le(1n, dk) $TT, +hdn: {Nat.is_lt(dk, $NR) $TT
%def SCA $KA, V, h, hh, dk, hd1, hdn

def dist_k($SCP) -> {M.dist($NR, h, $KK) == dk : Nat}:
  M.dist_pos(bp, h, dk, hh, hdn)

def hk_c($SCP, +c: Bool, +hc: {Nat.is_eq(h, $KK) == c : Bool}) -> {c $FF:
  match c:
    case False{}:
      {==}
    case True{}:
      +e = Equal.trans(Nat, 0n, M.dist($NR, h, h), dk, Equal.sym(Nat, M.dist($NR, h, h), 0n, RG.dist_self(bp, h, hh)), Equal.trans(Nat, M.dist($NR, h, h), M.dist($NR, h, $KK), dk, Equal.cong(Nat, Nat, z => M.dist($NR, h, z), h, $KK, N.eq_from_is_eq(h, $KK, hc)), dist_k($SCA)))
      Empty.absurd({True{} $FF, L.false_true(L.subst(Nat, z => {Nat.is_le(1n, z) $TT, dk, 0n, Equal.sym(Nat, 0n, dk, e), hd1)))

# the scan position is not the gap
def h_ne_k($SCP) -> {Nat.is_eq(h, $KK) $FF:
  hk_c($SCA, Nat.is_eq(h, $KK), {==})

# ---- end: the scan met an empty bucket ----

def e_bad($SCP, +hz: {B.occ(B.at(V, $KK)) $FF, +j: Nat, +hj: {Nat.is_lt(j, $NR) $TT, +hoj: {B.occ(B.at(V, j)) $TT, +hop: {B.opx(V, $NR, B.hb($MK, B.at(V, j)), M.dist($NR, B.hb($MK, B.at(V, j)), j), h) $TT, +hlt: {Nat.is_lt(M.dist($NR, B.hb($MK, B.at(V, j)), h), M.dist($NR, B.hb($MK, B.at(V, j)), j)) $TT, +hge: {Nat.is_le(dk, M.dist($NR, h, j)) $TT, +c3: Bool, +hc3: {Nat.is_eq(dk, M.dist($NR, h, j)) == c3 : Bool}) -> Empty:
  match c3:
    case True{}:
