def ig_1($PP, $HYG, $HOVT, +hk30: {Nat.is_lt(1n+k, 31n) $TT, gg: GR.GrowOK(tabT, $KL, k, sd, td)) -> IS.SetM(~V, $M0, key, x, $INS):
  match gg:
    case Tuple{+NT, Tuple{+eg, +hr}}:
      +r5 = N.eq_from_is_eq(IV.occn($NT2, $N2), IV.occn($BS, $NN), GR.r_5($GRA))
      +ob = L.subst(Nat, z => {Nat.is_le(Nat.double(z), $NN) $TT, UD.v(n), IV.occn($BS, $NN), N.eq_from_is_eq(UD.v(n), IV.occn($BS, $NN), hcn), hld)
      +hem = L.subst(Nat, z => {Nat.is_lt(z, $N2) $TT, IV.occn($BS, $NN), IV.occn($NT2, $N2), Equal.sym(Nat, IV.occn($NT2, $N2), IV.occn($BS, $NN), r5), N.le_lt_trans(IV.occn($BS, $NN), $NN, $N2, N.le_trans(IV.occn($BS, $NN), Nat.double(IV.occn($BS, $NN)), $NN, N.double_self_le(IV.occn($BS, $NN)), ob), N.pow2_lt_succ(k)))
      +pno = RH.pno_from($NT2, $BS, $NN, $N2, GR.r_6($GRA), key, IM.nohb_pno($BS, key, $NN, hno, $NN, N.le_refl($NN)), $N2, N.le_refl($N2))
      ig_2($PA, $HGA, hovi, hk30, NT, eg, hr, RI.find_e($NT2, $N2, N.succ_le_lt(0n, $N2, N.pow2_pos(1n+k)), CY.msk(1n+k), key, $HOMEg, PA.home_lt($W, 1n+k), GR.r_2($GRA), pno, hem))

# THEOREM: placing a new entry into a table that must grow refines set
def ins_grow($PP, $HYG, $CAP, $HOVT) -> IS.SetM(~V, $M0, key, x, $INS):
  +hk30 = k30($PA, $HGA, $CA, hovi)
  +ob = L.subst(Nat, z => {Nat.is_le(Nat.double(z), $NN) $TT, UD.v(n), IV.occn($BS, $NN), N.eq_from_is_eq(UD.v(n), IV.occn($BS, $NN), hcn), hld)
  ig_1($PA, $HGA, hovi, hk30, GR.grow_ok(one, h1, k, hk31, hk30, hk0, tabT, pt, $KL, sd, AR.slots_length(String, sd, ksT, pk), hwell, huq, ob, td, N.eq_from_is_eq(UD.v(td), 1n+k, htd)))

# ---- either way ----

%def HYA $HYG, +hcl: {B.cluster($BS, $NN, CY.msk(k)) $TT, +hsdk2: {Bool.or(Nat.is_lt(sd, k), $OVER) $TT, +he: {Nat.is_lt(e, $NN) $TT, +hz: {B.at($BS, e) == B.BE{} : B.Bk}, +hp: {B.occpath($BS, $NN, $HOME, M.dist($NN, $HOME, e)) $TT
%def HAA $HGA, hcl, hsdk2, he, hz, hp

def ia_c($PP, $HYA, $CAP, +c: Bool, +hc: {$OVER == c : Bool}) -> IS.SetM(~V, $M0, key, x, $INS):
  match c:
    case False{}:
      +h2 = L.subst(Bool, b => {Bool.or(Nat.is_lt(sd, k), b) $TT, $OVER, False{}, hc, hsdk2)
      +hsdk = Equal.trans(Bool, Nat.is_lt(sd, k), Bool.or(Nat.is_lt(sd, k), False{}), True{}, Equal.sym(Bool, Bool.or(Nat.is_lt(sd, k), False{}), Nat.is_lt(sd, k), WR.or_false(Nat.is_lt(sd, k))), h2)
      IS.ins_nogrow($PA, hk31, hk0, hsd, hsdk, pt, pk, pv, pn, htd, hsz, hsdu, hwell, hcl, huq, hcn, hld, hl, hfr, hnf, hfl, hs, hns, he, hz, hp, hno, hc)
    case True{}:
      ins_grow($PA, $HGA, $CA, hc)

# THEOREM: placing a new entry, whether or not the table grows, refines set
def ins_any($PP, $HYA, $CAP) -> IS.SetM(~V, $M0, key, x, $INS):
  ia_c($PA, $HAA, $CA, $OVER, {==})
