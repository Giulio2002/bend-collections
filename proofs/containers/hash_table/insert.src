    Equal.trans(List<&2, B.Bk>, $BS2, TB.buckets($TBU, AR.slots(String, $KS2), $NN), TB.buckets($TBU, $KLU, $NN), Equal.cong(List<&2, U32>, List<&2, B.Bk>, z => TB.buckets(z, AR.slots(String, $KS2), $NN), AR.slots(U32, $TAB2), $TBU, tab_slots($PA, $HA)), Equal.cong(List<&2, String>, List<&2, B.Bk>, z => TB.buckets($TBU, z, $NN), AR.slots(String, $KS2), $KLU, ks_slots($PA, $HA))),
    Equal.trans(List<&2, B.Bk>, TB.buckets($TBU, $KLU, $NN), IM.bupd($BS, e, B.BF{$W, $LK, TB.keyof($W, $SK)}), $BU, bp, Equal.cong(String, List<&2, B.Bk>, z => IM.bupd($BS, e, B.BF{$W, $LK, z}), TB.keyof($W, $SK), key, IA.keyof_stored(key))))

