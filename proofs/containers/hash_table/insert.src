    Equal.cong(Array<U32>, H.HashMap<&2, V>, a => H.HM{U32.inc(n), CY.msk(k), td, fr, sz, sdU, free, a, Array.set(String, AR.thaw(String, ksT), s, $SK), Array.set(Maybe<&2, V>, AR.thaw(Maybe<&2, V>, vsT), s, Some{x}), $na}, H.put_bucket(AR.thaw(U32, tabT), $AT, $W, $LK), $ta, tab_eq($PA, $HA)),
    Equal.trans(H.HashMap<&2, V>, H.HM{U32.inc(n), CY.msk(k), td, fr, sz, sdU, free, $ta, Array.set(String, AR.thaw(String, ksT), s, $SK), Array.set(Maybe<&2, V>, AR.thaw(Maybe<&2, V>, vsT), s, Some{x}), $na}, H.HM{U32.inc(n), CY.msk(k), td, fr, sz, sdU, free, $ta, $ka, Array.set(Maybe<&2, V>, AR.thaw(Maybe<&2, V>, vsT), s, Some{x}), $na}, ST.real(~V, $SH2),
      Equal.cong(Array<String>, H.HashMap<&2, V>, a => H.HM{U32.inc(n), CY.msk(k), td, fr, sz, sdU, free, $ta, a, Array.set(Maybe<&2, V>, AR.thaw(Maybe<&2, V>, vsT), s, Some{x}), $na}, Array.set(String, AR.thaw(String, ksT), s, $SK), $ka, ks_eq($PA, $HA)),
      Equal.cong(Array<Maybe<&2, V>>, H.HashMap<&2, V>, a => H.HM{U32.inc(n), CY.msk(k), td, fr, sz, sdU, free, $ta, $ka, a, $na}, Array.set(Maybe<&2, V>, AR.thaw(Maybe<&2, V>, vsT), s, Some{x}), $va, vs_eq($PA, $HA))))

# ---- the shadow's slot lists ----

%def TBU SC.update(U32, SC.update(U32, $TBL, Nat.double(e), $W), 1n+Nat.double(e), $LK)
