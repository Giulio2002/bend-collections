def eq_is_eq(+a: Nat, +b: Nat, +h: {a == b : Nat}) -> {Nat.is_eq(a, b) $TT:
  L.subst(Nat, z => {Nat.is_eq(a, z) $TT, a, b, h, N.is_eq_refl(a))

def kwnz_c(+c: U32, +t: String, +sh: Bool) -> {U32.is_eq(K.kw_c(c, t, sh), 0) $FF:
  match sh:
    case True{}:
      WR.short_nonzero(c)
    case False{}:
      WR.long_nonzero(STR.fold(SCon{Chr{c}, t}, 0))

# a key's word is never 0
def kword_nz(+key: String) -> {U32.is_eq(K.kword(key), 0) $FF:
  match key:
    case SNil{}:
      WR.long_nonzero(STR.fold(SNil{}, 0))
    case SCon{Chr{+c}, +t}:
      kwnz_c(c, t, K.short_c(c, t))

