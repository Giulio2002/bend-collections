# Placing a new entry: once its slot s is chosen and its bucket e is the
# empty bucket that ended its probe, and the table does not grow, the
# implementation's arrays are the shadow's with bucket e and slot s written,
# the invariant holds, and the model is the specification's set.

%def TT == True{} : Bool}
%def FF == False{} : Bool}
%def O +one: Nat, +h1: {one == 1n : Nat}
%def S32 WD.sc(32n, one)
%def PP ~V: Data, $O, +n: U32, +k: Nat, +td: U32, +fr: U32, +sz: U32, +sd: Nat, +sdU: U32, +free: U32, +tabT: AR.Tree<U32>, +ksT: AR.Tree<String>, +vsT: AR.Tree<Maybe<&2, V>>, +nxT: AR.Tree<U32>, +s: U32, +e: Nat, +key: String, +x: V
%def PA ~V, one, h1, n, k, td, fr, sz, sd, sdU, free, tabT, ksT, vsT, nxT, s, e, key, x
%def TBL AR.slots(U32, tabT)
%def KL AR.slots(String, ksT)
%def VSL AR.slots(Maybe<&2, V>, vsT)
%def NXL AR.slots(U32, nxT)
%def NN SC.pow2(k)
%def BS TB.buckets($TBL, $KL, $NN)
%def W K.kword(key)
%def SK PA.stored(key)
%def LK H.link(s)
%def AT U32.from_nat(e)
%def I1 UD.v(U32.shl($AT))
%def I2 UD.v(U32.inc(U32.shl($AT)))
%def T1 AR.upd(U32, 1n+k, tabT, $I1, $W)
%def TAB2 AR.upd(U32, 1n+k, $T1, $I2, $LK)
%def KS2 AR.upd(String, sd, ksT, UD.v(s), $SK)
%def VS2 AR.upd(Maybe<&2, V>, sd, vsT, UD.v(s), Some{x})
%def SH2 ST.HS{U32.inc(n), k, td, fr, sz, sd, sdU, free, $TAB2, $KS2, $VS2, nxT}
%def NB B.BF{$W, $LK, key}
%def BU IM.bupd($BS, e, $NB)
%def SLv UD.v(H.slot($LK))
%def ta AR.thaw(U32, $TAB2)
%def ka AR.thaw(String, $KS2)
%def va AR.thaw(Maybe<&2, V>, $VS2)
%def na AR.thaw(U32, nxT)
%def HOME UD.v(HS.bucket($W, CY.msk(k)))
%def HY +hk31: {Nat.is_lt(k, 31n) $TT, +hk0: {Nat.is_lt(0n, k) $TT, +hsd: {Nat.is_lt(sd, 32n) $TT, +hsdk: {Nat.is_lt(sd, k) $TT, +pt: {AR.perfect(U32, 1n+k, tabT) $TT, +pk: {AR.perfect(String, sd, ksT) $TT, +pv: {AR.perfect(Maybe<&2, V>, sd, vsT) $TT, +pn: {AR.perfect(U32, sd, nxT) $TT, +htd: {Nat.is_eq(UD.v(td), 1n+k) $TT, +hsz: {Nat.is_eq(UD.v(sz), SC.pow2(sd)) $TT, +hsdu: {Nat.is_eq(UD.v(sdU), sd) $TT, +hwell: {B.all_lt(B.PWell{$BS, sd}, $NN) $TT, +hcl: {B.cluster($BS, $NN, CY.msk(k)) $TT, +huq: {B.all_lt(B.PUniq{$BS}, $NN) $TT, +hcn: {Nat.is_eq(UD.v(n), IV.occn($BS, $NN)) $TT, +hld: {Nat.is_le(Nat.double(UD.v(n)), $NN) $TT, +hl: {B.all_lt(B.PLive{$BS, ST.lvs(~V, $VSL), UD.v(fr)}, $NN) $TT, +hfr: {Nat.is_le(UD.v(fr), UD.v(sz)) $TT, +hnf: {Nat.is_le(1n+UD.v(n), UD.v(fr)) $TT, +hfl: {ST.fl_ok($BS, $NN, $NXL, Nat.sub(UD.v(fr), 1n+UD.v(n)), free, UD.v(fr), Con{UD.v(s), Nil{}}) $TT, +hs: {Nat.is_lt(UD.v(s), UD.v(fr)) $TT, +hns: {ST.noslot($BS, UD.v(s), $NN) $TT, +he: {Nat.is_lt(e, $NN) $TT, +hz: {B.at($BS, e) == B.BE{} : B.Bk}, +hp: {B.occpath($BS, $NN, $HOME, M.dist($NN, $HOME, e)) $TT, +hno: {B.all_lt(B.PNo{$BS, key}, $NN) $TT
