def s32($PP, $HY) -> {Nat.is_lt(1n+UD.v(s), $S32) $TT:
  W32.bound32(one, h1, UD.v(s), sd, N.lt_trans(sd, k, 31n, hsdk, hk31), s_sd($PA, $HA))

# slot(link(s)) = s
def sl_eq($PP, $HY) -> {$SLv == UD.v(s) : Nat}:
  LK.slot_link(one, h1, s, s32($PA, $HA))

def ev($PP, $HY) -> {UD.v($AT) == e : Nat}:
