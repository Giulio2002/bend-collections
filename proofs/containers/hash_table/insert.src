  L.subst(Nat, z => {Nat.is_lt(z, SC.pow2(1n+k)) $TT, Nat.double(e), $I1, Equal.sym(Nat, $I1, Nat.double(e), ix1($PA, $HA)), N.lt_trans(Nat.double(e), 1n+Nat.double(e), SC.pow2(1n+k), N.lt_succ(Nat.double(e)), N.double_lt_bit(True{}, e, $NN, he)))

