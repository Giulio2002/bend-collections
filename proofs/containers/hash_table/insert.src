  +e4 = Equal.cong(Nat, List<&2, U32>, z => SC.update(U32, SC.update(U32, $TBL, Nat.double(e), $W), z, $LK), $I2, 1n+Nat.double(e), ix2($PA, $HA))
  Equal.trans(List<&2, U32>, AR.slots(U32, $TAB2), SC.update(U32, AR.slots(U32, $T1), $I2, $LK), $TBU, e1, Equal.trans(List<&2, U32>, SC.update(U32, AR.slots(U32, $T1), $I2, $LK), SC.update(U32, SC.update(U32, $TBL, $I1, $W), $I2, $LK), $TBU, e2, Equal.trans(List<&2, U32>, SC.update(U32, SC.update(U32, $TBL, $I1, $W), $I2, $LK), SC.update(U32, SC.update(U32, $TBL, Nat.double(e), $W), $I2, $LK), $TBU, e3, e4)))

