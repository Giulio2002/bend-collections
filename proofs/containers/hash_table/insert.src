def len_lt(-T: Data, +d: Nat, +t: AR.Tree<T>, +pf: {AR.perfect(T, d, t) $TT, +i: Nat, +h: {Nat.is_lt(i, SC.pow2(d)) $TT) -> {Nat.is_lt(i, SC.length(T, AR.slots(T, t))) $TT:
