# ---- the implementation's arrays ----

def tab_eq($PP, $HY) -> {H.put_bucket(AR.thaw(U32, tabT), $AT, $W, $LK) == AR.thaw(U32, $TAB2) : Array<U32>}:
  +p1 = AR.upd_perfect(U32, 1n+k, tabT, $I1, $W, pt)
  +s1 = AR.set(U32, 1n+k, tabT, U32.shl($AT), $W, W32.nth0($TBL, $I1), hk31, hi1($PA, $HA), W32.nth_some($TBL, $I1, len_lt(U32, 1n+k, tabT, pt, $I1, hi1($PA, $HA))), pt)
  +s2 = AR.set(U32, 1n+k, $T1, U32.inc(U32.shl($AT)), $LK, W32.nth0(AR.slots(U32, $T1), $I2), hk31, hi2($PA, $HA), W32.nth_some(AR.slots(U32, $T1), $I2, len_lt(U32, 1n+k, $T1, p1, $I2, hi2($PA, $HA))), p1)
  Equal.trans(Array<U32>, H.put_bucket(AR.thaw(U32, tabT), $AT, $W, $LK), Array.set(U32, AR.thaw(U32, $T1), U32.inc(U32.shl($AT)), $LK), AR.thaw(U32, $TAB2), Equal.cong(Array<U32>, Array<U32>, a => Array.set(U32, a, U32.inc(U32.shl($AT)), $LK), Array.set(U32, AR.thaw(U32, tabT), U32.shl($AT), $W), AR.thaw(U32, $T1), s1), s2)

def ks_eq($PP, $HY) -> {Array.set(String, AR.thaw(String, ksT), s, $SK) == AR.thaw(String, $KS2) : Array<String>}:
  AR.set(String, sd, ksT, s, $SK, TB.nths($KL, UD.v(s)), hsd, s_sd($PA, $HA), AX.nths_of(sd, ksT, UD.v(s), s_sd($PA, $HA), pk), pk)

def vs_eq($PP, $HY) -> {Array.set(Maybe<&2, V>, AR.thaw(Maybe<&2, V>, vsT), s, Some{x}) == AR.thaw(Maybe<&2, V>, $VS2) : Array<Maybe<&2, V>>}:
  AR.set(Maybe<&2, V>, sd, vsT, s, Some{x}, ST.nthm(~V, $VSL, UD.v(s)), hsd, s_sd($PA, $HA), ST.nthm_some(~V, $VSL, UD.v(s), len_lt(Maybe<&2, V>, sd, vsT, pv, UD.v(s), s_sd($PA, $HA))), pv)

# THEOREM: without growth, placing the entry builds the shadow's real map
