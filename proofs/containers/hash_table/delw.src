import Base
import ../../lib/logic.bend as L
import ../../lib/nat.bend as N
import ../../lib/array.bend as AR
import ../../../spec/lib/common.bend as SC
import ../../lib/u32div.bend as UD
import ../../../src/containers/hash_table.bend as H
import ./table.bend as TB
import ./buckets.bend as B
import ./cyc.bend as CY
import ./inv.bend as IV
import ./insm.bend as IM
import ./grow.bend as GR
import ./shift.bend as SH

# del_at, stated over the table's 2^k buckets.

%def TT == True{} : Bool}
%def FF == False{} : Bool}
%def NN SC.pow2(k)
%def MK CY.msk(k)
%def BP UD.v(CY.msk(k))
%def NR 1n+$BP
%def OB TB.buckets(AR.slots(U32, OT), kl, $NN)
%def OR TB.buckets(AR.slots(U32, OT), kl, $NR)
%def V0 IM.bupd($OB, i, B.BE{})
%def V0R IM.bupd($OR, i, B.BE{})
%def VF TB.buckets(AR.slots(U32, Tf), kl, $NN)
%def VFR TB.buckets(AR.slots(U32, Tf), kl, $NR)

def dfin2(+kl: List<&2, String>, +k: Nat, +V0: List<&2, B.Bk>, +Tf: AR.Tree<U32>) -> Bool:
  Bool.and(AR.perfect(U32, 1n+k, Tf), Bool.and(B.cluster($VF, $NN, $MK), Bool.and(B.all_lt(B.PUniq{$VF}, $NN), Bool.and(B.all_lt(B.PFrom{$VF, V0, $NN}, $NN), Bool.and(B.all_lt(B.PTo{V0, $VF, $NN}, $NN), Nat.is_eq(IV.occn($VF, $NN), IV.occn(V0, $NN)))))))

def DelAt2(+kl: List<&2, String>, +k: Nat, +OT: AR.Tree<U32>, +i: Nat) -> Type:
  Sigma<&1, &1, AR.Tree<U32>, Tf => {H.del_at(AR.thaw(U32, OT), $MK, U32.from_nat(i)) == AR.thaw(U32, Tf) : Array<U32>} & {dfin2(kl, k, $V0, Tf) $TT>

def hN(+k: Nat, +hk: {Nat.is_lt(k, 31n) $TT) -> {$NR == $NN : Nat}:
  Equal.trans(Nat, $NR, Nat.add($BP, 1n), $NN, N.add_comm(1n, $BP), GR.mskv(k, N.lt_le(k, 32n, N.lt_trans(k, 31n, 32n, hk, {==}))))

%def TO L.subst(Nat, z =>
%def FR , $NR, $NN, hN(k, hk31),

def d2_fin(+kl: List<&2, String>, +k: Nat, +hk31: {Nat.is_lt(k, 31n) $TT, +OT: AR.Tree<U32>, +i: Nat, d: SH.DelAt(kl, k, $BP, OT, i)) -> DelAt2(kl, k, OT, i):
  match d:
    case Tuple{+Tf, Tuple{+e1, +hd}}:
      +g1 = SH.f1(kl, k, $BP, $V0R, Tf, hd)
      +g2 = $TO {B.cluster(TB.buckets(AR.slots(U32, Tf), kl, z), z, $MK) $TT $FR SH.f2(kl, k, $BP, $V0R, Tf, hd))
      +g3 = $TO {B.all_lt(B.PUniq{TB.buckets(AR.slots(U32, Tf), kl, z)}, z) $TT $FR SH.f3(kl, k, $BP, $V0R, Tf, hd))
      +g4 = $TO {B.all_lt(B.PFrom{TB.buckets(AR.slots(U32, Tf), kl, z), IM.bupd(TB.buckets(AR.slots(U32, OT), kl, z), i, B.BE{}), z}, z) $TT $FR SH.f4(kl, k, $BP, $V0R, Tf, hd))
      +g5 = $TO {B.all_lt(B.PTo{IM.bupd(TB.buckets(AR.slots(U32, OT), kl, z), i, B.BE{}), TB.buckets(AR.slots(U32, Tf), kl, z), z}, z) $TT $FR SH.f5(kl, k, $BP, $V0R, Tf, hd))
      +g6 = $TO {Nat.is_eq(IV.occn(TB.buckets(AR.slots(U32, Tf), kl, z), z), IV.occn(IM.bupd(TB.buckets(AR.slots(U32, OT), kl, z), i, B.BE{}), z)) $TT $FR SH.f6(kl, k, $BP, $V0R, Tf, hd))
      (Tf, (e1, L.and_intro(AR.perfect(U32, 1n+k, Tf), Bool.and(B.cluster($VF, $NN, $MK), Bool.and(B.all_lt(B.PUniq{$VF}, $NN), Bool.and(B.all_lt(B.PFrom{$VF, $V0, $NN}, $NN), Bool.and(B.all_lt(B.PTo{$V0, $VF, $NN}, $NN), Nat.is_eq(IV.occn($VF, $NN), IV.occn($V0, $NN)))))), g1, L.and_intro(B.cluster($VF, $NN, $MK), Bool.and(B.all_lt(B.PUniq{$VF}, $NN), Bool.and(B.all_lt(B.PFrom{$VF, $V0, $NN}, $NN), Bool.and(B.all_lt(B.PTo{$V0, $VF, $NN}, $NN), Nat.is_eq(IV.occn($VF, $NN), IV.occn($V0, $NN))))), g2, L.and_intro(B.all_lt(B.PUniq{$VF}, $NN), Bool.and(B.all_lt(B.PFrom{$VF, $V0, $NN}, $NN), Bool.and(B.all_lt(B.PTo{$V0, $VF, $NN}, $NN), Nat.is_eq(IV.occn($VF, $NN), IV.occn($V0, $NN)))), g3, L.and_intro(B.all_lt(B.PFrom{$VF, $V0, $NN}, $NN), Bool.and(B.all_lt(B.PTo{$V0, $VF, $NN}, $NN), Nat.is_eq(IV.occn($VF, $NN), IV.occn($V0, $NN))), g4, L.and_intro(B.all_lt(B.PTo{$V0, $VF, $NN}, $NN), Nat.is_eq(IV.occn($VF, $NN), IV.occn($V0, $NN)), g5, g6)))))))

%def FB , $NN, $NR, Equal.sym(Nat, $NR, $NN, hN(k, hk31)),

# THEOREM: deleting a full bucket of a good table (2^k buckets, a free one)
def del_ok2(+k: Nat, +hk31: {Nat.is_lt(k, 31n) $TT, +kl: List<&2, String>, +OT: AR.Tree<U32>, +pot: {AR.perfect(U32, 1n+k, OT) $TT, +i: Nat, +hi: {Nat.is_lt(i, $NN) $TT, +cl: {B.cluster($OB, $NN, $MK) $TT, +huo: {B.all_lt(B.PUniq{$OB}, $NN) $TT, +hoi: {B.occ(B.at($OB, i)) $TT, +hem: {Nat.is_lt(IV.occn($OB, $NN), $NN) $TT) -> DelAt2(kl, k, OT, i):
  +hi2 = L.subst(Nat, z => {Nat.is_lt(i, z) $TT $FB hi)
  +cl2 = L.subst(Nat, z => {B.cluster(TB.buckets(AR.slots(U32, OT), kl, z), z, $MK) $TT $FB cl)
  +hu2 = L.subst(Nat, z => {B.all_lt(B.PUniq{TB.buckets(AR.slots(U32, OT), kl, z)}, z) $TT $FB huo)
  +ho2 = L.subst(Nat, z => {B.occ(B.at(TB.buckets(AR.slots(U32, OT), kl, z), i)) $TT $FB hoi)
  +he2 = L.subst(Nat, z => {Nat.is_lt(IV.occn(TB.buckets(AR.slots(U32, OT), kl, z), z), z) $TT $FB hem)
  d2_fin(kl, k, hk31, OT, i, SH.del_ok(1n, {==}, k, hk31, $BP, hN(k, hk31), kl, OT, pot, i, hi2, cl2, hu2, ho2, he2))
