def w_full($WP, $QP, +hc: {U32.is_eq($WQ, 0) $FF, +d: Bool, +hd: {H.is_short($WQ) == d : Bool}) -> WStep(tabT, kl, k, sd, q, kk, KT):
  match d:
    case True{}:
      w_short($WA, $QA, hc, hd)
    case False{}:
      w_long($WA, $QA, hc, hd)

def w_c($WP, $QP, +c: Bool, +hc: {U32.is_eq($WQ, 0) == c : Bool}) -> WStep(tabT, kl, k, sd, q, kk, KT):
  match c:
    case True{}:
      w_empty($WA, $QA, hc)
    case False{}:
      w_full($WA, $QA, hc, H.is_short($WQ), {==})

# THEOREM: one step of the walk prepends bucket q's key
def wstep($WP, $QP) -> WStep(tabT, kl, k, sd, q, kk, KT):
  w_c($WA, $QA, U32.is_eq($WQ, 0), {==})

%def FIN kb($BS, $NN, 0n)

def WalkOK(+tabT: AR.Tree<U32>, +kl: List<&2, String>, +k: Nat, +sd: Nat, +q: Nat, +kk: U32, +KT: AR.Tree<String>) -> Type:
  Sigma<&1, &1, AR.Tree<String>, K2 => {H.wk_go(1n+q, kk, $WK0) == H.WK{AR.thaw(U32, tabT), AR.thaw(String, K2), $FIN} : H.Walk} & ({AR.slots(String, K2) == kl : List<&2, String>} & {AR.perfect(String, sd, K2) $TT)>

def walk_0($WP, +kk: U32, +KT: AR.Tree<String>, st: WStep(tabT, kl, k, sd, 0n, kk, KT)) -> WalkOK(tabT, kl, k, sd, 0n, kk, KT):
  match st:
    case Tuple{+K2, Tuple{+e1, rest}}:
      (+hs2, pk2) = rest
      (K2, (Equal.trans(H.Walk, H.wk_step(kk, H.WK{AR.thaw(U32, tabT), AR.thaw(String, KT), kb($BS, Nat.sub($NN, 1n), 1n)}), H.WK{AR.thaw(U32, tabT), AR.thaw(String, K2), kb($BS, Nat.sub($NN, 0n), 0n)}, H.WK{AR.thaw(U32, tabT), AR.thaw(String, K2), $FIN}, e1, Equal.cong(Nat, H.Walk, z => H.WK{AR.thaw(U32, tabT), AR.thaw(String, K2), kb($BS, z, 0n)}, Nat.sub($NN, 0n), $NN, N.sub_zero($NN))), (hs2, pk2)))

def walk_s2($WP, +p: Nat, +kk: U32, +KT: AR.Tree<String>, +K2: AR.Tree<String>, +e1: {H.wk_step(kk, H.WK{AR.thaw(U32, tabT), AR.thaw(String, KT), kb($BS, Nat.sub($NN, 2n+p), 2n+p)}) == H.WK{AR.thaw(U32, tabT), AR.thaw(String, K2), kb($BS, Nat.sub($NN, 1n+p), 1n+p)} : H.Walk}, wo: WalkOK(tabT, kl, k, sd, p, U32.sub(kk, 1), K2)) -> WalkOK(tabT, kl, k, sd, 1n+p, kk, KT):
  match wo:
    case Tuple{+K3, Tuple{+e2, rest}}:
      (+hs3, pk3) = rest
      (K3, (Equal.trans(H.Walk, H.wk_go(2n+p, kk, H.WK{AR.thaw(U32, tabT), AR.thaw(String, KT), kb($BS, Nat.sub($NN, 2n+p), 2n+p)}), H.wk_go(1n+p, U32.sub(kk, 1), H.WK{AR.thaw(U32, tabT), AR.thaw(String, K2), kb($BS, Nat.sub($NN, 1n+p), 1n+p)}), H.WK{AR.thaw(U32, tabT), AR.thaw(String, K3), $FIN}, Equal.cong(H.Walk, H.Walk, w => H.wk_go(1n+p, U32.sub(kk, 1), w), H.wk_step(kk, H.WK{AR.thaw(U32, tabT), AR.thaw(String, KT), kb($BS, Nat.sub($NN, 2n+p), 2n+p)}), H.WK{AR.thaw(U32, tabT), AR.thaw(String, K2), kb($BS, Nat.sub($NN, 1n+p), 1n+p)}, e1), e2), (hs3, pk3)))

def walk_s($WP, +p: Nat, +kk: U32, +KT: AR.Tree<String>, st: WStep(tabT, kl, k, sd, 1n+p, kk, KT), rec: @+K2: AR.Tree<String> -> @+hs2: {AR.slots(String, K2) == kl : List<&2, String>} -> @+pk2: {AR.perfect(String, sd, K2) $TT -> WalkOK(tabT, kl, k, sd, p, U32.sub(kk, 1), K2)) -> WalkOK(tabT, kl, k, sd, 1n+p, kk, KT):
  match st:
    case Tuple{+K2, Tuple{+e1, rest}}:
      (+hs2, pk2) = rest
      walk_s2($WA, p, kk, KT, K2, e1, rec(K2, hs2, pk2))

# THEOREM: the walk over buckets q, q - 1, .., 0 lists every key in bucket order
def walk($WP, $QP) -> WalkOK(tabT, kl, k, sd, q, kk, KT):
  match q:
    case 0n:
      walk_0($WA, kk, KT, wstep($WA, 0n, hq, kk, hkk, KT, hsl, pk))
    case 1n+p:
      +hle = L.subst(Nat, z => {Nat.is_le(1n, z) $TT, 1n+p, UD.v(kk), Equal.sym(Nat, UD.v(kk), 1n+p, hkk), N.zero_le(p))
      +hk2 = Equal.trans(Nat, UD.v(U32.sub(kk, 1)), Nat.sub(UD.v(kk), 1n), p, U.sub_nat(kk, 1, hle), Equal.trans(Nat, Nat.sub(UD.v(kk), 1n), Nat.sub(1n+p, 1n), p, Equal.cong(Nat, Nat, z => Nat.sub(z, 1n), UD.v(kk), 1n+p, hkk), N.sub_zero(p)))
      walk_s($WA, p, kk, KT, wstep($WA, 1n+p, hq, kk, hkk, KT, hsl, pk), K2 => hs2 => pk2 => walk($WA, p, N.lt_trans(p, 1n+p, $NN, N.lt_succ(p), hq), U32.sub(kk, 1), hk2, K2, hs2, pk2))

# ---- the operation ----

def KeysOK(~V: Data, +sh: ST.Sh<V>, r: H.HashMap<&2, V> & List<&2, String>) -> Type:
  Sigma<&1, &1, ST.Sh<V>, sh2 => {r == (ST.real(~V, sh2), S.keys(~V, ST.model(~V, sh))) : H.HashMap<&2, V> & List<&2, String>} & ({ST.good(~V, sh2) $TT & {ST.model(~V, sh2) == ST.model(~V, sh) : List<&2, S.Entry<V>>})>

%def FP +n: U32, +k: Nat, +td: U32, +fresh: U32, +sz: U32, +sd: Nat, +sdU: U32, +free: U32, +tabT: AR.Tree<U32>, +ksT: AR.Tree<String>, +vsT: AR.Tree<Maybe<&2, V>>, +nxT: AR.Tree<U32>
%def FLD n, k, td, fresh, sz, sd, sdU, free, tabT, ksT, vsT, nxT
%def SH ST.HS{$FLD}
%def GF ~V, n, k, td, fresh, sz, sd, sdU, free, tabT, AR.slots(String, ksT), AR.perfect(String, sd, ksT), vsT, nxT, hg
%def KL0 AR.slots(String, ksT)
%def BS0 TB.buckets($TBL, $KL0, $NN)
%def VSL AR.slots(Maybe<&2, V>, vsT)
%def Q0 UD.v(CY.msk(k))
%def WALK H.wk_go(U32.to_nat(U32.inc(CY.msk(k))), CY.msk(k), H.WK{AR.thaw(U32, tabT), AR.thaw(String, ksT), Nil{}})

def keys_w(~V: Data, $FP, +hg: {ST.good(~V, $SH) $TT, wo: WalkOK(tabT, $KL0, k, sd, $Q0, CY.msk(k), ksT), +ew: {$WALK == H.wk_go(1n+$Q0, CY.msk(k), H.WK{AR.thaw(U32, tabT), AR.thaw(String, ksT), kb($BS0, Nat.sub($NN, 1n+$Q0), 1n+$Q0)}) : H.Walk}) -> KeysOK(~V, $SH, H.keys(&2, V, ST.real(~V, $SH))):
  match wo:
    case Tuple{+K2, Tuple{+e2, rest}}:
      (+hs2, pk2) = rest
      +kl = $KL0
      +pkT = ST.g_cpk($GF)
      +hgT = L.subst(Bool, b => {ST.goodF(~V, n, k, td, fresh, sz, sd, sdU, free, tabT, kl, b, vsT, nxT) $TT, AR.perfect(String, sd, ksT), True{}, pkT, hg)
      +g2 = L.subst(List<&2, String>, z => {ST.goodF(~V, n, k, td, fresh, sz, sd, sdU, free, tabT, z, AR.perfect(String, sd, K2), vsT, nxT) $TT, kl, AR.slots(String, K2), Equal.sym(List<&2, String>, AR.slots(String, K2), kl, hs2), L.subst(Bool, b => {ST.goodF(~V, n, k, td, fresh, sz, sd, sdU, free, tabT, kl, b, vsT, nxT) $TT, True{}, AR.perfect(String, sd, K2), Equal.sym(Bool, AR.perfect(String, sd, K2), True{}, pk2), hgT))
      +m2 = Equal.cong(List<&2, String>, List<&2, S.Entry<V>>, z => ST.absm(~V, TB.buckets($TBL, z, $NN), $VSL, $NN, 0n), AR.slots(String, K2), kl, hs2)
      +ek = Equal.sym(List<&2, String>, S.keys(~V, ST.absm(~V, $BS0, $VSL, $NN, 0n)), kb($BS0, $NN, 0n), keys_absm(~V, $BS0, $VSL, UD.v(fresh), $NN, ST.g_clive($GF), $NN, 0n, N.le_refl($NN)))
      +ea = Equal.trans(H.Walk, $WALK, H.wk_go(1n+$Q0, CY.msk(k), H.WK{AR.thaw(U32, tabT), AR.thaw(String, ksT), kb($BS0, Nat.sub($NN, 1n+$Q0), 1n+$Q0)}), H.WK{AR.thaw(U32, tabT), AR.thaw(String, K2), kb($BS0, $NN, 0n)}, ew, e2)
      +eb = Equal.cong(H.Walk, H.HashMap<&2, V> & List<&2, String>, w => H.keys_fin(&2, V, n, CY.msk(k), td, fresh, sz, sdU, free, AR.thaw(Maybe<&2, V>, vsT), AR.thaw(U32, nxT), w), $WALK, H.WK{AR.thaw(U32, tabT), AR.thaw(String, K2), kb($BS0, $NN, 0n)}, ea)
      +ec = Equal.cong(List<&2, String>, H.HashMap<&2, V> & List<&2, String>, z => (ST.real(~V, ST.HS{n, k, td, fresh, sz, sd, sdU, free, tabT, K2, vsT, nxT}), z), kb($BS0, $NN, 0n), S.keys(~V, ST.model(~V, $SH)), ek)
      (ST.HS{n, k, td, fresh, sz, sd, sdU, free, tabT, K2, vsT, nxT}, (Equal.trans(H.HashMap<&2, V> & List<&2, String>, H.keys(&2, V, ST.real(~V, $SH)), (ST.real(~V, ST.HS{n, k, td, fresh, sz, sd, sdU, free, tabT, K2, vsT, nxT}), kb($BS0, $NN, 0n)), (ST.real(~V, ST.HS{n, k, td, fresh, sz, sd, sdU, free, tabT, K2, vsT, nxT}), S.keys(~V, ST.model(~V, $SH))), eb, ec), (g2, m2)))

# THEOREM: keys lists the model's keys in order and keeps the map and its model
def keys_ok(~V: Data, +sh: ST.Sh<V>, +hg: {ST.good(~V, sh) $TT) -> KeysOK(~V, sh, H.keys(&2, V, ST.real(~V, sh))):
  match sh:
    case ST.HS{+n, +k, +td, +fresh, +sz, +sd, +sdU, +free, +tabT, +ksT, +vsT, +nxT}:
      +ck = ST.g_ck($GF)
      +hk31 = L.and_left(Nat.is_lt(k, 31n), Nat.is_lt(0n, k), ck)
      +a0 = GR.mskv(k, N.lt_le(k, 32n, N.lt_trans(k, 31n, 32n, hk31, {==})))
      +eq0 = Equal.trans(Nat, 1n+$Q0, Nat.add($Q0, 1n), $NN, Equal.sym(Nat, Nat.add($Q0, 1n), 1n+$Q0, N.add_comm($Q0, 1n)), a0)
      +hq0 = L.subst(Nat, z => {Nat.is_lt($Q0, z) $TT, 1n+$Q0, $NN, eq0, N.lt_succ($Q0))
      +ef = Equal.trans(Nat, U32.to_nat(U32.inc(CY.msk(k))), $NN, 1n+$Q0, PA.fuel_eq(1n, {==}, k, hk31), Equal.sym(Nat, 1n+$Q0, $NN, eq0))
      +esub = Equal.trans(Nat, Nat.sub($NN, 1n+$Q0), Nat.sub(1n+$Q0, 1n+$Q0), 0n, Equal.cong(Nat, Nat, z => Nat.sub(z, 1n+$Q0), $NN, 1n+$Q0, Equal.sym(Nat, 1n+$Q0, $NN, eq0)), N.sub_self($Q0))
      +eacc = Equal.cong(Nat, List<&2, String>, z => kb($BS0, z, 1n+$Q0), 0n, Nat.sub($NN, 1n+$Q0), Equal.sym(Nat, Nat.sub($NN, 1n+$Q0), 0n, esub))
      +ew = Equal.trans(H.Walk, $WALK, H.wk_go(1n+$Q0, CY.msk(k), H.WK{AR.thaw(U32, tabT), AR.thaw(String, ksT), Nil{}}), H.wk_go(1n+$Q0, CY.msk(k), H.WK{AR.thaw(U32, tabT), AR.thaw(String, ksT), kb($BS0, Nat.sub($NN, 1n+$Q0), 1n+$Q0)}), Equal.cong(Nat, H.Walk, f => H.wk_go(f, CY.msk(k), H.WK{AR.thaw(U32, tabT), AR.thaw(String, ksT), Nil{}}), U32.to_nat(U32.inc(CY.msk(k))), 1n+$Q0, ef), Equal.cong(List<&2, String>, H.Walk, z => H.wk_go(1n+$Q0, CY.msk(k), H.WK{AR.thaw(U32, tabT), AR.thaw(String, ksT), z}), kb($BS0, 0n, 1n+$Q0), kb($BS0, Nat.sub($NN, 1n+$Q0), 1n+$Q0), eacc))
      keys_w(~V, $FLD, hg, walk(1n, {==}, k, hk31, tabT, ST.g_cpt($GF), $KL0, sd, ST.g_csd($GF), AR.slots_length(String, sd, ksT, ST.g_cpk($GF)), ST.g_cwell($GF), $Q0, hq0, CY.msk(k), {==}, ksT, {==}, ST.g_cpk($GF)), ew)
