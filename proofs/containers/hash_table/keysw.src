def w_accx($WP, $QP, +b: B.Bk, +hb: {B.at($BS, q) == b : B.Bk}) -> {$ACC0 == SC.append(String, kof(b), $ACC) : List<&2, String>}:
  Equal.trans(List<&2, String>, $ACC0, SC.append(String, kof(B.at($BS, q)), $ACC), SC.append(String, kof(b), $ACC), acc_eq($BS, $NN, q, hq), Equal.cong(B.Bk, List<&2, String>, y => SC.append(String, kof(y), $ACC), B.at($BS, q), b, hb))

def nth_upd_same(+xs: List<&2, String>, +i: Nat, +v: String, +h: {Nat.is_lt(i, SC.length(String, xs)) $TT) -> {SC.nth(String, SC.update(String, xs, i, v), i) == Some{v} : Maybe<&2, String>}:
  match xs i:
    case Nil{} _:
      Empty.absurd({SC.nth(String, SC.update(String, Nil{}, i, v), i) == Some{v} : Maybe<&2, String>}, N.lt_zero_absurd(i, h))
    case Con{x, t} 0n:
      {==}
    case Con{x, t} 1n+p:
      nth_upd_same(t, p, v, h)

