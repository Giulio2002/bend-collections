# ---- slot values ----

def lvs_nth(~V: Data, +vsl: List<&2, Maybe<&2, V>>, +i: Nat) -> {B.nthb(lvs(~V, vsl), i) == some_b(~V, nthm(~V, vsl, i)) : Bool}:
  match vsl i:
    case Nil{} _:
      {==}
    case Con{m, t} 0n:
      {==}
    case Con{m, t} 1n+p:
      lvs_nth(~V, t, p)

def nthm_some(~V: Data, +vsl: List<&2, Maybe<&2, V>>, +i: Nat, +h: {Nat.is_lt(i, SC.length(Maybe<&2, V>, vsl)) == True{} : Bool}) -> {SC.nth(Maybe<&2, V>, vsl, i) == Some{nthm(~V, vsl, i)} : Maybe<&2, Maybe<&2, V>>}:
  match vsl i:
    case Nil{} _:
      Empty.absurd({SC.nth(Maybe<&2, V>, Nil{}, i) == Some{nthm(~V, Nil{}, i)} : Maybe<&2, Maybe<&2, V>>}, N.lt_zero_absurd(i, h))
    case Con{m, t} 0n:
      {==}
    case Con{m, t} 1n+p:
      nthm_some(~V, t, p, h)
