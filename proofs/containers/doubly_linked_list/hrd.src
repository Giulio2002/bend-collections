# get and set on a handle: the storage's checks and the live element.

%def MT Maybe<&2, T>
%def VL AR.slots($MT, vT)
%def GL AR.slots(U32, gT)
%def FV UD.v(fresh)
%def II UD.v(id)
%def TR(x) {x == True{} : Bool}
%def VLF SC.take($MT, $VL, $FV)
%def GLF SC.take(U32, $GL, $FV)
%def SHA tag, cap, fresh, free, head, tail, depth, vT, pT, nT, gT, sl, fl
%def SH ST.LS{$SHA}
%def G(c) ST.g_$c(~T, $SHA, hg)
%def HH E.H{owner, id, g}
%def RS ST.real(~T, $SH)
%def MS ST.model(~T, $SH)
%def OB E.Obs<T>
%def ST0 E.StaleHandle{}
%def VP +tag: U32, +cap: U32, +fresh: U32, +free: U32, +head: U32, +tail: U32, +depth: Nat, +vT: AR.Tree<$MT>, +pT: AR.Tree<U32>, +nT: AR.Tree<U32>, +gT: AR.Tree<U32>, +sl: List<&2, Nat>, +fl: List<&2, Nat>, +hg: $TR(ST.goodF(~T, $SHA)), +owner: U32, +id: U32, +g: U32
%def VA tag, cap, fresh, free, head, tail, depth, vT, pT, nT, gT, sl, fl, hg, owner, id, g
%def HO +ho: {U32.is_eq(owner, tag) == True{} : Bool}
%def CNT SC.length(Nat, sl)
%def STF tag, fresh, free, $CNT, head, tail, depth, cap
%def AV AR.thaw($MT, vT)
%def AP AR.thaw(U32, pT)
%def AN AR.thaw(U32, nT)
%def AG AR.thaw(U32, gT)
%def RAWS R.DL{$STF, $AV, $AP, $AN}
%def DO D.DList<T> & $OB

def lt_f(+id: U32, +fresh: U32, +h: {Nat.is_lt($II, $FV) == False{} : Bool}) -> {U32.is_lt(id, fresh) == False{} : Bool}:
  Equal.trans(Bool, U32.is_lt(id, fresh), Nat.is_lt($II, $FV), False{}, U.is_lt_nat(id, fresh), h)

def lt_t(+id: U32, +fresh: U32, +h: {Nat.is_lt($II, $FV) == True{} : Bool}) -> {U32.is_lt(id, fresh) == True{} : Bool}:
  Equal.trans(Bool, U32.is_lt(id, fresh), Nat.is_lt($II, $FV), True{}, U.is_lt_nat(id, fresh), h)

def i_lt(~T: Data, $VP, +hlt: {Nat.is_lt($II, $FV) == True{} : Bool}) -> {Nat.is_lt($II, SC.pow2(depth)) == True{} : Bool}:
  +e2d = N.eq_from_is_eq(UD.v(cap), SC.pow2(depth), $G(ccap))
  N.lt_le_trans($II, $FV, SC.pow2(depth), hlt, L.subst(Nat, z => {Nat.is_le($FV, z) == True{} : Bool}, UD.v(cap), SC.pow2(depth), e2d, $G(cfr)))

%def VGET LN.vget(T, depth, $G(cdep), vT, $G(cpv), id, i_lt(~T, $VA, hlt))

# ---- get ----

%def GC(c1, c2) D.value_result(~T, tag, depth, cap, $AG, R.get_checked(~T, c1, $STF, $AV, $AP, $AN, id, c2))
%def GF(r) D.value_result(~T, tag, depth, cap, $AG, R.get_fin(~T, $STF, $AP, $AN, r))
%def GOP E.Get{$HH}

def get_hi(~T: Data, $VP, $HO, +hlt: {Nat.is_lt($II, $FV) == False{} : Bool}) -> {D.dispatch(~T, $RS, $GOP) == ($RS, D.failed(~T, $GOP, $ST0)) : $DO}:
  Equal.trans($DO, $GC(U32.is_lt(id, fresh), U32.is_eq(owner, tag)), $GC(False{}, U32.is_eq(owner, tag)), ($RS, D.failed(~T, $GOP, $ST0)), Equal.cong(Bool, $DO, z => $GC(z, U32.is_eq(owner, tag)), U32.is_lt(id, fresh), False{}, lt_f(id, fresh, hlt)), Equal.cong(Bool, $DO, z => $GC(False{}, z), U32.is_eq(owner, tag), True{}, ho))

def get_pre(~T: Data, $VP, $HO, +hlt: {Nat.is_lt($II, $FV) == True{} : Bool}) -> {D.dispatch(~T, $RS, $GOP) == $GF(($AV, S.val_of(T, $VL, $II))) : $DO}:
  +e1 = Equal.cong(Bool, $DO, z => $GC(z, U32.is_eq(owner, tag)), U32.is_lt(id, fresh), True{}, lt_t(id, fresh, hlt))
  +e2 = Equal.cong(Bool, $DO, z => $GC(True{}, z), U32.is_eq(owner, tag), True{}, ho)
  +e3 = Equal.cong(Array<$MT> & $MT, $DO, r => $GF(r), Array.get($MT, $AV, id), ($AV, S.val_of(T, $VL, $II)), $VGET)
  Equal.trans($DO, $GC(U32.is_lt(id, fresh), U32.is_eq(owner, tag)), $GC(True{}, U32.is_eq(owner, tag)), $GF(($AV, S.val_of(T, $VL, $II))), e1, Equal.trans($DO, $GC(True{}, U32.is_eq(owner, tag)), $GC(True{}, True{}), $GF(($AV, S.val_of(T, $VL, $II))), e2, e3))

def get_none(~T: Data, $VP, $HO, +hlt: {Nat.is_lt($II, $FV) == True{} : Bool}, +hv: {S.val_of(T, $VL, $II) == None{} : $MT}) -> {D.dispatch(~T, $RS, $GOP) == ($RS, D.failed(~T, $GOP, $ST0)) : $DO}:
  Equal.trans($DO, D.dispatch(~T, $RS, $GOP), $GF(($AV, S.val_of(T, $VL, $II))), ($RS, D.failed(~T, $GOP, $ST0)), get_pre(~T, $VA, ho, hlt), Equal.cong($MT, $DO, m => $GF(($AV, m)), S.val_of(T, $VL, $II), None{}, hv))

def get_live(~T: Data, $VP, $HO, +hlt: {Nat.is_lt($II, $FV) == True{} : Bool}, +vv: T, +hv: {S.val_of(T, $VL, $II) == Some{vv} : $MT}, +hgen: {g == W32.nth0($GL, $II) : U32}) -> OK.POK(~T, $OB, S.live_op(T, $MS, $GOP, $II), D.dispatch(~T, $RS, $GOP)):
  +er = Equal.trans($DO, D.dispatch(~T, $RS, $GOP), $GF(($AV, S.val_of(T, $VL, $II))), ($RS, E.OVal{Done{vv}}), get_pre(~T, $VA, ho, hlt), Equal.cong($MT, $DO, m => $GF(($AV, m)), S.val_of(T, $VL, $II), Some{vv}, hv))
  +es = Equal.cong($MT, S.DS<T> & $OB, m => ($MS, E.OVal{S.maybe_done(T, $ST0, m)}), S.val_of(T, $VLF, $II), Some{vv}, Equal.trans($MT, S.val_of(T, $VLF, $II), S.val_of(T, $VL, $II), Some{vv}, VA.val_take(T, $VL, $FV, $II, hlt), hv))
  ($SH, (E.OVal{Done{vv}}, (er, (es, hg))))

# ---- set ----

%def SOP E.Set{$HH, x}
%def SC2(c1, c2) D.unit_result(~T, tag, depth, cap, $AG, R.set_checked(~T, c1, $STF, $AV, $AP, $AN, id, x, c2))
%def SF(r) D.unit_result(~T, tag, depth, cap, $AG, R.set_fin(~T, $STF, $AP, $AN, id, x, r))
%def VX AR.upd($MT, depth, vT, $II, Some{x})

def set_hi(~T: Data, $VP, +x: T, $HO, +hlt: {Nat.is_lt($II, $FV) == False{} : Bool}) -> {D.dispatch(~T, $RS, $SOP) == ($RS, D.failed(~T, $SOP, $ST0)) : $DO}:
  Equal.trans($DO, $SC2(U32.is_lt(id, fresh), U32.is_eq(owner, tag)), $SC2(False{}, U32.is_eq(owner, tag)), ($RS, D.failed(~T, $SOP, $ST0)), Equal.cong(Bool, $DO, z => $SC2(z, U32.is_eq(owner, tag)), U32.is_lt(id, fresh), False{}, lt_f(id, fresh, hlt)), Equal.cong(Bool, $DO, z => $SC2(False{}, z), U32.is_eq(owner, tag), True{}, ho))

def set_pre(~T: Data, $VP, +x: T, $HO, +hlt: {Nat.is_lt($II, $FV) == True{} : Bool}) -> {D.dispatch(~T, $RS, $SOP) == $SF((AR.thaw($MT, $VX), S.val_of(T, $VL, $II))) : $DO}:
  +e1 = Equal.cong(Bool, $DO, z => $SC2(z, U32.is_eq(owner, tag)), U32.is_lt(id, fresh), True{}, lt_t(id, fresh, hlt))
  +e2 = Equal.cong(Bool, $DO, z => $SC2(True{}, z), U32.is_eq(owner, tag), True{}, ho)
  +e3 = Equal.cong(Array<$MT> & $MT, $DO, r => $SF(r), Array.swap($MT, $AV, id, Some{x}), (AR.thaw($MT, $VX), S.val_of(T, $VL, $II)), LN.vswap(T, depth, $G(cdep), vT, $G(cpv), id, i_lt(~T, $VA, hlt), Some{x}))
  Equal.trans($DO, $SC2(U32.is_lt(id, fresh), U32.is_eq(owner, tag)), $SC2(True{}, U32.is_eq(owner, tag)), $SF((AR.thaw($MT, $VX), S.val_of(T, $VL, $II))), e1, Equal.trans($DO, $SC2(True{}, U32.is_eq(owner, tag)), $SC2(True{}, True{}), $SF((AR.thaw($MT, $VX), S.val_of(T, $VL, $II))), e2, e3))

def upd_upd(-X: Data, +xs: List<&2, X>, +i: Nat, +v: X, +w: X) -> {SC.update(X, SC.update(X, xs, i, v), i, w) == SC.update(X, xs, i, w) : List<&2, X>}:
  match xs i:
    case Nil{} _:
      {==}
    case Con{h, t} 0n:
      {==}
    case Con{h, +t} 1n+p:
      LL.cons_cong(X, h, SC.update(X, SC.update(X, t, p, v), p, w), SC.update(X, t, p, w), upd_upd(X, t, p, v, w))

def upd_self(-X: Data, +xs: List<&2, X>, +i: Nat, +x: X, +h: {SC.nth(X, xs, i) == Some{x} : Maybe<&2, X>}) -> {SC.update(X, xs, i, x) == xs : List<&2, X>}:
  match xs i:
    case Nil{} _:
      {==}
    case Con{+y, t} 0n:
      Equal.cong(X, List<&2, X>, z => Con{z, t}, x, y, Equal.sym(X, y, x, L.some_inj(X, y, x, h)))
    case Con{y, +t} 1n+p:
      LL.cons_cong(X, y, SC.update(X, t, p, x), t, upd_self(X, t, p, x, h))

# writing None back over a vacant slot restores the block
def set_back(~T: Data, $VP, +x: T, +hlt: {Nat.is_lt($II, $FV) == True{} : Bool}, +hv: {S.val_of(T, $VL, $II) == None{} : $MT}) -> {Array.set($MT, AR.thaw($MT, $VX), id, None{}) == $AV : Array<$MT>}:
  +hi = i_lt(~T, $VA, hlt)
  +pv = $G(cpv)
  +px = AR.upd_perfect($MT, depth, vT, $II, Some{x}, pv)
  +e1 = LN.vset(T, depth, $G(cdep), $VX, px, id, hi, None{})
  +hl = IG.len_is($MT, $VL, SC.pow2(depth), AR.slots_length($MT, depth, vT, pv), $II, hi)
  +hn = Equal.trans(Maybe<&2, $MT>, SC.nth($MT, $VL, $II), Some{S.val_of(T, $VL, $II)}, Some{None{}}, LN.nth_val(T, $VL, $II, hl), Equal.cong($MT, Maybe<&2, $MT>, m => Some{m}, S.val_of(T, $VL, $II), None{}, hv))
  +es = Equal.trans(List<&2, $MT>, AR.slots($MT, AR.upd($MT, depth, $VX, $II, None{})), SC.update($MT, AR.slots($MT, $VX), $II, None{}), $VL, AR.upd_slots($MT, depth, $VX, $II, None{}, hi, px), Equal.trans(List<&2, $MT>, SC.update($MT, AR.slots($MT, $VX), $II, None{}), SC.update($MT, SC.update($MT, $VL, $II, Some{x}), $II, None{}), $VL, Equal.cong(List<&2, $MT>, List<&2, $MT>, z => SC.update($MT, z, $II, None{}), AR.slots($MT, $VX), SC.update($MT, $VL, $II, Some{x}), AR.upd_slots($MT, depth, vT, $II, Some{x}, hi, pv)), Equal.trans(List<&2, $MT>, SC.update($MT, SC.update($MT, $VL, $II, Some{x}), $II, None{}), SC.update($MT, $VL, $II, None{}), $VL, upd_upd($MT, $VL, $II, Some{x}, None{}), upd_self($MT, $VL, $II, None{}, hn))))
  +et = AX.tree_ext($MT, depth, AR.upd($MT, depth, $VX, $II, None{}), vT, AR.upd_perfect($MT, depth, $VX, $II, None{}, px), pv, es)
  Equal.trans(Array<$MT>, Array.set($MT, AR.thaw($MT, $VX), id, None{}), AR.thaw($MT, AR.upd($MT, depth, $VX, $II, None{})), $AV, e1, Equal.cong(AR.Tree<$MT>, Array<$MT>, z => AR.thaw($MT, z), AR.upd($MT, depth, $VX, $II, None{}), vT, et))

def set_none(~T: Data, $VP, +x: T, $HO, +hlt: {Nat.is_lt($II, $FV) == True{} : Bool}, +hv: {S.val_of(T, $VL, $II) == None{} : $MT}) -> {D.dispatch(~T, $RS, $SOP) == ($RS, D.failed(~T, $SOP, $ST0)) : $DO}:
  +e1 = Equal.trans($DO, D.dispatch(~T, $RS, $SOP), $SF((AR.thaw($MT, $VX), S.val_of(T, $VL, $II))), $SF((AR.thaw($MT, $VX), None{})), set_pre(~T, $VA, x, ho, hlt), Equal.cong($MT, $DO, m => $SF((AR.thaw($MT, $VX), m)), S.val_of(T, $VL, $II), None{}, hv))
  Equal.trans($DO, D.dispatch(~T, $RS, $SOP), $SF((AR.thaw($MT, $VX), None{})), ($RS, D.failed(~T, $SOP, $ST0)), e1, Equal.cong(Array<$MT>, $DO, z => (D.DL{tag, depth, cap, R.DL{$STF, z, $AP, $AN}, $AG}, E.OUnit{Fail{$ST0}}), Array.set($MT, AR.thaw($MT, $VX), id, None{}), $AV, set_back(~T, $VA, x, hlt, hv)))

%def SHX ST.LS{tag, cap, fresh, free, head, tail, depth, $VX, pT, nT, gT, sl, fl}
%def VL2 SC.update($MT, $VL, $II, Some{x})

def set_live(~T: Data, $VP, +x: T, $HO, +hlt: {Nat.is_lt($II, $FV) == True{} : Bool}, +vv: T, +hv: {S.val_of(T, $VL, $II) == Some{vv} : $MT}, +hgen: {g == W32.nth0($GL, $II) : U32}) -> OK.POK(~T, $OB, S.live_op(T, $MS, $SOP, $II), D.dispatch(~T, $RS, $SOP)):
  +hi = i_lt(~T, $VA, hlt)
  +er = Equal.trans($DO, D.dispatch(~T, $RS, $SOP), $SF((AR.thaw($MT, $VX), S.val_of(T, $VL, $II))), (ST.real(~T, $SHX), E.OUnit{Done{Unit{}}}), set_pre(~T, $VA, x, ho, hlt), Equal.cong($MT, $DO, m => $SF((AR.thaw($MT, $VX), m)), S.val_of(T, $VL, $II), Some{vv}, hv))
  +esv = AR.upd_slots($MT, depth, vT, $II, Some{x}, hi, $G(cpv))
  +evl = Equal.trans(List<&2, $MT>, SC.update($MT, $VLF, $II, Some{x}), SC.take($MT, $VL2, $FV), SC.take($MT, AR.slots($MT, $VX), $FV), Equal.sym(List<&2, $MT>, SC.take($MT, $VL2, $FV), SC.update($MT, $VLF, $II, Some{x}), LL.sc_take_update($MT, $VL, $II, Some{x}, $FV)), Equal.cong(List<&2, $MT>, List<&2, $MT>, z => SC.take($MT, z, $FV), $VL2, AR.slots($MT, $VX), Equal.sym(List<&2, $MT>, AR.slots($MT, $VX), $VL2, esv)))
  +es = Equal.cong(List<&2, $MT>, S.DS<T> & $OB, z => (S.DS{tag, sl, z, $GLF, fl}, E.OUnit{Done{Unit{}}}), SC.update($MT, $VLF, $II, Some{x}), SC.take($MT, AR.slots($MT, $VX), $FV), evl)
  +hl = IG.len_is($MT, $VL, SC.pow2(depth), AR.slots_length($MT, depth, vT, $G(cpv)), $II, hi)
  +hlv = RL.by_eq(ST.live(T, $VL, $II), True{}, Equal.cong($MT, Bool, m => ST.some_b(T, m), S.val_of(T, $VL, $II), Some{vv}, hv), {==})
  +hm = VA.lvin_elim(~T, $VL, 0n, sl, $G(clv), $II, hlv)
  +r1 = L.subst(List<&2, $MT>, z => {ST.slok(~T, sl, $FV, z) == True{} : Bool}, $VL2, AR.slots($MT, $VX), Equal.sym(List<&2, $MT>, AR.slots($MT, $VX), $VL2, esv), LV.slok_upd(~T, sl, $FV, $VL, $II, Some{x}, hl, {==}, $G(csl)))
  +r2 = L.subst(List<&2, $MT>, z => {ST.flok(~T, fl, $FV, z) == True{} : Bool}, $VL2, AR.slots($MT, $VX), Equal.sym(List<&2, $MT>, AR.slots($MT, $VX), $VL2, esv), LV.flok_off(~T, fl, $FV, $VL, $II, Some{x}, RL.live_nf(~T, $II, fl, $FV, $VL, hlv, $G(cfl)), $G(cfl)))
  +r3 = L.subst(List<&2, $MT>, z => {ST.lvin(~T, z, 0n, sl) == True{} : Bool}, $VL2, AR.slots($MT, $VX), Equal.sym(List<&2, $MT>, AR.slots($MT, $VX), $VL2, esv), VA.lvin_upd(~T, $VL, 0n, sl, $II, Some{x}, $G(clv), hm))
  +hgd = ST.good_intro(~T, tag, cap, fresh, free, head, tail, depth, $VX, pT, nT, gT, sl, fl, $G(cdep), $G(ccap), AR.upd_perfect($MT, depth, vT, $II, Some{x}, $G(cpv)), $G(cpp), $G(cpn), $G(cpg), $G(cfr), $G(cseg), $G(chead), $G(ctail), $G(cnd), r1, $G(cfree), $G(cfll), r2, $G(cfnd), $G(cgz), r3)
  ($SHX, (E.OUnit{Done{Unit{}}}, (er, (es, hgd))))
