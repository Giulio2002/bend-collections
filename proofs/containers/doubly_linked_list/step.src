# THEOREM (one step): every operation, on every good shadow with fewer than
# 2^cz issued ids, refines the specification's step.

%def APN(a, b) SC.append(Nat, a, b)
%def MT Maybe<&2, T>
%def VL AR.slots($MT, vT)
%def PL AR.slots(U32, pT)
%def NL AR.slots(U32, nT)
%def GL AR.slots(U32, gT)
%def FV UD.v(fresh)
%def TR(x) {x == True{} : Bool}
%def VLF SC.take($MT, $VL, $FV)
%def GLF SC.take(U32, $GL, $FV)
%def SHA tag, cap, fresh, free, head, tail, depth, vT, pT, nT, gT, sl, fl
%def SH ST.LS{$SHA}
%def G(c) ST.g_$c(~T, $SHA, hg)
%def RS ST.real(~T, $SH)
%def MS ST.model(~T, $SH)
%def OB E.Obs<T>
%def DO D.DList<T> & $OB
%def AV AR.thaw($MT, vT)
%def AP AR.thaw(U32, pT)
%def AN AR.thaw(U32, nT)
%def AG AR.thaw(U32, gT)
%def SP +one: Nat, +h1: {one == 1n : Nat}, +cz: Nat, +hcz: {cz == 29n : Nat}, +tag: U32, +cap: U32, +fresh: U32, +free: U32, +head: U32, +tail: U32, +depth: Nat, +vT: AR.Tree<$MT>, +pT: AR.Tree<U32>, +nT: AR.Tree<U32>, +gT: AR.Tree<U32>, +sl: List<&2, Nat>, +fl: List<&2, Nat>, +hg: $TR(ST.goodF(~T, $SHA)), +hroom: $TR(Nat.is_lt($FV, SC.pow2(cz)))
%def SA one, h1, cz, hcz, tag, cap, fresh, free, head, tail, depth, vT, pT, nT, gT, sl, fl, hg, hroom
%def SQ +one: Nat, +h1: {one == 1n : Nat}, +tag: U32, +cap: U32, +fresh: U32, +free: U32, +head: U32, +tail: U32, +depth: Nat, +vT: AR.Tree<$MT>, +pT: AR.Tree<U32>, +nT: AR.Tree<U32>, +gT: AR.Tree<U32>, +sl: List<&2, Nat>, +fl: List<&2, Nat>, +hg: $TR(ST.goodF(~T, $SHA))
%def SQA one, h1, tag, cap, fresh, free, head, tail, depth, vT, pT, nT, gT, sl, fl, hg
%def STEP(op) OK.POK(~T, $OB, S.step(T, $MS, op), D.step(~T, $RS, op))

# ---- length and to_list ----

def len_ok(~T: Data, $SQ) -> $STEP(E.Length{}):
  ($SH, (E.ONat{SC.length(Nat, sl)}, ({==}, ({==}, hg))))

def values_take(~T: Data, +xs: List<&2, Nat>, +fr: Nat, +vl: List<&2, $MT>, +h: $TR(ST.slok(~T, xs, fr, vl))) -> {S.values(T, SC.take($MT, vl, fr), xs) == S.values(T, vl, xs) : List<&2, T>}:
  match xs:
    case Nil{}:
      {==}
    case Con{+x, +t}:
      +hx = L.and_left(Nat.is_lt(x, fr), ST.live(T, vl, x), L.and_left(Bool.and(Nat.is_lt(x, fr), ST.live(T, vl, x)), ST.slok(~T, t, fr, vl), h))
      +ih = values_take(~T, t, fr, vl, L.and_right(Bool.and(Nat.is_lt(x, fr), ST.live(T, vl, x)), ST.slok(~T, t, fr, vl), h))
      Equal.trans(List<&2, T>, S.cons_some(T, S.val_of(T, SC.take($MT, vl, fr), x), S.values(T, SC.take($MT, vl, fr), t)), S.cons_some(T, S.val_of(T, vl, x), S.values(T, SC.take($MT, vl, fr), t)), S.cons_some(T, S.val_of(T, vl, x), S.values(T, vl, t)), Equal.cong($MT, List<&2, T>, m => S.cons_some(T, m, S.values(T, SC.take($MT, vl, fr), t)), S.val_of(T, SC.take($MT, vl, fr), x), S.val_of(T, vl, x), VA.val_take(T, vl, fr, x, hx)), Equal.cong(List<&2, T>, List<&2, T>, z => S.cons_some(T, S.val_of(T, vl, x), z), S.values(T, SC.take($MT, vl, fr), t), S.values(T, vl, t), ih))

%def BK NL.rapp(sl, Nil{})
%def RAW R.DL{tag, fresh, free, SC.length(Nat, sl), head, tail, depth, cap, $AV, $AP, $AN}
%def RL2 R.DList<T> & List<&2, T>
%def TLR(n, c) R.tl_fin(~T, tag, fresh, free, SC.length(Nat, sl), head, tail, depth, cap, $AN, R.walk(~T, n, c))

# the storage's to_list: the values of the list's ids in order
def raw_list(~T: Data, $SQ) -> {R.to_list(~T, $RAW) == ($RAW, S.values(T, $VL, sl)) : $RL2}:
  +e2d = N.eq_from_is_eq(UD.v(cap), SC.pow2(depth), $G(ccap))
  +hfr2 = L.subst(Nat, z => {Nat.is_le($FV, z) == True{} : Bool}, UD.v(cap), SC.pow2(depth), e2d, $G(cfr))
  +ec = Equal.sym(Nat, SC.length(Nat, $BK), SC.length(Nat, sl), Equal.trans(Nat, SC.length(Nat, $BK), Nat.add(SC.length(Nat, sl), 0n), SC.length(Nat, sl), NL.len_rapp(sl, Nil{}), N.add_zero(SC.length(Nat, sl))))
  +et = Equal.trans(U32, tail, LK.last_or(sl, 0), LK.fst_or($BK, 0), A.eq_of(tail, LK.last_or(sl, 0), $G(ctail)), Equal.sym(U32, LK.fst_or($BK, 0), LK.last_or(sl, 0), LK.fo_rapp(sl, Nil{}, 0)))
  +hrok = WL.rok_app(~T, $PL, $NL, $VL, sl, Nil{}, $FV, 0, 0, $G(cseg), $G(csl), {==}, LK.u_refl(0))
  +ew = WL.walk(~T, one, h1, depth, $G(cdep), vT, pT, $G(cpv), $G(cpp), $FV, hfr2, $BK, Nil{}, hrok)
  +er1 = Equal.cong(Nat, $RL2, n => $TLR(n, R.C{$AV, $AP, Nil{}, tail}), SC.length(Nat, sl), SC.length(Nat, $BK), ec)
  +er2 = Equal.cong(U32, $RL2, z => $TLR(SC.length(Nat, $BK), R.C{$AV, $AP, Nil{}, z}), tail, LK.fst_or($BK, 0), et)
  +er3 = Equal.cong(R.Cur<T>, $RL2, c => R.tl_fin(~T, tag, fresh, free, SC.length(Nat, sl), head, tail, depth, cap, $AN, c), R.walk(~T, SC.length(Nat, $BK), R.C{$AV, $AP, Nil{}, LK.fst_or($BK, 0)}), R.C{$AV, $AP, WL.racc(T, $VL, $BK, Nil{}), 0}, ew)
  +ev = Equal.trans(List<&2, T>, WL.racc(T, $VL, $BK, Nil{}), SC.append(T, S.values(T, $VL, sl), Nil{}), S.values(T, $VL, sl), WL.ra_rapp(T, $VL, sl, Nil{}, Nil{}), LL.append_nil(T, S.values(T, $VL, sl)))
  +er4 = Equal.cong(List<&2, T>, $RL2, z => ($RAW, z), WL.racc(T, $VL, $BK, Nil{}), S.values(T, $VL, sl), ev)
  Equal.trans($RL2, $TLR(SC.length(Nat, sl), R.C{$AV, $AP, Nil{}, tail}), $TLR(SC.length(Nat, $BK), R.C{$AV, $AP, Nil{}, tail}), ($RAW, S.values(T, $VL, sl)), er1, Equal.trans($RL2, $TLR(SC.length(Nat, $BK), R.C{$AV, $AP, Nil{}, tail}), $TLR(SC.length(Nat, $BK), R.C{$AV, $AP, Nil{}, LK.fst_or($BK, 0)}), ($RAW, S.values(T, $VL, sl)), er2, Equal.trans($RL2, $TLR(SC.length(Nat, $BK), R.C{$AV, $AP, Nil{}, LK.fst_or($BK, 0)}), ($RAW, WL.racc(T, $VL, $BK, Nil{})), ($RAW, S.values(T, $VL, sl)), er3, er4)))

def spec_list(~T: Data, $SQ) -> {S.list_of(T, $MS) == S.values(T, $VL, sl) : List<&2, T>}:
  values_take(~T, sl, $FV, $VL, $G(csl))

def list_ok(~T: Data, $SQ) -> $STEP(E.ToList{}):
  +er = Equal.cong($RL2, $DO, r => D.list_result(~T, tag, depth, cap, $AG, r), R.to_list(~T, $RAW), ($RAW, S.values(T, $VL, sl)), raw_list(~T, $SQA))
  +es = Equal.cong(List<&2, T>, S.DS<T> & $OB, z => ($MS, E.OList{z}), S.list_of(T, $MS), S.values(T, $VL, sl), spec_list(~T, $SQA))
  ($SH, (E.OList{S.values(T, $VL, sl)}, (er, (es, hg))))

# ---- the pushes ----

%def IBF(n, h, a, b) R.insert_between_free(~T, tag, fresh, free, SC.length(Nat, n), head, tail, depth, cap, $AV, $AP, $AN, a, b, x)

%def HOK(sp, im) OK.POK(~T, E.Handle, sp, im)

def front_h(~T: Data, $SP, +x: T) -> $HOK(S.push_front(T, $MS, x), D.push_front(~T, $RS, x)):
  p = IN.ins_ok(~T, one, h1, tag, cap, fresh, head, tail, depth, vT, pT, nT, gT, Nil{}, sl, cz, hcz, free, fl, hg, hroom, x)
  +eh = A.eq_of(head, LK.fst_or(sl, 0), $G(chead))
  +er = Equal.cong(U32, D.DList<T> & E.Handle, z => D.inserted(~T, tag, depth, cap, $AG, $IBF(sl, head, 0, z)), head, LK.fst_or(sl, 0), eh)
  +es = HL.ins_pos(T, tag, sl, $VLF, $GLF, fl, x, S.PFront{}, Nil{}, sl, n => {==})
  OK.pok_eq(~T, E.Handle, S.push_front(T, $MS, x), IP.insAB(T, S.alloc(T, $MS), x, Nil{}, sl), D.push_front(~T, $RS, x), D.inserted(~T, tag, depth, cap, $AG, $IBF(sl, head, 0, LK.fst_or(sl, 0))), es, er, p)

def front_ok(~T: Data, $SP, +x: T) -> $STEP(E.PushFront{x}):
  HL.pok_push(~T, S.push_front(T, $MS, x), D.push_front(~T, $RS, x), front_h(~T, $SA, x))

%def SLN $APN(sl, Nil{})
%def SPB(o) IP.insAB(T, S.alloc(T, S.DS{tag, o, $VLF, $GLF, fl}), x, sl, Nil{})

def back_h(~T: Data, $SP, +x: T) -> $HOK(S.push_back(T, $MS, x), D.push_back(~T, $RS, x)):
  +ean = LL.append_nil(Nat, sl)
  +hg3 = L.subst(List<&2, Nat>, z => {ST.goodF(~T, tag, cap, fresh, free, head, tail, depth, vT, pT, nT, gT, z, fl) == True{} : Bool}, sl, $SLN, Equal.sym(List<&2, Nat>, $SLN, sl, ean), hg)
  p = IN.ins_ok(~T, one, h1, tag, cap, fresh, head, tail, depth, vT, pT, nT, gT, sl, Nil{}, cz, hcz, free, fl, hg3, hroom, x)
  +et = A.eq_of(tail, LK.last_or(sl, 0), $G(ctail))
  +er1 = Equal.cong(U32, D.DList<T> & E.Handle, z => D.inserted(~T, tag, depth, cap, $AG, $IBF(sl, head, z, 0)), tail, LK.last_or(sl, 0), et)
  +er2 = Equal.cong(List<&2, Nat>, D.DList<T> & E.Handle, z => D.inserted(~T, tag, depth, cap, $AG, $IBF(z, head, LK.last_or(sl, 0), 0)), sl, $SLN, Equal.sym(List<&2, Nat>, $SLN, sl, ean))
  +er = Equal.trans(D.DList<T> & E.Handle, D.push_back(~T, $RS, x), D.inserted(~T, tag, depth, cap, $AG, $IBF(sl, head, LK.last_or(sl, 0), 0)), D.inserted(~T, tag, depth, cap, $AG, $IBF($SLN, head, LK.last_or(sl, 0), 0)), er1, er2)
  +es1 = HL.ins_pos(T, tag, sl, $VLF, $GLF, fl, x, S.PBack{}, sl, Nil{}, n => LL.snoc_append(Nat, sl, n))
  +es2 = Equal.cong(List<&2, Nat>, S.DS<T> & E.Handle, z => $SPB(z), sl, $SLN, Equal.sym(List<&2, Nat>, $SLN, sl, ean))
  +es = Equal.trans(S.DS<T> & E.Handle, S.push_back(T, $MS, x), $SPB(sl), $SPB($SLN), es1, es2)
  OK.pok_eq(~T, E.Handle, S.push_back(T, $MS, x), $SPB($SLN), D.push_back(~T, $RS, x), D.inserted(~T, tag, depth, cap, $AG, $IBF($SLN, head, LK.last_or(sl, 0), 0)), es, er, p)

def back_ok(~T: Data, $SP, +x: T) -> $STEP(E.PushBack{x}):
  HL.pok_push(~T, S.push_back(T, $MS, x), D.push_back(~T, $RS, x), back_h(~T, $SA, x))

# ---- the handle operations ----

%def VA tag, cap, fresh, free, head, tail, depth, vT, pT, nT, gT, sl, fl, hg, owner, id, g
%def HH E.H{owner, id, g}
%def HP +owner: U32, +id: U32, +g: U32
%def ABW(h2) tag, cap, fresh, free, head, tail, depth, vT, pT, nT, gT, a, b, fl, owner, id, g, h2

def get_ok(~T: Data, $SQ, $HP) -> $STEP(E.Get{$HH}):
  VD.vstep(~T, $VA, E.Get{$HH}, {==}, {==}, ho => hlt => HR.get_hi(~T, $VA, ho, hlt), ho => hlt => hv => HR.get_none(~T, $VA, ho, hlt, hv), ho => hlt => vv => hv => hgen => HR.get_live(~T, $VA, ho, hlt, vv, hv, hgen))

def set_ok(~T: Data, $SQ, $HP, +x: T) -> $STEP(E.Set{$HH, x}):
  VD.vstep(~T, $VA, E.Set{$HH, x}, {==}, {==}, ho => hlt => HR.set_hi(~T, $VA, x, ho, hlt), ho => hlt => hv => HR.set_none(~T, $VA, x, ho, hlt, hv), ho => hlt => vv => hv => hgen => HR.set_live(~T, $VA, x, ho, hlt, vv, hv, hgen))

def next_ok(~T: Data, $SQ, $HP) -> $STEP(E.Next{$HH}):
  VD.vstep(~T, $VA, E.Next{$HH}, {==}, {==}, ho => hlt => NB.nb_hi(~T, $VA, True{}, ho, hlt), ho => hlt => hv => NB.nb_none(~T, $VA, True{}, ho, hlt, hv), ho => hlt => vv => hv => hgen => HL.next_live(~T, $VA, one, h1, ho, hlt, vv, hv, hgen))

def prev_ok(~T: Data, $SQ, $HP) -> $STEP(E.Prev{$HH}):
  VD.vstep(~T, $VA, E.Prev{$HH}, {==}, {==}, ho => hlt => NB.nb_hi(~T, $VA, False{}, ho, hlt), ho => hlt => hv => NB.nb_none(~T, $VA, False{}, ho, hlt, hv), ho => hlt => vv => hv => hgen => HL.prev_live(~T, $VA, one, h1, ho, hlt, vv, hv, hgen))

def remove_ok(~T: Data, $SQ, $HP) -> $STEP(E.Remove{$HH}):
  VD.vstep(~T, $VA, E.Remove{$HH}, {==}, {==}, ho => hlt => HL.rm_hi(~T, $VA, ho, hlt), ho => hlt => hv => HL.rm_none(~T, $VA, ho, hlt, hv), ho => hlt => vv => hv => hgen => HL.rm_live(~T, $VA, one, h1, ho, hlt, vv, hv, hgen))

def before_ok(~T: Data, $SP, $HP, +x: T) -> $STEP(E.InsertBefore{$HH, x}):
  VD.vstep(~T, $VA, E.InsertBefore{$HH, x}, {==}, {==}, ho => hlt => HL.ins_hi(~T, $VA, x, False{}, ho, hlt), ho => hlt => hv => HL.ins_none(~T, $VA, x, False{}, ho, hlt, hv), ho => hlt => vv => hv => hgen => HL.with_split(~T, $VA, E.InsertBefore{$HH, x}, vv, hv, a => b => hg2 => HI.ib_ab(~T, $ABW(hg2), one, h1, cz, hcz, hroom, ho, hlt, vv, hv, x)))

def after_ok(~T: Data, $SP, $HP, +x: T) -> $STEP(E.InsertAfter{$HH, x}):
  VD.vstep(~T, $VA, E.InsertAfter{$HH, x}, {==}, {==}, ho => hlt => HL.ins_hi(~T, $VA, x, True{}, ho, hlt), ho => hlt => hv => HL.ins_none(~T, $VA, x, True{}, ho, hlt, hv), ho => hlt => vv => hv => hgen => HL.with_split(~T, $VA, E.InsertAfter{$HH, x}, vv, hv, a => b => hg2 => HI.ia_ab(~T, $ABW(hg2), one, h1, cz, hcz, hroom, ho, hlt, vv, hv, x)))

# ---- every operation ----

def get_h(~T: Data, $SQ, +h: E.Handle) -> $STEP(E.Get{h}):
  match h:
    case E.H{+owner, +id, +g}:
      get_ok(~T, $SQA, owner, id, g)

def set_h(~T: Data, $SQ, +h: E.Handle, +x: T) -> $STEP(E.Set{h, x}):
  match h:
    case E.H{+owner, +id, +g}:
      set_ok(~T, $SQA, owner, id, g, x)

def next_h(~T: Data, $SQ, +h: E.Handle) -> $STEP(E.Next{h}):
  match h:
    case E.H{+owner, +id, +g}:
      next_ok(~T, $SQA, owner, id, g)

def prev_h(~T: Data, $SQ, +h: E.Handle) -> $STEP(E.Prev{h}):
  match h:
    case E.H{+owner, +id, +g}:
      prev_ok(~T, $SQA, owner, id, g)

def remove_h(~T: Data, $SQ, +h: E.Handle) -> $STEP(E.Remove{h}):
  match h:
    case E.H{+owner, +id, +g}:
      remove_ok(~T, $SQA, owner, id, g)

def before_h(~T: Data, $SP, +h: E.Handle, +x: T) -> $STEP(E.InsertBefore{h, x}):
  match h:
    case E.H{+owner, +id, +g}:
      before_ok(~T, $SA, owner, id, g, x)

def after_h(~T: Data, $SP, +h: E.Handle, +x: T) -> $STEP(E.InsertAfter{h, x}):
  match h:
    case E.H{+owner, +id, +g}:
      after_ok(~T, $SA, owner, id, g, x)

def step_ok(~T: Data, $SP, +op: E.Op<T>) -> $STEP(op):
  match op:
    case E.Length{}:
      len_ok(~T, $SQA)
    case E.PushFront{+x}:
      front_ok(~T, $SA, x)
    case E.PushBack{+x}:
      back_ok(~T, $SA, x)
    case E.InsertBefore{+h, +x}:
      before_h(~T, $SA, h, x)
    case E.InsertAfter{+h, +x}:
      after_h(~T, $SA, h, x)
    case E.Remove{+h}:
      remove_h(~T, $SQA, h)
    case E.Get{+h}:
      get_h(~T, $SQA, h)
    case E.Set{+h, +x}:
      set_h(~T, $SQA, h, x)
    case E.Next{+h}:
      next_h(~T, $SQA, h)
    case E.Prev{+h}:
      prev_h(~T, $SQA, h)
    case E.ToList{}:
      list_ok(~T, $SQA)
