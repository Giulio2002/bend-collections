# Insertion at the next fresh id, over the ready trees (the storage's own,
# or its doubled blocks).


def fv_lt(+fresh: U32, +cap: U32, +d: Nat, +hcap: {Nat.is_eq(UD.v(cap), SC.pow2(d)) == True{} : Bool}, +hlt: {Nat.is_lt(UD.v(fresh), UD.v(cap)) == True{} : Bool}) -> {Nat.is_lt(UD.v(fresh), SC.pow2(d)) == True{} : Bool}:
  L.subst(Nat, z => {Nat.is_lt(UD.v(fresh), z) == True{} : Bool}, UD.v(cap), SC.pow2(d), N.eq_from_is_eq(UD.v(cap), SC.pow2(d), hcap), hlt)

# the value of the next fresh counter
def inc_v(+one: Nat, +h1: {one == 1n : Nat}, +fresh: U32, +d: Nat, +hd: {Nat.is_lt(d, 30n) == True{} : Bool}, +h: {Nat.is_lt(UD.v(fresh), SC.pow2(d)) == True{} : Bool}) -> {UD.v(U32.inc(fresh)) == 1n+UD.v(fresh) : Nat}:
  W32.inc_val(one, h1, fresh, W32.bound32(one, h1, UD.v(fresh), d, RL.hd1(d, hd), h))

