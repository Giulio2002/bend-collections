# the one-pass seal is seal_ref
law seal_fused:
  for +key: List<&2, U32>
  for +nonce: List<&2, U32>
  for +aad: List<&2, U32>
  for +pt: List<&2, U32>
  {I.seal(key, nonce, aad, pt) == I.seal_ref(key, nonce, aad, pt) : List<&2, U32>}

def seal_fused(key, nonce, aad, pt):
  sealq(I.poly_key(key, nonce), aad, pt, CH.key(key), CH.nonce(nonce))

