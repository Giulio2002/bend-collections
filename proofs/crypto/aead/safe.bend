# seal(key, nonce, aad, pt), the one-pass ChaCha20-Poly1305 seal
def ok_seal(+key: List<&2, U32>, +nonce: List<&2, U32>, +aad: List<&2, U32>, +pt: List<&2, U32>) -> Bool:
  ok_sell(P.pad(32n, I.poly_key(key, nonce)), aad, pt, CH.key(key), CH.nonce(nonce))

def seal_mirror(+key: List<&2, U32>, +nonce: List<&2, U32>, +aad: List<&2, U32>, +pt: List<&2, U32>) -> {I.seal(key, nonce, aad, pt) == I.sell(P.pad(32n, I.poly_key(key, nonce)), aad, pt, CH.key(key), CH.nonce(nonce)) : List<&2, U32>}:
  {==}

# seal (and so encrypt, xseal and xencrypt): every Nat its Poly1305 part
# computes is below 2^48, for every key, nonce, aad and plaintext
law safe_seal:
  for +key: List<&2, U32>
  for +nonce: List<&2, U32>
  for +aad: List<&2, U32>
  for +pt: List<&2, U32>
  {ok_seal(key, nonce, aad, pt) == True{} : Bool}

def safe_seal(key, nonce, aad, pt):
  sell_safe(I.poly_key(key, nonce), aad, pt, CH.key(key), CH.nonce(nonce))


