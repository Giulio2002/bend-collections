def ok_sell(+pk: List<&2, U32>, +aad: List<&2, U32>, +pt: List<&2, U32>, +k: CH.Key, +n: CH.Nonce) -> Bool:
  match pk:
    case k0 <> k1 <> k2 <> k3 <> k4 <> k5 <> k6 <> k7 <> k8 <> k9 <> k10 <> k11 <> k12 <> k13 <> k14 <> k15 <> k16 <> k17 <> k18 <> k19 <> k20 <> k21 <> k22 <> k23 <> k24 <> k25 <> k26 <> k27 <> k28 <> k29 <> k30 <> k31 <> rest: ok_selk(k0, k1, k2, k3, k4, k5, k6, k7, k8, k9, k10, k11, k12, k13, k14, k15, k16, k17, k18, k19, k20, k21, k22, k23, k24, k25, k26, k27, k28, k29, k30, k31, aad, pt, k, n)
    case _: True{}

def sell_safe(+pk: List<&2, U32>, +aad: List<&2, U32>, +pt: List<&2, U32>, +k: CH.Key, +n: CH.Nonce) -> {ok_sell(P.pad(32n, pk), aad, pt, k, n) == True{} : Bool}:
  selk_safe(P.kh(pk), P.kh(P.tl(pk)), P.kh(P.tl(P.tl(pk))), P.kh(P.tl(P.tl(P.tl(pk)))), P.kh(P.tl(P.tl(P.tl(P.tl(pk))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(pk)))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk)))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk))))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk)))))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk))))))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk)))))))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk))))))))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk)))))))))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk))))))))))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk)))))))))))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk))))))))))))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk)))))))))))))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk))))))))))))))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk)))))))))))))))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk))))))))))))))))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk)))))))))))))))))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk))))))))))))))))))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk)))))))))))))))))))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.