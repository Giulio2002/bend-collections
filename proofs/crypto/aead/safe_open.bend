# open(key, nonce, aad, data), the ChaCha20-Poly1305 open
def ok_open(+key: List<&2, U32>, +nonce: List<&2, U32>, +aad: List<&2, U32>, +data: List<&2, U32>) -> Bool:
  match data:
    case y0 <> y1 <> y2 <> y3 <> y4 <> y5 <> y6 <> y7 <> y8 <> y9 <> y10 <> y11 <> y12 <> y13 <> y14 <> y15 <> rest: ok_osel(P.pad(32n, I.poly_key(key, nonce)), aad, rest, data, CH.key(key), CH.nonce(nonce))
    case _: True{}

# open (and so decrypt, xopen and xdecrypt): every Nat its Poly1305 part
# computes is below 2^48, for every key, nonce, aad and data
law safe_open:
  for +key: List<&2, U32>
  for +nonce: List<&2, U32>
  for +aad: List<&2, U32>
  for +data: List<&2, U32>
  {ok_open(key, nonce, aad, data) == True{} : Bool}

def safe_open(key, nonce, aad, data):
  match data:
    case Nil{}: {==}
    case +y0 <> +t0:
      match t0:
        case Nil{}: {==}
        case +y1 <> +t1:
          match t1:
            case Nil{}: {==}
            case +y2 <> +t2:
              match t2:
                case Nil{}: {==}
                case +y3 <> +t3:
                  match t3:
                    case Nil{}: {==}
                    case +y4 <> +t4:
                      match t4:
                        case Nil{}: {==}
                        case +y5 <> +t5:
                          match t5:
                            case Nil{}: {==}
                            case +y6 <> +t6:
                              match t6:
                                case Nil{}: {==}
                                case +y7 <> +t7:
                                  match t7:
                                    case Nil{}: {==}
                                    case +y8 <> +t8:
                                      match t8:
                                        case Nil{}: {==}
                                        case +y9 <> +t9:
                                          match t9:
                                            case Nil{}: {==}
                                            case +y10 <> +t10:
                                              match t10:
                                                case Nil{}: {==}
                                                case +y11 <> +t11:
                                                  match t11:
                                                    case Nil{}: {==}
                                                    case +y12 <> +t12:
                                                      match t12:
                                                        case Nil{}: {==}
                                                        case +y13 <> +t13:
                                                          match t13:
                                                            case Nil{}: {==}
                                                            case +y14 <> +t14:
                                                              match t14:
                                                                case Nil{}: {==}
                                                                case +y15 <> +rest:
                                                                  osel_safe(I.poly_key(key, nonce), aad, rest, y0 <> y1 <> y2 <> y3 <> y4 <> y5 <> y6 <> y7 <> y8 <> y9 <> y10 <> y11 <> y12 <> y13 <> y14 <> y15 <> rest, CH.key(key), CH.nonce(nonce))
