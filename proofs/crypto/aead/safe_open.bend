# I.osela: the tag pass after the aad's accumulator a (the plaintext pass
# computes no Nat)
def ok_osela(+pone: Nat, +kk: L.K, +sv: L.F, +a: P.A, +lead: List<&2, U32>, +xs: List<&2, U32>, +k: CH.Key, +n: CH.Nonce) -> Bool:
  match a lead:
    case P.A{h, la} Nil{}: SL.ok_tag_len(pone, kk, sv, la, P.absorb_pad(pone, Nil{}, kk, h, 0n))
    case P.A{h, la} +l <> +lt: ok_opoly(List.length(&2, U32, l <> lt), I.nblk(l <> lt), xs, pone, kk, sv, la, h, 0n)

def osela_safe(+pone: Nat, +hp: {pone == 1n : Nat}, +one: Nat, +h1: {one == 1n : Nat}, +r0: Nat, +r1: Nat, +r2: Nat, +r3: Nat, +r4: Nat, +kk: L.K, +hk: {kk == L.key(L.F{r0, r1, r2, r3, r4}) : L.K}, +hr0: {C.fits(26n, r0) == True{} : Bool}, +hr1: {C.fits(26n, r1) == True{} : Bool}, +hr2: {C.fits(26n, r2) == True{} : Bool}, +hr3: {C.fits(26n, r3) == True{} : Bool}, +hr4: {C.fits(26n, r4) == True{} : Bool}, +sv: L.F, +hs: {B.lim(26n, sv) == True{} : Bool}, +a: P.A, +ha: {B.lim(27n, SL.ah(a)) == True{} : Bool}, +lead: List<&2, U32>, +xs: List<&2, U32>, +k: CH.Key, +n: CH.Nonce) -> {ok_osela(pone, kk, sv, a, lead, xs, k, n) == True{} : Bool}:
  match a lead:
    case P.A{+h, +la} Nil{}: SL.tag_len_safe(pone, hp, one, h1, r0, r1, r2, r3, r4, kk, hk, hr0, hr1, hr2, hr3, hr4, sv, hs, la, P.absorb_pad(pone, Nil{}, kk, h, 0n), SL.pad_inv(pone, hp, one, h1, r0, r1, r2, r3, r4, kk, hk, hr0, hr1, hr2, hr3, hr4, Nil{}, h, 0n, ha))
    case P.A{+h, +la} +l <> +lt: opoly_safe(List.length(&2, U32, l <> lt), I.nblk(l <> lt), xs, pone, hp, one, h1, r0, r1, r2, r3, r4, kk, hk, hr0, hr1, hr2, hr3, hr4, sv, hs, la, h, ha, 0n)

# I.oselk
def ok_oselk(+k0: U32, +k1: U32, +k2: U32, +k3: U32, +k4: U32, +k5: U32, +k6: U32, +k7: U32, +k8: U32, +k9: U32, +k10: U32, +k11: U32, +k12: U32, +k13: U32, +k14: U32, +k15: U32, +k16: U32, +k17: U32, +k18: U32, +k19: U32, +k20: U32, +k21: U32, +k22: U32, +k23: U32, +k24: U32, +k25: U32, +k26: U32, +k27: U32, +k28: U32, +k29: U32, +k30: U32, +k31: U32, +aad: List<&2, U32>, +lead: List<&2, U32>, +xs: List<&2, U32>, +k: CH.Key, +n: CH.Nonce) -> Bool:
  +r = P.r_of(k0, k1, k2, k3, k4, k5, k6, k7, k8, k9, k10, k11, k12, k13, k14, k15)
  +kk = L.key(r)
