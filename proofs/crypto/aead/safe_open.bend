def opoly_safe(+fuel: Nat, +nb: Nat, +xs: List<&2, U32>, +pone: Nat, +hp: {pone == 1n : Nat}, +one: Nat, +h1: {one == 1n : Nat}, +r0: Nat, +r1: Nat, +r2: Nat, +r3: Nat, +r4: Nat, +kk: L.K, +hk: {kk == L.key(L.F{r0, r1, r2, r3, r4}) : L.K}, +hr0: {C.fits(26n, r0) == True{} : Bool}, +hr1: {C.fits(26n, r1) == True{} : Bool}, +hr2: {C.fits(26n, r2) == True{} : Bool}, +hr3: {C.fits(26n, r3) == True{} : Bool}, +hr4: {C.fits(26n, r4) == True{} : Bool}, +sv: L.F, +hs: {B.lim(26n, sv) == True{} : Bool}, +la: Nat, +h: L.F, +hh: {B.lim(27n, h) == True{} : Bool}, +cnt: Nat) -> {ok_opoly(fuel, nb, xs, pone, kk, sv, la, h, cnt) == True{} : Bool}:
  match fuel:
    case 0n: otag_safe(xs, pone, hp, one, h1, r0, r1, r2, r3, r4, kk, hk, hr0, hr1, hr2, hr3, hr4, sv, hs, la, h, hh, cnt)
    case 1n++p:
      match nb:
        case 0n: otag_safe(xs, pone, hp, one, h1, r0, r1, r2, r3, r4, kk, hk, hr0, hr1, hr2, hr3, hr4, sv, hs, la, h, hh, cnt)
        case 1n++q:
          match xs:
            case Nil{}: otag_safe(Nil{}, pone, hp, one, h1, r0, r1, r2, r3, r4, kk, hk, hr0, hr1, hr2, hr3, hr4, sv, hs, la, h, hh, cnt)
            case +x0 <> +t0:
              match t0:
                case Nil{}: otag_safe(x0 <> Nil{}, pone, hp, one, h1, r0, r1, r2, r3, r4, kk, hk, hr0, hr1, hr2, hr3, hr4, sv, hs, la, h, hh, cnt)
                case +x1 <> +t1:
                  match t1:
                    case Nil{}: otag_safe(x0 <> x1 <> Nil{}, pone, hp, one, h1, r0, r1, r2, r3, r4, kk, hk, hr0, hr1, hr2, hr3, hr4, sv, hs, la, h, hh, cnt)
