  oselk_safe(P.kh(pk), P.kh(P.tl(pk)), P.kh(P.tl(P.tl(pk))), P.kh(P.tl(P.tl(P.tl(pk)))), P.kh(P.tl(P.tl(P.tl(P.tl(pk))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(pk)))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk)))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk))))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk)))))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk))))))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk)))))))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk))))))))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk)))))))))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk))))))))))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk)))))))))))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk))))))))))))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk)))))))))))))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk))))))))))))))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk)))))))))))))))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk))))))))))))))))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk)))))))))))))))))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk))))))))))))))))))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(pk)))))))))))))))))))))))), P.kh(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P.tl(P