def c3_lt(+x: U32, +h: {Nat.is_lt(U32.to_nat(x), 256n) == True{} : Bool}) -> {Nat.is_lt(U32.to_nat(PH.c3(x)), 4n) == True{} : Bool}:
  %LW.rt(x) : {Nat.is_lt(U32.to_nat(PH.c3(_)), 4n) == True{} : Bool}
  c3_n(U32.to_nat(x), h)

def and3_lt(+x: U32) -> {Nat.is_lt(U32.to_nat(U32.and(x, 3)), 4n) == True{} : Bool}:
  N.le_lt_succ(U32.to_nat(U32.and(x, 3)), 3n, HH.and_le32(x, 3))

def c2_lt(+x: U32) -> {Nat.is_lt(U32.to_nat(PH.c2(x)), 4n) == True{} : Bool}:
  and3_lt(U32.shrn(x, 4n))

def c1_lt(+x: U32) -> {Nat.is_lt(U32.to_nat(PH.c1(x)), 4n) == True{} : Bool}:
  and3_lt(U32.shrn(x, 2n))

def c0_lt(+x: U32) -> {Nat.is_lt(U32.to_nat(PH.c0(x)), 4n) == True{} : Bool}:
  and3_lt(x)

def byte_rt(+x: U32, +h: {Nat.is_lt(U32.to_nat(x), 256n) == True{} : Bool}) -> {PH.byte_of(PH.c3(x), PH.c2(x), PH.c1(x), PH.c0(x)) == x : U32}:
  %LW.rt(x) : {PH.byte_of(PH.c3(_), PH.c2(_), PH.c1(_), PH.c0(_)) == _ : U32}
  byte_n(U32.to_nat(x), h)

