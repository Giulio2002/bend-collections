# The PHC string of an Argon2id hash parses back to its fields: base64 and
# decimal round trips, and the '$'-separated fields. Every finite fact
# (a crumb, a base64 digit, a decimal digit) is checked value by value.

# Every byte is below 256.
def ok(bs: List<&2, U32>) -> Bool:
  match bs:
    case Nil{}:
      True{}
    case x <> r:
      Bool.and(Nat.is_lt(U32.to_nat(x), 256n), ok(r))

def ok_head(+x: U32, +r: List<&2, U32>, +h: {ok(x <> r) == True{} : Bool}) -> {Nat.is_lt(U32.to_nat(x), 256n) == True{} : Bool}:
  L.and_left(Nat.is_lt(U32.to_nat(x), 256n), ok(r), h)

def ok_tail(+x: U32, +r: List<&2, U32>, +h: {ok(x <> r) == True{} : Bool}) -> {ok(r) == True{} : Bool}:
  L.and_right(Nat.is_lt(U32.to_nat(x), 256n), ok(r), h)

def u(+n: Nat) -> U32:
  U32.from_nat(n)

