def get_eq(+d: Nat, +ws: List<&2, U32>, +b: Nat, +hd: {Nat.is_lt(d, 32n) == True{} : Bool}, +hl: {SC.length(U32, ws) == SC.pow2(d) : Nat}, +h: {Nat.is_le(Nat.add(256n, Nat.mul(b, 256n)), SC.pow2(d)) == True{} : Bool}) -> {X.get(b, AR.thaw(U32, MEM.tree(d, ws))) == (AR.thaw(U32, MEM.tree(d, ws)), A.B{rowl(SC.drop(U32, ws, Nat.mul(b, 256n))), rowl(SC.drop(U32, ws, Nat.add(32n, Nat.mul(b, 256n)))), rowl(SC.drop(U32, ws, Nat.add(64n, Nat.mul(b, 256n)))), rowl(SC.drop(U32, ws, Nat.add(96n, Nat.mul(b, 256n)))), rowl(SC.drop(U32, ws, Nat.add(128n, Nat.mul(b, 256n)))), rowl(SC.drop(U32, ws, Nat.add(160n, Nat.mul(b, 256n)))), rowl(SC.drop(U32, ws, Nat.add(192n, Nat.mul(b, 256n)))), rowl(SC.drop(U32, ws, Nat.add(224n, Nat.mul(b, 256n))))}) : Array<U32> & A.Block}:
  +i = Nat.mul(b, 256n)
  %Equal.sym(Array<U32> & T.State, X.row(i, AR.thaw(U32, MEM.tree(d, ws))), (AR.thaw(U32, MEM.tree(d, ws)), rowl(SC.drop(U32, ws, i))), row_eq(d, ws, i, hd, hl, le_k(32n, i, SC.pow2(d), {==}, h))) : {X.rd0(i, _) == (AR.thaw(U32, MEM.tree(d, ws)), A.B{rowl(SC.drop(U32, ws, Nat.mul(b, 256n))), rowl(SC.drop(U32, ws, Nat.add(32n, Nat.mul(b, 256n)))), rowl(SC.drop(U32, ws, Nat.add(64n, Nat.mul(b, 256n)))), rowl(SC.drop(U32, ws, Nat.add(96n, Nat.mul(b, 256n)))), rowl(SC.drop(U32, ws, Nat.add(128n, Nat.mul(b, 256n)))), rowl(SC.drop(U32, ws, Nat.add(160n, Nat.mul(b, 256n)))), rowl(SC.drop(U32, ws, Nat.add(192n, Nat.mul(b, 256n)))), rowl(SC.drop(U32, ws, Nat.add(224n, Nat.mul(b, 256n))))}) : Array<U32> & A.Block}
  rd0_eq(d, ws, i, hd, hl, h)

# ---------------------------------------------------------------- a block's words

def rowl_app(+r: T.State, +x: List<&2, U32>, +e: List<&2, U32>) -> {rowl(SC.append(U32, SB.app(SB.row_words(r), x), e)) == r : T.State}:
  match r:
    case T.V{T.W{l0, l1}, T.W{l2, l3}, T.W{l4, l5}, T.W{l6, l7}, T.W{l8, l9}, T.W{l10, l11}, T.W{l12, l13}, T.W{l14, l15}, T.W{l16, l17}, T.W{l18, l19}, T.W{l20, l21}, T.W{l22, l23}, T.W{l24, l25}, T.W{l26, l27}, T.W{l28, l29}, T.W{l30, l31}}:
      {==}

def drop_row(+r: T.State, +x: List<&2, U32>, +e: List<&2, U32>) -> {SC.drop(U32, SC.append(U32, SB.app(SB.row_words(r), x), e), 32n) == SC.append(U32, x, e) : List<&2, U32>}:
  match r:
    case T.V{T.W{l0, l1}, T.W{l2, l3}, T.W{l4, l5}, T.W{l6, l7}, T.W{l8, l9}, T.W{l10, l11}, T.W{l12, l13}, T.W{l14, l15}, T.W{l16, l17}, T.W{l18, l19}, T.W{l20, l21}, T.W{l22, l23}, T.W{l24, l25}, T.W{l26, l27}, T.W{l28, l29}, T.W{l30, l31}}:
      Equal.trans(List<&2, U32>, SC.drop(U32, SC.append(U32, SB.app(SB.row_words(T.V{T.W{l0, l1}, T.W{l2, l3}, T.W{l4, l5}, T.W{l6, l7}, T.W{l8, l9}, T.W{l10, l11}, T.W{l12, l13}, T.W{l14, l15}, T.W{l16, l17}, T.W{l18, l19}, T.W{l20, l21}, T.W{l22, l23}, T.W{l24, l25}, T.W{l26, l27}, T.W{l28, l29}, T.W{l30, l31}}), x), e), 32n), SC.drop(U32, SC.append(U32, x, e), 0n), SC.append(U32, x, e), {==}, MEM.drop_zero(SC.append(U32, x, e)))

# ---------------------------------------------------------------- writing

# Storing a row with MEM.wr is X.wrow, and wr goes on at i + 32.
def wr_row(+r: T.State, +x: List<&2, U32>, +i: Nat, -a: Array<U32>) -> {MEM.wr(SB.app(SB.row_words(r), x), i, a) == MEM.wr(x, X.nx(i), X.wrow(r, i, a)) : Array<U32>}:
  match r:
    case T.V{T.W{l0, l1}, T.W{l2, l3}, T.W{l4, l5}, T.W{l6, l7}, T.W{l8, l9}, T.W{l10, l11}, T.W{l12, l13}, T.W{l14, l15}, T.W{l16, l17}, T.W{l18, l19}, T.W{l20, l21}, T.W{l22, l23}, T.W{l24, l25}, T.W{l26, l27}, T.W{l28, l29}, T.W{l30, l31}}:
      {==}

# X.put is MEM.wr of the block's words.
