  {P.key11(kk,t,h,last,w0,w1,w2,w3,w4,w5,w6,w7,w8,w9,w10,pair) == S.compress(h,S.lanes(S.trim(S.read(20n,12,[w10,w9,w8,w7,w6,w5,w4,w3,w2,w1,w0],pair),0n,kk)),t,last) : T.Chain}

