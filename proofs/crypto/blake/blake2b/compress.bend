law start_correct:
  for +h: T.Chain
  for +t: T.Counter
  {I.start(h,t) == S.start(h,t,False{}) : T.State}

def start_correct(h,t):
  match h t:
    case T.H{T.W{g0,e0},T.W{g1,e1},T.W{g2,e2},T.W{g3,e3},T.W{g4,e4},T.W{g5,e5},T.W{g6,e6},T.W{g7,e7}} T.C{t0,t1,t2,t3}: {==}

law start_last_correct:
  for +h: T.Chain
  for +t: T.Counter
  {I.start_last(h,t) == S.start(h,t,True{}) : T.State}

def start_last_correct(h,t):
  match h t:
    case T.H{T.W{g0,e0},T.W{g1,e1},T.W{g2,e2},T.W{g3,e3},T.W{g4,e4},T.W{g5,e5},T.W{g6,e6},T.W{g7,e7}} T.C{t0,t1,t2,t3}: {==}

law finish_correct:
