  {I.read1(index,t,h,w0,pair) == S.gather(30n,index,2,False{},0n,t,h,[w0],pair) : Array<U32> & T.Chain}

def read1_correct(index,t,h,w0,pair):
  (a,w1) = pair
  read2_correct(index,t,h,w0,w1,Array.get(U32,a,U32.add(index,2)))

law read0_correct:
  for +index: U32
  for +t: T.Counter
  for +h: T.Chain
  for pair: Array<U32> & U32
  {I.read0(index,t,h,pair) == S.gather(31n,index,1,False{},0n,t,h,[],pair) : Array<U32> & T.Chain}

def read0_correct(index,t,h,pair):
  (a,w0) = pair
  read1_correct(index,t,h,w0,Array.get(U32,a,U32.add(index,1)))

law absorb_correct:
  for a: Array<U32>
  for +index: U32
  for +t: T.Counter
  for +h: T.Chain
  {I.absorb(a,index,t,h) == S.absorb(a,index,t,h) : Array<U32> & T.Chain}

def absorb_correct(a,index,t,h):
  read0_correct(index,t,h,Array.get(U32,a,index))

law keep_correct:
  for +w: U32
  for +n: Nat
  {I.keep(w,n) == S.keep(w,n) : U32}

def keep_correct(w,n):
  match n:
    case 0n: {==}
    case 1n: {==}
    case 2n: {==}
    case 3n: {==}
    case 4n+p: {==}

