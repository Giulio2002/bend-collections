law last7_correct:
  for +remain: Nat
  for +index: U32
  for +t: T.Counter
  for +h: T.Chain
  for +w0: U32
  for +w1: U32
  for +w2: U32
  for +w3: U32
  for +w4: U32
  for +w5: U32
  for +w6: U32
  for pair: Array<U32> & U32
  {I.last7(remain,index,t,h,w0,w1,w2,w3,w4,w5,w6,pair) == Pair.snd(Array<U32>,T.Chain,S.gather(24n,index,8,True{},remain,t,h,[w6,w5,w4,w3,w2,w1,w0],pair)) : T.Chain}

