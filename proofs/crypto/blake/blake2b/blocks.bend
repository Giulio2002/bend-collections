law final_correct:
  for a: Array<U32>
  for +index: U32
  for +remain: Nat
  for +t: T.Counter
  for +h: T.Chain
  {I.final(a,index,remain,t,h) == S.final(a,index,remain,t,h) : T.Chain}

def final_correct(a,index,remain,t,h):
  %Equal.sym(T.Counter,F.bump(t,U32.from_nat(remain)),S.advance(t,U32.from_nat(remain)),C.bump_correct(t,U32.from_nat(remain))) : {I.last0(remain,index,_,h,Array.get(U32,a,index)) == S.final(a,index,remain,t,h) : T.Chain}
  last0_correct(remain,index,S.advance(t,U32.from_nat(remain)),h,Array.get(U32,a,index))

law blocks_step:
  for +n: Nat
  for +index: U32
  for +remain: Nat
  for +t: T.Counter
  for -a: Array<U32>
  for +h: T.Chain
  for view: Sigma<&2,&1,A.Tree,z => {a == A.thaw(z) : Array<U32>}>
  for recurse: @pair: (Array<U32> & T.Chain) -> {I.blocks(n,U32.add(index,32),remain,S.advance(t,128),pair) == S.blocks(n,U32.add(index,32),remain,S.advance(t,128),pair) : T.Chain}
  {I.blocks(1n+n,index,remain,t,(a,h)) == S.blocks(1n+n,index,remain,t,(a,h)) : T.Chain}

def blocks_step(n,index,remain,t,a,h,view,recurse):
  match view:
    case Tuple{+tree,pf}:
      %Equal.sym(Array<U32>,a,A.thaw(tree),pf) : {I.blocks(1n+n,index,remain,t,(_,h)) == S.blocks(1n+n,index,remain,t,(_,h)) : T.Chain}
      %Equal.sym(T.Counter,F.bump(t,128),S.advance(t,128),C.bump_correct(t,128)) : {I.blocks(n,U32.add(index,32),remain,_,I.absorb(A.thaw(tree),index,_,h)) == S.blocks(1n+n,index,remain,t,(A.thaw(tree),h)) : T.Chain}
      Equal.trans(T.Chain,
        I.blocks(n,U32.add(index,32),remain,S.advance(t,128),I.absorb(A.thaw(tree),index,S.advance(t,128),h)),
        S.blocks(n,U32.add(index,32),remain,S.advance(t,128),I.absorb(A.thaw(tree),index,S.advance(t,128),h)),
        S.blocks(n,U32.add(index,32),remain,S.advance(t,128),S.absorb(A.thaw(tree),index,S.advance(t,128),h)),
        recurse(I.absorb(A.thaw(tree),index,S.advance(t,128),h)),
        Equal.cong(Array<U32> & T.Chain,T.Chain,pair => S.blocks(n,U32.add(index,32),remain,S.advance(t,128),pair),
          I.absorb(A.thaw(tree),index,S.advance(t,128),h),S.absorb(A.thaw(tree),index,S.advance(t,128),h),absorb_correct(A.thaw(tree),index,S.advance(t,128),h)))

law blocks_correct:
  for +n: Nat
  for +index: U32
  for +remain: Nat
  for +t: T.Counter
  for pair: Array<U32> & T.Chain
  {I.blocks(n,index,remain,t,pair) == S.blocks(n,index,remain,t,pair) : T.Chain}

def blocks_correct(n,index,remain,t,pair):
  match n pair:
    case 0n Tuple{a,h}: final_correct(a,index,remain,t,h)
    case 1n+p Tuple{a,h}:
      blocks_step(p,index,remain,t,a,h,A.reify(a),pair => blocks_correct(p,U32.add(index,32),remain,S.advance(t,128),pair))

law unchecked_correct:
  for a: Array<U32>
  for +length: Nat
  {I.unchecked(a,length) == S.unchecked(a,length) : T.Chain}

def unchecked_correct(a,length):
  blocks_correct(Nat.div(Nat.sub(length,1n),128n),0,Nat.sub(length,Nat.mul(Nat.div(Nat.sub(length,1n),128n),128n)),T.C{0,0,0,0},(a,I.initial()))

law digest_correct:
  for +h: T.Chain
  {I.digest(h) == S.digest(h) : Array<U32>}

def digest_correct(h):
  match h:
    case T.H{T.W{l0,u0},T.W{l1,u1},T.W{l2,u2},T.W{l3,u3},T.W{l4,u4},T.W{l5,u5},T.W{l6,u6},T.W{l7,u7}}: {==}

law checked_true_reified:
  for -a: Array<U32>
  for +length: Nat
  for view: Sigma<&2,&1,A.Tree,z => {a == A.thaw(z) : Array<U32>}>
  {I.checked(True{},a,length) == S.checked(True{},a,length) : Maybe<&1,Array<U32>>}

def checked_true_reified(a,length,view):
  match view:
    case Tuple{+tree,pf}:
      %Equal.sym(Array<U32>,a,A.thaw(tree),pf) : {I.checked(True{},_,length) == S.checked(True{},_,length) : Maybe<&1,Array<U32>>}
      Equal.trans(Maybe<&1,Array<U32>>,
        Some{I.digest(I.unchecked(A.thaw(tree),length))},
        Some{I.digest(S.unchecked(A.thaw(tree),length))},
        Some{S.digest(S.unchecked(A.thaw(tree),length))},
        Equal.cong(T.Chain,Maybe<&1,Array<U32>>,x => Some{I.digest(x)},I.unchecked(A.thaw(tree),length),S.unchecked(A.thaw(tree),length),unchecked_correct(A.thaw(tree),length)),
        Equal.cong(Array<U32>,Maybe<&1,Array<U32>>,x => Some{x},I.digest(S.unchecked(A.thaw(tree),length)),S.digest(S.unchecked(A.thaw(tree),length)),digest_correct(S.unchecked(A.thaw(tree),length))))

law checked_correct:
  for +valid: Bool
  for a: Array<U32>
  for +length: Nat
  {I.checked(valid,a,length) == S.checked(valid,a,length) : Maybe<&1,Array<U32>>}

def checked_correct(valid,a,length):
  match valid:
    case False{}: {==}
    case True{}: checked_true_reified(a,length,A.reify(a))

law sized_correct:
  for +length: Nat
  for pair: Array<U32> & U32
  {I.sized(length,pair) == S.sized(length,pair) : Maybe<&1,Array<U32>>}

def sized_correct(length,pair):
  (a,capacity) = pair
  checked_correct(Nat.is_le(length,Nat.mul(4n,U32.to_nat(capacity))),a,length)

law blake2b_correct:
  for words: Array<U32>
  for +byte_length: Nat
  {I.blake2b(words,byte_length) == S.blake2b(words,byte_length) : Maybe<&1,Array<U32>>}

def blake2b_correct(words,byte_length):
  sized_correct(byte_length,Array.size(U32,words))
