# The bytes at message offsets i..i+3 of one word, zeroed from offset len on.
def kept(+w: U32, +i: Nat, +len: Nat) -> U32:
  R.word(R.keep_if(Nat.is_lt(i,len),R.byte(w,0n)),R.keep_if(Nat.is_lt(1n+i,len),R.byte(w,1n)),R.keep_if(Nat.is_lt(2n+i,len),R.byte(w,2n)),R.keep_if(Nat.is_lt(3n+i,len),R.byte(w,3n)))

law pad_word_correct:
  for +w: U32
  for +i: Nat
  for +len: Nat
  {kept(w,i,len) == K.pad_word(w,i,len) : U32}

def pad_word_correct(w,i,len):
  match i len:
    case 0n 0n: {==}
    case 0n 1n: part1(w)
    case 0n 2n: part2(w)
    case 0n 3n: part3(w)
    case 0n 4n+p: full(w)
    case 1n+j 0n: {==}
    case 1n+j 1n+l: pad_word_correct(w,j,l)

# Whole blocks: reassembling the serialized words gives the words back.
law words_serialize:
  for +ws: List<&2,U32>
  {R.words(R.serialize(ws)) == ws : List<&2,U32>}

def words_serialize(ws):
  match ws:
    case Nil{}: {==}
    case w <> rest:
      Equal.trans(List<&2,U32>,
        R.words(R.serialize(w <> rest)),
        R.word(R.byte(w,0n),R.byte(w,1n),R.byte(w,2n),R.byte(w,3n)) <> rest,
        w <> rest,
        Equal.cong(List<&2,U32>,List<&2,U32>,t => R.word(R.byte(w,0n),R.byte(w,1n),R.byte(w,2n),R.byte(w,3n)) <> t,R.words(R.serialize(rest)),rest,words_serialize(rest)),
        Equal.cong(U32,List<&2,U32>,x => x <> rest,R.word(R.byte(w,0n),R.byte(w,1n),R.byte(w,2n),R.byte(w,3n)),w,full(w)))

# The last block: the implementation masks word j with pad_word(w, i + 4j, len).
def masked(ws: List<&2,U32>, +i: Nat, +len: Nat) -> List<&2,U32>:
  match ws:
    case Nil{}: Nil{}
    case w <> rest: K.pad_word(w,i,len) <> masked(rest,4n+i,len)

law words_pad:
  for +ws: List<&2,U32>
  for +i: Nat
  for +len: Nat
  {R.words(R.pad(R.serialize(ws),i,len)) == masked(ws,i,len) : List<&2,U32>}

def words_pad(ws,i,len):
  match ws:
    case Nil{}: {==}
    case w <> rest:
      Equal.trans(List<&2,U32>,
        R.words(R.pad(R.serialize(w <> rest),i,len)),
        kept(w,i,len) <> masked(rest,4n+i,len),
        K.pad_word(w,i,len) <> masked(rest,4n+i,len),
        Equal.cong(List<&2,U32>,List<&2,U32>,t => kept(w,i,len) <> t,R.words(R.pad(R.serialize(rest),4n+i,len)),masked(rest,4n+i,len),words_pad(rest,4n+i,len)),
        Equal.cong(U32,List<&2,U32>,x => x <> masked(rest,4n+i,len),kept(w,i,len),K.pad_word(w,i,len),pad_word_correct(w,i,len)))
