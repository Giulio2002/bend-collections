  {K.pad1(remain,index,h,t0,t1,w0,pair) == R.last_block(10n,R.gather(14n,index,2,[w0],pair),remain,h,t0,u1) : T.State}

def pad1_correct(remain,index,h,t0,t1,u1,e,w0,pair):
  (a,w1) = pair
