  {K.pad3(remain,index,h,t0,t1,w0,w1,w2,pair) == R.last_block(10n,R.gather(12n,index,4,[w2,w1,w0],pair),remain,h,t0,u1) : T.State}

def pad3_correct(remain,index,h,t0,t1,u1,e,w0,w1,w2,pair):
  (a,w3) = pair
  pad4_correct(remain,index,h,t0,t1,u1,e,w0,w1,w2,w3,Array.get(U32,a,U32.add(index,4)))

law pad2_correct:
  for +remain: Nat
  for +index: U32
  for +h: T.State
  for +t0: U32
  for +t1: U32
  for +u1: U32
  for e: {t1 == u1 : U32}
  for +w0: U32
  for +w1: U32
  for pair: Array<U32> & U32
  {K.pad2(remain,index,h,t0,t1,w0,w1,pair) == R.last_block(10n,R.gather(13n,index,3,[w1,w0],pair),remain,h,t0,u1) : T.State}

def pad2_correct(remain,index,h,t0,t1,u1,e,w0,w1,pair):
  (a,w2) = pair
  pad3_correct(remain,index,h,t0,t1,u1,e,w0,w1,w2,Array.get(U32,a,U32.add(index,3)))

law pad1_correct:
