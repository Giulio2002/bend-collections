# A full block keeps all 64 bytes.
law zero_tail_full:
  for +b: T.Block
  {S.zero_tail(b,64n) == b : T.Block}

def zero_tail_full(b):
  match b:
    case T.B{m0,m1,m2,m3,m4,m5,m6,m7,m8,m9,m10,m11,m12,m13,m14,m15}: {==}
