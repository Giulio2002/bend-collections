law zeros_onto_correct:
  for +k: Nat
  for +acc: List<&2, U32>
  {C.zeros_onto(k, acc) == List.append(&2, U32, List.replicate(U32, k, 0), acc) : List<&2, U32>}

def zeros_onto_correct(k, acc):
  match k:
    case 0n:
      {==}
    case 1n+p:
      %zeros_onto_correct(p, acc) : {C.zeros_onto(1n+p, acc) == 0 <> _ : List<&2, U32>}
      {==}

law base256_onto_correct:
  for +w: Nat
  for +n: Nat
  for +acc: List<&2, U32>
  {C.base256_onto(w, n, acc) == List.append(&2, U32, C.base256(w, n), acc) : List<&2, U32>}

def base256_onto_correct(w, n, acc):
  match w:
    case 0n:
      {==}
    case 1n+p:
      +d = U32.from_nat(Nat.mod(n, 256n))
      +x = C.base256(p, Nat.div(n, 256n))
      Equal.trans(List<&2, U32>, C.base256_onto(p, Nat.div(n, 256n), d <> acc),
        List.append(&2, U32, x, d <> acc),
        List.append(&2, U32, List.append(&2, U32, x, [d]), acc),
        base256_onto_correct(p, Nat.div(n, 256n), d <> acc),
        Equal.sym(List<&2, U32>, List.append(&2, U32, List.append(&2, U32, x, [d]), acc),
          List.append(&2, U32, x, d <> acc), L.append_assoc(x, [d], acc)))

law suffix_fast_correct:
  for +n: Nat
  {C.suffix_fast(n) == C.suffix(n) : List<&2, U32>}

def suffix_fast_correct(n):
  +last = {[U32.shln(U32.from_nat(Nat.mod(n, 32n)), 3n)] : List<&2, U32>}
  +z = C.zeros(Nat.mod(n, 128n))
  %base256_onto_correct(15n, Nat.div(n, 32n), last) :
    {C.suffix_fast(n) == 128 <> List.append(&2, U32, List.replicate(U32, z, 0), _) : List<&2, U32>}
  %zeros_onto_correct(z, C.base256_onto(15n, Nat.div(n, 32n), last)) :
    {C.suffix_fast(n) == 128 <> _ : List<&2, U32>}
  {==}
