# The limb lists of src/crypto/secp256k1/limbs.bend and their values: every
# operation is exact on natural numbers (Fiat-Crypto's unsaturated limbs,
# Erbsen et al. 2019: the value of the limb list is the number; with Nat
# limbs there is no overflow to rule out in the value, and the run-time
# bound 2^48 is a separate statement). ev is the value without `one`;
# ev_value relates it to spec/crypto/secp256k1/field.bend's value.

def ev(xs: List<&2, Nat>) -> Nat:
  match xs:
    case Nil{}: 0n
    case x <> t: Nat.add(x, C.shift(16n, ev(t)))

# y at limb position n: y 2^(16 n)
def pos(n: Nat, +y: Nat) -> Nat:
  match n:
    case 0n: y
    case 1n+k: C.shift(16n, pos(k, y))

