  %Equal.sym(Nat, Nat.mul(Nat.div(Nat.div(s, 256n), 256n), 256n), C.shift(8n, Nat.div(Nat.div(s, 256n), 256n)), m256(Nat.div(Nat.div(s, 256n), 256n))) : {Nat.add(Nat.add(Nat.mod(s, 256n), C.shift(8n, Nat.mod(Nat.div(s, 256n), 256n))), C.shift(16n, Nat.div(Nat.div(s, 256n), 256n))) == Nat.add(C.shift(8n, Nat.add(_, Nat.mod(Nat.div(s, 256n), 256n))), Nat.mod(s, 256n)) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.mod(s, 256n), C.shift(8n, Nat.mod(Nat.div(s, 256n), 256n))), Nat.add(C.shift(8n, Nat.mod(Nat.div(s, 256n), 256n)), Nat.mod(s, 256n)), NA.add_comm(Nat.mod(s, 256n), C.shift(8n, Nat.mod(Nat.div(s, 256n), 256n)))) : {Nat.add(_, C.shift(16n, Nat.div(Nat.div(s, 256n), 256n))) == Nat.add(C.shift(8n, Nat.add(C.shift(8n, Nat.div(Nat.div(s, 256n), 256n)), Nat.mod(Nat.div(s, 256n), 256n))), Nat.mod(s, 256n)) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.add(C.shift(8n, Nat.mod(Nat.div(s, 256n), 256n)), Nat.mod(s, 256n)), C.shift(16n, Nat.div(Nat.div(s, 256n), 256n))), Nat.add(C.shift(8n, Nat.mod(Nat.div(s, 256n), 256n)), Nat.add(Nat.mod(s, 256n), C.shift(16n, Nat.div(Nat.div(s, 256n), 256n)))), NA.add_assoc(C.shift(8n, Nat.mod(Nat.div(s, 256n), 256n)), Nat.mod(s, 256n), C.shift(16n, Nat.div(Nat.div(s, 256n), 256n)))) : {_ == Nat.add(C.shift(8n, Nat.add(C.shift(8n, Nat.div(Nat.div(s, 256n), 256n)), Nat.mod(Nat.div(s, 256n), 256n))), Nat.mod(s, 256n)) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.mod(s, 256n), C.shift(16n, Nat.div(Nat.div(s, 256n), 256n))), Nat.add(C.shift(16n, Nat.div(Nat.div(s, 256n), 256n)), Nat.mod(s, 256n)), NA.add_comm(Nat.mod(s, 256n), C.shift(16n, Nat.div(Nat.div(s, 256n), 256n)))) : {Nat.add(C.shift(8n, Nat.mod(Nat.div(s, 256n), 256n)), _) == Nat.add(C.shift(8n, Nat.add(C.shift(8n, Nat.div(Nat.div(s, 256n), 256n)), Nat.mod(Nat.div(s, 256n), 256n))), Nat.mod(s, 256n)) : Nat}
  %Equal.sym(Nat, Nat.add(C.shift(8n, Nat.mod(Nat.div(s, 256n), 256n)), Nat.add(C.shift(16n, Nat.div(Nat.div(s, 256n), 256n)), Nat.mod(s, 256n))), Nat.add(C.shift(16n, Nat.div(Nat.div(s, 256n), 256n)), Nat.add(C.shift(8n, Nat.mod(Nat.div(s, 256n), 256n)), Nat.mod(s, 256n))), NA.add_swap(C.shift(8n, Nat.mod(Nat.div(s, 256n), 256n)), C.shift(16n, Nat.div(Nat.div(s, 256n), 256n)), Nat.mod(s, 256n))) : {_ == Nat.add(C.shift(8n, Nat.add(C.shift(8n, Nat.div(Nat.div(s, 256n), 256n)), Nat.mod(Nat.div(s, 256n), 256n))), Nat.mod(s, 256n)) : Nat}
  %Equal.sym(Nat, C.shift(8n, Nat.add(C.shift(8n, Nat.div(Nat.div(s, 256n), 256n)), Nat.mod(Nat.div(s, 256n), 256n))), Nat.add(C.shift(8n, C.shift(8n, Nat.div(Nat.div(s, 256n), 256n))), C.shift(8n, Nat.mod(Nat.div(s, 256n), 256n))), WW.shift_add(8n, C.shift(8n, Nat.div(Nat.div(s, 256n), 256n)), Nat.mod(Nat.div(s, 256n), 256n))) : {Nat.add(C.shift(16n, Nat.div(Nat.div(s, 256n), 256n)), Nat.add(C.shift(8n, Nat.mod(Nat.div(s, 256n), 256n)), Nat.mod(s, 256n))) == Nat.add(_, Nat.mod(s, 256n)) : Nat}
  %Equal.sym(Nat, C.shift(8n, C.shift(8n, Nat.div(Nat.div(s, 256n), 256n))), C.shift(16n, Nat.div(Nat.div(s, 256n), 256n)), SR.shift_shift(8n, 8n, Nat.div(Nat.div(s, 256n), 256n))) : {Nat.add(C.shift(16n, Nat.div(Nat.div(s, 256n), 256n)), Nat.add(C.shift(8n, Nat.mod(Nat.div(s, 256n), 256n)), Nat.mod(s, 256n))) == Nat.add(Nat.add(_, C.shift(8n, Nat.mod(Nat.div(s, 256n), 256n))), Nat.mod(s, 256n)) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.add(C.shift(16n, Nat.div(Nat.div(s, 256n), 256n)), C.shift(8n, Nat.mod(Nat.div(s, 256n), 256n))), Nat.mod(s, 256n)), Nat.add(C.shift(16n, Nat.div(Nat.div(s, 256n), 256n)), Nat.add(C.shift(8n, Nat.mod(Nat.div(s, 256n), 256n)), Nat.mod(s, 256n))), NA.add_assoc(C.shift(16n, Nat.div(Nat.div(s, 256n), 256n)), C.shift(8n, Nat.mod(Nat.div(s, 256n), 256n)), Nat.mod(s, 256n))) : {Nat.add(C.shift(16n, Nat.div(Nat.div(s, 256n), 256n)), Nat.add(C.shift(8n, Nat.mod(Nat.div(s, 256n), 256n)), Nat.mod(s, 256n))) == _ : Nat}
  {==}

def horner_v(xs: List<&2, Nat>) -> {L.horner(xs) == ev(xs) : Nat}:
  match xs:
    case Nil{}:
      {==}
    case +x <> +t:
      %Equal.sym(Nat, L.horner(t), ev(t), horner_v(t)) : {Nat.add(Nat.mul(Nat.mul(_, 256n), 256n), x) == Nat.add(x, C.shift(16n, ev(t))) : Nat}
      %Equal.sym(Nat, Nat.mul(ev(t), 256n), C.shift(8n, ev(t)), m256(ev(t))) : {Nat.add(Nat.mul(_, 256n), x) == Nat.add(x, C.shift(16n, ev(t))) : Nat}
      %Equal.sym(Nat, Nat.mul(C.shift(8n, ev(t)), 256n), C.shift(8n, C.shift(8n, ev(t))), m256(C.shift(8n, ev(t)))) : {Nat.add(_, x) == Nat.add(x, C.shift(16n, ev(t))) : Nat}
      %Equal.sym(Nat, C.shift(8n, C.shift(8n, ev(t))), C.shift(16n, ev(t)), SR.shift_shift(8n, 8n, ev(t))) : {Nat.add(_, x) == Nat.add(x, C.shift(16n, ev(t))) : Nat}
      %Equal.sym(Nat, Nat.add(x, C.shift(16n, ev(t))), Nat.add(C.shift(16n, ev(t)), x), NA.add_comm(x, C.shift(16n, ev(t)))) : {Nat.add(C.shift(16n, ev(t)), x) == _ : Nat}
      {==}

# a carry pass keeps the value: the carry in plus the limbs
def carry_v(n: Nat, +xs: List<&2, Nat>, +u: Nat) -> {ev(L.carry(n, xs, u)) == Nat.add(u, ev(xs)) : Nat}:
  match n:
    case 0n:
      %Equal.sym(Nat, L.horner(xs), ev(xs), horner_v(xs)) : {Nat.add(Nat.add(u, _), C.shift(16n, 0n)) == Nat.add(u, ev(xs)) : Nat}
      %Equal.sym(Nat, Nat.add(u, ev(xs)), Nat.add(ev(xs), u), NA.add_comm(u, ev(xs))) : {Nat.add(_, C.shift(16n, 0n)) == Nat.add(u, ev(xs)) : Nat}
      %Equal.sym(Nat, C.shift(16n, 0n), 0n, WW.shift_zero(16n)) : {Nat.add(Nat.add(ev(xs), u), _) == Nat.add(u, ev(xs)) : Nat}
      %Equal.sym(Nat, Nat.add(Nat.add(ev(xs), u), 0n), Nat.add(ev(xs), u), NA.add_zero(Nat.add(ev(xs), u))) : {_ == Nat.add(u, ev(xs)) : Nat}
      %Equal.sym(Nat, Nat.add(u, ev(xs)), Nat.add(ev(xs), u), NA.add_comm(u, ev(xs))) : {Nat.add(ev(xs), u) == _ : Nat}
      {==}
    case 1n+ +k:
      %Equal.sym(Nat, ev(L.carry(k, L.tl(xs), L.hi16(Nat.add(u, L.hd0(xs))))), Nat.add(L.hi16(Nat.add(u, L.hd0(xs))), ev(L.tl(xs))), carry_v(k, L.tl(xs), L.hi16(Nat.add(u, L.hd0(xs))))) : {Nat.add(L.lo16(Nat.add(u, L.hd0(xs))), C.shift(16n, _)) == Nat.add(u, ev(xs)) : Nat}
      %Equal.sym(Nat, ev(xs), Nat.add(L.hd0(xs), C.shift(16n, ev(L.tl(xs)))), hd_tl_v(xs)) : {Nat.add(L.lo16(Nat.add(u, L.hd0(xs))), C.shift(16n, Nat.add(L.hi16(Nat.add(u, L.hd0(xs))), ev(L.tl(xs))))) == Nat.add(u, _) : Nat}
      %Equal.sym(Nat, C.shift(16n, Nat.add(L.hi16(Nat.add(u, L.hd0(xs))), ev(L.tl(xs)))), Nat.add(C.shift(16n, L.hi16(Nat.add(u, L.hd0(xs)))), C.shift(16n, ev(L.tl(xs)))), WW.shift_add(16n, L.hi16(Nat.add(u, L.hd0(xs))), ev(L.tl(xs)))) : {Nat.add(L.lo16(Nat.add(u, L.hd0(xs))), _) == Nat.add(u, Nat.add(L.hd0(xs), C.shift(16n, ev(L.tl(xs))))) : Nat}
      %Equal.sym(Nat, Nat.add(L.lo16(Nat.add(u, L.hd0(xs))), Nat.add(C.shift(16n, L.hi16(Nat.add(u, L.hd0(xs)))), C.shift(16n, ev(L.tl(xs))))), Nat.add(Nat.add(L.lo16(Nat.add(u, L.hd0(xs))), C.shift(16n, L.hi16(Nat.add(u, L.hd0(xs))))), C.shift(16n, ev(L.tl(xs)))), Equal.sym(Nat, Nat.add(Nat.add(L.lo16(Nat.add(u, L.hd0(xs))), C.shift(16n, L.hi16(Nat.add(u, L.hd0(xs))))), C.shift(16n, ev(L.tl(xs)))), Nat.add(L.lo16(Nat.add(u, L.hd0(xs))), Nat.add(C.shift(16n, L.hi16(Nat.add(u, L.hd0(xs)))), C.shift(16n, ev(L.tl(xs))))), NA.add_assoc(L.lo16(Nat.add(u, L.hd0(xs))), C.shift(16n, L.hi16(Nat.add(u, L.hd0(xs)))), C.shift(16n, ev(L.tl(xs)))))) : {_ == Nat.add(u, Nat.add(L.hd0(xs), C.shift(16n, ev(L.tl(xs))))) : Nat}
      %Equal.sym(Nat, Nat.add(L.lo16(Nat.add(u, L.hd0(xs))), C.shift(16n, L.hi16(Nat.add(u, L.hd0(xs))))), Nat.add(u, L.hd0(xs)), lohi(Nat.add(u, L.hd0(xs)))) : {Nat.add(_, C.shift(16n, ev(L.tl(xs)))) == Nat.add(u, Nat.add(L.hd0(xs), C.shift(16n, ev(L.tl(xs))))) : Nat}
      %Equal.sym(Nat, Nat.add(u, L.hd0(xs)), Nat.add(L.hd0(xs), u), NA.add_comm(u, L.hd0(xs))) : {Nat.add(_, C.shift(16n, ev(L.tl(xs)))) == Nat.add(u, Nat.add(L.hd0(xs), C.shift(16n, ev(L.tl(xs))))) : Nat}
      %Equal.sym(Nat, Nat.add(Nat.add(L.hd0(xs), u), C.shift(16n, ev(L.tl(xs)))), Nat.add(L.hd0(xs), Nat.add(u, C.shift(16n, ev(L.tl(xs))))), NA.add_assoc(L.hd0(xs), u, C.shift(16n, ev(L.tl(xs))))) : {_ == Nat.add(u, Nat.add(L.hd0(xs), C.shift(16n, ev(L.tl(xs))))) : Nat}
      %Equal.sym(Nat, Nat.add(u, C.shift(16n, ev(L.tl(xs)))), Nat.add(C.shift(16n, ev(L.tl(xs))), u), NA.add_comm(u, C.shift(16n, ev(L.tl(xs))))) : {Nat.add(L.hd0(xs), _) == Nat.add(u, Nat.add(L.hd0(xs), C.shift(16n, ev(L.tl(xs))))) : Nat}
      %Equal.sym(Nat, Nat.add(u, Nat.add(L.hd0(xs), C.shift(16n, ev(L.tl(xs))))), Nat.add(L.hd0(xs), Nat.add(u, C.shift(16n, ev(L.tl(xs))))), NA.add_swap(u, L.hd0(xs), C.shift(16n, ev(L.tl(xs))))) : {Nat.add(L.hd0(xs), Nat.add(C.shift(16n, ev(L.tl(xs))), u)) == _ : Nat}
      %Equal.sym(Nat, Nat.add(u, C.shift(16n, ev(L.tl(xs)))), Nat.add(C.shift(16n, ev(L.tl(xs))), u), NA.add_comm(u, C.shift(16n, ev(L.tl(xs))))) : {Nat.add(L.hd0(xs), Nat.add(C.shift(16n, ev(L.tl(xs))), u)) == Nat.add(L.hd0(xs), _) : Nat}
      {==}
