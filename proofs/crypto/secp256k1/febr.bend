def shape2(+one: Nat, +x0: Nat, +x1: Nat, xs: List<&2, Nat>, +h: {FS.limbs16(one, 14n, xs) == True{} : Bool}) -> {F.to_list(F.of_list(x0 <> x1 <> xs)) == x0 <> x1 <> xs : List<&2, Nat>}:
  match xs:
    case Nil{}:
      Empty.absurd({F.to_list(F.of_list(x0 <> x1 <> [])) == x0 <> x1 <> [] : List<&2, Nat>}, Lg.false_true(h))
    case +y <> +t:
      shape3(one, x0, x1, y, t, Lg.and_right(Nat.is_lt(y, C.shift(16n, one)), FS.limbs16(one, 13n, t), h))

def shape1(+one: Nat, +x0: Nat, xs: List<&2, Nat>, +h: {FS.limbs16(one, 15n, xs) == True{} : Bool}) -> {F.to_list(F.of_list(x0 <> xs)) == x0 <> xs : List<&2, Nat>}:
  match xs:
    case Nil{}:
      Empty.absurd({F.to_list(F.of_list(x0 <> [])) == x0 <> [] : List<&2, Nat>}, Lg.false_true(h))
    case +y <> +t:
      shape2(one, x0, y, t, Lg.and_right(Nat.is_lt(y, C.shift(16n, one)), FS.limbs16(one, 14n, t), h))

def shape0(+one: Nat, xs: List<&2, Nat>, +h: {FS.limbs16(one, 16n, xs) == True{} : Bool}) -> {F.to_list(F.of_list(xs)) == xs : List<&2, Nat>}:
  match xs:
    case Nil{}:
      Empty.absurd({F.to_list(F.of_list([])) == [] : List<&2, Nat>}, Lg.false_true(h))
    case +y <> +t:
      shape1(one, y, t, Lg.and_right(Nat.is_lt(y, C.shift(16n, one)), FS.limbs16(one, 15n, t), h))

def shape(+one: Nat, +xs: List<&2, Nat>, +h: {FS.limbs16(one, 16n, xs) == True{} : Bool}) -> {F.to_list(F.of_list(xs)) == xs : List<&2, Nat>}:
  shape0(one, xs, h)

