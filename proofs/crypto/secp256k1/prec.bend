def rlen(+one: Nat, +h1: {one == 1n : Nat}, +h: List<&2, U32>, +sig: List<&2, U32>, a: Bool, b: Bool, +ha: {B.has_len(32n, h) == a : Bool}, +hb: {B.has_len(65n, sig) == b : Bool}) -> {E.recover_len(h, sig, Bool.and(a, b)) == ES.recover_len(one, h, sig, Bool.and(a, b)) : Maybe<&2, List<&2, U32>>}:
  match a b:
    case True{} True{}:
      rsig(one, h1, h, ha, sig, hb)
    case True{} False{}:
      {==}
    case False{} _:
      {==}

# the key recovered from a 32-byte hash and a 65-byte r || s || id
def recover_v(+one: Nat, +h1: {one == 1n : Nat}, +h: List<&2, U32>, +sig: List<&2, U32>) -> {E.recover(h, sig) == ES.recover(one, h, sig) : Maybe<&2, List<&2, U32>>}:
  %Equal.sym(Bool, B.has_len(32n, h), CV.length_is(32n, h), PD.hl_is(32n, h)) : {E.recover_len(h, sig, Bool.and(_, B.has_len(65n, sig))) == ES.recover_len(one, h, sig, Bool.and(CV.length_is(32n, h), CV.length_is(65n, sig))) : Maybe<&2, List<&2, U32>>}
  %Equal.sym(Bool, B.has_len(65n, sig), CV.length_is(65n, sig), PD.hl_is(65n, sig)) : {E.recover_len(h, sig, Bool.and(CV.length_is(32n, h), _)) == ES.recover_len(one, h, sig, Bool.and(CV.length_is(32n, h), CV.length_is(65n, sig))) : Maybe<&2, List<&2, U32>>}
  rlen(one, h1, h, sig, CV.length_is(32n, h), CV.length_is(65n, sig), PD.hl_is(32n, h), PD.hl_is(65n, sig))
