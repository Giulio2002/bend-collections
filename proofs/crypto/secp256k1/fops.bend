  %Equal.sym(Nat, LV.ev(M.finc([977n, 0n, 1n], L.carry(16n, xs, 0n))), Nat.mod(LV.ev(L.carry(16n, xs, 0n)), 1n+K.pp(one)), V.finc_v(one, h1, K.pp(one), [977n, 0n, 1n], K.hm_p(one, h1), K.cp_cc(one, h1), L.carry(16n, xs, 0n), hl, V.carry_top(16n, xs, 0n), hu)) : {_ == Nat.mod(LV.ev(xs), 1n+K.pp(one)) : Nat}
