def negr_le(+one: Nat, +h1: {one == 1n : Nat}, +b: F.FE, +hb: {red(one, b) == True{} : Bool}) -> {Nat.is_le(LV.ev(L.neg_raw([977n, 0n, 1n], F.to_list(b))), 1n+K.pp(one)) == True{} : Bool}:
