# ---- the final subtraction on a carried list below 2 p ----

def cl(+xs: List<&2, Nat>) -> List<&2, Nat>:
  L.carry(16n, xs, 0n)

def fin_v(+one: Nat, +h1: {one == 1n : Nat}, +xs: List<&2, Nat>, +hx: {Nat.is_lt(LV.ev(xs), Nat.add(1n+K.pp(one), 1n+K.pp(one))) == True{} : Bool}) -> {LV.ev(M.fin(L.carry(16n, xs, 0n))) == Nat.mod(LV.ev(xs), 1n+K.pp(one)) : Nat}:
