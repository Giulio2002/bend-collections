  %Equal.sym(Nat, LV.ev(F.to_list(a)), FS.value(one, F.to_list(a)), Equal.sym(Nat, FS.value(one, F.to_list(a)), LV.ev(F.to_list(a)), LV.ev_value(one, h1, F.to_list(a)))) : {Nat.mod(Nat.add(_, LV.ev(F.to_list(b))), 1n+K.pp(one)) == Nat.mod(Nat.add(FS.value(one, F.to_list(a)), FS.value(one, F.to_list(b))), FS.prime(one)) : Nat}
  %Equal.sym(Nat, LV.ev(F.to_list(b)), FS.value(one, F.to_list(b)), Equal.sym(Nat, FS.value(one, F.to_list(b)), LV.ev(F.to_list(b)), LV.ev_value(one, h1, F.to_list(b)))) : {Nat.mod(Nat.add(FS.value(one, F.to_list(a)), _), 1n+K.pp(one)) == Nat.mod(Nat.add(FS.value(one, F.to_list(a)), FS.value(one, F.to_list(b))), FS.prime(one)) : Nat}
  %Equal.sym(Nat, 1n+K.pp(one), FS.prime(one), Equal.sym(Nat, FS.prime(one), 1n+K.pp(one), K.prime_eq(one, h1))) : {Nat.mod(Nat.add(FS.value(one, F.to_list(a)), FS.value(one, F.to_list(b))), _) == Nat.mod(Nat.add(FS.value(one, F.to_list(a)), FS.value(one, F.to_list(b))), FS.prime(one)) : Nat}
  {==}

def add_r(+one: Nat, +h1: {one == 1n : Nat}, +a: F.FE, +b: F.FE, +ha: {red(one, a) == True{} : Bool}, +hb: {red(one, b) == True{} : Bool}) -> {red(one, F.add(a, b)) == True{} : Bool}:
