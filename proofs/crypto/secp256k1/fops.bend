def fin_r(+one: Nat, +h1: {one == 1n : Nat}, +xs: List<&2, Nat>, +hx: {Nat.is_lt(LV.ev(xs), Nat.add(1n+K.pp(one), 1n+K.pp(one))) == True{} : Bool}) -> {FS.reduced(one, FS.prime(one), M.fin(L.carry(16n, xs, 0n))) == True{} : Bool}:
  +r = M.fin(L.carry(16n, xs, 0n))
  +lt = I.lt_subst_l(Nat.mod(LV.ev(xs), 1n+K.pp(one)), LV.ev(r), 1n+K.pp(one), Equal.sym(Nat, LV.ev(r), Nat.mod(LV.ev(xs), 1n+K.pp(one)), fin_v(one, h1, xs, hx)), NR.dm_lt(K.pp(one), LV.ev(xs)))
  rl(one, h1, r, lt, fin_l(one, h1, xs, hx))

# ---- reduced inputs ----

def lt2m(+m: Nat, +a: Nat, +b: Nat, +ha: {Nat.is_lt(a, m) == True{} : Bool}, +hb: {Nat.is_le(b, m) == True{} : Bool}) -> {Nat.is_lt(Nat.add(a, b), Nat.add(m, m)) == True{} : Bool}:
  I.lt_le_add(a, b, m, m, ha, hb)

