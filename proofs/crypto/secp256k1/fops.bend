  %Equal.sym(Nat, FS.value(one, M.fin(L.carry(16n, L.add(F.to_list(a), L.neg_raw([977n, 0n, 1n], F.to_list(b))), 0n))), LV.ev(M.fin(L.carry(16n, L.add(F.to_list(a), L.neg_raw([977n, 0n, 1n], F.to_list(b))), 0n))), LV.ev_value(one, h1, M.fin(L.carry(16n, L.add(F.to_list(a), L.neg_raw([977n, 0n, 1n], F.to_list(b))), 0n)))) : {_ == Nat.mod(Nat.sub(Nat.add(FS.value(one, F.to_list(a)), FS.prime(one)), Nat.mod(FS.value(one, F.to_list(b)), FS.prime(one))), FS.prime(one)) : Nat}
  %Equal.sym(Nat, LV.ev(M.fin(L.carry(16n, L.add(F.to_list(a), L.neg_raw([977n, 0n, 1n], F.to_list(b))), 0n))), Nat.mod(LV.ev(L.add(F.to_list(a), L.neg_raw([977n, 0n, 1n], F.to_list(b)))), 1n+K.pp(one)), fin_v(one, h1, L.add(F.to_list(a), L.neg_raw([977n, 0n, 1n], F.to_list(b))), sub_hx(one, h1, a, b, ha, hb))) : {_ == Nat.mod(Nat.sub(Nat.add(FS.value(one, F.to_list(a)), FS.prime(one)), Nat.mod(FS.value(one, F.to_list(b)), FS.prime(one))), FS.prime(one)) : Nat}
  %Equal.sym(Nat, LV.ev(L.add(F.to_list(a), L.neg_raw([977n, 0n, 1n], F.to_list(b)))), Nat.add(LV.ev(F.to_list(a)), LV.ev(L.neg_raw([977n, 0n, 1n], F.to_list(b)))), LV.add_v(F.to_list(a), L.neg_raw([977n, 0n, 1n], F.to_list(b)))) : {Nat.mod(_, 1n+K.pp(one)) == Nat.mod(Nat.sub(Nat.add(FS.value(one, F.to_list(a)), FS.prime(one)), Nat.mod(FS.value(one, F.to_list(b)), FS.prime(one))), FS.prime(one)) : Nat}
  %Equal.sym(Nat, FS.value(one, F.to_list(a)), LV.ev(F.to_list(a)), LV.ev_value(one, h1, F.to_list(a))) : {Nat.mod(Nat.add(LV.ev(F.to_list(a)), LV.ev(L.neg_raw([977n, 0n, 1n], F.to_list(b)))), 1n+K.pp(one)) == Nat.mod(Nat.sub(Nat.add(_, FS.prime(one)), Nat.mod(FS.value(one, F.to_list(b)), FS.prime(one))), FS.prime(one)) : Nat}
  %Equal.sym(Nat, FS.value(one, F.to_list(b)), LV.ev(F.to_list(b)), LV.ev_value(one, h1, F.to_list(b))) : {Nat.mod(Nat.add(LV.ev(F.to_list(a)), LV.ev(L.neg_raw([977n, 0n, 1n], F.to_list(b)))), 1n+K.pp(one)) == Nat.mod(Nat.sub(Nat.add(LV.ev(F.to_list(a)), FS.prime(one)), Nat.mod(_, FS.prime(one))), FS.prime(one)) : Nat}
  %Equal.sym(Nat, FS.prime(one), 1n+K.pp(one), K.prime_eq(one, h1)) : {Nat.mod(Nat.add(LV.ev(F.to_list(a)), LV.ev(L.neg_raw([977n, 0n, 1n], F.to_list(b)))), 1n+K.pp(one)) == Nat.mod(Nat.sub(Nat.add(LV.ev(F.to_list(a)), _), Nat.mod(LV.ev(F.to_list(b)), FS.prime(one))), FS.prime(one)) : Nat}
  %Equal.sym(Nat, FS.prime(one), 1n+K.pp(one), K.prime_eq(one, h1)) : {Nat.mod(Nat.add(LV.ev(F.to_list(a)), LV.ev(L.neg_raw([977n, 0n, 1n], F.to_list(b)))), 1n+K.pp(one)) == Nat.mod(Nat.sub(Nat.add(LV.ev(F.to_list(a)), 1n+K.pp(one)), Nat.mod(LV.ev(F.to_list(b)), _)), FS.prime(one)) : Nat}
  %Equal.sym(Nat, FS.prime(one), 1n+K.pp(one), K.prime_eq(one, h1)) : {Nat.mod(Nat.add(LV.ev(F.to_list(a)), LV.ev(L.neg_raw([977n, 0n, 1n], F.to_list(b)))), 1n+K.pp(one)) == Nat.mod(Nat.sub(Nat.add(LV.ev(F.to_list(a)), 1n+K.pp(one)), Nat.mod(LV.ev(F.to_list(b)), 1n+K.pp(one))), _) : Nat}
  NG.sub_mod(K.pp(one), LV.ev(F.to_list(a)), LV.ev(F.to_list(b)), LV.ev(L.neg_raw([977n, 0n, 1n], F.to_list(b))), FO.rlt(one, h1, F.to_list(b), hb), negr_e(one, h1, b, hb))

def sub_r(+one: Nat, +h1: {one == 1n : Nat}, +a: F.FE, +b: F.FE, +ha: {red(one, a) == True{} : Bool}, +hb: {red(one, b) == True{} : Bool}) -> {red(one, F.sub(a, b)) == True{} : Bool}:
  %Equal.sym(List<&2, Nat>, F.to_list(F.sub(a, b)), M.fin(L.carry(16n, L.add(F.to_list(a), L.neg_raw([977n, 0n, 1n], F.to_list(b))), 0n)), sub_l(a, b)) : {FS.reduced(one, FS.prime(one), _) == True{} : Bool}
  fin_r(one, h1, L.add(F.to_list(a), L.neg_raw([977n, 0n, 1n], F.to_list(b))), sub_hx(one, h1, a, b, ha, hb))

def neg_hx(+one: Nat, +h1: {one == 1n : Nat}, +b: F.FE, +hb: {red(one, b) == True{} : Bool}) -> {Nat.is_lt(LV.ev(L.neg_raw([977n, 0n, 1n], F.to_list(b))), Nat.add(1n+K.pp(one), 1n+K.pp(one))) == True{} : Bool}:
  +m = {1n+K.pp(one) : Nat}
  N.le_lt_trans(LV.ev(L.neg_raw([977n, 0n, 1n], F.to_list(b))), m, Nat.add(m, m), negr_le(one, h1, b, hb), I.lt_add_pos(m, m, {==}))

def neg_v(+one: Nat, +h1: {one == 1n : Nat}, +b: F.FE, +hb: {red(one, b) == True{} : Bool}) -> {val(one, F.neg(b)) == FS.mneg(FS.prime(one), val(one, b)) : Nat}:
  %Equal.sym(List<&2, Nat>, F.to_list(F.neg(b)), M.fin(L.carry(16n, L.neg_raw([977n, 0n, 1n], F.to_list(b)), 0n)), neg_l(b)) : {FS.value(one, _) == Nat.mod(Nat.sub(Nat.add(0n, FS.prime(one)), Nat.mod(FS.value(one, F.to_list(b)), FS.prime(one))), FS.prime(one)) : Nat}
  %Equal.sym(Nat, FS.value(one, M.fin(L.carry(16n, L.neg_raw([977n, 0n, 1n], F.to_list(b)), 0n))), LV.ev(M.fin(L.carry(16n, L.neg_raw([977n, 0n, 1n], F.to_list(b)), 0n))), LV.ev_value(one, h1, M.fin(L.carry(16n, L.neg_raw([977n, 0n, 1n], F.to_list(b)), 0n)))) : {_ == Nat.mod(Nat.sub(Nat.add(0n, FS.prime(one)), Nat.mod(FS.value(one, F.to_list(b)), FS.prime(one))), FS.prime(one)) : Nat}
  %Equal.sym(Nat, LV.ev(M.fin(L.carry(16n, L.neg_raw([977n, 0n, 1n], F.to_list(b)), 0n))), Nat.mod(LV.ev(L.neg_raw([977n, 0n, 1n], F.to_list(b))), 1n+K.pp(one)), fin_v(one, h1, L.neg_raw([977n, 0n, 1n], F.to_list(b)), neg_hx(one, h1, b, hb))) : {_ == Nat.mod(Nat.sub(Nat.add(0n, FS.prime(one)), Nat.mod(FS.value(one, F.to_list(b)), FS.prime(one))), FS.prime(one)) : Nat}
  %Equal.sym(Nat, FS.value(one, F.to_list(b)), LV.ev(F.to_list(b)), LV.ev_value(one, h1, F.to_list(b))) : {Nat.mod(LV.ev(L.neg_raw([977n, 0n, 1n], F.to_list(b))), 1n+K.pp(one)) == Nat.mod(Nat.sub(Nat.add(0n, FS.prime(one)), Nat.mod(_, FS.prime(one))), FS.prime(one)) : Nat}
  %Equal.sym(Nat, FS.prime(one), 1n+K.pp(one), K.prime_eq(one, h1)) : {Nat.mod(LV.ev(L.neg_raw([977n, 0n, 1n], F.to_list(b))), 1n+K.pp(one)) == Nat.mod(Nat.sub(Nat.add(0n, _), Nat.mod(LV.ev(F.to_list(b)), FS.prime(one))), FS.prime(one)) : Nat}
  %Equal.sym(Nat, FS.prime(one), 1n+K.pp(one), K.prime_eq(one, h1)) : {Nat.mod(LV.ev(L.neg_raw([977n, 0n, 1n], F.to_list(b))), 1n+K.pp(one)) == Nat.mod(Nat.sub(Nat.add(0n, 1n+K.pp(one)), Nat.mod(LV.ev(F.to_list(b)), _)), FS.prime(one)) : Nat}
  %Equal.sym(Nat, FS.prime(one), 1n+K.pp(one), K.prime_eq(one, h1)) : {Nat.mod(LV.ev(L.neg_raw([977n, 0n, 1n], F.to_list(b))), 1n+K.pp(one)) == Nat.mod(Nat.sub(Nat.add(0n, 1n+K.pp(one)), Nat.mod(LV.ev(F.to_list(b)), 1n+K.pp(one))), _) : Nat}
  NG.sub_mod(K.pp(one), 0n, LV.ev(F.to_list(b)), LV.ev(L.neg_raw([977n, 0n, 1n], F.to_list(b))), FO.rlt(one, h1, F.to_list(b), hb), negr_e(one, h1, b, hb))

def neg_r(+one: Nat, +h1: {one == 1n : Nat}, +b: F.FE, +hb: {red(one, b) == True{} : Bool}) -> {red(one, F.neg(b)) == True{} : Bool}:
  %Equal.sym(List<&2, Nat>, F.to_list(F.neg(b)), M.fin(L.carry(16n, L.neg_raw([977n, 0n, 1n], F.to_list(b)), 0n)), neg_l(b)) : {FS.reduced(one, FS.prime(one), _) == True{} : Bool}
  fin_r(one, h1, L.neg_raw([977n, 0n, 1n], F.to_list(b)), neg_hx(one, h1, b, hb))

# ---- the reduction of a product ----

# x = lo + h T and f = lo + h c with T = m + c: f = x mod m
def fmod_g(+mp: Nat, +cv: Nat, +tt: Nat, +hm: {Nat.add(1n+mp, cv) == tt : Nat}, +lo: Nat, +h: Nat, +x: Nat, +ex: {x == Nat.add(lo, Nat.mul(h, tt)) : Nat}, +f: Nat, +ef: {f == Nat.add(lo, Nat.mul(h, cv)) : Nat}) -> {Nat.mod(f, 1n+mp) == Nat.mod(x, 1n+mp) : Nat}:
  %Equal.sym(Nat, x, Nat.add(lo, Nat.mul(h, tt)), ex) : {Nat.mod(f, 1n+mp) == Nat.mod(_, 1n+mp) : Nat}
  %Equal.sym(Nat, f, Nat.add(lo, Nat.mul(h, cv)), ef) : {Nat.mod(_, 1n+mp) == Nat.mod(Nat.add(lo, Nat.mul(h, tt)), 1n+mp) : Nat}
  %Equal.sym(Nat, tt, Nat.add(1n+mp, cv), Equal.sym(Nat, Nat.add(1n+mp, cv), tt, hm)) : {Nat.mod(Nat.add(lo, Nat.mul(h, cv)), 1n+mp) == Nat.mod(Nat.add(lo, Nat.mul(h, _)), 1n+mp) : Nat}
  %Equal.sym(Nat, Nat.mul(h, Nat.add(1n+mp, cv)), Nat.add(Nat.mul(h, 1n+mp), Nat.mul(h, cv)), NA.mul_add_left(h, 1n+mp, cv)) : {Nat.mod(Nat.add(lo, Nat.mul(h, cv)), 1n+mp) == Nat.mod(Nat.add(lo, _), 1n+mp) : Nat}
  %Equal.sym(Nat, Nat.add(lo, Nat.add(Nat.mul(h, 1n+mp), Nat.mul(h, cv))), Nat.add(Nat.mul(h, 1n+mp), Nat.add(lo, Nat.mul(h, cv))), NA.add_swap(lo, Nat.mul(h, 1n+mp), Nat.mul(h, cv))) : {Nat.mod(Nat.add(lo, Nat.mul(h, cv)), 1n+mp) == Nat.mod(_, 1n+mp) : Nat}
  %Equal.sym(Nat, Nat.mod(Nat.add(Nat.mul(h, 1n+mp), Nat.add(lo, Nat.mul(h, cv))), 1n+mp), Nat.mod(Nat.add(lo, Nat.mul(h, cv)), 1n+mp), NR.absorb(mp, h, Nat.add(lo, Nat.mul(h, cv)))) : {Nat.mod(Nat.add(lo, Nat.mul(h, cv)), 1n+mp) == _ : Nat}
  {==}

# the carry out of a pass of x < H 2^256 is below H
def top_lt(+one: Nat, +h1: {one == 1n : Nat}, +u: List<&2, Nat>, +hs: {L.drop(16n, u) == [L.hd0(L.drop(16n, u))] : List<&2, Nat>}, +hh: Nat, +hx: {Nat.is_lt(LV.ev(u), Nat.mul(hh, C.shift(256n, one))) == True{} : Bool}) -> {Nat.is_lt(L.hd0(L.drop(16n, u)), hh) == True{} : Bool}:
  +a = R.hi_lt(one, h1, u, hh, hx)
  +b = Lg.subst(List<&2, Nat>, z => {Nat.is_lt(LV.ev(z), hh) == True{} : Bool}, L.drop(16n, u), [L.hd0(L.drop(16n, u))], hs, a)
  %Equal.sym(Nat, L.hd0(L.drop(16n, u)), Nat.add(L.hd0(L.drop(16n, u)), 0n), Equal.sym(Nat, Nat.add(L.hd0(L.drop(16n, u)), 0n), L.hd0(L.drop(16n, u)), NA.add_zero(L.hd0(L.drop(16n, u))))) : {Nat.is_lt(_, hh) == True{} : Bool}
  %Equal.sym(Nat, 0n, C.shift(16n, 0n), Equal.sym(Nat, C.shift(16n, 0n), 0n, WW.shift_zero(16n))) : {Nat.is_lt(Nat.add(L.hd0(L.drop(16n, u)), _), hh) == True{} : Bool}
  b

# lo < T, t <= c: lo + t c < 2 m, from (1 + c) c + c <= T
def f2_lt(+one: Nat, +h1: {one == 1n : Nat}, +lo: Nat, +t: Nat, +hl: {Nat.is_lt(lo, C.shift(256n, one)) == True{} : Bool}, +ht: {Nat.is_lt(t, 1n+FS.cp(one)) == True{} : Bool}) -> {Nat.is_lt(Nat.add(lo, Nat.mul(t, FS.cp(one))), Nat.add(1n+K.pp(one), 1n+K.pp(one))) == True{} : Bool}:
  +cv = FS.cp(one)
  +tt = C.shift(256n, one)
  +m = {1n+K.pp(one) : Nat}
  +s1 = I.lt_le_add(lo, Nat.mul(t, cv), tt, Nat.mul(cv, cv), hl, AR.mul_le(t, cv, cv, N.lt_succ_le(t, cv, ht)))
  # cv + cv cv + cv <= T = m + cv
  +hb = I.le_subst_r(Nat.add(Nat.add(cv, Nat.mul(cv, cv)), cv), tt, Nat.add(m, cv), Equal.sym(Nat, Nat.add(m, cv), tt, K.hm_p(one, h1)), K.cp_hb(one, h1))
  +hb2 = Equal.trans(Bool, Nat.is_le(Nat.add(cv, Nat.mul(cv, cv)), m), Nat.is_le(Nat.add(Nat.add(cv, Nat.mul(cv, cv)), cv), Nat.add(m, cv)), True{}, Equal.sym(Bool, Nat.is_le(Nat.add(Nat.add(cv, Nat.mul(cv, cv)), cv), Nat.add(m, cv)), Nat.is_le(Nat.add(cv, Nat.mul(cv, cv)), m), FO.le_cancel_r(Nat.add(cv, Nat.mul(cv, cv)), m, cv)), hb)
  # T + cv cv = m + (cv + cv cv) <= m + m
  +e1 = Equal.trans(Nat, Nat.add(tt, Nat.mul(cv, cv)), Nat.add(Nat.add(m, cv), Nat.mul(cv, cv)), Nat.add(m, Nat.add(cv, Nat.mul(cv, cv))), Equal.cong(Nat, Nat, z => Nat.add(z, Nat.mul(cv, cv)), tt, Nat.add(m, cv), Equal.sym(Nat, Nat.add(m, cv), tt, K.hm_p(one, h1))), NA.add_assoc(m, cv, Nat.mul(cv, cv)))
  +le = I.le_subst_l(Nat.add(m, Nat.add(cv, Nat.mul(cv, cv))), Nat.add(tt, Nat.mul(cv, cv)), Nat.add(m, m), Equal.sym(Nat, Nat.add(tt, Nat.mul(cv, cv)), Nat.add(m, Nat.add(cv, Nat.mul(cv, cv))), e1), N.le_add_left(Nat.add(cv, Nat.mul(cv, cv)), m, m, hb2))
  N.lt_le_trans(Nat.add(lo, Nat.mul(t, cv)), Nat.add(tt, Nat.mul(cv, cv)), Nat.add(m, m), s1, le)

# lo + H c < (1 + c) T for lo < T, H < T
def f1_lt(+one: Nat, +h1: {one == 1n : Nat}, +lo: Nat, +h: Nat, +hl: {Nat.is_lt(lo, C.shift(256n, one)) == True{} : Bool}, +hh: {Nat.is_lt(h, C.shift(256n, one)) == True{} : Bool}) -> {Nat.is_lt(Nat.add(lo, Nat.mul(h, FS.cp(one))), Nat.mul(1n+FS.cp(one), C.shift(256n, one))) == True{} : Bool}:
  +cv = FS.cp(one)
  +tt = C.shift(256n, one)
  +le = I.le_subst_r(Nat.mul(h, cv), Nat.mul(tt, cv), Nat.mul(cv, tt), NA.mul_comm(tt, cv), AR.mul_le(h, tt, cv, N.lt_le(h, tt, hh)))
  I.lt_le_add(lo, Nat.mul(h, cv), tt, Nat.mul(cv, tt), hl, le)

def carryp0_v(+n: Nat, +xs: List<&2, Nat>) -> {LV.ev(M.carryp(n, xs, 0n)) == LV.ev(xs) : Nat}:
  V.carryp_v(n, xs, 0n)

# the second fold, reduced: below 2 m, and congruent
def mch2_lt(+one: Nat, +h1: {one == 1n : Nat}, +f1: List<&2, Nat>, +hf: {Nat.is_lt(LV.ev(f1), Nat.mul(1n+FS.cp(one), C.shift(256n, one))) == True{} : Bool}) -> {Nat.is_lt(LV.ev(M.foldt(L.carry(16n, f1, 0n))), Nat.add(1n+K.pp(one), 1n+K.pp(one))) == True{} : Bool}:
  +u = L.carry(16n, f1, 0n)
  +hs = V.carry_top(16n, f1, 0n)
  +hu = I.lt_subst_l(LV.ev(f1), LV.ev(u), Nat.mul(1n+FS.cp(one), C.shift(256n, one)), Equal.sym(Nat, LV.ev(u), LV.ev(f1), V.carry0_v(16n, f1)), hf)
  +hl = B.carry_limbs(one, h1, 16n, 16n, f1, 0n, {==})
  %Equal.sym(Nat, LV.ev(M.foldt(L.carry(16n, f1, 0n))), Nat.add(LV.ev(L.take(16n, L.carry(16n, f1, 0n))), Nat.mul(L.hd0(L.drop(16n, L.carry(16n, f1, 0n))), FS.cp(one))), V.foldt_v(one, h1, L.carry(16n, f1, 0n))) : {Nat.is_lt(_, Nat.add(1n+K.pp(one), 1n+K.pp(one))) == True{} : Bool}
  f2_lt(one, h1, LV.ev(L.take(16n, u)), L.hd0(L.drop(16n, u)), V.lo_lt(one, h1, u, hl), top_lt(one, h1, u, hs, 1n+FS.cp(one), hu))

def mch2_mod(+one: Nat, +h1: {one == 1n : Nat}, +f1: List<&2, Nat>) -> {Nat.mod(LV.ev(M.foldt(L.carry(16n, f1, 0n))), 1n+K.pp(one)) == Nat.mod(LV.ev(f1), 1n+K.pp(one)) : Nat}:
  +u = L.carry(16n, f1, 0n)
  %Equal.sym(Nat, LV.ev(f1), LV.ev(L.carry(16n, f1, 0n)), Equal.sym(Nat, LV.ev(L.carry(16n, f1, 0n)), LV.ev(f1), V.carry0_v(16n, f1))) : {Nat.mod(LV.ev(M.foldt(L.carry(16n, f1, 0n))), 1n+K.pp(one)) == Nat.mod(_, 1n+K.pp(one)) : Nat}
  fmod_g(K.pp(one), FS.cp(one), C.shift(256n, one), K.hm_p(one, h1), LV.ev(L.take(16n, u)), L.hd0(L.drop(16n, u)), LV.ev(u), V.split17(one, h1, u, V.carry_top(16n, f1, 0n)), LV.ev(M.foldt(u)), V.foldt_v(one, h1, u))

# the first fold: below (1 + c) T, and congruent
def mch1_lt(+one: Nat, +h1: {one == 1n : Nat}, +cs: List<&2, Nat>, +hc: {Nat.is_lt(LV.ev(cs), Nat.mul(C.shift(256n, one), C.shift(256n, one))) == True{} : Bool}) -> {Nat.is_lt(LV.ev(M.fold1(M.carryp(16n, cs, 0n))), Nat.mul(1n+FS.cp(one), C.shift(256n, one))) == True{} : Bool}:
  +w = M.carryp(16n, cs, 0n)
  +hw = I.lt_subst_l(LV.ev(cs), LV.ev(w), Nat.mul(C.shift(256n, one), C.shift(256n, one)), Equal.sym(Nat, LV.ev(w), LV.ev(cs), carryp0_v(16n, cs)), hc)
  %Equal.sym(Nat, LV.ev(M.fold1(M.carryp(16n, cs, 0n))), Nat.add(LV.ev(L.take(16n, M.carryp(16n, cs, 0n))), Nat.mul(LV.ev(L.drop(16n, M.carryp(16n, cs, 0n))), FS.cp(one))), V.fold1_v(one, h1, M.carryp(16n, cs, 0n))) : {Nat.is_lt(_, Nat.mul(1n+FS.cp(one), C.shift(256n, one))) == True{} : Bool}
  f1_lt(one, h1, LV.ev(L.take(16n, w)), LV.ev(L.drop(16n, w)), V.lo_lt(one, h1, w, V.carryp_limbs(one, h1, 16n, cs, 0n)), R.hi_lt(one, h1, w, C.shift(256n, one), hw))

def mch1_mod(+one: Nat, +h1: {one == 1n : Nat}, +cs: List<&2, Nat>) -> {Nat.mod(LV.ev(M.fold1(M.carryp(16n, cs, 0n))), 1n+K.pp(one)) == Nat.mod(LV.ev(cs), 1n+K.pp(one)) : Nat}:
  +w = M.carryp(16n, cs, 0n)
  %Equal.sym(Nat, LV.ev(cs), LV.ev(M.carryp(16n, cs, 0n)), Equal.sym(Nat, LV.ev(M.carryp(16n, cs, 0n)), LV.ev(cs), carryp0_v(16n, cs))) : {Nat.mod(LV.ev(M.fold1(M.carryp(16n, cs, 0n))), 1n+K.pp(one)) == Nat.mod(_, 1n+K.pp(one)) : Nat}
  fmod_g(K.pp(one), FS.cp(one), C.shift(256n, one), K.hm_p(one, h1), LV.ev(L.take(16n, w)), LV.ev(L.drop(16n, w)), LV.ev(w), R.split256(one, h1, w), LV.ev(M.fold1(w)), V.fold1_v(one, h1, w))

# a product x < T T reduced: x mod p
def mch_v(+one: Nat, +h1: {one == 1n : Nat}, +cs: List<&2, Nat>, +hc: {Nat.is_lt(LV.ev(cs), Nat.mul(C.shift(256n, one), C.shift(256n, one))) == True{} : Bool}) -> {LV.ev(M.fin(L.carry(16n, M.foldt(L.carry(16n, M.fold1(M.carryp(16n, cs, 0n)), 0n)), 0n))) == Nat.mod(LV.ev(cs), 1n+K.pp(one)) : Nat}:
  +f1 = M.fold1(M.carryp(16n, cs, 0n))
  %Equal.sym(Nat, LV.ev(M.fin(L.carry(16n, M.foldt(L.carry(16n, M.fold1(M.carryp(16n, cs, 0n)), 0n)), 0n))), Nat.mod(LV.ev(M.foldt(L.carry(16n, M.fold1(M.carryp(16n, cs, 0n)), 0n))), 1n+K.pp(one)), fin_v(one, h1, M.foldt(L.carry(16n, M.fold1(M.carryp(16n, cs, 0n)), 0n)), mch2_lt(one, h1, f1, mch1_lt(one, h1, cs, hc)))) : {_ == Nat.mod(LV.ev(cs), 1n+K.pp(one)) : Nat}
  %Equal.sym(Nat, Nat.mod(LV.ev(M.foldt(L.carry(16n, M.fold1(M.carryp(16n, cs, 0n)), 0n))), 1n+K.pp(one)), Nat.mod(LV.ev(M.fold1(M.carryp(16n, cs, 0n))), 1n+K.pp(one)), mch2_mod(one, h1, M.fold1(M.carryp(16n, cs, 0n)))) : {_ == Nat.mod(LV.ev(cs), 1n+K.pp(one)) : Nat}
  %Equal.sym(Nat, Nat.mod(LV.ev(M.fold1(M.carryp(16n, cs, 0n))), 1n+K.pp(one)), Nat.mod(LV.ev(cs), 1n+K.pp(one)), mch1_mod(one, h1, cs)) : {_ == Nat.mod(LV.ev(cs), 1n+K.pp(one)) : Nat}
  {==}

def mch_r(+one: Nat, +h1: {one == 1n : Nat}, +cs: List<&2, Nat>, +hc: {Nat.is_lt(LV.ev(cs), Nat.mul(C.shift(256n, one), C.shift(256n, one))) == True{} : Bool}) -> {FS.reduced(one, FS.prime(one), M.fin(L.carry(16n, M.foldt(L.carry(16n, M.fold1(M.carryp(16n, cs, 0n)), 0n)), 0n))) == True{} : Bool}:
  +f1 = M.fold1(M.carryp(16n, cs, 0n))
  fin_r(one, h1, M.foldt(L.carry(16n, f1, 0n)), mch2_lt(one, h1, f1, mch1_lt(one, h1, cs, hc)))

# ---- mul, sq ----

def mul_hx(+one: Nat, +h1: {one == 1n : Nat}, +a: F.FE, +b: F.FE, +ha: {red(one, a) == True{} : Bool}, +hb: {red(one, b) == True{} : Bool}) -> {Nat.is_lt(LV.ev(M.convu(F.to_list(a), F.to_list(b))), Nat.mul(C.shift(256n, one), C.shift(256n, one))) == True{} : Bool}:
  %Equal.sym(Nat, LV.ev(M.convu(F.to_list(a), F.to_list(b))), Nat.mul(LV.ev(F.to_list(a)), LV.ev(F.to_list(b))), V.convu_v(one, h1, 16n, F.to_list(a), FO.r16(one, F.to_list(a), ha), 16n, F.to_list(b), FO.r16(one, F.to_list(b), hb))) : {Nat.is_lt(_, Nat.mul(C.shift(256n, one), C.shift(256n, one))) == True{} : Bool}
  FO.mul_lt(LV.ev(F.to_list(a)), LV.ev(F.to_list(b)), C.shift(256n, one), FO.rtt(one, h1, F.to_list(a), ha), FO.rtt(one, h1, F.to_list(b), hb))

def mul_v(+one: Nat, +h1: {one == 1n : Nat}, +a: F.FE, +b: F.FE, +ha: {red(one, a) == True{} : Bool}, +hb: {red(one, b) == True{} : Bool}) -> {val(one, F.mul(a, b)) == FS.mmul(FS.prime(one), val(one, a), val(one, b)) : Nat}:
  %Equal.sym(List<&2, Nat>, F.to_list(F.mul(a, b)), M.fin(L.carry(16n, M.foldt(L.carry(16n, M.fold1(M.carryp(16n, M.convu(F.to_list(a), F.to_list(b)), 0n)), 0n)), 0n)), mul_l(a, b)) : {FS.value(one, _) == Nat.mod(Nat.mul(FS.value(one, F.to_list(a)), FS.value(one, F.to_list(b))), FS.prime(one)) : Nat}
  %Equal.sym(Nat, FS.value(one, M.fin(L.carry(16n, M.foldt(L.carry(16n, M.fold1(M.carryp(16n, M.convu(F.to_list(a), F.to_list(b)), 0n)), 0n)), 0n))), LV.ev(M.fin(L.carry(16n, M.foldt(L.carry(16n, M.fold1(M.carryp(16n, M.convu(F.to_list(a), F.to_list(b)), 0n)), 0n)), 0n))), LV.ev_value(one, h1, M.fin(L.carry(16n, M.foldt(L.carry(16n, M.fold1(M.carryp(16n, M.convu(F.to_list(a), F.to_list(b)), 0n)), 0n)), 0n)))) : {_ == Nat.mod(Nat.mul(FS.value(one, F.to_list(a)), FS.value(one, F.to_list(b))), FS.prime(one)) : Nat}
  %Equal.sym(Nat, LV.ev(M.fin(L.carry(16n, M.foldt(L.carry(16n, M.fold1(M.carryp(16n, M.convu(F.to_list(a), F.to_list(b)), 0n)), 0n)), 0n))), Nat.mod(LV.ev(M.convu(F.to_list(a), F.to_list(b))), 1n+K.pp(one)), mch_v(one, h1, M.convu(F.to_list(a), F.to_list(b)), mul_hx(one, h1, a, b, ha, hb))) : {_ == Nat.mod(Nat.mul(FS.value(one, F.to_list(a)), FS.value(one, F.to_list(b))), FS.prime(one)) : Nat}
  %Equal.sym(Nat, LV.ev(M.convu(F.to_list(a), F.to_list(b))), Nat.mul(LV.ev(F.to_list(a)), LV.ev(F.to_list(b))), V.convu_v(one, h1, 16n, F.to_list(a), FO.r16(one, F.to_list(a), ha), 16n, F.to_list(b), FO.r16(one, F.to_list(b), hb))) : {Nat.mod(_, 1n+K.pp(one)) == Nat.mod(Nat.mul(FS.value(one, F.to_list(a)), FS.value(one, F.to_list(b))), FS.prime(one)) : Nat}
  %Equal.sym(Nat, LV.ev(F.to_list(a)), FS.value(one, F.to_list(a)), Equal.sym(Nat, FS.value(one, F.to_list(a)), LV.ev(F.to_list(a)), LV.ev_value(one, h1, F.to_list(a)))) : {Nat.mod(Nat.mul(_, LV.ev(F.to_list(b))), 1n+K.pp(one)) == Nat.mod(Nat.mul(FS.value(one, F.to_list(a)), FS.value(one, F.to_list(b))), FS.prime(one)) : Nat}
  %Equal.sym(Nat, LV.ev(F.to_list(b)), FS.value(one, F.to_list(b)), Equal.sym(Nat, FS.value(one, F.to_list(b)), LV.ev(F.to_list(b)), LV.ev_value(one, h1, F.to_list(b)))) : {Nat.mod(Nat.mul(FS.value(one, F.to_list(a)), _), 1n+K.pp(one)) == Nat.mod(Nat.mul(FS.value(one, F.to_list(a)), FS.value(one, F.to_list(b))), FS.prime(one)) : Nat}
  %Equal.sym(Nat, 1n+K.pp(one), FS.prime(one), Equal.sym(Nat, FS.prime(one), 1n+K.pp(one), K.prime_eq(one, h1))) : {Nat.mod(Nat.mul(FS.value(one, F.to_list(a)), FS.value(one, F.to_list(b))), _) == Nat.mod(Nat.mul(FS.value(one, F.to_list(a)), FS.value(one, F.to_list(b))), FS.prime(one)) : Nat}
  {==}

def mul_r(+one: Nat, +h1: {one == 1n : Nat}, +a: F.FE, +b: F.FE, +ha: {red(one, a) == True{} : Bool}, +hb: {red(one, b) == True{} : Bool}) -> {red(one, F.mul(a, b)) == True{} : Bool}:
  %Equal.sym(List<&2, Nat>, F.to_list(F.mul(a, b)), M.fin(L.carry(16n, M.foldt(L.carry(16n, M.fold1(M.carryp(16n, M.convu(F.to_list(a), F.to_list(b)), 0n)), 0n)), 0n)), mul_l(a, b)) : {FS.reduced(one, FS.prime(one), _) == True{} : Bool}
  mch_r(one, h1, M.convu(F.to_list(a), F.to_list(b)), mul_hx(one, h1, a, b, ha, hb))

def sq_hx(+one: Nat, +h1: {one == 1n : Nat}, +a: F.FE, +ha: {red(one, a) == True{} : Bool}) -> {Nat.is_lt(LV.ev(M.sqru(F.to_list(a))), Nat.mul(C.shift(256n, one), C.shift(256n, one))) == True{} : Bool}:
  %Equal.sym(Nat, LV.ev(M.sqru(F.to_list(a))), Nat.mul(LV.ev(F.to_list(a)), LV.ev(F.to_list(a))), V.sqru_v(one, h1, 16n, F.to_list(a), FO.r16(one, F.to_list(a), ha))) : {Nat.is_lt(_, Nat.mul(C.shift(256n, one), C.shift(256n, one))) == True{} : Bool}
  FO.mul_lt(LV.ev(F.to_list(a)), LV.ev(F.to_list(a)), C.shift(256n, one), FO.rtt(one, h1, F.to_list(a), ha), FO.rtt(one, h1, F.to_list(a), ha))

def sq_v(+one: Nat, +h1: {one == 1n : Nat}, +a: F.FE, +ha: {red(one, a) == True{} : Bool}) -> {val(one, F.sq(a)) == FS.mmul(FS.prime(one), val(one, a), val(one, a)) : Nat}:
  %Equal.sym(List<&2, Nat>, F.to_list(F.sq(a)), M.fin(L.carry(16n, M.foldt(L.carry(16n, M.fold1(M.carryp(16n, M.sqru(F.to_list(a)), 0n)), 0n)), 0n)), sq_l(a)) : {FS.value(one, _) == Nat.mod(Nat.mul(FS.value(one, F.to_list(a)), FS.value(one, F.to_list(a))), FS.prime(one)) : Nat}
  %Equal.sym(Nat, FS.value(one, M.fin(L.carry(16n, M.foldt(L.carry(16n, M.fold1(M.carryp(16n, M.sqru(F.to_list(a)), 0n)), 0n)), 0n))), LV.ev(M.fin(L.carry(16n, M.foldt(L.carry(16n, M.fold1(M.carryp(16n, M.sqru(F.to_list(a)), 0n)), 0n)), 0n))), LV.ev_value(one, h1, M.fin(L.carry(16n, M.foldt(L.carry(16n, M.fold1(M.carryp(16n, M.sqru(F.to_list(a)), 0n)), 0n)), 0n)))) : {_ == Nat.mod(Nat.mul(FS.value(one, F.to_list(a)), FS.value(one, F.to_list(a))), FS.prime(one)) : Nat}
  %Equal.sym(Nat, LV.ev(M.fin(L.carry(16n, M.foldt(L.carry(16n, M.fold1(M.carryp(16n, M.sqru(F.to_list(a)), 0n)), 0n)), 0n))), Nat.mod(LV.ev(M.sqru(F.to_list(a))), 1n+K.pp(one)), mch_v(one, h1, M.sqru(F.to_list(a)), sq_hx(one, h1, a, ha))) : {_ == Nat.mod(Nat.mul(FS.value(one, F.to_list(a)), FS.value(one, F.to_list(a))), FS.prime(one)) : Nat}
  %Equal.sym(Nat, LV.ev(M.sqru(F.to_list(a))), Nat.mul(LV.ev(F.to_list(a)), LV.ev(F.to_list(a))), V.sqru_v(one, h1, 16n, F.to_list(a), FO.r16(one, F.to_list(a), ha))) : {Nat.mod(_, 1n+K.pp(one)) == Nat.mod(Nat.mul(FS.value(one, F.to_list(a)), FS.value(one, F.to_list(a))), FS.prime(one)) : Nat}
  %Equal.sym(Nat, LV.ev(F.to_list(a)), FS.value(one, F.to_list(a)), Equal.sym(Nat, FS.value(one, F.to_list(a)), LV.ev(F.to_list(a)), LV.ev_value(one, h1, F.to_list(a)))) : {Nat.mod(Nat.mul(_, LV.ev(F.to_list(a))), 1n+K.pp(one)) == Nat.mod(Nat.mul(FS.value(one, F.to_list(a)), FS.value(one, F.to_list(a))), FS.prime(one)) : Nat}
  %Equal.sym(Nat, LV.ev(F.to_list(a)), FS.value(one, F.to_list(a)), Equal.sym(Nat, FS.value(one, F.to_list(a)), LV.ev(F.to_list(a)), LV.ev_value(one, h1, F.to_list(a)))) : {Nat.mod(Nat.mul(FS.value(one, F.to_list(a)), _), 1n+K.pp(one)) == Nat.mod(Nat.mul(FS.value(one, F.to_list(a)), FS.value(one, F.to_list(a))), FS.prime(one)) : Nat}
  %Equal.sym(Nat, 1n+K.pp(one), FS.prime(one), Equal.sym(Nat, FS.prime(one), 1n+K.pp(one), K.prime_eq(one, h1))) : {Nat.mod(Nat.mul(FS.value(one, F.to_list(a)), FS.value(one, F.to_list(a))), _) == Nat.mod(Nat.mul(FS.value(one, F.to_list(a)), FS.value(one, F.to_list(a))), FS.prime(one)) : Nat}
  {==}

def sq_r(+one: Nat, +h1: {one == 1n : Nat}, +a: F.FE, +ha: {red(one, a) == True{} : Bool}) -> {red(one, F.sq(a)) == True{} : Bool}:
  %Equal.sym(List<&2, Nat>, F.to_list(F.sq(a)), M.fin(L.carry(16n, M.foldt(L.carry(16n, M.fold1(M.carryp(16n, M.sqru(F.to_list(a)), 0n)), 0n)), 0n)), sq_l(a)) : {FS.reduced(one, FS.prime(one), _) == True{} : Bool}
  mch_r(one, h1, M.sqru(F.to_list(a)), sq_hx(one, h1, a, ha))

# ---- in the limb value ----

def mul_e(+one: Nat, +h1: {one == 1n : Nat}, +a: F.FE, +b: F.FE, +ha: {red(one, a) == True{} : Bool}, +hb: {red(one, b) == True{} : Bool}) -> {LV.ev(F.to_list(F.mul(a, b))) == Nat.mod(Nat.mul(LV.ev(F.to_list(a)), LV.ev(F.to_list(b))), 1n+K.pp(one)) : Nat}:
  %Equal.sym(List<&2, Nat>, F.to_list(F.mul(a, b)), M.fin(L.carry(16n, M.foldt(L.carry(16n, M.fold1(M.carryp(16n, M.convu(F.to_list(a), F.to_list(b)), 0n)), 0n)), 0n)), mul_l(a, b)) : {LV.ev(_) == Nat.mod(Nat.mul(LV.ev(F.to_list(a)), LV.ev(F.to_list(b))), 1n+K.pp(one)) : Nat}
  %Equal.sym(Nat, LV.ev(M.fin(L.carry(16n, M.foldt(L.carry(16n, M.fold1(M.carryp(16n, M.convu(F.to_list(a), F.to_list(b)), 0n)), 0n)), 0n))), Nat.mod(LV.ev(M.convu(F.to_list(a), F.to_list(b))), 1n+K.pp(one)), mch_v(one, h1, M.convu(F.to_list(a), F.to_list(b)), mul_hx(one, h1, a, b, ha, hb))) : {_ == Nat.mod(Nat.mul(LV.ev(F.to_list(a)), LV.ev(F.to_list(b))), 1n+K.pp(one)) : Nat}
  %Equal.sym(Nat, LV.ev(M.convu(F.to_list(a), F.to_list(b))), Nat.mul(LV.ev(F.to_list(a)), LV.ev(F.to_list(b))), V.convu_v(one, h1, 16n, F.to_list(a), FO.r16(one, F.to_list(a), ha), 16n, F.to_list(b), FO.r16(one, F.to_list(b), hb))) : {Nat.mod(_, 1n+K.pp(one)) == Nat.mod(Nat.mul(LV.ev(F.to_list(a)), LV.ev(F.to_list(b))), 1n+K.pp(one)) : Nat}
  {==}

def sq_e(+one: Nat, +h1: {one == 1n : Nat}, +a: F.FE, +ha: {red(one, a) == True{} : Bool}) -> {LV.ev(F.to_list(F.sq(a))) == Nat.mod(Nat.mul(LV.ev(F.to_list(a)), LV.ev(F.to_list(a))), 1n+K.pp(one)) : Nat}:
  %Equal.sym(List<&2, Nat>, F.to_list(F.sq(a)), M.fin(L.carry(16n, M.foldt(L.carry(16n, M.fold1(M.carryp(16n, M.sqru(F.to_list(a)), 0n)), 0n)), 0n)), sq_l(a)) : {LV.ev(_) == Nat.mod(Nat.mul(LV.ev(F.to_list(a)), LV.ev(F.to_list(a))), 1n+K.pp(one)) : Nat}
  %Equal.sym(Nat, LV.ev(M.fin(L.carry(16n, M.foldt(L.carry(16n, M.fold1(M.carryp(16n, M.sqru(F.to_list(a)), 0n)), 0n)), 0n))), Nat.mod(LV.ev(M.sqru(F.to_list(a))), 1n+K.pp(one)), mch_v(one, h1, M.sqru(F.to_list(a)), sq_hx(one, h1, a, ha))) : {_ == Nat.mod(Nat.mul(LV.ev(F.to_list(a)), LV.ev(F.to_list(a))), 1n+K.pp(one)) : Nat}
  %Equal.sym(Nat, LV.ev(M.sqru(F.to_list(a))), Nat.mul(LV.ev(F.to_list(a)), LV.ev(F.to_list(a))), V.sqru_v(one, h1, 16n, F.to_list(a), FO.r16(one, F.to_list(a), ha))) : {Nat.mod(_, 1n+K.pp(one)) == Nat.mod(Nat.mul(LV.ev(F.to_list(a)), LV.ev(F.to_list(a))), 1n+K.pp(one)) : Nat}
  {==}

# ---- records and lists ----

def rt(r: F.FE) -> {F.of_list(F.to_list(r)) == r : F.FE}:
  match r:
    case F.FE{x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15}:
      {==}

# a reduced list is the list of its record
def rec_l(+one: Nat, +x: List<&2, Nat>, +hx: {FS.reduced(one, FS.prime(one), x) == True{} : Bool}) -> {F.to_list(F.of_list(x)) == x : List<&2, Nat>}:
  BR.shape(one, x, FO.r16(one, x, hx))

def rec_r(+one: Nat, +x: List<&2, Nat>, +hx: {FS.reduced(one, FS.prime(one), x) == True{} : Bool}) -> {red(one, F.of_list(x)) == True{} : Bool}:
  %Equal.sym(List<&2, Nat>, F.to_list(F.of_list(x)), x, rec_l(one, x, hx)) : {FS.reduced(one, FS.prime(one), _) == True{} : Bool}
  hx

def rec_v(+one: Nat, +x: List<&2, Nat>, +hx: {FS.reduced(one, FS.prime(one), x) == True{} : Bool}) -> {val(one, F.of_list(x)) == FS.value(one, x) : Nat}:
  %Equal.sym(List<&2, Nat>, F.to_list(F.of_list(x)), x, rec_l(one, x, hx)) : {FS.value(one, _) == FS.value(one, x) : Nat}
  {==}

# ---- selection ----

def sel1_l(+one: Nat, +h1: {one == 1n : Nat}, +x: F.FE, +y: F.FE, +hx: {red(one, x) == True{} : Bool}, +hy: {red(one, y) == True{} : Bool}) -> {F.select(1n, x, y) == x : F.FE}:
  +e = Equal.trans(List<&2, Nat>, F.to_list(F.select(1n, x, y)), M.selu(1n, F.to_list(x), F.to_list(y)), F.to_list(x), BR.select_b(1n, x, y), V.selu_one(one, h1, 16n, F.to_list(x), F.to_list(y), FO.r16(one, F.to_list(x), hx), FO.r16(one, F.to_list(y), hy)))
  Equal.trans(F.FE, F.select(1n, x, y), F.of_list(F.to_list(F.select(1n, x, y))), x, Equal.sym(F.FE, F.of_list(F.to_list(F.select(1n, x, y))), F.select(1n, x, y), rt(F.select(1n, x, y))), Equal.trans(F.FE, F.of_list(F.to_list(F.select(1n, x, y))), F.of_list(F.to_list(x)), x, Equal.cong(List<&2, Nat>, F.FE, l => F.of_list(l), F.to_list(F.select(1n, x, y)), F.to_list(x), e), rt(x)))

def sel0_l(+one: Nat, +h1: {one == 1n : Nat}, +x: F.FE, +y: F.FE, +hx: {red(one, x) == True{} : Bool}, +hy: {red(one, y) == True{} : Bool}) -> {F.select(0n, x, y) == y : F.FE}:
  +e = Equal.trans(List<&2, Nat>, F.to_list(F.select(0n, x, y)), M.selu(0n, F.to_list(x), F.to_list(y)), F.to_list(y), BR.select_b(0n, x, y), V.selu_zero(one, h1, 16n, F.to_list(x), F.to_list(y), FO.r16(one, F.to_list(x), hx), FO.r16(one, F.to_list(y), hy)))
  Equal.trans(F.FE, F.select(0n, x, y), F.of_list(F.to_list(F.select(0n, x, y))), y, Equal.sym(F.FE, F.of_list(F.to_list(F.select(0n, x, y))), F.select(0n, x, y), rt(F.select(0n, x, y))), Equal.trans(F.FE, F.of_list(F.to_list(F.select(0n, x, y))), F.of_list(F.to_list(y)), y, Equal.cong(List<&2, Nat>, F.FE, l => F.of_list(l), F.to_list(F.select(0n, x, y)), F.to_list(y), e), rt(y)))
