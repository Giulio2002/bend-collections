# a value below p, as a reduced list, in the limb value
def rl(+one: Nat, +h1: {one == 1n : Nat}, +x: List<&2, Nat>, +r: {Nat.is_lt(LV.ev(x), 1n+K.pp(one)) == True{} : Bool}, +l: {FS.limbs16(one, 16n, x) == True{} : Bool}) -> {FS.reduced(one, FS.prime(one), x) == True{} : Bool}:
