  +hu = I.lt_subst_l(LV.ev(xs), LV.ev(u), Nat.add(1n+K.pp(one), 1n+K.pp(one)), Equal.sym(Nat, LV.ev(u), LV.ev(xs), V.carry0_v(16n, xs)), hx)
