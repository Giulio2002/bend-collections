def wt1(+one: Nat, +h1: {one == 1n : Nat}, +hp: NP.Prime(FS.prime(one)), +hc: {Nat.is_eq(FS.mpow(FS.prime(one), Nat.sub(FS.prime(one), 7n), Nat.div(Nat.sub(FS.prime(one), 1n), 3n)), 1n) == False{} : Bool}, +a: PX.PT, +r: PX.PT, +v: Nat, +ha: {PP.pred(one, a) == True{} : Bool}, +va: {GS.valid(FS.prime(one), PP.pv(one, a)) == True{} : Bool}, +hr: {PP.pred(one, r) == True{} : Bool}, +vr: {GS.valid(FS.prime(one), PP.pv(one, r)) == True{} : Bool}, +he: {GS.equiv(FS.prime(one), PP.pv(one, r), GS.smul(FS.prime(one), v, PP.pv(one, a))) == True{} : Bool}, b2: Nat, +hb2: {Nat.is_lt(b2, 2n) == True{} : Bool}, b3: Nat, +hb3: {Nat.is_lt(b3, 2n) == True{} : Bool}, b4: Nat, +hb4: {Nat.is_lt(b4, 2n) == True{} : Bool}) -> {GS.equiv(FS.prime(one), PP.pv(one, PX.add(PX.dbl(PX.dbl(PX.dbl(PX.dbl(r)))), WR.tpk(1n, b2, b3, b4, a))), GS.smul(FS.prime(one), G4.nxt(b4, G4.nxt(b3, G4.nxt(b2, G4.nxt(1n, v)))), PP.pv(one, a))) == True{} : Bool}:
