# the step of the code
def wst_e(+one: Nat, +h1: {one == 1n : Nat}, +hp: NP.Prime(FS.prime(one)), +hc: {Nat.is_eq(FS.mpow(FS.prime(one), Nat.sub(FS.prime(one), 7n), Nat.div(Nat.sub(FS.prime(one), 1n), 3n)), 1n) == False{} : Bool}, +a: PX.PT, +r: PX.PT, +v: Nat, +ha: {PP.pred(one, a) == True{} : Bool}, +va: {GS.valid(FS.prime(one), PP.pv(one, a)) == True{} : Bool}, +hr: {PP.pred(one, r) == True{} : Bool}, +vr: {GS.valid(FS.prime(one), PP.pv(one, r)) == True{} : Bool}, +he: {GS.equiv(FS.prime(one), PP.pv(one, r), GS.smul(FS.prime(one), v, PP.pv(one, a))) == True{} : Bool}, +b1: Nat, +b2: Nat, +b3: Nat, +b4: Nat, +hb1: {Nat.is_lt(b1, 2n) == True{} : Bool}, +hb2: {Nat.is_lt(b2, 2n) == True{} : Bool}, +hb3: {Nat.is_lt(b3, 2n) == True{} : Bool}, +hb4: {Nat.is_lt(b4, 2n) == True{} : Bool}) -> {GS.equiv(FS.prime(one), PP.pv(one, PX.add(PX.dbl(PX.dbl(PX.dbl(PX.dbl(r)))), PX.tsel(b1, b2, b3, b4, PX.tab(a)))), GS.smul(FS.prime(one), G4.nxt(b4, G4.nxt(b3, G4.nxt(b2, G4.nxt(b1, v)))), PP.pv(one, a))) == True{} : Bool}:
  %Equal.sym(PX.PT, PX.tsel(b1, b2, b3, b4, PX.tab(a)), WR.tpk(b1, b2, b3, b4, a), WR.tsel_tab(one, h1, b1, b2, b3, b4, hb1, hb2, hb3, hb4, a, ha)) : {GS.equiv(FS.prime(one), PP.pv(one, PX.add(PX.dbl(PX.dbl(PX.dbl(PX.dbl(r)))), _)), GS.smul(FS.prime(one), G4.nxt(b4, G4.nxt(b3, G4.nxt(b2, G4.nxt(b1, v)))), PP.pv(one, a))) == True{} : Bool}
  wt(one, h1, hp, hc, a, r, v, ha, va, hr, vr, he, b1, hb1, b2, hb2, b3, hb3, b4, hb4)

def wst_vd(+one: Nat, +h1: {one == 1n : Nat}, +hp: NP.Prime(FS.prime(one)), +hc: {Nat.is_eq(FS.mpow(FS.prime(one), Nat.sub(FS.prime(one), 7n), Nat.div(Nat.sub(FS.prime(one), 1n), 3n)), 1n) == False{} : Bool}, +a: PX.PT, +r: PX.PT, +ha: {PP.pred(one, a) == True{} : Bool}, +va: {GS.valid(FS.prime(one), PP.pv(one, a)) == True{} : Bool}, +hr: {PP.pred(one, r) == True{} : Bool}, +vr: {GS.valid(FS.prime(one), PP.pv(one, r)) == True{} : Bool}, +b1: Nat, +b2: Nat, +b3: Nat, +b4: Nat, +hb1: {Nat.is_lt(b1, 2n) == True{} : Bool}, +hb2: {Nat.is_lt(b2, 2n) == True{} : Bool}, +hb3: {Nat.is_lt(b3, 2n) == True{} : Bool}, +hb4: {Nat.is_lt(b4, 2n) == True{} : Bool}) -> {GS.valid(FS.prime(one), PP.pv(one, PX.add(PX.dbl(PX.dbl(PX.dbl(PX.dbl(r)))), PX.tsel(b1, b2, b3, b4, PX.tab(a))))) == True{} : Bool}:
  %Equal.sym(PX.PT, PX.tsel(b1, b2, b3, b4, PX.tab(a)), WR.tpk(b1, b2, b3, b4, a), WR.tsel_tab(one, h1, b1, b2, b3, b4, hb1, hb2, hb3, hb4, a, ha)) : {GS.valid(FS.prime(one), PP.pv(one, PX.add(PX.dbl(PX.dbl(PX.dbl(PX.dbl(r)))), _))) == True{} : Bool}
  %Equal.sym(CV.SPoint, PP.pv(one, PX.add(PX.dbl(PX.dbl(PX.dbl(PX.dbl(r)))), WR.tpk(b1, b2, b3, b4, a))), CV.padd(FS.prime(one), PP.pv(one, PX.dbl(PX.dbl(PX.dbl(PX.dbl(r))))), PP.pv(one, WR.tpk(b1, b2, b3, b4, a))), PP.padd_v(one, h1, PX.dbl(PX.dbl(PX.dbl(PX.dbl(r)))), WR.tpk(b1, b2, b3, b4, a), WR.d4_r(one, h1, r, hr), WR.tpk_r(one, h1, b1, b2, b3, b4, a, ha))) : {GS.valid(FS.prime(one), _) == True{} : Bool}
  %Equal.sym(CV.SPoint, PP.pv(one, PX.dbl(PX.dbl(PX.dbl(PX.dbl(r))))), CV.pdbl(FS.prime(one), CV.pdbl(FS.prime(one), CV.pdbl(FS.prime(one), CV.pdbl(FS.prime(one), PP.pv(one, r))))), WR.d4_v(one, h1, r, hr)) : {GS.valid(FS.prime(one), CV.padd(FS.prime(one), _, PP.pv(one, WR.tpk(b1, b2, b3, b4, a)))) == True{} : Bool}
  GP.group_closed(one, h1, hp, hc, CV.pdbl(FS.prime(one), CV.pdbl(FS.prime(one), CV.pdbl(FS.prime(one), CV.pdbl(FS.prime(one), PP.pv(one, r))))), PP.pv(one, WR.tpk(b1, b2, b3, b4, a)), dbl4_vd(one, h1, hp, hc, PP.pv(one, r), vr), tpk_vd(one, h1, hp, hc, b1, b2, b3, b4, a, ha, va))

# ---- the loop over the windows ----

# a multiple of 4 bits
def wgo_vd(+one: Nat, +h1: {one == 1n : Nat}, +hp: NP.Prime(FS.prime(one)), +hc: {Nat.is_eq(FS.mpow(FS.prime(one), Nat.sub(FS.prime(one), 7n), Nat.div(Nat.sub(FS.prime(one), 1n), 3n)), 1n) == False{} : Bool}, bs: List<&2, Nat>, +a: PX.PT, +r: PX.PT, +ha: {PP.pred(one, a) == True{} : Bool}, +va: {GS.valid(FS.prime(one), PP.pv(one, a)) == True{} : Bool}, +hr: {PP.pred(one, r) == True{} : Bool}, +vr: {GS.valid(FS.prime(one), PP.pv(one, r)) == True{} : Bool}, +hb: {BV.all01(bs) == True{} : Bool}, +hq: {WR.ok4(bs) == True{} : Bool}) -> {GS.valid(FS.prime(one), PP.pv(one, PX.wgo(bs, PX.tab(a), r))) == True{} : Bool}:
  match bs:
    case Nil{}:
      vr
    case +b1 <> Nil{}:
      Empty.absurd({GS.valid(FS.prime(one), PP.pv(one, PX.wgo([b1], PX.tab(a), r))) == True{} : Bool}, Lg.false_true(hq))
    case +b1 <> +b2 <> Nil{}:
      Empty.absurd({GS.valid(FS.prime(one), PP.pv(one, PX.wgo([b1, b2], PX.tab(a), r))) == True{} : Bool}, Lg.false_true(hq))
    case +b1 <> +b2 <> +b3 <> Nil{}:
      Empty.absurd({GS.valid(FS.prime(one), PP.pv(one, PX.wgo([b1, b2, b3], PX.tab(a), r))) == True{} : Bool}, Lg.false_true(hq))
    case +b1 <> +b2 <> +b3 <> +b4 <> +t:
      +c1 = Lg.and_right(Nat.is_lt(b1, 2n), BV.all01(b2 <> b3 <> b4 <> t), hb)
      +c2 = Lg.and_right(Nat.is_lt(b2, 2n), BV.all01(b3 <> b4 <> t), c1)
      +c3 = Lg.and_right(Nat.is_lt(b3, 2n), BV.all01(b4 <> t), c2)
      +hb1 = Lg.and_left(Nat.is_lt(b1, 2n), BV.all01(b2 <> b3 <> b4 <> t), hb)
      +hb2 = Lg.and_left(Nat.is_lt(b2, 2n), BV.all01(b3 <> b4 <> t), c1)
      +hb3 = Lg.and_left(Nat.is_lt(b3, 2n), BV.all01(b4 <> t), c2)
      +hb4 = Lg.and_left(Nat.is_lt(b4, 2n), BV.all01(t), c3)
      +hbt = Lg.and_right(Nat.is_lt(b4, 2n), BV.all01(t), c3)
      wgo_vd(one, h1, hp, hc, t, a, PX.add(PX.dbl(PX.dbl(PX.dbl(PX.dbl(r)))), PX.tsel(b1, b2, b3, b4, PX.tab(a))), ha, va, WR.wst_r(one, h1, a, r, ha, hr, b1, b2, b3, b4, hb1, hb2, hb3, hb4), wst_vd(one, h1, hp, hc, a, r, ha, va, hr, vr, b1, b2, b3, b4, hb1, hb2, hb3, hb4), hbt, hq)

def wgo_e(+one: Nat, +h1: {one == 1n : Nat}, +hp: NP.Prime(FS.prime(one)), +hc: {Nat.is_eq(FS.mpow(FS.prime(one), Nat.sub(FS.prime(one), 7n), Nat.div(Nat.sub(FS.prime(one), 1n), 3n)), 1n) == False{} : Bool}, bs: List<&2, Nat>, +a: PX.PT, +r: PX.PT, +v: Nat, +ha: {PP.pred(one, a) == True{} : Bool}, +va: {GS.valid(FS.prime(one), PP.pv(one, a)) == True{} : Bool}, +hr: {PP.pred(one, r) == True{} : Bool}, +vr: {GS.valid(FS.prime(one), PP.pv(one, r)) == True{} : Bool}, +he: {GS.equiv(FS.prime(one), PP.pv(one, r), GS.smul(FS.prime(one), v, PP.pv(one, a))) == True{} : Bool}, +hb: {BV.all01(bs) == True{} : Bool}, +hq: {WR.ok4(bs) == True{} : Bool}) -> {GS.equiv(FS.prime(one), PP.pv(one, PX.wgo(bs, PX.tab(a), r)), GS.smul(FS.prime(one), G4.bvl(bs, v), PP.pv(one, a))) == True{} : Bool}:
  match bs:
    case Nil{}:
      he
    case +b1 <> Nil{}:
      Empty.absurd({GS.equiv(FS.prime(one), PP.pv(one, PX.wgo([b1], PX.tab(a), r)), GS.smul(FS.prime(one), G4.bvl([b1], v), PP.pv(one, a))) == True{} : Bool}, Lg.false_true(hq))
    case +b1 <> +b2 <> Nil{}:
      Empty.absurd({GS.equiv(FS.prime(one), PP.pv(one, PX.wgo([b1, b2], PX.tab(a), r)), GS.smul(FS.prime(one), G4.bvl([b1, b2], v), PP.pv(one, a))) == True{} : Bool}, Lg.false_true(hq))
    case +b1 <> +b2 <> +b3 <> Nil{}:
      Empty.absurd({GS.equiv(FS.prime(one), PP.pv(one, PX.wgo([b1, b2, b3], PX.tab(a), r)), GS.smul(FS.prime(one), G4.bvl([b1, b2, b3], v), PP.pv(one, a))) == True{} : Bool}, Lg.false_true(hq))
    case +b1 <> +b2 <> +b3 <> +b4 <> +t:
      +c1 = Lg.and_right(Nat.is_lt(b1, 2n), BV.all01(b2 <> b3 <> b4 <> t), hb)
      +c2 = Lg.and_right(Nat.is_lt(b2, 2n), BV.all01(b3 <> b4 <> t), c1)
      +c3 = Lg.and_right(Nat.is_lt(b3, 2n), BV.all01(b4 <> t), c2)
      +hb1 = Lg.and_left(Nat.is_lt(b1, 2n), BV.all01(b2 <> b3 <> b4 <> t), hb)
      +hb2 = Lg.and_left(Nat.is_lt(b2, 2n), BV.all01(b3 <> b4 <> t), c1)
      +hb3 = Lg.and_left(Nat.is_lt(b3, 2n), BV.all01(b4 <> t), c2)
      +hb4 = Lg.and_left(Nat.is_lt(b4, 2n), BV.all01(t), c3)
      +hbt = Lg.and_right(Nat.is_lt(b4, 2n), BV.all01(t), c3)
      wgo_e(one, h1, hp, hc, t, a, PX.add(PX.dbl(PX.dbl(PX.dbl(PX.dbl(r)))), PX.tsel(b1, b2, b3, b4, PX.tab(a))), G4.nxt(b4, G4.nxt(b3, G4.nxt(b2, G4.nxt(b1, v)))), ha, va, WR.wst_r(one, h1, a, r, ha, hr, b1, b2, b3, b4, hb1, hb2, hb3, hb4), wst_vd(one, h1, hp, hc, a, r, ha, va, hr, vr, b1, b2, b3, b4, hb1, hb2, hb3, hb4), wst_e(one, h1, hp, hc, a, r, v, ha, va, hr, vr, he, b1, b2, b3, b4, hb1, hb2, hb3, hb4), hbt, hq)

# ---- [k] a ----

def inf_vd(+one: Nat, +h1: {one == 1n : Nat}, +hp: NP.Prime(FS.prime(one)), +hc: {Nat.is_eq(FS.mpow(FS.prime(one), Nat.sub(FS.prime(one), 7n), Nat.div(Nat.sub(FS.prime(one), 1n), 3n)), 1n) == False{} : Bool}) -> {GS.valid(FS.prime(one), PP.pv(one, PX.infinity())) == True{} : Bool}:
  %Equal.sym(CV.SPoint, PP.pv(one, PX.infinity()), CV.infinity(), PM.pinf_v(one, h1)) : {GS.valid(FS.prime(one), _) == True{} : Bool}
  GP.group_infinity(one, h1, hp, hc)

def inf_e(+one: Nat, +h1: {one == 1n : Nat}, +hp: NP.Prime(FS.prime(one)), +hc: {Nat.is_eq(FS.mpow(FS.prime(one), Nat.sub(FS.prime(one), 7n), Nat.div(Nat.sub(FS.prime(one), 1n), 3n)), 1n) == False{} : Bool}, +a: PX.PT) -> {GS.equiv(FS.prime(one), PP.pv(one, PX.infinity()), GS.smul(FS.prime(one), 0n, PP.pv(one, a))) == True{} : Bool}:
  %Equal.sym(CV.SPoint, PP.pv(one, PX.infinity()), CV.infinity(), PM.pinf_v(one, h1)) : {GS.equiv(FS.prime(one), _, GS.smul(FS.prime(one), 0n, PP.pv(one, a))) == True{} : Bool}
  GP.equiv_refl(one, h1, hp, hc, CV.infinity())

def wmul_vd(+one: Nat, +h1: {one == 1n : Nat}, +hp: NP.Prime(FS.prime(one)), +hc: {Nat.is_eq(FS.mpow(FS.prime(one), Nat.sub(FS.prime(one), 7n), Nat.div(Nat.sub(FS.prime(one), 1n), 3n)), 1n) == False{} : Bool}, bs: List<&2, Nat>, +a: PX.PT, +ha: {PP.pred(one, a) == True{} : Bool}, +va: {GS.valid(FS.prime(one), PP.pv(one, a)) == True{} : Bool}, +hb: {BV.all01(bs) == True{} : Bool}, +hq: {WR.ok4(bs) == True{} : Bool}) -> {GS.valid(FS.prime(one), PP.pv(one, PX.wmul(bs, a))) == True{} : Bool}:
  match bs:
    case Nil{}:
      inf_vd(one, h1, hp, hc)
    case +b <> +t:
      wgo_vd(one, h1, hp, hc, b <> t, a, PX.infinity(), ha, va, PM.pinf_r(one, h1), inf_vd(one, h1, hp, hc), hb, hq)

# wmul(bits, a) is [v] a for the number v of the bits
def wmul_e(+one: Nat, +h1: {one == 1n : Nat}, +hp: NP.Prime(FS.prime(one)), +hc: {Nat.is_eq(FS.mpow(FS.prime(one), Nat.sub(FS.prime(one), 7n), Nat.div(Nat.sub(FS.prime(one), 1n), 3n)), 1n) == False{} : Bool}, bs: List<&2, Nat>, +a: PX.PT, +ha: {PP.pred(one, a) == True{} : Bool}, +va: {GS.valid(FS.prime(one), PP.pv(one, a)) == True{} : Bool}, +hb: {BV.all01(bs) == True{} : Bool}, +hq: {WR.ok4(bs) == True{} : Bool}) -> {GS.equiv(FS.prime(one), PP.pv(one, PX.wmul(bs, a)), GS.smul(FS.prime(one), G4.bvl(bs, 0n), PP.pv(one, a))) == True{} : Bool}:
  match bs:
    case Nil{}:
      inf_e(one, h1, hp, hc, a)
    case +b <> +t:
      wgo_e(one, h1, hp, hc, b <> t, a, PX.infinity(), 0n, ha, va, PM.pinf_r(one, h1), inf_vd(one, h1, hp, hc), inf_e(one, h1, hp, hc, a), hb, hq)
