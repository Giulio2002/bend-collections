def snz(+one: Nat, +h1: {one == 1n : Nat}, +gp: NP.Prime(FS.prime(one)), +gc: {Nat.is_eq(FS.mpow(FS.prime(one), Nat.sub(FS.prime(one), 7n), Nat.div(Nat.sub(FS.prime(one), 1n), 3n)), 1n) == False{} : Bool}, +hc: List<&2, U32>, +d: List<&2, Nat>, +hd: {FS.reduced(one, FS.order(one), d) == True{} : Bool}, +pb: List<&2, U32>, +m: List<&2, U32>, +k0: List<&2, Nat>, +hk0: {FS.reduced(one, FS.order(one), k0) == True{} : Bool}, z: Bool) -> {SC.sign_nz(hc, d, pb, m, k0, Bool.not(z)) == SS.sign_kz(one, hc, FS.value(one, d), pb, m, FS.value(one, k0), z) : Maybe<&2, List<&2, U32>>}:
  match z:
    case True{}:
      {==}
    case False{}:
      +hg = PA.g_r(one, h1)
      +hm = PM.mul_r(one, h1, k0, P.g(), SL.sl16(one, k0, hk0), hg)
      %Equal.sym(CV.SPoint, CV.g(one), PT.pv(one, P.g()), Equal.sym(CV.SPoint, PT.pv(one, P.g()), CV.g(one), PA.g_v(one, h1))) : {SC.sign_k(hc, d, pb, m, k0, P.to_affine(P.mul(k0, P.g()))) == SS.sign_r(one, hc, FS.value(one, d), pb, m, FS.value(one, k0), CV.to_affine(FS.prime(one), CV.pmul(FS.prime(one), FS.value(one, k0), _))) : Maybe<&2, List<&2, U32>>}
      %Equal.sym(CV.SAffine, CV.to_affine(FS.prime(one), CV.pmul(FS.prime(one), FS.value(one, k0), PT.pv(one, P.g()))), CV.to_affine(FS.prime(one), PT.pv(one, P.mul(k0, P.g()))), PM.mul_aff(one, h1, gp, gc, k0, P.g(), SL.sl16(one, k0, hk0), hg, PM.g_vd(one, h1))) : {SC.sign_k(hc, d, pb, m, k0, P.to_affine(P.mul(k0, P.g()))) == SS.sign_r(one, hc, FS.value(one, d), pb, m, FS.value(one, k0), _) : Maybe<&2, List<&2, U32>>}
