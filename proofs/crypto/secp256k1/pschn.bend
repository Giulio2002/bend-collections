def lxb(+one: Nat, +h1: {one == 1n : Nat}, +x: List<&2, Nat>, +hl: {FS.limbs16(one, 16n, x) == True{} : Bool}, b: Bool, +hb: {Nat.is_lt(FS.value(one, x), FS.prime(one)) == b : Bool}) -> {PE.mpv(one, SC.lift_if(x, b)) == SS.lift_if(one, FS.value(one, x), b) : Maybe<&2, CV.SPoint>}:
  match b:
    case True{}:
      PE.decompress_v(one, h1, x, 0n, SL.red_of(one, x, hl, hb), {==})
    case False{}:
      {==}

def lxr(+one: Nat, +h1: {one == 1n : Nat}, +x: List<&2, Nat>, +hl: {FS.limbs16(one, 16n, x) == True{} : Bool}, b: Bool, +hb: {Nat.is_lt(FS.value(one, x), FS.prime(one)) == b : Bool}) -> {PE.mpred(one, SC.lift_if(x, b)) == True{} : Bool}:
  match b:
    case True{}:
      PE.decompress_r(one, h1, x, 0n, SL.red_of(one, x, hl, hb), {==})
    case False{}:
      {==}

def lx(+one: Nat, +h1: {one == 1n : Nat}, +x: List<&2, Nat>, +hl: {FS.limbs16(one, 16n, x) == True{} : Bool}) -> {PE.mpv(one, SC.lift_x(x)) == SS.lift_x(one, FS.value(one, x)) : Maybe<&2, CV.SPoint>}:
  %Equal.sym(Bool, F.lt_p(x), Nat.is_lt(FS.value(one, x), FS.prime(one)), FW.lt_p_f(one, h1, x)) : {PE.mpv(one, SC.lift_if(x, _)) == SS.lift_if(one, FS.value(one, x), Nat.is_lt(FS.value(one, x), FS.prime(one))) : Maybe<&2, CV.SPoint>}
  lxb(one, h1, x, hl, Nat.is_lt(FS.value(one, x), FS.prime(one)), {==})

def lx_r(+one: Nat, +h1: {one == 1n : Nat}, +x: List<&2, Nat>, +hl: {FS.limbs16(one, 16n, x) == True{} : Bool}) -> {PE.mpred(one, SC.lift_x(x)) == True{} : Bool}:
  %Equal.sym(Bool, F.lt_p(x), Nat.is_lt(FS.value(one, x), FS.prime(one)), FW.lt_p_f(one, h1, x)) : {PE.mpred(one, SC.lift_if(x, _)) == True{} : Bool}
  lxr(one, h1, x, hl, Nat.is_lt(FS.value(one, x), FS.prime(one)), {==})

def vlen(+one: Nat, +h1: {one == 1n : Nat}, +hc: List<&2, U32>, +pk: List<&2, U32>, +m: List<&2, U32>, +sig: List<&2, U32>, a: Bool, b: Bool, +ha: {B.has_len(32n, pk) == a : Bool}, +hb: {B.has_len(64n, sig) == b : Bool}) -> {SC.verify_len(hc, pk, m, sig, Bool.and(a, b)) == SS.verify_len(one, hc, pk, m, sig, Bool.and(a, b)) : Bool}:
  match a b:
    case True{} True{}:
      +hl = BY.of_be_limbs(one, h1, pk, ha)
      %Equal.sym(Nat, CV.os2ip(pk), FS.value(one, B.of_be(pk)), Equal.sym(Nat, FS.value(one, B.of_be(pk)), CV.os2ip(pk), BY.of_be_value(one, h1, pk))) : {SC.verify_p(hc, pk, m, sig, SC.lift_x(B.of_be(pk))) == SS.verify_p(one, hc, pk, m, sig, SS.lift_x(one, _)) : Bool}
      %Equal.sym(Maybe<&2, CV.SPoint>, SS.lift_x(one, FS.value(one, B.of_be(pk))), PE.mpv(one, SC.lift_x(B.of_be(pk))), Equal.sym(Maybe<&2, CV.SPoint>, PE.mpv(one, SC.lift_x(B.of_be(pk))), SS.lift_x(one, FS.value(one, B.of_be(pk))), lx(one, h1, B.of_be(pk), hl))) : {SC.verify_p(hc, pk, m, sig, SC.lift_x(B.of_be(pk))) == SS.verify_p(one, hc, pk, m, sig, _) : Bool}
      vp(one, h1, hc, pk, m, sig, hb, SC.lift_x(B.of_be(pk)), lx_r(one, h1, B.of_be(pk), hl))
    case True{} False{}:
      {==}
    case False{} _:
      {==}

def verify_hv(+one: Nat, +h1: {one == 1n : Nat}, +hc: List<&2, U32>, +pk: List<&2, U32>, +m: List<&2, U32>, +sig: List<&2, U32>) -> {SC.verify_h(hc, pk, m, sig) == SS.verify_h(one, hc, pk, m, sig) : Bool}:
  %Equal.sym(Bool, B.has_len(32n, pk), CV.length_is(32n, pk), BL.hl_is(32n, pk)) : {SC.verify_len(hc, pk, m, sig, Bool.and(_, B.has_len(64n, sig))) == SS.verify_len(one, hc, pk, m, sig, Bool.and(CV.length_is(32n, pk), CV.length_is(64n, sig))) : Bool}
  %Equal.sym(Bool, B.has_len(64n, sig), CV.length_is(64n, sig), BL.hl_is(64n, sig)) : {SC.verify_len(hc, pk, m, sig, Bool.and(CV.length_is(32n, pk), _)) == SS.verify_len(one, hc, pk, m, sig, Bool.and(CV.length_is(32n, pk), CV.length_is(64n, sig))) : Bool}
  vlen(one, h1, hc, pk, m, sig, CV.length_is(32n, pk), CV.length_is(64n, sig), BL.hl_is(32n, pk), BL.hl_is(64n, sig))

# BIP-340 verification
def verify_v(+one: Nat, +h1: {one == 1n : Nat}, +pk: List<&2, U32>, +m: List<&2, U32>, +sig: List<&2, U32>) -> {SC.verify(pk, m, sig) == SS.verify(one, pk, m, sig) : Bool}:
  %Equal.sym(List<&2, U32>, SC.tagh(pk, SS.tag_challenge()), SS.th(one, SS.tag_challenge()), tht(one, pk, SS.tag_challenge())) : {SC.verify_h(_, pk, m, sig) == SS.verify_h(one, SS.th(one, SS.tag_challenge()), pk, m, sig) : Bool}
  verify_hv(one, h1, SS.th(one, SS.tag_challenge()), pk, m, sig)

# ---- signing ----

def sok(+sig: List<&2, U32>, b: Bool) -> {SC.sign_ok(sig, b) == SS.sign_if(sig, b) : Maybe<&2, List<&2, U32>>}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

def sfin(+one: Nat, +h1: {one == 1n : Nat}, +hc: List<&2, U32>, +pb: List<&2, U32>, +m: List<&2, U32>, +sig: List<&2, U32>) -> {SC.sign_fin(hc, pb, m, sig) == SS.sign_fin(one, hc, pb, m, sig) : Maybe<&2, List<&2, U32>>}:
  %Equal.sym(Bool, SC.verify_h(hc, pb, m, sig), SS.verify_h(one, hc, pb, m, sig), verify_hv(one, h1, hc, pb, m, sig)) : {SC.sign_ok(sig, _) == SS.sign_if(sig, SS.verify_h(one, hc, pb, m, sig)) : Maybe<&2, List<&2, U32>>}
  sok(sig, SS.verify_h(one, hc, pb, m, sig))

def ax_l(+one: Nat, +x: List<&2, Nat>, +y: List<&2, Nat>, +ha: {PA.ared(one, P.Affine{x, y}) == True{} : Bool}) -> {FS.limbs16(one, 16n, x) == True{} : Bool}:
  SL.l16(one, x, Lg.and_left(PT.red(one, x), PT.red(one, y), ha))

def sk_v(+one: Nat, +h1: {one == 1n : Nat}, +hc: List<&2, U32>, +d: List<&2, Nat>, +hd: {FS.reduced(one, FS.order(one), d) == True{} : Bool}, +pb: List<&2, U32>, +m: List<&2, U32>, +k0: List<&2, Nat>, +hk0: {FS.reduced(one, FS.order(one), k0) == True{} : Bool}, a: P.Affine, +ha: {PA.ared(one, a) == True{} : Bool}) -> {SC.sign_k(hc, d, pb, m, k0, a) == SS.sign_r(one, hc, FS.value(one, d), pb, m, FS.value(one, k0), PA.av(one, a)) : Maybe<&2, List<&2, U32>>}:
  match a:
    case P.Affine{+rx, +ry}:
      +hrx = ax_l(one, rx, ry, ha)
      +hk = even_r(one, h1, ry, k0, hk0)
