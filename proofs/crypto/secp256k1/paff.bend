      %Equal.sym(Nat, Nat.mul(one, x), x, LV.mul_one_l(one, h1, x)) : {Nat.is_lt(Nat.add(_, C.shift(16n, FS.value(one, List.append(&2, Nat, t, [top])))), C.shift(16n, LV.pos(j, b))) == True{} : Bool}
