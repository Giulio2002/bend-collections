def wv0_e(+one: Nat, +h1: {one == 1n : Nat}, +x: R.FE, +hx: {SQ.sred(one, x) == True{} : Bool}, +acc: R.FE, +ha: {SQ.sred(one, acc) == True{} : Bool}, +e: Nat, +he: {LV.ev(R.to_list(acc)) == Nat.mod(Nat.pow(LV.ev(R.to_list(x)), e), 1n+K.np(one)) : Nat}, b2: Nat, +hb2: {Nat.is_lt(b2, 2n) == True{} : Bool}, b3: Nat, +hb3: {Nat.is_lt(b3, 2n) == True{} : Bool}, b4: Nat, +hb4: {Nat.is_lt(b4, 2n) == True{} : Bool}) -> {LV.ev(R.to_list(SE.wstep(SE.wdig(0n, b2, b3, b4), SE.table(x), SE.sq(SE.sq(SE.sq(SE.sq(acc))))))) == Nat.mod(Nat.pow(LV.ev(R.to_list(x)), BV.hv([0n, b2, b3, b4], one, e)), 1n+K.np(one)) : Nat}:
  match b2:
    case 0n:
      wv00_e(one, h1, x, hx, acc, ha, e, he, b3, hb3, b4, hb4)
    case 1n:
      wv01_e(one, h1, x, hx, acc, ha, e, he, b3, hb3, b4, hb4)
    case 2n+ +k:
      Empty.absurd({LV.ev(R.to_list(SE.wstep(SE.wdig(0n, 2n+k, b3, b4), SE.table(x), SE.sq(SE.sq(SE.sq(SE.sq(acc))))))) == Nat.mod(Nat.pow(LV.ev(R.to_list(x)), BV.hv([0n, 2n+k, b3, b4], one, e)), 1n+K.np(one)) : Nat}, N.lt_zero_absurd(k, hb2))

def wv0_r(+one: Nat, +h1: {one == 1n : Nat}, +x: R.FE, +hx: {SQ.sred(one, x) == True{} : Bool}, +acc: R.FE, +ha: {SQ.sred(one, acc) == True{} : Bool}, b2: Nat, +hb2: {Nat.is_lt(b2, 2n) == True{} : Bool}, b3: Nat, +hb3: {Nat.is_lt(b3, 2n) == True{} : Bool}, b4: Nat, +hb4: {Nat.is_lt(b4, 2n) == True{} : Bool}) -> {SQ.sred(one, SE.wstep(SE.wdig(0n, b2, b3, b4), SE.table(x), SE.sq(SE.sq(SE.sq(SE.sq(acc)))))) == True{} : Bool}:
  match b2:
    case 0n:
      wv00_r(one, h1, x, hx, acc, ha, b3, hb3, b4, hb4)
    case 1n:
      wv01_r(one, h1, x, hx, acc, ha, b3, hb3, b4, hb4)
    case 2n+ +k:
      Empty.absurd({SQ.sred(one, SE.wstep(SE.wdig(0n, 2n+k, b3, b4), SE.table(x), SE.sq(SE.sq(SE.sq(SE.sq(acc)))))) == True{} : Bool}, N.lt_zero_absurd(k, hb2))

def wv1_e(+one: Nat, +h1: {one == 1n : Nat}, +x: R.FE, +hx: {SQ.sred(one, x) == True{} : Bool}, +acc: R.FE, +ha: {SQ.sred(one, acc) == True{} : Bool}, +e: Nat, +he: {LV.ev(R.to_list(acc)) == Nat.mod(Nat.pow(LV.ev(R.to_list(x)), e), 1n+K.np(one)) : Nat}, b2: Nat, +hb2: {Nat.is_lt(b2, 2n) == True{} : Bool}, b3: Nat, +hb3: {Nat.is_lt(b3, 2n) == True{} : Bool}, b4: Nat, +hb4: {Nat.is_lt(b4, 2n) == True{} : Bool}) -> {LV.ev(R.to_list(SE.wstep(SE.wdig(1n, b2, b3, b4), SE.table(x), SE.sq(SE.sq(SE.sq(SE.sq(acc))))))) == Nat.mod(Nat.pow(LV.ev(R.to_list(x)), BV.hv([1n, b2, b3, b4], one, e)), 1n+K.np(one)) : Nat}:
  match b2:
    case 0n:
      wv10_e(one, h1, x, hx, acc, ha, e, he, b3, hb3, b4, hb4)
    case 1n:
      wv11_e(one, h1, x, hx, acc, ha, e, he, b3, hb3, b4, hb4)
    case 2n+ +k:
      Empty.absurd({LV.ev(R.to_list(SE.wstep(SE.wdig(1n, 2n+k, b3, b4), SE.table(x), SE.sq(SE.sq(SE.sq(SE.sq(acc))))))) == Nat.mod(Nat.pow(LV.ev(R.to_list(x)), BV.hv([1n, 2n+k, b3, b4], one, e)), 1n+K.np(one)) : Nat}, N.lt_zero_absurd(k, hb2))

def wv1_r(+one: Nat, +h1: {one == 1n : Nat}, +x: R.FE, +hx: {SQ.sred(one, x) == True{} : Bool}, +acc: R.FE, +ha: {SQ.sred(one, acc) == True{} : Bool}, b2: Nat, +hb2: {Nat.is_lt(b2, 2n) == True{} : Bool}, b3: Nat, +hb3: {Nat.is_lt(b3, 2n) == True{} : Bool}, b4: Nat, +hb4: {Nat.is_lt(b4, 2n) == True{} : Bool}) -> {SQ.sred(one, SE.wstep(SE.wdig(1n, b2, b3, b4), SE.table(x), SE.sq(SE.sq(SE.sq(SE.sq(acc)))))) == True{} : Bool}:
  match b2:
    case 0n:
      wv10_r(one, h1, x, hx, acc, ha, b3, hb3, b4, hb4)
    case 1n:
      wv11_r(one, h1, x, hx, acc, ha, b3, hb3, b4, hb4)
    case 2n+ +k:
      Empty.absurd({SQ.sred(one, SE.wstep(SE.wdig(1n, 2n+k, b3, b4), SE.table(x), SE.sq(SE.sq(SE.sq(SE.sq(acc)))))) == True{} : Bool}, N.lt_zero_absurd(k, hb2))

def wv_e(+one: Nat, +h1: {one == 1n : Nat}, +x: R.FE, +hx: {SQ.sred(one, x) == True{} : Bool}, +acc: R.FE, +ha: {SQ.sred(one, acc) == True{} : Bool}, +e: Nat, +he: {LV.ev(R.to_list(acc)) == Nat.mod(Nat.pow(LV.ev(R.to_list(x)), e), 1n+K.np(one)) : Nat}, b1: Nat, +hb1: {Nat.is_lt(b1, 2n) == True{} : Bool}, b2: Nat, +hb2: {Nat.is_lt(b2, 2n) == True{} : Bool}, b3: Nat, +hb3: {Nat.is_lt(b3, 2n) == True{} : Bool}, b4: Nat, +hb4: {Nat.is_lt(b4, 2n) == True{} : Bool}) -> {LV.ev(R.to_list(SE.wstep(SE.wdig(b1, b2, b3, b4), SE.table(x), SE.sq(SE.sq(SE.sq(SE.sq(acc))))))) == Nat.mod(Nat.pow(LV.ev(R.to_list(x)), BV.hv([b1, b2, b3, b4], one, e)), 1n+K.np(one)) : Nat}:
  match b1:
    case 0n:
      wv0_e(one, h1, x, hx, acc, ha, e, he, b2, hb2, b3, hb3, b4, hb4)
    case 1n:
      wv1_e(one, h1, x, hx, acc, ha, e, he, b2, hb2, b3, hb3, b4, hb4)
    case 2n+ +k:
      Empty.absurd({LV.ev(R.to_list(SE.wstep(SE.wdig(2n+k, b2, b3, b4), SE.table(x), SE.sq(SE.sq(SE.sq(SE.sq(acc))))))) == Nat.mod(Nat.pow(LV.ev(R.to_list(x)), BV.hv([2n+k, b2, b3, b4], one, e)), 1n+K.np(one)) : Nat}, N.lt_zero_absurd(k, hb1))

def wv_r(+one: Nat, +h1: {one == 1n : Nat}, +x: R.FE, +hx: {SQ.sred(one, x) == True{} : Bool}, +acc: R.FE, +ha: {SQ.sred(one, acc) == True{} : Bool}, b1: Nat, +hb1: {Nat.is_lt(b1, 2n) == True{} : Bool}, b2: Nat, +hb2: {Nat.is_lt(b2, 2n) == True{} : Bool}, b3: Nat, +hb3: {Nat.is_lt(b3, 2n) == True{} : Bool}, b4: Nat, +hb4: {Nat.is_lt(b4, 2n) == True{} : Bool}) -> {SQ.sred(one, SE.wstep(SE.wdig(b1, b2, b3, b4), SE.table(x), SE.sq(SE.sq(SE.sq(SE.sq(acc)))))) == True{} : Bool}:
  match b1:
    case 0n:
      wv0_r(one, h1, x, hx, acc, ha, b2, hb2, b3, hb3, b4, hb4)
    case 1n:
      wv1_r(one, h1, x, hx, acc, ha, b2, hb2, b3, hb3, b4, hb4)
    case 2n+ +k:
      Empty.absurd({SQ.sred(one, SE.wstep(SE.wdig(2n+k, b2, b3, b4), SE.table(x), SE.sq(SE.sq(SE.sq(SE.sq(acc)))))) == True{} : Bool}, N.lt_zero_absurd(k, hb1))

def wpw_r(+one: Nat, +h1: {one == 1n : Nat}, +x: R.FE, +hx: {SQ.sred(one, x) == True{} : Bool}, bs: List<&2, Nat>, +acc: R.FE, +ha: {SQ.sred(one, acc) == True{} : Bool}, +hb: {BV.all01(bs) == True{} : Bool}) -> {SQ.sred(one, SE.pw_go(x, SE.table(x), bs, acc)) == True{} : Bool}:
  match bs:
    case Nil{}:
      ha
    case +b1 <> Nil{}:
      pow_r(one, h1, x, hx, [b1], acc, ha, hb)
    case +b1 <> +b2 <> Nil{}:
      pow_r(one, h1, x, hx, [b1, b2], acc, ha, hb)
    case +b1 <> +b2 <> +b3 <> Nil{}:
      pow_r(one, h1, x, hx, [b1, b2, b3], acc, ha, hb)
    case +b1 <> +b2 <> +b3 <> +b4 <> +r:
      +c1 = Lg.and_right(Nat.is_lt(b1, 2n), BV.all01(b2 <> b3 <> b4 <> r), hb)
      +c2 = Lg.and_right(Nat.is_lt(b2, 2n), BV.all01(b3 <> b4 <> r), c1)
      +c3 = Lg.and_right(Nat.is_lt(b3, 2n), BV.all01(b4 <> r), c2)
      +hb1 = Lg.and_left(Nat.is_lt(b1, 2n), BV.all01(b2 <> b3 <> b4 <> r), hb)
      +hb2 = Lg.and_left(Nat.is_lt(b2, 2n), BV.all01(b3 <> b4 <> r), c1)
      +hb3 = Lg.and_left(Nat.is_lt(b3, 2n), BV.all01(b4 <> r), c2)
      +hb4 = Lg.and_left(Nat.is_lt(b4, 2n), BV.all01(r), c3)
      +hr = Lg.and_right(Nat.is_lt(b4, 2n), BV.all01(r), c3)
      +ha2 = wv_r(one, h1, x, hx, acc, ha, b1, hb1, b2, hb2, b3, hb3, b4, hb4)
      wpw_r(one, h1, x, hx, r, SE.wstep(SE.wdig(b1, b2, b3, b4), SE.table(x), SE.sq(SE.sq(SE.sq(SE.sq(acc))))), ha2, hr)

def wpw_e(+one: Nat, +h1: {one == 1n : Nat}, +x: R.FE, +hx: {SQ.sred(one, x) == True{} : Bool}, bs: List<&2, Nat>, +acc: R.FE, +ha: {SQ.sred(one, acc) == True{} : Bool}, +e: Nat, +he: {LV.ev(R.to_list(acc)) == Nat.mod(Nat.pow(LV.ev(R.to_list(x)), e), 1n+K.np(one)) : Nat}, +hb: {BV.all01(bs) == True{} : Bool}) -> {LV.ev(R.to_list(SE.pw_go(x, SE.table(x), bs, acc))) == Nat.mod(Nat.pow(LV.ev(R.to_list(x)), BV.hv(bs, one, e)), 1n+K.np(one)) : Nat}:
  match bs:
    case Nil{}:
      he
    case +b1 <> Nil{}:
      pow_e(one, h1, x, hx, [b1], acc, ha, e, he, hb)
    case +b1 <> +b2 <> Nil{}:
      pow_e(one, h1, x, hx, [b1, b2], acc, ha, e, he, hb)
    case +b1 <> +b2 <> +b3 <> Nil{}:
      pow_e(one, h1, x, hx, [b1, b2, b3], acc, ha, e, he, hb)
    case +b1 <> +b2 <> +b3 <> +b4 <> +r:
      +c1 = Lg.and_right(Nat.is_lt(b1, 2n), BV.all01(b2 <> b3 <> b4 <> r), hb)
      +c2 = Lg.and_right(Nat.is_lt(b2, 2n), BV.all01(b3 <> b4 <> r), c1)
      +c3 = Lg.and_right(Nat.is_lt(b3, 2n), BV.all01(b4 <> r), c2)
      +hb1 = Lg.and_left(Nat.is_lt(b1, 2n), BV.all01(b2 <> b3 <> b4 <> r), hb)
      +hb2 = Lg.and_left(Nat.is_lt(b2, 2n), BV.all01(b3 <> b4 <> r), c1)
      +hb3 = Lg.and_left(Nat.is_lt(b3, 2n), BV.all01(b4 <> r), c2)
      +hb4 = Lg.and_left(Nat.is_lt(b4, 2n), BV.all01(r), c3)
      +hr = Lg.and_right(Nat.is_lt(b4, 2n), BV.all01(r), c3)
      +st = SE.wstep(SE.wdig(b1, b2, b3, b4), SE.table(x), SE.sq(SE.sq(SE.sq(SE.sq(acc)))))
      +rs = wv_r(one, h1, x, hx, acc, ha, b1, hb1, b2, hb2, b3, hb3, b4, hb4)
      +es = wv_e(one, h1, x, hx, acc, ha, e, he, b1, hb1, b2, hb2, b3, hb3, b4, hb4)
      wpw_e(one, h1, x, hx, r, st, rs, BV.hv([b1, b2, b3, b4], one, e), es, hr)

# pw looks at the bits, then at x (the table is never formed on unknown bits)
def pwx_is(x: R.FE, +bs: List<&2, Nat>, +acc: R.FE) -> {SE.pwx(x, bs, acc) == SE.pw_go2(x, bs, acc) : R.FE}:
  match x:
    case R.FE{a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15}:
      {==}

def pw_is(+x: R.FE, bs: List<&2, Nat>, +acc: R.FE) -> {SE.pw(x, bs, acc) == SE.pw_go2(x, bs, acc) : R.FE}:
  match bs:
    case Nil{}:
      {==}
    case +b <> +t:
      pwx_is(x, b <> t, acc)

def wpw2_e(+one: Nat, +h1: {one == 1n : Nat}, +x: R.FE, +hx: {SQ.sred(one, x) == True{} : Bool}, bs: List<&2, Nat>, +acc: R.FE, +ha: {SQ.sred(one, acc) == True{} : Bool}, +e: Nat, +he: {LV.ev(R.to_list(acc)) == Nat.mod(Nat.pow(LV.ev(R.to_list(x)), e), 1n+K.np(one)) : Nat}, +hb: {BV.all01(bs) == True{} : Bool}) -> {LV.ev(R.to_list(SE.pw_go2(x, bs, acc))) == Nat.mod(Nat.pow(LV.ev(R.to_list(x)), BV.hv(bs, one, e)), 1n+K.np(one)) : Nat}:
  match bs:
    case Nil{}:
      he
    case +b <> +t:
      wpw_e(one, h1, x, hx, b <> t, acc, ha, e, he, hb)

def wpw2_r(+one: Nat, +h1: {one == 1n : Nat}, +x: R.FE, +hx: {SQ.sred(one, x) == True{} : Bool}, bs: List<&2, Nat>, +acc: R.FE, +ha: {SQ.sred(one, acc) == True{} : Bool}, +hb: {BV.all01(bs) == True{} : Bool}) -> {SQ.sred(one, SE.pw_go2(x, bs, acc)) == True{} : Bool}:
  match bs:
    case Nil{}:
      ha
    case +b <> +t:
      wpw_r(one, h1, x, hx, b <> t, acc, ha, hb)

def pw_ev(+one: Nat, +h1: {one == 1n : Nat}, +x: R.FE, +hx: {SQ.sred(one, x) == True{} : Bool}, +bs: List<&2, Nat>, +acc: R.FE, +ha: {SQ.sred(one, acc) == True{} : Bool}, +e: Nat, +he: {LV.ev(R.to_list(acc)) == Nat.mod(Nat.pow(LV.ev(R.to_list(x)), e), 1n+K.np(one)) : Nat}, +hb: {BV.all01(bs) == True{} : Bool}) -> {LV.ev(R.to_list(SE.pw(x, bs, acc))) == Nat.mod(Nat.pow(LV.ev(R.to_list(x)), BV.hv(bs, one, e)), 1n+K.np(one)) : Nat}:
  %Equal.sym(R.FE, SE.pw(x, bs, acc), SE.pw_go2(x, bs, acc), pw_is(x, bs, acc)) : {LV.ev(R.to_list(_)) == Nat.mod(Nat.pow(LV.ev(R.to_list(x)), BV.hv(bs, one, e)), 1n+K.np(one)) : Nat}
  wpw2_e(one, h1, x, hx, bs, acc, ha, e, he, hb)

def pw_rv(+one: Nat, +h1: {one == 1n : Nat}, +x: R.FE, +hx: {SQ.sred(one, x) == True{} : Bool}, +bs: List<&2, Nat>, +acc: R.FE, +ha: {SQ.sred(one, acc) == True{} : Bool}, +hb: {BV.all01(bs) == True{} : Bool}) -> {SQ.sred(one, SE.pw(x, bs, acc)) == True{} : Bool}:
  %Equal.sym(R.FE, SE.pw(x, bs, acc), SE.pw_go2(x, bs, acc), pw_is(x, bs, acc)) : {SQ.sred(one, _) == True{} : Bool}
  wpw2_r(one, h1, x, hx, bs, acc, ha, hb)
# ---- END windowed ----

def xn() -> List<&2, Nat>:
  [48832n, 12233n, 41331n, 16429n, 24516n, 20663n, 8985n, 17745n, 1n, 0n, 0n, 0n, 0n, 0n, 0n, 0n]

def zeros7(+one: Nat) -> {FS.digits(one, [0n, 0n, 0n, 0n, 0n, 0n, 0n]) == 0n : Nat}:
  %Equal.sym(Nat, Nat.mul(one, 0n), 0n, NA.mul_zero(one)) : {Nat.add(_, C.shift(16n, Nat.add(Nat.mul(one, 0n), C.shift(16n, Nat.add(Nat.mul(one, 0n), C.shift(16n, Nat.add(Nat.mul(one, 0n), C.shift(16n, Nat.add(Nat.mul(one, 0n), C.shift(16n, Nat.add(Nat.mul(one, 0n), C.shift(16n, Nat.add(Nat.mul(one, 0n), C.shift(16n, 0n)))))))))))))) == 0n : Nat}
  %Equal.sym(Nat, Nat.mul(one, 0n), 0n, NA.mul_zero(one)) : {Nat.add(0n, C.shift(16n, Nat.add(_, C.shift(16n, Nat.add(Nat.mul(one, 0n), C.shift(16n, Nat.add(Nat.mul(one, 0n), C.shift(16n, Nat.add(Nat.mul(one, 0n), C.shift(16n, Nat.add(Nat.mul(one, 0n), C.shift(16n, Nat.add(Nat.mul(one, 0n), C.shift(16n, 0n)))))))))))))) == 0n : Nat}
  %Equal.sym(Nat, Nat.mul(one, 0n), 0n, NA.mul_zero(one)) : {Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(_, C.shift(16n, Nat.add(Nat.mul(one, 0n), C.shift(16n, Nat.add(Nat.mul(one, 0n), C.shift(16n, Nat.add(Nat.mul(one, 0n), C.shift(16n, Nat.add(Nat.mul(one, 0n), C.shift(16n, 0n)))))))))))))) == 0n : Nat}
  %Equal.sym(Nat, Nat.mul(one, 0n), 0n, NA.mul_zero(one)) : {Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(_, C.shift(16n, Nat.add(Nat.mul(one, 0n), C.shift(16n, Nat.add(Nat.mul(one, 0n), C.shift(16n, Nat.add(Nat.mul(one, 0n), C.shift(16n, 0n)))))))))))))) == 0n : Nat}
  %Equal.sym(Nat, Nat.mul(one, 0n), 0n, NA.mul_zero(one)) : {Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(_, C.shift(16n, Nat.add(Nat.mul(one, 0n), C.shift(16n, Nat.add(Nat.mul(one, 0n), C.shift(16n, 0n)))))))))))))) == 0n : Nat}
  %Equal.sym(Nat, Nat.mul(one, 0n), 0n, NA.mul_zero(one)) : {Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(_, C.shift(16n, Nat.add(Nat.mul(one, 0n), C.shift(16n, 0n)))))))))))))) == 0n : Nat}
  %Equal.sym(Nat, Nat.mul(one, 0n), 0n, NA.mul_zero(one)) : {Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(_, C.shift(16n, 0n)))))))))))))) == 0n : Nat}
  %Equal.sym(Nat, C.shift(16n, 0n), 0n, WW.shift_zero(16n)) : {Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(0n, _))))))))))))) == 0n : Nat}
  %Equal.sym(Nat, Nat.add(0n, 0n), 0n, {==}) : {Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, _)))))))))))) == 0n : Nat}
  %Equal.sym(Nat, C.shift(16n, 0n), 0n, WW.shift_zero(16n)) : {Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(0n, _))))))))))) == 0n : Nat}
  %Equal.sym(Nat, Nat.add(0n, 0n), 0n, {==}) : {Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, _)))))))))) == 0n : Nat}
  %Equal.sym(Nat, C.shift(16n, 0n), 0n, WW.shift_zero(16n)) : {Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(0n, _))))))))) == 0n : Nat}
  %Equal.sym(Nat, Nat.add(0n, 0n), 0n, {==}) : {Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, Nat.add(0n, C.shift(16n, _)))))))) == 0n : Nat}
