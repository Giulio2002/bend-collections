   0n, 1n, 0n, 0n, 0n, 1n, 0n, 1n, 0n, 1n, 0n, 1n, 0n, 0n, 0n, 1n, 0n, 0n, 1n, 0n, 0n, 0n, 1n, 1n, 0n, 0n, 0n, 1n, 1n, 0n, 0n, 1n,
