# Primes and Euclid's lemma, for the elliptic-curve group laws (any modulus).
#
# Prime(n) is the repo's trial-division predicate SN.prime(n) == True (2 <= n
# and no d in [2, n) divides n; Lean 4 Mathlib Nat.Prime). It is a Bool
# equation, hence Data: a hypothesis hp : Prime(p) may be used any number of
# times (a universally quantified function hypothesis could be used once).
# The usual reading is prime_div: every divisor d > 1 of n (n == k d) is n.
# Small literal primes: small_prime (the repo's sqrt-bounded trial division
# NB.is_prime, computed by the checker).
#
# Divisibility is stated as Nat.mod(x, n) == 0n; the modulus of a prime is
# written 2n+pp (every prime is at least 2), the modulus of the arithmetic
# lemmas 1n+bp.
def Prime(+n: Nat) -> Data:
  {SN.prime(n) == True{} : Bool}


# ---- divisibility helpers ----

# k n mod n == 0
def mod_mul0(+bp: Nat, +k: Nat) -> {Nat.mod(Nat.mul(k, 1n+bp), 1n+bp) == 0n : Nat}:
  %Equal.sym(Nat, Nat.mul(k, 1n+bp), Nat.add(Nat.mul(k, 1n+bp), 0n), Equal.sym(Nat, Nat.add(Nat.mul(k, 1n+bp), 0n), Nat.mul(k, 1n+bp), NA.add_zero(Nat.mul(k, 1n+bp)))) : {Nat.mod(_, 1n+bp) == 0n : Nat}
  %Equal.sym(Nat, Nat.mod(Nat.add(Nat.mul(k, 1n+bp), 0n), 1n+bp), Nat.mod(0n, 1n+bp), NR.absorb(bp, k, 0n)) : {_ == 0n : Nat}
  {==}


# x == k n gives x mod n == 0
def eq_mod0(+bp: Nat, +x: Nat, +k: Nat, +h: {x == Nat.mul(k, 1n+bp) : Nat}) -> {Nat.mod(x, 1n+bp) == 0n : Nat}:
  %Equal.sym(Nat, x, Nat.mul(k, 1n+bp), h) : {Nat.mod(_, 1n+bp) == 0n : Nat}
  %Equal.sym(Nat, Nat.mod(Nat.mul(k, 1n+bp), 1n+bp), 0n, mod_mul0(bp, k)) : {_ == 0n : Nat}
  {==}


# 0 < n == k d gives d <= n
def dvd_le(+n: Nat, k: Nat, +d: Nat, +e: {n == Nat.mul(k, d) : Nat}, +h: {Nat.is_lt(0n, n) == True{} : Bool}) -> {Nat.is_le(d, n) == True{} : Bool}:
  match k:
    case 0n:
      Empty.absurd({Nat.is_le(d, n) == True{} : Bool}, Lg.false_true(Equal.trans(Bool, False{}, Nat.is_lt(0n, n), True{}, Equal.cong(Nat, Bool, z => Nat.is_lt(0n, z), 0n, n, Equal.sym(Nat, n, 0n, e)), h)))
    case 1n+ +kp:
      %Equal.sym(Nat, n, Nat.mul(1n+kp, d), e) : {Nat.is_le(d, _) == True{} : Bool}
      N.le_add_right(d, Nat.mul(kp, d))


def pd_lt(+pp: Nat, +hp: Prime(2n+pp), +d: Nat, +dp: Nat, +hd: {d == 2n+dp : Nat}, +k: Nat, +e: {2n+pp == Nat.mul(k, d) : Nat}, +hlt: {Nat.is_lt(d, 2n+pp) == True{} : Bool}) -> Empty:
  +m0 = eq_mod0(1n+dp, 2n+pp, k, Equal.trans(Nat, 2n+pp, Nat.mul(k, d), Nat.mul(k, 2n+dp), e, Equal.cong(Nat, Nat, z => Nat.mul(k, z), d, 2n+dp, hd)))
  +nd = PR.nodiv_at(pp, 2n+pp, 2n, 2n+dp, hp, N.le_add_right(2n, dp), Equal.trans(Bool, Nat.is_lt(2n+dp, Nat.add(2n, pp)), Nat.is_lt(d, 2n+pp), True{}, Equal.cong(Nat, Bool, z => Nat.is_lt(z, 2n+pp), 2n+dp, d, Equal.sym(Nat, d, 2n+dp, hd)), hlt))
  Lg.true_false(Equal.trans(Bool, True{}, Nat.is_eq(Nat.mod(2n+pp, 2n+dp), 0n), False{}, Equal.cong(Nat, Bool, z => Nat.is_eq(z, 0n), 0n, Nat.mod(2n+pp, 2n+dp), Equal.sym(Nat, Nat.mod(2n+pp, 2n+dp), 0n, m0)), nd))


def pd_t(+pp: Nat, +hp: Prime(2n+pp), d: Nat, +k: Nat, +e: {2n+pp == Nat.mul(k, d) : Nat}, +l: {Nat.is_lt(1n, d) == True{} : Bool}, +hc: {Nat.is_lt(d, 2n+pp) == True{} : Bool}) -> {d == 2n+pp : Nat}:
  match d:
    case 0n:
      Empty.absurd({0n == 2n+pp : Nat}, Lg.false_true(l))
    case 1n:
      Empty.absurd({1n == 2n+pp : Nat}, Lg.false_true(l))
    case 2n+ +dp:
      Empty.absurd({2n+dp == 2n+pp : Nat}, pd_lt(pp, hp, 2n+dp, dp, {==}, k, e, hc))


def pd_case(+pp: Nat, +hp: Prime(2n+pp), +d: Nat, +k: Nat, +e: {2n+pp == Nat.mul(k, d) : Nat}, +l: {Nat.is_lt(1n, d) == True{} : Bool}, c: Bool, +hc: {Nat.is_lt(d, 2n+pp) == c : Bool}) -> {d == 2n+pp : Nat}:
  match c:
    case True{}:
      pd_t(pp, hp, d, k, e, l, hc)
    case False{}:
      N.le_antisym(d, 2n+pp, dvd_le(2n+pp, k, d, e, {==}), N.not_lt_le(d, 2n+pp, hc))


# every divisor d > 1 of a prime is the prime   (Mathlib Nat.Prime.eq_one_or_self_of_dvd)
def prime_div(n: Nat, +hp: Prime(n), +d: Nat, +k: Nat, +e: {n == Nat.mul(k, d) : Nat}, +l: {Nat.is_lt(1n, d) == True{} : Bool}) -> {d == n : Nat}:
  match n:
    case 0n:
      Empty.absurd({d == 0n : Nat}, Lg.false_true(hp))
    case 1n:
      Empty.absurd({d == 1n : Nat}, Lg.false_true(hp))
    case 2n+ +pp:
      pd_case(pp, hp, d, k, e, l, Nat.is_lt(d, 2n+pp), {==})


# a small literal prime, by the checker's trial division up to sqrt(n)
def small_prime(+n: Nat, +h: {NB.is_prime(n) == True{} : Bool}) -> Prime(n):
  Equal.trans(Bool, SN.prime(n), NB.is_prime(n), True{}, Equal.sym(Bool, NB.is_prime(n), SN.prime(n), PR.is_prime_value(n)), h)
