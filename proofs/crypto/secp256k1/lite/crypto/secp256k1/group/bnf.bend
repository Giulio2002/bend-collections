def bsq_v(a: B.Bn) -> {B.bval(bsq(a)) == Nat.mul(B.bval(a), B.bval(a)) : Nat}:
  match a:
    case B.BZ{}:
      {==}
    case B.B0{+t}:
      %Equal.sym(Nat, B.bval(bsq(t)), Nat.mul(B.bval(t), B.bval(t)), bsq_v(t)) : {Nat.add(Nat.add(_, B.bval(bsq(t))), Nat.add(B.bval(bsq(t)), B.bval(bsq(t)))) == Nat.mul(Nat.add(B.bval(t), B.bval(t)), Nat.add(B.bval(t), B.bval(t))) : Nat}
      %Equal.sym(Nat, B.bval(bsq(t)), Nat.mul(B.bval(t), B.bval(t)), bsq_v(t)) : {Nat.add(Nat.add(Nat.mul(B.bval(t), B.bval(t)), _), Nat.add(B.bval(bsq(t)), B.bval(bsq(t)))) == Nat.mul(Nat.add(B.bval(t), B.bval(t)), Nat.add(B.bval(t), B.bval(t))) : Nat}
      %Equal.sym(Nat, B.bval(bsq(t)), Nat.mul(B.bval(t), B.bval(t)), bsq_v(t)) : {Nat.add(Nat.add(Nat.mul(B.bval(t), B.bval(t)), Nat.mul(B.bval(t), B.bval(t))), Nat.add(_, B.bval(bsq(t)))) == Nat.mul(Nat.add(B.bval(t), B.bval(t)), Nat.add(B.bval(t), B.bval(t))) : Nat}
      %Equal.sym(Nat, B.bval(bsq(t)), Nat.mul(B.bval(t), B.bval(t)), bsq_v(t)) : {Nat.add(Nat.add(Nat.mul(B.bval(t), B.bval(t)), Nat.mul(B.bval(t), B.bval(t))), Nat.add(Nat.mul(B.bval(t), B.bval(t)), _)) == Nat.mul(Nat.add(B.bval(t), B.bval(t)), Nat.add(B.bval(t), B.bval(t))) : Nat}
      q0_s(B.bval(t))
    case B.B1{+t}:
      %Equal.sym(Nat, B.bval(B.badd(t, bsq(t))), Nat.add(B.bval(t), B.bval(bsq(t))), B.badd_v(t, bsq(t))) : {1n+Nat.add(Nat.add(_, B.bval(B.badd(t, bsq(t)))), Nat.add(B.bval(B.badd(t, bsq(t))), B.bval(B.badd(t, bsq(t))))) == Nat.mul(1n+Nat.add(B.bval(t), B.bval(t)), 1n+Nat.add(B.bval(t), B.bval(t))) : Nat}
      %Equal.sym(Nat, B.bval(B.badd(t, bsq(t))), Nat.add(B.bval(t), B.bval(bsq(t))), B.badd_v(t, bsq(t))) : {1n+Nat.add(Nat.add(Nat.add(B.bval(t), B.bval(bsq(t))), _), Nat.add(B.bval(B.badd(t, bsq(t))), B.bval(B.badd(t, bsq(t))))) == Nat.mul(1n+Nat.add(B.bval(t), B.bval(t)), 1n+Nat.add(B.bval(t), B.bval(t))) : Nat}
      %Equal.sym(Nat, B.bval(B.badd(t, bsq(t))), Nat.add(B.bval(t), B.bval(bsq(t))), B.badd_v(t, bsq(t))) : {1n+Nat.add(Nat.add(Nat.add(B.bval(t), B.bval(bsq(t))), Nat.add(B.bval(t), B.bval(bsq(t)))), Nat.add(_, B.bval(B.badd(t, bsq(t))))) == Nat.mul(1n+Nat.add(B.bval(t), B.bval(t)), 1n+Nat.add(B.bval(t), B.bval(t))) : Nat}
      %Equal.sym(Nat, B.bval(B.badd(t, bsq(t))), Nat.add(B.bval(t), B.bval(bsq(t))), B.badd_v(t, bsq(t))) : {1n+Nat.add(Nat.add(Nat.add(B.bval(t), B.bval(bsq(t))), Nat.add(B.bval(t), B.bval(bsq(t)))), Nat.add(Nat.add(B.bval(t), B.bval(bsq(t))), _)) == Nat.mul(1n+Nat.add(B.bval(t), B.bval(t)), 1n+Nat.add(B.bval(t), B.bval(t))) : Nat}
      %Equal.sym(Nat, B.bval(bsq(t)), Nat.mul(B.bval(t), B.bval(t)), bsq_v(t)) : {1n+Nat.add(Nat.add(Nat.add(B.bval(t), _), Nat.add(B.bval(t), B.bval(bsq(t)))), Nat.add(Nat.add(B.bval(t), B.bval(bsq(t))), Nat.add(B.bval(t), B.bval(bsq(t))))) == Nat.mul(1n+Nat.add(B.bval(t), B.bval(t)), 1n+Nat.add(B.bval(t), B.bval(t))) : Nat}
      %Equal.sym(Nat, B.bval(bsq(t)), Nat.mul(B.bval(t), B.bval(t)), bsq_v(t)) : {1n+Nat.add(Nat.add(Nat.add(B.bval(t), Nat.mul(B.bval(t), B.bval(t))), Nat.add(B.bval(t), _)), Nat.add(Nat.add(B.bval(t), B.bval(bsq(t))), Nat.add(B.bval(t), B.bval(bsq(t))))) == Nat.mul(1n+Nat.add(B.bval(t), B.bval(t)), 1n+Nat.add(B.bval(t), B.bval(t))) : Nat}
      %Equal.sym(Nat, B.bval(bsq(t)), Nat.mul(B.bval(t), B.bval(t)), bsq_v(t)) : {1n+Nat.add(Nat.add(Nat.add(B.bval(t), Nat.mul(B.bval(t), B.bval(t))), Nat.add(B.bval(t), Nat.mul(B.bval(t), B.bval(t)))), Nat.add(Nat.add(B.bval(t), _), Nat.add(B.bval(t), B.bval(bsq(t))))) == Nat.mul(1n+Nat.add(B.bval(t), B.bval(t)), 1n+Nat.add(B.bval(t), B.bval(t))) : Nat}
      %Equal.sym(Nat, B.bval(bsq(t)), Nat.mul(B.bval(t), B.bval(t)), bsq_v(t)) : {1n+Nat.add(Nat.add(Nat.add(B.bval(t), Nat.mul(B.bval(t), B.bval(t))), Nat.add(B.bval(t), Nat.mul(B.bval(t), B.bval(t)))), Nat.add(Nat.add(B.bval(t), Nat.mul(B.bval(t), B.bval(t))), Nat.add(B.bval(t), _))) == Nat.mul(1n+Nat.add(B.bval(t), B.bval(t)), 1n+Nat.add(B.bval(t), B.bval(t))) : Nat}
      q1_s(B.bval(t))


def s0_s(+v: Nat) -> {v == Nat.add(0n, Nat.mul(v, 1n)) : Nat}:
  %Equal.sym(Nat, Nat.mul(v, 1n), v, NA.mul_one(v)) : {v == Nat.add(0n, _) : Nat}
  %Equal.sym(Nat, Nat.add(0n, v), v, SR.zero_add(v)) : {v == _ : Nat}
  {==}


def sz_s(+k: Nat) -> {0n == Nat.add(0n, Nat.mul(0n, k)) : Nat}:
  %Equal.sym(Nat, Nat.mul(0n, k), 0n, SR.zero_mul(k)) : {0n == Nat.add(0n, _) : Nat}
  %Equal.sym(Nat, Nat.add(0n, 0n), 0n, {==}) : {0n == _ : Nat}
  {==}


def s2_s(+l: Nat, +h: Nat, +k: Nat) -> {Nat.add(Nat.add(l, Nat.mul(h, k)), Nat.add(l, Nat.mul(h, k))) == Nat.add(Nat.add(l, l), Nat.mul(h, Nat.add(k, k))) : Nat}:
  %Equal.sym(Nat, Nat.add(l, Nat.mul(h, k)), Nat.add(Nat.mul(h, k), l), NA.add_comm(l, Nat.mul(h, k))) : {Nat.add(_, Nat.add(l, Nat.mul(h, k))) == Nat.add(Nat.add(l, l), Nat.mul(h, Nat.add(k, k))) : Nat}
  %Equal.sym(Nat, Nat.add(l, Nat.mul(h, k)), Nat.add(Nat.mul(h, k), l), NA.add_comm(l, Nat.mul(h, k))) : {Nat.add(Nat.add(Nat.mul(h, k), l), _) == Nat.add(Nat.add(l, l), Nat.mul(h, Nat.add(k, k))) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.add(Nat.mul(h, k), l), Nat.add(Nat.mul(h, k), l)), Nat.add(Nat.mul(h, k), Nat.add(l, Nat.add(Nat.mul(h, k), l))), NA.add_assoc(Nat.mul(h, k), l, Nat.add(Nat.mul(h, k), l))) : {_ == Nat.add(Nat.add(l, l), Nat.mul(h, Nat.add(k, k))) : Nat}
  %Equal.sym(Nat, Nat.add(l, Nat.add(Nat.mul(h, k), l)), Nat.add(Nat.mul(h, k), Nat.add(l, l)), NA.add_swap(l, Nat.mul(h, k), l)) : {Nat.add(Nat.mul(h, k), _) == Nat.add(Nat.add(l, l), Nat.mul(h, Nat.add(k, k))) : Nat}
  %Equal.sym(Nat, Nat.mul(h, Nat.add(k, k)), Nat.add(Nat.mul(h, k), Nat.mul(h, k)), NA.mul_add_left(h, k, k)) : {Nat.add(Nat.mul(h, k), Nat.add(Nat.mul(h, k), Nat.add(l, l))) == Nat.add(Nat.add(l, l), _) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.add(l, l), Nat.add(Nat.mul(h, k), Nat.mul(h, k))), Nat.add(l, Nat.add(l, Nat.add(Nat.mul(h, k), Nat.mul(h, k)))), NA.add_assoc(l, l, Nat.add(Nat.mul(h, k), Nat.mul(h, k)))) : {Nat.add(Nat.mul(h, k), Nat.add(Nat.mul(h, k), Nat.add(l, l))) == _ : Nat}
  %Equal.sym(Nat, Nat.add(l, Nat.add(Nat.mul(h, k), Nat.mul(h, k))), Nat.add(Nat.mul(h, k), Nat.add(l, Nat.mul(h, k))), NA.add_swap(l, Nat.mul(h, k), Nat.mul(h, k))) : {Nat.add(Nat.mul(h, k), Nat.add(Nat.mul(h, k), Nat.add(l, l))) == Nat.add(l, _) : Nat}
  %Equal.sym(Nat, Nat.add(l, Nat.mul(h, k)), Nat.add(Nat.mul(h, k), l), NA.add_comm(l, Nat.mul(h, k))) : {Nat.add(Nat.mul(h, k), Nat.add(Nat.mul(h, k), Nat.add(l, l))) == Nat.add(l, Nat.add(Nat.mul(h, k), _)) : Nat}
  %Equal.sym(Nat, Nat.add(l, Nat.add(Nat.mul(h, k), Nat.add(Nat.mul(h, k), l))), Nat.add(Nat.mul(h, k), Nat.add(l, Nat.add(Nat.mul(h, k), l))), NA.add_swap(l, Nat.mul(h, k), Nat.add(Nat.mul(h, k), l))) : {Nat.add(Nat.mul(h, k), Nat.add(Nat.mul(h, k), Nat.add(l, l))) == _ : Nat}
  %Equal.sym(Nat, Nat.add(l, Nat.add(Nat.mul(h, k), l)), Nat.add(Nat.mul(h, k), Nat.add(l, l)), NA.add_swap(l, Nat.mul(h, k), l)) : {Nat.add(Nat.mul(h, k), Nat.add(Nat.mul(h, k), Nat.add(l, l))) == Nat.add(Nat.mul(h, k), _) : Nat}
  {==}


def s3_s(+l: Nat, +h: Nat, +k: Nat) -> {1n+Nat.add(Nat.add(l, Nat.mul(h, k)), Nat.add(l, Nat.mul(h, k))) == Nat.add(1n+Nat.add(l, l), Nat.mul(h, Nat.add(k, k))) : Nat}:
  %Equal.sym(Nat, Nat.add(l, Nat.mul(h, k)), Nat.add(Nat.mul(h, k), l), NA.add_comm(l, Nat.mul(h, k))) : {1n+Nat.add(_, Nat.add(l, Nat.mul(h, k))) == Nat.add(1n+Nat.add(l, l), Nat.mul(h, Nat.add(k, k))) : Nat}
  %Equal.sym(Nat, Nat.add(l, Nat.mul(h, k)), Nat.add(Nat.mul(h, k), l), NA.add_comm(l, Nat.mul(h, k))) : {1n+Nat.add(Nat.add(Nat.mul(h, k), l), _) == Nat.add(1n+Nat.add(l, l), Nat.mul(h, Nat.add(k, k))) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.add(Nat.mul(h, k), l), Nat.add(Nat.mul(h, k), l)), Nat.add(Nat.mul(h, k), Nat.add(l, Nat.add(Nat.mul(h, k), l))), NA.add_assoc(Nat.mul(h, k), l, Nat.add(Nat.mul(h, k), l))) : {1n+_ == Nat.add(1n+Nat.add(l, l), Nat.mul(h, Nat.add(k, k))) : Nat}
  %Equal.sym(Nat, Nat.add(l, Nat.add(Nat.mul(h, k), l)), Nat.add(Nat.mul(h, k), Nat.add(l, l)), NA.add_swap(l, Nat.mul(h, k), l)) : {1n+Nat.add(Nat.mul(h, k), _) == Nat.add(1n+Nat.add(l, l), Nat.mul(h, Nat.add(k, k))) : Nat}
  %Equal.sym(Nat, 1n+Nat.add(Nat.mul(h, k), Nat.add(Nat.mul(h, k), Nat.add(l, l))), Nat.add(Nat.add(Nat.mul(h, k), Nat.add(Nat.mul(h, k), Nat.add(l, l))), 1n), SR.succ_add(1n, Nat.add(Nat.mul(h, k), Nat.add(Nat.mul(h, k), Nat.add(l, l))))) : {_ == Nat.add(1n+Nat.add(l, l), Nat.mul(h, Nat.add(k, k))) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.add(Nat.mul(h, k), Nat.add(Nat.mul(h, k), Nat.add(l, l))), 1n), Nat.add(Nat.mul(h, k), Nat.add(Nat.add(Nat.mul(h, k), Nat.add(l, l)), 1n)), NA.add_assoc(Nat.mul(h, k), Nat.add(Nat.mul(h, k), Nat.add(l, l)), 1n)) : {_ == Nat.add(1n+Nat.add(l, l), Nat.mul(h, Nat.add(k, k))) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.add(Nat.mul(h, k), Nat.add(l, l)), 1n), Nat.add(Nat.mul(h, k), Nat.add(Nat.add(l, l), 1n)), NA.add_assoc(Nat.mul(h, k), Nat.add(l, l), 1n)) : {Nat.add(Nat.mul(h, k), _) == Nat.add(1n+Nat.add(l, l), Nat.mul(h, Nat.add(k, k))) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.add(l, l), 1n), Nat.add(l, Nat.add(l, 1n)), NA.add_assoc(l, l, 1n)) : {Nat.add(Nat.mul(h, k), Nat.add(Nat.mul(h, k), _)) == Nat.add(1n+Nat.add(l, l), Nat.mul(h, Nat.add(k, k))) : Nat}
  %Equal.sym(Nat, 1n+Nat.add(l, l), Nat.add(Nat.add(l, l), 1n), SR.succ_add(1n, Nat.add(l, l))) : {Nat.add(Nat.mul(h, k), Nat.add(Nat.mul(h, k), Nat.add(l, Nat.add(l, 1n)))) == Nat.add(_, Nat.mul(h, Nat.add(k, k))) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.add(l, l), 1n), Nat.add(l, Nat.add(l, 1n)), NA.add_assoc(l, l, 1n)) : {Nat.add(Nat.mul(h, k), Nat.add(Nat.mul(h, k), Nat.add(l, Nat.add(l, 1n)))) == Nat.add(_, Nat.mul(h, Nat.add(k, k))) : Nat}
  %Equal.sym(Nat, Nat.mul(h, Nat.add(k, k)), Nat.add(Nat.mul(h, k), Nat.mul(h, k)), NA.mul_add_left(h, k, k)) : {Nat.add(Nat.mul(h, k), Nat.add(Nat.mul(h, k), Nat.add(l, Nat.add(l, 1n)))) == Nat.add(Nat.add(l, Nat.add(l, 1n)), _) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.add(l, Nat.add(l, 1n)), Nat.add(Nat.mul(h, k), Nat.mul(h, k))), Nat.add(l, Nat.add(Nat.add(l, 1n), Nat.add(Nat.mul(h, k), Nat.mul(h, k)))), NA.add_assoc(l, Nat.add(l, 1n), Nat.add(Nat.mul(h, k), Nat.mul(h, k)))) : {Nat.add(Nat.mul(h, k), Nat.add(Nat.mul(h, k), Nat.add(l, Nat.add(l, 1n)))) == _ : Nat}
  %Equal.sym(Nat, Nat.add(Nat.add(l, 1n), Nat.add(Nat.mul(h, k), Nat.mul(h, k))), Nat.add(l, Nat.add(1n, Nat.add(Nat.mul(h, k), Nat.mul(h, k)))), NA.add_assoc(l, 1n, Nat.add(Nat.mul(h, k), Nat.mul(h, k)))) : {Nat.add(Nat.mul(h, k), Nat.add(Nat.mul(h, k), Nat.add(l, Nat.add(l, 1n)))) == Nat.add(l, _) : Nat}
  %Equal.sym(Nat, Nat.add(1n, Nat.add(Nat.mul(h, k), Nat.mul(h, k))), Nat.add(Nat.mul(h, k), Nat.add(1n, Nat.mul(h, k))), NA.add_swap(1n, Nat.mul(h, k), Nat.mul(h, k))) : {Nat.add(Nat.mul(h, k), Nat.add(Nat.mul(h, k), Nat.add(l, Nat.add(l, 1n)))) == Nat.add(l, Nat.add(l, _)) : Nat}
  %Equal.sym(Nat, Nat.add(1n, Nat.mul(h, k)), Nat.add(Nat.mul(h, k), 1n), NA.add_comm(1n, Nat.mul(h, k))) : {Nat.add(Nat.mul(h, k), Nat.add(Nat.mul(h, k), Nat.add(l, Nat.add(l, 1n)))) == Nat.add(l, Nat.add(l, Nat.add(Nat.mul(h, k), _))) : Nat}
  %Equal.sym(Nat, Nat.add(l, Nat.add(Nat.mul(h, k), Nat.add(Nat.mul(h, k), 1n))), Nat.add(Nat.mul(h, k), Nat.add(l, Nat.add(Nat.mul(h, k), 1n))), NA.add_swap(l, Nat.mul(h, k), Nat.add(Nat.mul(h, k), 1n))) : {Nat.add(Nat.mul(h, k), Nat.add(Nat.mul(h, k), Nat.add(l, Nat.add(l, 1n)))) == Nat.add(l, _) : Nat}
  %Equal.sym(Nat, Nat.add(l, Nat.add(Nat.mul(h, k), 1n)), Nat.add(Nat.mul(h, k), Nat.add(l, 1n)), NA.add_swap(l, Nat.mul(h, k), 1n)) : {Nat.add(Nat.mul(h, k), Nat.add(Nat.mul(h, k), Nat.add(l, Nat.add(l, 1n)))) == Nat.add(l, Nat.add(Nat.mul(h, k), _)) : Nat}
  %Equal.sym(Nat, Nat.add(l, Nat.add(Nat.mul(h, k), Nat.add(Nat.mul(h, k), Nat.add(l, 1n)))), Nat.add(Nat.mul(h, k), Nat.add(l, Nat.add(Nat.mul(h, k), Nat.add(l, 1n)))), NA.add_swap(l, Nat.mul(h, k), Nat.add(Nat.mul(h, k), Nat.add(l, 1n)))) : {Nat.add(Nat.mul(h, k), Nat.add(Nat.mul(h, k), Nat.add(l, Nat.add(l, 1n)))) == _ : Nat}
  %Equal.sym(Nat, Nat.add(l, Nat.add(Nat.mul(h, k), Nat.add(l, 1n))), Nat.add(Nat.mul(h, k), Nat.add(l, Nat.add(l, 1n))), NA.add_swap(l, Nat.mul(h, k), Nat.add(l, 1n))) : {Nat.add(Nat.mul(h, k), Nat.add(Nat.mul(h, k), Nat.add(l, Nat.add(l, 1n)))) == Nat.add(Nat.mul(h, k), _) : Nat}
  {==}


# a == lo + hi 2^k
def split_v(k: Nat, a: B.Bn) -> {B.bval(a) == Nat.add(B.bval(flo(k, a)), Nat.mul(B.bval(fhi(k, a)), B.bval(fshl(k, B.B1{B.BZ{}})))) : Nat}:
  match k a:
    case 0n +x:
      s0_s(B.bval(x))
    case 1n+ +j B.BZ{}:
      sz_s(B.bval(fshl(1n+j, B.B1{B.BZ{}})))
    case 1n+ +j B.B0{+t}:
      %Equal.sym(Nat, B.bval(t), Nat.add(B.bval(flo(j, t)), Nat.mul(B.bval(fhi(j, t)), B.bval(fshl(j, B.B1{B.BZ{}})))), split_v(j, t)) : {Nat.add(_, B.bval(t)) == Nat.add(Nat.add(B.bval(flo(j, t)), B.bval(flo(j, t))), Nat.mul(B.bval(fhi(j, t)), Nat.add(B.bval(fshl(j, B.B1{B.BZ{}})), B.bval(fshl(j, B.B1{B.BZ{}}))))) : Nat}
      %Equal.sym(Nat, B.bval(t), Nat.add(B.bval(flo(j, t)), Nat.mul(B.bval(fhi(j, t)), B.bval(fshl(j, B.B1{B.BZ{}})))), split_v(j, t)) : {Nat.add(Nat.add(B.bval(flo(j, t)), Nat.mul(B.bval(fhi(j, t)), B.bval(fshl(j, B.B1{B.BZ{}})))), _) == Nat.add(Nat.add(B.bval(flo(j, t)), B.bval(flo(j, t))), Nat.mul(B.bval(fhi(j, t)), Nat.add(B.bval(fshl(j, B.B1{B.BZ{}})), B.bval(fshl(j, B.B1{B.BZ{}}))))) : Nat}
      s2_s(B.bval(flo(j, t)), B.bval(fhi(j, t)), B.bval(fshl(j, B.B1{B.BZ{}})))
    case 1n+ +j B.B1{+t}:
      %Equal.sym(Nat, B.bval(t), Nat.add(B.bval(flo(j, t)), Nat.mul(B.bval(fhi(j, t)), B.bval(fshl(j, B.B1{B.BZ{}})))), split_v(j, t)) : {1n+Nat.add(_, B.bval(t)) == Nat.add(1n+Nat.add(B.bval(flo(j, t)), B.bval(flo(j, t))), Nat.mul(B.bval(fhi(j, t)), Nat.add(B.bval(fshl(j, B.B1{B.BZ{}})), B.bval(fshl(j, B.B1{B.BZ{}}))))) : Nat}
      %Equal.sym(Nat, B.bval(t), Nat.add(B.bval(flo(j, t)), Nat.mul(B.bval(fhi(j, t)), B.bval(fshl(j, B.B1{B.BZ{}})))), split_v(j, t)) : {1n+Nat.add(Nat.add(B.bval(flo(j, t)), Nat.mul(B.bval(fhi(j, t)), B.bval(fshl(j, B.B1{B.BZ{}})))), _) == Nat.add(1n+Nat.add(B.bval(flo(j, t)), B.bval(flo(j, t))), Nat.mul(B.bval(fhi(j, t)), Nat.add(B.bval(fshl(j, B.B1{B.BZ{}})), B.bval(fshl(j, B.B1{B.BZ{}}))))) : Nat}
      s3_s(B.bval(flo(j, t)), B.bval(fhi(j, t)), B.bval(fshl(j, B.B1{B.BZ{}})))


def fs_s(+l: Nat, +h: Nat, +c: Nat, +m: Nat) -> {Nat.add(l, Nat.mul(h, Nat.add(m, c))) == Nat.add(Nat.mul(h, m), Nat.add(l, Nat.mul(c, h))) : Nat}:
  %Equal.sym(Nat, Nat.add(m, c), Nat.add(c, m), NA.add_comm(m, c)) : {Nat.add(l, Nat.mul(h, _)) == Nat.add(Nat.mul(h, m), Nat.add(l, Nat.mul(c, h))) : Nat}
  %Equal.sym(Nat, Nat.mul(h, Nat.add(c, m)), Nat.add(Nat.mul(h, c), Nat.mul(h, m)), NA.mul_add_left(h, c, m)) : {Nat.add(l, _) == Nat.add(Nat.mul(h, m), Nat.add(l, Nat.mul(c, h))) : Nat}
  %Equal.sym(Nat, Nat.mul(h, c), Nat.mul(c, h), NA.mul_comm(h, c)) : {Nat.add(l, Nat.add(_, Nat.mul(h, m))) == Nat.add(Nat.mul(h, m), Nat.add(l, Nat.mul(c, h))) : Nat}
  %Equal.sym(Nat, Nat.add(l, Nat.add(Nat.mul(c, h), Nat.mul(h, m))), Nat.add(Nat.mul(c, h), Nat.add(l, Nat.mul(h, m))), NA.add_swap(l, Nat.mul(c, h), Nat.mul(h, m))) : {_ == Nat.add(Nat.mul(h, m), Nat.add(l, Nat.mul(c, h))) : Nat}
  %Equal.sym(Nat, Nat.add(l, Nat.mul(h, m)), Nat.add(Nat.mul(h, m), l), NA.add_comm(l, Nat.mul(h, m))) : {Nat.add(Nat.mul(c, h), _) == Nat.add(Nat.mul(h, m), Nat.add(l, Nat.mul(c, h))) : Nat}
  %Equal.sym(Nat, Nat.add(l, Nat.mul(c, h)), Nat.add(Nat.mul(c, h), l), NA.add_comm(l, Nat.mul(c, h))) : {Nat.add(Nat.mul(c, h), Nat.add(Nat.mul(h, m), l)) == Nat.add(Nat.mul(h, m), _) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.mul(h, m), Nat.add(Nat.mul(c, h), l)), Nat.add(Nat.mul(c, h), Nat.add(Nat.mul(h, m), l)), NA.add_swap(Nat.mul(h, m), Nat.mul(c, h), l)) : {Nat.add(Nat.mul(c, h), Nat.add(Nat.mul(h, m), l)) == _ : Nat}
  {==}


# a fold keeps the value modulo m = 1 + mp, when 2^k == m + c
def fold_v(+mp: Nat, +k: Nat, +c: B.Bn, +t: B.Bn, +hm: {B.bval(fshl(k, B.B1{B.BZ{}})) == Nat.add(1n+mp, B.bval(c)) : Nat}) -> {Nat.mod(B.bval(fold(k, c, t)), 1n+mp) == Nat.mod(B.bval(t), 1n+mp) : Nat}:
  %Equal.sym(Nat, B.bval(B.badd(flo(k, t), B.bmul(c, fhi(k, t)))), Nat.add(B.bval(flo(k, t)), B.bval(B.bmul(c, fhi(k, t)))), B.badd_v(flo(k, t), B.bmul(c, fhi(k, t)))) : {Nat.mod(_, 1n+mp) == Nat.mod(B.bval(t), 1n+mp) : Nat}
  %Equal.sym(Nat, B.bval(B.bmul(c, fhi(k, t))), Nat.mul(B.bval(c), B.bval(fhi(k, t))), B.bmul_v(c, fhi(k, t))) : {Nat.mod(Nat.add(B.bval(flo(k, t)), _), 1n+mp) == Nat.mod(B.bval(t), 1n+mp) : Nat}
  %Equal.sym(Nat, B.bval(t), Nat.add(B.bval(flo(k, t)), Nat.mul(B.bval(fhi(k, t)), B.bval(fshl(k, B.B1{B.BZ{}})))), split_v(k, t)) : {Nat.mod(Nat.add(B.bval(flo(k, t)), Nat.mul(B.bval(c), B.bval(fhi(k, t)))), 1n+mp) == Nat.mod(_, 1n+mp) : Nat}
  %Equal.sym(Nat, B.bval(fshl(k, B.B1{B.BZ{}})), Nat.add(1n+mp, B.bval(c)), hm) : {Nat.mod(Nat.add(B.bval(flo(k, t)), Nat.mul(B.bval(c), B.bval(fhi(k, t)))), 1n+mp) == Nat.mod(Nat.add(B.bval(flo(k, t)), Nat.mul(B.bval(fhi(k, t)), _)), 1n+mp) : Nat}
  %Equal.sym(Nat, Nat.add(B.bval(flo(k, t)), Nat.mul(B.bval(fhi(k, t)), Nat.add(1n+mp, B.bval(c)))), Nat.add(Nat.mul(B.bval(fhi(k, t)), 1n+mp), Nat.add(B.bval(flo(k, t)), Nat.mul(B.bval(c), B.bval(fhi(k, t))))), fs_s(B.bval(flo(k, t)), B.bval(fhi(k, t)), B.bval(c), 1n+mp)) : {Nat.mod(Nat.add(B.bval(flo(k, t)), Nat.mul(B.bval(c), B.bval(fhi(k, t)))), 1n+mp) == Nat.mod(_, 1n+mp) : Nat}
  %Equal.sym(Nat, Nat.mod(Nat.add(Nat.mul(B.bval(fhi(k, t)), 1n+mp), Nat.add(B.bval(flo(k, t)), Nat.mul(B.bval(c), B.bval(fhi(k, t))))), 1n+mp), Nat.mod(Nat.add(B.bval(flo(k, t)), Nat.mul(B.bval(c), B.bval(fhi(k, t)))), 1n+mp), NR.absorb(mp, B.bval(fhi(k, t)), Nat.add(B.bval(flo(k, t)), Nat.mul(B.bval(c), B.bval(fhi(k, t)))))) : {Nat.mod(Nat.add(B.bval(flo(k, t)), Nat.mul(B.bval(c), B.bval(fhi(k, t)))), 1n+mp) == _ : Nat}
  {==}


def fred_v(+mp: Nat, +k: Nat, +c: B.Bn, +t: B.Bn, +hm: {B.bval(fshl(k, B.B1{B.BZ{}})) == Nat.add(1n+mp, B.bval(c)) : Nat}) -> {Nat.mod(B.bval(fred(k, c, t)), 1n+mp) == Nat.mod(B.bval(t), 1n+mp) : Nat}:
  Equal.trans(Nat, Nat.mod(B.bval(fold(k, c, fold(k, c, t))), 1n+mp), Nat.mod(B.bval(fold(k, c, t)), 1n+mp), Nat.mod(B.bval(t), 1n+mp), fold_v(mp, k, c, fold(k, c, t), hm), fold_v(mp, k, c, t, hm))


def sq_c(+mp: Nat, +x: Nat, +w: Nat, +hx: {Nat.mod(x, 1n+mp) == Nat.mod(w, 1n+mp) : Nat}) -> {Nat.mod(Nat.mul(x, x), 1n+mp) == Nat.mod(Nat.mul(w, w), 1n+mp) : Nat}:
  Equal.trans(Nat, Nat.mod(Nat.mul(x, x), 1n+mp), Nat.mod(Nat.mul(w, x), 1n+mp), Nat.mod(Nat.mul(w, w), 1n+mp), Z.cg_mul_l(mp, x, w, x, hx), Z.cg_mul_r(mp, w, x, w, hx))


def e0(+mp: Nat, +x: B.Bn, +w: Nat, +hx: {Nat.mod(B.bval(x), 1n+mp) == Nat.mod(w, 1n+mp) : Nat}) -> {Nat.mod(B.bval(bsq(x)), 1n+mp) == Nat.mod(Nat.mul(w, w), 1n+mp) : Nat}:
  %Equal.sym(Nat, B.bval(bsq(x)), Nat.mul(B.bval(x), B.bval(x)), bsq_v(x)) : {Nat.mod(_, 1n+mp) == Nat.mod(Nat.mul(w, w), 1n+mp) : Nat}
  sq_c(mp, B.bval(x), w, hx)


def e1(+mp: Nat, +a: B.Bn, +x: B.Bn, +w: Nat, +hx: {Nat.mod(B.bval(x), 1n+mp) == Nat.mod(w, 1n+mp) : Nat}) -> {Nat.mod(B.bval(B.bmul(a, bsq(x))), 1n+mp) == Nat.mod(Nat.mul(B.bval(a), Nat.mul(w, w)), 1n+mp) : Nat}:
  %Equal.sym(Nat, B.bval(B.bmul(a, bsq(x))), Nat.mul(B.bval(a), B.bval(bsq(x))), B.bmul_v(a, bsq(x))) : {Nat.mod(_, 1n+mp) == Nat.mod(Nat.mul(B.bval(a), Nat.mul(w, w)), 1n+mp) : Nat}
  %Equal.sym(Nat, B.bval(bsq(x)), Nat.mul(B.bval(x), B.bval(x)), bsq_v(x)) : {Nat.mod(Nat.mul(B.bval(a), _), 1n+mp) == Nat.mod(Nat.mul(B.bval(a), Nat.mul(w, w)), 1n+mp) : Nat}
  Z.cg_mul_r(mp, B.bval(a), Nat.mul(B.bval(x), B.bval(x)), Nat.mul(w, w), sq_c(mp, B.bval(x), w, hx))


# fexp is a^e modulo m = 1 + mp, when 2^k == m + c
def fexp_v(e: B.Bn, +a: B.Bn, +k: Nat, +c: B.Bn, +mp: Nat, +hm: {B.bval(fshl(k, B.B1{B.BZ{}})) == Nat.add(1n+mp, B.bval(c)) : Nat}) -> {Nat.mod(B.bval(fexp(e, a, k, c)), 1n+mp) == Nat.mod(Nat.pow(B.bval(a), B.bval(e)), 1n+mp) : Nat}:
  match e:
    case B.BZ{}:
      {==}
    case B.B0{+t}:
      %Equal.sym(Nat, Nat.pow(B.bval(a), Nat.add(B.bval(t), B.bval(t))), Nat.mul(Nat.pow(B.bval(a), B.bval(t)), Nat.pow(B.bval(a), B.bval(t))), NR.pow_add(B.bval(a), B.bval(t), B.bval(t))) : {Nat.mod(B.bval(fred(k, c, bsq(fexp(t, a, k, c)))), 1n+mp) == Nat.mod(_, 1n+mp) : Nat}
      Equal.trans(Nat, Nat.mod(B.bval(fred(k, c, bsq(fexp(t, a, k, c)))), 1n+mp), Nat.mod(B.bval(bsq(fexp(t, a, k, c))), 1n+mp), Nat.mod(Nat.mul(Nat.pow(B.bval(a), B.bval(t)), Nat.pow(B.bval(a), B.bval(t))), 1n+mp), fred_v(mp, k, c, bsq(fexp(t, a, k, c)), hm), e0(mp, fexp(t, a, k, c), Nat.pow(B.bval(a), B.bval(t)), fexp_v(t, a, k, c, mp, hm)))
    case B.B1{+t}:
      %Equal.sym(Nat, Nat.pow(B.bval(a), Nat.add(B.bval(t), B.bval(t))), Nat.mul(Nat.pow(B.bval(a), B.bval(t)), Nat.pow(B.bval(a), B.bval(t))), NR.pow_add(B.bval(a), B.bval(t), B.bval(t))) : {Nat.mod(B.bval(fred(k, c, B.bmul(a, bsq(fexp(t, a, k, c))))), 1n+mp) == Nat.mod(Nat.mul(B.bval(a), _), 1n+mp) : Nat}
      Equal.trans(Nat, Nat.mod(B.bval(fred(k, c, B.bmul(a, bsq(fexp(t, a, k, c))))), 1n+mp), Nat.mod(B.bval(B.bmul(a, bsq(fexp(t, a, k, c)))), 1n+mp), Nat.mod(Nat.mul(B.bval(a), Nat.mul(Nat.pow(B.bval(a), B.bval(t)), Nat.pow(B.bval(a), B.bval(t)))), 1n+mp), fred_v(mp, k, c, B.bmul(a, bsq(fexp(t, a, k, c))), hm), e1(mp, a, fexp(t, a, k, c), Nat.pow(B.bval(a), B.bval(t)), fexp_v(t, a, k, c, mp, hm)))


# ---- powers and congruences ----

# a^(f e) == (a^e)^f
def pow_mul(+a: Nat, +e: Nat, f: Nat) -> {Nat.pow(a, Nat.mul(f, e)) == Nat.pow(Nat.pow(a, e), f) : Nat}:
  match f:
    case 0n:
      {==}
    case 1n+ +t:
      %Equal.sym(Nat, Nat.pow(a, Nat.add(e, Nat.mul(t, e))), Nat.mul(Nat.pow(a, e), Nat.pow(a, Nat.mul(t, e))), NR.pow_add(a, e, Nat.mul(t, e))) : {_ == Nat.mul(Nat.pow(a, e), Nat.pow(Nat.pow(a, e), t)) : Nat}
      %Equal.sym(Nat, Nat.pow(a, Nat.mul(t, e)), Nat.pow(Nat.pow(a, e), t), pow_mul(a, e, t)) : {Nat.mul(Nat.pow(a, e), _) == Nat.mul(Nat.pow(a, e), Nat.pow(Nat.pow(a, e), t)) : Nat}
      {==}


def pow_cg(+mp: Nat, +x: Nat, +w: Nat, k: Nat, +h: {Nat.mod(x, 1n+mp) == Nat.mod(w, 1n+mp) : Nat}) -> {Nat.mod(Nat.pow(x, k), 1n+mp) == Nat.mod(Nat.pow(w, k), 1n+mp) : Nat}:
  match k:
    case 0n:
      {==}
    case 1n+ +j:
      Equal.trans(Nat, Nat.mod(Nat.mul(x, Nat.pow(x, j)), 1n+mp), Nat.mod(Nat.mul(w, Nat.pow(x, j)), 1n+mp), Nat.mod(Nat.mul(w, Nat.pow(w, j)), 1n+mp), Z.cg_mul_l(mp, x, w, Nat.pow(x, j), h), Z.cg_mul_r(mp, w, Nat.pow(x, j), Nat.pow(w, j), pow_cg(mp, x, w, j, h)))


# y == x^f and x == a^e give y == a^(f e)
def rebase(+mp: Nat, +a: Nat, +e: Nat, +x: Nat, +f: Nat, +y: Nat, +hx: {Nat.mod(x, 1n+mp) == Nat.mod(Nat.pow(a, e), 1n+mp) : Nat}, +hy: {Nat.mod(y, 1n+mp) == Nat.mod(Nat.pow(x, f), 1n+mp) : Nat}) -> {Nat.mod(y, 1n+mp) == Nat.mod(Nat.pow(a, Nat.mul(f, e)), 1n+mp) : Nat}:
  %Equal.sym(Nat, Nat.pow(a, Nat.mul(f, e)), Nat.pow(Nat.pow(a, e), f), pow_mul(a, e, f)) : {Nat.mod(y, 1n+mp) == Nat.mod(_, 1n+mp) : Nat}
  Equal.trans(Nat, Nat.mod(y, 1n+mp), Nat.mod(Nat.pow(x, f), 1n+mp), Nat.mod(Nat.pow(Nat.pow(a, e), f), 1n+mp), hy, pow_cg(mp, x, Nat.pow(a, e), f, hx))


# x == a^e, y == a^f and x y == q m + z give z == a^(e + f)
def mulc(+mp: Nat, +a: Nat, +e: Nat, +f: Nat, +x: Nat, +y: Nat, +q: Nat, +z: Nat, +hx: {Nat.mod(x, 1n+mp) == Nat.mod(Nat.pow(a, e), 1n+mp) : Nat}, +hy: {Nat.mod(y, 1n+mp) == Nat.mod(Nat.pow(a, f), 1n+mp) : Nat}, +hs: {Nat.mul(x, y) == Nat.add(Nat.mul(q, 1n+mp), z) : Nat}) -> {Nat.mod(z, 1n+mp) == Nat.mod(Nat.pow(a, Nat.add(e, f)), 1n+mp) : Nat}:
  %Equal.sym(Nat, Nat.pow(a, Nat.add(e, f)), Nat.mul(Nat.pow(a, e), Nat.pow(a, f)), NR.pow_add(a, e, f)) : {Nat.mod(z, 1n+mp) == Nat.mod(_, 1n+mp) : Nat}
  %Equal.sym(Nat, Nat.mod(z, 1n+mp), Nat.mod(Nat.add(Nat.mul(q, 1n+mp), z), 1n+mp), Equal.sym(Nat, Nat.mod(Nat.add(Nat.mul(q, 1n+mp), z), 1n+mp), Nat.mod(z, 1n+mp), NR.absorb(mp, q, z))) : {_ == Nat.mod(Nat.mul(Nat.pow(a, e), Nat.pow(a, f)), 1n+mp) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.mul(q, 1n+mp), z), Nat.mul(x, y), Equal.sym(Nat, Nat.mul(x, y), Nat.add(Nat.mul(q, 1n+mp), z), hs)) : {Nat.mod(_, 1n+mp) == Nat.mod(Nat.mul(Nat.pow(a, e), Nat.pow(a, f)), 1n+mp) : Nat}
  Equal.trans(Nat, Nat.mod(Nat.mul(x, y), 1n+mp), Nat.mod(Nat.mul(Nat.pow(a, e), y), 1n+mp), Nat.mod(Nat.mul(Nat.pow(a, e), Nat.pow(a, f)), 1n+mp), Z.cg_mul_l(mp, x, Nat.pow(a, e), y, hx), Z.cg_mul_r(mp, Nat.pow(a, e), y, Nat.pow(a, f), hy))
