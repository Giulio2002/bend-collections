# Q equiv Q2: P + Q equiv P + Q2
def e_add_r(+mp: Nat, +hp: PM.Prime(1n+mp), +a: CS.SPoint, +b: CS.SPoint, +b2: CS.SPoint, +vb: {GS.valid(1n+mp, b) == True{} : Bool}, +vb2: {GS.valid(1n+mp, b2) == True{} : Bool}, +h: {GS.equiv(1n+mp, b, b2) == True{} : Bool}) -> {GS.equiv(1n+mp, CS.padd(1n+mp, a, b), CS.padd(1n+mp, a, b2)) == True{} : Bool}:
  %G1.add_comm(mp, b, a) : {GS.equiv(1n+mp, _, CS.padd(1n+mp, a, b2)) == True{} : Bool}
  %G1.add_comm(mp, b2, a) : {GS.equiv(1n+mp, CS.padd(1n+mp, b, a), _) == True{} : Bool}
  e_add_l(mp, hp, b, b2, a, vb, vb2, h)


# ---- identity, inverse, doubling ----

def lt1(+mp: Nat, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}) -> {Nat.is_lt(1n, 1n+mp) == True{} : Bool}:
  N.lt_trans(1n, 21n, 1n+mp, {==}, h21)


# O = (0 : 1 : 0) is a point of the group
def v_inf(+mp: Nat, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}) -> {GS.valid(1n+mp, CS.infinity()) == True{} : Bool}:
