# P + O equiv P
def unit(+mp: Nat, a: CS.SPoint) -> {GS.equiv(1n+mp, CS.padd(1n+mp, a, CS.infinity()), a) == True{} : Bool}:
  match a:
    case CS.SPoint{+x, +y, +z}:
      G1.e_pack(mp, CS.nth(33n, CS.run(1n+mp, CS.add_prog(), [x, y, z, 0n, 1n, 0n, 21n])), CS.nth(36n, CS.run(1n+mp, CS.add_prog(), [x, y, z, 0n, 1n, 0n, 21n])), CS.nth(39n, CS.run(1n+mp, CS.add_prog(), [x, y, z, 0n, 1n, 0n, 21n])), x, y, z,
        I.both_red(mp, Nat.mul(CS.nth(33n, CS.run(1n+mp, CS.add_prog(), [x, y, z, 0n, 1n, 0n, 21n])), y), Nat.mul(x, CS.nth(36n, CS.run(1n+mp, CS.add_prog(), [x, y, z, 0n, 1n, 0n, 21n]))), D.unit_ex(mp, x, y, z)),
        I.both_red(mp, Nat.mul(CS.nth(39n, CS.run(1n+mp, CS.add_prog(), [x, y, z, 0n, 1n, 0n, 21n])), y), Nat.mul(z, CS.nth(36n, CS.run(1n+mp, CS.add_prog(), [x, y, z, 0n, 1n, 0n, 21n]))), D.unit_ez(mp, x, y, z)))


def dx_red(+mp: Nat, +a: Nat, +b: Nat, +c: Nat) -> {Nat.mod(CS.nth(21n, CS.run(1n+mp, CS.dbl_prog(), [a, b, c, 21n])), 1n+mp) == CS.nth(21n, CS.run(1n+mp, CS.dbl_prog(), [a, b, c, 21n])) : Nat}:
  G1.reg_red(mp, CS.dbl_prog(), [a, b, c, 21n], 21n, CS.SAdd{20n, 20n}, {==})


def dy_red(+mp: Nat, +a: Nat, +b: Nat, +c: Nat) -> {Nat.mod(CS.nth(18n, CS.run(1n+mp, CS.dbl_prog(), [a, b, c, 21n])), 1n+mp) == CS.nth(18n, CS.run(1n+mp, CS.dbl_prog(), [a, b, c, 21n])) : Nat}:
  G1.reg_red(mp, CS.dbl_prog(), [a, b, c, 21n], 18n, CS.SAdd{11n, 17n}, {==})


def dz_red(+mp: Nat, +a: Nat, +b: Nat, +c: Nat) -> {Nat.mod(CS.nth(13n, CS.run(1n+mp, CS.dbl_prog(), [a, b, c, 21n])), 1n+mp) == CS.nth(13n, CS.run(1n+mp, CS.dbl_prog(), [a, b, c, 21n])) : Nat}:
  G1.reg_red(mp, CS.dbl_prog(), [a, b, c, 21n], 13n, CS.SMul{8n, 7n}, {==})


# 2 P (the doubling program) is P + P, as triples, for P on the curve
def dbl(+mp: Nat, a: CS.SPoint, +va: {GS.valid(1n+mp, a) == True{} : Bool}) -> {CS.pdbl(1n+mp, a) == CS.padd(1n+mp, a, a) : CS.SPoint}:
  match a:
    case CS.SPoint{+x, +y, +z}:
      +c = G1.v_onc(mp, x, y, z, va)
      G1.sp_eq(CS.nth(21n, CS.run(1n+mp, CS.dbl_prog(), [x, y, z, 21n])), CS.nth(18n, CS.run(1n+mp, CS.dbl_prog(), [x, y, z, 21n])), CS.nth(13n, CS.run(1n+mp, CS.dbl_prog(), [x, y, z, 21n])), CS.nth(33n, CS.run(1n+mp, CS.add_prog(), [x, y, z, x, y, z, 21n])), CS.nth(36n, CS.run(1n+mp, CS.add_prog(), [x, y, z, x, y, z, 21n])), CS.nth(39n, CS.run(1n+mp, CS.add_prog(), [x, y, z, x, y, z, 21n])),
