        G1.reg_eq(mp, CS.nth(18n, CS.run(1n+mp, CS.dbl_prog(), [x, y, z, 21n])), CS.nth(36n, CS.run(1n+mp, CS.add_prog(), [x, y, z, x, y, z, 21n])), dy_red(mp, x, y, z), G1.ay_red(mp, x, y, z, x, y, z), D.dbl_y(mp, x, y, z, c)),
        G1.reg_eq(mp, CS.nth(13n, CS.run(1n+mp, CS.dbl_prog(), [x, y, z, 21n])), CS.nth(39n, CS.run(1n+mp, CS.add_prog(), [x, y, z, x, y, z, 21n])), dz_red(mp, x, y, z), G1.az_red(mp, x, y, z, x, y, z), D.dbl_z(mp, x, y, z, c)))
