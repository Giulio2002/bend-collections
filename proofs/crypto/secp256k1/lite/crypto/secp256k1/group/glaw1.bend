    case CS.SPoint{+x1, +y1, +z1} CS.SPoint{+x2, +y2, +z2}:
      sp_eq(CS.nth(33n, CS.run(1n+mp, CS.add_prog(), [x1, y1, z1, x2, y2, z2, 21n])), CS.nth(36n, CS.run(1n+mp, CS.add_prog(), [x1, y1, z1, x2, y2, z2, 21n])), CS.nth(39n, CS.run(1n+mp, CS.add_prog(), [x1, y1, z1, x2, y2, z2, 21n])), CS.nth(33n, CS.run(1n+mp, CS.add_prog(), [x2, y2, z2, x1, y1, z1, 21n])), CS.nth(36n, CS.run(1n+mp, CS.add_prog(), [x2, y2, z2, x1, y1, z1, 21n])), CS.nth(39n, CS.run(1n+mp, CS.add_prog(), [x2, y2, z2, x1, y1, z1, 21n])),
        reg_eq(mp, CS.nth(33n, CS.run(1n+mp, CS.add_prog(), [x1, y1, z1, x2, y2, z2, 21n])), CS.nth(33n, CS.run(1n+mp, CS.add_prog(), [x2, y2, z2, x1, y1, z1, 21n])), ax_red(mp, x1, y1, z1, x2, y2, z2), ax_red(mp, x2, y2, z2, x1, y1, z1), CM.comm_x(mp, x1, y1, z1, x2, y2, z2, 21n)),
        reg_eq(mp, CS.nth(36n, CS.run(1n+mp, CS.add_prog(), [x1, y1, z1, x2, y2, z2, 21n])), CS.nth(36n, CS.run(1n+mp, CS.add_prog(), [x2, y2, z2, x1, y1, z1, 21n])), ay_red(mp, x1, y1, z1, x2, y2, z2), ay_red(mp, x2, y2, z2, x1, y1, z1), CM.comm_y(mp, x1, y1, z1, x2, y2, z2, 21n)),
        reg_eq(mp, CS.nth(39n, CS.run(1n+mp, CS.add_prog(), [x1, y1, z1, x2, y2, z2, 21n])), CS.nth(39n, CS.run(1n+mp, CS.add_prog(), [x2, y2, z2, x1, y1, z1, 21n])), az_red(mp, x1, y1, z1, x2, y2, z2), az_red(mp, x2, y2, z2, x1, y1, z1), CM.comm_z(mp, x1, y1, z1, x2, y2, z2, 21n)))
