# ---- closure and commutativity ----

# the sum of two points of the group is a point of the group
def v_add(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, a: CS.SPoint, b: CS.SPoint, +va: {GS.valid(1n+mp, a) == True{} : Bool}, +vb: {GS.valid(1n+mp, b) == True{} : Bool}) -> {GS.valid(1n+mp, CS.padd(1n+mp, a, b)) == True{} : Bool}:
  match a b:
    case CS.SPoint{+x1, +y1, +z1} CS.SPoint{+x2, +y2, +z2}:
      +c1 = v_onc(mp, x1, y1, z1, va)
      +c2 = v_onc(mp, x2, y2, z2, vb)
      v_pack(mp, C.aX(mp, x1, y1, z1, x2, y2, z2), C.aY(mp, x1, y1, z1, x2, y2, z2), C.aZ(mp, x1, y1, z1, x2, y2, z2),
        I.both_red(mp, Nat.mul(FS.mmul(1n+mp, C.aX(mp, x1, y1, z1, x2, y2, z2), C.aX(mp, x1, y1, z1, x2, y2, z2)), C.aX(mp, x1, y1, z1, x2, y2, z2)), Nat.sub(Nat.add(FS.mmul(1n+mp, FS.mmul(1n+mp, C.aY(mp, x1, y1, z1, x2, y2, z2), C.aY(mp, x1, y1, z1, x2, y2, z2)), C.aZ(mp, x1, y1, z1, x2, y2, z2)), 1n+mp), Nat.mod(FS.mmul(1n+mp, 7n, FS.mmul(1n+mp, FS.mmul(1n+mp, C.aZ(mp, x1, y1, z1, x2, y2, z2), C.aZ(mp, x1, y1, z1, x2, y2, z2)), C.aZ(mp, x1, y1, z1, x2, y2, z2))), 1n+mp)), C.add_curve(mp, x1, y1, z1, x2, y2, z2, c1, c2)),
        CP.y_nz(mp, hp, h3, hnc, h21, x1, y1, z1, x2, y2, z2, c1, c2, v_nz(mp, x1, y1, z1, va), v_nz(mp, x2, y2, z2, vb)))


# P + Q == Q + P, as triples
def add_comm(+mp: Nat, a: CS.SPoint, b: CS.SPoint) -> {CS.padd(1n+mp, a, b) == CS.padd(1n+mp, b, a) : CS.SPoint}:
