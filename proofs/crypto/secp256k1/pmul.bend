# Scalar multiplication (src/crypto/secp256k1/point.bend mul: masked
# double-and-add over the 256 bits of the scalar, most significant first)
# computes the specification's pmul (spec/crypto/secp256k1/curve.bend) on
# the values of the coordinates.

# ---- the specification's loop over a list of bits ----

def lgo(+p: Nat, bs: List<&2, Nat>, +a: CV.SPoint, r: CV.SPoint) -> CV.SPoint:
  match bs:
    case Nil{}: r
    case b <> t: lgo(p, t, a, CV.step(b, p, a, CV.pdbl(p, r)))

def sgo(i: Nat, +p: Nat, +k: Nat, +a: CV.SPoint, r: CV.SPoint) -> {CV.mul_go(i, p, k, a, r) == lgo(p, BR.sb(i, 0n, k), a, r) : CV.SPoint}:
  match i:
    case 0n:
      {==}
    case 1n+ +j:
      sgo(j, p, k, a, CV.step(CV.bit(j, k), p, a, CV.pdbl(p, r)))

def bit01(n: Nat) -> {Nat.is_lt(C.bit(n), 2n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n:
      {==}
    case 2n+m:
      bit01(m)

def sb01(i: Nat, +off: Nat, +k: Nat) -> {BV.all01(BR.sb(i, off, k)) == True{} : Bool}:
  match i:
    case 0n:
      {==}
    case 1n+ +j:
      Lg.and_intro(Nat.is_lt(CV.bit(Nat.add(off, j), k), 2n), BV.all01(BR.sb(j, off, k)), bit01(C.high(Nat.add(off, j), k)), sb01(j, off, k))

# ---- selection ----

def sel0(+one: Nat, n: Nat, xs: List<&2, Nat>, ys: List<&2, Nat>, +hx: {FS.limbs16(one, n, xs) == True{} : Bool}, +hy: {FS.limbs16(one, n, ys) == True{} : Bool}) -> {L.select(0n, xs, ys) == ys : List<&2, Nat>}:
