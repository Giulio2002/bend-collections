  PT.op_r(one, PX.vmul_go(L.bitsf(ks), P.to_pt(pp), PX.infinity()), PM.vmul_go_r(one, h1, L.bitsf(ks), P.to_pt(pp), PX.infinity(), lbits01(one, h1, ks, hk), PT.tp_r(one, pp, hp), PM.pinf_r(one, h1)))

