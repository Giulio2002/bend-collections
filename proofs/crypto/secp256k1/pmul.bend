          +hyt = Lg.and_right(Nat.is_lt(y, C.shift(16n, one)), FS.limbs16(one, k, yt), hy)
          %Equal.sym(List<&2, Nat>, L.select(0n, xt, yt), yt, sel0(one, k, xt, yt, hxt, hyt)) : {Nat.add(Nat.mul(x, 0n), Nat.mul(y, 1n)) <> _ == y <> yt : List<&2, Nat>}
          %Equal.sym(Nat, Nat.mul(x, 0n), 0n, NA.mul_zero(x)) : {Nat.add(_, Nat.mul(y, 1n)) <> yt == y <> yt : List<&2, Nat>}
          %Equal.sym(Nat, Nat.mul(y, 1n), y, NA.mul_one(y)) : {Nat.add(0n, _) <> yt == y <> yt : List<&2, Nat>}
          {==}

def sel1(+one: Nat, n: Nat, xs: List<&2, Nat>, ys: List<&2, Nat>, +hx: {FS.limbs16(one, n, xs) == True{} : Bool}, +hy: {FS.limbs16(one, n, ys) == True{} : Bool}) -> {L.select(1n, xs, ys) == xs : List<&2, Nat>}:
