  %Equal.sym(Nat, one, 1n, h1) : {Nat.add(FS.cp(one), Nat.add(BV.hv(F.inv_bits(), one, 0n), 2n)) == Nat.add(Nat.add(BV.hv(L.cbits(L.bits(L.norm16([978n, 0n, 1n]))), one, 0n), Nat.add(0n, Nat.add(FS.cp(one), _))), one) : Nat}
