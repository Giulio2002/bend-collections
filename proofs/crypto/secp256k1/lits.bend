# every element of a literal list is below 65536 (literals compare as literals)
def ok16(n: Nat, xs: List<&2, Nat>) -> Bool:
  match n xs:
    case 0n Nil{}: True{}
    case 0n x <> t: False{}
    case 1n+k Nil{}: False{}
    case 1n+k x <> t: Bool.and(Nat.is_lt(x, 65536n), ok16(k, t))

def lits16_e(+one: Nat, +e: {Nat.is_le(65536n, C.shift(16n, one)) == True{} : Bool}, n: Nat, xs: List<&2, Nat>, +h: {ok16(n, xs) == True{} : Bool}) -> {FS.limbs16(one, n, xs) == True{} : Bool}:
  match n xs:
    case 0n Nil{}:
      {==}
    case 0n x <> t:
      Empty.absurd({FS.limbs16(one, 0n, x <> t) == True{} : Bool}, Lg.false_true(h))
    case 1n+k Nil{}:
      Empty.absurd({FS.limbs16(one, 1n+k, []) == True{} : Bool}, Lg.false_true(h))
    case 1n+ +k +x <> +t:
      +hx = Lg.and_left(Nat.is_lt(x, 65536n), ok16(k, t), h)
      +ht = Lg.and_right(Nat.is_lt(x, 65536n), ok16(k, t), h)
      Lg.and_intro(Nat.is_lt(x, C.shift(16n, one)), FS.limbs16(one, k, t), N.lt_le_trans(x, 65536n, C.shift(16n, one), hx, e), lits16_e(one, e, k, t, ht))

# a list of literals below 2^16 is a list of limbs
def lits16(+one: Nat, +h1: {one == 1n : Nat}, n: Nat, xs: List<&2, Nat>, +h: {ok16(n, xs) == True{} : Bool}) -> {FS.limbs16(one, n, xs) == True{} : Bool}:
  lits16_e(one, le16(one, h1), n, xs, h)
