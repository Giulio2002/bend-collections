# not (x < m + 1) is m < x
def nlt(x: Nat, m: Nat) -> {Bool.not(Nat.is_lt(x, 1n+m)) == Nat.is_lt(m, x) : Bool}:
  match x m:
    case 0n _:
      Equal.sym(Bool, Nat.is_lt(m, 0n), False{}, N.not_lt_zero(m))
    case 1n+y 0n:
      %Equal.sym(Bool, Nat.is_lt(y, 0n), False{}, N.not_lt_zero(y)) : {Bool.not(_) == True{} : Bool}
      {==}
    case 1n+y 1n+k:
      nlt(y, k)

