# for r < N < P: (r + N) mod P >= N exactly when r + N < P
def rn_cond(+r: Nat, +nn: Nat, +pp: Nat, +hr: {Nat.is_lt(r, nn) == True{} : Bool}, +hn: {Nat.is_lt(nn, 1n+pp) == True{} : Bool}, c: Bool, +hc: {Nat.is_lt(Nat.add(r, nn), 1n+pp) == c : Bool}) -> {Bool.not(Nat.is_lt(Nat.mod(Nat.add(r, nn), 1n+pp), nn)) == c : Bool}:
  match c:
    case True{}:
      rc_true(r, nn, pp, hc)
    case False{}:
      rc_false(r, nn, pp, hr, hn, hc)

# n < p
def n_lt_p(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.is_lt(1n+K.np(one), 1n+K.pp(one)) == True{} : Bool}:
  lt_of_sum(1n+K.pp(one), 1n+K.np(one), FS.cp(one), FS.cn(one), pn_sum(one, h1), cp_lt_cn(one, h1))
