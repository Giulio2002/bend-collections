def padd_v(+one: Nat, +h1: {one == 1n : Nat}, a: PX.PT, b: PX.PT, +ha: {pred(one, a) == True{} : Bool}, +hb: {pred(one, b) == True{} : Bool}) -> {pv(one, PX.add(a, b)) == CV.padd(FS.prime(one), pv(one, a), pv(one, b)) : CV.SPoint}:
