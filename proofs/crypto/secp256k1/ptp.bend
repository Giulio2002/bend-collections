def padd_r(+one: Nat, +h1: {one == 1n : Nat}, a: PX.PT, b: PX.PT, +ha: {pred(one, a) == True{} : Bool}, +hb: {pred(one, b) == True{} : Bool}) -> {pred(one, PX.add(a, b)) == True{} : Bool}:
  match a b:
    case PX.PT{+x1, +y1, +z1} PX.PT{+x2, +y2, +z2}:
      +hr = run_r(one, h1, I.radd_prog(), [x1, y1, z1, x2, y2, z2, PX.b3()], regs7_r(one, h1, PX.PT{x1, y1, z1}, PX.PT{x2, y2, z2}, ha, hb))
      +rs = I.rrun(I.radd_prog(), [x1, y1, z1, x2, y2, z2, PX.b3()])
      %Equal.sym(PX.PT, PX.add(PX.PT{x1, y1, z1}, PX.PT{x2, y2, z2}), I.add_out(I.rrun_go(I.radd_prog(), I.regs7(PX.PT{x1, y1, z1}, PX.PT{x2, y2, z2}))), PB.add_b(PX.PT{x1, y1, z1}, PX.PT{x2, y2, z2})) : {pred(one, _) == True{} : Bool}
      %Equal.sym(List<&2, F.FE>, I.rrun_go(I.radd_prog(), [x1, y1, z1, x2, y2, z2, PX.b3()]), I.rrun(I.radd_prog(), [x1, y1, z1, x2, y2, z2, PX.b3()]), Equal.sym(List<&2, F.FE>, I.rrun(I.radd_prog(), [x1, y1, z1, x2, y2, z2, PX.b3()]), I.rrun_go(I.radd_prog(), [x1, y1, z1, x2, y2, z2, PX.b3()]), run_is(I.radd_prog(), [x1, y1, z1, x2, y2, z2, PX.b3()]))) : {pred(one, I.add_out(_)) == True{} : Bool}
      pr3(one, I.rnth(33n, rs), I.rnth(36n, rs), I.rnth(39n, rs), nth_r(one, h1, 33n, rs, hr), nth_r(one, h1, 36n, rs, hr), nth_r(one, h1, 39n, rs, hr))

def pdbl_r(+one: Nat, +h1: {one == 1n : Nat}, a: PX.PT, +ha: {pred(one, a) == True{} : Bool}) -> {pred(one, PX.dbl(a)) == True{} : Bool}:
  match a:
    case PX.PT{+x, +y, +z}:
      +hr = run_r(one, h1, I.rdbl_prog(), [x, y, z, PX.b3()], regs4_r(one, h1, PX.PT{x, y, z}, ha))
      +rs = I.rrun(I.rdbl_prog(), [x, y, z, PX.b3()])
      %Equal.sym(PX.PT, PX.dbl(PX.PT{x, y, z}), I.dbl_out(I.rrun_go(I.rdbl_prog(), I.regs4(PX.PT{x, y, z}))), PB.dbl_b(PX.PT{x, y, z})) : {pred(one, _) == True{} : Bool}
      %Equal.sym(List<&2, F.FE>, I.rrun_go(I.rdbl_prog(), [x, y, z, PX.b3()]), I.rrun(I.rdbl_prog(), [x, y, z, PX.b3()]), Equal.sym(List<&2, F.FE>, I.rrun(I.rdbl_prog(), [x, y, z, PX.b3()]), I.rrun_go(I.rdbl_prog(), [x, y, z, PX.b3()]), run_is(I.rdbl_prog(), [x, y, z, PX.b3()]))) : {pred(one, I.dbl_out(_)) == True{} : Bool}
      pr3(one, I.rnth(21n, rs), I.rnth(18n, rs), I.rnth(13n, rs), nth_r(one, h1, 21n, rs, hr), nth_r(one, h1, 18n, rs, hr), nth_r(one, h1, 13n, rs, hr))
