def pv(+one: Nat, p: PX.PT) -> CV.SPoint:
  match p:
    case PX.PT{x, y, z}: CV.SPoint{OP.val(one, x), OP.val(one, y), OP.val(one, z)}

def pred(+one: Nat, p: PX.PT) -> Bool:
  match p:
    case PX.PT{x, y, z}: Bool.and(red(one, x), Bool.and(red(one, y), red(one, z)))

def add_prog_eq() -> {cprog(I.radd_prog()) == CV.add_prog() : List<&2, CV.SOp>}:
  {==}

def dbl_prog_eq() -> {cprog(I.rdbl_prog()) == CV.dbl_prog() : List<&2, CV.SOp>}:
