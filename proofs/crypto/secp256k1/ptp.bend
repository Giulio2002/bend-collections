def pr3(+one: Nat, +a: F.FE, +b: F.FE, +c: F.FE, +ha: {red(one, a) == True{} : Bool}, +hb: {red(one, b) == True{} : Bool}, +hc: {red(one, c) == True{} : Bool}) -> {pred(one, PX.PT{a, b, c}) == True{} : Bool}:
  Lg.and_intro(red(one, a), Bool.and(red(one, b), red(one, c)), ha, Lg.and_intro(red(one, b), red(one, c), hb, hc))

def regs7_r(+one: Nat, +h1: {one == 1n : Nat}, p: PX.PT, q: PX.PT, +hp: {pred(one, p) == True{} : Bool}, +hq: {pred(one, q) == True{} : Bool}) -> {allred(one, I.regs7(p, q)) == True{} : Bool}:
  match p q:
    case PX.PT{+x1, +y1, +z1} PX.PT{+x2, +y2, +z2}:
      +hx = Lg.and_left(red(one, x1), Bool.and(red(one, y1), red(one, z1)), hp)
      +hy = Lg.and_left(red(one, y1), red(one, z1), Lg.and_right(red(one, x1), Bool.and(red(one, y1), red(one, z1)), hp))
      +hz = Lg.and_right(red(one, y1), red(one, z1), Lg.and_right(red(one, x1), Bool.and(red(one, y1), red(one, z1)), hp))
      +gx = Lg.and_left(red(one, x2), Bool.and(red(one, y2), red(one, z2)), hq)
      +gy = Lg.and_left(red(one, y2), red(one, z2), Lg.and_right(red(one, x2), Bool.and(red(one, y2), red(one, z2)), hq))
      +gz = Lg.and_right(red(one, y2), red(one, z2), Lg.and_right(red(one, x2), Bool.and(red(one, y2), red(one, z2)), hq))
      Lg.and_intro(red(one, x1), allred(one, [y1, z1, x2, y2, z2, PX.b3()]), hx, Lg.and_intro(red(one, y1), allred(one, [z1, x2, y2, z2, PX.b3()]), hy, Lg.and_intro(red(one, z1), allred(one, [x2, y2, z2, PX.b3()]), hz, Lg.and_intro(red(one, x2), allred(one, [y2, z2, PX.b3()]), gx, Lg.and_intro(red(one, y2), allred(one, [z2, PX.b3()]), gy, Lg.and_intro(red(one, z2), allred(one, [PX.b3()]), gz, Lg.and_intro(red(one, PX.b3()), True{}, b3_r(one, h1), {==})))))))

def regs4_r(+one: Nat, +h1: {one == 1n : Nat}, p: PX.PT, +hp: {pred(one, p) == True{} : Bool}) -> {allred(one, I.regs4(p)) == True{} : Bool}:
  match p:
    case PX.PT{+x, +y, +z}:
      +hx = Lg.and_left(red(one, x), Bool.and(red(one, y), red(one, z)), hp)
      +hy = Lg.and_left(red(one, y), red(one, z), Lg.and_right(red(one, x), Bool.and(red(one, y), red(one, z)), hp))
      +hz = Lg.and_right(red(one, y), red(one, z), Lg.and_right(red(one, x), Bool.and(red(one, y), red(one, z)), hp))
      Lg.and_intro(red(one, x), allred(one, [y, z, PX.b3()]), hx, Lg.and_intro(red(one, y), allred(one, [z, PX.b3()]), hy, Lg.and_intro(red(one, z), allred(one, [PX.b3()]), hz, Lg.and_intro(red(one, PX.b3()), True{}, b3_r(one, h1), {==}))))


# rrun looks at its first register first
def run_is(prog: List<&2, I.ROp>, rs: List<&2, F.FE>) -> {I.rrun(prog, rs) == I.rrun_go(prog, rs) : List<&2, F.FE>}:
  match rs:
    case Nil{}:
      {==}
    case r <> t:
      match r:
        case F.FE{a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15}:
          {==}

def run_r(+one: Nat, +h1: {one == 1n : Nat}, +prog: List<&2, I.ROp>, +rs: List<&2, F.FE>, +h: {allred(one, rs) == True{} : Bool}) -> {allred(one, I.rrun(prog, rs)) == True{} : Bool}:
  %Equal.sym(List<&2, F.FE>, I.rrun(prog, rs), I.rrun_go(prog, rs), run_is(prog, rs)) : {allred(one, _) == True{} : Bool}
  run_go_r(one, h1, prog, rs, h)

def run_v(+one: Nat, +h1: {one == 1n : Nat}, +prog: List<&2, I.ROp>, +rs: List<&2, F.FE>, +h: {allred(one, rs) == True{} : Bool}) -> {vals(one, I.rrun(prog, rs)) == CV.run(FS.prime(one), cprog(prog), vals(one, rs)) : List<&2, Nat>}:
  %Equal.sym(List<&2, F.FE>, I.rrun(prog, rs), I.rrun_go(prog, rs), run_is(prog, rs)) : {vals(one, _) == CV.run(FS.prime(one), cprog(prog), vals(one, rs)) : List<&2, Nat>}
  %Equal.sym(List<&2, Nat>, CV.run(FS.prime(one), cprog(prog), vals(one, rs)), CV.run_go(FS.prime(one), cprog(prog), vals(one, rs)), srun_is(FS.prime(one), cprog(prog), vals(one, rs))) : {vals(one, I.rrun_go(prog, rs)) == _ : List<&2, Nat>}
  run_go_v(one, h1, prog, rs, h)

