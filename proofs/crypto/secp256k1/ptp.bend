  match rs:
    case Nil{}: True{}
    case r <> t: Bool.and(red(one, r), allred(one, t))

def cop(op: I.ROp) -> CV.SOp:
  match op:
    case I.RAdd{i, j}: CV.SAdd{i, j}
    case I.RSub{i, j}: CV.SSub{i, j}
    case I.RMul{i, j}: CV.SMul{i, j}
    case I.RSq{+i}: CV.SMul{i, i}

def cprog(ops: List<&2, I.ROp>) -> List<&2, CV.SOp>:
