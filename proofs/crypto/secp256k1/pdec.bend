def d65r(+one: Nat, +h1: {one == 1n : Nat}, +pre: U32, +rest: List<&2, U32>, +hl: {B.has_len(64n, rest) == True{} : Bool}) -> {PE.mpred(one, P.decode_65(pre, rest)) == True{} : Bool}:
  +hlx = BY.of_be_limbs(one, h1, B.prefix(32n, rest), BL.pl32(rest, hl))
  +hly = BY.of_be_limbs(one, h1, B.suffix(32n, rest), BL.sl32(rest, hl))
  %Equal.sym(Bool, F.lt_p(B.of_be(B.prefix(32n, rest))), Nat.is_lt(FS.value(one, B.of_be(B.prefix(32n, rest))), FS.prime(one)), FW.lt_p_f(one, h1, B.of_be(B.prefix(32n, rest)))) : {PE.mpred(one, P.decode_u(B.of_be(B.prefix(32n, rest)), B.of_be(B.suffix(32n, rest)), Bool.and(Bool.and(U32.is_eq(pre, 4), Bool.and(_, F.lt_p(B.of_be(B.suffix(32n, rest))))), P.on_curve(B.of_be(B.prefix(32n, rest)), B.of_be(B.suffix(32n, rest)))))) == True{} : Bool}
  %Equal.sym(Bool, F.lt_p(B.of_be(B.suffix(32n, rest))), Nat.is_lt(FS.value(one, B.of_be(B.suffix(32n, rest))), FS.prime(one)), FW.lt_p_f(one, h1, B.of_be(B.suffix(32n, rest)))) : {PE.mpred(one, P.decode_u(B.of_be(B.prefix(32n, rest)), B.of_be(B.suffix(32n, rest)), Bool.and(Bool.and(U32.is_eq(pre, 4), Bool.and(Nat.is_lt(FS.value(one, B.of_be(B.prefix(32n, rest))), FS.prime(one)), _)), P.on_curve(B.of_be(B.prefix(32n, rest)), B.of_be(B.suffix(32n, rest)))))) == True{} : Bool}
  dur(one, h1, B.of_be(B.prefix(32n, rest)), B.of_be(B.suffix(32n, rest)), hlx, hly, U32.is_eq(pre, 4), Nat.is_lt(FS.value(one, B.of_be(B.prefix(32n, rest))), FS.prime(one)), Nat.is_lt(FS.value(one, B.of_be(B.suffix(32n, rest))), FS.prime(one)), {==}, {==})

# ---- decode ----

def dl(+one: Nat, +h1: {one == 1n : Nat}, +bs: List<&2, U32>, c33: Bool, c65: Bool, +h33: {B.has_len(33n, bs) == c33 : Bool}, +h65: {B.has_len(65n, bs) == c65 : Bool}) -> {PE.mpv(one, P.decode_len(bs, c33, c65)) == CV.decode_len(FS.prime(one), bs, c33, c65) : Maybe<&2, CV.SPoint>}:
  match c33 c65:
    case True{} _:
      %Equal.sym(U32, B.head(bs), CV.head(bs), BL.head_eq(bs)) : {PE.mpv(one, P.decode_33(_, B.tail(bs))) == CV.decode_c(FS.prime(one), CV.head(bs), CV.os2ip(CV.after(1n, bs))) : Maybe<&2, CV.SPoint>}
      %Equal.sym(List<&2, U32>, B.tail(bs), CV.after(1n, bs), BL.tail_after(bs)) : {PE.mpv(one, P.decode_33(CV.head(bs), _)) == CV.decode_c(FS.prime(one), CV.head(bs), CV.os2ip(CV.after(1n, bs))) : Maybe<&2, CV.SPoint>}
      d33(one, h1, CV.head(bs), CV.after(1n, bs), BL.len_tail(32n, bs, h33))
    case False{} True{}:
      %Equal.sym(U32, B.head(bs), CV.head(bs), BL.head_eq(bs)) : {PE.mpv(one, P.decode_65(_, B.tail(bs))) == CV.decode_u(FS.prime(one), CV.head(bs), CV.os2ip(CV.first(32n, CV.after(1n, bs))), CV.os2ip(CV.after(33n, bs))) : Maybe<&2, CV.SPoint>}
      %Equal.sym(List<&2, U32>, B.tail(bs), CV.after(1n, bs), BL.tail_after(bs)) : {PE.mpv(one, P.decode_65(CV.head(bs), _)) == CV.decode_u(FS.prime(one), CV.head(bs), CV.os2ip(CV.first(32n, CV.after(1n, bs))), CV.os2ip(CV.after(33n, bs))) : Maybe<&2, CV.SPoint>}
      %Equal.sym(List<&2, U32>, CV.after(33n, bs), CV.after(32n, CV.after(1n, bs)), BL.after33(bs)) : {PE.mpv(one, P.decode_65(CV.head(bs), CV.after(1n, bs))) == CV.decode_u(FS.prime(one), CV.head(bs), CV.os2ip(CV.first(32n, CV.after(1n, bs))), CV.os2ip(_)) : Maybe<&2, CV.SPoint>}
      d65(one, h1, CV.head(bs), CV.after(1n, bs), BL.len_tail(64n, bs, h65))
    case False{} False{}:
      {==}

def dlr(+one: Nat, +h1: {one == 1n : Nat}, +bs: List<&2, U32>, c33: Bool, c65: Bool, +h33: {B.has_len(33n, bs) == c33 : Bool}, +h65: {B.has_len(65n, bs) == c65 : Bool}) -> {PE.mpred(one, P.decode_len(bs, c33, c65)) == True{} : Bool}:
  match c33 c65:
    case True{} _:
      %Equal.sym(List<&2, U32>, B.tail(bs), CV.after(1n, bs), BL.tail_after(bs)) : {PE.mpred(one, P.decode_33(B.head(bs), _)) == True{} : Bool}
      d33r(one, h1, B.head(bs), CV.after(1n, bs), BL.len_tail(32n, bs, h33))
    case False{} True{}:
      %Equal.sym(List<&2, U32>, B.tail(bs), CV.after(1n, bs), BL.tail_after(bs)) : {PE.mpred(one, P.decode_65(B.head(bs), _)) == True{} : Bool}
      d65r(one, h1, B.head(bs), CV.after(1n, bs), BL.len_tail(64n, bs, h65))
    case False{} False{}:
      {==}

def decode_v(+one: Nat, +h1: {one == 1n : Nat}, +bs: List<&2, U32>) -> {PE.mpv(one, P.decode(bs)) == CV.decode(FS.prime(one), bs) : Maybe<&2, CV.SPoint>}:
  %Equal.sym(Bool, B.has_len(33n, bs), CV.length_is(33n, bs), BL.hl_is(33n, bs)) : {PE.mpv(one, P.decode_len(bs, _, B.has_len(65n, bs))) == CV.decode_len(FS.prime(one), bs, CV.length_is(33n, bs), CV.length_is(65n, bs)) : Maybe<&2, CV.SPoint>}
  %Equal.sym(Bool, B.has_len(65n, bs), CV.length_is(65n, bs), BL.hl_is(65n, bs)) : {PE.mpv(one, P.decode_len(bs, CV.length_is(33n, bs), _)) == CV.decode_len(FS.prime(one), bs, CV.length_is(33n, bs), CV.length_is(65n, bs)) : Maybe<&2, CV.SPoint>}
  dl(one, h1, bs, CV.length_is(33n, bs), CV.length_is(65n, bs), BL.hl_is(33n, bs), BL.hl_is(65n, bs))

def decode_r(+one: Nat, +h1: {one == 1n : Nat}, +bs: List<&2, U32>) -> {PE.mpred(one, P.decode(bs)) == True{} : Bool}:
  dlr(one, h1, bs, B.has_len(33n, bs), B.has_len(65n, bs), {==}, {==})
