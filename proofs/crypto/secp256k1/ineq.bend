  Lg.subst(Nat, z => {Nat.is_le(z, c) == True{} : Bool}, a, b, e, h)

def lt_subst_r(+a: Nat, +b: Nat, +c: Nat, +e: {b == c : Nat}, +h: {Nat.is_lt(a, b) == True{} : Bool}) -> {Nat.is_lt(a, c) == True{} : Bool}:
  Lg.subst(Nat, z => {Nat.is_lt(a, z) == True{} : Bool}, b, c, e, h)

def lt_subst_l(+a: Nat, +b: Nat, +c: Nat, +e: {a == b : Nat}, +h: {Nat.is_lt(a, c) == True{} : Bool}) -> {Nat.is_lt(b, c) == True{} : Bool}:
