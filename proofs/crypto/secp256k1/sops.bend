# spec/crypto/secp256k1/field.bend: on reduced inputs (16 limbs below 2^16,
# value below n) the product and the square are reduced, of the specified
# value. The reduction is limbs.bend's L.reduce(c, 4n, xs) (sval.bend),
# whose value reducek.bend proves.

def sred(+one: Nat, +a: FE.FE) -> Bool:
  FS.reduced(one, FS.order(one), FE.to_list(a))

def sval(+one: Nat, +a: FE.FE) -> Nat:
  FS.value(one, FE.to_list(a))

