def l16(+one: Nat, +x: List<&2, Nat>, +h: {PT.red(one, x) == True{} : Bool}) -> {FS.limbs16(one, 16n, x) == True{} : Bool}:
  Lg.and_left(FS.limbs16(one, 16n, x), Nat.is_lt(FS.value(one, x), FS.prime(one)), h)

def rx(+one: Nat, +x: List<&2, Nat>, +y: List<&2, Nat>, +z: List<&2, Nat>, +h: {PT.pred(one, P.Point{x, y, z}) == True{} : Bool}) -> {FS.limbs16(one, 16n, x) == True{} : Bool}:
