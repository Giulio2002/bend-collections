# Selection (b ? p : q, b in {0, 1}) and small facts for the point proofs.
def bit01(n: Nat) -> {Nat.is_lt(C.bit(n), 2n) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n:
      {==}
    case 2n+m:
      bit01(m)

def sb01(i: Nat, +off: Nat, +k: Nat) -> {BV.all01(BR.sb(i, off, k)) == True{} : Bool}:
  match i:
    case 0n:
      {==}
    case 1n+ +j:
      Lg.and_intro(Nat.is_lt(CV.bit(Nat.add(off, j), k), 2n), BV.all01(BR.sb(j, off, k)), bit01(C.high(Nat.add(off, j), k)), sb01(j, off, k))

