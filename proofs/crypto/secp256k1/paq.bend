# 1 / z = 0 for z = 0 (mod m)
def inv0(mp: Nat, +z: Nat, +hz: {Nat.mod(z, 1n+mp) == 0n : Nat}, +hm: {Nat.is_lt(1n, mp) == True{} : Bool}) -> {FS.minv(1n+mp, z) == 0n : Nat}:
  match mp:
    case 0n:
      Empty.absurd({FS.minv(1n, z) == 0n : Nat}, Lg.false_true(hm))
    case 1n:
      Empty.absurd({FS.minv(2n, z) == 0n : Nat}, Lg.false_true(hm))
    case 2n+ +k:
      F.z_mul_l(2n+k, z, Nat.pow(z, k), hz)

