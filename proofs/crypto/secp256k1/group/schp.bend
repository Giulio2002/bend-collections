# Sign(sk, m, a) == sig and PubKey(sk) == pk: Verify(pk, m, sig)
def sign_verify(+one: Nat, +sk: List<&2, U32>, +m: List<&2, U32>, +aux: List<&2, U32>, +sig: List<&2, U32>, +pk: List<&2, U32>, +hpk: {SS.pubkey(one, sk) == Some{pk} : Maybe<&2, List<&2, U32>>}, +hs: {SS.sign(one, sk, m, aux) == Some{sig} : Maybe<&2, List<&2, U32>>}) -> {SS.verify(one, pk, m, sig) == True{} : Bool}:
  sv1(one, sk, m, aux, sig, pk, hpk, hs, Bool.and(CS.length_is(32n, aux), SS.secret_ok(one, sk)), {==})

def sn_c(+one: Nat, +h1: {one == 1n : Nat}, +hp: PM.Prime(FS.prime(one)), +hc: {Nat.is_eq(FS.mpow(FS.prime(one), Nat.sub(FS.prime(one), 7n), Nat.div(Nat.sub(FS.prime(one), 1n), 3n)), 1n) == False{} : Bool}, +hq: PM.Prime(FS.order(one)), +hg: {GS.valid(FS.prime(one), CS.g(one)) == True{} : Bool}, +hng: {GS.equiv(FS.prime(one), GS.smul(FS.prime(one), FS.order(one), CS.g(one)), CS.infinity()) == True{} : Bool}, +sk: List<&2, U32>, +m: List<&2, U32>, +aux: List<&2, U32>, +hla: {CS.length_is(32n, aux) == True{} : Bool}, +hso: {SS.secret_ok(one, sk) == True{} : Bool}, +hs: {SS.sign(one, sk, m, aux) == None{} : Maybe<&2, List<&2, U32>>}, c: Bool, +hcc: {Nat.is_eq(D.nonce(one, sk, m, aux), 0n) == c : Bool}) -> {Nat.is_eq(D.nonce(one, sk, m, aux), 0n) == True{} : Bool}:
  match c:
    case True{}:
      hcc
    case False{}:
      Empty.absurd({Nat.is_eq(D.nonce(one, sk, m, aux), 0n) == True{} : Bool}, Lg.none_some(List<&2, U32>, D.sigv(one, sk, m, aux), Equal.trans(Maybe<&2, List<&2, U32>>, None{}, SS.sign(one, sk, m, aux), Some{D.sigv(one, sk, m, aux)}, Equal.sym(Maybe<&2, List<&2, U32>>, SS.sign(one, sk, m, aux), None{}, hs), signs(one, h1, hp, hc, hq, hg, hng, sk, m, aux, hla, hso, hcc))))

# Sign fails (for a valid key and 32 bytes of aux) only when the nonce is 0
def sign_none(+one: Nat, +h1: {one == 1n : Nat}, +hp: PM.Prime(FS.prime(one)), +hc: {Nat.is_eq(FS.mpow(FS.prime(one), Nat.sub(FS.prime(one), 7n), Nat.div(Nat.sub(FS.prime(one), 1n), 3n)), 1n) == False{} : Bool}, +hq: PM.Prime(FS.order(one)), +hg: {GS.valid(FS.prime(one), CS.g(one)) == True{} : Bool}, +hng: {GS.equiv(FS.prime(one), GS.smul(FS.prime(one), FS.order(one), CS.g(one)), CS.infinity()) == True{} : Bool}, +sk: List<&2, U32>, +m: List<&2, U32>, +aux: List<&2, U32>, +hla: {CS.length_is(32n, aux) == True{} : Bool}, +hso: {SS.secret_ok(one, sk) == True{} : Bool}, +hs: {SS.sign(one, sk, m, aux) == None{} : Maybe<&2, List<&2, U32>>}) -> {Nat.is_eq(D.nonce(one, sk, m, aux), 0n) == True{} : Bool}:
  sn_c(one, h1, hp, hc, hq, hg, hng, sk, m, aux, hla, hso, hs, Nat.is_eq(D.nonce(one, sk, m, aux), 0n), {==})
