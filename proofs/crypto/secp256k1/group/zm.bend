# Congruences modulo m = 1 + mp, and the relation between a residue r and
# a difference P - N of natural numbers: Rel(mp, r, P, N) says
# r + N == P (mod m). The spec's madd, msub and mmul of residues are the
# sum, difference and product of the differences.

def Rel(+mp: Nat, +r: Nat, +p: Nat, +n: Nat) -> Data:
  {Nat.mod(Nat.add(r, n), 1n+mp) == Nat.mod(p, 1n+mp) : Nat}

# a - b == c - d (mod m)
def SameM(+mp: Nat, +a: Nat, +b: Nat, +c: Nat, +d: Nat) -> Data:
  {Nat.mod(Nat.add(a, d), 1n+mp) == Nat.mod(Nat.add(c, b), 1n+mp) : Nat}

