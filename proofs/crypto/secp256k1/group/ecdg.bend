  %Equal.sym(CS.SAffine, CS.to_affine(1n+mp, rr), CS.to_affine(1n+mp, kp), w_ta(mp, hp, rr, kp, vrr, vkp, nr, nk, G2.e_trans(mp, hp, rr, GS.smul(1n+mp, k, g), kp, G4.v_smul(mp, hp, h3, hnc, h21, k, g, vg), hrr, G2.e_sym(mp, kp, GS.smul(1n+mp, k, g), hkp)))) : {Nat.is_eq(Nat.mod(CS.aff_x(_), 1n+nm), Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm)) == True{} : Bool}
  N.is_eq_refl(Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm))

# R equiv [-k] g: the same
def rr_neg(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +nm: Nat, +hq: PM.Prime(1n+nm), +g: CS.SPoint, +vg: {GS.valid(1n+mp, g) == True{} : Bool}, +hng: {GS.equiv(1n+mp, GS.smul(1n+mp, 1n+nm, g), CS.infinity()) == True{} : Bool}, +hgo: {GS.equiv(1n+mp, g, CS.infinity()) == False{} : Bool}, +rr: CS.SPoint, +kp: CS.SPoint, +k: Nat, +nzk: F.NZ(nm, k), +vkp: {GS.valid(1n+mp, kp) == True{} : Bool}, +hkp: {GS.equiv(1n+mp, kp, GS.smul(1n+mp, k, g)) == True{} : Bool}, +vrr: {GS.valid(1n+mp, rr) == True{} : Bool}, +hrr: {GS.equiv(1n+mp, rr, GS.smul(1n+mp, FS.msub(1n+nm, 0n, k), g)) == True{} : Bool}) -> {Bool.and(Bool.not(CS.is_inf(rr)), Nat.is_eq(Nat.mod(CS.aff_x(CS.to_affine(1n+mp, rr)), 1n+nm), Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm))) == True{} : Bool}:
  +nk = knz(mp, hp, h3, hnc, h21, nm, hq, g, vg, hng, hgo, kp, k, nzk, vkp, hkp)
  +vsk = G4.v_smul(mp, hp, h3, hnc, h21, k, g, vg)
  +vnk = G2.v_neg(mp, kp, vkp)
  +hn = G2.e_trans(mp, hp, rr, GS.smul(1n+mp, FS.msub(1n+nm, 0n, k), g), GS.neg(1n+mp, kp), G4.v_smul(mp, hp, h3, hnc, h21, FS.msub(1n+nm, 0n, k), g, vg), hrr, G2.e_trans(mp, hp, GS.smul(1n+mp, FS.msub(1n+nm, 0n, k), g), GS.neg(1n+mp, GS.smul(1n+mp, k, g)), GS.neg(1n+mp, kp), G2.v_neg(mp, GS.smul(1n+mp, k, g), vsk), negk(mp, hp, h3, hnc, h21, nm, hq, g, vg, hng, hgo, k), G5.e_neg(mp, GS.smul(1n+mp, k, g), kp, G2.e_sym(mp, kp, GS.smul(1n+mp, k, g), hkp))))
  +nn = w_negz(mp, kp, nk)
  +nr = w_nz(mp, hp, GS.neg(1n+mp, kp), rr, vrr, nn, G2.e_sym(mp, rr, GS.neg(1n+mp, kp), hn))
  %Equal.sym(Bool, CS.is_inf(rr), False{}, w_inf(mp, rr, nr)) : {Bool.and(Bool.not(_), Nat.is_eq(Nat.mod(CS.aff_x(CS.to_affine(1n+mp, rr)), 1n+nm), Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm))) == True{} : Bool}
  %Equal.sym(CS.SAffine, CS.to_affine(1n+mp, rr), CS.to_affine(1n+mp, GS.neg(1n+mp, kp)), w_ta(mp, hp, rr, GS.neg(1n+mp, kp), vrr, vnk, nr, nn, hn)) : {Nat.is_eq(Nat.mod(CS.aff_x(_), 1n+nm), Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm)) == True{} : Bool}
  %Equal.sym(Nat, CS.aff_x(CS.to_affine(1n+mp, GS.neg(1n+mp, kp))), CS.aff_x(CS.to_affine(1n+mp, kp)), w_negx(mp, kp)) : {Nat.is_eq(Nat.mod(_, 1n+nm), Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm)) == True{} : Bool}
  N.is_eq_refl(Nat.mod(CS.aff_x(CS.to_affine(1n+mp, kp)), 1n+nm))
