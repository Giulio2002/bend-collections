# Points of the group with the same affine point are equiv (the converse of
# A1.aff_eqv). Modulus m = 1 + mp, prime (hp), 21 < m (h21).

def ax(a: GA.APoint) -> Nat:
  match a:
    case GA.AInf{}:
      0n
    case GA.APt{x, y}:
      x

def ay(a: GA.APoint) -> Nat:
