# The specification's register programs (curve.bend: add_prog, dbl_prog are
# data) run on polynomials: srun is CS.run_go with the sum, difference and
# product of poly.bend. If the input polynomials have the values of the
# input registers (Agree), every register of the specification's run has
# the value of its polynomial, modulo m = 1 + mp.

def snth(i: Nat, regs: List<&2, List<&2, P.Tm>>) -> List<&2, P.Tm>:
  match i regs:
    case _ Nil{}:
      Nil{}
    case 0n r <> t:
      r
    case 1n+k r <> t:
      snth(k, t)

def sexec(op: CS.SOp, +regs: List<&2, List<&2, P.Tm>>) -> List<&2, P.Tm>:
  match op:
    case CS.SAdd{i, j}:
      P.padd(snth(i, regs), snth(j, regs))
    case CS.SSub{i, j}:
      P.psub(snth(i, regs), snth(j, regs))
    case CS.SMul{i, j}:
      P.pmul(snth(i, regs), snth(j, regs))

def srun(prog: List<&2, CS.SOp>, +regs: List<&2, List<&2, P.Tm>>) -> List<&2, List<&2, P.Tm>>:
  match prog:
    case Nil{}:
      regs
    case op <> t:
      srun(t, List.append(&2, List<&2, P.Tm>, regs, [sexec(op, regs)]))

