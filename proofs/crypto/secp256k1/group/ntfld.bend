# Fermat: a^(p-1) == 1 (mod p) when p does not divide a
def flt1(p: Nat, +hp: PM.Prime(p), +a: Nat, +ha: {Nat.is_eq(Nat.mod(a, p), 0n) == False{} : Bool}) -> {Nat.mod(Nat.pow(a, Nat.sub(p, 1n)), p) == 1n : Nat}:
  match p:
    case 0n:
      Empty.absurd({Nat.mod(Nat.pow(a, Nat.sub(0n, 1n)), 0n) == 1n : Nat}, Lg.false_true(hp))
    case 1n:
      Empty.absurd({Nat.mod(Nat.pow(a, Nat.sub(1n, 1n)), 1n) == 1n : Nat}, Lg.false_true(hp))
    case 2n+ +pp:
      flt1_s(pp, hp, a, ha)

# a a^(p-2) == 1 (mod p)
def inv_pow(p: Nat, +hp: PM.Prime(p), +a: Nat, +ha: {Nat.is_eq(Nat.mod(a, p), 0n) == False{} : Bool}) -> {Nat.mod(Nat.mul(a, Nat.pow(a, Nat.sub(p, 2n))), p) == 1n : Nat}:
  match p:
    case 0n:
      Empty.absurd({Nat.mod(Nat.mul(a, Nat.pow(a, Nat.sub(0n, 2n))), 0n) == 1n : Nat}, Lg.false_true(hp))
    case 1n:
      Empty.absurd({Nat.mod(Nat.mul(a, Nat.pow(a, Nat.sub(1n, 2n))), 1n) == 1n : Nat}, Lg.false_true(hp))
    case 2n+ +pp:
      %Equal.sym(Nat, Nat.sub(pp, 0n), pp, N.sub_zero(pp)) : {Nat.mod(Nat.mul(a, Nat.pow(a, _)), 2n+pp) == 1n : Nat}
      flt1_s(pp, hp, a, ha)

# the specification's inverse: a * minv(a) == 1 in GF(p)
def minv_ok(p: Nat, +hp: PM.Prime(p), +a: Nat, +ha: {Nat.is_eq(Nat.mod(a, p), 0n) == False{} : Bool}) -> {FS.mmul(p, a, FS.minv(p, a)) == 1n : Nat}:
