    case 0n:
      Empty.absurd({FS.mmul(0n, a, FS.minv(0n, a)) == 1n : Nat}, Lg.false_true(hp))
    case 1n:
      Empty.absurd({FS.mmul(1n, a, FS.minv(1n, a)) == 1n : Nat}, Lg.false_true(hp))
    case 2n+ +pp:
      %Equal.sym(Nat, Nat.sub(pp, 0n), pp, N.sub_zero(pp)) : {Nat.mod(Nat.mul(a, Nat.mod(Nat.pow(a, _), 2n+pp)), 2n+pp) == 1n : Nat}
