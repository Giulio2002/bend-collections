# cancellation: a x == a y (mod p), p not dividing a, gives x == y (mod p)
def mul_cancel(p: Nat, +hp: PM.Prime(p), +a: Nat, +ha: {Nat.is_eq(Nat.mod(a, p), 0n) == False{} : Bool}, +x: Nat, +y: Nat, +h: {Nat.mod(Nat.mul(a, x), p) == Nat.mod(Nat.mul(a, y), p) : Nat}) -> {Nat.mod(x, p) == Nat.mod(y, p) : Nat}:
  match p:
    case 0n:
      Empty.absurd({Nat.mod(x, 0n) == Nat.mod(y, 0n) : Nat}, Lg.false_true(hp))
    case 1n:
      Empty.absurd({Nat.mod(x, 1n) == Nat.mod(y, 1n) : Nat}, Lg.false_true(hp))
    case 2n+ +pp:
      cancel2(pp, hp, a, ha, x, y, h)

# no zero divisors   (Euclid's lemma)
def no_zero_div(p: Nat, +hp: PM.Prime(p), +a: Nat, +b: Nat, +hab: {Nat.mod(Nat.mul(a, b), p) == 0n : Nat}, +ha: {Nat.is_eq(Nat.mod(a, p), 0n) == False{} : Bool}) -> {Nat.mod(b, p) == 0n : Nat}:
  PM.euclid(p, hp, a, b, hab, ha)

def one_mod2(+pp: Nat) -> {Nat.mod(1n, 2n+pp) == 1n : Nat}:
  NR.mod_of(0n, 1n+pp, 1n, {==})

# a^(p-1) == 1 (mod p), p = 2 + pp
def flt1_s(+pp: Nat, +hp: PM.Prime(2n+pp), +a: Nat, +ha: {Nat.is_eq(Nat.mod(a, 2n+pp), 0n) == False{} : Bool}) -> {Nat.mod(Nat.pow(a, 1n+pp), 2n+pp) == 1n : Nat}:
