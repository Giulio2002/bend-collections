    case 1n+ +i:
      +eqn = Equal.trans(Nat, 1n+Nat.add(dq, i), 1n+Nat.add(i, dq), nq, Equal.cong(Nat, Nat, z => 1n+z, Nat.add(dq, i), Nat.add(i, dq), NA.add_comm(dq, i)), hb)
      +hlt = Equal.trans(Bool, Nat.is_lt(dq, nq), Nat.is_lt(dq, 1n+Nat.add(dq, i)), True{}, Equal.cong(Nat, Bool, z => Nat.is_lt(dq, z), nq, 1n+Nat.add(dq, i), Equal.sym(Nat, 1n+Nat.add(dq, i), nq, eqn)), N.le_lt_succ(dq, Nat.add(dq, i), N.le_add_right(dq, i)))
      Lg.and_intro(Bool.not(Nat.is_eq(Nat.mod(2n+nq, 2n+dq), 0n)), SN.nodiv(i, 2n+nq, 3n+dq), Lg.not_false(Nat.is_eq(Nat.mod(2n+nq, 2n+dq), 0n), ndiv(nq, es, hc, hf, dq, hlt, Nat.is_eq(Nat.mod(2n+nq, 2n+dq), 0n), {==})), nd_all(i, nq, es, hc, hf, 1n+dq, Equal.trans(Nat, Nat.add(i, 1n+dq), 1n+Nat.add(i, dq), nq, NA.add_succ(i, dq), hb)))

def pock_s(+nq: Nat, +es: List<&2, PE>, +hc: Cert(2n+nq, es), +hf: {Nat.is_le(2n+nq, Nat.mul(fprod(es), fprod(es))) == True{} : Bool}) -> PM.Prime(2n+nq):
  nd_all(nq, nq, es, hc, hf, 0n, NA.add_zero(nq))

# Pocklington: a certificate for N = 2 + nq with N <= F F makes N prime
def pocklington(+n: Nat, +nq: Nat, +hn: {n == 2n+nq : Nat}, +es: List<&2, PE>, +hc: Cert(n, es), +hf: {Nat.is_le(n, Nat.mul(fprod(es), fprod(es))) == True{} : Bool}) -> PM.Prime(n):
  Equal.trans(Bool, SN.prime(n), SN.prime(2n+nq), True{}, Equal.cong(Nat, Bool, z => SN.prime(z), n, 2n+nq, hn),
    pock_s(nq, es,
      Equal.trans(Bool, cert_ok(2n+nq, es), cert_ok(n, es), True{}, Equal.cong(Nat, Bool, z => cert_ok(z, es), 2n+nq, n, Equal.sym(Nat, n, 2n+nq, hn)), hc),
      Equal.trans(Bool, Nat.is_le(2n+nq, Nat.mul(fprod(es), fprod(es))), Nat.is_le(n, Nat.mul(fprod(es), fprod(es))), True{}, Equal.cong(Nat, Bool, z => Nat.is_le(z, Nat.mul(fprod(es), fprod(es))), 2n+nq, n, Equal.sym(Nat, n, 2n+nq, hn)), hf)))
