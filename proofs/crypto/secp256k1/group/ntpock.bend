    Lg.and_intro(SN.prime(q), Bool.and(c2(n, q, m), Bool.and(c3(n, q, m, a), Bool.and(c4(n, m, a, b), Bool.and(c5(n, b, u, v), c6(fprod(t), q))))), hq,
      Lg.and_intro(c2(n, q, m), Bool.and(c3(n, q, m, a), Bool.and(c4(n, m, a, b), Bool.and(c5(n, b, u, v), c6(fprod(t), q)))), iseq(n, Nat.add(Nat.mul(q, m), 1n), e2),
        Lg.and_intro(c3(n, q, m, a), Bool.and(c4(n, m, a, b), Bool.and(c5(n, b, u, v), c6(fprod(t), q))), iseq(Nat.mod(Nat.pow(a, Nat.mul(q, m)), n), 1n, e3),
          Lg.and_intro(c4(n, m, a, b), Bool.and(c5(n, b, u, v), c6(fprod(t), q)), iseq(Nat.mod(Nat.pow(a, m), n), b, e4),
