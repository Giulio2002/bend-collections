def fbound(+es: List<&2, PE>, +nq: Nat, +hc: Cert(2n+nq, es), +rr: Nat, +k: Nat, +hr: PM.Prime(2n+rr), +e: {2n+nq == Nat.mul(k, 2n+rr) : Nat}) -> {Nat.is_le(fprod(es), 1n+rr) == True{} : Bool}:
