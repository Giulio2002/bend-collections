# Pocklington's criterion with a squarefree factored part (Pocklington 1914;
# Brillhart, Lehmer and Selfridge 1975, Theorem 4 with F squarefree).
#
# A certificate for N is a list of entries PE{q, m, a, b, u, v}, one per
# prime q of the factored part F = the product of the q's, each saying
#   q is prime,  N == q m + 1,  a^(q m) mod N == 1,  a^m mod N == b,
#   u (b - 1) == v N + 1  (so gcd(a^((N-1)/q) - 1, N) == 1),
#   q does not divide the product of the entries after it (the q's are
#   distinct primes).
# Then every prime factor r of N is 1 mod F (ntord.bend's step for each q,
# and distinct primes dividing r - 1 divide it together), so r > F; with
# N <= F F, N has no factor d in [2, N): the smaller of d and N / d is at
# most F and has a prime factor (ntmf.bend), which is a prime factor of N.
#
# Cert(N, es) is one Bool equation (Data, so it can be used many times);
# cert_nil and cert_cons build it from the equations, which a closed
# computation can supply; nothing here evaluates a power.

type PE is Data:
  PE{q: Nat, m: Nat, a: Nat, b: Nat, u: Nat, v: Nat}

def c2(+n: Nat, +q: Nat, +m: Nat) -> Bool:
  Nat.is_eq(n, Nat.add(Nat.mul(q, m), 1n))

def c3(+n: Nat, +q: Nat, +m: Nat, +a: Nat) -> Bool:
  Nat.is_eq(Nat.mod(Nat.pow(a, Nat.mul(q, m)), n), 1n)

def c4(+n: Nat, +m: Nat, +a: Nat, +b: Nat) -> Bool:
  Nat.is_eq(Nat.mod(Nat.pow(a, m), n), b)

def c5(+n: Nat, +b: Nat, +u: Nat, +v: Nat) -> Bool:
  Nat.is_eq(Nat.mul(u, Nat.sub(b, 1n)), Nat.add(Nat.mul(v, n), 1n))

def c6(+f0: Nat, +q: Nat) -> Bool:
  Bool.not(Nat.is_eq(Nat.mod(f0, q), 0n))

def ent_ok(+n: Nat, e: PE, +f0: Nat) -> Bool:
  match e:
    case PE{+q, +m, +a, +b, +u, +v}:
      Bool.and(SN.prime(q), Bool.and(c2(n, q, m), Bool.and(c3(n, q, m, a), Bool.and(c4(n, m, a, b), Bool.and(c5(n, b, u, v), c6(f0, q))))))

# the factored part: the product of the q's
def fprod(es: List<&2, PE>) -> Nat:
  match es:
    case Nil{}:
      1n
    case PE{q, m, a, b, u, v} <> t:
      Nat.mul(q, fprod(t))

def cert_ok(+n: Nat, es: List<&2, PE>) -> Bool:
  match es:
    case Nil{}:
      True{}
    case +e <> +t:
      Bool.and(ent_ok(n, e, fprod(t)), cert_ok(n, t))

def Cert(+n: Nat, +es: List<&2, PE>) -> Data:
  {cert_ok(n, es) == True{} : Bool}

# ---- building a certificate ----

def iseq(+x: Nat, +y: Nat, +e: {x == y : Nat}) -> {Nat.is_eq(x, y) == True{} : Bool}:
  Equal.trans(Bool, Nat.is_eq(x, y), Nat.is_eq(x, x), True{}, Equal.cong(Nat, Bool, z => Nat.is_eq(x, z), y, x, Equal.sym(Nat, x, y, e)), N.is_eq_refl(x))

def cert_nil(+n: Nat) -> Cert(n, Nil{}):
  {==}

def cert_cons(+n: Nat, +q: Nat, +m: Nat, +a: Nat, +b: Nat, +u: Nat, +v: Nat, +t: List<&2, PE>, +hq: PM.Prime(q), +e2: {n == Nat.add(Nat.mul(q, m), 1n) : Nat}, +e3: {Nat.mod(Nat.pow(a, Nat.mul(q, m)), n) == 1n : Nat}, +e4: {Nat.mod(Nat.pow(a, m), n) == b : Nat}, +e5: {Nat.mul(u, Nat.sub(b, 1n)) == Nat.add(Nat.mul(v, n), 1n) : Nat}, +e6: {Nat.is_eq(Nat.mod(fprod(t), q), 0n) == False{} : Bool}, +ht: Cert(n, t)) -> Cert(n, PE{q, m, a, b, u, v} <> t):
