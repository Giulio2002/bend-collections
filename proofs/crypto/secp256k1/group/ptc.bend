  %X.bo(one, h1, y) : {CS.SPoint{X.bvalo(one, x), X.bvalo(one, y), X.bvalo(one, z)} == CS.SPoint{X.bvalo(one, x), _, B.bval(z)} : CS.SPoint}
  %X.bo(one, h1, z) : {CS.SPoint{X.bvalo(one, x), X.bvalo(one, y), X.bvalo(one, z)} == CS.SPoint{X.bvalo(one, x), X.bvalo(one, y), _} : CS.SPoint}
  {==}

def beq3(a: M.BP, b: M.BP) -> Bool:
  match a b:
    case M.BP{x1, y1, z1} M.BP{x2, y2, z2}:
      Bool.and(B.beq(x1, x2), Bool.and(B.beq(y1, y2), B.beq(z1, z2)))

def beq3_v(a: M.BP, b: M.BP, +h: {beq3(a, b) == True{} : Bool}) -> {M.spv(a) == M.spv(b) : CS.SPoint}:
  match a b:
    case M.BP{+x1, +y1, +z1} M.BP{+x2, +y2, +z2}:
      %Equal.sym(Nat, B.bval(x1), B.bval(x2), B.beq_v(x1, x2, Lg.and_left(B.beq(x1, x2), Bool.and(B.beq(y1, y2), B.beq(z1, z2)), h))) : {CS.SPoint{_, B.bval(y1), B.bval(z1)} == CS.SPoint{B.bval(x2), B.bval(y2), B.bval(z2)} : CS.SPoint}
      %Equal.sym(Nat, B.bval(y1), B.bval(y2), B.beq_v(y1, y2, Lg.and_left(B.beq(y1, y2), B.beq(z1, z2), Lg.and_right(B.beq(x1, x2), Bool.and(B.beq(y1, y2), B.beq(z1, z2)), h)))) : {CS.SPoint{B.bval(x2), _, B.bval(z1)} == CS.SPoint{B.bval(x2), B.bval(y2), B.bval(z2)} : CS.SPoint}
      %Equal.sym(Nat, B.bval(z1), B.bval(z2), B.beq_v(z1, z2, Lg.and_right(B.beq(y1, y2), B.beq(z1, z2), Lg.and_right(B.beq(x1, x2), Bool.and(B.beq(y1, y2), B.beq(z1, z2)), h)))) : {CS.SPoint{B.bval(x2), B.bval(y2), _} == CS.SPoint{B.bval(x2), B.bval(y2), B.bval(z2)} : CS.SPoint}
      {==}

# the result of a loop: every check passed and the point is e
def fck(r: M.RP, +e: M.BP) -> Bool:
  match r:
    case M.RP{pt, ok}:
      Bool.and(ok, beq3(pt, e))

def fck_ok(r: M.RP, +e: M.BP, +h: {fck(r, e) == True{} : Bool}) -> {M.rpk(r) == True{} : Bool}:
  match r:
    case M.RP{+pt, +ok}:
      Lg.and_left(ok, beq3(pt, e), h)

def fck_eq(r: M.RP, +e: M.BP, +h: {fck(r, e) == True{} : Bool}) -> {beq3(M.rpp(r), e) == True{} : Bool}:
  match r:
    case M.RP{+pt, +ok}:
      Lg.and_right(ok, beq3(pt, e), h)

