# Identities by reflection: residues a and b with polynomials sa and sb
# (Z.Rel) are equal modulo m when the polynomial sa - sb, reduced by the
# hypotheses x_i^3 == f_i, computes to the empty list.

def mon_unit(n: Nat, i: Nat, +k: Nat, +env: List<&2, Nat>, +hi: {Nat.is_lt(i, n) == True{} : Bool}) -> {E.mon(P.unit(n, i, k), env) == Nat.pow(E.venv(i, env), k) : Nat}:
  match n i:
    case 0n +i2:
      Empty.absurd({E.mon(P.unit(0n, i2, k), env) == Nat.pow(E.venv(i2, env), k) : Nat}, N.lt_zero_absurd(i2, hi))
    case 1n+ +m 0n:
      %Equal.sym(Nat, E.mon(P.unit(m, 0n, 0n), E.tl(env)), 1n, R.mon_zero(m, E.tl(env))) : {Nat.mul(Nat.pow(E.hd(env), k), _) == Nat.pow(E.hd(env), k) : Nat}
      NA.mul_one(Nat.pow(E.hd(env), k))
    case 1n+ +m 1n+ +j:
      %Equal.sym(Nat, E.mon(P.unit(m, j, k), E.tl(env)), Nat.pow(E.venv(j, E.tl(env)), k), mon_unit(m, j, k, E.tl(env), hi)) : {Nat.mul(1n, _) == Nat.pow(E.venv(j, E.tl(env)), k) : Nat}
      SR.one_mul(Nat.pow(E.venv(j, E.tl(env)), k))

def vp_s(+v: Nat) -> {Nat.add(v, 0n) == Nat.add(Nat.mul(1n, Nat.mul(v, 1n)), 0n) : Nat}:
  %Equal.sym(Nat, Nat.add(v, 0n), v, NA.add_zero(v)) : {_ == Nat.add(Nat.mul(1n, Nat.mul(v, 1n)), 0n) : Nat}
  %Equal.sym(Nat, Nat.mul(v, 1n), v, NA.mul_one(v)) : {v == Nat.add(Nat.mul(1n, _), 0n) : Nat}
  %Equal.sym(Nat, Nat.mul(1n, v), v, SR.one_mul(v)) : {v == Nat.add(_, 0n) : Nat}
  %Equal.sym(Nat, Nat.add(v, 0n), v, NA.add_zero(v)) : {v == _ : Nat}
  {==}

# variable i has the value of the polynomial x_i
def var_rel(+mp: Nat, +n: Nat, +i: Nat, +env: List<&2, Nat>, +hi: {Nat.is_lt(i, n) == True{} : Bool}) -> Z.Rel(mp, E.venv(i, env), E.eP(P.pvar(n, i), env), E.eN(P.pvar(n, i), env)):
