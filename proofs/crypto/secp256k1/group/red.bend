def k0_s(+a: Nat, +c: Nat) -> {Nat.add(Nat.add(a, 0n), c) == Nat.add(a, Nat.add(c, 0n)) : Nat}:
  %Equal.sym(Nat, Nat.add(a, 0n), a, NA.add_zero(a)) : {Nat.add(_, c) == Nat.add(a, Nat.add(c, 0n)) : Nat}
  %Equal.sym(Nat, Nat.add(c, 0n), c, NA.add_zero(c)) : {Nat.add(a, c) == Nat.add(a, _) : Nat}
  {==}

def red_k_v(+mp: Nat, +n: Nat, +i: Nat, +dp: Nat, +f: List<&2, P.Tm>, +c1: B.Bn, +c2: B.Bn, +e: List<&2, Nat>, +env: List<&2, Nat>, k: Nat, +hi: {Nat.is_lt(i, n) == True{} : Bool}, +h: Z.Rel(mp, Nat.pow(E.venv(i, env), 1n+dp), E.eP(f, env), E.eN(f, env)), +hk: {Nat.is_le(Nat.mul(k, 1n+dp), P.nth(i, e)) == True{} : Bool}) -> Z.SameM(mp, E.eP(P.red_k(n, i, dp, f, P.Zc{c1, c2}, e, k), env), E.eN(P.red_k(n, i, dp, f, P.Zc{c1, c2}, e, k), env), Nat.mul(B.bval(c1), E.mon(e, env)), Nat.mul(B.bval(c2), E.mon(e, env))):
  match k:
    case 0n:
      Equal.cong(Nat, Nat, z => Nat.mod(z, 1n+mp), Nat.add(Nat.add(Nat.mul(B.bval(c1), E.mon(e, env)), 0n), Nat.mul(B.bval(c2), E.mon(e, env))), Nat.add(Nat.mul(B.bval(c1), E.mon(e, env)), Nat.add(Nat.mul(B.bval(c2), E.mon(e, env)), 0n)), k0_s(Nat.mul(B.bval(c1), E.mon(e, env)), Nat.mul(B.bval(c2), E.mon(e, env))))
    case 1n+ +j:
      red_g_v(mp, n, i, dp, f, c1, c2, e, env, 1n+j, hi, h, hk)

# one term: c x^(d k + r) mu becomes c x^r mu f^k
def red_t_v(+mp: Nat, +n: Nat, +i: Nat, +dp: Nat, +f: List<&2, P.Tm>, t: P.Tm, +env: List<&2, Nat>, +hi: {Nat.is_lt(i, n) == True{} : Bool}, +h: Z.Rel(mp, Nat.pow(E.venv(i, env), 1n+dp), E.eP(f, env), E.eN(f, env))) -> Z.SameM(mp, E.eP(P.red_t(n, i, dp, f, t), env), E.eN(P.red_t(n, i, dp, f, t), env), E.tP(t, env), E.tN(t, env)):
  match t:
    case P.Tm{P.Zc{+c1, +c2}, +e}:
      red_k_v(mp, n, i, dp, f, c1, c2, e, env, Nat.div(P.nth(i, e), 1n+dp), hi, h, div_le(dp, P.nth(i, e)))

def red_v(+mp: Nat, +n: Nat, +i: Nat, +dp: Nat, +f: List<&2, P.Tm>, a: List<&2, P.Tm>, +env: List<&2, Nat>, +hi: {Nat.is_lt(i, n) == True{} : Bool}, +h: Z.Rel(mp, Nat.pow(E.venv(i, env), 1n+dp), E.eP(f, env), E.eN(f, env))) -> Z.SameM(mp, E.eP(P.red(n, i, dp, f, a), env), E.eN(P.red(n, i, dp, f, a), env), E.eP(a, env), E.eN(a, env)):
  match a:
    case Nil{}:
      {==}
    case +x <> +xs:
      +t = P.red_t(n, i, dp, f, x)
      +r = P.red(n, i, dp, f, xs)
      Z.sameM_trans(mp, E.eP(P.padd(t, r), env), E.eN(P.padd(t, r), env), Nat.add(E.eP(t, env), E.eP(r, env)), Nat.add(E.eN(t, env), E.eN(r, env)), Nat.add(E.tP(x, env), E.eP(xs, env)), Nat.add(E.tN(x, env), E.eN(xs, env)),
        Z.sameM_of(mp, E.eP(P.padd(t, r), env), E.eN(P.padd(t, r), env), Nat.add(E.eP(t, env), E.eP(r, env)), Nat.add(E.eN(t, env), E.eN(r, env)), E.padd_v(t, r, env)),
        Z.sameM_add(mp, E.eP(t, env), E.eN(t, env), E.tP(x, env), E.tN(x, env), E.eP(r, env), E.eN(r, env), E.eP(xs, env), E.eN(xs, env), red_t_v(mp, n, i, dp, f, x, env, hi, h), red_v(mp, n, i, dp, f, xs, env, hi, h)))

# ---- the reduction class by class (P.redf) ----

def kle(+dp: Nat, +v: Nat, +k: Nat, +hb: {Nat.is_eq(Nat.div(v, 1n+dp), k) == True{} : Bool}) -> {Nat.is_le(Nat.mul(k, 1n+dp), v) == True{} : Bool}:
  %N.eq_from_is_eq(Nat.div(v, 1n+dp), k, hb) : {Nat.is_le(Nat.mul(_, 1n+dp), v) == True{} : Bool}
  div_le(dp, v)

def pt_p(+a: Nat, +m2: Nat, +xk: Nat, +s: Nat, +r: Nat) -> {Nat.add(Nat.mul(a, Nat.mul(m2, xk)), Nat.add(Nat.mul(s, xk), r)) == Nat.add(Nat.mul(Nat.add(Nat.mul(a, m2), s), xk), r) : Nat}:
  %Equal.sym(Nat, Nat.add(Nat.mul(s, xk), r), Nat.add(r, Nat.mul(s, xk)), NA.add_comm(Nat.mul(s, xk), r)) : {Nat.add(Nat.mul(a, Nat.mul(m2, xk)), _) == Nat.add(Nat.mul(Nat.add(Nat.mul(a, m2), s), xk), r) : Nat}
  %Equal.sym(Nat, Nat.mul(Nat.add(Nat.mul(a, m2), s), xk), Nat.add(Nat.mul(Nat.mul(a, m2), xk), Nat.mul(s, xk)), NA.mul_add_right(Nat.mul(a, m2), s, xk)) : {Nat.add(Nat.mul(a, Nat.mul(m2, xk)), Nat.add(r, Nat.mul(s, xk))) == Nat.add(_, r) : Nat}
  %Equal.sym(Nat, Nat.mul(Nat.mul(a, m2), xk), Nat.mul(a, Nat.mul(m2, xk)), NA.mul_assoc(a, m2, xk)) : {Nat.add(Nat.mul(a, Nat.mul(m2, xk)), Nat.add(r, Nat.mul(s, xk))) == Nat.add(Nat.add(_, Nat.mul(s, xk)), r) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.add(Nat.mul(a, Nat.mul(m2, xk)), Nat.mul(s, xk)), r), Nat.add(Nat.mul(a, Nat.mul(m2, xk)), Nat.add(Nat.mul(s, xk), r)), NA.add_assoc(Nat.mul(a, Nat.mul(m2, xk)), Nat.mul(s, xk), r)) : {Nat.add(Nat.mul(a, Nat.mul(m2, xk)), Nat.add(r, Nat.mul(s, xk))) == _ : Nat}
  %Equal.sym(Nat, Nat.add(Nat.mul(s, xk), r), Nat.add(r, Nat.mul(s, xk)), NA.add_comm(Nat.mul(s, xk), r)) : {Nat.add(Nat.mul(a, Nat.mul(m2, xk)), Nat.add(r, Nat.mul(s, xk))) == Nat.add(Nat.mul(a, Nat.mul(m2, xk)), _) : Nat}
  {==}

def pf_p(+t: Nat, +sx: Nat, +r: Nat) -> {Nat.add(t, Nat.add(sx, r)) == Nat.add(sx, Nat.add(t, r)) : Nat}:
  %Equal.sym(Nat, Nat.add(sx, r), Nat.add(r, sx), NA.add_comm(sx, r)) : {Nat.add(t, _) == Nat.add(sx, Nat.add(t, r)) : Nat}
  %Equal.sym(Nat, Nat.add(t, Nat.add(r, sx)), Nat.add(r, Nat.add(t, sx)), NA.add_swap(t, r, sx)) : {_ == Nat.add(sx, Nat.add(t, r)) : Nat}
  %Equal.sym(Nat, Nat.add(t, sx), Nat.add(sx, t), NA.add_comm(t, sx)) : {Nat.add(r, _) == Nat.add(sx, Nat.add(t, r)) : Nat}
  %Equal.sym(Nat, Nat.add(t, r), Nat.add(r, t), NA.add_comm(t, r)) : {Nat.add(r, Nat.add(sx, t)) == Nat.add(sx, _) : Nat}
  %Equal.sym(Nat, Nat.add(sx, Nat.add(r, t)), Nat.add(r, Nat.add(sx, t)), NA.add_swap(sx, r, t)) : {Nat.add(r, Nat.add(sx, t)) == _ : Nat}
  {==}

def part_p_c(+n: Nat, +i: Nat, +dp: Nat, +k: Nat, +c1: B.Bn, +c2: B.Bn, +e: List<&2, Nat>, +xs: List<&2, P.Tm>, +env: List<&2, Nat>, +hi: {Nat.is_lt(i, n) == True{} : Bool}, +ih: {E.eP(xs, env) == Nat.add(Nat.mul(E.eP(P.sel(n, i, dp, k, xs), env), Nat.pow(E.venv(i, env), Nat.mul(k, 1n+dp))), E.eP(P.rst(i, dp, k, xs), env)) : Nat}, b: Bool, +hb: {Nat.is_eq(Nat.div(P.nth(i, e), 1n+dp), k) == b : Bool}) -> {Nat.add(Nat.mul(B.bval(c1), E.mon(e, env)), E.eP(xs, env)) == Nat.add(Nat.mul(E.eP(P.sel_c(b, P.Zc{c1, c2}, P.esub(e, P.unit(n, i, Nat.mul(k, 1n+dp))), P.sel(n, i, dp, k, xs)), env), Nat.pow(E.venv(i, env), Nat.mul(k, 1n+dp))), E.eP(P.sel_c(Bool.not(b), P.Zc{c1, c2}, e, P.rst(i, dp, k, xs)), env)) : Nat}:
  match b:
    case True{}:
      %Equal.sym(Nat, E.eP(xs, env), Nat.add(Nat.mul(E.eP(P.sel(n, i, dp, k, xs), env), Nat.pow(E.venv(i, env), Nat.mul(k, 1n+dp))), E.eP(P.rst(i, dp, k, xs), env)), ih) : {Nat.add(Nat.mul(B.bval(c1), E.mon(e, env)), _) == Nat.add(Nat.mul(Nat.add(Nat.mul(B.bval(c1), E.mon(P.esub(e, P.unit(n, i, Nat.mul(k, 1n+dp))), env)), E.eP(P.sel(n, i, dp, k, xs), env)), Nat.pow(E.venv(i, env), Nat.mul(k, 1n+dp))), E.eP(P.rst(i, dp, k, xs), env)) : Nat}
      %Equal.sym(Nat, E.mon(e, env), Nat.mul(E.mon(P.esub(e, P.unit(n, i, Nat.mul(k, 1n+dp))), env), Nat.pow(E.venv(i, env), Nat.mul(k, 1n+dp))), mon_split(n, i, e, env, Nat.mul(k, 1n+dp), kle(dp, P.nth(i, e), k, hb), hi)) : {Nat.add(Nat.mul(B.bval(c1), _), Nat.add(Nat.mul(E.eP(P.sel(n, i, dp, k, xs), env), Nat.pow(E.venv(i, env), Nat.mul(k, 1n+dp))), E.eP(P.rst(i, dp, k, xs), env))) == Nat.add(Nat.mul(Nat.add(Nat.mul(B.bval(c1), E.mon(P.esub(e, P.unit(n, i, Nat.mul(k, 1n+dp))), env)), E.eP(P.sel(n, i, dp, k, xs), env)), Nat.pow(E.venv(i, env), Nat.mul(k, 1n+dp))), E.eP(P.rst(i, dp, k, xs), env)) : Nat}
      pt_p(B.bval(c1), E.mon(P.esub(e, P.unit(n, i, Nat.mul(k, 1n+dp))), env), Nat.pow(E.venv(i, env), Nat.mul(k, 1n+dp)), E.eP(P.sel(n, i, dp, k, xs), env), E.eP(P.rst(i, dp, k, xs), env))
    case False{}:
      %Equal.sym(Nat, E.eP(xs, env), Nat.add(Nat.mul(E.eP(P.sel(n, i, dp, k, xs), env), Nat.pow(E.venv(i, env), Nat.mul(k, 1n+dp))), E.eP(P.rst(i, dp, k, xs), env)), ih) : {Nat.add(Nat.mul(B.bval(c1), E.mon(e, env)), _) == Nat.add(Nat.mul(E.eP(P.sel(n, i, dp, k, xs), env), Nat.pow(E.venv(i, env), Nat.mul(k, 1n+dp))), Nat.add(Nat.mul(B.bval(c1), E.mon(e, env)), E.eP(P.rst(i, dp, k, xs), env))) : Nat}
      pf_p(Nat.mul(B.bval(c1), E.mon(e, env)), Nat.mul(E.eP(P.sel(n, i, dp, k, xs), env), Nat.pow(E.venv(i, env), Nat.mul(k, 1n+dp))), E.eP(P.rst(i, dp, k, xs), env))

# the value of a is the value of its class k (times x^(d k)) plus the rest
def part_p(+n: Nat, +i: Nat, +dp: Nat, +k: Nat, a: List<&2, P.Tm>, +env: List<&2, Nat>, +hi: {Nat.is_lt(i, n) == True{} : Bool}) -> {E.eP(a, env) == Nat.add(Nat.mul(E.eP(P.sel(n, i, dp, k, a), env), Nat.pow(E.venv(i, env), Nat.mul(k, 1n+dp))), E.eP(P.rst(i, dp, k, a), env)) : Nat}:
  match a:
    case Nil{}:
      {==}
    case P.Tm{P.Zc{+c1, +c2}, +e} <> +xs:
      part_p_c(n, i, dp, k, c1, c2, e, xs, env, hi, part_p(n, i, dp, k, xs, env, hi), Nat.is_eq(Nat.div(P.nth(i, e), 1n+dp), k), {==})

def pt_n(+a: Nat, +m2: Nat, +xk: Nat, +s: Nat, +r: Nat) -> {Nat.add(Nat.mul(a, Nat.mul(m2, xk)), Nat.add(Nat.mul(s, xk), r)) == Nat.add(Nat.mul(Nat.add(Nat.mul(a, m2), s), xk), r) : Nat}:
  %Equal.sym(Nat, Nat.add(Nat.mul(s, xk), r), Nat.add(r, Nat.mul(s, xk)), NA.add_comm(Nat.mul(s, xk), r)) : {Nat.add(Nat.mul(a, Nat.mul(m2, xk)), _) == Nat.add(Nat.mul(Nat.add(Nat.mul(a, m2), s), xk), r) : Nat}
  %Equal.sym(Nat, Nat.mul(Nat.add(Nat.mul(a, m2), s), xk), Nat.add(Nat.mul(Nat.mul(a, m2), xk), Nat.mul(s, xk)), NA.mul_add_right(Nat.mul(a, m2), s, xk)) : {Nat.add(Nat.mul(a, Nat.mul(m2, xk)), Nat.add(r, Nat.mul(s, xk))) == Nat.add(_, r) : Nat}
  %Equal.sym(Nat, Nat.mul(Nat.mul(a, m2), xk), Nat.mul(a, Nat.mul(m2, xk)), NA.mul_assoc(a, m2, xk)) : {Nat.add(Nat.mul(a, Nat.mul(m2, xk)), Nat.add(r, Nat.mul(s, xk))) == Nat.add(Nat.add(_, Nat.mul(s, xk)), r) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.add(Nat.mul(a, Nat.mul(m2, xk)), Nat.mul(s, xk)), r), Nat.add(Nat.mul(a, Nat.mul(m2, xk)), Nat.add(Nat.mul(s, xk), r)), NA.add_assoc(Nat.mul(a, Nat.mul(m2, xk)), Nat.mul(s, xk), r)) : {Nat.add(Nat.mul(a, Nat.mul(m2, xk)), Nat.add(r, Nat.mul(s, xk))) == _ : Nat}
  %Equal.sym(Nat, Nat.add(Nat.mul(s, xk), r), Nat.add(r, Nat.mul(s, xk)), NA.add_comm(Nat.mul(s, xk), r)) : {Nat.add(Nat.mul(a, Nat.mul(m2, xk)), Nat.add(r, Nat.mul(s, xk))) == Nat.add(Nat.mul(a, Nat.mul(m2, xk)), _) : Nat}
  {==}

def pf_n(+t: Nat, +sx: Nat, +r: Nat) -> {Nat.add(t, Nat.add(sx, r)) == Nat.add(sx, Nat.add(t, r)) : Nat}:
  %Equal.sym(Nat, Nat.add(sx, r), Nat.add(r, sx), NA.add_comm(sx, r)) : {Nat.add(t, _) == Nat.add(sx, Nat.add(t, r)) : Nat}
  %Equal.sym(Nat, Nat.add(t, Nat.add(r, sx)), Nat.add(r, Nat.add(t, sx)), NA.add_swap(t, r, sx)) : {_ == Nat.add(sx, Nat.add(t, r)) : Nat}
  %Equal.sym(Nat, Nat.add(t, sx), Nat.add(sx, t), NA.add_comm(t, sx)) : {Nat.add(r, _) == Nat.add(sx, Nat.add(t, r)) : Nat}
  %Equal.sym(Nat, Nat.add(t, r), Nat.add(r, t), NA.add_comm(t, r)) : {Nat.add(r, Nat.add(sx, t)) == Nat.add(sx, _) : Nat}
  %Equal.sym(Nat, Nat.add(sx, Nat.add(r, t)), Nat.add(r, Nat.add(sx, t)), NA.add_swap(sx, r, t)) : {Nat.add(r, Nat.add(sx, t)) == _ : Nat}
  {==}

def part_n_c(+n: Nat, +i: Nat, +dp: Nat, +k: Nat, +c1: B.Bn, +c2: B.Bn, +e: List<&2, Nat>, +xs: List<&2, P.Tm>, +env: List<&2, Nat>, +hi: {Nat.is_lt(i, n) == True{} : Bool}, +ih: {E.eN(xs, env) == Nat.add(Nat.mul(E.eN(P.sel(n, i, dp, k, xs), env), Nat.pow(E.venv(i, env), Nat.mul(k, 1n+dp))), E.eN(P.rst(i, dp, k, xs), env)) : Nat}, b: Bool, +hb: {Nat.is_eq(Nat.div(P.nth(i, e), 1n+dp), k) == b : Bool}) -> {Nat.add(Nat.mul(B.bval(c2), E.mon(e, env)), E.eN(xs, env)) == Nat.add(Nat.mul(E.eN(P.sel_c(b, P.Zc{c1, c2}, P.esub(e, P.unit(n, i, Nat.mul(k, 1n+dp))), P.sel(n, i, dp, k, xs)), env), Nat.pow(E.venv(i, env), Nat.mul(k, 1n+dp))), E.eN(P.sel_c(Bool.not(b), P.Zc{c1, c2}, e, P.rst(i, dp, k, xs)), env)) : Nat}:
  match b:
    case True{}:
      %Equal.sym(Nat, E.eN(xs, env), Nat.add(Nat.mul(E.eN(P.sel(n, i, dp, k, xs), env), Nat.pow(E.venv(i, env), Nat.mul(k, 1n+dp))), E.eN(P.rst(i, dp, k, xs), env)), ih) : {Nat.add(Nat.mul(B.bval(c2), E.mon(e, env)), _) == Nat.add(Nat.mul(Nat.add(Nat.mul(B.bval(c2), E.mon(P.esub(e, P.unit(n, i, Nat.mul(k, 1n+dp))), env)), E.eN(P.sel(n, i, dp, k, xs), env)), Nat.pow(E.venv(i, env), Nat.mul(k, 1n+dp))), E.eN(P.rst(i, dp, k, xs), env)) : Nat}
      %Equal.sym(Nat, E.mon(e, env), Nat.mul(E.mon(P.esub(e, P.unit(n, i, Nat.mul(k, 1n+dp))), env), Nat.pow(E.venv(i, env), Nat.mul(k, 1n+dp))), mon_split(n, i, e, env, Nat.mul(k, 1n+dp), kle(dp, P.nth(i, e), k, hb), hi)) : {Nat.add(Nat.mul(B.bval(c2), _), Nat.add(Nat.mul(E.eN(P.sel(n, i, dp, k, xs), env), Nat.pow(E.venv(i, env), Nat.mul(k, 1n+dp))), E.eN(P.rst(i, dp, k, xs), env))) == Nat.add(Nat.mul(Nat.add(Nat.mul(B.bval(c2), E.mon(P.esub(e, P.unit(n, i, Nat.mul(k, 1n+dp))), env)), E.eN(P.sel(n, i, dp, k, xs), env)), Nat.pow(E.venv(i, env), Nat.mul(k, 1n+dp))), E.eN(P.rst(i, dp, k, xs), env)) : Nat}
      pt_n(B.bval(c2), E.mon(P.esub(e, P.unit(n, i, Nat.mul(k, 1n+dp))), env), Nat.pow(E.venv(i, env), Nat.mul(k, 1n+dp)), E.eN(P.sel(n, i, dp, k, xs), env), E.eN(P.rst(i, dp, k, xs), env))
    case False{}:
      %Equal.sym(Nat, E.eN(xs, env), Nat.add(Nat.mul(E.eN(P.sel(n, i, dp, k, xs), env), Nat.pow(E.venv(i, env), Nat.mul(k, 1n+dp))), E.eN(P.rst(i, dp, k, xs), env)), ih) : {Nat.add(Nat.mul(B.bval(c2), E.mon(e, env)), _) == Nat.add(Nat.mul(E.eN(P.sel(n, i, dp, k, xs), env), Nat.pow(E.venv(i, env), Nat.mul(k, 1n+dp))), Nat.add(Nat.mul(B.bval(c2), E.mon(e, env)), E.eN(P.rst(i, dp, k, xs), env))) : Nat}
      pf_n(Nat.mul(B.bval(c2), E.mon(e, env)), Nat.mul(E.eN(P.sel(n, i, dp, k, xs), env), Nat.pow(E.venv(i, env), Nat.mul(k, 1n+dp))), E.eN(P.rst(i, dp, k, xs), env))

# the value of a is the value of its class k (times x^(d k)) plus the rest
def part_n(+n: Nat, +i: Nat, +dp: Nat, +k: Nat, a: List<&2, P.Tm>, +env: List<&2, Nat>, +hi: {Nat.is_lt(i, n) == True{} : Bool}) -> {E.eN(a, env) == Nat.add(Nat.mul(E.eN(P.sel(n, i, dp, k, a), env), Nat.pow(E.venv(i, env), Nat.mul(k, 1n+dp))), E.eN(P.rst(i, dp, k, a), env)) : Nat}:
  match a:
    case Nil{}:
      {==}
    case P.Tm{P.Zc{+c1, +c2}, +e} <> +xs:
      part_n_c(n, i, dp, k, c1, c2, e, xs, env, hi, part_n(n, i, dp, k, xs, env, hi), Nat.is_eq(Nat.div(P.nth(i, e), 1n+dp), k), {==})

def ca_a(+ps: Nat, +ns: Nat, +xk: Nat, +pf: Nat, +nf: Nat) -> {Nat.add(Nat.add(Nat.mul(pf, ps), Nat.mul(nf, ns)), Nat.mul(ns, xk)) == Nat.add(Nat.mul(pf, ps), Nat.mul(ns, Nat.add(xk, nf))) : Nat}:
  %Equal.sym(Nat, Nat.add(Nat.mul(pf, ps), Nat.mul(nf, ns)), Nat.add(Nat.mul(nf, ns), Nat.mul(pf, ps)), NA.add_comm(Nat.mul(pf, ps), Nat.mul(nf, ns))) : {Nat.add(_, Nat.mul(ns, xk)) == Nat.add(Nat.mul(pf, ps), Nat.mul(ns, Nat.add(xk, nf))) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.add(Nat.mul(nf, ns), Nat.mul(pf, ps)), Nat.mul(ns, xk)), Nat.add(Nat.mul(nf, ns), Nat.add(Nat.mul(pf, ps), Nat.mul(ns, xk))), NA.add_assoc(Nat.mul(nf, ns), Nat.mul(pf, ps), Nat.mul(ns, xk))) : {_ == Nat.add(Nat.mul(pf, ps), Nat.mul(ns, Nat.add(xk, nf))) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.mul(pf, ps), Nat.mul(ns, xk)), Nat.add(Nat.mul(ns, xk), Nat.mul(pf, ps)), NA.add_comm(Nat.mul(pf, ps), Nat.mul(ns, xk))) : {Nat.add(Nat.mul(nf, ns), _) == Nat.add(Nat.mul(pf, ps), Nat.mul(ns, Nat.add(xk, nf))) : Nat}
  %Equal.sym(Nat, Nat.add(xk, nf), Nat.add(nf, xk), NA.add_comm(xk, nf)) : {Nat.add(Nat.mul(nf, ns), Nat.add(Nat.mul(ns, xk), Nat.mul(pf, ps))) == Nat.add(Nat.mul(pf, ps), Nat.mul(ns, _)) : Nat}
  %Equal.sym(Nat, Nat.mul(ns, Nat.add(nf, xk)), Nat.add(Nat.mul(ns, nf), Nat.mul(ns, xk)), NA.mul_add_left(ns, nf, xk)) : {Nat.add(Nat.mul(nf, ns), Nat.add(Nat.mul(ns, xk), Nat.mul(pf, ps))) == Nat.add(Nat.mul(pf, ps), _) : Nat}
  %Equal.sym(Nat, Nat.mul(ns, nf), Nat.mul(nf, ns), NA.mul_comm(ns, nf)) : {Nat.add(Nat.mul(nf, ns), Nat.add(Nat.mul(ns, xk), Nat.mul(pf, ps))) == Nat.add(Nat.mul(pf, ps), Nat.add(_, Nat.mul(ns, xk))) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.mul(pf, ps), Nat.add(Nat.mul(nf, ns), Nat.mul(ns, xk))), Nat.add(Nat.mul(nf, ns), Nat.add(Nat.mul(pf, ps), Nat.mul(ns, xk))), NA.add_swap(Nat.mul(pf, ps), Nat.mul(nf, ns), Nat.mul(ns, xk))) : {Nat.add(Nat.mul(nf, ns), Nat.add(Nat.mul(ns, xk), Nat.mul(pf, ps))) == _ : Nat}
  %Equal.sym(Nat, Nat.add(Nat.mul(pf, ps), Nat.mul(ns, xk)), Nat.add(Nat.mul(ns, xk), Nat.mul(pf, ps)), NA.add_comm(Nat.mul(pf, ps), Nat.mul(ns, xk))) : {Nat.add(Nat.mul(nf, ns), Nat.add(Nat.mul(ns, xk), Nat.mul(pf, ps))) == Nat.add(Nat.mul(nf, ns), _) : Nat}
  {==}

def ca_b(+ps: Nat, +ns: Nat, +xk: Nat, +pf: Nat, +nf: Nat) -> {Nat.add(Nat.mul(ps, xk), Nat.add(Nat.mul(pf, ns), Nat.mul(nf, ps))) == Nat.add(Nat.mul(ps, Nat.add(xk, nf)), Nat.mul(pf, ns)) : Nat}:
  %Equal.sym(Nat, Nat.mul(pf, ns), Nat.mul(ns, pf), NA.mul_comm(pf, ns)) : {Nat.add(Nat.mul(ps, xk), Nat.add(_, Nat.mul(nf, ps))) == Nat.add(Nat.mul(ps, Nat.add(xk, nf)), Nat.mul(pf, ns)) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.mul(ns, pf), Nat.mul(nf, ps)), Nat.add(Nat.mul(nf, ps), Nat.mul(ns, pf)), NA.add_comm(Nat.mul(ns, pf), Nat.mul(nf, ps))) : {Nat.add(Nat.mul(ps, xk), _) == Nat.add(Nat.mul(ps, Nat.add(xk, nf)), Nat.mul(pf, ns)) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.mul(ps, xk), Nat.add(Nat.mul(nf, ps), Nat.mul(ns, pf))), Nat.add(Nat.mul(nf, ps), Nat.add(Nat.mul(ps, xk), Nat.mul(ns, pf))), NA.add_swap(Nat.mul(ps, xk), Nat.mul(nf, ps), Nat.mul(ns, pf))) : {_ == Nat.add(Nat.mul(ps, Nat.add(xk, nf)), Nat.mul(pf, ns)) : Nat}
