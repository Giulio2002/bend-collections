# one term: c x^(3k + r) mu becomes c x^r mu f^k
def red_t_v(+mp: Nat, +n: Nat, +i: Nat, +f: List<&2, P.Tm>, t: P.Tm, +env: List<&2, Nat>, +hi: {Nat.is_lt(i, n) == True{} : Bool}, +h: Z.Rel(mp, Nat.pow(E.venv(i, env), 3n), E.eP(f, env), E.eN(f, env))) -> Z.SameM(mp, E.eP(P.red_t(n, i, f, t), env), E.eN(P.red_t(n, i, f, t), env), E.tP(t, env), E.tN(t, env)):
