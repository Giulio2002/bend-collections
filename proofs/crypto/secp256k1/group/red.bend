def redf_v(+mp: Nat, +n: Nat, +i: Nat, +dp: Nat, +f: List<&2, P.Tm>, +a: List<&2, P.Tm>, +env: List<&2, Nat>, +hi: {Nat.is_lt(i, n) == True{} : Bool}, +h: Z.Rel(mp, Nat.pow(E.venv(i, env), 1n+dp), E.eP(f, env), E.eN(f, env))) -> Z.SameM(mp, E.eP(P.redf(n, i, dp, f, a), env), E.eN(P.redf(n, i, dp, f, a), env), E.eP(a, env), E.eN(a, env)):
  redc_v(2n, mp, n, i, dp, f, a, env, hi, h)
