def red_v(+mp: Nat, +n: Nat, +i: Nat, +f: List<&2, P.Tm>, a: List<&2, P.Tm>, +env: List<&2, Nat>, +hi: {Nat.is_lt(i, n) == True{} : Bool}, +h: Z.Rel(mp, Nat.pow(E.venv(i, env), 3n), E.eP(f, env), E.eN(f, env))) -> Z.SameM(mp, E.eP(P.red(n, i, f, a), env), E.eN(P.red(n, i, f, a), env), E.eP(a, env), E.eN(a, env)):
  match a:
    case Nil{}:
      {==}
    case +x <> +xs:
      +t = P.red_t(n, i, f, x)
      +r = P.red(n, i, f, xs)
      Z.sameM_trans(mp, E.eP(P.padd(t, r), env), E.eN(P.padd(t, r), env), Nat.add(E.eP(t, env), E.eP(r, env)), Nat.add(E.eN(t, env), E.eN(r, env)), Nat.add(E.tP(x, env), E.eP(xs, env)), Nat.add(E.tN(x, env), E.eN(xs, env)),
        Z.sameM_of(mp, E.eP(P.padd(t, r), env), E.eN(P.padd(t, r), env), Nat.add(E.eP(t, env), E.eP(r, env)), Nat.add(E.eN(t, env), E.eN(r, env)), E.padd_v(t, r, env)),
        Z.sameM_add(mp, E.eP(t, env), E.eN(t, env), E.tP(x, env), E.tN(x, env), E.eP(r, env), E.eN(r, env), E.eP(xs, env), E.eN(xs, env), red_t_v(mp, n, i, f, x, env, hi, h), red_v(mp, n, i, f, xs, env, hi, h)))
