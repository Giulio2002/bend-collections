  %Equal.sym(Nat, Nat.mod(x, 1n+mp), x, SQ.mred(mp, x, hx)) : {Nat.is_eq(_, 0n) == False{} : Bool}
  h0

def neg_nz(+mp: Nat, +y: Nat, +n: F.NZ(mp, y)) -> F.NZ(mp, FS.msub(1n+mp, 0n, y)):
