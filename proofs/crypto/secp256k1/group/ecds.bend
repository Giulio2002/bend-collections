def loop_good(fuel: Nat, +one: Nat, +h1: {one == 1n : Nat}, +hp: PM.Prime(FS.prime(one)), +hc: {Nat.is_eq(FS.mpow(FS.prime(one), Nat.sub(FS.prime(one), 7n), Nat.div(Nat.sub(FS.prime(one), 1n), 3n)), 1n) == False{} : Bool}, +hq: PM.Prime(FS.order(one)), +hg: {GS.valid(FS.prime(one), CS.g(one)) == True{} : Bool}, +hng: {GS.equiv(FS.prime(one), GS.smul(FS.prime(one), FS.order(one), CS.g(one)), CS.infinity()) == True{} : Bool}, +c: Bool, +d: Nat, +h: List<&2, U32>, +strict: Bool, +kk: List<&2, U32>, +v: List<&2, U32>, att: ES.Attempt, +sd: {ES.scalar_ok(one, d) == True{} : Bool}, +hlen: {CS.length_is(32n, h) == True{} : Bool}, +ga: GoodA(one, c, d, h, strict, att)) -> GoodM(one, c, d, h, strict, ES.sign_loop(fuel, one, ES.hash_scalar(one, h), d, kk, v, att)):
  match fuel att:
    case 0n ES.Retry{}:
      Unit{}
    case 0n ES.Sig{sig}:
      ga
    case 1n+ +f ES.Retry{}:
      loop_good(f, one, h1, hp, hc, hq, hg, hng, c, d, h, strict, ES.hmac(kk, ES.cat(v, [0])), ES.hmac(ES.hmac(kk, ES.cat(v, [0])), ES.hmac(ES.hmac(kk, ES.cat(v, [0])), v)), ES.attempt(one, ES.hash_scalar(one, h), d, ES.hmac(ES.hmac(kk, ES.cat(v, [0])), ES.hmac(ES.hmac(kk, ES.cat(v, [0])), v))), sd, hlen, att_good(one, h1, hp, hc, hq, hg, hng, c, d, h, strict, ES.hmac(ES.hmac(kk, ES.cat(v, [0])), ES.hmac(ES.hmac(kk, ES.cat(v, [0])), v)), sd, hlen))
    case 1n+f ES.Sig{sig}:
      ga

def drbg_good(+one: Nat, +h1: {one == 1n : Nat}, +hp: PM.Prime(FS.prime(one)), +hc: {Nat.is_eq(FS.mpow(FS.prime(one), Nat.sub(FS.prime(one), 7n), Nat.div(Nat.sub(FS.prime(one), 1n), 3n)), 1n) == False{} : Bool}, +hq: PM.Prime(FS.order(one)), +hg: {GS.valid(FS.prime(one), CS.g(one)) == True{} : Bool}, +hng: {GS.equiv(FS.prime(one), GS.smul(FS.prime(one), FS.order(one), CS.g(one)), CS.infinity()) == True{} : Bool}, +c: Bool, +d: Nat, +h: List<&2, U32>, +strict: Bool, g: ES.Drbg, +sd: {ES.scalar_ok(one, d) == True{} : Bool}, +hlen: {CS.length_is(32n, h) == True{} : Bool}) -> GoodM(one, c, d, h, strict, ES.sign_drbg(one, ES.hash_scalar(one, h), d, g)):
  match g:
    case ES.Drbg{+k, +v}:
      loop_good(16n, one, h1, hp, hc, hq, hg, hng, c, d, h, strict, k, ES.hmac(k, v), ES.attempt(one, ES.hash_scalar(one, h), d, ES.hmac(k, v)), sd, hlen, att_good(one, h1, hp, hc, hq, hg, hng, c, d, h, strict, ES.hmac(k, v), sd, hlen))

def sign_g(+one: Nat, +h1: {one == 1n : Nat}, +hp: PM.Prime(FS.prime(one)), +hc: {Nat.is_eq(FS.mpow(FS.prime(one), Nat.sub(FS.prime(one), 7n), Nat.div(Nat.sub(FS.prime(one), 1n), 3n)), 1n) == False{} : Bool}, +hq: PM.Prime(FS.order(one)), +hg: {GS.valid(FS.prime(one), CS.g(one)) == True{} : Bool}, +hng: {GS.equiv(FS.prime(one), GS.smul(FS.prime(one), FS.order(one), CS.g(one)), CS.infinity()) == True{} : Bool}, +k0: List<&2, U32>, +v0: List<&2, U32>, +c: Bool, +d: Nat, +h: List<&2, U32>, +strict: Bool, +b1: Bool, +b2: Bool, ok: Bool, +hok: {Bool.and(b1, Bool.and(b2, ES.scalar_ok(one, d))) == ok : Bool}, +hb1: {b1 == CS.length_is(32n, h) : Bool}) -> GoodM(one, c, d, h, strict, ES.sign_d(one, k0, v0, h, d, ok)):
  match ok:
    case False{}:
      Unit{}
    case True{}:
      drbg_good(one, h1, hp, hc, hq, hg, hng, c, d, h, strict, ES.drbg_init(k0, v0, ES.cat(ES.i2osp32(d), ES.i2osp32(ES.hash_scalar(one, h)))), Lg.and_right(b2, ES.scalar_ok(one, d), Lg.and_right(b1, Bool.and(b2, ES.scalar_ok(one, d)), hok)), Equal.trans(Bool, CS.length_is(32n, h), b1, True{}, Equal.sym(Bool, b1, CS.length_is(32n, h), hb1), Lg.and_left(b1, Bool.and(b2, ES.scalar_ok(one, d)), hok)))

# every signature ES.sign returns is good for the key of OS2IP(sk)
def sign_good(+one: Nat, +h1: {one == 1n : Nat}, +hp: PM.Prime(FS.prime(one)), +hc: {Nat.is_eq(FS.mpow(FS.prime(one), Nat.sub(FS.prime(one), 7n), Nat.div(Nat.sub(FS.prime(one), 1n), 3n)), 1n) == False{} : Bool}, +hq: PM.Prime(FS.order(one)), +hg: {GS.valid(FS.prime(one), CS.g(one)) == True{} : Bool}, +hng: {GS.equiv(FS.prime(one), GS.smul(FS.prime(one), FS.order(one), CS.g(one)), CS.infinity()) == True{} : Bool}, +c: Bool, +sk: List<&2, U32>, +h: List<&2, U32>, +strict: Bool) -> GoodM(one, c, CS.os2ip(sk), h, strict, ES.sign(one, sk, h)):
  sign_g(one, h1, hp, hc, hq, hg, hng, ES.fill(32n, 0), ES.fill(32n, 1), c, CS.os2ip(sk), h, strict, CS.length_is(32n, h), CS.length_is(32n, sk), Bool.and(CS.length_is(32n, h), Bool.and(CS.length_is(32n, sk), ES.scalar_ok(one, CS.os2ip(sk)))), {==}, {==})

def good_of(+one: Nat, +h1: {one == 1n : Nat}, +hp: PM.Prime(FS.prime(one)), +hc: {Nat.is_eq(FS.mpow(FS.prime(one), Nat.sub(FS.prime(one), 7n), Nat.div(Nat.sub(FS.prime(one), 1n), 3n)), 1n) == False{} : Bool}, +hq: PM.Prime(FS.order(one)), +hg: {GS.valid(FS.prime(one), CS.g(one)) == True{} : Bool}, +hng: {GS.equiv(FS.prime(one), GS.smul(FS.prime(one), FS.order(one), CS.g(one)), CS.infinity()) == True{} : Bool}, +c: Bool, +sk: List<&2, U32>, +h: List<&2, U32>, +strict: Bool, +sig: List<&2, U32>, +hs: {ES.sign(one, sk, h) == Some{sig} : Maybe<&2, List<&2, U32>>}) -> Good(one, c, CS.os2ip(sk), h, strict, sig):
  Lg.subst(Maybe<&2, List<&2, U32>>, m => GoodM(one, c, CS.os2ip(sk), h, strict, m), ES.sign(one, sk, h), Some{sig}, hs, sign_good(one, h1, hp, hc, hq, hg, hng, c, sk, h, strict))

def fst(-A: Data, -B: Data, p: S.Both<A, B>) -> A:
  match p:
    case S.Both{a, b}:
      a

def snd(-A: Data, -B: Data, p: S.Both<A, B>) -> B:
  match p:
    case S.Both{a, b}:
      b

# sign, then verify with the signer's public key
def sign_verify(+one: Nat, +h1: {one == 1n : Nat}, +hp: PM.Prime(FS.prime(one)), +hc: {Nat.is_eq(FS.mpow(FS.prime(one), Nat.sub(FS.prime(one), 7n), Nat.div(Nat.sub(FS.prime(one), 1n), 3n)), 1n) == False{} : Bool}, +hq: PM.Prime(FS.order(one)), +hg: {GS.valid(FS.prime(one), CS.g(one)) == True{} : Bool}, +hng: {GS.equiv(FS.prime(one), GS.smul(FS.prime(one), FS.order(one), CS.g(one)), CS.infinity()) == True{} : Bool}, +sk: List<&2, U32>, +h: List<&2, U32>, +c: Bool, +strict: Bool, +sig: List<&2, U32>, +pk: List<&2, U32>, +hs: {ES.sign(one, sk, h) == Some{sig} : Maybe<&2, List<&2, U32>>}, +hpk: {ES.public_key(one, sk, c) == Some{pk} : Maybe<&2, List<&2, U32>>}) -> {ES.verify(one, pk, h, CS.first(64n, sig), strict) == True{} : Bool}:
  Lg.subst(List<&2, U32>, z => {ES.verify(one, z, h, CS.first(64n, sig), strict) == True{} : Bool}, ES.pk_of(one, c, CS.pmul(ES.p(one), CS.os2ip(sk), CS.g(one))), pk, EB.pk_eq(one, sk, c, pk, hpk),
    fst({ES.verify(one, ES.pk_of(one, c, CS.pmul(FS.prime(one), CS.os2ip(sk), CS.g(one))), h, CS.first(64n, sig), strict) == True{} : Bool}, {ES.recover(one, h, sig) == Some{CS.encode_uncompressed(FS.prime(one), CS.pmul(FS.prime(one), CS.os2ip(sk), CS.g(one)))} : Maybe<&2, List<&2, U32>>}, good_of(one, h1, hp, hc, hq, hg, hng, c, sk, h, strict, sig, hs)))

def pub_u(+one: Nat, +d: Nat, ok: Bool, +hok: {ok == True{} : Bool}) -> {ES.public_d(one, False{}, d, ok) == Some{CS.encode_uncompressed(FS.prime(one), CS.pmul(FS.prime(one), d, CS.g(one)))} : Maybe<&2, List<&2, U32>>}:
  match ok:
    case True{}:
      {==}
    case False{}:
      Empty.absurd({ES.public_d(one, False{}, d, False{}) == Some{CS.encode_uncompressed(FS.prime(one), CS.pmul(FS.prime(one), d, CS.g(one)))} : Maybe<&2, List<&2, U32>>}, Lg.false_true(hok))

# sign, then recover: the signer's uncompressed public key
def sign_recover(+one: Nat, +h1: {one == 1n : Nat}, +hp: PM.Prime(FS.prime(one)), +hc: {Nat.is_eq(FS.mpow(FS.prime(one), Nat.sub(FS.prime(one), 7n), Nat.div(Nat.sub(FS.prime(one), 1n), 3n)), 1n) == False{} : Bool}, +hq: PM.Prime(FS.order(one)), +hg: {GS.valid(FS.prime(one), CS.g(one)) == True{} : Bool}, +hng: {GS.equiv(FS.prime(one), GS.smul(FS.prime(one), FS.order(one), CS.g(one)), CS.infinity()) == True{} : Bool}, +sk: List<&2, U32>, +h: List<&2, U32>, +sig: List<&2, U32>, +hs: {ES.sign(one, sk, h) == Some{sig} : Maybe<&2, List<&2, U32>>}) -> {ES.recover(one, h, sig) == ES.public_key(one, sk, False{}) : Maybe<&2, List<&2, U32>>}:
  Equal.trans(Maybe<&2, List<&2, U32>>, ES.recover(one, h, sig), Some{CS.encode_uncompressed(FS.prime(one), CS.pmul(FS.prime(one), CS.os2ip(sk), CS.g(one)))}, ES.public_key(one, sk, False{}), snd({ES.verify(one, ES.pk_of(one, False{}, CS.pmul(FS.prime(one), CS.os2ip(sk), CS.g(one))), h, CS.first(64n, sig), False{}) == True{} : Bool}, {ES.recover(one, h, sig) == Some{CS.encode_uncompressed(FS.prime(one), CS.pmul(FS.prime(one), CS.os2ip(sk), CS.g(one)))} : Maybe<&2, List<&2, U32>>}, good_of(one, h1, hp, hc, hq, hg, hng, False{}, sk, h, False{}, sig, hs)), Equal.sym(Maybe<&2, List<&2, U32>>, ES.public_key(one, sk, False{}), Some{CS.encode_uncompressed(FS.prime(one), CS.pmul(FS.prime(one), CS.os2ip(sk), CS.g(one)))}, pub_u(one, CS.os2ip(sk), Bool.and(CS.length_is(32n, sk), ES.scalar_ok(one, CS.os2ip(sk))), Lg.and_right(CS.length_is(32n, h), Bool.and(CS.length_is(32n, sk), ES.scalar_ok(one, CS.os2ip(sk))), EB.sign_ok(one, sk, h, sig, hs)))))
