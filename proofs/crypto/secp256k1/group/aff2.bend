# ---- the general case ----

def corr_a(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +x1: Nat, +y1: Nat, +z1: Nat, +x2: Nat, +y2: Nat, +z2: Nat, +va: {GS.valid(1n+mp, CS.SPoint{x1, y1, z1}) == True{} : Bool}, +vb: {GS.valid(1n+mp, CS.SPoint{x2, y2, z2}) == True{} : Bool}, +hz: {Nat.mod(z1, 1n+mp) == 0n : Nat}) -> {GA.of_proj(1n+mp, CS.padd(1n+mp, CS.SPoint{x1, y1, z1}, CS.SPoint{x2, y2, z2})) == GA.of_proj(1n+mp, CS.SPoint{x2, y2, z2}) : GA.APoint}:
  +vi = G2.v_inf(mp, h21)
  A1.aff_eqv(mp, hp, CS.padd(1n+mp, CS.SPoint{x1, y1, z1}, CS.SPoint{x2, y2, z2}), CS.SPoint{x2, y2, z2}, G1.v_add(mp, hp, h3, hnc, h21, CS.SPoint{x1, y1, z1}, CS.SPoint{x2, y2, z2}, va, vb), vb, G2.e_trans(mp, hp, CS.padd(1n+mp, CS.SPoint{x1, y1, z1}, CS.SPoint{x2, y2, z2}), CS.padd(1n+mp, CS.infinity(), CS.SPoint{x2, y2, z2}), CS.SPoint{x2, y2, z2}, G1.v_add(mp, hp, h3, hnc, h21, CS.infinity(), CS.SPoint{x2, y2, z2}, vi, vb), G2.e_add_l(mp, hp, CS.SPoint{x1, y1, z1}, CS.infinity(), CS.SPoint{x2, y2, z2}, va, vi, A1.inf_eqv(mp, hp, x1, y1, z1, G1.v_onc(mp, x1, y1, z1, va), hz)), G4.unit_l(mp, CS.SPoint{x2, y2, z2})))

def corr_b(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +x1: Nat, +y1: Nat, +z1: Nat, +x2: Nat, +y2: Nat, +z2: Nat, +va: {GS.valid(1n+mp, CS.SPoint{x1, y1, z1}) == True{} : Bool}, +vb: {GS.valid(1n+mp, CS.SPoint{x2, y2, z2}) == True{} : Bool}, +hz: {Nat.mod(z2, 1n+mp) == 0n : Nat}) -> {GA.of_proj(1n+mp, CS.padd(1n+mp, CS.SPoint{x1, y1, z1}, CS.SPoint{x2, y2, z2})) == GA.of_proj(1n+mp, CS.SPoint{x1, y1, z1}) : GA.APoint}:
  +vi = G2.v_inf(mp, h21)
  A1.aff_eqv(mp, hp, CS.padd(1n+mp, CS.SPoint{x1, y1, z1}, CS.SPoint{x2, y2, z2}), CS.SPoint{x1, y1, z1}, G1.v_add(mp, hp, h3, hnc, h21, CS.SPoint{x1, y1, z1}, CS.SPoint{x2, y2, z2}, va, vb), va, G2.e_trans(mp, hp, CS.padd(1n+mp, CS.SPoint{x1, y1, z1}, CS.SPoint{x2, y2, z2}), CS.padd(1n+mp, CS.SPoint{x1, y1, z1}, CS.infinity()), CS.SPoint{x1, y1, z1}, G1.v_add(mp, hp, h3, hnc, h21, CS.SPoint{x1, y1, z1}, CS.infinity(), va, vi), G2.e_add_r(mp, hp, CS.SPoint{x1, y1, z1}, CS.SPoint{x2, y2, z2}, CS.infinity(), vb, vi, A1.inf_eqv(mp, hp, x2, y2, z2, G1.v_onc(mp, x2, y2, z2, vb), hz)), G2.unit(mp, CS.SPoint{x1, y1, z1})))

def corr_d(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +x1: Nat, +y1: Nat, +z1: Nat, +x2: Nat, +y2: Nat, +z2: Nat, +va: {GS.valid(1n+mp, CS.SPoint{x1, y1, z1}) == True{} : Bool}, +vb: {GS.valid(1n+mp, CS.SPoint{x2, y2, z2}) == True{} : Bool}, +n1: F.NZ(mp, z1), +n2: F.NZ(mp, z2)) -> {GA.of_proj(1n+mp, CS.padd(1n+mp, CS.SPoint{x1, y1, z1}, CS.SPoint{x2, y2, z2})) == GA.add(1n+mp, GA.APt{FS.mmul(1n+mp, x1, FS.minv(1n+mp, z1)), FS.mmul(1n+mp, y1, FS.minv(1n+mp, z1))}, GA.APt{FS.mmul(1n+mp, x2, FS.minv(1n+mp, z2)), FS.mmul(1n+mp, y2, FS.minv(1n+mp, z2))}) : GA.APoint}:
  +va2 = A1.nrm_v(mp, hp, x1, y1, z1, G1.v_onc(mp, x1, y1, z1, va), G1.v_nz(mp, x1, y1, z1, va), n1)
  +vb2 = A1.nrm_v(mp, hp, x2, y2, z2, G1.v_onc(mp, x2, y2, z2, vb), G1.v_nz(mp, x2, y2, z2, vb), n2)
  Equal.trans(GA.APoint, GA.of_proj(1n+mp, CS.padd(1n+mp, CS.SPoint{x1, y1, z1}, CS.SPoint{x2, y2, z2})), GA.of_proj(1n+mp, CS.padd(1n+mp, CS.SPoint{FS.mmul(1n+mp, x1, FS.minv(1n+mp, z1)), FS.mmul(1n+mp, y1, FS.minv(1n+mp, z1)), 1n}, CS.SPoint{FS.mmul(1n+mp, x2, FS.minv(1n+mp, z2)), FS.mmul(1n+mp, y2, FS.minv(1n+mp, z2)), 1n})), GA.add(1n+mp, GA.APt{FS.mmul(1n+mp, x1, FS.minv(1n+mp, z1)), FS.mmul(1n+mp, y1, FS.minv(1n+mp, z1))}, GA.APt{FS.mmul(1n+mp, x2, FS.minv(1n+mp, z2)), FS.mmul(1n+mp, y2, FS.minv(1n+mp, z2))}),
    A1.aff_eqv(mp, hp, CS.padd(1n+mp, CS.SPoint{x1, y1, z1}, CS.SPoint{x2, y2, z2}), CS.padd(1n+mp, CS.SPoint{FS.mmul(1n+mp, x1, FS.minv(1n+mp, z1)), FS.mmul(1n+mp, y1, FS.minv(1n+mp, z1)), 1n}, CS.SPoint{FS.mmul(1n+mp, x2, FS.minv(1n+mp, z2)), FS.mmul(1n+mp, y2, FS.minv(1n+mp, z2)), 1n}), G1.v_add(mp, hp, h3, hnc, h21, CS.SPoint{x1, y1, z1}, CS.SPoint{x2, y2, z2}, va, vb), G1.v_add(mp, hp, h3, hnc, h21, CS.SPoint{FS.mmul(1n+mp, x1, FS.minv(1n+mp, z1)), FS.mmul(1n+mp, y1, FS.minv(1n+mp, z1)), 1n}, CS.SPoint{FS.mmul(1n+mp, x2, FS.minv(1n+mp, z2)), FS.mmul(1n+mp, y2, FS.minv(1n+mp, z2)), 1n}, va2, vb2),
      G2.e_trans(mp, hp, CS.padd(1n+mp, CS.SPoint{x1, y1, z1}, CS.SPoint{x2, y2, z2}), CS.padd(1n+mp, CS.SPoint{FS.mmul(1n+mp, x1, FS.minv(1n+mp, z1)), FS.mmul(1n+mp, y1, FS.minv(1n+mp, z1)), 1n}, CS.SPoint{x2, y2, z2}), CS.padd(1n+mp, CS.SPoint{FS.mmul(1n+mp, x1, FS.minv(1n+mp, z1)), FS.mmul(1n+mp, y1, FS.minv(1n+mp, z1)), 1n}, CS.SPoint{FS.mmul(1n+mp, x2, FS.minv(1n+mp, z2)), FS.mmul(1n+mp, y2, FS.minv(1n+mp, z2)), 1n}), G1.v_add(mp, hp, h3, hnc, h21, CS.SPoint{FS.mmul(1n+mp, x1, FS.minv(1n+mp, z1)), FS.mmul(1n+mp, y1, FS.minv(1n+mp, z1)), 1n}, CS.SPoint{x2, y2, z2}, va2, vb), G2.e_add_l(mp, hp, CS.SPoint{x1, y1, z1}, CS.SPoint{FS.mmul(1n+mp, x1, FS.minv(1n+mp, z1)), FS.mmul(1n+mp, y1, FS.minv(1n+mp, z1)), 1n}, CS.SPoint{x2, y2, z2}, va, va2, A1.nrm_e(mp, hp, x1, y1, z1, n1)), G2.e_add_r(mp, hp, CS.SPoint{FS.mmul(1n+mp, x1, FS.minv(1n+mp, z1)), FS.mmul(1n+mp, y1, FS.minv(1n+mp, z1)), 1n}, CS.SPoint{x2, y2, z2}, CS.SPoint{FS.mmul(1n+mp, x2, FS.minv(1n+mp, z2)), FS.mmul(1n+mp, y2, FS.minv(1n+mp, z2)), 1n}, vb, vb2, A1.nrm_e(mp, hp, x2, y2, z2, n2)))),
    corr1(mp, hp, h3, hnc, h21, FS.mmul(1n+mp, x1, FS.minv(1n+mp, z1)), FS.mmul(1n+mp, y1, FS.minv(1n+mp, z1)), FS.mmul(1n+mp, x2, FS.minv(1n+mp, z2)), FS.mmul(1n+mp, y2, FS.minv(1n+mp, z2)), va2, vb2, NR.mod_mod(mp, Nat.mul(x1, FS.minv(1n+mp, z1))), NR.mod_mod(mp, Nat.mul(y1, FS.minv(1n+mp, z1))), NR.mod_mod(mp, Nat.mul(x2, FS.minv(1n+mp, z2))), NR.mod_mod(mp, Nat.mul(y2, FS.minv(1n+mp, z2)))))

def corr_c(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, +x1: Nat, +y1: Nat, +z1: Nat, +x2: Nat, +y2: Nat, +z2: Nat, +va: {GS.valid(1n+mp, CS.SPoint{x1, y1, z1}) == True{} : Bool}, +vb: {GS.valid(1n+mp, CS.SPoint{x2, y2, z2}) == True{} : Bool}, i1: Bool, i2: Bool, +h1: {Nat.is_eq(Nat.mod(z1, 1n+mp), 0n) == i1 : Bool}, +h2: {Nat.is_eq(Nat.mod(z2, 1n+mp), 0n) == i2 : Bool}) -> {GA.of_proj(1n+mp, CS.padd(1n+mp, CS.SPoint{x1, y1, z1}, CS.SPoint{x2, y2, z2})) == GA.add(1n+mp, GA.of_sel(i1, 1n+mp, x1, y1, FS.minv(1n+mp, z1)), GA.of_sel(i2, 1n+mp, x2, y2, FS.minv(1n+mp, z2))) : GA.APoint}:
  match i1 i2:
    case True{} True{}:
      %h2 : {GA.of_proj(1n+mp, CS.padd(1n+mp, CS.SPoint{x1, y1, z1}, CS.SPoint{x2, y2, z2})) == GA.of_sel(_, 1n+mp, x2, y2, FS.minv(1n+mp, z2)) : GA.APoint}
      corr_a(mp, hp, h3, hnc, h21, x1, y1, z1, x2, y2, z2, va, vb, N.eq_from_is_eq(Nat.mod(z1, 1n+mp), 0n, h1))
    case True{} False{}:
      %h2 : {GA.of_proj(1n+mp, CS.padd(1n+mp, CS.SPoint{x1, y1, z1}, CS.SPoint{x2, y2, z2})) == GA.of_sel(_, 1n+mp, x2, y2, FS.minv(1n+mp, z2)) : GA.APoint}
      corr_a(mp, hp, h3, hnc, h21, x1, y1, z1, x2, y2, z2, va, vb, N.eq_from_is_eq(Nat.mod(z1, 1n+mp), 0n, h1))
    case False{} True{}:
      %h1 : {GA.of_proj(1n+mp, CS.padd(1n+mp, CS.SPoint{x1, y1, z1}, CS.SPoint{x2, y2, z2})) == GA.of_sel(_, 1n+mp, x1, y1, FS.minv(1n+mp, z1)) : GA.APoint}
      corr_b(mp, hp, h3, hnc, h21, x1, y1, z1, x2, y2, z2, va, vb, N.eq_from_is_eq(Nat.mod(z2, 1n+mp), 0n, h2))
    case False{} False{}:
      corr_d(mp, hp, h3, hnc, h21, x1, y1, z1, x2, y2, z2, va, vb, h1, h2)

# the affine point of A + B is the chord-and-tangent sum of the affine points
def corr(+mp: Nat, +hp: PM.Prime(1n+mp), +h3: {Nat.mod(mp, 3n) == 0n : Nat}, +hnc: {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(1n+mp, 7n), Nat.div(mp, 3n)), 1n+mp), 1n) == False{} : Bool}, +h21: {Nat.is_lt(21n, 1n+mp) == True{} : Bool}, a: CS.SPoint, b: CS.SPoint, +va: {GS.valid(1n+mp, a) == True{} : Bool}, +vb: {GS.valid(1n+mp, b) == True{} : Bool}) -> {GA.of_proj(1n+mp, CS.padd(1n+mp, a, b)) == GA.add(1n+mp, GA.of_proj(1n+mp, a), GA.of_proj(1n+mp, b)) : GA.APoint}:
  match a b:
    case CS.SPoint{+x1, +y1, +z1} CS.SPoint{+x2, +y2, +z2}:
      corr_c(mp, hp, h3, hnc, h21, x1, y1, z1, x2, y2, z2, va, vb, Nat.is_eq(Nat.mod(z1, 1n+mp), 0n), Nat.is_eq(Nat.mod(z2, 1n+mp), 0n), {==}, {==})
