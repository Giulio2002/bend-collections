        Equal.cong(Nat, Nat, z => Nat.add(Nat.mul(z, u), Nat.mul(Nat.add(c, b), v)), Nat.add(a, d), Nat.add(c, b), h),
        Equal.cong(Nat, Nat, z => Nat.add(Nat.mul(Nat.add(c, b), u), Nat.mul(z, v)), Nat.add(c, b), Nat.add(a, d), Equal.sym(Nat, Nat.add(a, d), Nat.add(c, b), h))),
      mul_t(a, b, c, d, u, v)))

# ---- exponent vectors ----

def cmp_eq(a: Nat, b: Nat, +h: {Nat.cmp(a, b) == EQ{} : Cmp}) -> {a == b : Nat}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+y:
      Empty.absurd({0n == 1n+y : Nat}, Lg.cmp_lt_eq(h))
    case 1n+x 0n:
      Empty.absurd({1n+x == 0n : Nat}, Lg.cmp_eq_gt(Equal.sym(Cmp, GT{}, EQ{}, h)))
    case 1n+ +x 1n+ +y:
      Equal.cong(Nat, Nat, z => 1n+z, x, y, cmp_eq(x, y, h))

def lo_left(c: Cmp, +lo: Cmp, +h: {P.cmp_lo(c, lo) == EQ{} : Cmp}) -> {c == EQ{} : Cmp}:
  match c:
    case EQ{}:
      {==}
    case LT{}:
      Empty.absurd({LT{} == EQ{} : Cmp}, Lg.cmp_lt_eq(h))
    case GT{}:
      Empty.absurd({GT{} == EQ{} : Cmp}, Lg.cmp_eq_gt(Equal.sym(Cmp, GT{}, EQ{}, h)))

def lo_right(c: Cmp, +lo: Cmp, +h: {P.cmp_lo(c, lo) == EQ{} : Cmp}) -> {lo == EQ{} : Cmp}:
  match c:
    case EQ{}:
      h
    case LT{}:
      Empty.absurd({lo == EQ{} : Cmp}, Lg.cmp_lt_eq(h))
    case GT{}:
      Empty.absurd({lo == EQ{} : Cmp}, Lg.cmp_eq_gt(Equal.sym(Cmp, GT{}, EQ{}, h)))

def ecmp_eq(a: List<&2, Nat>, b: List<&2, Nat>, +h: {P.ecmp(a, b) == EQ{} : Cmp}) -> {a == b : List<&2, Nat>}:
  match a b:
    case Nil{} Nil{}:
      {==}
    case Nil{} y <> ys:
      Empty.absurd({Nil{} == y <> ys : List<&2, Nat>}, Lg.cmp_lt_eq(h))
    case x <> xs Nil{}:
      Empty.absurd({x <> xs == Nil{} : List<&2, Nat>}, Lg.cmp_eq_gt(Equal.sym(Cmp, GT{}, EQ{}, h)))
    case +x <> +xs +y <> +ys:
      +hx = cmp_eq(x, y, lo_left(Nat.cmp(x, y), P.ecmp(xs, ys), h))
      +ht = ecmp_eq(xs, ys, lo_right(Nat.cmp(x, y), P.ecmp(xs, ys), h))
      %hx : {x <> xs == _ <> ys : List<&2, Nat>}
      %ht : {x <> xs == x <> _ : List<&2, Nat>}
      {==}

def pow_add(+a: Nat, +x: Nat, +y: Nat) -> {Nat.pow(a, Nat.add(x, y)) == Nat.mul(Nat.pow(a, x), Nat.pow(a, y)) : Nat}:
  NR.pow_add(a, x, y)

def mon4_s(+a: Nat, +b: Nat, +c: Nat, +d: Nat) -> {Nat.mul(Nat.mul(a, b), Nat.mul(c, d)) == Nat.mul(Nat.mul(a, c), Nat.mul(b, d)) : Nat}:
  %Equal.sym(Nat, Nat.mul(Nat.mul(a, b), Nat.mul(c, d)), Nat.mul(a, Nat.mul(b, Nat.mul(c, d))), NA.mul_assoc(a, b, Nat.mul(c, d))) : {_ == Nat.mul(Nat.mul(a, c), Nat.mul(b, d)) : Nat}
  %Equal.sym(Nat, Nat.mul(Nat.mul(a, c), Nat.mul(b, d)), Nat.mul(a, Nat.mul(c, Nat.mul(b, d))), NA.mul_assoc(a, c, Nat.mul(b, d))) : {Nat.mul(a, Nat.mul(b, Nat.mul(c, d))) == _ : Nat}
  %Equal.sym(Nat, Nat.mul(c, Nat.mul(b, d)), Nat.mul(b, Nat.mul(c, d)), SR.mul_swap(c, b, d)) : {Nat.mul(a, Nat.mul(b, Nat.mul(c, d))) == Nat.mul(a, _) : Nat}
  {==}

def mon_add(e: List<&2, Nat>, f: List<&2, Nat>, +env: List<&2, Nat>) -> {mon(P.eadd(e, f), env) == Nat.mul(mon(e, env), mon(f, env)) : Nat}:
  match e f:
    case Nil{} ys:
      Equal.sym(Nat, Nat.add(mon(ys, env), 0n), mon(ys, env), NA.add_zero(mon(ys, env)))
    case +x <> +xs Nil{}:
      Equal.sym(Nat, Nat.mul(mon(x <> xs, env), 1n), mon(x <> xs, env), NA.mul_one(mon(x <> xs, env)))
    case +x <> +xs +y <> +ys:
      %Equal.sym(Nat, mon(P.eadd(xs, ys), tl(env)), Nat.mul(mon(xs, tl(env)), mon(ys, tl(env))), mon_add(xs, ys, tl(env))) : {Nat.mul(Nat.pow(hd(env), Nat.add(x, y)), _) == Nat.mul(Nat.mul(Nat.pow(hd(env), x), mon(xs, tl(env))), Nat.mul(Nat.pow(hd(env), y), mon(ys, tl(env)))) : Nat}
      %Equal.sym(Nat, Nat.pow(hd(env), Nat.add(x, y)), Nat.mul(Nat.pow(hd(env), x), Nat.pow(hd(env), y)), pow_add(hd(env), x, y)) : {Nat.mul(_, Nat.mul(mon(xs, tl(env)), mon(ys, tl(env)))) == Nat.mul(Nat.mul(Nat.pow(hd(env), x), mon(xs, tl(env))), Nat.mul(Nat.pow(hd(env), y), mon(ys, tl(env)))) : Nat}
      mon4_s(Nat.pow(hd(env), x), Nat.pow(hd(env), y), mon(xs, tl(env)), mon(ys, tl(env)))

# ---- negation ----

def pneg_p(a: List<&2, P.Tm>, +env: List<&2, Nat>) -> {eP(P.pneg(a), env) == eN(a, env) : Nat}:
  match a:
    case Nil{}:
      {==}
    case P.Tm{P.Zc{p, n}, e} <> xs:
      %Equal.sym(Nat, eP(P.pneg(xs), env), eN(xs, env), pneg_p(xs, env)) : {Nat.add(Nat.mul(B.bval(n), mon(e, env)), _) == Nat.add(Nat.mul(B.bval(n), mon(e, env)), eN(xs, env)) : Nat}
      {==}

def pneg_n(a: List<&2, P.Tm>, +env: List<&2, Nat>) -> {eN(P.pneg(a), env) == eP(a, env) : Nat}:
  match a:
    case Nil{}:
      {==}
    case P.Tm{P.Zc{p, n}, e} <> xs:
      %Equal.sym(Nat, eN(P.pneg(xs), env), eP(xs, env), pneg_n(xs, env)) : {Nat.add(Nat.mul(B.bval(p), mon(e, env)), _) == Nat.add(Nat.mul(B.bval(p), mon(e, env)), eP(xs, env)) : Nat}
      {==}

# ---- the product by one term ----

def tm_s(+cp1: Nat, +cn1: Nat, +dp: Nat, +dn: Nat, +me: Nat, +mf: Nat) -> {Nat.mul(Nat.add(Nat.mul(cp1, dp), Nat.mul(cn1, dn)), Nat.mul(me, mf)) == Nat.add(Nat.mul(Nat.mul(cp1, me), Nat.mul(dp, mf)), Nat.mul(Nat.mul(cn1, me), Nat.mul(dn, mf))) : Nat}:
  %Equal.sym(Nat, Nat.add(Nat.mul(cp1, dp), Nat.mul(cn1, dn)), Nat.add(Nat.mul(cn1, dn), Nat.mul(cp1, dp)), NA.add_comm(Nat.mul(cp1, dp), Nat.mul(cn1, dn))) : {Nat.mul(_, Nat.mul(me, mf)) == Nat.add(Nat.mul(Nat.mul(cp1, me), Nat.mul(dp, mf)), Nat.mul(Nat.mul(cn1, me), Nat.mul(dn, mf))) : Nat}
  %Equal.sym(Nat, Nat.mul(Nat.add(Nat.mul(cn1, dn), Nat.mul(cp1, dp)), Nat.mul(me, mf)), Nat.add(Nat.mul(Nat.mul(cn1, dn), Nat.mul(me, mf)), Nat.mul(Nat.mul(cp1, dp), Nat.mul(me, mf))), NA.mul_add_right(Nat.mul(cn1, dn), Nat.mul(cp1, dp), Nat.mul(me, mf))) : {_ == Nat.add(Nat.mul(Nat.mul(cp1, me), Nat.mul(dp, mf)), Nat.mul(Nat.mul(cn1, me), Nat.mul(dn, mf))) : Nat}
  %Equal.sym(Nat, Nat.mul(Nat.mul(cn1, dn), Nat.mul(me, mf)), Nat.mul(cn1, Nat.mul(dn, Nat.mul(me, mf))), NA.mul_assoc(cn1, dn, Nat.mul(me, mf))) : {Nat.add(_, Nat.mul(Nat.mul(cp1, dp), Nat.mul(me, mf))) == Nat.add(Nat.mul(Nat.mul(cp1, me), Nat.mul(dp, mf)), Nat.mul(Nat.mul(cn1, me), Nat.mul(dn, mf))) : Nat}
  %Equal.sym(Nat, Nat.mul(Nat.mul(cp1, dp), Nat.mul(me, mf)), Nat.mul(cp1, Nat.mul(dp, Nat.mul(me, mf))), NA.mul_assoc(cp1, dp, Nat.mul(me, mf))) : {Nat.add(Nat.mul(cn1, Nat.mul(dn, Nat.mul(me, mf))), _) == Nat.add(Nat.mul(Nat.mul(cp1, me), Nat.mul(dp, mf)), Nat.mul(Nat.mul(cn1, me), Nat.mul(dn, mf))) : Nat}
  %Equal.sym(Nat, Nat.mul(Nat.mul(cp1, me), Nat.mul(dp, mf)), Nat.mul(cp1, Nat.mul(me, Nat.mul(dp, mf))), NA.mul_assoc(cp1, me, Nat.mul(dp, mf))) : {Nat.add(Nat.mul(cn1, Nat.mul(dn, Nat.mul(me, mf))), Nat.mul(cp1, Nat.mul(dp, Nat.mul(me, mf)))) == Nat.add(_, Nat.mul(Nat.mul(cn1, me), Nat.mul(dn, mf))) : Nat}
  %Equal.sym(Nat, Nat.mul(me, Nat.mul(dp, mf)), Nat.mul(dp, Nat.mul(me, mf)), SR.mul_swap(me, dp, mf)) : {Nat.add(Nat.mul(cn1, Nat.mul(dn, Nat.mul(me, mf))), Nat.mul(cp1, Nat.mul(dp, Nat.mul(me, mf)))) == Nat.add(Nat.mul(cp1, _), Nat.mul(Nat.mul(cn1, me), Nat.mul(dn, mf))) : Nat}
  %Equal.sym(Nat, Nat.mul(Nat.mul(cn1, me), Nat.mul(dn, mf)), Nat.mul(cn1, Nat.mul(me, Nat.mul(dn, mf))), NA.mul_assoc(cn1, me, Nat.mul(dn, mf))) : {Nat.add(Nat.mul(cn1, Nat.mul(dn, Nat.mul(me, mf))), Nat.mul(cp1, Nat.mul(dp, Nat.mul(me, mf)))) == Nat.add(Nat.mul(cp1, Nat.mul(dp, Nat.mul(me, mf))), _) : Nat}
  %Equal.sym(Nat, Nat.mul(me, Nat.mul(dn, mf)), Nat.mul(dn, Nat.mul(me, mf)), SR.mul_swap(me, dn, mf)) : {Nat.add(Nat.mul(cn1, Nat.mul(dn, Nat.mul(me, mf))), Nat.mul(cp1, Nat.mul(dp, Nat.mul(me, mf)))) == Nat.add(Nat.mul(cp1, Nat.mul(dp, Nat.mul(me, mf))), Nat.mul(cn1, _)) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.mul(cp1, Nat.mul(dp, Nat.mul(me, mf))), Nat.mul(cn1, Nat.mul(dn, Nat.mul(me, mf)))), Nat.add(Nat.mul(cn1, Nat.mul(dn, Nat.mul(me, mf))), Nat.mul(cp1, Nat.mul(dp, Nat.mul(me, mf)))), NA.add_comm(Nat.mul(cp1, Nat.mul(dp, Nat.mul(me, mf))), Nat.mul(cn1, Nat.mul(dn, Nat.mul(me, mf))))) : {Nat.add(Nat.mul(cn1, Nat.mul(dn, Nat.mul(me, mf))), Nat.mul(cp1, Nat.mul(dp, Nat.mul(me, mf)))) == _ : Nat}
  {==}

def tm_t(+cp1: Nat, +cn1: Nat, +dp: Nat, +dn: Nat, +me: Nat, +mf: Nat) -> {Nat.mul(Nat.add(Nat.mul(cp1, dn), Nat.mul(cn1, dp)), Nat.mul(me, mf)) == Nat.add(Nat.mul(Nat.mul(cp1, me), Nat.mul(dn, mf)), Nat.mul(Nat.mul(cn1, me), Nat.mul(dp, mf))) : Nat}:
  %Equal.sym(Nat, Nat.add(Nat.mul(cp1, dn), Nat.mul(cn1, dp)), Nat.add(Nat.mul(cn1, dp), Nat.mul(cp1, dn)), NA.add_comm(Nat.mul(cp1, dn), Nat.mul(cn1, dp))) : {Nat.mul(_, Nat.mul(me, mf)) == Nat.add(Nat.mul(Nat.mul(cp1, me), Nat.mul(dn, mf)), Nat.mul(Nat.mul(cn1, me), Nat.mul(dp, mf))) : Nat}
  %Equal.sym(Nat, Nat.mul(Nat.add(Nat.mul(cn1, dp), Nat.mul(cp1, dn)), Nat.mul(me, mf)), Nat.add(Nat.mul(Nat.mul(cn1, dp), Nat.mul(me, mf)), Nat.mul(Nat.mul(cp1, dn), Nat.mul(me, mf))), NA.mul_add_right(Nat.mul(cn1, dp), Nat.mul(cp1, dn), Nat.mul(me, mf))) : {_ == Nat.add(Nat.mul(Nat.mul(cp1, me), Nat.mul(dn, mf)), Nat.mul(Nat.mul(cn1, me), Nat.mul(dp, mf))) : Nat}
  %Equal.sym(Nat, Nat.mul(Nat.mul(cn1, dp), Nat.mul(me, mf)), Nat.mul(cn1, Nat.mul(dp, Nat.mul(me, mf))), NA.mul_assoc(cn1, dp, Nat.mul(me, mf))) : {Nat.add(_, Nat.mul(Nat.mul(cp1, dn), Nat.mul(me, mf))) == Nat.add(Nat.mul(Nat.mul(cp1, me), Nat.mul(dn, mf)), Nat.mul(Nat.mul(cn1, me), Nat.mul(dp, mf))) : Nat}
  %Equal.sym(Nat, Nat.mul(Nat.mul(cp1, dn), Nat.mul(me, mf)), Nat.mul(cp1, Nat.mul(dn, Nat.mul(me, mf))), NA.mul_assoc(cp1, dn, Nat.mul(me, mf))) : {Nat.add(Nat.mul(cn1, Nat.mul(dp, Nat.mul(me, mf))), _) == Nat.add(Nat.mul(Nat.mul(cp1, me), Nat.mul(dn, mf)), Nat.mul(Nat.mul(cn1, me), Nat.mul(dp, mf))) : Nat}
  %Equal.sym(Nat, Nat.mul(Nat.mul(cp1, me), Nat.mul(dn, mf)), Nat.mul(cp1, Nat.mul(me, Nat.mul(dn, mf))), NA.mul_assoc(cp1, me, Nat.mul(dn, mf))) : {Nat.add(Nat.mul(cn1, Nat.mul(dp, Nat.mul(me, mf))), Nat.mul(cp1, Nat.mul(dn, Nat.mul(me, mf)))) == Nat.add(_, Nat.mul(Nat.mul(cn1, me), Nat.mul(dp, mf))) : Nat}
  %Equal.sym(Nat, Nat.mul(me, Nat.mul(dn, mf)), Nat.mul(dn, Nat.mul(me, mf)), SR.mul_swap(me, dn, mf)) : {Nat.add(Nat.mul(cn1, Nat.mul(dp, Nat.mul(me, mf))), Nat.mul(cp1, Nat.mul(dn, Nat.mul(me, mf)))) == Nat.add(Nat.mul(cp1, _), Nat.mul(Nat.mul(cn1, me), Nat.mul(dp, mf))) : Nat}
  %Equal.sym(Nat, Nat.mul(Nat.mul(cn1, me), Nat.mul(dp, mf)), Nat.mul(cn1, Nat.mul(me, Nat.mul(dp, mf))), NA.mul_assoc(cn1, me, Nat.mul(dp, mf))) : {Nat.add(Nat.mul(cn1, Nat.mul(dp, Nat.mul(me, mf))), Nat.mul(cp1, Nat.mul(dn, Nat.mul(me, mf)))) == Nat.add(Nat.mul(cp1, Nat.mul(dn, Nat.mul(me, mf))), _) : Nat}
  %Equal.sym(Nat, Nat.mul(me, Nat.mul(dp, mf)), Nat.mul(dp, Nat.mul(me, mf)), SR.mul_swap(me, dp, mf)) : {Nat.add(Nat.mul(cn1, Nat.mul(dp, Nat.mul(me, mf))), Nat.mul(cp1, Nat.mul(dn, Nat.mul(me, mf)))) == Nat.add(Nat.mul(cp1, Nat.mul(dn, Nat.mul(me, mf))), Nat.mul(cn1, _)) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.mul(cp1, Nat.mul(dn, Nat.mul(me, mf))), Nat.mul(cn1, Nat.mul(dp, Nat.mul(me, mf)))), Nat.add(Nat.mul(cn1, Nat.mul(dp, Nat.mul(me, mf))), Nat.mul(cp1, Nat.mul(dn, Nat.mul(me, mf)))), NA.add_comm(Nat.mul(cp1, Nat.mul(dn, Nat.mul(me, mf))), Nat.mul(cn1, Nat.mul(dp, Nat.mul(me, mf))))) : {Nat.add(Nat.mul(cn1, Nat.mul(dp, Nat.mul(me, mf))), Nat.mul(cp1, Nat.mul(dn, Nat.mul(me, mf)))) == _ : Nat}
  {==}

def tmul1_p(+t: P.Tm, u: P.Tm, +env: List<&2, Nat>) -> {tP(P.tmul1(t, u), env) == Nat.add(Nat.mul(tP(t, env), tP(u, env)), Nat.mul(tN(t, env), tN(u, env))) : Nat}:
  match t u:
    case P.Tm{P.Zc{+p1, +n1}, +e} P.Tm{P.Zc{+p2, +n2}, +f}:
      %Equal.sym(Nat, B.bval(B.badd(B.bmul(p1, p2), B.bmul(n1, n2))), Nat.add(B.bval(B.bmul(p1, p2)), B.bval(B.bmul(n1, n2))), B.badd_v(B.bmul(p1, p2), B.bmul(n1, n2))) : {Nat.mul(_, mon(P.eadd(e, f), env)) == Nat.add(Nat.mul(Nat.mul(B.bval(p1), mon(e, env)), Nat.mul(B.bval(p2), mon(f, env))), Nat.mul(Nat.mul(B.bval(n1), mon(e, env)), Nat.mul(B.bval(n2), mon(f, env)))) : Nat}
      %Equal.sym(Nat, B.bval(B.bmul(p1, p2)), Nat.mul(B.bval(p1), B.bval(p2)), B.bmul_v(p1, p2)) : {Nat.mul(Nat.add(_, B.bval(B.bmul(n1, n2))), mon(P.eadd(e, f), env)) == Nat.add(Nat.mul(Nat.mul(B.bval(p1), mon(e, env)), Nat.mul(B.bval(p2), mon(f, env))), Nat.mul(Nat.mul(B.bval(n1), mon(e, env)), Nat.mul(B.bval(n2), mon(f, env)))) : Nat}
      %Equal.sym(Nat, B.bval(B.bmul(n1, n2)), Nat.mul(B.bval(n1), B.bval(n2)), B.bmul_v(n1, n2)) : {Nat.mul(Nat.add(Nat.mul(B.bval(p1), B.bval(p2)), _), mon(P.eadd(e, f), env)) == Nat.add(Nat.mul(Nat.mul(B.bval(p1), mon(e, env)), Nat.mul(B.bval(p2), mon(f, env))), Nat.mul(Nat.mul(B.bval(n1), mon(e, env)), Nat.mul(B.bval(n2), mon(f, env)))) : Nat}
      %Equal.sym(Nat, mon(P.eadd(e, f), env), Nat.mul(mon(e, env), mon(f, env)), mon_add(e, f, env)) : {Nat.mul(Nat.add(Nat.mul(B.bval(p1), B.bval(p2)), Nat.mul(B.bval(n1), B.bval(n2))), _) == Nat.add(Nat.mul(Nat.mul(B.bval(p1), mon(e, env)), Nat.mul(B.bval(p2), mon(f, env))), Nat.mul(Nat.mul(B.bval(n1), mon(e, env)), Nat.mul(B.bval(n2), mon(f, env)))) : Nat}
      tm_s(B.bval(p1), B.bval(n1), B.bval(p2), B.bval(n2), mon(e, env), mon(f, env))

def tmul1_n(+t: P.Tm, u: P.Tm, +env: List<&2, Nat>) -> {tN(P.tmul1(t, u), env) == Nat.add(Nat.mul(tP(t, env), tN(u, env)), Nat.mul(tN(t, env), tP(u, env))) : Nat}:
  match t u:
    case P.Tm{P.Zc{+p1, +n1}, +e} P.Tm{P.Zc{+p2, +n2}, +f}:
      %Equal.sym(Nat, B.bval(B.badd(B.bmul(p1, n2), B.bmul(n1, p2))), Nat.add(B.bval(B.bmul(p1, n2)), B.bval(B.bmul(n1, p2))), B.badd_v(B.bmul(p1, n2), B.bmul(n1, p2))) : {Nat.mul(_, mon(P.eadd(e, f), env)) == Nat.add(Nat.mul(Nat.mul(B.bval(p1), mon(e, env)), Nat.mul(B.bval(n2), mon(f, env))), Nat.mul(Nat.mul(B.bval(n1), mon(e, env)), Nat.mul(B.bval(p2), mon(f, env)))) : Nat}
      %Equal.sym(Nat, B.bval(B.bmul(p1, n2)), Nat.mul(B.bval(p1), B.bval(n2)), B.bmul_v(p1, n2)) : {Nat.mul(Nat.add(_, B.bval(B.bmul(n1, p2))), mon(P.eadd(e, f), env)) == Nat.add(Nat.mul(Nat.mul(B.bval(p1), mon(e, env)), Nat.mul(B.bval(n2), mon(f, env))), Nat.mul(Nat.mul(B.bval(n1), mon(e, env)), Nat.mul(B.bval(p2), mon(f, env)))) : Nat}
      %Equal.sym(Nat, B.bval(B.bmul(n1, p2)), Nat.mul(B.bval(n1), B.bval(p2)), B.bmul_v(n1, p2)) : {Nat.mul(Nat.add(Nat.mul(B.bval(p1), B.bval(n2)), _), mon(P.eadd(e, f), env)) == Nat.add(Nat.mul(Nat.mul(B.bval(p1), mon(e, env)), Nat.mul(B.bval(n2), mon(f, env))), Nat.mul(Nat.mul(B.bval(n1), mon(e, env)), Nat.mul(B.bval(p2), mon(f, env)))) : Nat}
      %Equal.sym(Nat, mon(P.eadd(e, f), env), Nat.mul(mon(e, env), mon(f, env)), mon_add(e, f, env)) : {Nat.mul(Nat.add(Nat.mul(B.bval(p1), B.bval(n2)), Nat.mul(B.bval(n1), B.bval(p2))), _) == Nat.add(Nat.mul(Nat.mul(B.bval(p1), mon(e, env)), Nat.mul(B.bval(n2), mon(f, env))), Nat.mul(Nat.mul(B.bval(n1), mon(e, env)), Nat.mul(B.bval(p2), mon(f, env)))) : Nat}
      tm_t(B.bval(p1), B.bval(n1), B.bval(p2), B.bval(n2), mon(e, env), mon(f, env))

def tml_s(+a: Nat, +b: Nat, +c: Nat, +d: Nat, +u: Nat, +v: Nat) -> {Nat.add(Nat.add(Nat.mul(a, c), Nat.mul(b, d)), Nat.add(Nat.mul(a, u), Nat.mul(b, v))) == Nat.add(Nat.mul(a, Nat.add(c, u)), Nat.mul(b, Nat.add(d, v))) : Nat}:
  %Equal.sym(Nat, Nat.add(Nat.add(Nat.mul(a, c), Nat.mul(b, d)), Nat.add(Nat.mul(a, u), Nat.mul(b, v))), Nat.add(Nat.mul(a, c), Nat.add(Nat.mul(b, d), Nat.add(Nat.mul(a, u), Nat.mul(b, v)))), NA.add_assoc(Nat.mul(a, c), Nat.mul(b, d), Nat.add(Nat.mul(a, u), Nat.mul(b, v)))) : {_ == Nat.add(Nat.mul(a, Nat.add(c, u)), Nat.mul(b, Nat.add(d, v))) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.mul(b, d), Nat.add(Nat.mul(a, u), Nat.mul(b, v))), Nat.add(Nat.mul(a, u), Nat.add(Nat.mul(b, d), Nat.mul(b, v))), NA.add_swap(Nat.mul(b, d), Nat.mul(a, u), Nat.mul(b, v))) : {Nat.add(Nat.mul(a, c), _) == Nat.add(Nat.mul(a, Nat.add(c, u)), Nat.mul(b, Nat.add(d, v))) : Nat}
  %Equal.sym(Nat, Nat.mul(a, Nat.add(c, u)), Nat.add(Nat.mul(a, c), Nat.mul(a, u)), NA.mul_add_left(a, c, u)) : {Nat.add(Nat.mul(a, c), Nat.add(Nat.mul(a, u), Nat.add(Nat.mul(b, d), Nat.mul(b, v)))) == Nat.add(_, Nat.mul(b, Nat.add(d, v))) : Nat}
  %Equal.sym(Nat, Nat.mul(b, Nat.add(d, v)), Nat.add(Nat.mul(b, d), Nat.mul(b, v)), NA.mul_add_left(b, d, v)) : {Nat.add(Nat.mul(a, c), Nat.add(Nat.mul(a, u), Nat.add(Nat.mul(b, d), Nat.mul(b, v)))) == Nat.add(Nat.add(Nat.mul(a, c), Nat.mul(a, u)), _) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.add(Nat.mul(a, c), Nat.mul(a, u)), Nat.add(Nat.mul(b, d), Nat.mul(b, v))), Nat.add(Nat.mul(a, c), Nat.add(Nat.mul(a, u), Nat.add(Nat.mul(b, d), Nat.mul(b, v)))), NA.add_assoc(Nat.mul(a, c), Nat.mul(a, u), Nat.add(Nat.mul(b, d), Nat.mul(b, v)))) : {Nat.add(Nat.mul(a, c), Nat.add(Nat.mul(a, u), Nat.add(Nat.mul(b, d), Nat.mul(b, v)))) == _ : Nat}
  {==}

def tmul_p(+t: P.Tm, b: List<&2, P.Tm>, +env: List<&2, Nat>) -> {eP(P.tmul(t, b), env) == Nat.add(Nat.mul(tP(t, env), eP(b, env)), Nat.mul(tN(t, env), eN(b, env))) : Nat}:
  match b:
    case Nil{}:
      %Equal.sym(Nat, Nat.mul(tP(t, env), 0n), 0n, NA.mul_zero(tP(t, env))) : {0n == Nat.add(_, Nat.mul(tN(t, env), 0n)) : Nat}
      %Equal.sym(Nat, Nat.mul(tN(t, env), 0n), 0n, NA.mul_zero(tN(t, env))) : {0n == Nat.add(0n, _) : Nat}
      {==}
    case +y <> +ys:
      %Equal.sym(Nat, tP(P.tmul1(t, y), env), Nat.add(Nat.mul(tP(t, env), tP(y, env)), Nat.mul(tN(t, env), tN(y, env))), tmul1_p(t, y, env)) : {Nat.add(_, eP(P.tmul(t, ys), env)) == Nat.add(Nat.mul(tP(t, env), Nat.add(tP(y, env), eP(ys, env))), Nat.mul(tN(t, env), Nat.add(tN(y, env), eN(ys, env)))) : Nat}
      %Equal.sym(Nat, eP(P.tmul(t, ys), env), Nat.add(Nat.mul(tP(t, env), eP(ys, env)), Nat.mul(tN(t, env), eN(ys, env))), tmul_p(t, ys, env)) : {Nat.add(Nat.add(Nat.mul(tP(t, env), tP(y, env)), Nat.mul(tN(t, env), tN(y, env))), _) == Nat.add(Nat.mul(tP(t, env), Nat.add(tP(y, env), eP(ys, env))), Nat.mul(tN(t, env), Nat.add(tN(y, env), eN(ys, env)))) : Nat}
      tml_s(tP(t, env), tN(t, env), tP(y, env), tN(y, env), eP(ys, env), eN(ys, env))

def tmul_n(+t: P.Tm, b: List<&2, P.Tm>, +env: List<&2, Nat>) -> {eN(P.tmul(t, b), env) == Nat.add(Nat.mul(tP(t, env), eN(b, env)), Nat.mul(tN(t, env), eP(b, env))) : Nat}:
  match b:
    case Nil{}:
      %Equal.sym(Nat, Nat.mul(tP(t, env), 0n), 0n, NA.mul_zero(tP(t, env))) : {0n == Nat.add(_, Nat.mul(tN(t, env), 0n)) : Nat}
      %Equal.sym(Nat, Nat.mul(tN(t, env), 0n), 0n, NA.mul_zero(tN(t, env))) : {0n == Nat.add(0n, _) : Nat}
      {==}
    case +y <> +ys:
      %Equal.sym(Nat, tN(P.tmul1(t, y), env), Nat.add(Nat.mul(tP(t, env), tN(y, env)), Nat.mul(tN(t, env), tP(y, env))), tmul1_n(t, y, env)) : {Nat.add(_, eN(P.tmul(t, ys), env)) == Nat.add(Nat.mul(tP(t, env), Nat.add(tN(y, env), eN(ys, env))), Nat.mul(tN(t, env), Nat.add(tP(y, env), eP(ys, env)))) : Nat}
      %Equal.sym(Nat, eN(P.tmul(t, ys), env), Nat.add(Nat.mul(tP(t, env), eN(ys, env)), Nat.mul(tN(t, env), eP(ys, env))), tmul_n(t, ys, env)) : {Nat.add(Nat.add(Nat.mul(tP(t, env), tN(y, env)), Nat.mul(tN(t, env), tP(y, env))), _) == Nat.add(Nat.mul(tP(t, env), Nat.add(tN(y, env), eN(ys, env))), Nat.mul(tN(t, env), Nat.add(tP(y, env), eP(ys, env)))) : Nat}
      tml_s(tP(t, env), tN(t, env), tN(y, env), tP(y, env), eN(ys, env), eP(ys, env))

# ---- sums ----

def same_rw(+a: Nat, +b: Nat, +c: Nat, +d: Nat, +c2: Nat, +d2: Nat, +h: Same(a, b, c, d), +hc: {c == c2 : Nat}, +hd: {d == d2 : Nat}) -> Same(a, b, c2, d2):
  %hc : {Nat.add(a, d2) == Nat.add(_, b) : Nat}
  %hd : {Nat.add(a, _) == Nat.add(c, b) : Nat}
  h

def same_z(+p: Nat, +n: Nat) -> Same(p, n, Nat.add(p, 0n), Nat.add(n, 0n)):
  %Equal.sym(Nat, Nat.add(n, 0n), n, NA.add_zero(n)) : {Nat.add(p, _) == Nat.add(Nat.add(p, 0n), n) : Nat}
  %Equal.sym(Nat, Nat.add(p, n), Nat.add(n, p), NA.add_comm(p, n)) : {_ == Nat.add(Nat.add(p, 0n), n) : Nat}
  %Equal.sym(Nat, Nat.add(p, 0n), p, NA.add_zero(p)) : {Nat.add(n, p) == Nat.add(_, n) : Nat}
  %Equal.sym(Nat, Nat.add(p, n), Nat.add(n, p), NA.add_comm(p, n)) : {Nat.add(n, p) == _ : Nat}
  {==}

def cnz_s(+sp: Nat, +m: Nat, +r: Nat, +q: Nat) -> {Nat.add(r, Nat.add(Nat.mul(sp, m), q)) == Nat.add(Nat.add(Nat.mul(sp, m), r), q) : Nat}:
  %Equal.sym(Nat, Nat.mul(sp, m), Nat.mul(m, sp), NA.mul_comm(sp, m)) : {Nat.add(r, Nat.add(_, q)) == Nat.add(Nat.add(Nat.mul(sp, m), r), q) : Nat}
  %Equal.sym(Nat, Nat.add(r, Nat.add(Nat.mul(m, sp), q)), Nat.add(Nat.mul(m, sp), Nat.add(r, q)), NA.add_swap(r, Nat.mul(m, sp), q)) : {_ == Nat.add(Nat.add(Nat.mul(sp, m), r), q) : Nat}
  %Equal.sym(Nat, Nat.add(r, q), Nat.add(q, r), NA.add_comm(r, q)) : {Nat.add(Nat.mul(m, sp), _) == Nat.add(Nat.add(Nat.mul(sp, m), r), q) : Nat}
  %Equal.sym(Nat, Nat.mul(sp, m), Nat.mul(m, sp), NA.mul_comm(sp, m)) : {Nat.add(Nat.mul(m, sp), Nat.add(q, r)) == Nat.add(Nat.add(_, r), q) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.add(Nat.mul(m, sp), r), q), Nat.add(Nat.mul(m, sp), Nat.add(r, q)), NA.add_assoc(Nat.mul(m, sp), r, q)) : {Nat.add(Nat.mul(m, sp), Nat.add(q, r)) == _ : Nat}
  %Equal.sym(Nat, Nat.add(r, q), Nat.add(q, r), NA.add_comm(r, q)) : {Nat.add(Nat.mul(m, sp), Nat.add(q, r)) == Nat.add(Nat.mul(m, sp), _) : Nat}
  {==}

# the head term kept, or dropped when its coefficient is zero
def cnz_v(z: Bool, +s: P.Zc, +e: List<&2, Nat>, +r: List<&2, P.Tm>, +env: List<&2, Nat>, +hz: {z == P.zzero(s) : Bool}) -> Same(eP(P.cons_nz(z, s, e, r), env), eN(P.cons_nz(z, s, e, r), env), Nat.add(Nat.mul(cp(s), mon(e, env)), eP(r, env)), Nat.add(Nat.mul(cn(s), mon(e, env)), eN(r, env))):
  match z s:
    case False{} s2:
      same_refl(Nat.add(Nat.mul(cp(s2), mon(e, env)), eP(r, env)), Nat.add(Nat.mul(cn(s2), mon(e, env)), eN(r, env)))
    case True{} P.Zc{+sp, +sn}:
      +hv = B.beq_v(sp, sn, Equal.sym(Bool, True{}, B.beq(sp, sn), hz))
      %Equal.sym(Nat, B.bval(sp), B.bval(sn), hv) : {Nat.add(eP(r, env), Nat.add(Nat.mul(B.bval(sn), mon(e, env)), eN(r, env))) == Nat.add(Nat.add(Nat.mul(_, mon(e, env)), eP(r, env)), eN(r, env)) : Nat}
      cnz_s(B.bval(sn), mon(e, env), eP(r, env), eN(r, env))

def eqc_s(+u: Nat, +v: Nat, +m: Nat, +p1: Nat, +p2: Nat) -> {Nat.add(Nat.mul(Nat.add(u, v), m), Nat.add(p1, p2)) == Nat.add(Nat.add(Nat.mul(u, m), p1), Nat.add(Nat.mul(v, m), p2)) : Nat}:
  %Equal.sym(Nat, Nat.mul(Nat.add(u, v), m), Nat.add(Nat.mul(u, m), Nat.mul(v, m)), NA.mul_add_right(u, v, m)) : {Nat.add(_, Nat.add(p1, p2)) == Nat.add(Nat.add(Nat.mul(u, m), p1), Nat.add(Nat.mul(v, m), p2)) : Nat}
  %Equal.sym(Nat, Nat.mul(u, m), Nat.mul(m, u), NA.mul_comm(u, m)) : {Nat.add(Nat.add(_, Nat.mul(v, m)), Nat.add(p1, p2)) == Nat.add(Nat.add(Nat.mul(u, m), p1), Nat.add(Nat.mul(v, m), p2)) : Nat}
  %Equal.sym(Nat, Nat.mul(v, m), Nat.mul(m, v), NA.mul_comm(v, m)) : {Nat.add(Nat.add(Nat.mul(m, u), _), Nat.add(p1, p2)) == Nat.add(Nat.add(Nat.mul(u, m), p1), Nat.add(Nat.mul(v, m), p2)) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.add(Nat.mul(m, u), Nat.mul(m, v)), Nat.add(p1, p2)), Nat.add(Nat.mul(m, u), Nat.add(Nat.mul(m, v), Nat.add(p1, p2))), NA.add_assoc(Nat.mul(m, u), Nat.mul(m, v), Nat.add(p1, p2))) : {_ == Nat.add(Nat.add(Nat.mul(u, m), p1), Nat.add(Nat.mul(v, m), p2)) : Nat}
  %Equal.sym(Nat, Nat.mul(u, m), Nat.mul(m, u), NA.mul_comm(u, m)) : {Nat.add(Nat.mul(m, u), Nat.add(Nat.mul(m, v), Nat.add(p1, p2))) == Nat.add(Nat.add(_, p1), Nat.add(Nat.mul(v, m), p2)) : Nat}
  %Equal.sym(Nat, Nat.mul(v, m), Nat.mul(m, v), NA.mul_comm(v, m)) : {Nat.add(Nat.mul(m, u), Nat.add(Nat.mul(m, v), Nat.add(p1, p2))) == Nat.add(Nat.add(Nat.mul(m, u), p1), Nat.add(_, p2)) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.add(Nat.mul(m, u), p1), Nat.add(Nat.mul(m, v), p2)), Nat.add(Nat.mul(m, u), Nat.add(p1, Nat.add(Nat.mul(m, v), p2))), NA.add_assoc(Nat.mul(m, u), p1, Nat.add(Nat.mul(m, v), p2))) : {Nat.add(Nat.mul(m, u), Nat.add(Nat.mul(m, v), Nat.add(p1, p2))) == _ : Nat}
  %Equal.sym(Nat, Nat.add(p1, Nat.add(Nat.mul(m, v), p2)), Nat.add(Nat.mul(m, v), Nat.add(p1, p2)), NA.add_swap(p1, Nat.mul(m, v), p2)) : {Nat.add(Nat.mul(m, u), Nat.add(Nat.mul(m, v), Nat.add(p1, p2))) == Nat.add(Nat.mul(m, u), _) : Nat}
  {==}

def eq_case(x: P.Tm, y: P.Tm, +xs: List<&2, P.Tm>, +ys: List<&2, P.Tm>, +env: List<&2, Nat>, +ho: {EQ{} == P.hcmp(x <> xs, y <> ys) : Cmp}, +ih: Same(eP(P.merge(xs, ys, P.hcmp(xs, ys)), env), eN(P.merge(xs, ys, P.hcmp(xs, ys)), env), Nat.add(eP(xs, env), eP(ys, env)), Nat.add(eN(xs, env), eN(ys, env)))) -> Same(eP(P.cons_nz(P.zzero(P.tsum(x, y)), P.tsum(x, y), P.texp(x), P.merge(xs, ys, P.hcmp(xs, ys))), env), eN(P.cons_nz(P.zzero(P.tsum(x, y)), P.tsum(x, y), P.texp(x), P.merge(xs, ys, P.hcmp(xs, ys))), env), Nat.add(Nat.add(tP(x, env), eP(xs, env)), Nat.add(tP(y, env), eP(ys, env))), Nat.add(Nat.add(tN(x, env), eN(xs, env)), Nat.add(tN(y, env), eN(ys, env)))):
  match x y:
    case P.Tm{P.Zc{+cp1, +cn1}, +e} P.Tm{P.Zc{+dp, +dn}, +f}:
      +hef = ecmp_eq(e, f, Equal.sym(Cmp, EQ{}, P.ecmp(e, f), ho))
      +m2 = P.merge(xs, ys, P.hcmp(xs, ys))
      +s = {P.Zc{B.badd(cp1, dp), B.badd(cn1, dn)} : P.Zc}
      +h1 = cnz_v(B.beq(B.badd(cp1, dp), B.badd(cn1, dn)), s, e, m2, env, {==})
      +h2 = same_add(Nat.mul(cp(s), mon(e, env)), Nat.mul(cn(s), mon(e, env)), Nat.mul(cp(s), mon(e, env)), Nat.mul(cn(s), mon(e, env)), eP(m2, env), eN(m2, env), Nat.add(eP(xs, env), eP(ys, env)), Nat.add(eN(xs, env), eN(ys, env)), same_refl(Nat.mul(cp(s), mon(e, env)), Nat.mul(cn(s), mon(e, env))), ih)
      +h3 = same_trans(eP(P.cons_nz(B.beq(B.badd(cp1, dp), B.badd(cn1, dn)), s, e, m2), env), eN(P.cons_nz(B.beq(B.badd(cp1, dp), B.badd(cn1, dn)), s, e, m2), env), Nat.add(Nat.mul(cp(s), mon(e, env)), eP(m2, env)), Nat.add(Nat.mul(cn(s), mon(e, env)), eN(m2, env)), Nat.add(Nat.mul(cp(s), mon(e, env)), Nat.add(eP(xs, env), eP(ys, env))), Nat.add(Nat.mul(cn(s), mon(e, env)), Nat.add(eN(xs, env), eN(ys, env))), h1, h2)
      +hc = Equal.trans(Nat, Nat.add(Nat.mul(B.bval(B.badd(cp1, dp)), mon(e, env)), Nat.add(eP(xs, env), eP(ys, env))), Nat.add(Nat.mul(Nat.add(B.bval(cp1), B.bval(dp)), mon(e, env)), Nat.add(eP(xs, env), eP(ys, env))), Nat.add(Nat.add(Nat.mul(B.bval(cp1), mon(e, env)), eP(xs, env)), Nat.add(Nat.mul(B.bval(dp), mon(e, env)), eP(ys, env))),
        Equal.cong(Nat, Nat, z => Nat.add(Nat.mul(z, mon(e, env)), Nat.add(eP(xs, env), eP(ys, env))), B.bval(B.badd(cp1, dp)), Nat.add(B.bval(cp1), B.bval(dp)), B.badd_v(cp1, dp)),
        eqc_s(B.bval(cp1), B.bval(dp), mon(e, env), eP(xs, env), eP(ys, env)))
      +hd = Equal.trans(Nat, Nat.add(Nat.mul(B.bval(B.badd(cn1, dn)), mon(e, env)), Nat.add(eN(xs, env), eN(ys, env))), Nat.add(Nat.mul(Nat.add(B.bval(cn1), B.bval(dn)), mon(e, env)), Nat.add(eN(xs, env), eN(ys, env))), Nat.add(Nat.add(Nat.mul(B.bval(cn1), mon(e, env)), eN(xs, env)), Nat.add(Nat.mul(B.bval(dn), mon(e, env)), eN(ys, env))),
        Equal.cong(Nat, Nat, z => Nat.add(Nat.mul(z, mon(e, env)), Nat.add(eN(xs, env), eN(ys, env))), B.bval(B.badd(cn1, dn)), Nat.add(B.bval(cn1), B.bval(dn)), B.badd_v(cn1, dn)),
        eqc_s(B.bval(cn1), B.bval(dn), mon(e, env), eN(xs, env), eN(ys, env)))
      %hef : {Nat.add(eP(P.cons_nz(B.beq(B.badd(cp1, dp), B.badd(cn1, dn)), s, e, m2), env), Nat.add(Nat.add(Nat.mul(B.bval(cn1), mon(e, env)), eN(xs, env)), Nat.add(Nat.mul(B.bval(dn), mon(f, env)), eN(ys, env)))) == Nat.add(Nat.add(Nat.add(Nat.mul(B.bval(cp1), mon(e, env)), eP(xs, env)), Nat.add(Nat.mul(B.bval(dp), mon(_, env)), eP(ys, env))), eN(P.cons_nz(B.beq(B.badd(cp1, dp), B.badd(cn1, dn)), s, e, m2), env)) : Nat}
      %hef : {Nat.add(eP(P.cons_nz(B.beq(B.badd(cp1, dp), B.badd(cn1, dn)), s, e, m2), env), Nat.add(Nat.add(Nat.mul(B.bval(cn1), mon(e, env)), eN(xs, env)), Nat.add(Nat.mul(B.bval(dn), mon(_, env)), eN(ys, env)))) == Nat.add(Nat.add(Nat.add(Nat.mul(B.bval(cp1), mon(e, env)), eP(xs, env)), Nat.add(Nat.mul(B.bval(dp), mon(e, env)), eP(ys, env))), eN(P.cons_nz(B.beq(B.badd(cp1, dp), B.badd(cn1, dn)), s, e, m2), env)) : Nat}
      same_rw(eP(P.cons_nz(B.beq(B.badd(cp1, dp), B.badd(cn1, dn)), s, e, m2), env), eN(P.cons_nz(B.beq(B.badd(cp1, dp), B.badd(cn1, dn)), s, e, m2), env), Nat.add(Nat.mul(cp(s), mon(e, env)), Nat.add(eP(xs, env), eP(ys, env))), Nat.add(Nat.mul(cn(s), mon(e, env)), Nat.add(eN(xs, env), eN(ys, env))), Nat.add(Nat.add(Nat.mul(B.bval(cp1), mon(e, env)), eP(xs, env)), Nat.add(Nat.mul(B.bval(dp), mon(e, env)), eP(ys, env))), Nat.add(Nat.add(Nat.mul(B.bval(cn1), mon(e, env)), eN(xs, env)), Nat.add(Nat.mul(B.bval(dn), mon(e, env)), eN(ys, env))), h3, hc, hd)

def gt_s(+t: Nat, +p: Nat, +q: Nat) -> {Nat.add(t, Nat.add(p, q)) == Nat.add(Nat.add(t, p), q) : Nat}:
  %Equal.sym(Nat, Nat.add(t, Nat.add(p, q)), Nat.add(p, Nat.add(t, q)), NA.add_swap(t, p, q)) : {_ == Nat.add(Nat.add(t, p), q) : Nat}
  %Equal.sym(Nat, Nat.add(t, q), Nat.add(q, t), NA.add_comm(t, q)) : {Nat.add(p, _) == Nat.add(Nat.add(t, p), q) : Nat}
  %Equal.sym(Nat, Nat.add(t, p), Nat.add(p, t), NA.add_comm(t, p)) : {Nat.add(p, Nat.add(q, t)) == Nat.add(_, q) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.add(p, t), q), Nat.add(p, Nat.add(t, q)), NA.add_assoc(p, t, q)) : {Nat.add(p, Nat.add(q, t)) == _ : Nat}
  %Equal.sym(Nat, Nat.add(t, q), Nat.add(q, t), NA.add_comm(t, q)) : {Nat.add(p, Nat.add(q, t)) == Nat.add(p, _) : Nat}
  {==}

def lt_s(+t: Nat, +p: Nat, +q: Nat) -> {Nat.add(t, Nat.add(p, q)) == Nat.add(p, Nat.add(t, q)) : Nat}:
  %Equal.sym(Nat, Nat.add(t, Nat.add(p, q)), Nat.add(p, Nat.add(t, q)), NA.add_swap(t, p, q)) : {_ == Nat.add(p, Nat.add(t, q)) : Nat}
  %Equal.sym(Nat, Nat.add(t, q), Nat.add(q, t), NA.add_comm(t, q)) : {Nat.add(p, _) == Nat.add(p, Nat.add(t, q)) : Nat}
  %Equal.sym(Nat, Nat.add(t, q), Nat.add(q, t), NA.add_comm(t, q)) : {Nat.add(p, Nat.add(q, t)) == Nat.add(p, _) : Nat}
  {==}

def merge_v(+a: List<&2, P.Tm>, +b: List<&2, P.Tm>, o: Cmp, +env: List<&2, Nat>, +ho: {o == P.hcmp(a, b) : Cmp}) -> Same(eP(P.merge(a, b, o), env), eN(P.merge(a, b, o), env), Nat.add(eP(a, env), eP(b, env)), Nat.add(eN(a, env), eN(b, env))):
  match a b o:
    case Nil{} _ _:
      same_refl(eP(b, env), eN(b, env))
    case +x <> +xs Nil{} _:
      same_z(eP(a, env), eN(a, env))
    case +x <> +xs +y <> +ys GT{}:
      +ih = merge_v(xs, b, P.hcmp(xs, b), env, {==})
      +m2 = P.merge(xs, b, P.hcmp(xs, b))
      same_rw(Nat.add(tP(x, env), eP(m2, env)), Nat.add(tN(x, env), eN(m2, env)), Nat.add(tP(x, env), Nat.add(eP(xs, env), eP(b, env))), Nat.add(tN(x, env), Nat.add(eN(xs, env), eN(b, env))), Nat.add(Nat.add(tP(x, env), eP(xs, env)), eP(b, env)), Nat.add(Nat.add(tN(x, env), eN(xs, env)), eN(b, env)),
        same_add(tP(x, env), tN(x, env), tP(x, env), tN(x, env), eP(m2, env), eN(m2, env), Nat.add(eP(xs, env), eP(b, env)), Nat.add(eN(xs, env), eN(b, env)), same_refl(tP(x, env), tN(x, env)), ih),
        gt_s(tP(x, env), eP(xs, env), eP(b, env)), gt_s(tN(x, env), eN(xs, env), eN(b, env)))
    case +x <> +xs +y <> +ys LT{}:
      +ih = merge_v(a, ys, P.hcmp(a, ys), env, {==})
      +m2 = P.merge(a, ys, P.hcmp(a, ys))
      same_rw(Nat.add(tP(y, env), eP(m2, env)), Nat.add(tN(y, env), eN(m2, env)), Nat.add(tP(y, env), Nat.add(eP(a, env), eP(ys, env))), Nat.add(tN(y, env), Nat.add(eN(a, env), eN(ys, env))), Nat.add(eP(a, env), Nat.add(tP(y, env), eP(ys, env))), Nat.add(eN(a, env), Nat.add(tN(y, env), eN(ys, env))),
        same_add(tP(y, env), tN(y, env), tP(y, env), tN(y, env), eP(m2, env), eN(m2, env), Nat.add(eP(a, env), eP(ys, env)), Nat.add(eN(a, env), eN(ys, env)), same_refl(tP(y, env), tN(y, env)), ih),
        lt_s(tP(y, env), eP(a, env), eP(ys, env)), lt_s(tN(y, env), eN(a, env), eN(ys, env)))
    case +x <> +xs +y <> +ys EQ{}:
      eq_case(x, y, xs, ys, env, ho, merge_v(xs, ys, P.hcmp(xs, ys), env, {==}))

def padd_v(+a: List<&2, P.Tm>, +b: List<&2, P.Tm>, +env: List<&2, Nat>) -> Same(eP(P.padd(a, b), env), eN(P.padd(a, b), env), Nat.add(eP(a, env), eP(b, env)), Nat.add(eN(a, env), eN(b, env))):
  merge_v(a, b, P.hcmp(a, b), env, {==})

def psub_v(+a: List<&2, P.Tm>, +b: List<&2, P.Tm>, +env: List<&2, Nat>) -> Same(eP(P.psub(a, b), env), eN(P.psub(a, b), env), Nat.add(eP(a, env), eN(b, env)), Nat.add(eN(a, env), eP(b, env))):
  same_rw(eP(P.psub(a, b), env), eN(P.psub(a, b), env), Nat.add(eP(a, env), eP(P.pneg(b), env)), Nat.add(eN(a, env), eN(P.pneg(b), env)), Nat.add(eP(a, env), eN(b, env)), Nat.add(eN(a, env), eP(b, env)),
    padd_v(a, P.pneg(b), env),
    Equal.cong(Nat, Nat, z => Nat.add(eP(a, env), z), eP(P.pneg(b), env), eN(b, env), pneg_p(b, env)),
    Equal.cong(Nat, Nat, z => Nat.add(eN(a, env), z), eN(P.pneg(b), env), eP(b, env), pneg_n(b, env)))

# ---- products ----

def pm_s(+tp: Nat, +tn: Nat, +xp: Nat, +xn: Nat, +bp: Nat, +bn: Nat) -> {Nat.add(Nat.add(Nat.mul(tp, bp), Nat.mul(tn, bn)), Nat.add(Nat.mul(xp, bp), Nat.mul(xn, bn))) == Nat.add(Nat.mul(Nat.add(tp, xp), bp), Nat.mul(Nat.add(tn, xn), bn)) : Nat}:
  %Equal.sym(Nat, Nat.mul(tp, bp), Nat.mul(bp, tp), NA.mul_comm(tp, bp)) : {Nat.add(Nat.add(_, Nat.mul(tn, bn)), Nat.add(Nat.mul(xp, bp), Nat.mul(xn, bn))) == Nat.add(Nat.mul(Nat.add(tp, xp), bp), Nat.mul(Nat.add(tn, xn), bn)) : Nat}
  %Equal.sym(Nat, Nat.mul(tn, bn), Nat.mul(bn, tn), NA.mul_comm(tn, bn)) : {Nat.add(Nat.add(Nat.mul(bp, tp), _), Nat.add(Nat.mul(xp, bp), Nat.mul(xn, bn))) == Nat.add(Nat.mul(Nat.add(tp, xp), bp), Nat.mul(Nat.add(tn, xn), bn)) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.mul(bp, tp), Nat.mul(bn, tn)), Nat.add(Nat.mul(bn, tn), Nat.mul(bp, tp)), NA.add_comm(Nat.mul(bp, tp), Nat.mul(bn, tn))) : {Nat.add(_, Nat.add(Nat.mul(xp, bp), Nat.mul(xn, bn))) == Nat.add(Nat.mul(Nat.add(tp, xp), bp), Nat.mul(Nat.add(tn, xn), bn)) : Nat}
  %Equal.sym(Nat, Nat.mul(xp, bp), Nat.mul(bp, xp), NA.mul_comm(xp, bp)) : {Nat.add(Nat.add(Nat.mul(bn, tn), Nat.mul(bp, tp)), Nat.add(_, Nat.mul(xn, bn))) == Nat.add(Nat.mul(Nat.add(tp, xp), bp), Nat.mul(Nat.add(tn, xn), bn)) : Nat}
  %Equal.sym(Nat, Nat.mul(xn, bn), Nat.mul(bn, xn), NA.mul_comm(xn, bn)) : {Nat.add(Nat.add(Nat.mul(bn, tn), Nat.mul(bp, tp)), Nat.add(Nat.mul(bp, xp), _)) == Nat.add(Nat.mul(Nat.add(tp, xp), bp), Nat.mul(Nat.add(tn, xn), bn)) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.mul(bp, xp), Nat.mul(bn, xn)), Nat.add(Nat.mul(bn, xn), Nat.mul(bp, xp)), NA.add_comm(Nat.mul(bp, xp), Nat.mul(bn, xn))) : {Nat.add(Nat.add(Nat.mul(bn, tn), Nat.mul(bp, tp)), _) == Nat.add(Nat.mul(Nat.add(tp, xp), bp), Nat.mul(Nat.add(tn, xn), bn)) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.add(Nat.mul(bn, tn), Nat.mul(bp, tp)), Nat.add(Nat.mul(bn, xn), Nat.mul(bp, xp))), Nat.add(Nat.mul(bn, tn), Nat.add(Nat.mul(bp, tp), Nat.add(Nat.mul(bn, xn), Nat.mul(bp, xp)))), NA.add_assoc(Nat.mul(bn, tn), Nat.mul(bp, tp), Nat.add(Nat.mul(bn, xn), Nat.mul(bp, xp)))) : {_ == Nat.add(Nat.mul(Nat.add(tp, xp), bp), Nat.mul(Nat.add(tn, xn), bn)) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.mul(bp, tp), Nat.add(Nat.mul(bn, xn), Nat.mul(bp, xp))), Nat.add(Nat.mul(bn, xn), Nat.add(Nat.mul(bp, tp), Nat.mul(bp, xp))), NA.add_swap(Nat.mul(bp, tp), Nat.mul(bn, xn), Nat.mul(bp, xp))) : {Nat.add(Nat.mul(bn, tn), _) == Nat.add(Nat.mul(Nat.add(tp, xp), bp), Nat.mul(Nat.add(tn, xn), bn)) : Nat}
  %Equal.sym(Nat, Nat.mul(Nat.add(tp, xp), bp), Nat.add(Nat.mul(tp, bp), Nat.mul(xp, bp)), NA.mul_add_right(tp, xp, bp)) : {Nat.add(Nat.mul(bn, tn), Nat.add(Nat.mul(bn, xn), Nat.add(Nat.mul(bp, tp), Nat.mul(bp, xp)))) == Nat.add(_, Nat.mul(Nat.add(tn, xn), bn)) : Nat}
  %Equal.sym(Nat, Nat.mul(tp, bp), Nat.mul(bp, tp), NA.mul_comm(tp, bp)) : {Nat.add(Nat.mul(bn, tn), Nat.add(Nat.mul(bn, xn), Nat.add(Nat.mul(bp, tp), Nat.mul(bp, xp)))) == Nat.add(Nat.add(_, Nat.mul(xp, bp)), Nat.mul(Nat.add(tn, xn), bn)) : Nat}
  %Equal.sym(Nat, Nat.mul(xp, bp), Nat.mul(bp, xp), NA.mul_comm(xp, bp)) : {Nat.add(Nat.mul(bn, tn), Nat.add(Nat.mul(bn, xn), Nat.add(Nat.mul(bp, tp), Nat.mul(bp, xp)))) == Nat.add(Nat.add(Nat.mul(bp, tp), _), Nat.mul(Nat.add(tn, xn), bn)) : Nat}
  %Equal.sym(Nat, Nat.mul(Nat.add(tn, xn), bn), Nat.add(Nat.mul(tn, bn), Nat.mul(xn, bn)), NA.mul_add_right(tn, xn, bn)) : {Nat.add(Nat.mul(bn, tn), Nat.add(Nat.mul(bn, xn), Nat.add(Nat.mul(bp, tp), Nat.mul(bp, xp)))) == Nat.add(Nat.add(Nat.mul(bp, tp), Nat.mul(bp, xp)), _) : Nat}
  %Equal.sym(Nat, Nat.mul(tn, bn), Nat.mul(bn, tn), NA.mul_comm(tn, bn)) : {Nat.add(Nat.mul(bn, tn), Nat.add(Nat.mul(bn, xn), Nat.add(Nat.mul(bp, tp), Nat.mul(bp, xp)))) == Nat.add(Nat.add(Nat.mul(bp, tp), Nat.mul(bp, xp)), Nat.add(_, Nat.mul(xn, bn))) : Nat}
  %Equal.sym(Nat, Nat.mul(xn, bn), Nat.mul(bn, xn), NA.mul_comm(xn, bn)) : {Nat.add(Nat.mul(bn, tn), Nat.add(Nat.mul(bn, xn), Nat.add(Nat.mul(bp, tp), Nat.mul(bp, xp)))) == Nat.add(Nat.add(Nat.mul(bp, tp), Nat.mul(bp, xp)), Nat.add(Nat.mul(bn, tn), _)) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.add(Nat.mul(bp, tp), Nat.mul(bp, xp)), Nat.add(Nat.mul(bn, tn), Nat.mul(bn, xn))), Nat.add(Nat.mul(bp, tp), Nat.add(Nat.mul(bp, xp), Nat.add(Nat.mul(bn, tn), Nat.mul(bn, xn)))), NA.add_assoc(Nat.mul(bp, tp), Nat.mul(bp, xp), Nat.add(Nat.mul(bn, tn), Nat.mul(bn, xn)))) : {Nat.add(Nat.mul(bn, tn), Nat.add(Nat.mul(bn, xn), Nat.add(Nat.mul(bp, tp), Nat.mul(bp, xp)))) == _ : Nat}
  %Equal.sym(Nat, Nat.add(Nat.mul(bp, xp), Nat.add(Nat.mul(bn, tn), Nat.mul(bn, xn))), Nat.add(Nat.mul(bn, tn), Nat.add(Nat.mul(bp, xp), Nat.mul(bn, xn))), NA.add_swap(Nat.mul(bp, xp), Nat.mul(bn, tn), Nat.mul(bn, xn))) : {Nat.add(Nat.mul(bn, tn), Nat.add(Nat.mul(bn, xn), Nat.add(Nat.mul(bp, tp), Nat.mul(bp, xp)))) == Nat.add(Nat.mul(bp, tp), _) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.mul(bp, xp), Nat.mul(bn, xn)), Nat.add(Nat.mul(bn, xn), Nat.mul(bp, xp)), NA.add_comm(Nat.mul(bp, xp), Nat.mul(bn, xn))) : {Nat.add(Nat.mul(bn, tn), Nat.add(Nat.mul(bn, xn), Nat.add(Nat.mul(bp, tp), Nat.mul(bp, xp)))) == Nat.add(Nat.mul(bp, tp), Nat.add(Nat.mul(bn, tn), _)) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.mul(bp, tp), Nat.add(Nat.mul(bn, tn), Nat.add(Nat.mul(bn, xn), Nat.mul(bp, xp)))), Nat.add(Nat.mul(bn, tn), Nat.add(Nat.mul(bp, tp), Nat.add(Nat.mul(bn, xn), Nat.mul(bp, xp)))), NA.add_swap(Nat.mul(bp, tp), Nat.mul(bn, tn), Nat.add(Nat.mul(bn, xn), Nat.mul(bp, xp)))) : {Nat.add(Nat.mul(bn, tn), Nat.add(Nat.mul(bn, xn), Nat.add(Nat.mul(bp, tp), Nat.mul(bp, xp)))) == _ : Nat}
  %Equal.sym(Nat, Nat.add(Nat.mul(bp, tp), Nat.add(Nat.mul(bn, xn), Nat.mul(bp, xp))), Nat.add(Nat.mul(bn, xn), Nat.add(Nat.mul(bp, tp), Nat.mul(bp, xp))), NA.add_swap(Nat.mul(bp, tp), Nat.mul(bn, xn), Nat.mul(bp, xp))) : {Nat.add(Nat.mul(bn, tn), Nat.add(Nat.mul(bn, xn), Nat.add(Nat.mul(bp, tp), Nat.mul(bp, xp)))) == Nat.add(Nat.mul(bn, tn), _) : Nat}
  {==}

def pmul_v(a: List<&2, P.Tm>, +b: List<&2, P.Tm>, +env: List<&2, Nat>) -> Same(eP(P.pmul(a, b), env), eN(P.pmul(a, b), env), Nat.add(Nat.mul(eP(a, env), eP(b, env)), Nat.mul(eN(a, env), eN(b, env))), Nat.add(Nat.mul(eP(a, env), eN(b, env)), Nat.mul(eN(a, env), eP(b, env)))):
  match a:
    case Nil{}:
      {==}
    case +x <> +xs:
      +t = P.tmul(x, b)
      +r = P.pmul(xs, b)
      +h1 = padd_v(t, r, env)
      +h2 = same_add(eP(t, env), eN(t, env), eP(t, env), eN(t, env), eP(r, env), eN(r, env), Nat.add(Nat.mul(eP(xs, env), eP(b, env)), Nat.mul(eN(xs, env), eN(b, env))), Nat.add(Nat.mul(eP(xs, env), eN(b, env)), Nat.mul(eN(xs, env), eP(b, env))), same_refl(eP(t, env), eN(t, env)), pmul_v(xs, b, env))
      +h3 = same_trans(eP(P.padd(t, r), env), eN(P.padd(t, r), env), Nat.add(eP(t, env), eP(r, env)), Nat.add(eN(t, env), eN(r, env)), Nat.add(eP(t, env), Nat.add(Nat.mul(eP(xs, env), eP(b, env)), Nat.mul(eN(xs, env), eN(b, env)))), Nat.add(eN(t, env), Nat.add(Nat.mul(eP(xs, env), eN(b, env)), Nat.mul(eN(xs, env), eP(b, env)))), h1, h2)
      +hc = Equal.trans(Nat, Nat.add(eP(t, env), Nat.add(Nat.mul(eP(xs, env), eP(b, env)), Nat.mul(eN(xs, env), eN(b, env)))), Nat.add(Nat.add(Nat.mul(tP(x, env), eP(b, env)), Nat.mul(tN(x, env), eN(b, env))), Nat.add(Nat.mul(eP(xs, env), eP(b, env)), Nat.mul(eN(xs, env), eN(b, env)))), Nat.add(Nat.mul(Nat.add(tP(x, env), eP(xs, env)), eP(b, env)), Nat.mul(Nat.add(tN(x, env), eN(xs, env)), eN(b, env))),
        Equal.cong(Nat, Nat, z => Nat.add(z, Nat.add(Nat.mul(eP(xs, env), eP(b, env)), Nat.mul(eN(xs, env), eN(b, env)))), eP(t, env), Nat.add(Nat.mul(tP(x, env), eP(b, env)), Nat.mul(tN(x, env), eN(b, env))), tmul_p(x, b, env)),
        pm_s(tP(x, env), tN(x, env), eP(xs, env), eN(xs, env), eP(b, env), eN(b, env)))
      +hd = Equal.trans(Nat, Nat.add(eN(t, env), Nat.add(Nat.mul(eP(xs, env), eN(b, env)), Nat.mul(eN(xs, env), eP(b, env)))), Nat.add(Nat.add(Nat.mul(tP(x, env), eN(b, env)), Nat.mul(tN(x, env), eP(b, env))), Nat.add(Nat.mul(eP(xs, env), eN(b, env)), Nat.mul(eN(xs, env), eP(b, env)))), Nat.add(Nat.mul(Nat.add(tP(x, env), eP(xs, env)), eN(b, env)), Nat.mul(Nat.add(tN(x, env), eN(xs, env)), eP(b, env))),
        Equal.cong(Nat, Nat, z => Nat.add(z, Nat.add(Nat.mul(eP(xs, env), eN(b, env)), Nat.mul(eN(xs, env), eP(b, env)))), eN(t, env), Nat.add(Nat.mul(tP(x, env), eN(b, env)), Nat.mul(tN(x, env), eP(b, env))), tmul_n(x, b, env)),
        pm_s(tP(x, env), tN(x, env), eP(xs, env), eN(xs, env), eN(b, env), eP(b, env)))
      same_rw(eP(P.padd(t, r), env), eN(P.padd(t, r), env), Nat.add(eP(t, env), Nat.add(Nat.mul(eP(xs, env), eP(b, env)), Nat.mul(eN(xs, env), eN(b, env)))), Nat.add(eN(t, env), Nat.add(Nat.mul(eP(xs, env), eN(b, env)), Nat.mul(eN(xs, env), eP(b, env)))), Nat.add(Nat.mul(Nat.add(tP(x, env), eP(xs, env)), eP(b, env)), Nat.mul(Nat.add(tN(x, env), eN(xs, env)), eN(b, env))), Nat.add(Nat.mul(Nat.add(tP(x, env), eP(xs, env)), eN(b, env)), Nat.mul(Nat.add(tN(x, env), eN(xs, env)), eP(b, env))), h3, hc, hd)
