# Binary natural numbers for closed computation in the proof checker.
#
# The checker keeps Nat in unary and U32 as a list of 32 bits, so neither
# multiplies big closed numbers in reasonable time. Bn is a little-endian
# list of bits (B0{t} = 2 t, B1{t} = 2 t + 1, BZ{} = 0; leading zeros are
# allowed), with addition, product and equality defined here by structural
# recursion; the lemmas give their values (bval) in Nat, for every input,
# so a closed Bn computation checked by {==} proves a Nat fact.

type Bn is Data:
  BZ{}
  B0{t: Bn}
  B1{t: Bn}

def bval(a: Bn) -> Nat:
  match a:
    case BZ{}:
      0n
    case B0{+t}:
      Nat.add(bval(t), bval(t))
    case B1{+t}:
      1n+Nat.add(bval(t), bval(t))

def binc(a: Bn) -> Bn:
  match a:
    case BZ{}:
      B1{BZ{}}
    case B0{t}:
      B1{t}
    case B1{t}:
      B0{binc(t)}

def badd(a: Bn, b: Bn) -> Bn:
  match a b:
    case BZ{} y:
      y
    case B0{x} BZ{}:
      B0{x}
    case B1{x} BZ{}:
      B1{x}
    case B0{x} B0{y}:
      B0{badd(x, y)}
    case B0{x} B1{y}:
      B1{badd(x, y)}
    case B1{x} B0{y}:
      B1{badd(x, y)}
    case B1{x} B1{y}:
      B0{binc(badd(x, y))}

def bmul(a: Bn, +b: Bn) -> Bn:
  match a:
    case BZ{}:
      BZ{}
    case B0{t}:
      B0{bmul(t, b)}
    case B1{t}:
      badd(b, B0{bmul(t, b)})

# equal values (leading zeros ignored)
def beq(a: Bn, b: Bn) -> Bool:
  match a b:
    case BZ{} BZ{}:
      True{}
    case BZ{} B0{y}:
      beq(BZ{}, y)
    case BZ{} B1{y}:
      False{}
    case B0{x} BZ{}:
      beq(x, BZ{})
    case B1{x} BZ{}:
      False{}
    case B0{x} B0{y}:
      beq(x, y)
    case B1{x} B1{y}:
      beq(x, y)
    case B0{x} B1{y}:
      False{}
    case B1{x} B0{y}:
      False{}

# the binary form of a (small) unary number
def nbin(n: Nat) -> Bn:
  match n:
    case 0n:
      BZ{}
    case 1n+k:
      binc(nbin(k))

