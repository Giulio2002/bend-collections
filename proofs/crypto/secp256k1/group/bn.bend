      %Equal.sym(Nat, Nat.add(Nat.add(bval(y), 1n), Nat.add(bval(x), Nat.add(bval(y), 1n))), Nat.add(bval(y), Nat.add(1n, Nat.add(bval(x), Nat.add(bval(y), 1n)))), NA.add_assoc(bval(y), 1n, Nat.add(bval(x), Nat.add(bval(y), 1n)))) : {Nat.add(bval(x), _) == Nat.add(1n+Nat.add(bval(x), bval(x)), 1n+Nat.add(bval(y), bval(y))) : Nat}
      %Equal.sym(Nat, Nat.add(1n, Nat.add(bval(x), Nat.add(bval(y), 1n))), Nat.add(bval(x), Nat.add(1n, Nat.add(bval(y), 1n))), NA.add_swap(1n, bval(x), Nat.add(bval(y), 1n))) : {Nat.add(bval(x), Nat.add(bval(y), _)) == Nat.add(1n+Nat.add(bval(x), bval(x)), 1n+Nat.add(bval(y), bval(y))) : Nat}
      %Equal.sym(Nat, Nat.add(1n, Nat.add(bval(y), 1n)), Nat.add(bval(y), Nat.add(1n, 1n)), NA.add_swap(1n, bval(y), 1n)) : {Nat.add(bval(x), Nat.add(bval(y), Nat.add(bval(x), _))) == Nat.add(1n+Nat.add(bval(x), bval(x)), 1n+Nat.add(bval(y), bval(y))) : Nat}
      %Equal.sym(Nat, Nat.add(1n, 1n), 2n, {==}) : {Nat.add(bval(x), Nat.add(bval(y), Nat.add(bval(x), Nat.add(bval(y), _)))) == Nat.add(1n+Nat.add(bval(x), bval(x)), 1n+Nat.add(bval(y), bval(y))) : Nat}
      %Equal.sym(Nat, Nat.add(bval(y), Nat.add(bval(x), Nat.add(bval(y), 2n))), Nat.add(bval(x), Nat.add(bval(y), Nat.add(bval(y), 2n))), NA.add_swap(bval(y), bval(x), Nat.add(bval(y), 2n))) : {Nat.add(bval(x), _) == Nat.add(1n+Nat.add(bval(x), bval(x)), 1n+Nat.add(bval(y), bval(y))) : Nat}
      %Equal.sym(Nat, 1n+Nat.add(bval(x), bval(x)), Nat.add(Nat.add(bval(x), bval(x)), 1n), SR.succ_add(1n, Nat.add(bval(x), bval(x)))) : {Nat.add(bval(x), Nat.add(bval(x), Nat.add(bval(y), Nat.add(bval(y), 2n)))) == Nat.add(_, 1n+Nat.add(bval(y), bval(y))) : Nat}
      %Equal.sym(Nat, Nat.add(Nat.add(bval(x), bval(x)), 1n), Nat.add(bval(x), Nat.add(bval(x), 1n)), NA.add_assoc(bval(x), bval(x), 1n)) : {Nat.add(bval(x), Nat.add(bval(x), Nat.add(bval(y), Nat.add(bval(y), 2n)))) == Nat.add(_, 1n+Nat.add(bval(y), bval(y))) : Nat}
      %Equal.sym(Nat, 1n+Nat.add(bval(y), bval(y)), Nat.add(Nat.add(bval(y), bval(y)), 1n), SR.succ_add(1n, Nat.add(bval(y), bval(y)))) : {Nat.add(bval(x), Nat.add(bval(x), Nat.add(bval(y), Nat.add(bval(y), 2n)))) == Nat.add(Nat.add(bval(x), Nat.add(bval(x), 1n)), _) : Nat}
      %Equal.sym(Nat, Nat.add(Nat.add(bval(y), bval(y)), 1n), Nat.add(bval(y), Nat.add(bval(y), 1n)), NA.add_assoc(bval(y), bval(y), 1n)) : {Nat.add(bval(x), Nat.add(bval(x), Nat.add(bval(y), Nat.add(bval(y), 2n)))) == Nat.add(Nat.add(bval(x), Nat.add(bval(x), 1n)), _) : Nat}
      %Equal.sym(Nat, Nat.add(Nat.add(bval(x), Nat.add(bval(x), 1n)), Nat.add(bval(y), Nat.add(bval(y), 1n))), Nat.add(bval(x), Nat.add(Nat.add(bval(x), 1n), Nat.add(bval(y), Nat.add(bval(y), 1n)))), NA.add_assoc(bval(x), Nat.add(bval(x), 1n), Nat.add(bval(y), Nat.add(bval(y), 1n)))) : {Nat.add(bval(x), Nat.add(bval(x), Nat.add(bval(y), Nat.add(bval(y), 2n)))) == _ : Nat}
      %Equal.sym(Nat, Nat.add(Nat.add(bval(x), 1n), Nat.add(bval(y), Nat.add(bval(y), 1n))), Nat.add(bval(x), Nat.add(1n, Nat.add(bval(y), Nat.add(bval(y), 1n)))), NA.add_assoc(bval(x), 1n, Nat.add(bval(y), Nat.add(bval(y), 1n)))) : {Nat.add(bval(x), Nat.add(bval(x), Nat.add(bval(y), Nat.add(bval(y), 2n)))) == Nat.add(bval(x), _) : Nat}
      %Equal.sym(Nat, Nat.add(1n, Nat.add(bval(y), Nat.add(bval(y), 1n))), Nat.add(bval(y), Nat.add(1n, Nat.add(bval(y), 1n))), NA.add_swap(1n, bval(y), Nat.add(bval(y), 1n))) : {Nat.add(bval(x), Nat.add(bval(x), Nat.add(bval(y), Nat.add(bval(y), 2n)))) == Nat.add(bval(x), Nat.add(bval(x), _)) : Nat}
      %Equal.sym(Nat, Nat.add(1n, Nat.add(bval(y), 1n)), Nat.add(bval(y), Nat.add(1n, 1n)), NA.add_swap(1n, bval(y), 1n)) : {Nat.add(bval(x), Nat.add(bval(x), Nat.add(bval(y), Nat.add(bval(y), 2n)))) == Nat.add(bval(x), Nat.add(bval(x), Nat.add(bval(y), _))) : Nat}
      %Equal.sym(Nat, Nat.add(1n, 1n), 2n, {==}) : {Nat.add(bval(x), Nat.add(bval(x), Nat.add(bval(y), Nat.add(bval(y), 2n)))) == Nat.add(bval(x), Nat.add(bval(x), Nat.add(bval(y), Nat.add(bval(y), _)))) : Nat}
      {==}

def bmul_v(a: Bn, +b: Bn) -> {bval(bmul(a, b)) == Nat.mul(bval(a), bval(b)) : Nat}:
  match a:
    case BZ{}:
      {==}
    case B0{+t}:
      %Equal.sym(Nat, bval(bmul(t, b)), Nat.mul(bval(t), bval(b)), bmul_v(t, b)) : {Nat.add(_, bval(bmul(t, b))) == Nat.mul(Nat.add(bval(t), bval(t)), bval(b)) : Nat}
      %Equal.sym(Nat, bval(bmul(t, b)), Nat.mul(bval(t), bval(b)), bmul_v(t, b)) : {Nat.add(Nat.mul(bval(t), bval(b)), _) == Nat.mul(Nat.add(bval(t), bval(t)), bval(b)) : Nat}
      %Equal.sym(Nat, Nat.mul(bval(t), bval(b)), Nat.mul(bval(b), bval(t)), NA.mul_comm(bval(t), bval(b))) : {Nat.add(_, Nat.mul(bval(t), bval(b))) == Nat.mul(Nat.add(bval(t), bval(t)), bval(b)) : Nat}
      %Equal.sym(Nat, Nat.mul(bval(t), bval(b)), Nat.mul(bval(b), bval(t)), NA.mul_comm(bval(t), bval(b))) : {Nat.add(Nat.mul(bval(b), bval(t)), _) == Nat.mul(Nat.add(bval(t), bval(t)), bval(b)) : Nat}
      %Equal.sym(Nat, Nat.mul(Nat.add(bval(t), bval(t)), bval(b)), Nat.add(Nat.mul(bval(t), bval(b)), Nat.mul(bval(t), bval(b))), NA.mul_add_right(bval(t), bval(t), bval(b))) : {Nat.add(Nat.mul(bval(b), bval(t)), Nat.mul(bval(b), bval(t))) == _ : Nat}
      %Equal.sym(Nat, Nat.mul(bval(t), bval(b)), Nat.mul(bval(b), bval(t)), NA.mul_comm(bval(t), bval(b))) : {Nat.add(Nat.mul(bval(b), bval(t)), Nat.mul(bval(b), bval(t))) == Nat.add(_, Nat.mul(bval(t), bval(b))) : Nat}
      %Equal.sym(Nat, Nat.mul(bval(t), bval(b)), Nat.mul(bval(b), bval(t)), NA.mul_comm(bval(t), bval(b))) : {Nat.add(Nat.mul(bval(b), bval(t)), Nat.mul(bval(b), bval(t))) == Nat.add(Nat.mul(bval(b), bval(t)), _) : Nat}
      {==}
    case B1{+t}:
      %Equal.sym(Nat, bval(badd(b, B0{bmul(t, b)})), Nat.add(bval(b), bval(B0{bmul(t, b)})), badd_v(b, B0{bmul(t, b)})) : {_ == Nat.mul(1n+Nat.add(bval(t), bval(t)), bval(b)) : Nat}
      %Equal.sym(Nat, bval(bmul(t, b)), Nat.mul(bval(t), bval(b)), bmul_v(t, b)) : {Nat.add(bval(b), Nat.add(_, bval(bmul(t, b)))) == Nat.mul(1n+Nat.add(bval(t), bval(t)), bval(b)) : Nat}
      %Equal.sym(Nat, bval(bmul(t, b)), Nat.mul(bval(t), bval(b)), bmul_v(t, b)) : {Nat.add(bval(b), Nat.add(Nat.mul(bval(t), bval(b)), _)) == Nat.mul(1n+Nat.add(bval(t), bval(t)), bval(b)) : Nat}
      %Equal.sym(Nat, Nat.mul(bval(t), bval(b)), Nat.mul(bval(b), bval(t)), NA.mul_comm(bval(t), bval(b))) : {Nat.add(bval(b), Nat.add(_, Nat.mul(bval(t), bval(b)))) == Nat.mul(1n+Nat.add(bval(t), bval(t)), bval(b)) : Nat}
      %Equal.sym(Nat, Nat.mul(bval(t), bval(b)), Nat.mul(bval(b), bval(t)), NA.mul_comm(bval(t), bval(b))) : {Nat.add(bval(b), Nat.add(Nat.mul(bval(b), bval(t)), _)) == Nat.mul(1n+Nat.add(bval(t), bval(t)), bval(b)) : Nat}
      %Equal.sym(Nat, 1n+Nat.add(bval(t), bval(t)), Nat.add(Nat.add(bval(t), bval(t)), 1n), SR.succ_add(1n, Nat.add(bval(t), bval(t)))) : {Nat.add(bval(b), Nat.add(Nat.mul(bval(b), bval(t)), Nat.mul(bval(b), bval(t)))) == Nat.mul(_, bval(b)) : Nat}
      %Equal.sym(Nat, Nat.add(Nat.add(bval(t), bval(t)), 1n), Nat.add(bval(t), Nat.add(bval(t), 1n)), NA.add_assoc(bval(t), bval(t), 1n)) : {Nat.add(bval(b), Nat.add(Nat.mul(bval(b), bval(t)), Nat.mul(bval(b), bval(t)))) == Nat.mul(_, bval(b)) : Nat}
      %Equal.sym(Nat, Nat.mul(Nat.add(bval(t), Nat.add(bval(t), 1n)), bval(b)), Nat.add(Nat.mul(bval(t), bval(b)), Nat.mul(Nat.add(bval(t), 1n), bval(b))), NA.mul_add_right(bval(t), Nat.add(bval(t), 1n), bval(b))) : {Nat.add(bval(b), Nat.add(Nat.mul(bval(b), bval(t)), Nat.mul(bval(b), bval(t)))) == _ : Nat}
      %Equal.sym(Nat, Nat.mul(bval(t), bval(b)), Nat.mul(bval(b), bval(t)), NA.mul_comm(bval(t), bval(b))) : {Nat.add(bval(b), Nat.add(Nat.mul(bval(b), bval(t)), Nat.mul(bval(b), bval(t)))) == Nat.add(_, Nat.mul(Nat.add(bval(t), 1n), bval(b))) : Nat}
      %Equal.sym(Nat, Nat.mul(Nat.add(bval(t), 1n), bval(b)), Nat.add(Nat.mul(bval(t), bval(b)), Nat.mul(1n, bval(b))), NA.mul_add_right(bval(t), 1n, bval(b))) : {Nat.add(bval(b), Nat.add(Nat.mul(bval(b), bval(t)), Nat.mul(bval(b), bval(t)))) == Nat.add(Nat.mul(bval(b), bval(t)), _) : Nat}
      %Equal.sym(Nat, Nat.mul(bval(t), bval(b)), Nat.mul(bval(b), bval(t)), NA.mul_comm(bval(t), bval(b))) : {Nat.add(bval(b), Nat.add(Nat.mul(bval(b), bval(t)), Nat.mul(bval(b), bval(t)))) == Nat.add(Nat.mul(bval(b), bval(t)), Nat.add(_, Nat.mul(1n, bval(b)))) : Nat}
      %Equal.sym(Nat, Nat.mul(1n, bval(b)), bval(b), SR.one_mul(bval(b))) : {Nat.add(bval(b), Nat.add(Nat.mul(bval(b), bval(t)), Nat.mul(bval(b), bval(t)))) == Nat.add(Nat.mul(bval(b), bval(t)), Nat.add(Nat.mul(bval(b), bval(t)), _)) : Nat}
      %Equal.sym(Nat, Nat.add(Nat.mul(bval(b), bval(t)), bval(b)), Nat.add(bval(b), Nat.mul(bval(b), bval(t))), NA.add_comm(Nat.mul(bval(b), bval(t)), bval(b))) : {Nat.add(bval(b), Nat.add(Nat.mul(bval(b), bval(t)), Nat.mul(bval(b), bval(t)))) == Nat.add(Nat.mul(bval(b), bval(t)), _) : Nat}
      %Equal.sym(Nat, Nat.add(Nat.mul(bval(b), bval(t)), Nat.add(bval(b), Nat.mul(bval(b), bval(t)))), Nat.add(bval(b), Nat.add(Nat.mul(bval(b), bval(t)), Nat.mul(bval(b), bval(t)))), NA.add_swap(Nat.mul(bval(b), bval(t)), bval(b), Nat.mul(bval(b), bval(t)))) : {Nat.add(bval(b), Nat.add(Nat.mul(bval(b), bval(t)), Nat.mul(bval(b), bval(t)))) == _ : Nat}
      {==}

def beq_v(a: Bn, b: Bn, +h: {beq(a, b) == True{} : Bool}) -> {bval(a) == bval(b) : Nat}:
  match a b:
    case BZ{} BZ{}:
      {==}
    case BZ{} B0{+y}:
      %Equal.sym(Nat, bval(y), bval(BZ{}), Equal.sym(Nat, bval(BZ{}), bval(y), beq_v(BZ{}, y, h))) : {0n == Nat.add(_, bval(y)) : Nat}
      %Equal.sym(Nat, bval(y), bval(BZ{}), Equal.sym(Nat, bval(BZ{}), bval(y), beq_v(BZ{}, y, h))) : {0n == Nat.add(bval(BZ{}), _) : Nat}
      {==}
    case BZ{} B1{y}:
      Empty.absurd({0n == 1n+Nat.add(bval(y), bval(y)) : Nat}, Lg.false_true(h))
    case B0{+x} BZ{}:
      %Equal.sym(Nat, bval(x), bval(BZ{}), beq_v(x, BZ{}, h)) : {Nat.add(_, bval(x)) == 0n : Nat}
      %Equal.sym(Nat, bval(x), bval(BZ{}), beq_v(x, BZ{}, h)) : {Nat.add(bval(BZ{}), _) == 0n : Nat}
      {==}
    case B1{x} BZ{}:
      Empty.absurd({1n+Nat.add(bval(x), bval(x)) == 0n : Nat}, Lg.false_true(h))
    case B0{+x} B0{+y}:
      %Equal.sym(Nat, bval(x), bval(y), beq_v(x, y, h)) : {Nat.add(_, bval(x)) == Nat.add(bval(y), bval(y)) : Nat}
      %Equal.sym(Nat, bval(x), bval(y), beq_v(x, y, h)) : {Nat.add(bval(y), _) == Nat.add(bval(y), bval(y)) : Nat}
      {==}
    case B1{+x} B1{+y}:
      %Equal.sym(Nat, bval(x), bval(y), beq_v(x, y, h)) : {1n+Nat.add(_, bval(x)) == 1n+Nat.add(bval(y), bval(y)) : Nat}
      %Equal.sym(Nat, bval(x), bval(y), beq_v(x, y, h)) : {1n+Nat.add(bval(y), _) == 1n+Nat.add(bval(y), bval(y)) : Nat}
      {==}
    case B0{x} B1{y}:
      Empty.absurd({Nat.add(bval(x), bval(x)) == 1n+Nat.add(bval(y), bval(y)) : Nat}, Lg.false_true(h))
    case B1{x} B0{y}:
      Empty.absurd({1n+Nat.add(bval(x), bval(x)) == Nat.add(bval(y), bval(y)) : Nat}, Lg.false_true(h))

def nbin_v(n: Nat) -> {bval(nbin(n)) == n : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+ +k:
      %Equal.sym(Nat, bval(binc(nbin(k))), 1n+bval(nbin(k)), binc_v(nbin(k))) : {_ == 1n+k : Nat}
      %Equal.sym(Nat, bval(nbin(k)), k, nbin_v(k)) : {1n+_ == 1n+k : Nat}
      {==}
