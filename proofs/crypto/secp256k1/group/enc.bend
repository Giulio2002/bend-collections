    IE.aff_curve(mp, x, y, z, FS.minv(1n+mp, z), N.eq_from_is_eq(FS.mmul(1n+mp, FS.mmul(1n+mp, y, y), z), FS.madd(1n+mp, FS.mmul(1n+mp, FS.mmul(1n+mp, x, x), x), FS.mmul(1n+mp, 7n, FS.mmul(1n+mp, FS.mmul(1n+mp, z, z), z))), Lg.and_left(GS.on_curve(1n+mp, CS.SPoint{x, y, z}), GS.y_nonzero(1n+mp, CS.SPoint{x, y, z}), hv)), Equal.sym(Nat, FS.mmul(1n+mp, z, FS.minv(1n+mp, z)), 1n, FD.inv_mod(1n+mp, hp, z, hz))))))

# ---- the round trips on the specification's encoders ----

def rt_u1(+one: Nat, +h1: {one == 1n : Nat}, +mp: Nat, +hp: PM.Prime(1n+mp), +s: Nat, +he: {Nat.add(1n+mp, 1n) == Nat.mul(s, 4n) : Nat}, +hodd: {Nat.mod(1n+mp, 2n) == 1n : Nat}, +h256: {Nat.is_le(1n+mp, C.shift(256n, one)) == True{} : Bool}, +x: Nat, +y: Nat, +hx: {Nat.is_lt(x, 1n+mp) == True{} : Bool}, +hy: {Nat.is_lt(y, 1n+mp) == True{} : Bool}, +hc: {CS.on_curve(1n+mp, x, y) == True{} : Bool}) -> {CS.decode(1n+mp, CS.encode_uncompressed(1n+mp, CS.SPoint{x, y, 1n})) == Some{CS.SPoint{x, y, 1n}} : Maybe<&2, CS.SPoint>}:
  %Equal.sym(CS.SAffine, CS.to_affine(1n+mp, CS.SPoint{x, y, 1n}), CS.SAffine{x, y}, aff_one(mp, hp, x, y, hx, hy)) : {CS.decode(1n+mp, CS.enc_u(_)) == Some{CS.SPoint{x, y, 1n}} : Maybe<&2, CS.SPoint>}
  dec_u(one, h1, mp, hp, s, he, hodd, h256, x, y, hx, hy, hc)

def rt_c1(+one: Nat, +h1: {one == 1n : Nat}, +mp: Nat, +hp: PM.Prime(1n+mp), +s: Nat, +he: {Nat.add(1n+mp, 1n) == Nat.mul(s, 4n) : Nat}, +hodd: {Nat.mod(1n+mp, 2n) == 1n : Nat}, +h256: {Nat.is_le(1n+mp, C.shift(256n, one)) == True{} : Bool}, +x: Nat, +y: Nat, +hx: {Nat.is_lt(x, 1n+mp) == True{} : Bool}, +hy: {Nat.is_lt(y, 1n+mp) == True{} : Bool}, +hc: {CS.on_curve(1n+mp, x, y) == True{} : Bool}) -> {CS.decode(1n+mp, CS.encode_compressed(1n+mp, CS.SPoint{x, y, 1n})) == Some{CS.SPoint{x, y, 1n}} : Maybe<&2, CS.SPoint>}:
  %Equal.sym(CS.SAffine, CS.to_affine(1n+mp, CS.SPoint{x, y, 1n}), CS.SAffine{x, y}, aff_one(mp, hp, x, y, hx, hy)) : {CS.decode(1n+mp, CS.enc_c(_)) == Some{CS.SPoint{x, y, 1n}} : Maybe<&2, CS.SPoint>}
  dec_c(one, h1, mp, hp, s, he, hodd, h256, x, y, hx, hy, hc)

# a point of the group with z != 0: decode(encode(a)) is its affine form
def rt_u(+one: Nat, +h1: {one == 1n : Nat}, +mp: Nat, +hp: PM.Prime(1n+mp), +s: Nat, +he: {Nat.add(1n+mp, 1n) == Nat.mul(s, 4n) : Nat}, +hodd: {Nat.mod(1n+mp, 2n) == 1n : Nat}, +h256: {Nat.is_le(1n+mp, C.shift(256n, one)) == True{} : Bool}, +x: Nat, +y: Nat, +z: Nat, +hv: {GS.valid(1n+mp, CS.SPoint{x, y, z}) == True{} : Bool}, +hz: F.NZ(mp, z)) -> {CS.decode(1n+mp, CS.encode_uncompressed(1n+mp, CS.SPoint{x, y, z})) == Some{CS.SPoint{FS.mmul(1n+mp, x, FS.minv(1n+mp, z)), FS.mmul(1n+mp, y, FS.minv(1n+mp, z)), 1n}} : Maybe<&2, CS.SPoint>}:
  dec_u(one, h1, mp, hp, s, he, hodd, h256, FS.mmul(1n+mp, x, FS.minv(1n+mp, z)), FS.mmul(1n+mp, y, FS.minv(1n+mp, z)), NR.dm_lt(mp, Nat.mul(x, FS.minv(1n+mp, z))), NR.dm_lt(mp, Nat.mul(y, FS.minv(1n+mp, z))), aff_on(mp, hp, x, y, z, hv, hz))

def rt_c(+one: Nat, +h1: {one == 1n : Nat}, +mp: Nat, +hp: PM.Prime(1n+mp), +s: Nat, +he: {Nat.add(1n+mp, 1n) == Nat.mul(s, 4n) : Nat}, +hodd: {Nat.mod(1n+mp, 2n) == 1n : Nat}, +h256: {Nat.is_le(1n+mp, C.shift(256n, one)) == True{} : Bool}, +x: Nat, +y: Nat, +z: Nat, +hv: {GS.valid(1n+mp, CS.SPoint{x, y, z}) == True{} : Bool}, +hz: F.NZ(mp, z)) -> {CS.decode(1n+mp, CS.encode_compressed(1n+mp, CS.SPoint{x, y, z})) == Some{CS.SPoint{FS.mmul(1n+mp, x, FS.minv(1n+mp, z)), FS.mmul(1n+mp, y, FS.minv(1n+mp, z)), 1n}} : Maybe<&2, CS.SPoint>}:
  dec_c(one, h1, mp, hp, s, he, hodd, h256, FS.mmul(1n+mp, x, FS.minv(1n+mp, z)), FS.mmul(1n+mp, y, FS.minv(1n+mp, z)), NR.dm_lt(mp, Nat.mul(x, FS.minv(1n+mp, z))), NR.dm_lt(mp, Nat.mul(y, FS.minv(1n+mp, z))), aff_on(mp, hp, x, y, z, hv, hz))
