def mul1(+mp: Nat, +x: Nat, +hx: {Nat.is_lt(x, 1n+mp) == True{} : Bool}) -> {FS.mmul(1n+mp, x, 1n) == x : Nat}:
  %Equal.sym(Nat, Nat.mul(x, 1n), x, NA.mul_one(x)) : {Nat.mod(_, 1n+mp) == x : Nat}
  SQ.mred(mp, x, hx)

