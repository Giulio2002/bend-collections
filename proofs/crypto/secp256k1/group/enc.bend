# ---- the affine form of a projective point ----

def pow_one(e: Nat) -> {Nat.pow(1n, e) == 1n : Nat}:
  match e:
    case 0n:
      {==}
    case 1n+ +k:
      %Equal.sym(Nat, Nat.pow(1n, k), 1n, pow_one(k)) : {Nat.mul(1n, _) == 1n : Nat}
      {==}

def lt1(+mp: Nat, +hp: PM.Prime(1n+mp)) -> {Nat.is_lt(1n, 1n+mp) == True{} : Bool}:
  PM.prime_ge2(1n+mp, hp)

def minv_one(+mp: Nat, +hp: PM.Prime(1n+mp)) -> {FS.minv(1n+mp, 1n) == 1n : Nat}:
