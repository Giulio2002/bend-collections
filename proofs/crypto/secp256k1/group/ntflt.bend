    case 0n:
      {==}
    case 1n+ +m:
      %Equal.sym(Nat, Nat.pow(Nat.add(x, 1n), m), bsum(m, m, x), binom(m, x)) : {Nat.mul(Nat.add(x, 1n), _) == bsum(1n+m, 1n+m, x) : Nat}
      %Equal.sym(Nat, bsum(1n+m, 1n+m, x), Nat.add(bsum(m, 1n+m, x), Nat.mul(x, bsum(m, m, x))), pascal(m, m, x)) : {Nat.mul(Nat.add(x, 1n), bsum(m, m, x)) == _ : Nat}
      %Equal.sym(Nat, S.choose(m, 1n+m), 0n, FA.choose_eq_zero(m, 1n+m, N.lt_succ(m))) : {Nat.mul(Nat.add(x, 1n), bsum(m, m, x)) == Nat.add(Nat.add(bsum(m, m, x), Nat.mul(_, Nat.pow(x, 1n+m))), Nat.mul(x, bsum(m, m, x))) : Nat}
      ring2(bsum(m, m, x), x, Nat.pow(x, 1n+m))

# C(n, n) == 1
def choose_self(n: Nat) -> {S.choose(n, n) == 1n : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+ +m:
      %Equal.sym(Nat, S.choose(m, m), 1n, choose_self(m)) : {Nat.add(_, S.choose(m, 1n+m)) == 1n : Nat}
      %Equal.sym(Nat, S.choose(m, 1n+m), 0n, FA.choose_eq_zero(m, 1n+m, N.lt_succ(m))) : {Nat.add(1n, _) == 1n : Nat}
      {==}

# ---- the middle coefficients vanish mod p ----

# 0 < k < n (n = 1 + bp): k mod n != 0
def small_nz(+bp: Nat, +k: Nat, +h: {Nat.is_lt(k, 1n+bp) == True{} : Bool}) -> {Nat.mod(k, 1n+bp) == k : Nat}:
  NR.mod_of(0n, bp, k, h)

def ck_eq(+pm: Nat, +j: Nat) -> {Nat.mul(1n+j, S.choose(1n+pm, 1n+j)) == Nat.mul(S.choose(pm, j), 1n+pm) : Nat}:
  %Equal.sym(Nat, Nat.mul(1n+j, S.choose(1n+pm, 1n+j)), Nat.mul(S.choose(1n+pm, 1n+j), 1n+j), NA.mul_comm(1n+j, S.choose(1n+pm, 1n+j))) : {_ == Nat.mul(S.choose(pm, j), 1n+pm) : Nat}
  %Equal.sym(Nat, Nat.mul(S.choose(1n+pm, 1n+j), 1n+j), Nat.mul(1n+pm, S.choose(pm, j)), Equal.sym(Nat, Nat.mul(1n+pm, S.choose(pm, j)), Nat.mul(S.choose(1n+pm, 1n+j), 1n+j), FA.succ_mul_choose(pm, j))) : {_ == Nat.mul(S.choose(pm, j), 1n+pm) : Nat}
  %Equal.sym(Nat, Nat.mul(1n+pm, S.choose(pm, j)), Nat.mul(S.choose(pm, j), 1n+pm), NA.mul_comm(1n+pm, S.choose(pm, j))) : {_ == Nat.mul(S.choose(pm, j), 1n+pm) : Nat}
  {==}

# p | C(p, j + 1) for j + 1 < p   (Mathlib Nat.Prime.dvd_choose_self)
def choose_dvd(+pm: Nat, +hp: PM.Prime(1n+pm), +j: Nat, +h: {Nat.is_lt(1n+j, 1n+pm) == True{} : Bool}) -> {Nat.mod(S.choose(1n+pm, 1n+j), 1n+pm) == 0n : Nat}:
  +hab = PM.eq_mod0(pm, Nat.mul(1n+j, S.choose(1n+pm, 1n+j)), S.choose(pm, j), ck_eq(pm, j))
  +hk = small_nz(pm, 1n+j, h)
  +ha = Equal.cong(Nat, Bool, z => Nat.is_eq(z, 0n), Nat.mod(1n+j, 1n+pm), 1n+j, hk)
  PM.euclid(1n+pm, hp, 1n+j, S.choose(1n+pm, 1n+j), hab, ha)

# (u + c q) mod n == u mod n when c mod n == 0
def mod_drop(+bp: Nat, +u: Nat, +c: Nat, +q: Nat, +hc: {Nat.mod(c, 1n+bp) == 0n : Nat}) -> {Nat.mod(Nat.add(u, Nat.mul(c, q)), 1n+bp) == Nat.mod(u, 1n+bp) : Nat}:
