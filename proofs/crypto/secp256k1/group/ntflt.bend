  {==}

# (x + 1)^n == sum_k C(n, k) x^k   (Mathlib add_pow)
def binom(n: Nat, +x: Nat) -> {Nat.pow(Nat.add(x, 1n), n) == bsum(n, n, x) : Nat}:
