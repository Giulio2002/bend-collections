  %Equal.sym(Nat, Nat.mul(Nat.mul(Nat.div(c, 1n+bp), 1n+bp), q), Nat.mul(Nat.div(c, 1n+bp), Nat.mul(1n+bp, q)), NA.mul_assoc(Nat.div(c, 1n+bp), 1n+bp, q)) : {Nat.mod(Nat.add(u, _), 1n+bp) == Nat.mod(u, 1n+bp) : Nat}
  %Equal.sym(Nat, Nat.mul(1n+bp, q), Nat.mul(q, 1n+bp), NA.mul_comm(1n+bp, q)) : {Nat.mod(Nat.add(u, Nat.mul(Nat.div(c, 1n+bp), _)), 1n+bp) == Nat.mod(u, 1n+bp) : Nat}
  %Equal.sym(Nat, Nat.mul(Nat.div(c, 1n+bp), Nat.mul(q, 1n+bp)), Nat.mul(Nat.mul(Nat.div(c, 1n+bp), q), 1n+bp), Equal.sym(Nat, Nat.mul(Nat.mul(Nat.div(c, 1n+bp), q), 1n+bp), Nat.mul(Nat.div(c, 1n+bp), Nat.mul(q, 1n+bp)), NA.mul_assoc(Nat.div(c, 1n+bp), q, 1n+bp))) : {Nat.mod(Nat.add(u, _), 1n+bp) == Nat.mod(u, 1n+bp) : Nat}
  %Equal.sym(Nat, Nat.mod(Nat.add(u, Nat.mul(Nat.mul(Nat.div(c, 1n+bp), q), 1n+bp)), 1n+bp), Nat.mod(u, 1n+bp), PM.mod_add_mul(bp, u, Nat.mul(Nat.div(c, 1n+bp), q))) : {_ == Nat.mod(u, 1n+bp) : Nat}
  {==}

def one_mod(+bp: Nat, +h: {Nat.is_lt(1n, 1n+bp) == True{} : Bool}) -> {Nat.mod(1n, 1n+bp) == 1n : Nat}:
  NR.mod_of(0n, bp, 1n, h)

# the partial sums up to k < p are 1 mod p
def bsum_low(+pm: Nat, +hp: PM.Prime(1n+pm), k: Nat, +x: Nat, +h: {Nat.is_lt(k, 1n+pm) == True{} : Bool}) -> {Nat.mod(bsum(1n+pm, k, x), 1n+pm) == 1n : Nat}:
  match k:
    case 0n:
      one_mod(pm, PM.prime_ge2(1n+pm, hp))
    case 1n+ +j:
      %Equal.sym(Nat, Nat.mod(Nat.add(bsum(1n+pm, j, x), Nat.mul(S.choose(1n+pm, 1n+j), Nat.pow(x, 1n+j))), 1n+pm), Nat.mod(bsum(1n+pm, j, x), 1n+pm), mod_drop(pm, bsum(1n+pm, j, x), S.choose(1n+pm, 1n+j), Nat.pow(x, 1n+j), choose_dvd(pm, hp, j, h))) : {_ == 1n : Nat}
      bsum_low(pm, hp, j, x, N.lt_trans(j, 1n+j, 1n+pm, N.lt_succ(j), h))

# (x + 1)^p == x^p + 1 (mod p)
def frosh(+pm: Nat, +hp: PM.Prime(1n+pm), +x: Nat) -> {Nat.mod(Nat.pow(Nat.add(x, 1n), 1n+pm), 1n+pm) == Nat.mod(Nat.add(1n, Nat.pow(x, 1n+pm)), 1n+pm) : Nat}:
  %Equal.sym(Nat, Nat.pow(Nat.add(x, 1n), 1n+pm), bsum(1n+pm, 1n+pm, x), binom(1n+pm, x)) : {Nat.mod(_, 1n+pm) == Nat.mod(Nat.add(1n, Nat.pow(x, 1n+pm)), 1n+pm) : Nat}
  %Equal.sym(Nat, S.choose(1n+pm, 1n+pm), 1n, choose_self(1n+pm)) : {Nat.mod(Nat.add(bsum(1n+pm, pm, x), Nat.mul(_, Nat.pow(x, 1n+pm))), 1n+pm) == Nat.mod(Nat.add(1n, Nat.pow(x, 1n+pm)), 1n+pm) : Nat}
  %Equal.sym(Nat, Nat.mul(1n, Nat.pow(x, 1n+pm)), Nat.pow(x, 1n+pm), SR.one_mul(Nat.pow(x, 1n+pm))) : {Nat.mod(Nat.add(bsum(1n+pm, pm, x), _), 1n+pm) == Nat.mod(Nat.add(1n, Nat.pow(x, 1n+pm)), 1n+pm) : Nat}
  %Equal.sym(Nat, Nat.mod(Nat.add(bsum(1n+pm, pm, x), Nat.pow(x, 1n+pm)), 1n+pm), Nat.mod(Nat.add(Nat.mod(bsum(1n+pm, pm, x), 1n+pm), Nat.pow(x, 1n+pm)), 1n+pm), Equal.sym(Nat, Nat.mod(Nat.add(Nat.mod(bsum(1n+pm, pm, x), 1n+pm), Nat.pow(x, 1n+pm)), 1n+pm), Nat.mod(Nat.add(bsum(1n+pm, pm, x), Nat.pow(x, 1n+pm)), 1n+pm), NR.mod_add_l(pm, bsum(1n+pm, pm, x), Nat.pow(x, 1n+pm)))) : {_ == Nat.mod(Nat.add(1n, Nat.pow(x, 1n+pm)), 1n+pm) : Nat}
  %Equal.sym(Nat, Nat.mod(bsum(1n+pm, pm, x), 1n+pm), 1n, bsum_low(pm, hp, pm, x, N.lt_succ(pm))) : {Nat.mod(Nat.add(_, Nat.pow(x, 1n+pm)), 1n+pm) == Nat.mod(Nat.add(1n, Nat.pow(x, 1n+pm)), 1n+pm) : Nat}
  {==}

# ---- Fermat ----

def flt_s(+pm: Nat, +hp: PM.Prime(1n+pm), a: Nat) -> {Nat.mod(Nat.pow(a, 1n+pm), 1n+pm) == Nat.mod(a, 1n+pm) : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+ +c:
      %Equal.sym(Nat, Nat.add(1n, c), Nat.add(c, 1n), Equal.sym(Nat, Nat.add(c, 1n), Nat.add(1n, c), NA.add_comm(c, 1n))) : {Nat.mod(Nat.pow(_, 1n+pm), 1n+pm) == Nat.mod(1n+c, 1n+pm) : Nat}
      %Equal.sym(Nat, Nat.mod(Nat.pow(Nat.add(c, 1n), 1n+pm), 1n+pm), Nat.mod(Nat.add(1n, Nat.pow(c, 1n+pm)), 1n+pm), frosh(pm, hp, c)) : {_ == Nat.mod(1n+c, 1n+pm) : Nat}
      %Equal.sym(Nat, Nat.mod(Nat.add(1n, Nat.pow(c, 1n+pm)), 1n+pm), Nat.mod(Nat.add(1n, Nat.mod(Nat.pow(c, 1n+pm), 1n+pm)), 1n+pm), Equal.sym(Nat, Nat.mod(Nat.add(1n, Nat.mod(Nat.pow(c, 1n+pm), 1n+pm)), 1n+pm), Nat.mod(Nat.add(1n, Nat.pow(c, 1n+pm)), 1n+pm), NR.mod_add_r(pm, 1n, Nat.pow(c, 1n+pm)))) : {_ == Nat.mod(1n+c, 1n+pm) : Nat}
      %Equal.sym(Nat, Nat.mod(Nat.pow(c, 1n+pm), 1n+pm), Nat.mod(c, 1n+pm), flt_s(pm, hp, c)) : {Nat.mod(Nat.add(1n, _), 1n+pm) == Nat.mod(1n+c, 1n+pm) : Nat}
      %Equal.sym(Nat, Nat.mod(Nat.add(1n, Nat.mod(c, 1n+pm)), 1n+pm), Nat.mod(Nat.add(1n, c), 1n+pm), NR.mod_add_r(pm, 1n, c)) : {_ == Nat.mod(1n+c, 1n+pm) : Nat}
      {==}

# a^p == a (mod p)   (Mathlib ZMod.pow_card)
def flt(p: Nat, +hp: PM.Prime(p), +a: Nat) -> {Nat.mod(Nat.pow(a, p), p) == Nat.mod(a, p) : Nat}:
  match p:
    case 0n:
      Empty.absurd({Nat.mod(Nat.pow(a, 0n), 0n) == Nat.mod(a, 0n) : Nat}, Lg.false_true(hp))
    case 1n+ +pm:
      flt_s(pm, hp, a)
