# Pascal's rule on the sums: B(n + 1, k + 1) == B(n, k + 1) + x B(n, k)
def pascal(+n: Nat, k: Nat, +x: Nat) -> {bsum(1n+n, 1n+k, x) == Nat.add(bsum(n, 1n+k, x), Nat.mul(x, bsum(n, k, x))) : Nat}:
  match k:
    case 0n:
      %Equal.sym(Nat, S.choose(n, 0n), 1n, FA.choose_zero_right(n)) : {Nat.add(1n, Nat.mul(Nat.add(_, S.choose(n, 1n)), Nat.mul(x, 1n))) == Nat.add(Nat.add(S.choose(n, 0n), Nat.mul(S.choose(n, 1n), Nat.mul(x, 1n))), Nat.mul(x, S.choose(n, 0n))) : Nat}
      %Equal.sym(Nat, S.choose(n, 0n), 1n, FA.choose_zero_right(n)) : {Nat.add(1n, Nat.mul(Nat.add(1n, S.choose(n, 1n)), Nat.mul(x, 1n))) == Nat.add(Nat.add(_, Nat.mul(S.choose(n, 1n), Nat.mul(x, 1n))), Nat.mul(x, S.choose(n, 0n))) : Nat}
      %Equal.sym(Nat, S.choose(n, 0n), 1n, FA.choose_zero_right(n)) : {Nat.add(1n, Nat.mul(Nat.add(1n, S.choose(n, 1n)), Nat.mul(x, 1n))) == Nat.add(Nat.add(1n, Nat.mul(S.choose(n, 1n), Nat.mul(x, 1n))), Nat.mul(x, _)) : Nat}
      ring0(S.choose(n, 1n), x)
    case 1n+ +j:
      %Equal.sym(Nat, bsum(1n+n, 1n+j, x), Nat.add(bsum(n, 1n+j, x), Nat.mul(x, bsum(n, j, x))), pascal(n, j, x)) : {Nat.add(_, Nat.mul(Nat.add(S.choose(n, 1n+j), S.choose(n, 2n+j)), Nat.mul(x, Nat.pow(x, 1n+j)))) == Nat.add(Nat.add(bsum(n, 1n+j, x), Nat.mul(S.choose(n, 2n+j), Nat.mul(x, Nat.pow(x, 1n+j)))), Nat.mul(x, Nat.add(bsum(n, j, x), Nat.mul(S.choose(n, 1n+j), Nat.pow(x, 1n+j))))) : Nat}
      ring1(bsum(n, 1n+j, x), bsum(n, j, x), S.choose(n, 1n+j), S.choose(n, 2n+j), x, Nat.pow(x, 1n+j))

def ring2(+b: Nat, +x: Nat, +q: Nat) -> {Nat.mul(Nat.add(x, 1n), b) == Nat.add(Nat.add(b, Nat.mul(0n, q)), Nat.mul(x, b)) : Nat}:
