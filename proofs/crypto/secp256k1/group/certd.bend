# (p - 7)^e mod p != 1, with e = (p - 1) / 3 = X.bvalo(one, CB.e3l())
def cube_ne(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(FS.prime(one), 7n), X.bvalo(one, CB.e3l())), FS.prime(one)), 1n) == False{} : Bool}:
  %Equal.sym(Nat, Nat.sub(FS.prime(one), 7n), X.bvalo(one, CB.p7l()), CB.p_m7(one, h1)) : {Nat.is_eq(Nat.mod(Nat.pow(_, X.bvalo(one, CB.e3l())), FS.prime(one)), 1n) == False{} : Bool}
  %Equal.sym(Nat, FS.prime(one), X.bvalo(one, CB.pl()), Equal.sym(Nat, X.bvalo(one, CB.pl()), FS.prime(one), CB.p_is(one, h1))) : {Nat.is_eq(Nat.mod(Nat.pow(X.bvalo(one, CB.p7l()), X.bvalo(one, CB.e3l())), _), 1n) == False{} : Bool}
  %Equal.sym(Nat, Nat.mod(Nat.pow(X.bvalo(one, CB.p7l()), X.bvalo(one, CB.e3l())), X.bvalo(one, CB.pl())), X.bvalo(one, cl()), CL.fin_o(one, h1, CB.p7l(), CB.pl(), CB.p1l(), cl(), CB.e3l(), dl(), h_n(), CC.pw(one, h1), h_lt())) : {Nat.is_eq(_, 1n) == False{} : Bool}
  %Equal.sym(Nat, X.bvalo(one, cl()), 2n+X.bvalo(one, c2l()), X.suc2_o(one, h1, cl(), c2l(), h_c())) : {Nat.is_eq(_, 1n) == False{} : Bool}
  {==}

# the same with the exponent written (p - 1) / 3
def cube_ne_div(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(FS.prime(one), 7n), Nat.div(X.bvalo(one, CB.p1l()), 3n)), FS.prime(one)), 1n) == False{} : Bool}:
  %Equal.sym(Nat, Nat.div(X.bvalo(one, CB.p1l()), 3n), X.bvalo(one, CB.e3l()), CB.p_div3(one, h1)) : {Nat.is_eq(Nat.mod(Nat.pow(Nat.sub(FS.prime(one), 7n), _), FS.prime(one)), 1n) == False{} : Bool}
  cube_ne(one, h1)
