  %Equal.sym(CS.SPoint, PC.spo(one, M.BP{x, y, z}), CS.SPoint{B.bval(x), B.bval(y), B.bval(z)}, PC.spo_v(one, h1, x, y, z)) : {GS.valid(1n+B.bval(p1), _) == True{} : Bool}
  Lg.and_intro(GS.on_curve(1n+B.bval(p1), CS.SPoint{B.bval(x), B.bval(y), B.bval(z)}), GS.y_nonzero(1n+B.bval(p1), CS.SPoint{B.bval(x), B.bval(y), B.bval(z)}), oc_b(p, p1, c, x, y, z, y1, hn, hwk, hr, h7, hc), yn_b(p, p1, c, x, y, z, y1, hn, hwk, hr, hc))

