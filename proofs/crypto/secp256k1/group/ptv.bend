def h7_p() -> {M.ltk(b7l(), CB.pl()) == True{} : Bool}:
  {==}

def gck() -> {vck(PC.cl(), CB.pl(), PC.gxl(), PC.gyl(), B.B1{B.BZ{}}, gy1l()) == True{} : Bool}:
  {==}

# G is a point of the group (modulus 1 + pm)
def g_valid_m(+one: Nat, +h1: {one == 1n : Nat}) -> {GS.valid(1n+X.bvalo(one, CB.p1l()), CS.g(one)) == True{} : Bool}:
  %g_is(one, h1) : {GS.valid(1n+X.bvalo(one, CB.p1l()), _) == True{} : Bool}
  gv(one, h1, CB.pl(), CB.p1l(), PC.cl(), PC.gxl(), PC.gyl(), B.B1{B.BZ{}}, gy1l(), PC.hn_p(), PC.hw_p(), PC.hg_p(), h7_p(), gck())

# G is a point of the group
def g_valid(+one: Nat, +h1: {one == 1n : Nat}) -> {GS.valid(FS.prime(one), CS.g(one)) == True{} : Bool}:
  Lg.subst(Nat, q => {GS.valid(q, CS.g(one)) == True{} : Bool}, 1n+X.bvalo(one, CB.p1l()), FS.prime(one), Equal.sym(Nat, FS.prime(one), 1n+X.bvalo(one, CB.p1l()), CB.p_suc(one, h1)), g_valid_m(one, h1))
