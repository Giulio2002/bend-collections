# ---- a literal point is a point of the group ----

# Y^2, Y^2 Z, X^2, X^3, Z^2, Z^3, 7 Z^3, X^3 + 7 Z^3 on the registers X, Y, Z, 7
def oc_prog() -> List<&2, CS.SOp>:
  [CS.SMul{1n, 1n}, CS.SMul{4n, 2n}, CS.SMul{0n, 0n}, CS.SMul{6n, 0n}, CS.SMul{2n, 2n}, CS.SMul{8n, 2n}, CS.SMul{3n, 9n}, CS.SAdd{7n, 10n}]

def b7l() -> B.Bn:
  B.B1{B.B1{B.B1{B.BZ{}}}}

def vfin(r: M.RR, +y: B.Bn, +y1: B.Bn) -> Bool:
  match r:
    case M.RR{+regs, ok}:
      Bool.and(ok, Bool.and(B.beq(M.bnth(5n, regs), M.bnth(11n, regs)), B.beq(y, B.binc(y1))))

# the closed check: Y^2 Z == X^3 + 7 Z^3 (mod p) and y == y1 + 1
def vck(+c: B.Bn, +p: B.Bn, +x: B.Bn, +y: B.Bn, +z: B.Bn, +y1: B.Bn) -> Bool:
  vfin(M.brun(oc_prog(), c, p, M.RR{[x, y, z, b7l()], True{}}), y, y1)

