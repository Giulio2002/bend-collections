# Modular exponentiation certificates on the binary numbers of bn.bend.
#
# A power a^e mod m is not computed by division: the certificate lists, for
# every squaring and every multiplication by the base of the left-to-right
# binary method, the quotient q and the remainder r (found outside, by
# tools/generators/secp256k1_group/gen_cert.py), and chk verifies
# x x == q m + r (or x a == q m + r) with the proved product, sum and
# equality of bn.bend. chk_v: a checked list proves
# fin == a^eb (mod m), for every input; the literal lists are then checked
# by {==}, one closed computation each.

type St is Data:
  Sq{q: B.Bn, r: B.Bn}
  Mu{q: B.Bn, r: B.Bn}

def chk(steps: List<&2, St>, +a: B.Bn, +m: B.Bn, +x: B.Bn) -> Bool:
  match steps:
    case Nil{}:
      True{}
    case Sq{+q, +r} <> t:
      Bool.and(B.beq(B.bmul(x, x), B.badd(B.bmul(q, m), r)), chk(t, a, m, r))
    case Mu{+q, +r} <> t:
      Bool.and(B.beq(B.bmul(x, a), B.badd(B.bmul(q, m), r)), chk(t, a, m, r))

# the last remainder
def fin(steps: List<&2, St>, x: B.Bn) -> B.Bn:
  match steps:
    case Nil{}:
      x
    case Sq{q, r} <> t:
      fin(t, r)
    case Mu{q, r} <> t:
      fin(t, r)

# the exponent reached from e
def eb(steps: List<&2, St>, e: B.Bn) -> B.Bn:
  match steps:
    case Nil{}:
      e
    case Sq{q, r} <> t:
      eb(t, B.B0{e})
    case Mu{q, r} <> t:
      eb(t, B.binc(e))

