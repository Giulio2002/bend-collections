# Counter mode keeps the length.
def gctr_len(+nr: Nat, +ks: List<&2, T.State>, +q0: T.Quad, +q1: T.Quad, +q2: T.Quad, +xs: List<&2, U32>, +c: U32) -> {List.length(&2, U32, G.gctr(A.Schedule{nr, ks}, xs, q0, q1, q2, c)) == List.length(&2, U32, xs) : Nat}:
  match xs:
    case x0 <> x1 <> x2 <> x3 <> x4 <> x5 <> x6 <> x7 <> x8 <> x9 <> x10 <> x11 <> x12 <> x13 <> x14 <> x15 <> rest:
      %Equal.sym(Nat, List.length(&2, U32, List.append(&2, U32, G.xor_bytes([x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15], G.keystream(A.Schedule{nr, ks}, q0, q1, q2, c)), G.gctr(A.Schedule{nr, ks}, rest, q0, q1, q2, U32.inc(c)))), Nat.add(List.length(&2, U32, G.xor_bytes([x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15], G.keystream(A.Schedule{nr, ks}, q0, q1, q2, c))), List.length(&2, U32, G.gctr(A.Schedule{nr, ks}, rest, q0, q1, q2, U32.inc(c)))), len_append(G.xor_bytes([x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15], G.keystream(A.Schedule{nr, ks}, q0, q1, q2, c)), G.gctr(A.Schedule{nr, ks}, rest, q0, q1, q2, U32.inc(c)))) : {_ == List.length(&2, U32, x0 <> x1 <> x2 <> x3 <> x4 <> x5 <> x6 <> x7 <> x8 <> x9 <> x10 <> x11 <> x12 <> x13 <> x14 <> x15 <> rest) : Nat}
      %Equal.sym(Nat, List.length(&2, U32, G.xor_bytes([x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15], G.keystream(A.Schedule{nr, ks}, q0, q1, q2, c))), 16n, len16(x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, A.encrypt_state(A.Schedule{nr, ks}, G.counter(q0, q1, q2, c)))) : {Nat.add(_, List.length(&2, U32, G.gctr(A.Schedule{nr, ks}, rest, q0, q1, q2, U32.inc(c)))) == List.length(&2, U32, x0 <> x1 <> x2 <> x3 <> x4 <> x5 <> x6 <> x7 <> x8 <> x9 <> x10 <> x11 <> x12 <> x13 <> x14 <> x15 <> rest) : Nat}
      %Equal.sym(Nat, List.length(&2, U32, G.gctr(A.Schedule{nr, ks}, rest, q0, q1, q2, U32.inc(c))), List.length(&2, U32, rest), gctr_len(nr, ks, q0, q1, q2, rest, U32.inc(c))) : {Nat.add(16n, _) == List.length(&2, U32, x0 <> x1 <> x2 <> x3 <> x4 <> x5 <> x6 <> x7 <> x8 <> x9 <> x10 <> x11 <> x12 <> x13 <> x14 <> x15 <> rest) : Nat}
      {==}
    case Nil{}:
      {==}
    case x0 <> Nil{}:
      lenp1(x0, A.encrypt_state(A.Schedule{nr, ks}, G.counter(q0, q1, q2, c)))
    case x0 <> x1 <> Nil{}:
      lenp2(x0, x1, A.encrypt_state(A.Schedule{nr, ks}, G.counter(q0, q1, q2, c)))
    case x0 <> x1 <> x2 <> Nil{}:
      lenp3(x0, x1, x2, A.encrypt_state(A.Schedule{nr, ks}, G.counter(q0, q1, q2, c)))
    case x0 <> x1 <> x2 <> x3 <> Nil{}:
      lenp4(x0, x1, x2, x3, A.encrypt_state(A.Schedule{nr, ks}, G.counter(q0, q1, q2, c)))
    case x0 <> x1 <> x2 <> x3 <> x4 <> Nil{}:
      lenp5(x0, x1, x2, x3, x4, A.encrypt_state(A.Schedule{nr, ks}, G.counter(q0, q1, q2, c)))
    case x0 <> x1 <> x2 <> x3 <> x4 <> x5 <> Nil{}:
      lenp6(x0, x1, x2, x3, x4, x5, A.encrypt_state(A.Schedule{nr, ks}, G.counter(q0, q1, q2, c)))
    case x0 <> x1 <> x2 <> x3 <> x4 <> x5 <> x6 <> Nil{}:
      lenp7(x0, x1, x2, x3, x4, x5, x6, A.encrypt_state(A.Schedule{nr, ks}, G.counter(q0, q1, q2, c)))
    case x0 <> x1 <> x2 <> x3 <> x4 <> x5 <> x6 <> x7 <> Nil{}:
      lenp8(x0, x1, x2, x3, x4, x5, x6, x7, A.encrypt_state(A.Schedule{nr, ks}, G.counter(q0, q1, q2, c)))
    case x0 <> x1 <> x2 <> x3 <> x4 <> x5 <> x6 <> x7 <> x8 <> Nil{}:
      lenp9(x0, x1, x2, x3, x4, x5, x6, x7, x8, A.encrypt_state(A.Schedule{nr, ks}, G.counter(q0, q1, q2, c)))
    case x0 <> x1 <> x2 <> x3 <> x4 <> x5 <> x6 <> x7 <> x8 <> x9 <> Nil{}:
      lenp10(x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, A.encrypt_state(A.Schedule{nr, ks}, G.counter(q0, q1, q2, c)))
    case x0 <> x1 <> x2 <> x3 <> x4 <> x5 <> x6 <> x7 <> x8 <> x9 <> x10 <> Nil{}:
      lenp11(x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, A.encrypt_state(A.Schedule{nr, ks}, G.counter(q0, q1, q2, c)))
    case x0 <> x1 <> x2 <> x3 <> x4 <> x5 <> x6 <> x7 <> x8 <> x9 <> x10 <> x11 <> Nil{}:
      lenp12(x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, A.encrypt_state(A.Schedule{nr, ks}, G.counter(q0, q1, q2, c)))
    case x0 <> x1 <> x2 <> x3 <> x4 <> x5 <> x6 <> x7 <> x8 <> x9 <> x10 <> x11 <> x12 <> Nil{}:
      lenp13(x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, A.encrypt_state(A.Schedule{nr, ks}, G.counter(q0, q1, q2, c)))
    case x0 <> x1 <> x2 <> x3 <> x4 <> x5 <> x6 <> x7 <> x8 <> x9 <> x10 <> x11 <> x12 <> x13 <> Nil{}:
      lenp14(x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, A.encrypt_state(A.Schedule{nr, ks}, G.counter(q0, q1, q2, c)))
    case x0 <> x1 <> x2 <> x3 <> x4 <> x5 <> x6 <> x7 <> x8 <> x9 <> x10 <> x11 <> x12 <> x13 <> x14 <> Nil{}:
      lenp15(x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, A.encrypt_state(A.Schedule{nr, ks}, G.counter(q0, q1, q2, c)))

