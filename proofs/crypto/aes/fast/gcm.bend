def take_le(+xs: List<&2, U32>, +k: Nat) -> {Nat.is_le(List.length(&2, U32, List.take(&2, U32, xs, k)), k) == True{} : Bool}:
  match xs k:
    case Nil{} _:
      N.zero_le(k)
    case x <> t 0n:
      {==}
    case x <> t 1n+p:
      take_le(t, p)

def take_len(+xs: List<&2, U32>, +k: Nat, +hk: {Nat.is_le(k, List.length(&2, U32, xs)) == True{} : Bool}) -> {List.length(&2, U32, List.take(&2, U32, xs, k)) == k : Nat}:
  match xs k:
    case Nil{} 0n:
      {==}
    case Nil{} 1n+p:
      Empty.absurd({0n == 1n+p : Nat}, LG.false_true(hk))
    case x <> t 0n:
      {==}
    case x <> t 1n+p:
      N.succ_cong(List.length(&2, U32, List.take(&2, U32, t, p)), p, take_len(t, p, hk))

# The one-pass loop of decryption.
