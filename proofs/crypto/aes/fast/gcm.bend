# Counter mode on fewer than 32 bytes: one xor with both keystream blocks.
def short_gctr(+nr: Nat, +ks: List<&2, T.State>, +h: {List.length(&2, T.State, ks) == 2n+Nat.sub(nr, 1n) : Nat}, +q0: T.Quad, +q1: T.Quad, +q2: T.Quad, +l: List<&2, U32>, +c: U32, +hl: {Nat.is_lt(List.length(&2, U32, l), 32n) == True{} : Bool}) -> {G.gctr(A.Schedule{nr, ks}, l, q0, q1, q2, c) == F.xor_into(l, List.append(&2, U32, G.keystream(A.Schedule{nr, ks}, q0, q1, q2, c), G.keystream(A.Schedule{nr, ks}, q0, q1, q2, U32.inc(c))), Nil{}) : List<&2, U32>}:
  match l:
    case Nil{}:
      {==}
    case x0 <> Nil{}:
      short1(x0, A.encrypt_state(A.Schedule{nr, ks}, G.counter(q0, q1, q2, c)), A.encrypt_state(A.Schedule{nr, ks}, G.counter(q0, q1, q2, U32.inc(c))))
