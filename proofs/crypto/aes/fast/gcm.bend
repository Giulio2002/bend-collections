# GCM-AE.
def seal_ok(+nr: Nat, +ks: List<&2, T.State>, +h: {List.length(&2, T.State, ks) == 2n+Nat.sub(nr, 1n) : Nat}, +q0: T.Quad, +q1: T.Quad, +q2: T.Quad, +aad: List<&2, U32>, +pt: List<&2, U32>) -> {F.seal(F.Keys{nr, F.key_planes(ks)}, F.N{F.quad_word(q0), F.quad_word(q1), F.quad_word(q2)}, aad, pt) == G.seal_core(A.Schedule{nr, ks}, q0, q1, q2, aad, pt) : List<&2, U32>}:
