  match sa sb:
    case T.S{T.W{s0, s1, s2, s3}, T.W{s4, s5, s6, s7}, T.W{s8, s9, s10, s11}, T.W{s12, s13, s14, s15}} T.S{T.W{u0, u1, u2, u3}, T.W{u4, u5, u6, u7}, T.W{u8, u9, u10, u11}, T.W{u12, u13, u14, u15}}:
      {==}

