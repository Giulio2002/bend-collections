# Two counter blocks: the keystreams of counters c and c + 1.
def ctr_ok(+nr: Nat, +ks: List<&2, T.State>, +h: {List.length(&2, T.State, ks) == 2n+Nat.sub(nr, 1n) : Nat}, +q0: T.Quad, +q1: T.Quad, +q2: T.Quad, +c: U32) -> {F.stream(F.ctr2(F.Keys{nr, F.key_planes(ks)}, F.N{F.quad_word(q0), F.quad_word(q1), F.quad_word(q2)}, c)) == List.append(&2, U32, G.keystream(A.Schedule{nr, ks}, q0, q1, q2, c), G.keystream(A.Schedule{nr, ks}, q0, q1, q2, U32.inc(c))) : List<&2, U32>}:
  C.encrypt2_ok(nr, ks, h, q0, q1, q2, T.W{U32.and(255, U32.shrn(c, 24n)), U32.and(255, U32.shrn(c, 16n)), U32.and(255, U32.shrn(c, 8n)), U32.and(255, c)}, q0, q1, q2, T.W{U32.and(255, U32.shrn(U32.inc(c), 24n)), U32.and(255, U32.shrn(U32.inc(c), 16n)), U32.and(255, U32.shrn(U32.inc(c), 8n)), U32.and(255, U32.inc(c))})

def hk_state(+sa: T.State, +sb: T.State) -> {F.hash_key(List.append(&2, U32, A.bytes_of(sa), A.bytes_of(sb))) == G.pack(sa) : G.Block}:
  match sa sb:
    case T.S{T.W{s0, s1, s2, s3}, T.W{s4, s5, s6, s7}, T.W{s8, s9, s10, s11}, T.W{s12, s13, s14, s15}} T.S{T.W{u0, u1, u2, u3}, T.W{u4, u5, u6, u7}, T.W{u8, u9, u10, u11}, T.W{u12, u13, u14, u15}}:
      {==}

# H = E(K, 0).
def hk_ok(+nr: Nat, +ks: List<&2, T.State>, +h: {List.length(&2, T.State, ks) == 2n+Nat.sub(nr, 1n) : Nat}) -> {F.hash_key(F.stream(F.encrypt2(F.Keys{nr, F.key_planes(ks)}, 0, 0, 0, 0, 0, 0, 0, 0))) == G.hash_key(A.Schedule{nr, ks}) : G.Block}:
