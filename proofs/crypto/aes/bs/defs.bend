#
# The bits of a byte, the bit-plane relation B and the extensionality lemmas
# the bit-level proofs assemble their results with.

def wbit(n: Nat, w: Word(n), i: Nat) -> Bool:
  match n w i:
    case 0n WNil{} _:
      False{}
    case 1n+p WCon{b, t} 0n:
      b
    case 1n+p WCon{b, t} 1n+j:
      wbit(p, t, j)

# Bit i of a U32 (bit 0 the least significant).
def bit(x: U32, i: Nat) -> Bool:
  match x:
    case U32{w}: wbit(32n, w, i)

# The byte with bits b0 (least significant) .. b7.
def byte_of(b0: Bool, b1: Bool, b2: Bool, b3: Bool, b4: Bool, b5: Bool, b6: Bool, b7: Bool) -> U32:
  U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, WCon{b6, WCon{b7, Word.zero(24n)}}}}}}}}}

