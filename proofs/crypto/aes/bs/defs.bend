def bit_id(f: Bool -> Bool, +x: Bool, ht: {f(True{}) == True{} : Bool}, hf: {f(False{}) == False{} : Bool}) -> {f(x) == x : Bool}:
  match x:
    case True{}: ht
    case False{}: hf

