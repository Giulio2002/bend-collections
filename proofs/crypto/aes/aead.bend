# x is no longer than k.
def fits(x: List<&2, U32>, k: List<&2, U32>) -> Bool:
  match x:
    case Nil{}:
      True{}
    case a <> xs:
      match k:
        case Nil{}:
          False{}
        case b <> ks:
          fits(xs, ks)

# (x xor k) xor k == x, byte by byte.
def xb_inv(+x: List<&2, U32>, +k: List<&2, U32>, +h: {fits(x, k) == True{} : Bool}) -> {G.xor_bytes(G.xor_bytes(x, k), k) == x : List<&2, U32>}:
