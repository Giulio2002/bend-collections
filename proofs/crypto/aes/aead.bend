  {==}

def gctr_part5(+nk: Nat, +nr: Nat, +key: List<&2, U32>, +x0: U32, +x1: U32, +x2: U32, +x3: U32, +x4: U32, +cb: List<&2, U32>) -> {G.gctr(nk, nr, key, [x0, x1, x2, x3, x4], cb) == [U32.xor(x0, S.nth_byte(G.ciph(nk, nr, key, cb), 0n)), U32.xor(x1, S.nth_byte(G.ciph(nk, nr, key, cb), 1n)), U32.xor(x2, S.nth_byte(G.ciph(nk, nr, key, cb), 2n)), U32.xor(x3, S.nth_byte(G.ciph(nk, nr, key, cb), 3n)), U32.xor(x4, S.nth_byte(G.ciph(nk, nr, key, cb), 4n))] : List<&2, U32>}:
