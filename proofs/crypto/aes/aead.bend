    case Nil{}:
      match k:
        case Nil{}:
          {==}
        case b <> ks:
          {==}
    case a <> xs:
      match k:
        case Nil{}:
          Empty.absurd({G.xor_bytes(G.xor_bytes(a <> xs, Nil{}), Nil{}) == a <> xs : List<&2, U32>}, L.false_true(h))
