# ---- GCM (SP 800-38D) ----

# The implementation's GCM-AE / GCM-AD, for every expanded key, 96-bit
# nonce, AAD and input.
law Gcm.seal:
  for +nk: Nat
  for +nr: Nat
  for +key: List<&2, U32>
  for +n0: U32
  for +n1: U32
  for +n2: U32
  for +n3: U32
  for +n4: U32
  for +n5: U32
  for +n6: U32
  for +n7: U32
  for +n8: U32
  for +n9: U32
  for +n10: U32
  for +n11: U32
  for +aad: List<&2, U32>
  for +pt: List<&2, U32>
  {GI.seal_core(A.Schedule{nr, A.expand(nk, nr, key)}, T.W{n0, n1, n2, n3}, T.W{n4, n5, n6, n7}, T.W{n8, n9, n10, n11}, aad, pt) == G.seal(nk, nr, key, [n0, n1, n2, n3, n4, n5, n6, n7, n8, n9, n10, n11], aad, pt) : List<&2, U32>}

