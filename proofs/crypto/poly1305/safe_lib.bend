# absorb_pad (the AEAD's padded pieces)
def ok_pad(+pone: Nat, +msg: List<&2, U32>, +k: L.K, +h: L.F, +n: Nat) -> Bool:
  match msg:
    case Nil{}: True{}
    case x0 <> x1 <> x2 <> x3 <> x4 <> x5 <> x6 <> x7 <> x8 <> x9 <> x10 <> x11 <> x12 <> x13 <> x14 <> x15 <> rest:
      +m = L.load(L.byte(x0), L.byte(x1), L.byte(x2), L.byte(x3), L.byte(x4), L.byte(x5), L.byte(x6), L.byte(x7), L.byte(x8), L.byte(x9), L.byte(x10), L.byte(x11), L.byte(x12), L.byte(x13), L.byte(x14), L.byte(x15), pone)
      Bool.and(O.ok_load(L.byte(x0), L.byte(x1), L.byte(x2), L.byte(x3), L.byte(x4), L.byte(x5), L.byte(x6), L.byte(x7), L.byte(x8), L.byte(x9), L.byte(x10), L.byte(x11), L.byte(x12), L.byte(x13), L.byte(x14), L.byte(x15), pone), Bool.and(O.ok_block(k, h, m), ok_pad(pone, rest, k, L.block(k, h, m), Nat.add(n, 16n))))
    case +x <> +rest: ok_abs(pone, List.append(&2, U32, x <> rest, P.pad16(x <> rest)), k, h)

def ah(+a: P.A) -> L.F:
  match a:
    case P.A{h, n}: h

