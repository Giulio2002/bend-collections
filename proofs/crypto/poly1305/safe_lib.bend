def ok_gen(+fuel: Nat, +msg: List<&2, U32>, +k: L.K, +h: L.F) -> Bool:
  match fuel msg:
    case 0n _: True{}
    case 1n+f Nil{}: True{}
    case 1n+f +x <> +rest:
      +ys = List.append(&2, U32, P.take(16n, x <> rest), [1])
      +m = P.load17(ys)
      Bool.and(ok_load17(ys), Bool.and(O.ok_block(k, h, m), ok_gen(f, P.skip(16n, x <> rest), k, L.block(k, h, m))))

