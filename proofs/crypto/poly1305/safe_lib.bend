# the AEAD tag: aad and ct absorbed with their padding, then the lengths
def ok_tag_len(+pone: Nat, +k: L.K, +s: L.F, +la: Nat, +a: P.A) -> Bool:
  match a:
    case P.A{h, lc}:
      +ms = List.append(&2, U32, P.le8(8n, la), P.le8(8n, lc))
      Bool.and(ok_abs(pone, ms, k, h), O.ok_fin(P.absorb(pone, ms, k, h), s))

def ok_tag_ct(+pone: Nat, +k: L.K, +s: L.F, +a: P.A, +ct: List<&2, U32>) -> Bool:
  match a:
    case P.A{h, la}: Bool.and(ok_pad(pone, ct, k, h, 0n), ok_tag_len(pone, k, s, la, P.absorb_pad(pone, ct, k, h, 0n)))

def tag_len_safe(+pone: Nat, +hp: {pone == 1n : Nat}, +one: Nat, +h1: {one == 1n : Nat}, +r0: Nat, +r1: Nat, +r2: Nat, +r3: Nat, +r4: Nat, +kk: L.K, +hk: {kk == L.key(L.F{r0, r1, r2, r3, r4}) : L.K}, +hr0: {C.fits(26n, r0) == True{} : Bool}, +hr1: {C.fits(26n, r1) == True{} : Bool}, +hr2: {C.fits(26n, r2) == True{} : Bool}, +hr3: {C.fits(26n, r3) == True{} : Bool}, +hr4: {C.fits(26n, r4) == True{} : Bool}, +s: L.F, +hs: {B.lim(26n, s) == True{} : Bool}, +la: Nat, +a: P.A, +ha: {B.lim(27n, ah(a)) == True{} : Bool}) -> {ok_tag_len(pone, kk, s, la, a) == True{} : Bool}:
  match a:
    case P.A{h, lc}:
      +ms = List.append(&2, U32, P.le8(8n, la), P.le8(8n, lc))
      LG.and_intro(ok_abs(pone, ms, kk, h), O.ok_fin(P.absorb(pone, ms, kk, h), s), abs_ok(pone, hp, one, h1, r0, r1, r2, r3, r4, kk, hk, hr0, hr1, hr2, hr3, hr4, ms, h, ha), O.fin_ok(P.absorb(pone, ms, kk, h), s, abs_inv(pone, hp, one, h1, r0, r1, r2, r3, r4, kk, hk, hr0, hr1, hr2, hr3, hr4, ms, h, ha), hs))

def tag_ct_safe(+pone: Nat, +hp: {pone == 1n : Nat}, +one: Nat, +h1: {one == 1n : Nat}, +r0: Nat, +r1: Nat, +r2: Nat, +r3: Nat, +r4: Nat, +kk: L.K, +hk: {kk == L.key(L.F{r0, r1, r2, r3, r4}) : L.K}, +hr0: {C.fits(26n, r0) == True{} : Bool}, +hr1: {C.fits(26n, r1) == True{} : Bool}, +hr2: {C.fits(26n, r2) == True{} : Bool}, +hr3: {C.fits(26n, r3) == True{} : Bool}, +hr4: {C.fits(26n, r4) == True{} : Bool}, +s: L.F, +hs: {B.lim(26n, s) == True{} : Bool}, +a: P.A, +ct: List<&2, U32>, +ha: {B.lim(27n, ah(a)) == True{} : Bool}) -> {ok_tag_ct(pone, kk, s, a, ct) == True{} : Bool}:
  match a:
    case P.A{h, la}:
      LG.and_intro(ok_pad(pone, ct, kk, h, 0n), ok_tag_len(pone, kk, s, la, P.absorb_pad(pone, ct, kk, h, 0n)), pad_ok(pone, hp, one, h1, r0, r1, r2, r3, r4, kk, hk, hr0, hr1, hr2, hr3, hr4, ct, h, 0n, ha), tag_len_safe(pone, hp, one, h1, r0, r1, r2, r3, r4, kk, hk, hr0, hr1, hr2, hr3, hr4, s, hs, la, P.absorb_pad(pone, ct, kk, h, 0n), pad_inv(pone, hp, one, h1, r0, r1, r2, r3, r4, kk, hk, hr0, hr1, hr2, hr3, hr4, ct, h, 0n, ha)))

# ---- the one-pass ChaCha20-Poly1305 seal (src/crypto/aead/chacha20poly1305.bend)

# the tag's end over the last ciphertext bytes ct (I.ftail)
def ok_ftail(+ct: List<&2, U32>, +pone: Nat, +kk: L.K, +sv: L.F, +la: Nat, +h: L.F, +cnt: Nat) -> Bool:
  Bool.and(ok_pad(pone, ct, kk, h, cnt), ok_tag_len(pone, kk, sv, la, P.absorb_pad(pone, ct, kk, h, cnt)))

def ftail_safe(+ct: List<&2, U32>, +pone: Nat, +hp: {pone == 1n : Nat}, +one: Nat, +h1: {one == 1n : Nat}, +r0: Nat, +r1: Nat, +r2: Nat, +r3: Nat, +r4: Nat, +kk: L.K, +hk: {kk == L.key(L.F{r0, r1, r2, r3, r4}) : L.K}, +hr0: {C.fits(26n, r0) == True{} : Bool}, +hr1: {C.fits(26n, r1) == True{} : Bool}, +hr2: {C.fits(26n, r2) == True{} : Bool}, +hr3: {C.fits(26n, r3) == True{} : Bool}, +hr4: {C.fits(26n, r4) == True{} : Bool}, +sv: L.F, +hs: {B.lim(26n, sv) == True{} : Bool}, +la: Nat, +h: L.F, +hh: {B.lim(27n, h) == True{} : Bool}, +cnt: Nat) -> {ok_ftail(ct, pone, kk, sv, la, h, cnt) == True{} : Bool}:
  LG.and_intro(ok_pad(pone, ct, kk, h, cnt), ok_tag_len(pone, kk, sv, la, P.absorb_pad(pone, ct, kk, h, cnt)), pad_ok(pone, hp, one, h1, r0, r1, r2, r3, r4, kk, hk, hr0, hr1, hr2, hr3, hr4, ct, h, cnt, hh), tag_len_safe(pone, hp, one, h1, r0, r1, r2, r3, r4, kk, hk, hr0, hr1, hr2, hr3, hr4, sv, hs, la, P.absorb_pad(pone, ct, kk, h, cnt), pad_inv(pone, hp, one, h1, r0, r1, r2, r3, r4, kk, hk, hr0, hr1, hr2, hr3, hr4, ct, h, cnt, hh)))

