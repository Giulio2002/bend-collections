# absorb (16 bytes per step, a short last block through absorb_gen)
def ok_abs(+pone: Nat, +msg: List<&2, U32>, +k: L.K, +h: L.F) -> Bool:
  match msg:
    case Nil{}: True{}
    case x0 <> x1 <> x2 <> x3 <> x4 <> x5 <> x6 <> x7 <> x8 <> x9 <> x10 <> x11 <> x12 <> x13 <> x14 <> x15 <> rest:
      +m = L.load(L.byte(x0), L.byte(x1), L.byte(x2), L.byte(x3), L.byte(x4), L.byte(x5), L.byte(x6), L.byte(x7), L.byte(x8), L.byte(x9), L.byte(x10), L.byte(x11), L.byte(x12), L.byte(x13), L.byte(x14), L.byte(x15), pone)
      Bool.and(O.ok_load(L.byte(x0), L.byte(x1), L.byte(x2), L.byte(x3), L.byte(x4), L.byte(x5), L.byte(x6), L.byte(x7), L.byte(x8), L.byte(x9), L.byte(x10), L.byte(x11), L.byte(x12), L.byte(x13), L.byte(x14), L.byte(x15), pone), Bool.and(O.ok_block(k, h, m), ok_abs(pone, rest, k, L.block(k, h, m))))
    case +x <> +rest: ok_gen(List.length(&2, U32, x <> rest), x <> rest, k, h)

def abs_ok(+pone: Nat, +hp: {pone == 1n : Nat}, +one: Nat, +h1: {one == 1n : Nat}, +r0: Nat, +r1: Nat, +r2: Nat, +r3: Nat, +r4: Nat, +kk: L.K, +hk: {kk == L.key(L.F{r0, r1, r2, r3, r4}) : L.K}, +hr0: {C.fits(26n, r0) == True{} : Bool}, +hr1: {C.fits(26n, r1) == True{} : Bool}, +hr2: {C.fits(26n, r2) == True{} : Bool}, +hr3: {C.fits(26n, r3) == True{} : Bool}, +hr4: {C.fits(26n, r4) == True{} : Bool}, +msg: List<&2, U32>, +h: L.F, +hh: {B.lim(27n, h) == True{} : Bool}) -> {ok_abs(pone, msg, kk, h) == True{} : Bool}:
