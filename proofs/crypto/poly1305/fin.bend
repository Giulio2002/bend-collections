# The tag bytes of an accumulator with 27-bit limbs: ((h mod p) + s) mod 2^128.
def fin_val(+one: Nat, +h1: {one == 1n : Nat}, +b: Nat, +hb: {b == C.shift(13n, one) : Nat}, +w: Nat, +hw: {w == Nat.mul(b, b) : Nat}, +bp: Nat, +h5: {Nat.add(1n+bp, 5n) == C.shift(130n, one) : Nat}, h: L.F, s: L.F, +hh: {B.lim(27n, h) == True{} : Bool}) -> {L.fin(w, h, s) == R.le_bytes(16n, Nat.add(Nat.mod(V.val(h), 1n+bp), V.val(s))) : List<&2, U32>}:
  match h:
    case L.F{+h0, +hq1, +h2, +h3, +h4}:
      +t = L.top(w, L.F{h0, hq1, h2, h3, h4})
      +tb = top_bound(one, h1, b, hb, w, hw, bp, h5, h0, hq1, h2, h3, h4, B.g0(27n, h0, hq1, h2, h3, h4, hh), B.g1(27n, h0, hq1, h2, h3, h4, hh), B.g2(27n, h0, hq1, h2, h3, h4, hh), B.g3(27n, h0, hq1, h2, h3, h4, hh), B.g4(27n, h0, hq1, h2, h3, h4, hh))
      Equal.trans(List<&2, U32>, L.frz(w, t, s), R.le_bytes(16n, Nat.add(Nat.mod(V.val(t), 1n+bp), V.val(s))), R.le_bytes(16n, Nat.add(Nat.mod(V.ev(h0, hq1, h2, h3, h4), 1n+bp), V.val(s))),
        frz_val(one, h1, b, hb, w, hw, bp, h5, t, s, tb),
        Equal.cong(Nat, List<&2, U32>, z => R.le_bytes(16n, Nat.add(z, V.val(s))), Nat.mod(V.val(t), 1n+bp), Nat.mod(V.ev(h0, hq1, h2, h3, h4), 1n+bp), V.top_val(one, h1, b, hb, w, hw, bp, h5, h0, hq1, h2, h3, h4)))
