  %Equal.sym(Nat, Nat.add(Nat.add(C.shift(26n, l1), Nat.add(C.shift(52n, l2), Nat.add(C.shift(78n, l3), C.shift(104n, l4)))), c), Nat.add(C.shift(26n, l1), Nat.add(Nat.add(C.shift(52n, l2), Nat.add(C.shift(78n, l3), C.shift(104n, l4))), c)), NA.add_assoc(C.shift(26n, l1), Nat.add(C.shift(52n, l2), Nat.add(C.shift(78n, l3), C.shift(104n, l4))), c)) : {Nat.add(a, Nat.add(c, Nat.add(C.shift(26n, l1), Nat.add(C.shift(52n, l2), Nat.add(C.shift(78n, l3), C.shift(104n, l4)))))) == Nat.add(a, _) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.add(C.shift(52n, l2), Nat.add(C.shift(78n, l3), C.shift(104n, l4))), c), Nat.add(C.shift(52n, l2), Nat.add(Nat.add(C.shift(78n, l3), C.shift(104n, l4)), c)), NA.add_assoc(C.shift(52n, l2), Nat.add(C.shift(78n, l3), C.shift(104n, l4)), c)) : {Nat.add(a, Nat.add(c, Nat.add(C.shift(26n, l1), Nat.add(C.shift(52n, l2), Nat.add(C.shift(78n, l3), C.shift(104n, l4)))))) == Nat.add(a, Nat.add(C.shift(26n, l1), _)) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.add(C.shift(78n, l3), C.shift(104n, l4)), c), Nat.add(C.shift(78n, l3), Nat.add(C.shift(104n, l4), c)), NA.add_assoc(C.shift(78n, l3), C.shift(104n, l4), c)) : {Nat.add(a, Nat.add(c, Nat.add(C.shift(26n, l1), Nat.add(C.shift(52n, l2), Nat.add(C.shift(78n, l3), C.shift(104n, l4)))))) == Nat.add(a, Nat.add(C.shift(26n, l1), Nat.add(C.shift(52n, l2), _))) : Nat}
  %Equal.sym(Nat, Nat.add(C.shift(104n, l4), c), Nat.add(c, C.shift(104n, l4)), NA.add_comm(C.shift(104n, l4), c)) : {Nat.add(a, Nat.add(c, Nat.add(C.shift(26n, l1), Nat.add(C.shift(52n, l2), Nat.add(C.shift(78n, l3), C.shift(104n, l4)))))) == Nat.add(a, Nat.add(C.shift(26n, l1), Nat.add(C.shift(52n, l2), Nat.add(C.shift(78n, l3), _)))) : Nat}
  %Equal.sym(Nat, Nat.add(C.shift(78n, l3), Nat.add(c, C.shift(104n, l4))), Nat.add(c, Nat.add(C.shift(78n, l3), C.shift(104n, l4))), NA.add_swap(C.shift(78n, l3), c, C.shift(104n, l4))) : {Nat.add(a, Nat.add(c, Nat.add(C.shift(26n, l1), Nat.add(C.shift(52n, l2), Nat.add(C.shift(78n, l3), C.shift(104n, l4)))))) == Nat.add(a, Nat.add(C.shift(26n, l1), Nat.add(C.shift(52n, l2), _))) : Nat}
  %Equal.sym(Nat, Nat.add(C.shift(52n, l2), Nat.add(c, Nat.add(C.shift(78n, l3), C.shift(104n, l4)))), Nat.add(c, Nat.add(C.shift(52n, l2), Nat.add(C.shift(78n, l3), C.shift(104n, l4)))), NA.add_swap(C.shift(52n, l2), c, Nat.add(C.shift(78n, l3), C.shift(104n, l4)))) : {Nat.add(a, Nat.add(c, Nat.add(C.shift(26n, l1), Nat.add(C.shift(52n, l2), Nat.add(C.shift(78n, l3), C.shift(104n, l4)))))) == Nat.add(a, Nat.add(C.shift(26n, l1), _)) : Nat}
  %Equal.sym(Nat, Nat.add(C.shift(26n, l1), Nat.add(c, Nat.add(C.shift(52n, l2), Nat.add(C.shift(78n, l3), C.shift(104n, l4))))), Nat.add(c, Nat.add(C.shift(26n, l1), Nat.add(C.shift(52n, l2), Nat.add(C.shift(78n, l3), C.shift(104n, l4))))), NA.add_swap(C.shift(26n, l1), c, Nat.add(C.shift(52n, l2), Nat.add(C.shift(78n, l3), C.shift(104n, l4))))) : {Nat.add(a, Nat.add(c, Nat.add(C.shift(26n, l1), Nat.add(C.shift(52n, l2), Nat.add(C.shift(78n, l3), C.shift(104n, l4)))))) == Nat.add(a, _) : Nat}
  {==}

# five 26-bit limbs: 130 bits
def ev_fit(+l0: Nat, +l1: Nat, +l2: Nat, +l3: Nat, +l4: Nat, +h0: {C.fits(26n, l0) == True{} : Bool}, +h1: {C.fits(26n, l1) == True{} : Bool}, +h2: {C.fits(26n, l2) == True{} : Bool}, +h3: {C.fits(26n, l3) == True{} : Bool}, +h4: {C.fits(26n, l4) == True{} : Bool}) -> {C.fits(130n, V.ev(l0, l1, l2, l3, l4)) == True{} : Bool}:
  +a = WW.limbs_fit(26n, 26n, l3, l4, h3, h4)
  +c = WW.limbs_fit(26n, 52n, l2, Nat.add(l3, C.shift(26n, l4)), h2, a)
  +d = WW.limbs_fit(26n, 78n, l1, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4)))), h1, c)
  WW.limbs_fit(26n, 104n, l0, Nat.add(l1, C.shift(26n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4)))))), h0, d)

# ---- p is large ----

# x < 64 is below p
def small_p(+one: Nat, +h1: {one == 1n : Nat}, +bp: Nat, +h5: {Nat.add(1n+bp, 5n) == C.shift(130n, one) : Nat}, +x: Nat, +hx: {C.fits(6n, x) == True{} : Bool}) -> {Nat.is_lt(x, 1n+bp) == True{} : Bool}:
  +l64 = WW.lt_of_fits(6n, x, hx)
  +l69 = A.btrue(Nat.is_lt(Nat.add(x, 5n), 69n), Nat.is_lt(x, 64n), WW.lt_cancel_r(x, 64n, 5n), l64)
  +s7 = LG.subst(Nat, z => {Nat.is_le(C.shift(7n, z), C.shift(130n, one)) == True{} : Bool}, one, 1n, h1, WW.shift_ge(123n, C.shift(7n, one)))
  +l2 = N.lt_le_trans(Nat.add(x, 5n), 69n, C.shift(130n, one), l69, N.le_trans(69n, 128n, C.shift(130n, one), {==}, s7))
  +l3 = A.lt_subst(Nat.add(x, 5n), C.shift(130n, one), Nat.add(1n+bp, 5n), Equal.sym(Nat, Nat.add(1n+bp, 5n), C.shift(130n, one), h5), l2)
  A.btrue(Nat.is_lt(x, 1n+bp), Nat.is_lt(Nat.add(x, 5n), Nat.add(1n+bp, 5n)), Equal.sym(Bool, Nat.is_lt(Nat.add(x, 5n), Nat.add(1n+bp, 5n)), Nat.is_lt(x, 1n+bp), WW.lt_cancel_r(x, 1n+bp, 5n)), l3)

# ---- the conditional subtraction ----

def c01(+c: Nat, +h: {C.fits(1n, c) == True{} : Bool}) -> Or({c == 0n : Nat}, {c == 1n : Nat}):
  match c:
    case 0n: Inl{{==}}
    case 1n: Inr{{==}}
    case 2n+k: Empty.absurd(Or({2n+k == 0n : Nat}, {2n+k == 1n : Nat}), LG.false_true(h))

def pick0(+x: Nat, +y: Nat) -> {L.pick(0n, x, y) == x : Nat}:
  %Equal.sym(Nat, Nat.mul(x, 1n), x, NA.mul_one(x)) : {Nat.add(_, Nat.mul(y, 0n)) == x : Nat}
  %Equal.sym(Nat, Nat.mul(y, 0n), 0n, NA.mul_zero(y)) : {Nat.add(x, _) == x : Nat}
  %Equal.sym(Nat, Nat.add(x, 0n), x, NA.add_zero(x)) : {_ == x : Nat}
  {==}

def pick1(+x: Nat, +y: Nat) -> {L.pick(1n, x, y) == y : Nat}:
  %Equal.sym(Nat, Nat.mul(x, 0n), 0n, NA.mul_zero(x)) : {Nat.add(_, Nat.mul(y, 1n)) == y : Nat}
  %Equal.sym(Nat, Nat.mul(y, 1n), y, NA.mul_one(y)) : {Nat.add(0n, _) == y : Nat}
  %Equal.sym(Nat, Nat.add(0n, y), y, SR.zero_add(y)) : {_ == y : Nat}
  {==}

def pk(+c: Nat, +d: Nat, +e: {c == d : Nat}, +x: Nat, +y: Nat) -> {L.pick(c, x, y) == L.pick(d, x, y) : Nat}:
  Equal.cong(Nat, Nat, z => L.pick(z, x, y), c, d, e)

# x + 5 == G + 2^130 c with G below 2^130 and x + 5 < 2^130 + p: selecting
# x (c = 0) or G (c = 1) gives x mod p.
def sel_case(+one: Nat, +h1: {one == 1n : Nat}, +bp: Nat, +h5: {Nat.add(1n+bp, 5n) == C.shift(130n, one) : Nat}, +x0: Nat, +x1: Nat, +x2: Nat, +x3: Nat, +x4: Nat, +g0: Nat, +g1: Nat, +g2: Nat, +g3: Nat, +g4: Nat, +c: Nat, +hE: {Nat.add(V.ev(x0, x1, x2, x3, x4), 5n) == Nat.add(V.ev(g0, g1, g2, g3, g4), C.shift(130n, c)) : Nat}, +hb: {Nat.is_lt(Nat.add(V.ev(x0, x1, x2, x3, x4), 5n), Nat.add(C.shift(130n, one), 1n+bp)) == True{} : Bool}, +hG: {C.fits(130n, V.ev(g0, g1, g2, g3, g4)) == True{} : Bool}, o: Or({c == 0n : Nat}, {c == 1n : Nat})) -> {V.ev(L.pick(c, x0, g0), L.pick(c, x1, g1), L.pick(c, x2, g2), L.pick(c, x3, g3), L.pick(c, x4, g4)) == Nat.mod(V.ev(x0, x1, x2, x3, x4), 1n+bp) : Nat}:
  match o:
    case Inl{+e0}:
      +vx = V.ev(x0, x1, x2, x3, x4)
      +vg = V.ev(g0, g1, g2, g3, g4)
      +s = C.shift(130n, one)
      +pp = {1n+bp : Nat}
      +x5 = Nat.add(vx, 5n)
      +ep = V.ev_cong(L.pick(c, x0, g0), L.pick(c, x1, g1), L.pick(c, x2, g2), L.pick(c, x3, g3), L.pick(c, x4, g4), x0, x1, x2, x3, x4,
        Equal.trans(Nat, L.pick(c, x0, g0), L.pick(0n, x0, g0), x0, pk(c, 0n, e0, x0, g0), pick0(x0, g0)),
        Equal.trans(Nat, L.pick(c, x1, g1), L.pick(0n, x1, g1), x1, pk(c, 0n, e0, x1, g1), pick0(x1, g1)),
        Equal.trans(Nat, L.pick(c, x2, g2), L.pick(0n, x2, g2), x2, pk(c, 0n, e0, x2, g2), pick0(x2, g2)),
        Equal.trans(Nat, L.pick(c, x3, g3), L.pick(0n, x3, g3), x3, pk(c, 0n, e0, x3, g3), pick0(x3, g3)),
        Equal.trans(Nat, L.pick(c, x4, g4), L.pick(0n, x4, g4), x4, pk(c, 0n, e0, x4, g4), pick0(x4, g4)))
      +eg = Equal.trans(Nat, x5, Nat.add(vg, C.shift(130n, c)), vg, hE,
        Equal.trans(Nat, Nat.add(vg, C.shift(130n, c)), Nat.add(vg, C.shift(130n, 0n)), vg, Equal.cong(Nat, Nat, z => Nat.add(vg, C.shift(130n, z)), c, 0n, e0),
          Equal.trans(Nat, Nat.add(vg, C.shift(130n, 0n)), Nat.add(vg, 0n), vg, Equal.cong(Nat, Nat, z => Nat.add(vg, z), C.shift(130n, 0n), 0n, WW.shift_zero(130n)), NA.add_zero(vg))))
      +lg = A.lt_subst(vg, s, Nat.add(pp, 5n), Equal.sym(Nat, Nat.add(pp, 5n), s, h5), WW.lt_one(130n, one, h1, vg, hG))
      +lv = A.btrue(Nat.is_lt(vx, pp), Nat.is_lt(x5, Nat.add(pp, 5n)), Equal.sym(Bool, Nat.is_lt(x5, Nat.add(pp, 5n)), Nat.is_lt(vx, pp), WW.lt_cancel_r(vx, pp, 5n)), A.lt_substl(vg, x5, Nat.add(pp, 5n), Equal.sym(Nat, x5, vg, eg), lg))
      Equal.trans(Nat, V.ev(L.pick(c, x0, g0), L.pick(c, x1, g1), L.pick(c, x2, g2), L.pick(c, x3, g3), L.pick(c, x4, g4)), vx, Nat.mod(vx, pp), ep, Equal.sym(Nat, Nat.mod(vx, pp), vx, NR.mod_of(0n, bp, vx, lv)))
    case Inr{+e1}:
      +vx = V.ev(x0, x1, x2, x3, x4)
      +vg = V.ev(g0, g1, g2, g3, g4)
      +s = C.shift(130n, one)
      +pp = {1n+bp : Nat}
      +x5 = Nat.add(vx, 5n)
      +ec = Equal.trans(Nat, c, 1n, one, e1, Equal.sym(Nat, one, 1n, h1))
      +ep = V.ev_cong(L.pick(c, x0, g0), L.pick(c, x1, g1), L.pick(c, x2, g2), L.pick(c, x3, g3), L.pick(c, x4, g4), g0, g1, g2, g3, g4,
        Equal.trans(Nat, L.pick(c, x0, g0), L.pick(1n, x0, g0), g0, pk(c, 1n, e1, x0, g0), pick1(x0, g0)),
        Equal.trans(Nat, L.pick(c, x1, g1), L.pick(1n, x1, g1), g1, pk(c, 1n, e1, x1, g1), pick1(x1, g1)),
        Equal.trans(Nat, L.pick(c, x2, g2), L.pick(1n, x2, g2), g2, pk(c, 1n, e1, x2, g2), pick1(x2, g2)),
        Equal.trans(Nat, L.pick(c, x3, g3), L.pick(1n, x3, g3), g3, pk(c, 1n, e1, x3, g3), pick1(x3, g3)),
        Equal.trans(Nat, L.pick(c, x4, g4), L.pick(1n, x4, g4), g4, pk(c, 1n, e1, x4, g4), pick1(x4, g4)))
      +eS = Equal.trans(Nat, x5, Nat.add(vg, C.shift(130n, c)), Nat.add(vg, s), hE, Equal.cong(Nat, Nat, z => Nat.add(vg, C.shift(130n, z)), c, one, ec))
      +e5 = Equal.trans(Nat, Nat.add(5n, vx), x5, Nat.add(5n, Nat.add(vg, pp)), NA.add_comm(5n, vx),
        Equal.trans(Nat, x5, Nat.add(vg, s), Nat.add(5n, Nat.add(vg, pp)), eS,
          Equal.trans(Nat, Nat.add(vg, s), Nat.add(vg, Nat.add(pp, 5n)), Nat.add(5n, Nat.add(vg, pp)), Equal.cong(Nat, Nat, z => Nat.add(vg, z), s, Nat.add(pp, 5n), Equal.sym(Nat, Nat.add(pp, 5n), s, h5)),
            Equal.trans(Nat, Nat.add(vg, Nat.add(pp, 5n)), Nat.add(Nat.add(vg, pp), 5n), Nat.add(5n, Nat.add(vg, pp)), Equal.sym(Nat, Nat.add(Nat.add(vg, pp), 5n), Nat.add(vg, Nat.add(pp, 5n)), NA.add_assoc(vg, pp, 5n)), NA.add_comm(Nat.add(vg, pp), 5n)))))
      +evx = NR.add_cancel(5n, vx, Nat.add(vg, pp), e5)
      +lb2 = A.lt_substl(x5, Nat.add(vg, s), Nat.add(s, pp), eS, hb)
      +lb3 = A.lt_subst(Nat.add(vg, s), Nat.add(s, pp), Nat.add(pp, s), NA.add_comm(s, pp), lb2)
      +lgp = A.btrue(Nat.is_lt(vg, pp), Nat.is_lt(Nat.add(vg, s), Nat.add(pp, s)), Equal.sym(Bool, Nat.is_lt(Nat.add(vg, s), Nat.add(pp, s)), Nat.is_lt(vg, pp), WW.lt_cancel_r(vg, pp, s)), lb3)
      +em = Equal.trans(Nat, Nat.mod(vx, pp), Nat.mod(Nat.add(Nat.mul(1n, pp), vg), pp), vg,
        Equal.cong(Nat, Nat, z => Nat.mod(z, pp), vx, Nat.add(Nat.mul(1n, pp), vg),
          Equal.trans(Nat, vx, Nat.add(vg, pp), Nat.add(Nat.mul(1n, pp), vg), evx,
            Equal.trans(Nat, Nat.add(vg, pp), Nat.add(pp, vg), Nat.add(Nat.mul(1n, pp), vg), NA.add_comm(vg, pp), Equal.cong(Nat, Nat, z => Nat.add(z, vg), pp, Nat.mul(1n, pp), Equal.sym(Nat, Nat.mul(1n, pp), pp, SR.one_mul(pp)))))),
        Equal.trans(Nat, Nat.mod(Nat.add(Nat.mul(1n, pp), vg), pp), Nat.mod(vg, pp), vg, NR.absorb(bp, 1n, vg), NR.mod_of(0n, bp, vg, lgp)))
      Equal.trans(Nat, V.ev(L.pick(c, x0, g0), L.pick(c, x1, g1), L.pick(c, x2, g2), L.pick(c, x3, g3), L.pick(c, x4, g4)), vg, Nat.mod(vx, pp), ep, Equal.sym(Nat, Nat.mod(vx, pp), vg, em))

def sel_val(+one: Nat, +h1: {one == 1n : Nat}, +bp: Nat, +h5: {Nat.add(1n+bp, 5n) == C.shift(130n, one) : Nat}, +x0: Nat, +x1: Nat, +x2: Nat, +x3: Nat, +x4: Nat, +g0: Nat, +g1: Nat, +g2: Nat, +g3: Nat, +g4: Nat, +c: Nat, +hE: {Nat.add(V.ev(x0, x1, x2, x3, x4), 5n) == Nat.add(V.ev(g0, g1, g2, g3, g4), C.shift(130n, c)) : Nat}, +hb: {Nat.is_lt(Nat.add(V.ev(x0, x1, x2, x3, x4), 5n), Nat.add(C.shift(130n, one), 1n+bp)) == True{} : Bool}, +hG: {C.fits(130n, V.ev(g0, g1, g2, g3, g4)) == True{} : Bool}) -> {V.ev(L.pick(c, x0, g0), L.pick(c, x1, g1), L.pick(c, x2, g2), L.pick(c, x3, g3), L.pick(c, x4, g4)) == Nat.mod(V.ev(x0, x1, x2, x3, x4), 1n+bp) : Nat}:
  +vx = V.ev(x0, x1, x2, x3, x4)
  +vg = V.ev(g0, g1, g2, g3, g4)
  +s = C.shift(130n, one)
  +pp = {1n+bp : Nat}
  +x5 = Nat.add(vx, 5n)
  +le1 = A.le_subst(pp, Nat.add(pp, 5n), s, h5, N.le_add_right(pp, 5n))
  +lx2 = N.lt_le_trans(x5, Nat.add(s, pp), Nat.add(s, s), hb, N.le_add_left(pp, s, s, le1))
  +lx3 = A.lt_subst(x5, Nat.add(s, s), Nat.double(s), Equal.sym(Nat, Nat.double(s), Nat.add(s, s), NA.double_self(s)), lx2)
  +f131 = A.fits_subst(131n, x5, Nat.add(vg, C.shift(130n, c)), hE, WW.fits_one(131n, one, h1, x5, lx3))
  +hc1 = A.fits_subst(1n, C.high(130n, Nat.add(vg, C.shift(130n, c))), c, WW.high_u(130n, vg, c, hG), SH.fits_high(130n, 1n, Nat.add(vg, C.shift(130n, c)), f131))
  sel_case(one, h1, bp, h5, x0, x1, x2, x3, x4, g0, g1, g2, g3, g4, c, hE, hb, hG, c01(c, hc1))

# ---- the tag ----

# top brings a 27-bit-limb accumulator below 2^130 + 64 <= 2^130 + p
def top_bound(+one: Nat, +h1: {one == 1n : Nat}, +b: Nat, +hb: {b == C.shift(13n, one) : Nat}, +w: Nat, +hw: {w == Nat.mul(b, b) : Nat}, +bp: Nat, +h5: {Nat.add(1n+bp, 5n) == C.shift(130n, one) : Nat}, +h0: Nat, +h1l: Nat, +h2: Nat, +h3: Nat, +h4: Nat, +hh0: {C.fits(27n, h0) == True{} : Bool}, +hh1: {C.fits(27n, h1l) == True{} : Bool}, +hh2: {C.fits(27n, h2) == True{} : Bool}, +hh3: {C.fits(27n, h3) == True{} : Bool}, +hh4: {C.fits(27n, h4) == True{} : Bool}) -> {Nat.is_lt(Nat.add(V.val(L.top(w, L.F{h0, h1l, h2, h3, h4})), 5n), Nat.add(C.shift(130n, one), 1n+bp)) == True{} : Bool}:
  +t1 = Nat.div(h0, w)
  +p2 = K.fdw(one, h1, b, hb, w, hw, 1n, h0, hh0)
  +t3 = Nat.add(h1l, t1)
  +p4 = B.fa(27n, 1n, h1l, t1, {==}, hh1, p2)
  +t5 = Nat.div(t3, w)
  +p6 = K.fdw(one, h1, b, hb, w, hw, 2n, t3, p4)
  +t7 = Nat.add(h2, t5)
  +p8 = B.fa(27n, 2n, h2, t5, {==}, hh2, p6)
  +t9 = Nat.div(t7, w)
  +p10 = K.fdw(one, h1, b, hb, w, hw, 2n, t7, p8)
  +t11 = Nat.add(h3, t9)
  +p12 = B.fa(27n, 2n, h3, t9, {==}, hh3, p10)
  +t13 = Nat.div(t11, w)
  +p14 = K.fdw(one, h1, b, hb, w, hw, 2n, t11, p12)
  +t15 = Nat.add(h4, t13)
  +p16 = B.fa(27n, 2n, h4, t13, {==}, hh4, p14)
