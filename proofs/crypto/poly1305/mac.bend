def tln(n: Nat, +xs: List<&2, U32>) -> List<&2, U32>:
  match n:
    case 0n: xs
    case 1n+m: tln(m, P.tl(xs))

law tln_nil:
  for +n: Nat
  {tln(n, []) == [] : List<&2, U32>}

def tln_nil(n):
  match n:
    case 0n: {==}
    case 1n+m: tln_nil(m)

law suffix_tln:
  for +n: Nat
  for +xs: List<&2, U32>
  {R.suffix(n, xs) == tln(n, xs) : List<&2, U32>}

def suffix_tln(n, xs):
  match n xs:
    case 0n _: {==}
    case 1n+m Nil{}: Equal.sym(List<&2, U32>, tln(m, []), [], tln_nil(m))
    case 1n+m x <> t: suffix_tln(m, t)

