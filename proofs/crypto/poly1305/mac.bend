                                                                                                                  match t27:
                                                                                                                    case Nil{}: {==}
                                                                                                                    case +k28 <> +t28:
                                                                                                                      match t28:
                                                                                                                        case Nil{}: {==}
                                                                                                                        case +k29 <> +t29:
