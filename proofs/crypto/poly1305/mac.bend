                                                                                                                                case Nil{}: {==}
                                                                                                                                case +k31 <> +t31:
                                                                                                                                  match t31:
                                                                                                                                    case Nil{}:
                                                                                                                                      Empty.absurd({P.poly1305_w(pone, k0 <> k1 <> k2 <> k3 <> k4 <> k5 <> k6 <> k7 <> k8 <> k9 <> k10 <> k11 <> k12 <> k13 <> k14 <> k15 <> k16 <> k17 <> k18 <> k19 <> k20 <> k21 <> k22 <> k23 <> k24 <> k25 <> k26 <> k27 <> k28 <> k29 <> k30 <> k31 <> Nil{}, msg) == None{} : Maybe<&2, List<&2, U32>>}, LG.false_true(Equal.sym(Bool, True{}, False{}, h)))
                                                                                                                                    case +x <> +rest: {==}

# The checked API: the tag for a 32-byte key, None for any other length.
law poly1305_valid:
  for +key: List<&2, U32>
  for +msg: List<&2, U32>
  for +h: {Nat.is_eq(List.length(&2, U32, key), 32n) == True{} : Bool}
  {P.poly1305(key, msg) == Some{R.mac(key, msg)} : Maybe<&2, List<&2, U32>>}

def poly1305_valid(key, msg, h):
  match msg:
    case Nil{}: pv(1n, {==}, 1n, {==}, bpv(1n), bp5(1n, {==}), key, [], h)
    case x <> rest: pv(1n, {==}, 1n, {==}, bpv(1n), bp5(1n, {==}), key, x <> rest, h)

law poly1305_invalid:
  for +key: List<&2, U32>
  for +msg: List<&2, U32>
  for +h: {Nat.is_eq(List.length(&2, U32, key), 32n) == False{} : Bool}
  {P.poly1305(key, msg) == None{} : Maybe<&2, List<&2, U32>>}

def poly1305_invalid(key, msg, h):
  pinv(1n, key, msg, h)
