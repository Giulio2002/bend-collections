def pinv(+pone: Nat, +key: List<&2, U32>, +msg: List<&2, U32>, +h: {Nat.is_eq(List.length(&2, U32, key), 32n) == False{} : Bool}) -> {P.poly1305_w(pone, key, msg) == None{} : Maybe<&2, List<&2, U32>>}:
  match key:
    case Nil{}: {==}
    case +k0 <> +t0:
      match t0:
        case Nil{}: {==}
        case +k1 <> +t1:
          match t1:
            case Nil{}: {==}
            case +k2 <> +t2:
              match t2:
                case Nil{}: {==}
                case +k3 <> +t3:
                  match t3:
                    case Nil{}: {==}
                    case +k4 <> +t4:
                      match t4:
                        case Nil{}: {==}
                        case +k5 <> +t5:
                          match t5:
                            case Nil{}: {==}
                            case +k6 <> +t6:
                              match t6:
                                case Nil{}: {==}
                                case +k7 <> +t7:
                                  match t7:
                                    case Nil{}: {==}
                                    case +k8 <> +t8:
                                      match t8:
                                        case Nil{}: {==}
                                        case +k9 <> +t9:
                                          match t9:
                                            case Nil{}: {==}
                                            case +k10 <> +t10:
                                              match t10:
                                                case Nil{}: {==}
                                                case +k11 <> +t11:
                                                  match t11:
                                                    case Nil{}: {==}
                                                    case +k12 <> +t12:
                                                      match t12:
                                                        case Nil{}: {==}
                                                        case +k13 <> +t13:
                                                          match t13:
                                                            case Nil{}: {==}
                                                            case +k14 <> +t14:
                                                              match t14:
                                                                case Nil{}: {==}
                                                                case +k15 <> +t15:
                                                                  match t15:
                                                                    case Nil{}: {==}
                                                                    case +k16 <> +t16:
                                                                      match t16:
                                                                        case Nil{}: {==}
                                                                        case +k17 <> +t17:
                                                                          match t17:
                                                                            case Nil{}: {==}
                                                                            case +k18 <> +t18:
                                                                              match t18:
                                                                                case Nil{}: {==}
                                                                                case +k19 <> +t19:
                                                                                  match t19:
                                                                                    case Nil{}: {==}
                                                                                    case +k20 <> +t20:
                                                                                      match t20:
                                                                                        case Nil{}: {==}
                                                                                        case +k21 <> +t21:
                                                                                          match t21:
                                                                                            case Nil{}: {==}
                                                                                            case +k22 <> +t22:
                                                                                              match t22:
                                                                                                case Nil{}: {==}
                                                                                                case +k23 <> +t23:
                                                                                                  match t23:
                                                                                                    case Nil{}: {==}
                                                                                                    case +k24 <> +t24:
                                                                                                      match t24:
                                                                                                        case Nil{}: {==}
                                                                                                        case +k25 <> +t25:
                                                                                                          match t25:
                                                                                                            case Nil{}: {==}
                                                                                                            case +k26 <> +t26:
