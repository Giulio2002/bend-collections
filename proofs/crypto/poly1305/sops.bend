# ---- composite functions ----

def ok_carry(+z: L.F) -> Bool:
  Bool.and(ok_top(z), ok_fix(L.top(z)))

def carry_mirror(+z: L.F) -> {L.carry(z) == L.fix(L.top(z)) : L.F}:
  {==}

def carry_ok(+z: L.F, +hz: {B.lim(47n, z) == True{} : Bool}) -> {ok_carry(z) == True{} : Bool}:
  LG.and_intro(ok_top(z), ok_fix(L.top(z)), top_ok_r(z, hz), fix_ok_r(L.top(z), top_fit_r(z, hz)))

def ok_fin(+h: L.F, +s: L.F) -> Bool:
  Bool.and(ok_top(h), ok_frz(L.top(h), s))

def fin_mirror(+h: L.F, +s: L.F) -> {L.fin(h, s) == L.frz(L.top(h), s) : List<&2, U32>}:
  {==}

# the final reduction of an accumulator of 27-bit limbs, s of 26-bit limbs
def fin_ok(+h: L.F, +s: L.F, +hh: {B.lim(27n, h) == True{} : Bool}, +hs: {B.lim(26n, s) == True{} : Bool}) -> {ok_fin(h, s) == True{} : Bool}:
  +h47 = lim_mono(27n, 47n, {==}, h, hh)
  LG.and_intro(ok_top(h), ok_frz(L.top(h), s), top_ok_r(h, h47), frz_ok_r(L.top(h), s, top_fit_r(h, h47), hs))

# one block: h + m, the two products, their combination, the carry pass
def ok_block(+k: L.K, +h: L.F, +m: L.F) -> Bool:
  match k h m:
    case L.K{+e0, +e1, +e2, +e3, +e4, +f1, +f2, +f3, +f4, +o0, +o1, +o2, +o3, +o4, +g1, +g2, +g3, +g4} L.F{+h0, +h1, +h2, +h3, +h4} L.F{+m0, +m1, +m2, +m3, +m4}:
      +a0 = Nat.add(h0, m0)
      +a1 = Nat.add(h1, m1)
      +a2 = Nat.add(h2, m2)
      +a3 = Nat.add(h3, m3)
      +a4 = Nat.add(h4, m4)
      +dd = L.mul(a0, a1, a2, a3, a4, e0, e1, e2, e3, e4, f1, f2, f3, f4)
      +oo = L.mul(a0, a1, a2, a3, a4, o0, o1, o2, o3, o4, g1, g2, g3, g4)
      Bool.and(C.fits(48n, a0), Bool.and(C.fits(48n, a1), Bool.and(C.fits(48n, a2), Bool.and(C.fits(48n, a3), Bool.and(C.fits(48n, a4), Bool.and(ok_mul(a0, a1, a2, a3, a4, e0, e1, e2, e3, e4, f1, f2, f3, f4), Bool.and(ok_mul(a0, a1, a2, a3, a4, o0, o1, o2, o3, o4, g1, g2, g3, g4), Bool.and(ok_comb(dd, oo), ok_carry(L.comb(dd, oo))))))))))

def block_mirror(+e0: Nat, +e1: Nat, +e2: Nat, +e3: Nat, +e4: Nat, +f1: Nat, +f2: Nat, +f3: Nat, +f4: Nat, +o0: Nat, +o1: Nat, +o2: Nat, +o3: Nat, +o4: Nat, +g1: Nat, +g2: Nat, +g3: Nat, +g4: Nat, +h0: Nat, +h1: Nat, +h2: Nat, +h3: Nat, +h4: Nat, +m0: Nat, +m1: Nat, +m2: Nat, +m3: Nat, +m4: Nat) -> {L.block(L.K{e0, e1, e2, e3, e4, f1, f2, f3, f4, o0, o1, o2, o3, o4, g1, g2, g3, g4}, L.F{h0, h1, h2, h3, h4}, L.F{m0, m1, m2, m3, m4}) == L.carry(L.comb(L.mul(Nat.add(h0, m0), Nat.add(h1, m1), Nat.add(h2, m2), Nat.add(h3, m3), Nat.add(h4, m4), e0, e1, e2, e3, e4, f1, f2, f3, f4), L.mul(Nat.add(h0, m0), Nat.add(h1, m1), Nat.add(h2, m2), Nat.add(h3, m3), Nat.add(h4, m4), o0, o1, o2, o3, o4, g1, g2, g3, g4))) : L.F}:
  {==}

# a block with the key of r (26-bit limbs), h of 27-bit limbs, m of 26
def block_ok(+r0: Nat, +r1: Nat, +r2: Nat, +r3: Nat, +r4: Nat, +hr0: {C.fits(26n, r0) == True{} : Bool}, +hr1: {C.fits(26n, r1) == True{} : Bool}, +hr2: {C.fits(26n, r2) == True{} : Bool}, +hr3: {C.fits(26n, r3) == True{} : Bool}, +hr4: {C.fits(26n, r4) == True{} : Bool}, +h: L.F, +m: L.F, +hh: {B.lim(27n, h) == True{} : Bool}, +hm: {B.lim(26n, m) == True{} : Bool}) -> {ok_block(L.key(L.F{r0, r1, r2, r3, r4}), h, m) == True{} : Bool}:
  match h m:
    case L.F{+h0, +h1, +h2, +h3, +h4} L.F{+m0, +m1, +m2, +m3, +m4}:
      +a0 = Nat.add(h0, m0)
      +pa0 = B.fa(27n, 26n, h0, m0, {==}, B.g0(27n, h0, h1, h2, h3, h4, hh), B.g0(26n, m0, m1, m2, m3, m4, hm))
      +a1 = Nat.add(h1, m1)
      +pa1 = B.fa(27n, 26n, h1, m1, {==}, B.g1(27n, h0, h1, h2, h3, h4, hh), B.g1(26n, m0, m1, m2, m3, m4, hm))
      +a2 = Nat.add(h2, m2)
      +pa2 = B.fa(27n, 26n, h2, m2, {==}, B.g2(27n, h0, h1, h2, h3, h4, hh), B.g2(26n, m0, m1, m2, m3, m4, hm))
      +a3 = Nat.add(h3, m3)
      +pa3 = B.fa(27n, 26n, h3, m3, {==}, B.g3(27n, h0, h1, h2, h3, h4, hh), B.g3(26n, m0, m1, m2, m3, m4, hm))
      +a4 = Nat.add(h4, m4)
      +pa4 = B.fa(27n, 26n, h4, m4, {==}, B.g4(27n, h0, h1, h2, h3, h4, hh), B.g4(26n, m0, m1, m2, m3, m4, hm))
      +e0 = Nat.mod(r0, 8192n)
      +pe0 = K.fmb(r0)
      +o0 = Nat.div(r0, 8192n)
      +po0 = K.fdb(13n, r0, hr0)
      +e1 = Nat.mod(r1, 8192n)
      +pe1 = K.fmb(r1)
      +o1 = Nat.div(r1, 8192n)
      +po1 = K.fdb(13n, r1, hr1)
      +e2 = Nat.mod(r2, 8192n)
      +pe2 = K.fmb(r2)
      +o2 = Nat.div(r2, 8192n)
      +po2 = K.fdb(13n, r2, hr2)
      +e3 = Nat.mod(r3, 8192n)
      +pe3 = K.fmb(r3)
      +o3 = Nat.div(r3, 8192n)
      +po3 = K.fdb(13n, r3, hr3)
      +e4 = Nat.mod(r4, 8192n)
      +pe4 = K.fmb(r4)
      +o4 = Nat.div(r4, 8192n)
      +po4 = K.fdb(13n, r4, hr4)
      +f1 = Nat.mul(e1, 5n)
      +pf1 = B.f5(13n, e1, pe1)
      +g1 = Nat.mul(o1, 5n)
      +pg1 = B.f5(13n, o1, po1)
      +f2 = Nat.mul(e2, 5n)
      +pf2 = B.f5(13n, e2, pe2)
      +g2 = Nat.mul(o2, 5n)
      +pg2 = B.f5(13n, o2, po2)
      +f3 = Nat.mul(e3, 5n)
      +pf3 = B.f5(13n, e3, pe3)
      +g3 = Nat.mul(o3, 5n)
      +pg3 = B.f5(13n, o3, po3)
      +f4 = Nat.mul(e4, 5n)
      +pf4 = B.f5(13n, e4, pe4)
      +g4 = Nat.mul(o4, 5n)
      +pg4 = B.f5(13n, o4, po4)
      +dd = L.mul(a0, a1, a2, a3, a4, e0, e1, e2, e3, e4, f1, f2, f3, f4)
      +oo = L.mul(a0, a1, a2, a3, a4, o0, o1, o2, o3, o4, g1, g2, g3, g4)
      +hd = mul_col(28n, 13n, a0, a1, a2, a3, a4, e0, e1, e2, e3, e4, pa0, pa1, pa2, pa3, pa4, pe0, pe1, pe2, pe3, pe4)
      +ho = mul_col(28n, 13n, a0, a1, a2, a3, a4, o0, o1, o2, o3, o4, pa0, pa1, pa2, pa3, pa4, po0, po1, po2, po3, po4)
      +c8 = ok_carry(L.comb(dd, oo))
      +c7 = Bool.and(ok_comb(dd, oo), c8)
      +c6 = Bool.and(ok_mul(a0, a1, a2, a3, a4, o0, o1, o2, o3, o4, g1, g2, g3, g4), c7)
      +c5 = Bool.and(ok_mul(a0, a1, a2, a3, a4, e0, e1, e2, e3, e4, f1, f2, f3, f4), c6)
      +c4 = Bool.and(C.fits(48n, a4), c5)
      +c3 = Bool.and(C.fits(48n, a3), c4)
      +c2 = Bool.and(C.fits(48n, a2), c3)
      +c1 = Bool.and(C.fits(48n, a1), c2)
      +c0 = Bool.and(C.fits(48n, a0), c1)
      +q8 = carry_ok(L.comb(dd, oo), comb_fit_r(dd, oo, hd, ho))
      +q7 = LG.and_intro(ok_comb(dd, oo), c8, comb_ok_r(dd, oo, hd, ho), q8)
      +q6 = LG.and_intro(ok_mul(a0, a1, a2, a3, a4, o0, o1, o2, o3, o4, g1, g2, g3, g4), c7, mul_ok(a0, a1, a2, a3, a4, o0, o1, o2, o3, o4, g1, g2, g3, g4, pa0, pa1, pa2, pa3, pa4, po0, po1, po2, po3, po4, pg1, pg2, pg3, pg4), q7)
      +q5 = LG.and_intro(ok_mul(a0, a1, a2, a3, a4, e0, e1, e2, e3, e4, f1, f2, f3, f4), c6, mul_ok(a0, a1, a2, a3, a4, e0, e1, e2, e3, e4, f1, f2, f3, f4, pa0, pa1, pa2, pa3, pa4, pe0, pe1, pe2, pe3, pe4, pf1, pf2, pf3, pf4), q6)
      +q4 = LG.and_intro(C.fits(48n, a4), c5, B.fm(28n, 48n, a4, {==}, pa4), q5)
      +q3 = LG.and_intro(C.fits(48n, a3), c4, B.fm(28n, 48n, a3, {==}, pa3), q4)
      +q2 = LG.and_intro(C.fits(48n, a2), c3, B.fm(28n, 48n, a2, {==}, pa2), q3)
      +q1 = LG.and_intro(C.fits(48n, a1), c2, B.fm(28n, 48n, a1, {==}, pa1), q2)
      +q0 = LG.and_intro(C.fits(48n, a0), c1, B.fm(28n, 48n, a0, {==}, pa0), q1)
      q0
