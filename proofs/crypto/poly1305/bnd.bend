  +t31 = L.mw(t15)
  +p32 = K.fmw(t15)
  +t33 = L.mw(t23)
  +p34 = K.fmw(t23)
  +p35 = fm(26n, 27n, t33, {==}, p34)
  +t36 = L.dw(t23)
  +p37 = K.fdw(2n, t23, p24)
  +t38 = Nat.add(t25, t36)
  +p39 = fa(26n, 2n, t25, t36, {==}, p26, p37)
  +p40 = fm(26n, 27n, t27, {==}, p28)
  +p41 = fm(26n, 27n, t29, {==}, p30)
  +p42 = fm(26n, 27n, t31, {==}, p32)
  mk(27n, t33, t38, t27, t29, t31, p35, p39, p40, p41, p42)

def carry_fit_r(+one: Nat, +h1: {one == 1n : Nat}, z: L.F, +hz: {lim(49n, z) == True{} : Bool}) -> {lim(27n, L.carry(z)) == True{} : Bool}:
  match z:
    case L.F{+z0, +z1, +z2, +z3, +z4}:
      carry_fit(one, h1, z0, z1, z2, z3, z4, g0(49n, z0, z1, z2, z3, z4, hz), g1(49n, z0, z1, z2, z3, z4, hz), g2(49n, z0, z1, z2, z3, z4, hz), g3(49n, z0, z1, z2, z3, z4, hz), g4(49n, z0, z1, z2, z3, z4, hz))

# One block keeps every limb at 27 bits, for a key of 26-bit limbs and a
# message block of 26-bit limbs.
def block_inv(+one: Nat, +h1: {one == 1n : Nat}, +r0: Nat, +r1: Nat, +r2: Nat, +r3: Nat, +r4: Nat, +hr0: {C.fits(26n, r0) == True{} : Bool}, +hr1: {C.fits(26n, r1) == True{} : Bool}, +hr2: {C.fits(26n, r2) == True{} : Bool}, +hr3: {C.fits(26n, r3) == True{} : Bool}, +hr4: {C.fits(26n, r4) == True{} : Bool}, h: L.F, m: L.F, +hh: {lim(27n, h) == True{} : Bool}, +hm: {lim(26n, m) == True{} : Bool}) -> {lim(27n, L.block(L.key(L.F{r0, r1, r2, r3, r4}), h, m)) == True{} : Bool}:
  match h m:
    case L.F{+hh0, +hh1, +hh2, +hh3, +hh4} L.F{+mm0, +mm1, +mm2, +mm3, +mm4}:
      +t1 = Nat.add(hh0, mm0)
      +p2 = fa(27n, 26n, hh0, mm0, {==}, g0(27n, hh0, hh1, hh2, hh3, hh4, hh), g0(26n, mm0, mm1, mm2, mm3, mm4, hm))
      +t3 = Nat.add(hh1, mm1)
      +p4 = fa(27n, 26n, hh1, mm1, {==}, g1(27n, hh0, hh1, hh2, hh3, hh4, hh), g1(26n, mm0, mm1, mm2, mm3, mm4, hm))
      +t5 = Nat.add(hh2, mm2)
      +p6 = fa(27n, 26n, hh2, mm2, {==}, g2(27n, hh0, hh1, hh2, hh3, hh4, hh), g2(26n, mm0, mm1, mm2, mm3, mm4, hm))
      +t7 = Nat.add(hh3, mm3)
      +p8 = fa(27n, 26n, hh3, mm3, {==}, g3(27n, hh0, hh1, hh2, hh3, hh4, hh), g3(26n, mm0, mm1, mm2, mm3, mm4, hm))
      +t9 = Nat.add(hh4, mm4)
      +p10 = fa(27n, 26n, hh4, mm4, {==}, g4(27n, hh0, hh1, hh2, hh3, hh4, hh), g4(26n, mm0, mm1, mm2, mm3, mm4, hm))
      +t11 = Nat.mod(r0, 8192n)
      +p12 = K.fmb(r0)
      +t13 = Nat.mod(r1, 8192n)
      +p14 = K.fmb(r1)
      +t15 = Nat.mod(r2, 8192n)
      +p16 = K.fmb(r2)
      +t17 = Nat.mod(r3, 8192n)
      +p18 = K.fmb(r3)
      +t19 = Nat.mod(r4, 8192n)
      +p20 = K.fmb(r4)
      +t21 = Nat.div(r0, 8192n)
      +p22 = K.fdb(13n, r0, hr0)
      +t23 = Nat.div(r1, 8192n)
      +p24 = K.fdb(13n, r1, hr1)
      +t25 = Nat.div(r2, 8192n)
      +p26 = K.fdb(13n, r2, hr2)
      +t27 = Nat.div(r3, 8192n)
      +p28 = K.fdb(13n, r3, hr3)
      +t29 = Nat.div(r4, 8192n)
      +p30 = K.fdb(13n, r4, hr4)
      +dd = L.mul(t1, t3, t5, t7, t9, t11, t13, t15, t17, t19, Nat.mul(t13, 5n), Nat.mul(t15, 5n), Nat.mul(t17, 5n), Nat.mul(t19, 5n))
      +oo = L.mul(t1, t3, t5, t7, t9, t21, t23, t25, t27, t29, Nat.mul(t23, 5n), Nat.mul(t25, 5n), Nat.mul(t27, 5n), Nat.mul(t29, 5n))
      carry_fit_r(one, h1, L.comb(dd, oo), comb_fit_r(one, h1, dd, oo, mul_fit(t1, t3, t5, t7, t9, t11, t13, t15, t17, t19, p2, p4, p6, p8, p10, p12, p14, p16, p18, p20), mul_fit(t1, t3, t5, t7, t9, t21, t23, t25, t27, t29, p2, p4, p6, p8, p10, p22, p24, p26, p28, p30)))

# y (k bits) at 2^8, 2^6, 2^4, 2^2 above x
def f256(+k: Nat, +x: Nat, +y: Nat, +hx: {C.fits(8n, x) == True{} : Bool}, +hy: {C.fits(k, y) == True{} : Bool}) -> {C.fits(Nat.add(8n, k), Nat.add(x, Nat.mul(y, 256n))) == True{} : Bool}:
  %Equal.sym(Nat, Nat.mul(y, 256n), C.shift(8n, y), K.m256(y)) : {C.fits(Nat.add(8n, k), Nat.add(x, _)) == True{} : Bool}
  WW.limbs_fit(8n, k, x, y, hx, hy)

def f64(+k: Nat, +x: Nat, +y: Nat, +hx: {C.fits(6n, x) == True{} : Bool}, +hy: {C.fits(k, y) == True{} : Bool}) -> {C.fits(Nat.add(6n, k), Nat.add(x, Nat.mul(y, 64n))) == True{} : Bool}:
  %Equal.sym(Nat, Nat.mul(y, 64n), C.shift(6n, y), K.m64(y)) : {C.fits(Nat.add(6n, k), Nat.add(x, _)) == True{} : Bool}
  WW.limbs_fit(6n, k, x, y, hx, hy)

def f16(+k: Nat, +x: Nat, +y: Nat, +hx: {C.fits(4n, x) == True{} : Bool}, +hy: {C.fits(k, y) == True{} : Bool}) -> {C.fits(Nat.add(4n, k), Nat.add(x, Nat.mul(y, 16n))) == True{} : Bool}:
  %Equal.sym(Nat, Nat.mul(y, 16n), C.shift(4n, y), K.m16(y)) : {C.fits(Nat.add(4n, k), Nat.add(x, _)) == True{} : Bool}
  WW.limbs_fit(4n, k, x, y, hx, hy)

def f4(+k: Nat, +x: Nat, +y: Nat, +hx: {C.fits(2n, x) == True{} : Bool}, +hy: {C.fits(k, y) == True{} : Bool}) -> {C.fits(Nat.add(2n, k), Nat.add(x, Nat.mul(y, 4n))) == True{} : Bool}:
  %Equal.sym(Nat, Nat.mul(y, 4n), C.shift(2n, y), K.m4(y)) : {C.fits(Nat.add(2n, k), Nat.add(x, _)) == True{} : Bool}
  WW.limbs_fit(2n, k, x, y, hx, hy)

def load_fit(+x0: Nat, +x1: Nat, +x2: Nat, +x3: Nat, +x4: Nat, +x5: Nat, +x6: Nat, +x7: Nat, +x8: Nat, +x9: Nat, +x10: Nat, +x11: Nat, +x12: Nat, +x13: Nat, +x14: Nat, +x15: Nat, +pb: Nat, +hx0: {C.fits(8n, x0) == True{} : Bool}, +hx1: {C.fits(8n, x1) == True{} : Bool}, +hx2: {C.fits(8n, x2) == True{} : Bool}, +hx3: {C.fits(8n, x3) == True{} : Bool}, +hx4: {C.fits(8n, x4) == True{} : Bool}, +hx5: {C.fits(8n, x5) == True{} : Bool}, +hx6: {C.fits(8n, x6) == True{} : Bool}, +hx7: {C.fits(8n, x7) == True{} : Bool}, +hx8: {C.fits(8n, x8) == True{} : Bool}, +hx9: {C.fits(8n, x9) == True{} : Bool}, +hx10: {C.fits(8n, x10) == True{} : Bool}, +hx11: {C.fits(8n, x11) == True{} : Bool}, +hx12: {C.fits(8n, x12) == True{} : Bool}, +hx13: {C.fits(8n, x13) == True{} : Bool}, +hx14: {C.fits(8n, x14) == True{} : Bool}, +hx15: {C.fits(8n, x15) == True{} : Bool}, +hpb: {C.fits(1n, pb) == True{} : Bool}) -> {lim(26n, L.load(x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, pb)) == True{} : Bool}:
  +c0 = Nat.add(x2, Nat.mul(Nat.mod(x3, 4n), 256n))
  +p0 = f256(2n, x2, Nat.mod(x3, 4n), hx2, K.fm4(x3))
  +c1 = Nat.add(x1, Nat.mul(c0, 256n))
  +p1 = f256(10n, x1, c0, hx1, p0)
  +p2 = f256(18n, x0, c1, hx0, p1)
  +c3 = Nat.add(x5, Nat.mul(Nat.mod(x6, 16n), 256n))
  +p3 = f256(4n, x5, Nat.mod(x6, 16n), hx5, K.fm16(x6))
  +c4 = Nat.add(x4, Nat.mul(c3, 256n))
  +p4 = f256(12n, x4, c3, hx4, p3)
  +p5 = f64(20n, Nat.div(x3, 4n), c4, K.fd4(6n, x3, hx3), p4)
  +c6 = Nat.add(x8, Nat.mul(Nat.mod(x9, 64n), 256n))
  +p6 = f256(6n, x8, Nat.mod(x9, 64n), hx8, K.fm64(x9))
  +c7 = Nat.add(x7, Nat.mul(c6, 256n))
  +p7 = f256(14n, x7, c6, hx7, p6)
  +p8 = f16(22n, Nat.div(x6, 16n), c7, K.fd16(4n, x6, hx6), p7)
  +c9 = Nat.add(x11, Nat.mul(x12, 256n))
  +p9 = f256(8n, x11, x12, hx11, hx12)
  +c10 = Nat.add(x10, Nat.mul(c9, 256n))
  +p10 = f256(16n, x10, c9, hx10, p9)
  +p11 = f4(24n, Nat.div(x9, 64n), c10, K.fd64(2n, x9, hx9), p10)
  +c12 = Nat.add(x15, Nat.mul(pb, 256n))
  +p12 = f256(1n, x15, pb, hx15, hpb)
  +c13 = Nat.add(x14, Nat.mul(c12, 256n))
  +p13 = f256(9n, x14, c12, hx14, p12)
  +p14 = fm(25n, 26n, Nat.add(x13, Nat.mul(c13, 256n)), {==}, f256(17n, x13, c13, hx13, p13))
  mk(26n, Nat.add(x0, Nat.mul(c1, 256n)), Nat.add(Nat.div(x3, 4n), Nat.mul(c4, 64n)), Nat.add(Nat.div(x6, 16n), Nat.mul(c7, 16n)), Nat.add(Nat.div(x9, 64n), Nat.mul(c10, 4n)), Nat.add(x13, Nat.mul(c13, 256n)), p2, p5, p8, p11, p14)

# a byte has 8 bits
def byte_fit(+x: U32) -> {C.fits(8n, L.byte(x)) == True{} : Bool}:
  A.fits_subst(8n, C.low(8n, U32.to_nat(x)), L.byte(x), Equal.sym(Nat, L.byte(x), C.low(8n, U32.to_nat(x)), FB.andm(x, 8n, 255, {==})), WW.low_fits(8n, U32.to_nat(x)))
