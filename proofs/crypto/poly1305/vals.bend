# ---- limbs to bytes ----

def high8(+a: Nat) -> {C.high(8n, a) == L.d8(a) : Nat}:
  WW.high_div(8n, a, 255n, {==})

def low8(+a: Nat) -> {C.low(8n, a) == Nat.mod(a, 256n) : Nat}:
  +lo = C.low(8n, a)
  +dv = Nat.div(a, 256n)
  +e1 = Equal.trans(Nat, Nat.add(lo, C.shift(8n, dv)), a, Nat.add(Nat.mod(a, 256n), C.shift(8n, dv)),
    Equal.trans(Nat, Nat.add(lo, C.shift(8n, dv)), Nat.add(lo, C.shift(8n, C.high(8n, a))), a,
      Equal.cong(Nat, Nat, t => Nat.add(lo, C.shift(8n, t)), dv, C.high(8n, a), Equal.sym(Nat, C.high(8n, a), dv, high8(a))),
      Equal.sym(Nat, a, Nat.add(lo, C.shift(8n, C.high(8n, a))), WW.low_high(8n, a))),
    K.d256(a))
  +e2 = Equal.trans(Nat, Nat.add(C.shift(8n, dv), lo), Nat.add(lo, C.shift(8n, dv)), Nat.add(C.shift(8n, dv), Nat.mod(a, 256n)), NA.add_comm(C.shift(8n, dv), lo),
    Equal.trans(Nat, Nat.add(lo, C.shift(8n, dv)), Nat.add(Nat.mod(a, 256n), C.shift(8n, dv)), Nat.add(C.shift(8n, dv), Nat.mod(a, 256n)), e1, NA.add_comm(Nat.mod(a, 256n), C.shift(8n, dv))))
  NR.add_cancel(C.shift(8n, dv), lo, Nat.mod(a, 256n), e2)

# one byte off a + 2^8 t
def lb(+m: Nat, +a: Nat, +t: Nat) -> {R.le_bytes(1n+m, Nat.add(a, C.shift(8n, t))) == L.by(a) <> R.le_bytes(m, Nat.add(L.d8(a), t)) : List<&2, U32>}:
  +x = Nat.add(a, C.shift(8n, t))
  %Equal.sym(Nat, C.low(8n, x), Nat.mod(a, 256n), Equal.trans(Nat, C.low(8n, x), C.low(8n, a), Nat.mod(a, 256n), WW.low_add_shift(8n, a, t), low8(a))) : {U32.from_nat(_) <> R.le_bytes(m, C.high(8n, x)) == L.by(a) <> R.le_bytes(m, Nat.add(L.d8(a), t)) : List<&2, U32>}
  %Equal.sym(Nat, C.high(8n, x), Nat.add(L.d8(a), t), Equal.trans(Nat, C.high(8n, x), Nat.add(C.high(8n, a), t), Nat.add(L.d8(a), t), WW.high_add_shift(8n, a, t), Equal.cong(Nat, Nat, z => Nat.add(z, t), C.high(8n, a), L.d8(a), high8(a)))) : {U32.from_nat(Nat.mod(a, 256n)) <> R.le_bytes(m, _) == L.by(a) <> R.le_bytes(m, Nat.add(L.d8(a), t)) : List<&2, U32>}
  {==}

def lb0(+m: Nat, +a: Nat) -> {R.le_bytes(1n+m, a) == L.by(a) <> R.le_bytes(m, L.d8(a)) : List<&2, U32>}:
  %Equal.sym(Nat, C.low(8n, a), Nat.mod(a, 256n), low8(a)) : {U32.from_nat(_) <> R.le_bytes(m, C.high(8n, a)) == L.by(a) <> R.le_bytes(m, L.d8(a)) : List<&2, U32>}
  %Equal.sym(Nat, C.high(8n, a), L.d8(a), high8(a)) : {U32.from_nat(Nat.mod(a, 256n)) <> R.le_bytes(m, _) == L.by(a) <> R.le_bytes(m, L.d8(a)) : List<&2, U32>}
  {==}

def e3(+c: Nat, +l1: Nat, +y: Nat) -> {Nat.add(c, C.shift(2n, Nat.add(l1, C.shift(26n, y)))) == Nat.add(Nat.add(c, Nat.mul(l1, 4n)), C.shift(8n, C.shift(20n, y))) : Nat}:
  %Equal.sym(Nat, C.shift(2n, Nat.add(l1, C.shift(26n, y))), Nat.add(C.shift(2n, l1), C.shift(2n, C.shift(26n, y))), WW.shift_add(2n, l1, C.shift(26n, y))) : {Nat.add(c, _) == Nat.add(Nat.add(c, Nat.mul(l1, 4n)), C.shift(8n, C.shift(20n, y))) : Nat}
  %Equal.sym(Nat, C.shift(2n, C.shift(26n, y)), C.shift(28n, y), SR.shift_shift(2n, 26n, y)) : {Nat.add(c, Nat.add(C.shift(2n, l1), _)) == Nat.add(Nat.add(c, Nat.mul(l1, 4n)), C.shift(8n, C.shift(20n, y))) : Nat}
  %Equal.sym(Nat, Nat.mul(l1, 4n), C.shift(2n, l1), Equal.sym(Nat, C.shift(2n, l1), Nat.mul(l1, C.shift(2n, 1n)), WW.shift_mul(2n, l1))) : {Nat.add(c, Nat.add(C.shift(2n, l1), C.shift(28n, y))) == Nat.add(Nat.add(c, _), C.shift(8n, C.shift(20n, y))) : Nat}
  %Equal.sym(Nat, C.shift(8n, C.shift(20n, y)), C.shift(28n, y), SR.shift_shift(8n, 20n, y)) : {Nat.add(c, Nat.add(C.shift(2n, l1), C.shift(28n, y))) == Nat.add(Nat.add(c, C.shift(2n, l1)), _) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.add(c, C.shift(2n, l1)), C.shift(28n, y)), Nat.add(c, Nat.add(C.shift(2n, l1), C.shift(28n, y))), NA.add_assoc(c, C.shift(2n, l1), C.shift(28n, y))) : {Nat.add(c, Nat.add(C.shift(2n, l1), C.shift(28n, y))) == _ : Nat}
  {==}

def e6(+c: Nat, +l2: Nat, +y: Nat) -> {Nat.add(c, C.shift(4n, Nat.add(l2, C.shift(26n, y)))) == Nat.add(Nat.add(c, Nat.mul(l2, 16n)), C.shift(8n, C.shift(22n, y))) : Nat}:
  %Equal.sym(Nat, C.shift(4n, Nat.add(l2, C.shift(26n, y))), Nat.add(C.shift(4n, l2), C.shift(4n, C.shift(26n, y))), WW.shift_add(4n, l2, C.shift(26n, y))) : {Nat.add(c, _) == Nat.add(Nat.add(c, Nat.mul(l2, 16n)), C.shift(8n, C.shift(22n, y))) : Nat}
  %Equal.sym(Nat, C.shift(4n, C.shift(26n, y)), C.shift(30n, y), SR.shift_shift(4n, 26n, y)) : {Nat.add(c, Nat.add(C.shift(4n, l2), _)) == Nat.add(Nat.add(c, Nat.mul(l2, 16n)), C.shift(8n, C.shift(22n, y))) : Nat}
  %Equal.sym(Nat, Nat.mul(l2, 16n), C.shift(4n, l2), Equal.sym(Nat, C.shift(4n, l2), Nat.mul(l2, C.shift(4n, 1n)), WW.shift_mul(4n, l2))) : {Nat.add(c, Nat.add(C.shift(4n, l2), C.shift(30n, y))) == Nat.add(Nat.add(c, _), C.shift(8n, C.shift(22n, y))) : Nat}
  %Equal.sym(Nat, C.shift(8n, C.shift(22n, y)), C.shift(30n, y), SR.shift_shift(8n, 22n, y)) : {Nat.add(c, Nat.add(C.shift(4n, l2), C.shift(30n, y))) == Nat.add(Nat.add(c, C.shift(4n, l2)), _) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.add(c, C.shift(4n, l2)), C.shift(30n, y)), Nat.add(c, Nat.add(C.shift(4n, l2), C.shift(30n, y))), NA.add_assoc(c, C.shift(4n, l2), C.shift(30n, y))) : {Nat.add(c, Nat.add(C.shift(4n, l2), C.shift(30n, y))) == _ : Nat}
  {==}

def e9(+c: Nat, +l3: Nat, +y: Nat) -> {Nat.add(c, C.shift(6n, Nat.add(l3, C.shift(26n, y)))) == Nat.add(Nat.add(c, Nat.mul(l3, 64n)), C.shift(8n, C.shift(24n, y))) : Nat}:
  %Equal.sym(Nat, C.shift(6n, Nat.add(l3, C.shift(26n, y))), Nat.add(C.shift(6n, l3), C.shift(6n, C.shift(26n, y))), WW.shift_add(6n, l3, C.shift(26n, y))) : {Nat.add(c, _) == Nat.add(Nat.add(c, Nat.mul(l3, 64n)), C.shift(8n, C.shift(24n, y))) : Nat}
  %Equal.sym(Nat, C.shift(6n, C.shift(26n, y)), C.shift(32n, y), SR.shift_shift(6n, 26n, y)) : {Nat.add(c, Nat.add(C.shift(6n, l3), _)) == Nat.add(Nat.add(c, Nat.mul(l3, 64n)), C.shift(8n, C.shift(24n, y))) : Nat}
  %Equal.sym(Nat, Nat.mul(l3, 64n), C.shift(6n, l3), Equal.sym(Nat, C.shift(6n, l3), Nat.mul(l3, C.shift(6n, 1n)), WW.shift_mul(6n, l3))) : {Nat.add(c, Nat.add(C.shift(6n, l3), C.shift(32n, y))) == Nat.add(Nat.add(c, _), C.shift(8n, C.shift(24n, y))) : Nat}
  %Equal.sym(Nat, C.shift(8n, C.shift(24n, y)), C.shift(32n, y), SR.shift_shift(8n, 24n, y)) : {Nat.add(c, Nat.add(C.shift(6n, l3), C.shift(32n, y))) == Nat.add(Nat.add(c, C.shift(6n, l3)), _) : Nat}
  %Equal.sym(Nat, Nat.add(Nat.add(c, C.shift(6n, l3)), C.shift(32n, y)), Nat.add(c, Nat.add(C.shift(6n, l3), C.shift(32n, y))), NA.add_assoc(c, C.shift(6n, l3), C.shift(32n, y))) : {Nat.add(c, Nat.add(C.shift(6n, l3), C.shift(32n, y))) == _ : Nat}
  {==}

# The streamed bytes are the 16 low bytes of the limbs' value.
def bytes_val(+l0: Nat, +l1: Nat, +l2: Nat, +l3: Nat, +l4: Nat) -> {L.bytes(l0, l1, l2, l3, l4) == R.le_bytes(16n, ev(l0, l1, l2, l3, l4)) : List<&2, U32>}:
  %Equal.sym(List<&2, U32>, R.le_bytes(16n, Nat.add(l0, C.shift(8n, C.shift(18n, Nat.add(l1, C.shift(26n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4)))))))))), L.by(l0) <> R.le_bytes(15n, Nat.add(L.d8(l0), C.shift(18n, Nat.add(l1, C.shift(26n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4))))))))), lb(15n, l0, C.shift(18n, Nat.add(l1, C.shift(26n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4))))))))) : {L.bytes(l0, l1, l2, l3, l4) == _ : List<&2, U32>}
  %Equal.sym(List<&2, U32>, R.le_bytes(15n, Nat.add(L.d8(l0), C.shift(8n, C.shift(10n, Nat.add(l1, C.shift(26n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4)))))))))), L.by(L.d8(l0)) <> R.le_bytes(14n, Nat.add(L.d8(L.d8(l0)), C.shift(10n, Nat.add(l1, C.shift(26n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4))))))))), lb(14n, L.d8(l0), C.shift(10n, Nat.add(l1, C.shift(26n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4))))))))) : {L.bytes(l0, l1, l2, l3, l4) == L.by(l0) <> _ : List<&2, U32>}
  %Equal.sym(List<&2, U32>, R.le_bytes(14n, Nat.add(L.d8(L.d8(l0)), C.shift(8n, C.shift(2n, Nat.add(l1, C.shift(26n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4)))))))))), L.by(L.d8(L.d8(l0))) <> R.le_bytes(13n, Nat.add(L.d8(L.d8(L.d8(l0))), C.shift(2n, Nat.add(l1, C.shift(26n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4))))))))), lb(13n, L.d8(L.d8(l0)), C.shift(2n, Nat.add(l1, C.shift(26n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4))))))))) : {L.bytes(l0, l1, l2, l3, l4) == L.by(l0) <> L.by(L.d8(l0)) <> _ : List<&2, U32>}
  %Equal.cong(Nat, List<&2, U32>, z => R.le_bytes(13n, z), Nat.add(Nat.add(L.d8(L.d8(L.d8(l0))), Nat.mul(l1, 4n)), C.shift(8n, C.shift(20n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4))))))), Nat.add(L.d8(L.d8(L.d8(l0))), C.shift(2n, Nat.add(l1, C.shift(26n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4)))))))), Equal.sym(Nat, Nat.add(L.d8(L.d8(L.d8(l0))), C.shift(2n, Nat.add(l1, C.shift(26n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4)))))))), Nat.add(Nat.add(L.d8(L.d8(L.d8(l0))), Nat.mul(l1, 4n)), C.shift(8n, C.shift(20n, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4))))))), e3(L.d8(L.d8(L.d8(l0))), l1, Nat.add(l2, C.shift(26n, Nat.add(l3, C.shift(26n, l4))))))) : {L.bytes(l0, l1, l2, l3, l4) == L.by(l0) <> L.by(L.d8(l0)) <> L.by(L.d8(L.d8(l0))) <> _ : List<&2, U32>}
