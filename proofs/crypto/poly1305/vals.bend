def fix_val_r(+one: Nat, +h1: {one == 1n : Nat}, t: L.F) -> {val(L.fix(t)) == val(t) : Nat}:
  match t:
    case L.F{+u0, +t1, +t2, +t3, +t4}: fix_val(one, h1, u0, t1, t2, t3, t4)

def carry_val_r(+one: Nat, +h1: {one == 1n : Nat}, +bp: Nat, +h5: {Nat.add(1n+bp, 5n) == C.shift(130n, one) : Nat}, z: L.F) -> {Nat.mod(val(L.carry(z)), 1n+bp) == Nat.mod(val(z), 1n+bp) : Nat}:
  match z:
    case L.F{+z0, +z1, +z2, +z3, +z4}:
      +tz = L.top(L.F{z0, z1, z2, z3, z4})
      K.cg_tr(bp, val(L.fix(tz)), val(tz), ev(z0, z1, z2, z3, z4), K.cg_eq(bp, val(L.fix(tz)), val(tz), fix_val_r(one, h1, tz)), top_val(one, h1, bp, h5, z0, z1, z2, z3, z4))

# ---- the multiplier in 13-bit halves ----

def key_val(+one: Nat, +h1: {one == 1n : Nat}, +r0: Nat, +r1: Nat, +r2: Nat, +r3: Nat, +r4: Nat) -> {ev(r0, r1, r2, r3, r4) == Nat.add(ev(Nat.mod(r0, 8192n), Nat.mod(r1, 8192n), Nat.mod(r2, 8192n), Nat.mod(r3, 8192n), Nat.mod(r4, 8192n)), C.shift(13n, ev(Nat.div(r0, 8192n), Nat.div(r1, 8192n), Nat.div(r2, 8192n), Nat.div(r3, 8192n), Nat.div(r4, 8192n)))) : Nat}:
  Equal.trans(Nat, ev(r0, r1, r2, r3, r4), ev(Nat.add(Nat.mod(r0, 8192n), C.shift(13n, Nat.div(r0, 8192n))), Nat.add(Nat.mod(r1, 8192n), C.shift(13n, Nat.div(r1, 8192n))), Nat.add(Nat.mod(r2, 8192n), C.shift(13n, Nat.div(r2, 8192n))), Nat.add(Nat.mod(r3, 8192n), C.shift(13n, Nat.div(r3, 8192n))), Nat.add(Nat.mod(r4, 8192n), C.shift(13n, Nat.div(r4, 8192n)))), Nat.add(ev(Nat.mod(r0, 8192n), Nat.mod(r1, 8192n), Nat.mod(r2, 8192n), Nat.mod(r3, 8192n), Nat.mod(r4, 8192n)), C.shift(13n, ev(Nat.div(r0, 8192n), Nat.div(r1, 8192n), Nat.div(r2, 8192n), Nat.div(r3, 8192n), Nat.div(r4, 8192n)))),
    ev_cong(r0, r1, r2, r3, r4, Nat.add(Nat.mod(r0, 8192n), C.shift(13n, Nat.div(r0, 8192n))), Nat.add(Nat.mod(r1, 8192n), C.shift(13n, Nat.div(r1, 8192n))), Nat.add(Nat.mod(r2, 8192n), C.shift(13n, Nat.div(r2, 8192n))), Nat.add(Nat.mod(r3, 8192n), C.shift(13n, Nat.div(r3, 8192n))), Nat.add(Nat.mod(r4, 8192n), C.shift(13n, Nat.div(r4, 8192n))), K.sb(r0), K.sb(r1), K.sb(r2), K.sb(r3), K.sb(r4)),
    ev_split13(Nat.mod(r0, 8192n), Nat.mod(r1, 8192n), Nat.mod(r2, 8192n), Nat.mod(r3, 8192n), Nat.mod(r4, 8192n), Nat.div(r0, 8192n), Nat.div(r1, 8192n), Nat.div(r2, 8192n), Nat.div(r3, 8192n), Nat.div(r4, 8192n)))

def split13(+x: Nat, +e: Nat, +f: Nat) -> {Nat.add(Nat.mul(x, e), C.shift(13n, Nat.mul(x, f))) == Nat.mul(x, Nat.add(e, C.shift(13n, f))) : Nat}:
  %Equal.sym(Nat, Nat.mul(x, e), Nat.mul(e, x), NA.mul_comm(x, e)) : {Nat.add(_, C.shift(13n, Nat.mul(x, f))) == Nat.mul(x, Nat.add(e, C.shift(13n, f))) : Nat}
  %Equal.sym(Nat, Nat.mul(x, f), Nat.mul(f, x), NA.mul_comm(x, f)) : {Nat.add(Nat.mul(e, x), C.shift(13n, _)) == Nat.mul(x, Nat.add(e, C.shift(13n, f))) : Nat}
  %Equal.sym(Nat, Nat.mul(x, Nat.add(e, C.shift(13n, f))), Nat.add(Nat.mul(x, e), Nat.mul(x, C.shift(13n, f))), NA.mul_add_left(x, e, C.shift(13n, f))) : {Nat.add(Nat.mul(e, x), C.shift(13n, Nat.mul(f, x))) == _ : Nat}
  %Equal.sym(Nat, Nat.mul(x, e), Nat.mul(e, x), NA.mul_comm(x, e)) : {Nat.add(Nat.mul(e, x), C.shift(13n, Nat.mul(f, x))) == Nat.add(_, Nat.mul(x, C.shift(13n, f))) : Nat}
  %Equal.sym(Nat, Nat.mul(x, C.shift(13n, f)), C.shift(13n, Nat.mul(x, f)), WW.shift_mul_r(13n, x, f)) : {Nat.add(Nat.mul(e, x), C.shift(13n, Nat.mul(f, x))) == Nat.add(Nat.mul(e, x), _) : Nat}
  %Equal.sym(Nat, Nat.mul(x, f), Nat.mul(f, x), NA.mul_comm(x, f)) : {Nat.add(Nat.mul(e, x), C.shift(13n, Nat.mul(f, x))) == Nat.add(Nat.mul(e, x), C.shift(13n, _)) : Nat}
  {==}

# One block: (h + m) r mod p, for the multiplier of the limbs of r.
def block_val(+one: Nat, +h1: {one == 1n : Nat}, +bp: Nat, +h5: {Nat.add(1n+bp, 5n) == C.shift(130n, one) : Nat}, +r0: Nat, +r1: Nat, +r2: Nat, +r3: Nat, +r4: Nat, h: L.F, m: L.F) -> {Nat.mod(val(L.block(L.key(L.F{r0, r1, r2, r3, r4}), h, m)), 1n+bp) == Nat.mod(Nat.mul(Nat.add(val(h), val(m)), ev(r0, r1, r2, r3, r4)), 1n+bp) : Nat}:
  match h m:
    case L.F{+hh0, +hh1, +hh2, +hh3, +hh4} L.F{+mm0, +mm1, +mm2, +mm3, +mm4}:
