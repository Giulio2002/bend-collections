  +y9 = P.tl(y8)
  +y10 = P.tl(y9)
  +y11 = P.tl(y10)
  +y12 = P.tl(y11)
  +y13 = P.tl(y12)
  +y14 = P.tl(y13)
  +y15 = P.tl(y14)
  O.ok_load(P.hd(ys), P.hd(y1), P.hd(y2), P.hd(y3), P.hd(y4), P.hd(y5), P.hd(y6), P.hd(y7), P.hd(y8), P.hd(y9), P.hd(y10), P.hd(y11), P.hd(y12), P.hd(y13), P.hd(y14), P.hd(y15), P.hd(P.tl(y15)))

