# mac(key, msg)
def ok_mac(+key: List<&2, U32>, +msg: List<&2, U32>) -> Bool:
  match msg:
    case Nil{}: ok_mac_w(1n, key, [])
    case x <> rest: ok_mac_w(1n, key, x <> rest)

# poly1305(key, msg): the tag for a 32-byte key
def ok_poly1305_w(+pone: Nat, +key: List<&2, U32>, +msg: List<&2, U32>) -> Bool:
  match key:
    case k0 <> k1 <> k2 <> k3 <> k4 <> k5 <> k6 <> k7 <> k8 <> k9 <> k10 <> k11 <> k12 <> k13 <> k14 <> k15 <> k16 <> k17 <> k18 <> k19 <> k20 <> k21 <> k22 <> k23 <> k24 <> k25 <> k26 <> k27 <> k28 <> k29 <> k30 <> k31 <> Nil{}:
      ok_tag(pone, k0, k1, k2, k3, k4, k5, k6, k7, k8, k9, k10, k11, k12, k13, k14, k15, k16, k17, k18, k19, k20, k21, k22, k23, k24, k25, k26, k27, k28, k29, k30, k31, msg)
