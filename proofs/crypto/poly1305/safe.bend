  +c1 = Bool.and(O.ok_load(L.byte(k16), L.byte(k17), L.byte(k18), L.byte(k19), L.byte(k20), L.byte(k21), L.byte(k22), L.byte(k23), L.byte(k24), L.byte(k25), L.byte(k26), L.byte(k27), L.byte(k28), L.byte(k29), L.byte(k30), L.byte(k31), 0n), c2)
  +c0 = Bool.and(O.ok_load(L.byte(U32.and(k0, 255)), L.byte(U32.and(k1, 255)), L.byte(U32.and(k2, 255)), L.byte(U32.and(k3, 15)), L.byte(U32.and(k4, 252)), L.byte(U32.and(k5, 255)), L.byte(U32.and(k6, 255)), L.byte(U32.and(k7, 15)), L.byte(U32.and(k8, 252)), L.byte(U32.and(k9, 255)), L.byte(U32.and(k10, 255)), L.byte(U32.and(k11, 15)), L.byte(U32.and(k12, 252)), L.byte(U32.and(k13, 255)), L.byte(U32.and(k14, 255)), L.byte(U32.and(k15, 15)), 0n), c1)
  +q4 = qc
  +q3 = LG.and_intro(SL.ok_pad(pone, aad, kk, L.zero(), 0n), c4, qa, q4)
  +q2 = LG.and_intro(O.ok_key(P.r_of(k0, k1, k2, k3, k4, k5, k6, k7, k8, k9, k10, k11, k12, k13, k14, k15)), c3, qk, q3)
  +q1 = LG.and_intro(O.ok_load(L.byte(k16), L.byte(k17), L.byte(k18), L.byte(k19), L.byte(k20), L.byte(k21), L.byte(k22), L.byte(k23), L.byte(k24), L.byte(k25), L.byte(k26), L.byte(k27), L.byte(k28), L.byte(k29), L.byte(k30), L.byte(k31), 0n), c2, qs, q2)
  +q0 = LG.and_intro(O.ok_load(L.byte(U32.and(k0, 255)), L.byte(U32.and(k1, 255)), L.byte(U32.and(k2, 255)), L.byte(U32.and(k3, 15)), L.byte(U32.and(k4, 252)), L.byte(U32.and(k5, 255)), L.byte(U32.and(k6, 255)), L.byte(U32.and(k7, 15)), L.byte(U32.and(k8, 252)), L.byte(U32.and(k9, 255)), L.byte(U32.and(k10, 255)), L.byte(U32.and(k11, 15)), L.byte(U32.and(k12, 252)), L.byte(U32.and(k13, 255)), L.byte(U32.and(k14, 255)), L.byte(U32.and(k15, 15)), 0n), c1, ql, q1)
  q0

def ok_tag2_list(+pone: Nat, +key: List<&2, U32>, +aad: List<&2, U32>, +ct: List<&2, U32>) -> Bool:
  match key:
    case k0 <> k1 <> k2 <> k3 <> k4 <> k5 <> k6 <> k7 <> k8 <> k9 <> k10 <> k11 <> k12 <> k13 <> k14 <> k15 <> k16 <> k17 <> k18 <> k19 <> k20 <> k21 <> k22 <> k23 <> k24 <> k25 <> k26 <> k27 <> k28 <> k29 <> k30 <> k31 <> rest:
      ok_tag2(pone, k0, k1, k2, k3, k4, k5, k6, k7, k8, k9, k10, k11, k12, k13, k14, k15, k16, k17, k18, k19, k20, k21, k22, k23, k24, k25, k26, k27, k28, k29, k30, k31, aad, ct)
    case _:
      True{}

def ok_mac_aead_w(+pone: Nat, +key: List<&2, U32>, +aad: List<&2, U32>, +ct: List<&2, U32>) -> Bool:
  ok_tag2_list(pone, P.pad(32n, key), aad, ct)

