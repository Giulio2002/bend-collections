# absorb_gen (the RFC loop, run on a last short block)
def ok_gen(+fuel: Nat, +msg: List<&2, U32>, +k: L.K, +h: L.F) -> Bool:
  match fuel msg:
    case 0n _: True{}
    case 1n+f Nil{}: True{}
    case 1n+f +x <> +rest:
