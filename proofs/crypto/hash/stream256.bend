    case b0 <> b1 <> Nil{} 2n+j:
      %lz0_correct(j, sfx) : {N.lzp(b0 <> b1 <> Nil{}, 2n+j, sfx) == C.pack(b0, b1, 0, 0) <> _ : List<&2, U32>}
