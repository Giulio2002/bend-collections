law state256:
  for +cs: List<&2, List<&2, U32>>
  for +st: N256.St
  {H.fold(cs, H.Sha256H{st}) == H.Sha256H{P256.fold_st(cs, 48n, st)} : H.Hasher}

def state256(cs, st):
  match cs:
    case Nil{}:
      {==}
    case c <> ct:
      state256(ct, N256.update(st, c, 48n))

