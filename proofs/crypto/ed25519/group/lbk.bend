# [L]B = O for the base point of edwards25519, by checked computation: the
# checker. A chain of affine additions on literal points (binary numbers,
# bn.bend) is a list of operations, each carrying its result (x3, y3) and
# its quotients; `chk` verifies, by closed computation on the literals, for
# each addition (x1, y1) + (x2, y2) = (x3, y3):
#
#     d ((x1 x2) (y1 y2)) == kt p + t                 (t: the remainder)
#     jx p + (1 + t) x3 == kx p + (x1 y2 + y1 x2)     (x3 == nx / dx modulo p)
#     ky p + y3 == (y1 y2 + x1 x2) + t y3             (y3 == ny / dy modulo p)
#
# No proof here and nothing about the curve: lbt.bend proves that a chain
# accepted by `chk` computes scalar multiples of B (soundness), and the
# segments lb_NN.bend only evaluate `chk` (Reach), so they stay independent
# of the group law's proofs.

def bdec(a: B.Bn) -> B.Bn:
  match a:
    case B.BZ{}:
      B.BZ{}
    case B.B0{t}:
      B.B1{bdec(t)}
    case B.B1{t}:
      B.B0{t}

# a - b for a >= b (only proposes the remainder: chk verifies it)
def bsubu(a: B.Bn, b: B.Bn) -> B.Bn:
  match a b:
    case B.BZ{} y:
      B.BZ{}
    case B.B0{x} B.BZ{}:
      B.B0{x}
    case B.B1{x} B.BZ{}:
      B.B1{x}
    case B.B0{x} B.B0{y}:
      B.B0{bsubu(x, y)}
    case B.B1{x} B.B1{y}:
      B.B0{bsubu(x, y)}
    case B.B1{x} B.B0{y}:
      B.B1{bsubu(x, y)}
    case B.B0{x} B.B1{y}:
      B.B1{bdec(bsubu(x, y))}

# leading zeros removed
def bnz(t: B.Bn) -> B.Bn:
  match t:
    case B.BZ{}:
      B.BZ{}
    case B.B0{u}:
      B.B0{B.B0{u}}
    case B.B1{u}:
      B.B0{B.B1{u}}

def bnorm(a: B.Bn) -> B.Bn:
  match a:
    case B.BZ{}:
      B.BZ{}
    case B.B0{t}:
      bnz(bnorm(t))
    case B.B1{t}:
      B.B1{bnorm(t)}

# d ((x1 x2) (y1 y2))
def tT(+x1: B.Bn, +y1: B.Bn, +x2: B.Bn, +y2: B.Bn) -> B.Bn:
  B.bmul(PL.dl(), B.bmul(B.bmul(x1, x2), B.bmul(y1, y2)))

def c1(+tt: B.Bn, +kt: B.Bn, +t: B.Bn) -> Bool:
  B.beq(tt, B.badd(B.bmul(kt, PL.pl()), t))

def c2(+x1: B.Bn, +y1: B.Bn, +x2: B.Bn, +y2: B.Bn, +x3: B.Bn, +jx: B.Bn, +kx: B.Bn, +t: B.Bn) -> Bool:
  B.beq(B.badd(B.bmul(jx, PL.pl()), B.bmul(B.binc(t), x3)), B.badd(B.bmul(kx, PL.pl()), B.badd(B.bmul(x1, y2), B.bmul(y1, x2))))

def c3(+x1: B.Bn, +y1: B.Bn, +x2: B.Bn, +y2: B.Bn, +y3: B.Bn, +ky: B.Bn, +t: B.Bn) -> Bool:
  B.beq(B.badd(B.bmul(ky, PL.pl()), y3), B.badd(B.badd(B.bmul(y1, y2), B.bmul(x1, x2)), B.bmul(t, y3)))

def stepc(+x1: B.Bn, +y1: B.Bn, +x2: B.Bn, +y2: B.Bn, +x3: B.Bn, +y3: B.Bn, +kt: B.Bn, +jx: B.Bn, +kx: B.Bn, +ky: B.Bn, +tt: B.Bn, +t: B.Bn) -> Bool:
  Bool.and(c1(tt, kt, t), Bool.and(c2(x1, y1, x2, y2, x3, jx, kx, t), c3(x1, y1, x2, y2, y3, ky, t)))

# the remainder t of tt by p, given the quotient
def tof(+tt: B.Bn, +kt: B.Bn) -> B.Bn:
  bnorm(bsubu(tt, B.bmul(kt, PL.pl())))

def stept(+x1: B.Bn, +y1: B.Bn, +x2: B.Bn, +y2: B.Bn, +x3: B.Bn, +y3: B.Bn, +kt: B.Bn, +jx: B.Bn, +kx: B.Bn, +ky: B.Bn, +tt: B.Bn) -> Bool:
  stepc(x1, y1, x2, y2, x3, y3, kt, jx, kx, ky, tt, tof(tt, kt))

# (x1, y1) + (x2, y2) == (x3, y3) modulo p, with the quotients kt, jx, kx, ky
def step(+x1: B.Bn, +y1: B.Bn, +x2: B.Bn, +y2: B.Bn, +x3: B.Bn, +y3: B.Bn, +kt: B.Bn, +jx: B.Bn, +kx: B.Bn, +ky: B.Bn) -> Bool:
  stept(x1, y1, x2, y2, x3, y3, kt, jx, kx, ky, tT(x1, y1, x2, y2))

# D: [n]B -> [n + n]B (doubling); A: [n]B -> [1 + n]B (B + [n]B)
type Op is Data:
  D{x: B.Bn, y: B.Bn, kt: B.Bn, jx: B.Bn, kx: B.Bn, ky: B.Bn}
  A{x: B.Bn, y: B.Bn, kt: B.Bn, jx: B.Bn, kx: B.Bn, ky: B.Bn}

# from [n]B == (x, y), the operations lead to [n2]B == (x2, y2)
def chk(ops: List<&2, Op>, +n: B.Bn, +x: B.Bn, +y: B.Bn, +n2: B.Bn, +x2: B.Bn, +y2: B.Bn) -> Bool:
  match ops:
    case Nil{}:
      Bool.and(B.beq(n, n2), Bool.and(B.beq(x, x2), B.beq(y, y2)))
    case o <> r:
      match o:
        case D{+x3, +y3, +kt, +jx, +kx, +ky}:
          Bool.and(step(x, y, x, y, x3, y3, kt, jx, kx, ky), chk(r, B.badd(n, n), x3, y3, n2, x2, y2))
        case A{+x3, +y3, +kt, +jx, +kx, +ky}:
          Bool.and(step(PL.bxl(), PL.byl(), x, y, x3, y3, kt, jx, kx, ky), chk(r, B.binc(n), x3, y3, n2, x2, y2))

# a checked chain from (n, x, y) to (n2, x2, y2)
def Reach(+n: B.Bn, +x: B.Bn, +y: B.Bn, +n2: B.Bn, +x2: B.Bn, +y2: B.Bn) -> Data:
  Sigma<&2, &2, List<&2, Op>, o => {chk(o, n, x, y, n2, x2, y2) == True{} : Bool}>
