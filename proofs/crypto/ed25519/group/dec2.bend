# ---- the power ----

def pw5(+mp: Nat, +m: Nat, +hk: {Nat.div(mp, 2n) == Nat.add(Nat.add(1n, Nat.add(m, m)), Nat.add(1n, Nat.add(m, m))) : Nat}, +a: Nat) -> {Nat.mul(Nat.pow(a, Nat.add(1n, Nat.add(m, m))), Nat.pow(a, Nat.add(1n, Nat.add(m, m)))) == Nat.pow(a, Nat.div(mp, 2n)) : Nat}:
