# Point decoding recovers x (RFC 8032 section 5.1.3): for a point (x, y) of
# the curve, the decoder run on y and the parity of x returns
# (x : y : 1 : x y). p = 8 m + 5: with u = y^2 - 1, v = d y^2 + 1 the
# candidate xc = (u v^3) (u v^7)^m has v xc^2 = u (u v^7)^(2 m + 1), and
# u v^7 = (x v^4)^2, so v xc^2 = u W with W = (x v^4)^((p - 1) / 2) = +-1
# (Fermat): xc or xc sqrt(-1) is a root of v r^2 = u = v x^2, hence +-x, and
# the parity picks x.

# ---- small facts ----

def sq_zero_c(+mp: Nat, +hp: PM.Prime(1n+mp), +r: Nat, +h: {Nat.mod(Nat.mul(r, r), 1n+mp) == 0n : Nat}, c: Bool, +hc: {Nat.is_eq(Nat.mod(r, 1n+mp), 0n) == c : Bool}) -> {Nat.mod(r, 1n+mp) == 0n : Nat}:
  match c:
    case True{}:
      N.eq_from_is_eq(Nat.mod(r, 1n+mp), 0n, hc)
    case False{}:
      F.zprod(mp, hp, r, r, h, hc)

def sq_zero(+mp: Nat, +hp: PM.Prime(1n+mp), +r: Nat, +h: {Nat.mod(Nat.mul(r, r), 1n+mp) == 0n : Nat}) -> {Nat.mod(r, 1n+mp) == 0n : Nat}:
  sq_zero_c(mp, hp, r, h, Nat.is_eq(Nat.mod(r, 1n+mp), 0n), {==})

def mod2_le(+a: Nat) -> {Nat.is_le(Nat.mod(a, 2n), 1n) == True{} : Bool}:
  N.lt_succ_le(Nat.mod(a, 2n), 1n, NR.dm_lt(1n, a))

def bxor_self(b: Nat, +hb: {Nat.is_le(b, 1n) == True{} : Bool}) -> {SX.bxor(b, b) == 0n : Nat}:
  match b:
    case 0n:
      {==}
    case 1n:
      {==}
    case 2n+c:
      Empty.absurd({SX.bxor(2n+c, 2n+c) == 0n : Nat}, Lg.false_true(hb))

# a + b odd, a, b <= 1: b xor a == 1
def bxor_odd(a: Nat, b: Nat, +ha: {Nat.is_le(a, 1n) == True{} : Bool}, +hb: {Nat.is_le(b, 1n) == True{} : Bool}, +h: {Nat.mod(Nat.add(a, b), 2n) == 1n : Nat}) -> {SX.bxor(b, a) == 1n : Nat}:
  match a b:
    case 0n 0n:
      Empty.absurd({SX.bxor(0n, 0n) == 1n : Nat}, N.zero_succ(0n, h))
    case 0n 1n:
      {==}
    case 0n 2n+c:
      Empty.absurd({SX.bxor(2n+c, 0n) == 1n : Nat}, Lg.false_true(hb))
    case 1n 0n:
      {==}
    case 1n 1n:
      Empty.absurd({SX.bxor(1n, 1n) == 1n : Nat}, N.zero_succ(0n, h))
    case 1n 2n+c:
      Empty.absurd({SX.bxor(2n+c, 1n) == 1n : Nat}, Lg.false_true(hb))
    case 2n+e 0n:
      Empty.absurd({SX.bxor(0n, 2n+e) == 1n : Nat}, Lg.false_true(ha))
    case 2n+e 1n+c:
      Empty.absurd({SX.bxor(1n+c, 2n+e) == 1n : Nat}, Lg.false_true(ha))

def half_eq(+mp: Nat, +he: {Nat.mod(mp, 2n) == 0n : Nat}) -> {mp == Nat.add(Nat.mul(Nat.div(mp, 2n), 2n), 0n) : Nat}:
