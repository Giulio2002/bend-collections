  +g = FS.fpow(1n+mp, b, m)
  +pb = Nat.pow(b, m)
  +c1 = CG.c_trans(mp, FS.fmul(1n+mp, g, g), Nat.mul(g, g), Nat.mul(pb, pb), CG.c_mod(mp, Nat.mul(g, g)), CG.c_mul(mp, g, pb, g, pb, CG.c_mod(mp, pb), CG.c_mod(mp, pb)))
  +c2 = CG.c_trans(mp, FS.fmul(1n+mp, b, FS.fmul(1n+mp, g, g)), Nat.mul(b, FS.fmul(1n+mp, g, g)), Nat.mul(b, Nat.mul(pb, pb)), CG.c_mod(mp, Nat.mul(b, FS.fmul(1n+mp, g, g))), CG.c_mul(mp, b, b, FS.fmul(1n+mp, g, g), Nat.mul(pb, pb), CG.c_refl(mp, b), c1))
  +c3 = CG.c_eq(mp, Nat.mul(b, Nat.mul(pb, pb)), Nat.pow(b, k), Equal.cong(Nat, Nat, z => Nat.mul(b, z), Nat.mul(pb, pb), Nat.pow(b, Nat.add(m, m)), Equal.sym(Nat, Nat.pow(b, Nat.add(m, m)), Nat.mul(pb, pb), NR.pow_add(b, m, m))))
  +c4 = CG.c_pow(mp, b, FS.fmul(1n+mp, a, a), k, hb)
  +c5 = CG.c_trans(mp, Nat.pow(FS.fmul(1n+mp, a, a), k), Nat.mul(Nat.pow(a, k), Nat.pow(a, k)), Nat.pow(a, Nat.div(mp, 2n)), FQ.sq_pow(mp, a, k), CG.c_eq(mp, Nat.mul(Nat.pow(a, k), Nat.pow(a, k)), Nat.pow(a, Nat.div(mp, 2n)), pw5(mp, m, hk, a)))
