# ---- the candidate, with the exponent m ----

def dg(+mp: Nat, +d: Nat, +y: Nat, +m: Nat) -> Nat:
  FS.fpow(1n+mp, IDE.db(mp, DC.du(mp, y), DC.dv(mp, d, y), 0n, 0n, 0n, 0n, 0n), m)

def dxm(+mp: Nat, +d: Nat, +y: Nat, +m: Nat) -> Nat:
  IDE.dc(mp, DC.du(mp, y), DC.dv(mp, d, y), dg(mp, d, y, m), 0n, 0n, 0n, 0n)

def dvxx(+mp: Nat, +d: Nat, +y: Nat, +m: Nat) -> Nat:
  FS.fmul(1n+mp, DC.dv(mp, d, y), FS.fmul(1n+mp, dxm(mp, d, y, m), dxm(mp, d, y, m)))

# u == v x^2
def uvx(+mp: Nat, +d: Nat, +x: Nat, +y: Nat, +he: GL.Eq(mp, d, x, y)) -> {Nat.mod(DC.du(mp, y), 1n+mp) == Nat.mod(FS.fmul(1n+mp, DC.dv(mp, d, y), FS.fmul(1n+mp, x, x)), 1n+mp) : Nat}:
  F.msub_z(mp, DC.du(mp, y), FS.fmul(1n+mp, DC.dv(mp, d, y), FS.fmul(1n+mp, x, x)), IDD.dec_uv(mp, x, y, d, 0n, 0n, Equal.cong(Nat, Nat, z => Nat.mod(z, 1n+mp), G.lhs(1n+mp, x, y), G.rhs(1n+mp, d, x, y), he)))

def du_red(+mp: Nat, +y: Nat) -> {Nat.mod(DC.du(mp, y), 1n+mp) == DC.du(mp, y) : Nat}:
  FQ.fsub_red(mp, FS.fmul(1n+mp, y, y), 1n)

def vxx_red(+mp: Nat, +d: Nat, +y: Nat, +m: Nat) -> {Nat.mod(dvxx(mp, d, y, m), 1n+mp) == dvxx(mp, d, y, m) : Nat}:
  FQ.fmul_red(mp, DC.dv(mp, d, y), FS.fmul(1n+mp, dxm(mp, d, y, m), dxm(mp, d, y, m)))

# from a congruence to the decoder's test
def test_true(+mp: Nat, +a: Nat, +b: Nat, +ha: {Nat.mod(a, 1n+mp) == a : Nat}, +hb: {Nat.mod(b, 1n+mp) == b : Nat}, +h: {Nat.mod(a, 1n+mp) == Nat.mod(b, 1n+mp) : Nat}, +hf: {Nat.is_eq(a, b) == False{} : Bool}) -> Empty:
  Lg.true_false(Equal.trans(Bool, True{}, Nat.is_eq(a, b), False{}, Equal.sym(Bool, Nat.is_eq(a, b), True{}, PK.iseq(a, b, FQ.red_eq(mp, a, b, ha, hb, h))), hf))

# x == 0: the first test succeeds
def t_zero(+mp: Nat, +d: Nat, +x: Nat, +y: Nat, +m: Nat, +he: GL.Eq(mp, d, x, y), +hx0: {Nat.mod(x, 1n+mp) == 0n : Nat}) -> {Nat.mod(dvxx(mp, d, y, m), 1n+mp) == Nat.mod(DC.du(mp, y), 1n+mp) : Nat}:
  +u = DC.du(mp, y)
  +v = DC.dv(mp, d, y)
  +g = dg(mp, d, y, m)
  +hu0 = IDE.dec_u0(mp, u, v, g, x, 0n, 0n, 0n, uvx(mp, d, x, y, he), hx0)
  +hc0 = IDE.dec_c0(mp, u, v, g, x, 0n, 0n, 0n, hu0)
  Equal.trans(Nat, Nat.mod(dvxx(mp, d, y, m), 1n+mp), 0n, Nat.mod(u, 1n+mp), F.z_mmul_r(mp, v, FS.fmul(1n+mp, dxm(mp, d, y, m), dxm(mp, d, y, m)), F.z_mmul_l(mp, dxm(mp, d, y, m), dxm(mp, d, y, m), hc0)), Equal.sym(Nat, Nat.mod(u, 1n+mp), 0n, hu0))

# v xc^2 == u W, W = (x v^4)^((p - 1) / 2)
def t_w(+mp: Nat, +d: Nat, +x: Nat, +y: Nat, +m: Nat, +hk: {Nat.div(mp, 2n) == Nat.add(Nat.add(1n, Nat.add(m, m)), Nat.add(1n, Nat.add(m, m))) : Nat}, +he: GL.Eq(mp, d, x, y)) -> {Nat.mod(dvxx(mp, d, y, m), 1n+mp) == Nat.mod(FS.fmul(1n+mp, DC.du(mp, y), Nat.pow(IDE.da(mp, DC.du(mp, y), DC.dv(mp, d, y), 0n, x, 0n, 0n, 0n), Nat.div(mp, 2n))), 1n+mp) : Nat}:
  +u = DC.du(mp, y)
  +v = DC.dv(mp, d, y)
  +g = dg(mp, d, y, m)
  +b = IDE.db(mp, u, v, 0n, 0n, 0n, 0n, 0n)
  +a = IDE.da(mp, u, v, 0n, x, 0n, 0n, 0n)
  +ww = Nat.pow(a, Nat.div(mp, 2n))
  +hb = F.msub_z(mp, b, FS.fmul(1n+mp, a, a), IDE.dec_b(mp, u, v, 0n, x, 0n, 0n, 0n, uvx(mp, d, x, y, he)))
