      +hw2 = IDE.dec_w2(mp, u, v, 0n, x, 0n, ww, 0n, FQ.half_one(mp, hp, FQ.cv_even(mp, d, hc), a, hna))
      +hw1 = F.zprod(mp, hp, FS.fsub(1n+mp, ww, 1n), FS.fadd(1n+mp, ww, 1n), F.z_red(mp, Nat.mul(FS.fsub(1n+mp, ww, 1n), FS.fadd(1n+mp, ww, 1n)), hw2), hcw)
      +e = F.msub_z(mp, FS.fmul(1n+mp, u, ww), FS.fsub(1n+mp, 0n, u), IDE.dec_wm(mp, u, v, 0n, x, 0n, ww, 0n, hw1))
      test_true(mp, dvxx(mp, d, y, m), FS.fsub(1n+mp, 0n, u), vxx_red(mp, d, y, m), FQ.fsub_red(mp, 0n, u), Equal.trans(Nat, Nat.mod(dvxx(mp, d, y, m), 1n+mp), Nat.mod(FS.fmul(1n+mp, u, ww), 1n+mp), Nat.mod(FS.fsub(1n+mp, 0n, u), 1n+mp), hvx, e), hn)

# both tests failing is impossible
def t_ff_c(+mp: Nat, +d: Nat, +hc: G.Curve(mp, d), +x: Nat, +y: Nat, +m: Nat, +hk: {Nat.div(mp, 2n) == Nat.add(Nat.add(1n, Nat.add(m, m)), Nat.add(1n, Nat.add(m, m))) : Nat}, +he: GL.Eq(mp, d, x, y), +hu: {Nat.is_eq(dvxx(mp, d, y, m), DC.du(mp, y)) == False{} : Bool}, +hn: {Nat.is_eq(dvxx(mp, d, y, m), FS.fsub(1n+mp, 0n, DC.du(mp, y))) == False{} : Bool}, c: Bool, +hcx: {Nat.is_eq(Nat.mod(x, 1n+mp), 0n) == c : Bool}) -> Empty:
  match c:
    case True{}:
      test_true(mp, dvxx(mp, d, y, m), DC.du(mp, y), vxx_red(mp, d, y, m), du_red(mp, y), t_zero(mp, d, x, y, m, he, N.eq_from_is_eq(Nat.mod(x, 1n+mp), 0n, hcx)), hu)
    case False{}:
      t_nz_c(mp, d, hc, x, y, m, hk, he, hcx, hu, hn, Nat.is_eq(Nat.mod(FS.fsub(1n+mp, Nat.pow(IDE.da(mp, DC.du(mp, y), DC.dv(mp, d, y), 0n, x, 0n, 0n, 0n), Nat.div(mp, 2n)), 1n), 1n+mp), 0n), {==})

# ---- a root r of v r^2 == u is x or -x, and the parity picks x ----

def fail_s(x: Nat) -> {Bool.and(Nat.is_eq(x, 0n), Nat.is_eq(Nat.mod(x, 2n), 1n)) == False{} : Bool}:
  match x:
    case 0n:
      {==}
    case 1n+xp:
      {==}

# r == x
def fin_same(+mp: Nat, +x: Nat, +y: Nat) -> {ED.dec_fin(1n+mp, x, y, Nat.mod(x, 2n), Bool.and(Nat.is_eq(x, 0n), Nat.is_eq(Nat.mod(x, 2n), 1n))) == Some{ED.EPt{x, y, 1n, FS.fmul(1n+mp, x, y)}} : Maybe<&2, ED.EPt>}:
  %Equal.sym(Bool, Bool.and(Nat.is_eq(x, 0n), Nat.is_eq(Nat.mod(x, 2n), 1n)), False{}, fail_s(x)) : {ED.dec_fin(1n+mp, x, y, Nat.mod(x, 2n), _) == Some{ED.EPt{x, y, 1n, FS.fmul(1n+mp, x, y)}} : Maybe<&2, ED.EPt>}
  %Equal.sym(Nat, SX.bxor(Nat.mod(x, 2n), Nat.mod(x, 2n)), 0n, bxor_self(Nat.mod(x, 2n), mod2_le(x))) : {Some{ED.EPt{SX.cs_fst(_, x, FS.fsub(1n+mp, 0n, x)), y, 1n, FS.fmul(1n+mp, SX.cs_fst(SX.bxor(Nat.mod(x, 2n), Nat.mod(x, 2n)), x, FS.fsub(1n+mp, 0n, x)), y)}} == Some{ED.EPt{x, y, 1n, FS.fmul(1n+mp, x, y)}} : Maybe<&2, ED.EPt>}
  %Equal.sym(Nat, SX.bxor(Nat.mod(x, 2n), Nat.mod(x, 2n)), 0n, bxor_self(Nat.mod(x, 2n), mod2_le(x))) : {Some{ED.EPt{SX.cs_fst(0n, x, FS.fsub(1n+mp, 0n, x)), y, 1n, FS.fmul(1n+mp, SX.cs_fst(_, x, FS.fsub(1n+mp, 0n, x)), y)}} == Some{ED.EPt{x, y, 1n, FS.fmul(1n+mp, x, y)}} : Maybe<&2, ED.EPt>}
  {==}

def neg_neg(+mp: Nat, +x: Nat, +hx: {Nat.is_lt(x, 1n+mp) == True{} : Bool}) -> {FS.fsub(1n+mp, 0n, FS.fsub(1n+mp, 0n, x)) == x : Nat}:
  FQ.red_eq(mp, FS.fsub(1n+mp, 0n, FS.fsub(1n+mp, 0n, x)), x, FQ.fsub_red(mp, 0n, FS.fsub(1n+mp, 0n, x)), FL.small_nz(mp, x, hx), IDD.dec_nn(mp, x, 0n, 0n, 0n, 0n))

# r == -x, x != 0
def fin_neg(+mp: Nat, +he2: {Nat.mod(mp, 2n) == 0n : Nat}, +xp: Nat, +y: Nat, +hx: {Nat.is_lt(1n+xp, 1n+mp) == True{} : Bool}, +hr0: {Nat.is_eq(FS.fsub(1n+mp, 0n, 1n+xp), 0n) == False{} : Bool}) -> {ED.dec_fin(1n+mp, FS.fsub(1n+mp, 0n, 1n+xp), y, Nat.mod(1n+xp, 2n), Bool.and(Nat.is_eq(FS.fsub(1n+mp, 0n, 1n+xp), 0n), Nat.is_eq(Nat.mod(1n+xp, 2n), 1n))) == Some{ED.EPt{1n+xp, y, 1n, FS.fmul(1n+mp, 1n+xp, y)}} : Maybe<&2, ED.EPt>}:
  %Equal.sym(Bool, Nat.is_eq(FS.fsub(1n+mp, 0n, 1n+xp), 0n), False{}, hr0) : {ED.dec_fin(1n+mp, FS.fsub(1n+mp, 0n, 1n+xp), y, Nat.mod(1n+xp, 2n), Bool.and(_, Nat.is_eq(Nat.mod(1n+xp, 2n), 1n))) == Some{ED.EPt{1n+xp, y, 1n, FS.fmul(1n+mp, 1n+xp, y)}} : Maybe<&2, ED.EPt>}
  %Equal.sym(Nat, SX.bxor(Nat.mod(FS.fsub(1n+mp, 0n, 1n+xp), 2n), Nat.mod(1n+xp, 2n)), 1n, par(mp, he2, 1n+xp, FS.fsub(1n+mp, 0n, 1n+xp), neg_sum(mp, xp, hx))) : {Some{ED.EPt{SX.cs_fst(_, FS.fsub(1n+mp, 0n, 1n+xp), FS.fsub(1n+mp, 0n, FS.fsub(1n+mp, 0n, 1n+xp))), y, 1n, FS.fmul(1n+mp, SX.cs_fst(SX.bxor(Nat.mod(FS.fsub(1n+mp, 0n, 1n+xp), 2n), Nat.mod(1n+xp, 2n)), FS.fsub(1n+mp, 0n, 1n+xp), FS.fsub(1n+mp, 0n, FS.fsub(1n+mp, 0n, 1n+xp))), y)}} == Some{ED.EPt{1n+xp, y, 1n, FS.fmul(1n+mp, 1n+xp, y)}} : Maybe<&2, ED.EPt>}
  %Equal.sym(Nat, SX.bxor(Nat.mod(FS.fsub(1n+mp, 0n, 1n+xp), 2n), Nat.mod(1n+xp, 2n)), 1n, par(mp, he2, 1n+xp, FS.fsub(1n+mp, 0n, 1n+xp), neg_sum(mp, xp, hx))) : {Some{ED.EPt{SX.cs_fst(1n, FS.fsub(1n+mp, 0n, 1n+xp), FS.fsub(1n+mp, 0n, FS.fsub(1n+mp, 0n, 1n+xp))), y, 1n, FS.fmul(1n+mp, SX.cs_fst(_, FS.fsub(1n+mp, 0n, 1n+xp), FS.fsub(1n+mp, 0n, FS.fsub(1n+mp, 0n, 1n+xp))), y)}} == Some{ED.EPt{1n+xp, y, 1n, FS.fmul(1n+mp, 1n+xp, y)}} : Maybe<&2, ED.EPt>}
  %Equal.sym(Nat, FS.fsub(1n+mp, 0n, FS.fsub(1n+mp, 0n, 1n+xp)), 1n+xp, neg_neg(mp, 1n+xp, hx)) : {Some{ED.EPt{_, y, 1n, FS.fmul(1n+mp, FS.fsub(1n+mp, 0n, FS.fsub(1n+mp, 0n, 1n+xp)), y)}} == Some{ED.EPt{1n+xp, y, 1n, FS.fmul(1n+mp, 1n+xp, y)}} : Maybe<&2, ED.EPt>}
  %Equal.sym(Nat, FS.fsub(1n+mp, 0n, FS.fsub(1n+mp, 0n, 1n+xp)), 1n+xp, neg_neg(mp, 1n+xp, hx)) : {Some{ED.EPt{1n+xp, y, 1n, FS.fmul(1n+mp, _, y)}} == Some{ED.EPt{1n+xp, y, 1n, FS.fmul(1n+mp, 1n+xp, y)}} : Maybe<&2, ED.EPt>}
  {==}


# the decoder's last step, on a root r, returns (x : y : 1 : x y)
def Fin(+mp: Nat, +x: Nat, +y: Nat, +r: Nat) -> Type:
  {ED.dec_fin(1n+mp, r, y, Nat.mod(x, 2n), Bool.and(Nat.is_eq(r, 0n), Nat.is_eq(Nat.mod(x, 2n), 1n))) == Some{ED.EPt{x, y, 1n, FS.fmul(1n+mp, x, y)}} : Maybe<&2, ED.EPt>}

def neg_nz_s(+mp: Nat, +xp: Nat, +hx: {Nat.is_lt(1n+xp, 1n+mp) == True{} : Bool}, +h0: {FS.fsub(1n+mp, 0n, 1n+xp) == 0n : Nat}) -> {1n+xp == 1n+mp : Nat}:
  %Equal.sym(Nat, 1n+xp, Nat.add(1n+xp, 0n), Equal.sym(Nat, Nat.add(1n+xp, 0n), 1n+xp, NA.add_zero(1n+xp))) : {_ == 1n+mp : Nat}
  %Equal.sym(Nat, 0n, FS.fsub(1n+mp, 0n, 1n+xp), Equal.sym(Nat, FS.fsub(1n+mp, 0n, 1n+xp), 0n, h0)) : {Nat.add(1n+xp, _) == 1n+mp : Nat}
  neg_sum(mp, xp, hx)

def neg_nz_c(+mp: Nat, +xp: Nat, +hx: {Nat.is_lt(1n+xp, 1n+mp) == True{} : Bool}, c: Bool, +hc: {Nat.is_eq(FS.fsub(1n+mp, 0n, 1n+xp), 0n) == c : Bool}) -> {Nat.is_eq(FS.fsub(1n+mp, 0n, 1n+xp), 0n) == False{} : Bool}:
  match c:
    case False{}:
      hc
    case True{}:
      Empty.absurd({Nat.is_eq(FS.fsub(1n+mp, 0n, 1n+xp), 0n) == False{} : Bool}, N.lt_ne(1n+xp, 1n+mp, hx, neg_nz_s(mp, xp, hx, N.eq_from_is_eq(FS.fsub(1n+mp, 0n, 1n+xp), 0n, hc))))

# (r - x) (r + x) == 0 for two roots
def two_roots(+mp: Nat, +d: Nat, +hc: G.Curve(mp, d), +x: Nat, +y: Nat, +r: Nat, +he: GL.Eq(mp, d, x, y), +hr: DC.Root(mp, d, y, r)) -> {Nat.mod(Nat.mul(FS.fsub(1n+mp, r, x), FS.fadd(1n+mp, r, x)), 1n+mp) == 0n : Nat}:
  +hp = FQ.cv_prime(mp, d, hc)
  +v = DC.dv(mp, d, y)
  F.z_red(mp, Nat.mul(FS.fsub(1n+mp, r, x), FS.fadd(1n+mp, r, x)), F.zprod(mp, hp, v, FS.fmul(1n+mp, FS.fsub(1n+mp, r, x), FS.fadd(1n+mp, r, x)),
    F.z_red(mp, Nat.mul(v, FS.fmul(1n+mp, FS.fsub(1n+mp, r, x), FS.fadd(1n+mp, r, x))), IDD.dec_pm(mp, x, y, d, 0n, r, hr, uvx(mp, d, x, y, he))), vnz(mp, d, hc, y)))

def fin_pm(+mp: Nat, +d: Nat, +hc: G.Curve(mp, d), +xp: Nat, +y: Nat, +r: Nat, +hx: {Nat.is_lt(1n+xp, 1n+mp) == True{} : Bool}, +he: GL.Eq(mp, d, 1n+xp, y), +hr: DC.Root(mp, d, y, r), +hrr: {Nat.mod(r, 1n+mp) == r : Nat}, c: Bool, +hcc: {Nat.is_eq(Nat.mod(FS.fsub(1n+mp, r, 1n+xp), 1n+mp), 0n) == c : Bool}) -> Fin(mp, 1n+xp, y, r):
  match c:
    case True{}:
      +heq = FQ.red_eq(mp, r, 1n+xp, hrr, FL.small_nz(mp, 1n+xp, hx), F.msub_z(mp, r, 1n+xp, N.eq_from_is_eq(Nat.mod(FS.fsub(1n+mp, r, 1n+xp), 1n+mp), 0n, hcc)))
      %Equal.sym(Nat, r, 1n+xp, heq) : Fin(mp, 1n+xp, y, _)
      fin_same(mp, 1n+xp, y)
    case False{}:
      +hp = FQ.cv_prime(mp, d, hc)
      +hs = F.zprod(mp, hp, FS.fsub(1n+mp, r, 1n+xp), FS.fadd(1n+mp, r, 1n+xp), two_roots(mp, d, hc, 1n+xp, y, r, he, hr), hcc)
      +heq = FQ.red_eq(mp, r, FS.fsub(1n+mp, 0n, 1n+xp), hrr, FQ.fsub_red(mp, 0n, 1n+xp), F.msub_z(mp, r, FS.fsub(1n+mp, 0n, 1n+xp), IDD.dec_rneg(mp, 1n+xp, y, d, 0n, r, hs)))
      %Equal.sym(Nat, r, FS.fsub(1n+mp, 0n, 1n+xp), heq) : Fin(mp, 1n+xp, y, _)
      fin_neg(mp, FQ.cv_even(mp, d, hc), xp, y, hx, neg_nz_c(mp, xp, hx, Nat.is_eq(FS.fsub(1n+mp, 0n, 1n+xp), 0n), {==}))

def fin_rt(+mp: Nat, +d: Nat, +hc: G.Curve(mp, d), x: Nat, +y: Nat, +r: Nat, +hx: {Nat.is_lt(x, 1n+mp) == True{} : Bool}, +he: GL.Eq(mp, d, x, y), +hr: DC.Root(mp, d, y, r), +hrr: {Nat.mod(r, 1n+mp) == r : Nat}) -> Fin(mp, x, y, r):
  match x:
    case 0n:
      +hp = FQ.cv_prime(mp, d, hc)
      +v = DC.dv(mp, d, y)
      +h0 = sq_zero(mp, hp, r, F.z_red(mp, Nat.mul(r, r), F.zprod(mp, hp, v, FS.fmul(1n+mp, r, r), F.z_red(mp, Nat.mul(v, FS.fmul(1n+mp, r, r)), IDD.dec_sq0(mp, 0n, y, d, 0n, r, hr, uvx(mp, d, 0n, y, he), {==})), vnz(mp, d, hc, y))))
      +heq = Equal.trans(Nat, r, Nat.mod(r, 1n+mp), 0n, Equal.sym(Nat, Nat.mod(r, 1n+mp), r, hrr), h0)
      %Equal.sym(Nat, r, 0n, heq) : Fin(mp, 0n, y, _)
      fin_same(mp, 0n, y)
    case 1n+ +xp:
      fin_pm(mp, d, hc, xp, y, r, hx, he, hr, hrr, Nat.is_eq(Nat.mod(FS.fsub(1n+mp, r, 1n+xp), 1n+mp), 0n), {==})

def dxm_red(+mp: Nat, +d: Nat, +y: Nat, +m: Nat) -> {Nat.mod(dxm(mp, d, y, m), 1n+mp) == dxm(mp, d, y, m) : Nat}:
  FQ.fmul_red(mp, FS.fmul(1n+mp, DC.du(mp, y), FS.fmul(1n+mp, FS.fmul(1n+mp, DC.dv(mp, d, y), DC.dv(mp, d, y)), DC.dv(mp, d, y))), dg(mp, d, y, m))

# the decoder's root selection, with the exponent m
def Rt(+mp: Nat, +d: Nat, +x: Nat, +y: Nat, +m: Nat) -> Type:
  {ED.dec_root(1n+mp, dxm(mp, d, y, m), y, Nat.mod(x, 2n), Nat.is_eq(dvxx(mp, d, y, m), DC.du(mp, y)), Nat.is_eq(dvxx(mp, d, y, m), FS.fsub(1n+mp, 0n, DC.du(mp, y)))) == Some{ED.EPt{x, y, 1n, FS.fmul(1n+mp, x, y)}} : Maybe<&2, ED.EPt>}

def root_rt(+mp: Nat, +d: Nat, +hc: G.Curve(mp, d), +m: Nat, +hk: {Nat.div(mp, 2n) == Nat.add(Nat.add(1n, Nat.add(m, m)), Nat.add(1n, Nat.add(m, m))) : Nat}, +x: Nat, +y: Nat, +hx: {Nat.is_lt(x, 1n+mp) == True{} : Bool}, +he: GL.Eq(mp, d, x, y), is_u: Bool, is_nu: Bool, +hu: {Nat.is_eq(dvxx(mp, d, y, m), DC.du(mp, y)) == is_u : Bool}, +hn: {Nat.is_eq(dvxx(mp, d, y, m), FS.fsub(1n+mp, 0n, DC.du(mp, y))) == is_nu : Bool}) -> {ED.dec_root(1n+mp, dxm(mp, d, y, m), y, Nat.mod(x, 2n), is_u, is_nu) == Some{ED.EPt{x, y, 1n, FS.fmul(1n+mp, x, y)}} : Maybe<&2, ED.EPt>}:
  match is_u:
    case True{}:
      fin_rt(mp, d, hc, x, y, dxm(mp, d, y, m), hx, he, Equal.cong(Nat, Nat, z => Nat.mod(z, 1n+mp), dvxx(mp, d, y, m), DC.du(mp, y), N.eq_from_is_eq(dvxx(mp, d, y, m), DC.du(mp, y), hu)), dxm_red(mp, d, y, m))
    case False{}:
      match is_nu:
        case True{}:
          fin_rt(mp, d, hc, x, y, FS.fmul(1n+mp, dxm(mp, d, y, m), G.sqm1(1n+mp)), hx, he, DC.root_i(mp, d, hc, y, dxm(mp, d, y, m), N.eq_from_is_eq(dvxx(mp, d, y, m), FS.fsub(1n+mp, 0n, DC.du(mp, y)), hn)), FQ.fmul_red(mp, dxm(mp, d, y, m), G.sqm1(1n+mp)))
        case False{}:
          Empty.absurd({None{} == Some{ED.EPt{x, y, 1n, FS.fmul(1n+mp, x, y)}} : Maybe<&2, ED.EPt>}, t_ff_c(mp, d, hc, x, y, m, hk, he, hu, hn, Nat.is_eq(Nat.mod(x, 1n+mp), 0n), {==}))

# x recovery: the decoder on y and the parity of x returns (x : y : 1 : x y),
# for a point (x, y) of the curve, p = 8 m + 5
def dec_rt(+mp: Nat, +d: Nat, +hc: G.Curve(mp, d), +m: Nat, +h58: {Nat.div(Nat.sub(1n+mp, 5n), 8n) == m : Nat}, +hk: {Nat.div(mp, 2n) == Nat.add(Nat.add(1n, Nat.add(m, m)), Nat.add(1n, Nat.add(m, m))) : Nat}, +x: Nat, +y: Nat, +hx: {Nat.is_lt(x, 1n+mp) == True{} : Bool}, +he: GL.Eq(mp, d, x, y)) -> {ED.dec_y(1n+mp, d, y, Nat.mod(x, 2n), False{}) == Some{ED.EPt{x, y, 1n, FS.fmul(1n+mp, x, y)}} : Maybe<&2, ED.EPt>}:
  %Equal.sym(Nat, Nat.div(Nat.sub(1n+mp, 5n), 8n), m, h58) : Rt(mp, d, x, y, _)
  root_rt(mp, d, hc, m, hk, x, y, hx, he, Nat.is_eq(dvxx(mp, d, y, m), DC.du(mp, y)), Nat.is_eq(dvxx(mp, d, y, m), FS.fsub(1n+mp, 0n, DC.du(mp, y))), {==}, {==})
