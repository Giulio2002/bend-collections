# b == a a: b (b^m)^2 == a^((p - 1) / 2), for (p - 1) / 2 == 2 (2 m + 1)
def pw(+mp: Nat, +m: Nat, +hk: {Nat.div(mp, 2n) == Nat.add(Nat.add(1n, Nat.add(m, m)), Nat.add(1n, Nat.add(m, m))) : Nat}, +b: Nat, +a: Nat, +hb: {Nat.mod(b, 1n+mp) == Nat.mod(FS.fmul(1n+mp, a, a), 1n+mp) : Nat}) -> {Nat.mod(FS.fmul(1n+mp, b, FS.fmul(1n+mp, FS.fpow(1n+mp, b, m), FS.fpow(1n+mp, b, m))), 1n+mp) == Nat.mod(Nat.pow(a, Nat.div(mp, 2n)), 1n+mp) : Nat}:
