def vnz_c(+mp: Nat, +d: Nat, +hc: G.Curve(mp, d), +y: Nat, c: Bool, +hcc: {Nat.is_eq(Nat.mod(DC.dv(mp, d, y), 1n+mp), 0n) == c : Bool}) -> F.NZ(mp, DC.dv(mp, d, y)):
