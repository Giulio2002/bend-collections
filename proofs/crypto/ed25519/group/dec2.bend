# x + r == p: the parities of r and x differ
def par(+mp: Nat, +he: {Nat.mod(mp, 2n) == 0n : Nat}, +x: Nat, +r: Nat, +h: {Nat.add(x, r) == 1n+mp : Nat}) -> {SX.bxor(Nat.mod(r, 2n), Nat.mod(x, 2n)) == 1n : Nat}:
