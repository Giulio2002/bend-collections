# ---- Euclid's lemma ----

# a prime n does not divide a: gcd(a, n) == 1
def g1(+pp: Nat, +hp: Prime(2n+pp), +a: Nat, +ha: {Nat.is_eq(Nat.mod(a, 2n+pp), 0n) == False{} : Bool}, g: Nat, +hg: {M.gcd(a, 2n+pp) == g : Nat}) -> {M.gcd(a, 2n+pp) == 1n : Nat}:
