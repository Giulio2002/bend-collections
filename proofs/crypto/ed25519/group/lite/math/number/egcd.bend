def bez_go(+f: Nat, +a: Nat, +b: Nat) -> {SN.eg_pos(a, b, NB.egcd_go(f, a, b)) == SN.eg_neg(a, b, NB.egcd_go(f, a, b)) : Nat}:
  match f b:
    case 0n _:
      base(a, b)
    case 1n+ +g 0n:
      base(a, 0n)
