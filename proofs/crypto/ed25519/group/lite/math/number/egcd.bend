    case NB.EG{+g, +x, +y, +neg}:
      up_sign(a, b, q, r, ha, g, x, y, neg, ih)


# a == (a div b) b + a mod b
def split(+a: Nat, +bp: Nat) -> {a == Nat.add(Nat.mul(Nat.div(a, 1n+bp), 1n+bp), Nat.mod(a, 1n+bp)) : Nat}:
