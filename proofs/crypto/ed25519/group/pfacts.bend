  %Equal.sym(Nat, X.bvalo(one, l8()), 8n, X.lit_o(one, h1, l8(), 8n, v8())) : {Nat.mod(Nat.add(Nat.mul(X.bvalo(one, e58l()), _), X.bvalo(one, l4())), 8n) == 4n : Nat}
  %Equal.sym(Nat, X.bvalo(one, l4()), 4n, X.lit_o(one, h1, l4(), 4n, v4())) : {Nat.mod(Nat.add(Nat.mul(X.bvalo(one, e58l()), 8n), _), 8n) == 4n : Nat}
  NR.mod_of(X.bvalo(one, e58l()), 7n, 4n, {==})

# (p - 1) mod 4 == 0
def p1_mod4(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.mod(X.bvalo(one, p1l()), 4n) == 0n : Nat}:
  mod_o(one, h1, p1l(), q4l(), l4(), 3n, v4(), {==})

def lt2(+y: Nat) -> {Nat.is_lt(2n, 3n+y) == True{} : Bool}:
  {==}

def nz2(+y: Nat) -> {Nat.is_eq(Nat.mod(2n, 3n+y), 0n) == False{} : Bool}:
  %Equal.sym(Nat, Nat.mod(Nat.add(Nat.mul(0n, 3n+y), 2n), 3n+y), 2n, NR.mod_of(0n, 2n+y, 2n, lt2(y))) : {Nat.is_eq(_, 0n) == False{} : Bool}
  {==}

def p_nz2_eq(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.is_eq(Nat.mod(2n, 1n+X.bvalo(one, p1l())), 0n) == False{} : Bool}:
  %Equal.sym(Nat, X.bvalo(one, p1l()), 2n+X.bvalo(one, p3l()), X.suc2_o(one, h1, p1l(), p3l(), {==})) : {Nat.is_eq(Nat.mod(2n, 1n+_), 0n) == False{} : Bool}
  nz2(X.bvalo(one, p3l()))

# 2 is not 0 modulo p
def p_nz2(+one: Nat, +h1: {one == 1n : Nat}) -> F.NZ(X.bvalo(one, p1l()), 2n):
  p_nz2_eq(one, h1)

# x == k p: x mod p == 0
def pmod0(+one: Nat, +h1: {one == 1n : Nat}, +x: B.Bn, +k: B.Bn, +h: {B.beq(x, B.bmul(k, pl())) == True{} : Bool}) -> {Nat.mod(X.bvalo(one, x), FS.prime(one)) == 0n : Nat}:
  %Equal.sym(Nat, X.bvalo(one, x), X.bvalo(one, B.bmul(k, pl())), X.eq_o(one, h1, x, B.bmul(k, pl()), h)) : {Nat.mod(_, FS.prime(one)) == 0n : Nat}
  %Equal.sym(Nat, X.bvalo(one, B.bmul(k, pl())), Nat.mul(X.bvalo(one, k), X.bvalo(one, pl())), X.mul_o(one, h1, k, pl())) : {Nat.mod(_, FS.prime(one)) == 0n : Nat}
  %Equal.sym(Nat, X.bvalo(one, pl()), FS.prime(one), p_is(one, h1)) : {Nat.mod(Nat.mul(X.bvalo(one, k), _), FS.prime(one)) == 0n : Nat}
  %Equal.sym(Nat, FS.prime(one), 1n+X.bvalo(one, p1l()), p_suc(one, h1)) : {Nat.mod(Nat.mul(X.bvalo(one, k), _), FS.prime(one)) == 0n : Nat}
  %Equal.sym(Nat, FS.prime(one), 1n+X.bvalo(one, p1l()), p_suc(one, h1)) : {Nat.mod(Nat.mul(X.bvalo(one, k), 1n+X.bvalo(one, p1l())), _) == 0n : Nat}
  PM.mod_mul0(X.bvalo(one, p1l()), X.bvalo(one, k))

# ---- d = -121665 / 121666 ----

def c5_ok() -> {dmatch([B.B1{B.B0{B.B0{B.B0{B.B0{B.B0{B.B1{B.BZ{}}}}}}}}, B.B1{B.B1{B.B0{B.B1{B.B1{B.B0{B.B1{B.B1{B.BZ{}}}}}}}}}, B.B1{B.BZ{}}], [65n, 219n, 1n]) == True{} : Bool}:
  {==}

def c6_ok() -> {dmatch([B.B0{B.B1{B.B0{B.B0{B.B0{B.B0{B.B1{B.BZ{}}}}}}}}, B.B1{B.B1{B.B0{B.B1{B.B1{B.B0{B.B1{B.B1{B.BZ{}}}}}}}}}, B.B1{B.BZ{}}], [66n, 219n, 1n]) == True{} : Bool}:
  {==}

def eq4() -> {B.beq(c5l(), bdig([B.B1{B.B0{B.B0{B.B0{B.B0{B.B0{B.B1{B.BZ{}}}}}}}}, B.B1{B.B1{B.B0{B.B1{B.B1{B.B0{B.B1{B.B1{B.BZ{}}}}}}}}}, B.B1{B.BZ{}}])) == True{} : Bool}:
  {==}

# 121665, as ED.dconst writes it
def c5_is(+one: Nat, +h1: {one == 1n : Nat}) -> {X.bvalo(one, c5l()) == FS.digits(one, [65n, 219n, 1n]) : Nat}:
  %Equal.sym(Nat, X.bvalo(one, c5l()), X.bvalo(one, bdig([B.B1{B.B0{B.B0{B.B0{B.B0{B.B0{B.B1{B.BZ{}}}}}}}}, B.B1{B.B1{B.B0{B.B1{B.B1{B.B0{B.B1{B.B1{B.BZ{}}}}}}}}}, B.B1{B.BZ{}}])), X.eq_o(one, h1, c5l(), bdig([B.B1{B.B0{B.B0{B.B0{B.B0{B.B0{B.B1{B.BZ{}}}}}}}}, B.B1{B.B1{B.B0{B.B1{B.B1{B.B0{B.B1{B.B1{B.BZ{}}}}}}}}}, B.B1{B.BZ{}}]), eq4())) : {_ == FS.digits(one, [65n, 219n, 1n]) : Nat}
  dig_o(one, h1, [B.B1{B.B0{B.B0{B.B0{B.B0{B.B0{B.B1{B.BZ{}}}}}}}}, B.B1{B.B1{B.B0{B.B1{B.B1{B.B0{B.B1{B.B1{B.BZ{}}}}}}}}}, B.B1{B.BZ{}}], [65n, 219n, 1n], c5_ok())

def eq5() -> {B.beq(c6l(), bdig([B.B0{B.B1{B.B0{B.B0{B.B0{B.B0{B.B1{B.BZ{}}}}}}}}, B.B1{B.B1{B.B0{B.B1{B.B1{B.B0{B.B1{B.B1{B.BZ{}}}}}}}}}, B.B1{B.BZ{}}])) == True{} : Bool}:
  {==}

# 121666
def c6_is(+one: Nat, +h1: {one == 1n : Nat}) -> {X.bvalo(one, c6l()) == FS.digits(one, [66n, 219n, 1n]) : Nat}:
  %Equal.sym(Nat, X.bvalo(one, c6l()), X.bvalo(one, bdig([B.B0{B.B1{B.B0{B.B0{B.B0{B.B0{B.B1{B.BZ{}}}}}}}}, B.B1{B.B1{B.B0{B.B1{B.B1{B.B0{B.B1{B.B1{B.BZ{}}}}}}}}}, B.B1{B.BZ{}}])), X.eq_o(one, h1, c6l(), bdig([B.B0{B.B1{B.B0{B.B0{B.B0{B.B0{B.B1{B.BZ{}}}}}}}}, B.B1{B.B1{B.B0{B.B1{B.B1{B.B0{B.B1{B.B1{B.BZ{}}}}}}}}}, B.B1{B.BZ{}}]), eq5())) : {_ == FS.digits(one, [66n, 219n, 1n]) : Nat}
  dig_o(one, h1, [B.B0{B.B1{B.B0{B.B0{B.B0{B.B0{B.B1{B.BZ{}}}}}}}}, B.B1{B.B1{B.B0{B.B1{B.B1{B.B0{B.B1{B.B1{B.BZ{}}}}}}}}}, B.B1{B.BZ{}}], [66n, 219n, 1n], c6_ok())

# 121666 d + 121665 == 0 (mod p), on the literals
def d_defl(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.mod(Nat.add(Nat.mul(X.bvalo(one, dl()), X.bvalo(one, c6l())), X.bvalo(one, c5l())), FS.prime(one)) == 0n : Nat}:
  %Equal.sym(Nat, Nat.mul(X.bvalo(one, dl()), X.bvalo(one, c6l())), X.bvalo(one, B.bmul(dl(), c6l())), Equal.sym(Nat, X.bvalo(one, B.bmul(dl(), c6l())), Nat.mul(X.bvalo(one, dl()), X.bvalo(one, c6l())), X.mul_o(one, h1, dl(), c6l()))) : {Nat.mod(Nat.add(_, X.bvalo(one, c5l())), FS.prime(one)) == 0n : Nat}
  %Equal.sym(Nat, Nat.add(X.bvalo(one, B.bmul(dl(), c6l())), X.bvalo(one, c5l())), X.bvalo(one, B.badd(B.bmul(dl(), c6l()), c5l())), Equal.sym(Nat, X.bvalo(one, B.badd(B.bmul(dl(), c6l()), c5l())), Nat.add(X.bvalo(one, B.bmul(dl(), c6l())), X.bvalo(one, c5l())), X.add_o(one, h1, B.bmul(dl(), c6l()), c5l()))) : {Nat.mod(_, FS.prime(one)) == 0n : Nat}
  pmod0(one, h1, B.badd(B.bmul(dl(), c6l()), c5l()), dkl(), {==})

# the same with the specification's 121666 and 121665
def d_def(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.mod(Nat.add(Nat.mul(X.bvalo(one, dl()), FS.digits(one, [66n, 219n, 1n])), FS.digits(one, [65n, 219n, 1n])), FS.prime(one)) == 0n : Nat}:
  %Equal.sym(Nat, FS.digits(one, [66n, 219n, 1n]), X.bvalo(one, c6l()), Equal.sym(Nat, X.bvalo(one, c6l()), FS.digits(one, [66n, 219n, 1n]), c6_is(one, h1))) : {Nat.mod(Nat.add(Nat.mul(X.bvalo(one, dl()), _), FS.digits(one, [65n, 219n, 1n])), FS.prime(one)) == 0n : Nat}
  %Equal.sym(Nat, FS.digits(one, [65n, 219n, 1n]), X.bvalo(one, c5l()), Equal.sym(Nat, X.bvalo(one, c5l()), FS.digits(one, [65n, 219n, 1n]), c5_is(one, h1))) : {Nat.mod(Nat.add(Nat.mul(X.bvalo(one, dl()), X.bvalo(one, c6l())), _), FS.prime(one)) == 0n : Nat}
  d_defl(one, h1)

def d_lt(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.is_lt(X.bvalo(one, dl()), FS.prime(one)) == True{} : Bool}:
  %Equal.sym(Nat, FS.prime(one), X.bvalo(one, pl()), Equal.sym(Nat, X.bvalo(one, pl()), FS.prime(one), p_is(one, h1))) : {Nat.is_lt(X.bvalo(one, dl()), _) == True{} : Bool}
  X.lt_o(one, h1, dl(), pl(), dcl(), {==})

# ---- I = sqrt(-1) ----

# I^2 + 1 == 0 (mod p)
def i_sq(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.mod(Nat.add(Nat.mul(X.bvalo(one, il()), X.bvalo(one, il())), 1n), FS.prime(one)) == 0n : Nat}:
  %Equal.sym(Nat, Nat.mul(X.bvalo(one, il()), X.bvalo(one, il())), X.bvalo(one, B.bmul(il(), il())), Equal.sym(Nat, X.bvalo(one, B.bmul(il(), il())), Nat.mul(X.bvalo(one, il()), X.bvalo(one, il())), X.mul_o(one, h1, il(), il()))) : {Nat.mod(Nat.add(_, 1n), FS.prime(one)) == 0n : Nat}
  %Equal.sym(Nat, 1n, X.bvalo(one, B.B1{B.BZ{}}), Equal.sym(Nat, X.bvalo(one, B.B1{B.BZ{}}), 1n, X.one_o(one, h1))) : {Nat.mod(Nat.add(X.bvalo(one, B.bmul(il(), il())), _), FS.prime(one)) == 0n : Nat}
  %Equal.sym(Nat, Nat.add(X.bvalo(one, B.bmul(il(), il())), X.bvalo(one, B.B1{B.BZ{}})), X.bvalo(one, B.badd(B.bmul(il(), il()), B.B1{B.BZ{}})), Equal.sym(Nat, X.bvalo(one, B.badd(B.bmul(il(), il()), B.B1{B.BZ{}})), Nat.add(X.bvalo(one, B.bmul(il(), il())), X.bvalo(one, B.B1{B.BZ{}})), X.add_o(one, h1, B.bmul(il(), il()), B.B1{B.BZ{}}))) : {Nat.mod(_, FS.prime(one)) == 0n : Nat}
  pmod0(one, h1, B.badd(B.bmul(il(), il()), B.B1{B.BZ{}}), ikl(), {==})

def i_lt(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.is_lt(X.bvalo(one, il()), FS.prime(one)) == True{} : Bool}:
  %Equal.sym(Nat, FS.prime(one), X.bvalo(one, pl()), Equal.sym(Nat, X.bvalo(one, pl()), FS.prime(one), p_is(one, h1))) : {Nat.is_lt(X.bvalo(one, il()), _) == True{} : Bool}
  X.lt_o(one, h1, il(), pl(), icl(), {==})
