def v_t(+mp: Nat, +d: Nat, +x: Nat, +y: Nat, +z: Nat, +t: Nat, +h: GE.Valid(1n+mp, d, ED.EPt{x, y, z, t})) -> {FS.fmul(1n+mp, t, z) == FS.fmul(1n+mp, x, y) : Nat}:
