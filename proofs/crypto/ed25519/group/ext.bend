# the affine point of a valid point is on the curve
def aff_on(+mp: Nat, +d: Nat, a: ED.EPt, +h: GE.Valid(1n+mp, d, a)) -> G.OnCurve(1n+mp, d, GE.affine(1n+mp, a)):
