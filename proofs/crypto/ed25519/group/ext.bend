  %Equal.sym(Nat, qd(mp, IEA.ax(mp, x1, y1, z1, t1, x2, y2, z2, t2, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x2, z2), qd(mp, y2, z2)), IEA.az(mp, x1, y1, z1, t1, x2, y2, z2, t2, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x2, z2), qd(mp, y2, z2))), G.add_x(1n+mp, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x2, z2), qd(mp, y2, z2)), ac_x(mp, d, hc, x1, y1, z1, t1, x2, y2, z2, t2, h1, h2)) : {G.lhs(1n+mp, G.add_x(1n+mp, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x2, z2), qd(mp, y2, z2)), qd(mp, IEA.ay(mp, x1, y1, z1, t1, x2, y2, z2, t2, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x2, z2), qd(mp, y2, z2)), IEA.az(mp, x1, y1, z1, t1, x2, y2, z2, t2, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x2, z2), qd(mp, y2, z2)))) == G.rhs(1n+mp, d, _, qd(mp, IEA.ay(mp, x1, y1, z1, t1, x2, y2, z2, t2, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x2, z2), qd(mp, y2, z2)), IEA.az(mp, x1, y1, z1, t1, x2, y2, z2, t2, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x2, z2), qd(mp, y2, z2)))) : Nat}
  %Equal.sym(Nat, qd(mp, IEA.ay(mp, x1, y1, z1, t1, x2, y2, z2, t2, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x2, z2), qd(mp, y2, z2)), IEA.az(mp, x1, y1, z1, t1, x2, y2, z2, t2, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x2, z2), qd(mp, y2, z2))), G.add_y(1n+mp, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x2, z2), qd(mp, y2, z2)), ac_y(mp, d, hc, x1, y1, z1, t1, x2, y2, z2, t2, h1, h2)) : {G.lhs(1n+mp, G.add_x(1n+mp, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x2, z2), qd(mp, y2, z2)), _) == G.rhs(1n+mp, d, G.add_x(1n+mp, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x2, z2), qd(mp, y2, z2)), qd(mp, IEA.ay(mp, x1, y1, z1, t1, x2, y2, z2, t2, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x2, z2), qd(mp, y2, z2)), IEA.az(mp, x1, y1, z1, t1, x2, y2, z2, t2, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x2, z2), qd(mp, y2, z2)))) : Nat}
  %Equal.sym(Nat, qd(mp, IEA.ay(mp, x1, y1, z1, t1, x2, y2, z2, t2, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x2, z2), qd(mp, y2, z2)), IEA.az(mp, x1, y1, z1, t1, x2, y2, z2, t2, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x2, z2), qd(mp, y2, z2))), G.add_y(1n+mp, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x2, z2), qd(mp, y2, z2)), ac_y(mp, d, hc, x1, y1, z1, t1, x2, y2, z2, t2, h1, h2)) : {G.lhs(1n+mp, G.add_x(1n+mp, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x2, z2), qd(mp, y2, z2)), G.add_y(1n+mp, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x2, z2), qd(mp, y2, z2))) == G.rhs(1n+mp, d, G.add_x(1n+mp, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x2, z2), qd(mp, y2, z2)), _) : Nat}
  GL.add_on(mp, d, hc, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x2, z2), qd(mp, y2, z2), v_e(mp, d, x1, y1, z1, t1, h1), v_e(mp, d, x2, y2, z2, t2, h2))

# ---- addition, on points ----

# the affine point of the sum is the sum of the affine points
def add_aff(+mp: Nat, +d: Nat, +hc: G.Curve(mp, d), a: ED.EPt, b: ED.EPt, +ha: GE.Valid(1n+mp, d, a), +hb: GE.Valid(1n+mp, d, b)) -> {GE.affine(1n+mp, ED.add(1n+mp, d, a, b)) == G.aadd(1n+mp, d, GE.affine(1n+mp, a), GE.affine(1n+mp, b)) : G.APt}:
  match a b:
    case ED.EPt{+x1, +y1, +z1, +t1} ED.EPt{+x2, +y2, +z2, +t2}:
      GP.apt_eq(qd(mp, IEA.ax(mp, x1, y1, z1, t1, x2, y2, z2, t2, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x2, z2), qd(mp, y2, z2)), IEA.az(mp, x1, y1, z1, t1, x2, y2, z2, t2, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x2, z2), qd(mp, y2, z2))),
        qd(mp, IEA.ay(mp, x1, y1, z1, t1, x2, y2, z2, t2, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x2, z2), qd(mp, y2, z2)), IEA.az(mp, x1, y1, z1, t1, x2, y2, z2, t2, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x2, z2), qd(mp, y2, z2))),
        G.add_x(1n+mp, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x2, z2), qd(mp, y2, z2)), G.add_y(1n+mp, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x2, z2), qd(mp, y2, z2)),
        ac_x(mp, d, hc, x1, y1, z1, t1, x2, y2, z2, t2, ha, hb), ac_y(mp, d, hc, x1, y1, z1, t1, x2, y2, z2, t2, ha, hb))

# the sum of two valid points is valid
def add_valid(+mp: Nat, +d: Nat, +hc: G.Curve(mp, d), a: ED.EPt, b: ED.EPt, +ha: GE.Valid(1n+mp, d, a), +hb: GE.Valid(1n+mp, d, b)) -> GE.Valid(1n+mp, d, ED.add(1n+mp, d, a, b)):
  match a b:
    case ED.EPt{+x1, +y1, +z1, +t1} ED.EPt{+x2, +y2, +z2, +t2}:
      +u1 = qd(mp, x1, z1)
      +v1 = qd(mp, y1, z1)
      +u2 = qd(mp, x2, z2)
      +v2 = qd(mp, y2, z2)
      v_in(mp, d, IEA.ax(mp, x1, y1, z1, t1, x2, y2, z2, t2, d, u1, v1, u2, v2), IEA.ay(mp, x1, y1, z1, t1, x2, y2, z2, t2, d, u1, v1, u2, v2), IEA.az(mp, x1, y1, z1, t1, x2, y2, z2, t2, d, u1, v1, u2, v2), IEA.at(mp, x1, y1, z1, t1, x2, y2, z2, t2, d, u1, v1, u2, v2),
        ac_nz(mp, d, hc, x1, y1, z1, t1, x2, y2, z2, t2, ha, hb), ac_e(mp, d, hc, x1, y1, z1, t1, x2, y2, z2, t2, ha, hb), ac_t(mp, x1, y1, z1, t1, x2, y2, z2, t2, d, u1, v1, u2, v2))

# ---- doubling, on coordinates (T is not read) ----

def dc_nz(+mp: Nat, +d: Nat, +hc: G.Curve(mp, d), +x1: Nat, +y1: Nat, +z1: Nat, +hz: F.NZ(mp, z1), +he: GL.Eq(mp, d, qd(mp, x1, z1), qd(mp, y1, z1))) -> F.NZ(mp, IED.dbz(mp, x1, y1, z1, d, FS.finv(1n+mp, d), qd(mp, x1, z1), qd(mp, y1, z1))):
  +hp = FQ.cv_prime(mp, d, hc)
  +e = FS.finv(1n+mp, d)
  +u = qd(mp, x1, z1)
  +v = qd(mp, y1, z1)
  +z2 = FS.fmul(1n+mp, z1, z1)
  +hz2 = F.nz_mmul(mp, hp, z1, z1, hz, hz)
  +hr = F.nz_mmul(mp, hp, FS.fmul(1n+mp, z2, z2), FS.fmul(1n+mp, G.dx(1n+mp, d, u, v, u, v), G.dy(1n+mp, d, u, v, u, v)), F.nz_mmul(mp, hp, z2, z2, hz2, hz2), GL.nz_xy(mp, d, hc, u, v, u, v, he, he))
  nz_neg(mp, IED.dbz(mp, x1, y1, z1, d, e, u, v), nz_cong(mp, FS.fsub(1n+mp, 0n, IED.dbz(mp, x1, y1, z1, d, e, u, v)), FS.fmul(1n+mp, FS.fmul(1n+mp, z2, z2), FS.fmul(1n+mp, G.dx(1n+mp, d, u, v, u, v), G.dy(1n+mp, d, u, v, u, v))),
    IED.dbl_z(mp, x1, y1, z1, d, e, u, v, rx(mp, hp, x1, z1, hz), rx(mp, hp, y1, z1, hz), GL.crule(mp, d, hc, u, v, he), GL.dinv(mp, d, hc)), hr))

def dc_x(+mp: Nat, +d: Nat, +hc: G.Curve(mp, d), +x1: Nat, +y1: Nat, +z1: Nat, +hz: F.NZ(mp, z1), +he: GL.Eq(mp, d, qd(mp, x1, z1), qd(mp, y1, z1))) -> {qd(mp, IED.dbx(mp, x1, y1, z1, d, FS.finv(1n+mp, d), qd(mp, x1, z1), qd(mp, y1, z1)), IED.dbz(mp, x1, y1, z1, d, FS.finv(1n+mp, d), qd(mp, x1, z1), qd(mp, y1, z1))) == G.add_x(1n+mp, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x1, z1), qd(mp, y1, z1)) : Nat}:
  +hp = FQ.cv_prime(mp, d, hc)
  +e = FS.finv(1n+mp, d)
  +u = qd(mp, x1, z1)
  +v = qd(mp, y1, z1)
  FQ.frac_eq(mp, hp, IED.dbx(mp, x1, y1, z1, d, e, u, v), IED.dbz(mp, x1, y1, z1, d, e, u, v), G.nx(1n+mp, u, v, u, v), G.dx(1n+mp, d, u, v, u, v), dc_nz(mp, d, hc, x1, y1, z1, hz, he), GL.compl_x(mp, d, hc, u, v, u, v, he, he),
    IED.dbl_x(mp, x1, y1, z1, d, e, u, v, rx(mp, hp, x1, z1, hz), rx(mp, hp, y1, z1, hz), GL.crule(mp, d, hc, u, v, he), GL.dinv(mp, d, hc)))

def dc_y(+mp: Nat, +d: Nat, +hc: G.Curve(mp, d), +x1: Nat, +y1: Nat, +z1: Nat, +hz: F.NZ(mp, z1), +he: GL.Eq(mp, d, qd(mp, x1, z1), qd(mp, y1, z1))) -> {qd(mp, IED.dby(mp, x1, y1, z1, d, FS.finv(1n+mp, d), qd(mp, x1, z1), qd(mp, y1, z1)), IED.dbz(mp, x1, y1, z1, d, FS.finv(1n+mp, d), qd(mp, x1, z1), qd(mp, y1, z1))) == G.add_y(1n+mp, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x1, z1), qd(mp, y1, z1)) : Nat}:
  +hp = FQ.cv_prime(mp, d, hc)
  +e = FS.finv(1n+mp, d)
  +u = qd(mp, x1, z1)
  +v = qd(mp, y1, z1)
  FQ.frac_eq(mp, hp, IED.dby(mp, x1, y1, z1, d, e, u, v), IED.dbz(mp, x1, y1, z1, d, e, u, v), G.ny(1n+mp, u, v, u, v), G.dy(1n+mp, d, u, v, u, v), dc_nz(mp, d, hc, x1, y1, z1, hz, he), GL.compl_y(mp, d, hc, u, v, u, v, he, he),
    IED.dbl_y(mp, x1, y1, z1, d, e, u, v, rx(mp, hp, x1, z1, hz), rx(mp, hp, y1, z1, hz), GL.crule(mp, d, hc, u, v, he), GL.dinv(mp, d, hc)))

def dc_t(+mp: Nat, +x1: Nat, +y1: Nat, +z1: Nat, +d: Nat, +e: Nat, +u: Nat, +v: Nat) -> {FS.fmul(1n+mp, IED.dbt(mp, x1, y1, z1, d, e, u, v), IED.dbz(mp, x1, y1, z1, d, e, u, v)) == FS.fmul(1n+mp, IED.dbx(mp, x1, y1, z1, d, e, u, v), IED.dby(mp, x1, y1, z1, d, e, u, v)) : Nat}:
  FQ.red_eq(mp, FS.fmul(1n+mp, IED.dbt(mp, x1, y1, z1, d, e, u, v), IED.dbz(mp, x1, y1, z1, d, e, u, v)), FS.fmul(1n+mp, IED.dbx(mp, x1, y1, z1, d, e, u, v), IED.dby(mp, x1, y1, z1, d, e, u, v)),
    FQ.fmul_red(mp, IED.dbt(mp, x1, y1, z1, d, e, u, v), IED.dbz(mp, x1, y1, z1, d, e, u, v)), FQ.fmul_red(mp, IED.dbx(mp, x1, y1, z1, d, e, u, v), IED.dby(mp, x1, y1, z1, d, e, u, v)), IED.dbl_t(mp, x1, y1, z1, d, e, u, v))

def dc_e(+mp: Nat, +d: Nat, +hc: G.Curve(mp, d), +x1: Nat, +y1: Nat, +z1: Nat, +hz: F.NZ(mp, z1), +he: GL.Eq(mp, d, qd(mp, x1, z1), qd(mp, y1, z1))) -> GL.Eq(mp, d, qd(mp, IED.dbx(mp, x1, y1, z1, d, FS.finv(1n+mp, d), qd(mp, x1, z1), qd(mp, y1, z1)), IED.dbz(mp, x1, y1, z1, d, FS.finv(1n+mp, d), qd(mp, x1, z1), qd(mp, y1, z1))), qd(mp, IED.dby(mp, x1, y1, z1, d, FS.finv(1n+mp, d), qd(mp, x1, z1), qd(mp, y1, z1)), IED.dbz(mp, x1, y1, z1, d, FS.finv(1n+mp, d), qd(mp, x1, z1), qd(mp, y1, z1)))):
  %Equal.sym(Nat, qd(mp, IED.dbx(mp, x1, y1, z1, d, FS.finv(1n+mp, d), qd(mp, x1, z1), qd(mp, y1, z1)), IED.dbz(mp, x1, y1, z1, d, FS.finv(1n+mp, d), qd(mp, x1, z1), qd(mp, y1, z1))), G.add_x(1n+mp, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x1, z1), qd(mp, y1, z1)), dc_x(mp, d, hc, x1, y1, z1, hz, he)) : {G.lhs(1n+mp, _, qd(mp, IED.dby(mp, x1, y1, z1, d, FS.finv(1n+mp, d), qd(mp, x1, z1), qd(mp, y1, z1)), IED.dbz(mp, x1, y1, z1, d, FS.finv(1n+mp, d), qd(mp, x1, z1), qd(mp, y1, z1)))) == G.rhs(1n+mp, d, qd(mp, IED.dbx(mp, x1, y1, z1, d, FS.finv(1n+mp, d), qd(mp, x1, z1), qd(mp, y1, z1)), IED.dbz(mp, x1, y1, z1, d, FS.finv(1n+mp, d), qd(mp, x1, z1), qd(mp, y1, z1))), qd(mp, IED.dby(mp, x1, y1, z1, d, FS.finv(1n+mp, d), qd(mp, x1, z1), qd(mp, y1, z1)), IED.dbz(mp, x1, y1, z1, d, FS.finv(1n+mp, d), qd(mp, x1, z1), qd(mp, y1, z1)))) : Nat}
  %Equal.sym(Nat, qd(mp, IED.dbx(mp, x1, y1, z1, d, FS.finv(1n+mp, d), qd(mp, x1, z1), qd(mp, y1, z1)), IED.dbz(mp, x1, y1, z1, d, FS.finv(1n+mp, d), qd(mp, x1, z1), qd(mp, y1, z1))), G.add_x(1n+mp, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x1, z1), qd(mp, y1, z1)), dc_x(mp, d, hc, x1, y1, z1, hz, he)) : {G.lhs(1n+mp, G.add_x(1n+mp, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x1, z1), qd(mp, y1, z1)), qd(mp, IED.dby(mp, x1, y1, z1, d, FS.finv(1n+mp, d), qd(mp, x1, z1), qd(mp, y1, z1)), IED.dbz(mp, x1, y1, z1, d, FS.finv(1n+mp, d), qd(mp, x1, z1), qd(mp, y1, z1)))) == G.rhs(1n+mp, d, _, qd(mp, IED.dby(mp, x1, y1, z1, d, FS.finv(1n+mp, d), qd(mp, x1, z1), qd(mp, y1, z1)), IED.dbz(mp, x1, y1, z1, d, FS.finv(1n+mp, d), qd(mp, x1, z1), qd(mp, y1, z1)))) : Nat}
  %Equal.sym(Nat, qd(mp, IED.dby(mp, x1, y1, z1, d, FS.finv(1n+mp, d), qd(mp, x1, z1), qd(mp, y1, z1)), IED.dbz(mp, x1, y1, z1, d, FS.finv(1n+mp, d), qd(mp, x1, z1), qd(mp, y1, z1))), G.add_y(1n+mp, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x1, z1), qd(mp, y1, z1)), dc_y(mp, d, hc, x1, y1, z1, hz, he)) : {G.lhs(1n+mp, G.add_x(1n+mp, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x1, z1), qd(mp, y1, z1)), _) == G.rhs(1n+mp, d, G.add_x(1n+mp, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x1, z1), qd(mp, y1, z1)), qd(mp, IED.dby(mp, x1, y1, z1, d, FS.finv(1n+mp, d), qd(mp, x1, z1), qd(mp, y1, z1)), IED.dbz(mp, x1, y1, z1, d, FS.finv(1n+mp, d), qd(mp, x1, z1), qd(mp, y1, z1)))) : Nat}
  %Equal.sym(Nat, qd(mp, IED.dby(mp, x1, y1, z1, d, FS.finv(1n+mp, d), qd(mp, x1, z1), qd(mp, y1, z1)), IED.dbz(mp, x1, y1, z1, d, FS.finv(1n+mp, d), qd(mp, x1, z1), qd(mp, y1, z1))), G.add_y(1n+mp, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x1, z1), qd(mp, y1, z1)), dc_y(mp, d, hc, x1, y1, z1, hz, he)) : {G.lhs(1n+mp, G.add_x(1n+mp, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x1, z1), qd(mp, y1, z1)), G.add_y(1n+mp, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x1, z1), qd(mp, y1, z1))) == G.rhs(1n+mp, d, G.add_x(1n+mp, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x1, z1), qd(mp, y1, z1)), _) : Nat}
  GL.add_on(mp, d, hc, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x1, z1), qd(mp, y1, z1), he, he)

# ---- doubling, on points ----

# the affine point of the double is the affine point added to itself
def dbl_aff(+mp: Nat, +d: Nat, +hc: G.Curve(mp, d), a: ED.EPt, +ha: GE.Valid(1n+mp, d, a)) -> {GE.affine(1n+mp, ED.double(1n+mp, a)) == G.aadd(1n+mp, d, GE.affine(1n+mp, a), GE.affine(1n+mp, a)) : G.APt}:
  match a:
    case ED.EPt{+x1, +y1, +z1, +t1}:
      +hz = v_z(mp, d, x1, y1, z1, t1, ha)
      +he = v_e(mp, d, x1, y1, z1, t1, ha)
      GP.apt_eq(qd(mp, IED.dbx(mp, x1, y1, z1, d, FS.finv(1n+mp, d), qd(mp, x1, z1), qd(mp, y1, z1)), IED.dbz(mp, x1, y1, z1, d, FS.finv(1n+mp, d), qd(mp, x1, z1), qd(mp, y1, z1))),
        qd(mp, IED.dby(mp, x1, y1, z1, d, FS.finv(1n+mp, d), qd(mp, x1, z1), qd(mp, y1, z1)), IED.dbz(mp, x1, y1, z1, d, FS.finv(1n+mp, d), qd(mp, x1, z1), qd(mp, y1, z1))),
        G.add_x(1n+mp, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x1, z1), qd(mp, y1, z1)), G.add_y(1n+mp, d, qd(mp, x1, z1), qd(mp, y1, z1), qd(mp, x1, z1), qd(mp, y1, z1)),
        dc_x(mp, d, hc, x1, y1, z1, hz, he), dc_y(mp, d, hc, x1, y1, z1, hz, he))

# the double of a valid point is valid
def dbl_valid(+mp: Nat, +d: Nat, +hc: G.Curve(mp, d), a: ED.EPt, +ha: GE.Valid(1n+mp, d, a)) -> GE.Valid(1n+mp, d, ED.double(1n+mp, a)):
  match a:
    case ED.EPt{+x1, +y1, +z1, +t1}:
      +hz = v_z(mp, d, x1, y1, z1, t1, ha)
      +he = v_e(mp, d, x1, y1, z1, t1, ha)
      +e = FS.finv(1n+mp, d)
      +u = qd(mp, x1, z1)
      +v = qd(mp, y1, z1)
      v_in(mp, d, IED.dbx(mp, x1, y1, z1, d, e, u, v), IED.dby(mp, x1, y1, z1, d, e, u, v), IED.dbz(mp, x1, y1, z1, d, e, u, v), IED.dbt(mp, x1, y1, z1, d, e, u, v),
        dc_nz(mp, d, hc, x1, y1, z1, hz, he), dc_e(mp, d, hc, x1, y1, z1, hz, he), dc_t(mp, x1, y1, z1, d, e, u, v))

# ---- the identity (0 : 1 : 1 : 0) ----

def one_inv(+mp: Nat, +hp: PM.Prime(1n+mp)) -> {qd(mp, 1n, 1n) == 1n : Nat}:
  FQ.frac_val(mp, hp, 1n, 1n, 1n, nz_one(mp, hp), FQ.one_lt(mp, hp), Equal.sym(Nat, Nat.mod(Nat.mod(1n, 1n+mp), 1n+mp), Nat.mod(1n, 1n+mp), NR.mod_mod(mp, 1n)))

def id_aff(+mp: Nat, +d: Nat, +hc: G.Curve(mp, d)) -> {GE.affine(1n+mp, ED.identity()) == G.azero() : G.APt}:
  GP.apt_eq(qd(mp, 0n, 1n), qd(mp, 1n, 1n), 0n, 1n, {==}, one_inv(mp, FQ.cv_prime(mp, d, hc)))

def id_e(+mp: Nat, +d: Nat, +hc: G.Curve(mp, d)) -> GL.Eq(mp, d, qd(mp, 0n, 1n), qd(mp, 1n, 1n)):
  %Equal.sym(Nat, qd(mp, 1n, 1n), 1n, one_inv(mp, FQ.cv_prime(mp, d, hc))) : {G.lhs(1n+mp, 0n, _) == G.rhs(1n+mp, d, 0n, qd(mp, 1n, 1n)) : Nat}
  %Equal.sym(Nat, qd(mp, 1n, 1n), 1n, one_inv(mp, FQ.cv_prime(mp, d, hc))) : {G.lhs(1n+mp, 0n, 1n) == G.rhs(1n+mp, d, 0n, _) : Nat}
  GL.zero_eq(mp, d)

def id_valid(+mp: Nat, +d: Nat, +hc: G.Curve(mp, d)) -> GE.Valid(1n+mp, d, ED.identity()):
  v_in(mp, d, 0n, 1n, 1n, 0n, nz_one(mp, FQ.cv_prime(mp, d, hc)), id_e(mp, d, hc), {==})
