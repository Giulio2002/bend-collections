# RFC 8032's point addition and doubling in extended coordinates
# (spec/crypto/ed25519.bend: ED.add, ED.double) are the affine addition of
# the curve: for valid points (Z != 0, (X / Z, Y / Z) on the curve,
# T Z == X Y) the result is valid and its affine point is the sum of the
# affine points. No exceptional case: the law is complete.

# a / z
def qd(+mp: Nat, +a: Nat, +z: Nat) -> Nat:
  FS.fmul(1n+mp, a, FS.finv(1n+mp, z))

def vb2(+mp: Nat, +d: Nat, +x: Nat, +y: Nat, +z: Nat) -> Bool:
  Nat.is_eq(G.lhs(1n+mp, qd(mp, x, z), qd(mp, y, z)), G.rhs(1n+mp, d, qd(mp, x, z), qd(mp, y, z)))

def vb3(+mp: Nat, +x: Nat, +y: Nat, +z: Nat, +t: Nat) -> Bool:
  Nat.is_eq(FS.fmul(1n+mp, t, z), FS.fmul(1n+mp, x, y))

# ---- a valid point ----

