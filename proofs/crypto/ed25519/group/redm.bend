# Reduction of a polynomial (proofs/crypto/secp256k1/group/poly.bend) by a
# rule "monomial -> polynomial": every term c x^e in which the monomial
# x^u fits k >= 1 times becomes c x^(e - k u) f^k. It generalizes P.red
# (whose left side is a power of one variable) to left sides such as
# x^2 y^2 (the twisted Edwards curve equation d x^2 y^2 = y^2 - x^2 - 1) and
# d e (e the inverse of d). redm keeps the value modulo m at every point env
# where x^u == f (mod m): redm_v. The number of fits is computed by efit and
# then checked (e - k u + k u == e), so nothing has to be proved about efit.

# k u
def escale(k: Nat, +u: List<&2, Nat>) -> List<&2, Nat>:
  match k:
    case 0n:
      Nil{}
    case 1n+j:
      P.eadd(u, escale(j, u))

def nmin(a: Nat, b: Nat) -> Nat:
  match a b:
    case 0n _:
      0n
    case 1n+x 0n:
      0n
    case 1n+x 1n+y:
      1n+nmin(x, y)

def ffin(has: Bool, acc: Nat) -> Nat:
  match has:
    case True{}:
      acc
    case False{}:
      0n

def facc(y: Nat, has: Bool, +x: Nat, +acc: Nat) -> Nat:
  match y has:
    case 0n _:
      acc
    case 1n+yp True{}:
      nmin(acc, Nat.div(x, 1n+yp))
    case 1n+yp False{}:
      Nat.div(x, 1n+yp)

def fhas(y: Nat, +has: Bool) -> Bool:
  match y:
    case 0n:
      has
    case 1n+yp:
      True{}

# the least e_i / u_i over the positions with u_i > 0 (0 when there is none)
def efit(e: List<&2, Nat>, u: List<&2, Nat>, +acc: Nat, +has: Bool) -> Nat:
  match e u:
    case Nil{} Nil{}:
      ffin(has, acc)
    case Nil{} y <> ys:
      0n
    case x <> xs Nil{}:
      ffin(has, acc)
    case +x <> xs +y <> ys:
      efit(xs, ys, facc(y, has, x, acc), fhas(y, has))

def redm_c(o: Cmp, +c: P.Zc, +e: List<&2, Nat>, +e2: List<&2, Nat>, +f: List<&2, P.Tm>, +n: Nat, +k: Nat) -> List<&2, P.Tm>:
