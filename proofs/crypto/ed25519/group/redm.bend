# one reduction step back: a polynomial whose reduction is zero is zero
def sm_redm(+mp: Nat, +n: Nat, +u: List<&2, Nat>, +f: List<&2, P.Tm>, +a: List<&2, P.Tm>, +env: List<&2, Nat>, +h: Z.Rel(mp, E.mon(u, env), E.eP(f, env), E.eN(f, env)), +hz: Z.SameM(mp, 0n, 0n, E.eP(redm(n, u, f, a), env), E.eN(redm(n, u, f, a), env))) -> Z.SameM(mp, 0n, 0n, E.eP(a, env), E.eN(a, env)):
  Z.sameM_trans(mp, 0n, 0n, E.eP(redm(n, u, f, a), env), E.eN(redm(n, u, f, a), env), E.eP(a, env), E.eN(a, env), hz, redm_v(mp, n, u, f, a, env, h))
