    case LT{}:
      [P.Tm{c, e}]
    case GT{}:
      [P.Tm{c, e}]

def redm_k(+n: Nat, +u: List<&2, Nat>, +f: List<&2, P.Tm>, +c: P.Zc, +e: List<&2, Nat>, k: Nat) -> List<&2, P.Tm>:
