def um_is(+one: Nat, +h1: {one == 1n : Nat}) -> {FS.fsub(1n+X.bvalo(one, PF.p1l()), 1n, X.bvalo(one, PF.byl())) == X.bvalo(one, PF.bywl()) : Nat}:
  %Equal.sym(Nat, Nat.mod(X.bvalo(one, PF.byl()), 1n+X.bvalo(one, PF.p1l())), X.bvalo(one, PF.byl()), FL.small_nz(X.bvalo(one, PF.p1l()), X.bvalo(one, PF.byl()), CP.lt_p(one, h1, PF.byl(), PF.bycl(), h_by()))) : {Nat.mod(Nat.sub(Nat.add(1n, 1n+X.bvalo(one, PF.p1l())), _), 1n+X.bvalo(one, PF.p1l())) == X.bvalo(one, PF.bywl()) : Nat}
  %Equal.sym(Nat, Nat.add(1n, 1n+X.bvalo(one, PF.p1l())), Nat.add(X.bvalo(one, PF.byl()), X.bvalo(one, PF.bywl())), w_sum(one, h1)) : {Nat.mod(Nat.sub(_, X.bvalo(one, PF.byl())), 1n+X.bvalo(one, PF.p1l())) == X.bvalo(one, PF.bywl()) : Nat}
  %Equal.sym(Nat, Nat.sub(Nat.add(X.bvalo(one, PF.byl()), X.bvalo(one, PF.bywl())), X.bvalo(one, PF.byl())), X.bvalo(one, PF.bywl()), N.add_sub_cancel(X.bvalo(one, PF.byl()), X.bvalo(one, PF.bywl()))) : {Nat.mod(_, 1n+X.bvalo(one, PF.p1l())) == X.bvalo(one, PF.bywl()) : Nat}
  FL.small_nz(X.bvalo(one, PF.p1l()), X.bvalo(one, PF.bywl()), CP.lt_p(one, h1, PF.bywl(), PF.bym2l(), h_w()))

def um_nz_eq(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.is_eq(Nat.mod(FS.fsub(1n+X.bvalo(one, PF.p1l()), 1n, X.bvalo(one, PF.byl())), 1n+X.bvalo(one, PF.p1l())), 0n) == False{} : Bool}:
  %Equal.sym(Nat, FS.fsub(1n+X.bvalo(one, PF.p1l()), 1n, X.bvalo(one, PF.byl())), X.bvalo(one, PF.bywl()), um_is(one, h1)) : {Nat.is_eq(Nat.mod(_, 1n+X.bvalo(one, PF.p1l())), 0n) == False{} : Bool}
  CP.nz_eq(one, h1, PF.bywl(), PF.bywm1l(), PF.bym2l(), h_w1(), h_w())

# 1 - by is not 0 modulo p
def um_nz(+one: Nat, +h1: {one == 1n : Nat}) -> F.NZ(X.bvalo(one, PF.p1l()), FS.fsub(1n+X.bvalo(one, PF.p1l()), 1n, X.bvalo(one, PF.byl()))):
  um_nz_eq(one, h1)

def up_nz_eq(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.is_eq(Nat.mod(FS.fadd(1n+X.bvalo(one, PF.p1l()), 1n, X.bvalo(one, PF.byl())), 1n+X.bvalo(one, PF.p1l())), 0n) == False{} : Bool}:
  %Equal.sym(Nat, FS.fadd(1n+X.bvalo(one, PF.p1l()), 1n, X.bvalo(one, PF.byl())), X.bvalo(one, B.binc(PF.byl())), up_is(one, h1)) : {Nat.is_eq(Nat.mod(_, 1n+X.bvalo(one, PF.p1l())), 0n) == False{} : Bool}
  CP.nz_eq(one, h1, B.binc(PF.byl()), PF.byl(), PF.by1cl(), h_bb(), h_by1())

# 1 + by is not 0 modulo p
def up_nz(+one: Nat, +h1: {one == 1n : Nat}) -> F.NZ(X.bvalo(one, PF.p1l()), FS.fadd(1n+X.bvalo(one, PF.p1l()), 1n, X.bvalo(one, PF.byl()))):
  up_nz_eq(one, h1)

def lt9(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.is_lt(9n, 1n+X.bvalo(one, PF.p1l())) == True{} : Bool}:
  %Equal.sym(Nat, 9n, X.bvalo(one, PF.l9()), Equal.sym(Nat, X.bvalo(one, PF.l9()), 9n, X.lit_o(one, h1, PF.l9(), 9n, v9()))) : {Nat.is_lt(_, 1n+X.bvalo(one, PF.p1l())) == True{} : Bool}
  CP.lt_p(one, h1, PF.l9(), PF.p10l(), h_10())

# 1 + by == 9 (1 - by) (mod p)
def u_frac(+one: Nat, +h1: {one == 1n : Nat}) -> {Nat.mod(FS.fadd(1n+X.bvalo(one, PF.p1l()), 1n, X.bvalo(one, PF.byl())), 1n+X.bvalo(one, PF.p1l())) == Nat.mod(FS.fmul(1n+X.bvalo(one, PF.p1l()), 9n, FS.fsub(1n+X.bvalo(one, PF.p1l()), 1n, X.bvalo(one, PF.byl()))), 1n+X.bvalo(one, PF.p1l())) : Nat}:
  %Equal.sym(Nat, FS.fadd(1n+X.bvalo(one, PF.p1l()), 1n, X.bvalo(one, PF.byl())), X.bvalo(one, B.binc(PF.byl())), up_is(one, h1)) : {Nat.mod(_, 1n+X.bvalo(one, PF.p1l())) == Nat.mod(FS.fmul(1n+X.bvalo(one, PF.p1l()), 9n, FS.fsub(1n+X.bvalo(one, PF.p1l()), 1n, X.bvalo(one, PF.byl()))), 1n+X.bvalo(one, PF.p1l())) : Nat}
  %Equal.sym(Nat, FS.fsub(1n+X.bvalo(one, PF.p1l()), 1n, X.bvalo(one, PF.byl())), X.bvalo(one, PF.bywl()), um_is(one, h1)) : {Nat.mod(X.bvalo(one, B.binc(PF.byl())), 1n+X.bvalo(one, PF.p1l())) == Nat.mod(FS.fmul(1n+X.bvalo(one, PF.p1l()), 9n, _), 1n+X.bvalo(one, PF.p1l())) : Nat}
  %Equal.sym(Nat, 9n, X.bvalo(one, PF.l9()), Equal.sym(Nat, X.bvalo(one, PF.l9()), 9n, X.lit_o(one, h1, PF.l9(), 9n, v9()))) : {Nat.mod(X.bvalo(one, B.binc(PF.byl())), 1n+X.bvalo(one, PF.p1l())) == Nat.mod(FS.fmul(1n+X.bvalo(one, PF.p1l()), _, X.bvalo(one, PF.bywl())), 1n+X.bvalo(one, PF.p1l())) : Nat}
  %Equal.sym(Nat, Nat.mod(FS.fmul(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.l9()), X.bvalo(one, PF.bywl())), 1n+X.bvalo(one, PF.p1l())), FS.fmul(1n+X.bvalo(one, PF.p1l()), X.bvalo(one, PF.l9()), X.bvalo(one, PF.bywl())), FQ.fmul_red(X.bvalo(one, PF.p1l()), X.bvalo(one, PF.l9()), X.bvalo(one, PF.bywl()))) : {Nat.mod(X.bvalo(one, B.binc(PF.byl())), 1n+X.bvalo(one, PF.p1l())) == _ : Nat}
  %Equal.sym(Nat, Nat.mod(X.bvalo(one, B.binc(PF.byl())), 1n+X.bvalo(one, PF.p1l())), X.bvalo(one, B.binc(PF.byl())), FL.small_nz(X.bvalo(one, PF.p1l()), X.bvalo(one, B.binc(PF.byl())), CP.lt_p(one, h1, B.binc(PF.byl()), PF.by1cl(), h_by1()))) : {_ == Nat.mod(Nat.mul(X.bvalo(one, PF.l9()), X.bvalo(one, PF.bywl())), 1n+X.bvalo(one, PF.p1l())) : Nat}
  %Equal.sym(Nat, Nat.mul(X.bvalo(one, PF.l9()), X.bvalo(one, PF.bywl())), X.bvalo(one, B.bmul(PF.l9(), PF.bywl())), Equal.sym(Nat, X.bvalo(one, B.bmul(PF.l9(), PF.bywl())), Nat.mul(X.bvalo(one, PF.l9()), X.bvalo(one, PF.bywl())), X.mul_o(one, h1, PF.l9(), PF.bywl()))) : {X.bvalo(one, B.binc(PF.byl())) == Nat.mod(_, 1n+X.bvalo(one, PF.p1l())) : Nat}
  %Equal.sym(Nat, Nat.mod(X.bvalo(one, B.bmul(PF.l9(), PF.bywl())), 1n+X.bvalo(one, PF.p1l())), X.bvalo(one, B.binc(PF.byl())), CP.mod_p(one, h1, B.bmul(PF.l9(), PF.bywl()), PF.b9kl(), B.binc(PF.byl()), PF.by1cl(), h_9(), h_by1())) : {X.bvalo(one, B.binc(PF.byl())) == _ : Nat}
  {==}

# the Montgomery u of the base point is 9
def nine_u(+one: Nat, +h1: {one == 1n : Nat}, +hp: PM.Prime(1n+X.bvalo(one, PF.p1l()))) -> {FS.fmul(1n+X.bvalo(one, PF.p1l()), FS.fadd(1n+X.bvalo(one, PF.p1l()), 1n, X.bvalo(one, PF.byl())), FS.finv(1n+X.bvalo(one, PF.p1l()), FS.fsub(1n+X.bvalo(one, PF.p1l()), 1n, X.bvalo(one, PF.byl())))) == 9n : Nat}:
  FQ.frac_val(X.bvalo(one, PF.p1l()), hp, FS.fadd(1n+X.bvalo(one, PF.p1l()), 1n, X.bvalo(one, PF.byl())), FS.fsub(1n+X.bvalo(one, PF.p1l()), 1n, X.bvalo(one, PF.byl())), 9n, um_nz(one, h1), lt9(one, h1), u_frac(one, h1))
