  %Equal.sym(Maybe<&2, ED.EPt>, ED.decode(1n+mp, d, VS2.enc(one, ar)), Some{ED.EPt{G.ax(ar), G.ay(ar), 1n, FS.fmul(1n+mp, G.ax(ar), G.ay(ar))}}, drt_a(one, h1, mp, d, hc, m, h58, hk, hp255, ar, har)) : {ED.check(one, 1n+mp, d, ss(one, 1n+lp, SHA.sha512_bytes(seed), msg, VS2.enc(one, ar), VS2.enc(one, aa)), VS2.enc(one, ar), VS2.enc(one, aa), msg, _, ED.decode(1n+mp, d, VS2.enc(one, aa))) == True{} : Bool}
  %Equal.sym(Maybe<&2, ED.EPt>, ED.decode(1n+mp, d, VS2.enc(one, aa)), Some{ED.EPt{G.ax(aa), G.ay(aa), 1n, FS.fmul(1n+mp, G.ax(aa), G.ay(aa))}}, drt_a(one, h1, mp, d, hc, m, h58, hk, hp255, aa, haa)) : {ED.check(one, 1n+mp, d, ss(one, 1n+lp, SHA.sha512_bytes(seed), msg, VS2.enc(one, ar), VS2.enc(one, aa)), VS2.enc(one, ar), VS2.enc(one, aa), msg, Some{ED.EPt{G.ax(ar), G.ay(ar), 1n, FS.fmul(1n+mp, G.ax(ar), G.ay(ar))}}, _) == True{} : Bool}
  VS2.check_eq(one, mp, d, hc, ED.base(1n+mp, d), DC.base_valid(mp, d, hc), lp, hlb, rs(one, h, msg), ED.hram(one, er, ea, msg), ED.secret(h),
    fit_l(one, h1, lp, hle, hl256, FS.value(SHA.sha512_bytes(ED.cat(ED.rest(32n, h), msg)))), hram_fit(one, h1, lp, hle, hl256, er, ea, msg), EB.secret_sha_fits(one, h1, seed), hfit,
    rr, pa, DC.some_valid(mp, d, hc, er, rr, dr), DC.some_valid(mp, d, hc, ea, pa, da),
    Equal.trans(G.APt, GE.affine(1n+mp, rr), ar, GE.affine(1n+mp, ED.mul(one, 1n+mp, d, rs(one, h, msg), ED.base(1n+mp, d))), aff_a(mp, d, hc, ar, har), hra),
    Equal.trans(G.APt, GE.affine(1n+mp, pa), aa, GE.affine(1n+mp, ED.mul(one, 1n+mp, d, ED.secret(h), ED.base(1n+mp, d))), aff_a(mp, d, hc, aa, haa), hsa))

# the signature of sign_body verifies under public_of, at the modulus 1 + mp
def sv_true(+one: Nat, +h1: {one == 1n : Nat}, +mp: Nat, +d: Nat, +hc: G.Curve(mp, d), +m: Nat, +h58: {Nat.div(Nat.sub(1n+mp, 5n), 8n) == m : Nat}, +hk: {Nat.div(mp, 2n) == Nat.add(Nat.add(1n, Nat.add(m, m)), Nat.add(1n, Nat.add(m, m))) : Nat}, +hp255: {Nat.is_le(1n+mp, C.shift(255n, one)) == True{} : Bool}, +lp: Nat, +hle: {ED.ell(one) == 1n+lp : Nat}, +hl256: {Nat.is_le(1n+lp, C.shift(256n, one)) == True{} : Bool}, +hlb: {G.nmul(1n+mp, d, 1n+lp, GE.affine(1n+mp, ED.base(1n+mp, d))) == G.azero() : G.APt}, +seed: List<&2, U32>, +msg: List<&2, U32>) -> {vf(one, mp, d, ED.ell(one), SHA.sha512_bytes(seed), msg, ED.encode(one, 1n+mp, ED.mul(one, 1n+mp, d, rs(one, SHA.sha512_bytes(seed), msg), ED.base(1n+mp, d))), ED.public_of(one, 1n+mp, d, SHA.sha512_bytes(seed))) == True{} : Bool}:
  +h = SHA.sha512_bytes(seed)
  +hbv = DC.base_valid(mp, d, hc)
  +pr = ED.mul(one, 1n+mp, d, rs(one, SHA.sha512_bytes(seed), msg), ED.base(1n+mp, d))
  +pa = ED.mul(one, 1n+mp, d, ED.secret(SHA.sha512_bytes(seed)), ED.base(1n+mp, d))
  +hrv = SM.mul_valid(one, mp, d, hc, rs(one, SHA.sha512_bytes(seed), msg), ED.base(1n+mp, d), hbv)
  +hav = SM.mul_valid(one, mp, d, hc, ED.secret(SHA.sha512_bytes(seed)), ED.base(1n+mp, d), hbv)
  %Equal.sym(Nat, ED.ell(one), 1n+lp, hle) : {vf(one, mp, d, _, SHA.sha512_bytes(seed), msg, ED.encode(one, 1n+mp, ED.mul(one, 1n+mp, d, rs(one, SHA.sha512_bytes(seed), msg), ED.base(1n+mp, d))), ED.public_of(one, 1n+mp, d, SHA.sha512_bytes(seed))) == True{} : Bool}
  %Equal.sym(List<&2, U32>, ED.encode(one, 1n+mp, pr), VS2.enc(one, GE.affine(1n+mp, pr)), VS2.encode_aff(one, 1n+mp, pr)) : {vf(one, mp, d, 1n+lp, SHA.sha512_bytes(seed), msg, _, ED.public_of(one, 1n+mp, d, SHA.sha512_bytes(seed))) == True{} : Bool}
  %Equal.sym(List<&2, U32>, ED.public_of(one, 1n+mp, d, h), VS2.enc(one, GE.affine(1n+mp, pa)), Equal.trans(List<&2, U32>, ED.public_of(one, 1n+mp, d, h), ED.encode(one, 1n+mp, pa), VS2.enc(one, GE.affine(1n+mp, pa)), VS2.public_of_eq(one, 1n+mp, d, h), VS2.encode_aff(one, 1n+mp, pa))) : {vf(one, mp, d, 1n+lp, SHA.sha512_bytes(seed), msg, VS2.enc(one, GE.affine(1n+mp, pr)), _) == True{} : Bool}
  vf_true(one, h1, mp, d, hc, m, h58, hk, hp255, lp, hle, hl256, hlb, seed, msg, GE.affine(1n+mp, pr), GE.affine(1n+mp, pa), EX.aff_on(mp, d, pr, hrv), EX.aff_on(mp, d, pa, hav), {==}, {==})

# ---- the encoding round trip ----

# decode(encode(a)) is (x : y : 1 : x y) for the affine point (x, y) of a valid a
def dec_enc(+one: Nat, +h1: {one == 1n : Nat}, +mp: Nat, +d: Nat, +hc: G.Curve(mp, d), +m: Nat, +h58: {Nat.div(Nat.sub(1n+mp, 5n), 8n) == m : Nat}, +hk: {Nat.div(mp, 2n) == Nat.add(Nat.add(1n, Nat.add(m, m)), Nat.add(1n, Nat.add(m, m))) : Nat}, +hp255: {Nat.is_le(1n+mp, C.shift(255n, one)) == True{} : Bool}, +a: ED.EPt, +ha: GE.Valid(1n+mp, d, a)) -> {ED.decode(1n+mp, d, ED.encode(one, 1n+mp, a)) == Some{ED.EPt{G.ax(GE.affine(1n+mp, a)), G.ay(GE.affine(1n+mp, a)), 1n, FS.fmul(1n+mp, G.ax(GE.affine(1n+mp, a)), G.ay(GE.affine(1n+mp, a)))}} : Maybe<&2, ED.EPt>}:
  %Equal.sym(List<&2, U32>, ED.encode(one, 1n+mp, a), VS2.enc(one, GE.affine(1n+mp, a)), VS2.encode_aff(one, 1n+mp, a)) : {ED.decode(1n+mp, d, _) == Some{ED.EPt{G.ax(GE.affine(1n+mp, a)), G.ay(GE.affine(1n+mp, a)), 1n, FS.fmul(1n+mp, G.ax(GE.affine(1n+mp, a)), G.ay(GE.affine(1n+mp, a)))}} : Maybe<&2, ED.EPt>}
  drt_a(one, h1, mp, d, hc, m, h58, hk, hp255, GE.affine(1n+mp, a), EX.aff_on(mp, d, a, ha))

# and that point has the same affine point as a (it is the same point)
def dec_enc_aff(+mp: Nat, +d: Nat, +hc: G.Curve(mp, d), +a: ED.EPt, +ha: GE.Valid(1n+mp, d, a)) -> {GE.affine(1n+mp, ED.EPt{G.ax(GE.affine(1n+mp, a)), G.ay(GE.affine(1n+mp, a)), 1n, FS.fmul(1n+mp, G.ax(GE.affine(1n+mp, a)), G.ay(GE.affine(1n+mp, a)))}) == GE.affine(1n+mp, a) : G.APt}:
  aff_a(mp, d, hc, GE.affine(1n+mp, a), EX.aff_on(mp, d, a, ha))
