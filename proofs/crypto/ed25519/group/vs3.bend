def hram_eq(+one: Nat, rb: List<&2, U32>, +a: List<&2, U32>, +msg: List<&2, U32>) -> {ED.hram(one, rb, a, msg) == Nat.mod(FS.value(SHA.sha512_bytes(ED.cat(rb, ED.cat(a, msg)))), ED.ell(one)) : Nat}:
