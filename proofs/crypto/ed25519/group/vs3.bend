# ---- signing, then verifying ----

# r = SHA-512(prefix || M) mod L
def rs(+one: Nat, +h: List<&2, U32>, +msg: List<&2, U32>) -> Nat:
  Nat.mod(FS.value(SHA.sha512_bytes(ED.cat(ED.rest(32n, h), msg))), ED.ell(one))

# S = (r + k s) mod el
def ss(+one: Nat, +el: Nat, +h: List<&2, U32>, +msg: List<&2, U32>, +rb: List<&2, U32>, +a: List<&2, U32>) -> Nat:
  Nat.mod(Nat.add(rs(one, h, msg), Nat.mul(ED.hram(one, rb, a, msg), ED.secret(h))), el)

# the verification of the signature (rb, S) under the key a
def vf(+one: Nat, +mp: Nat, +d: Nat, +el: Nat, +h: List<&2, U32>, +msg: List<&2, U32>, +rb: List<&2, U32>, +a: List<&2, U32>) -> Bool:
