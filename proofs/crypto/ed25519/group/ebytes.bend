  U.to_nat_from_nat(Nat.mod(a, 2n), 1n, {==}, NR.dm_lt(1n, a))

# ---- little-endian bytes ----

def byte_val(+x: Nat) -> {U32.to_nat(U32.from_nat(Nat.mod(x, 256n))) == Nat.mod(x, 256n) : Nat}:
  U.to_nat_from_nat(Nat.mod(x, 256n), 8n, {==}, NR.dm_lt(255n, x))

# x div 2^(8 n)
def dv(n: Nat, +x: Nat) -> Nat:
  match n:
    case 0n:
      x
    case 1n+m:
      dv(m, Nat.div(x, 256n))

# 8 n
def e8(n: Nat) -> Nat:
  match n:
    case 0n:
      0n
    case 1n+m:
      8n+e8(m)

