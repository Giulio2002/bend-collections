      %Equal.sym(Nat, Nat.add(C.shift(8n, FS.value(SX.le_bytes(m, Nat.div(x, 256n)))), C.shift(8n, LM.shn(m, dv(m, Nat.div(x, 256n))))), C.shift(8n, Nat.add(FS.value(SX.le_bytes(m, Nat.div(x, 256n))), LM.shn(m, dv(m, Nat.div(x, 256n))))), Equal.sym(Nat, C.shift(8n, Nat.add(FS.value(SX.le_bytes(m, Nat.div(x, 256n))), LM.shn(m, dv(m, Nat.div(x, 256n))))), Nat.add(C.shift(8n, FS.value(SX.le_bytes(m, Nat.div(x, 256n)))), C.shift(8n, LM.shn(m, dv(m, Nat.div(x, 256n))))), WW.shift_add(8n, FS.value(SX.le_bytes(m, Nat.div(x, 256n))), LM.shn(m, dv(m, Nat.div(x, 256n)))))) : {Nat.add(Nat.mod(x, 256n), _) == x : Nat}
      %Equal.sym(Nat, Nat.add(FS.value(SX.le_bytes(m, Nat.div(x, 256n))), LM.shn(m, dv(m, Nat.div(x, 256n)))), Nat.div(x, 256n), val_split(m, Nat.div(x, 256n))) : {Nat.add(Nat.mod(x, 256n), C.shift(8n, _)) == x : Nat}
      LM.dm256(x)

def val_pad(+n: Nat, +x: Nat, +h: {C.fits(e8(n), x) == True{} : Bool}) -> {FS.value(SX.le_bytes(n, x)) == Nat.add(FS.value(SX.le_bytes(n, x)), LM.shn(n, dv(n, x))) : Nat}:
  %Equal.sym(Nat, dv(n, x), C.high(e8(n), x), dv_high(n, x)) : {FS.value(SX.le_bytes(n, x)) == Nat.add(FS.value(SX.le_bytes(n, x)), LM.shn(n, _)) : Nat}
  %Equal.sym(Nat, C.high(e8(n), x), 0n, N.eq_from_is_eq(C.high(e8(n), x), 0n, h)) : {FS.value(SX.le_bytes(n, x)) == Nat.add(FS.value(SX.le_bytes(n, x)), LM.shn(n, _)) : Nat}
  %Equal.sym(Nat, LM.shn(n, 0n), 0n, shn_zero(n)) : {FS.value(SX.le_bytes(n, x)) == Nat.add(FS.value(SX.le_bytes(n, x)), _) : Nat}
  %Equal.sym(Nat, Nat.add(FS.value(SX.le_bytes(n, x)), 0n), FS.value(SX.le_bytes(n, x)), NA.add_zero(FS.value(SX.le_bytes(n, x)))) : {FS.value(SX.le_bytes(n, x)) == _ : Nat}
  {==}

# E3, for any byte count: x < 2^(8 n) is the value of its n bytes
def val_le_n(+n: Nat, +x: Nat, +h: {C.fits(e8(n), x) == True{} : Bool}) -> {FS.value(SX.le_bytes(n, x)) == x : Nat}:
  Equal.trans(Nat, FS.value(SX.le_bytes(n, x)), Nat.add(FS.value(SX.le_bytes(n, x)), LM.shn(n, dv(n, x))), x, val_pad(n, x, h), val_split(n, x))

# E3
def val_le(+one: Nat, +h1: {one == 1n : Nat}, +x: Nat, +hx: {C.fits(C.shift(8n, one), x) == True{} : Bool}) -> {FS.value(SX.le_bytes(C.shift(5n, one), x)) == x : Nat}:
  Lg.subst(Nat, z => {FS.value(SX.le_bytes(C.shift(5n, z), x)) == x : Nat}, 1n, one, Equal.sym(Nat, one, 1n, h1), val_le_n(32n, x, Lg.subst(Nat, z => {C.fits(C.shift(8n, z), x) == True{} : Bool}, one, 1n, h1, hx)))

# ---- E5: a zero bit leaves the bytes as they are ----

def msb_zero_n(n: Nat, +y: Nat) -> {ED.set_msb(SX.le_bytes(n, y), U32.from_nat(0n)) == SX.le_bytes(n, y) : List<&2, U32>}:
  match n:
    case 0n:
      {==}
    case 1n:
      Equal.cong(U32, List<&2, U32>, z => Con{z, Nil{}}, U32.or(U32.from_nat(Nat.mod(y, 256n)), 0), U32.from_nat(Nat.mod(y, 256n)), or_zero(U32.from_nat(Nat.mod(y, 256n))))
    case 2n+ +k:
      Equal.cong(List<&2, U32>, List<&2, U32>, z => Con{U32.from_nat(Nat.mod(y, 256n)), z}, ED.set_msb(SX.le_bytes(1n+k, Nat.div(y, 256n)), U32.from_nat(0n)), SX.le_bytes(1n+k, Nat.div(y, 256n)), msb_zero_n(1n+k, Nat.div(y, 256n)))

def msb_zero(+one: Nat, +y: Nat) -> {ED.set_msb(SX.le_bytes(C.shift(5n, one), y), U32.from_nat(0n)) == SX.le_bytes(C.shift(5n, one), y) : List<&2, U32>}:
  msb_zero_n(C.shift(5n, one), y)

def le32(+one: Nat, +h1: {one == 1n : Nat}, +y: Nat) -> {SX.le_bytes(32n, y) == SX.le_bytes(C.shift(5n, one), y) : List<&2, U32>}:
  Lg.subst(Nat, z => {SX.le_bytes(32n, y) == SX.le_bytes(C.shift(5n, z), y) : List<&2, U32>}, 1n, one, Equal.sym(Nat, one, 1n, h1), {==})

# ---- E4: the two halves of a signature ----

def first_n(n: Nat, +y: Nat, +b: U32, +t: List<&2, U32>) -> {ED.first(n, ED.cat(ED.set_msb(SX.le_bytes(n, y), b), t)) == ED.set_msb(SX.le_bytes(n, y), b) : List<&2, U32>}:
  match n:
    case 0n:
      {==}
    case 1n:
      {==}
    case 2n+ +k:
      Equal.cong(List<&2, U32>, List<&2, U32>, z => Con{U32.from_nat(Nat.mod(y, 256n)), z}, ED.first(1n+k, ED.cat(ED.set_msb(SX.le_bytes(1n+k, Nat.div(y, 256n)), b), t)), ED.set_msb(SX.le_bytes(1n+k, Nat.div(y, 256n)), b), first_n(1n+k, Nat.div(y, 256n), b, t))

def rest_n(n: Nat, +y: Nat, +b: U32, +t: List<&2, U32>) -> {ED.rest(n, ED.cat(ED.set_msb(SX.le_bytes(n, y), b), t)) == t : List<&2, U32>}:
  match n:
    case 0n:
      {==}
    case 1n:
      {==}
    case 2n+ +k:
      rest_n(1n+k, Nat.div(y, 256n), b, t)

def first_enc(+one: Nat, +h1: {one == 1n : Nat}, +y: Nat, +b: Nat, +t: List<&2, U32>) -> {ED.first(32n, ED.cat(ED.set_msb(SX.le_bytes(C.shift(5n, one), y), U32.from_nat(b)), t)) == ED.set_msb(SX.le_bytes(C.shift(5n, one), y), U32.from_nat(b)) : List<&2, U32>}:
  Lg.subst(Nat, z => {ED.first(32n, ED.cat(ED.set_msb(SX.le_bytes(C.shift(5n, z), y), U32.from_nat(b)), t)) == ED.set_msb(SX.le_bytes(C.shift(5n, z), y), U32.from_nat(b)) : List<&2, U32>}, 1n, one, Equal.sym(Nat, one, 1n, h1), first_n(32n, y, U32.from_nat(b), t))

def rest_enc(+one: Nat, +h1: {one == 1n : Nat}, +y: Nat, +b: Nat, +t: List<&2, U32>) -> {ED.rest(32n, ED.cat(ED.set_msb(SX.le_bytes(C.shift(5n, one), y), U32.from_nat(b)), t)) == t : List<&2, U32>}:
  Lg.subst(Nat, z => {ED.rest(32n, ED.cat(ED.set_msb(SX.le_bytes(C.shift(5n, z), y), U32.from_nat(b)), t)) == t : List<&2, U32>}, 1n, one, Equal.sym(Nat, one, 1n, h1), rest_n(32n, y, U32.from_nat(b), t))

# ---- E1, E2: the decoder reads y and the bit back ----

# the mask passes over a byte that is not the last
def mask_con(+x: U32, +y: U32, yt: List<&2, U32>, +b: U32) -> {SX.mask_last(Con{x, ED.set_msb(Con{y, yt}, b)}) == Con{x, SX.mask_last(ED.set_msb(Con{y, yt}, b))} : List<&2, U32>}:
  match yt:
    case Nil{}:
      {==}
    case Con{z, zt}:
      {==}

# 1 + m bytes whose last one is below 2^7: masking the bit gives the bytes back
def mask_n(m: Nat, +y: Nat, +b: Nat, +hl: {Nat.is_lt(Nat.mod(dv(m, y), 256n), 128n) == True{} : Bool}, +hb: {Nat.is_le(b, 1n) == True{} : Bool}) -> {SX.mask_last(ED.set_msb(SX.le_bytes(1n+m, y), U32.from_nat(b))) == SX.le_bytes(1n+m, y) : List<&2, U32>}:
  match m:
    case 0n:
      Equal.cong(U32, List<&2, U32>, z => Con{z, Nil{}}, U32.and(U32.or(U32.from_nat(Nat.mod(y, 256n)), U32.shln(U32.from_nat(b), 7n)), 127), U32.from_nat(Nat.mod(y, 256n)), msb_mask(U32.from_nat(Nat.mod(y, 256n)), b, Lg.subst(Nat, z => {Nat.is_lt(z, 128n) == True{} : Bool}, Nat.mod(y, 256n), U32.to_nat(U32.from_nat(Nat.mod(y, 256n))), Equal.sym(Nat, U32.to_nat(U32.from_nat(Nat.mod(y, 256n))), Nat.mod(y, 256n), byte_val(y)), hl), hb))
    case 1n+ +k:
      Equal.trans(List<&2, U32>, SX.mask_last(Con{U32.from_nat(Nat.mod(y, 256n)), ED.set_msb(SX.le_bytes(1n+k, Nat.div(y, 256n)), U32.from_nat(b))}), Con{U32.from_nat(Nat.mod(y, 256n)), SX.mask_last(ED.set_msb(SX.le_bytes(1n+k, Nat.div(y, 256n)), U32.from_nat(b)))}, Con{U32.from_nat(Nat.mod(y, 256n)), SX.le_bytes(1n+k, Nat.div(y, 256n))},
        mask_con(U32.from_nat(Nat.mod(y, 256n)), U32.from_nat(Nat.mod(Nat.div(y, 256n), 256n)), SX.le_bytes(k, Nat.div(Nat.div(y, 256n), 256n)), U32.from_nat(b)),
        Equal.cong(List<&2, U32>, List<&2, U32>, z => Con{U32.from_nat(Nat.mod(y, 256n)), z}, SX.mask_last(ED.set_msb(SX.le_bytes(1n+k, Nat.div(y, 256n)), U32.from_nat(b))), SX.le_bytes(1n+k, Nat.div(y, 256n)), mask_n(k, Nat.div(y, 256n), b, hl, hb)))

# and the value with the bit is the value plus 2^(8 m + 7) b
def sval_n(m: Nat, +y: Nat, +b: Nat, +hl: {Nat.is_lt(Nat.mod(dv(m, y), 256n), 128n) == True{} : Bool}, +hb: {Nat.is_le(b, 1n) == True{} : Bool}) -> {FS.value(ED.set_msb(SX.le_bytes(1n+m, y), U32.from_nat(b))) == Nat.add(FS.value(SX.le_bytes(1n+m, y)), LM.shn(m, C.shift(7n, b))) : Nat}:
  match m:
    case 0n:
      %Equal.sym(Nat, Nat.add(U32.to_nat(U32.or(U32.from_nat(Nat.mod(y, 256n)), U32.shln(U32.from_nat(b), 7n))), 0n), U32.to_nat(U32.or(U32.from_nat(Nat.mod(y, 256n)), U32.shln(U32.from_nat(b), 7n))), NA.add_zero(U32.to_nat(U32.or(U32.from_nat(Nat.mod(y, 256n)), U32.shln(U32.from_nat(b), 7n))))) : {_ == Nat.add(Nat.add(U32.to_nat(U32.from_nat(Nat.mod(y, 256n))), 0n), C.shift(7n, b)) : Nat}
      %Equal.sym(Nat, Nat.add(U32.to_nat(U32.from_nat(Nat.mod(y, 256n))), 0n), U32.to_nat(U32.from_nat(Nat.mod(y, 256n))), NA.add_zero(U32.to_nat(U32.from_nat(Nat.mod(y, 256n))))) : {U32.to_nat(U32.or(U32.from_nat(Nat.mod(y, 256n)), U32.shln(U32.from_nat(b), 7n))) == Nat.add(_, C.shift(7n, b)) : Nat}
      msb_val(U32.from_nat(Nat.mod(y, 256n)), b, Lg.subst(Nat, z => {Nat.is_lt(z, 128n) == True{} : Bool}, Nat.mod(y, 256n), U32.to_nat(U32.from_nat(Nat.mod(y, 256n))), Equal.sym(Nat, U32.to_nat(U32.from_nat(Nat.mod(y, 256n))), Nat.mod(y, 256n), byte_val(y)), hl), hb)
    case 1n+ +k:
      %Equal.sym(Nat, FS.value(ED.set_msb(SX.le_bytes(1n+k, Nat.div(y, 256n)), U32.from_nat(b))), Nat.add(FS.value(SX.le_bytes(1n+k, Nat.div(y, 256n))), LM.shn(k, C.shift(7n, b))), sval_n(k, Nat.div(y, 256n), b, hl, hb)) : {Nat.add(U32.to_nat(U32.from_nat(Nat.mod(y, 256n))), C.shift(8n, _)) == Nat.add(Nat.add(U32.to_nat(U32.from_nat(Nat.mod(y, 256n))), C.shift(8n, FS.value(SX.le_bytes(1n+k, Nat.div(y, 256n))))), C.shift(8n, LM.shn(k, C.shift(7n, b)))) : Nat}
      %Equal.sym(Nat, C.shift(8n, Nat.add(FS.value(SX.le_bytes(1n+k, Nat.div(y, 256n))), LM.shn(k, C.shift(7n, b)))), Nat.add(C.shift(8n, FS.value(SX.le_bytes(1n+k, Nat.div(y, 256n)))), C.shift(8n, LM.shn(k, C.shift(7n, b)))), WW.shift_add(8n, FS.value(SX.le_bytes(1n+k, Nat.div(y, 256n))), LM.shn(k, C.shift(7n, b)))) : {Nat.add(U32.to_nat(U32.from_nat(Nat.mod(y, 256n))), _) == Nat.add(Nat.add(U32.to_nat(U32.from_nat(Nat.mod(y, 256n))), C.shift(8n, FS.value(SX.le_bytes(1n+k, Nat.div(y, 256n))))), C.shift(8n, LM.shn(k, C.shift(7n, b)))) : Nat}
      %Equal.sym(Nat, Nat.add(U32.to_nat(U32.from_nat(Nat.mod(y, 256n))), Nat.add(C.shift(8n, FS.value(SX.le_bytes(1n+k, Nat.div(y, 256n)))), C.shift(8n, LM.shn(k, C.shift(7n, b))))), Nat.add(Nat.add(U32.to_nat(U32.from_nat(Nat.mod(y, 256n))), C.shift(8n, FS.value(SX.le_bytes(1n+k, Nat.div(y, 256n))))), C.shift(8n, LM.shn(k, C.shift(7n, b)))), Equal.sym(Nat, Nat.add(Nat.add(U32.to_nat(U32.from_nat(Nat.mod(y, 256n))), C.shift(8n, FS.value(SX.le_bytes(1n+k, Nat.div(y, 256n))))), C.shift(8n, LM.shn(k, C.shift(7n, b)))), Nat.add(U32.to_nat(U32.from_nat(Nat.mod(y, 256n))), Nat.add(C.shift(8n, FS.value(SX.le_bytes(1n+k, Nat.div(y, 256n)))), C.shift(8n, LM.shn(k, C.shift(7n, b))))), NA.add_assoc(U32.to_nat(U32.from_nat(Nat.mod(y, 256n))), C.shift(8n, FS.value(SX.le_bytes(1n+k, Nat.div(y, 256n)))), C.shift(8n, LM.shn(k, C.shift(7n, b)))))) : {_ == Nat.add(Nat.add(U32.to_nat(U32.from_nat(Nat.mod(y, 256n))), C.shift(8n, FS.value(SX.le_bytes(1n+k, Nat.div(y, 256n))))), C.shift(8n, LM.shn(k, C.shift(7n, b)))) : Nat}
      {==}

# y < 2^255: below 2^256, and its byte 31 is below 2^7
def fits256(+y: Nat, +hy: {C.fits(255n, y) == True{} : Bool}) -> {C.fits(256n, y) == True{} : Bool}:
  %Equal.sym(Nat, C.high(256n, y), C.high(1n, C.high(255n, y)), WW.high_comp(1n, 255n, y)) : {Nat.is_eq(_, 0n) == True{} : Bool}
  %Equal.sym(Nat, C.high(255n, y), 0n, N.eq_from_is_eq(C.high(255n, y), 0n, hy)) : {Nat.is_eq(C.high(1n, _), 0n) == True{} : Bool}
  {==}

def top_fits(+y: Nat, +hy: {C.fits(255n, y) == True{} : Bool}) -> {C.fits(7n, C.high(248n, y)) == True{} : Bool}:
  %Equal.sym(Nat, C.high(7n, C.high(248n, y)), C.high(255n, y), Equal.sym(Nat, C.high(255n, y), C.high(7n, C.high(248n, y)), WW.high_comp(7n, 248n, y))) : {Nat.is_eq(_, 0n) == True{} : Bool}
  %Equal.sym(Nat, C.high(255n, y), 0n, N.eq_from_is_eq(C.high(255n, y), 0n, hy)) : {Nat.is_eq(_, 0n) == True{} : Bool}
  {==}

def small_mod(+q: Nat, +h: {C.fits(7n, q) == True{} : Bool}) -> {Nat.is_lt(Nat.mod(q, 256n), 128n) == True{} : Bool}:
  +lt = WW.lt_of_fits(7n, q, h)
  Lg.subst(Nat, z => {Nat.is_lt(z, 128n) == True{} : Bool}, q, Nat.mod(q, 256n), Equal.sym(Nat, Nat.mod(q, 256n), q, NR.mod_of(0n, 255n, q, N.lt_le_trans(q, 128n, 256n, lt, {==}))), lt)

def top7(+y: Nat, +hy: {C.fits(255n, y) == True{} : Bool}) -> {Nat.is_lt(Nat.mod(dv(31n, y), 256n), 128n) == True{} : Bool}:
  Lg.subst(Nat, z => {Nat.is_lt(Nat.mod(z, 256n), 128n) == True{} : Bool}, C.high(248n, y), dv(31n, y), Equal.sym(Nat, dv(31n, y), C.high(248n, y), dv_high(31n, y)), small_mod(C.high(248n, y), top_fits(y, hy)))

def enc_y32(+y: Nat, +b: Nat, +hy: {C.fits(255n, y) == True{} : Bool}, +hb: {Nat.is_le(b, 1n) == True{} : Bool}) -> {FS.value(SX.mask_last(ED.set_msb(SX.le_bytes(32n, y), U32.from_nat(b)))) == y : Nat}:
  Equal.trans(Nat, FS.value(SX.mask_last(ED.set_msb(SX.le_bytes(32n, y), U32.from_nat(b)))), FS.value(SX.le_bytes(32n, y)), y, Equal.cong(List<&2, U32>, Nat, z => FS.value(z), SX.mask_last(ED.set_msb(SX.le_bytes(32n, y), U32.from_nat(b))), SX.le_bytes(32n, y), mask_n(31n, y, b, top7(y, hy), hb)), val_le_n(32n, y, fits256(y, hy)))

# bit 255 of y + 2^255 b
def top_bit(+y: Nat, +b: Nat, +hy: {C.fits(255n, y) == True{} : Bool}, +hb: {Nat.is_le(b, 1n) == True{} : Bool}) -> {C.bit(C.high(255n, Nat.add(y, C.shift(255n, b)))) == b : Nat}:
  %Equal.sym(Nat, C.high(255n, Nat.add(y, C.shift(255n, b))), Nat.add(C.high(255n, y), b), WW.high_add_shift(255n, y, b)) : {C.bit(_) == b : Nat}
  %Equal.sym(Nat, C.high(255n, y), 0n, N.eq_from_is_eq(C.high(255n, y), 0n, hy)) : {C.bit(Nat.add(_, b)) == b : Nat}
  bit_small(b, hb)

def enc_bit32(+y: Nat, +b: Nat, +hy: {C.fits(255n, y) == True{} : Bool}, +hb: {Nat.is_le(b, 1n) == True{} : Bool}) -> {SX.kbit(FS.value(ED.set_msb(SX.le_bytes(32n, y), U32.from_nat(b))), 255n) == b : Nat}:
  %Equal.sym(Nat, FS.value(ED.set_msb(SX.le_bytes(32n, y), U32.from_nat(b))), Nat.add(FS.value(SX.le_bytes(32n, y)), LM.shn(31n, C.shift(7n, b))), sval_n(31n, y, b, top7(y, hy), hb)) : {C.bit(C.high(255n, _)) == b : Nat}
  %Equal.sym(Nat, FS.value(SX.le_bytes(32n, y)), y, val_le_n(32n, y, fits256(y, hy))) : {C.bit(C.high(255n, Nat.add(_, LM.shn(31n, C.shift(7n, b))))) == b : Nat}
  top_bit(y, b, hy, hb)

# E1: the decoder's y (the bytes with bit 255 masked) is y
def enc_y(+one: Nat, +h1: {one == 1n : Nat}, +y: Nat, +b: Nat, +hy: {C.fits(255n, y) == True{} : Bool}, +hb: {Nat.is_le(b, 1n) == True{} : Bool}) -> {FS.value(SX.mask_last(ED.set_msb(SX.le_bytes(C.shift(5n, one), y), U32.from_nat(b)))) == y : Nat}:
  Lg.subst(Nat, z => {FS.value(SX.mask_last(ED.set_msb(SX.le_bytes(C.shift(5n, z), y), U32.from_nat(b)))) == y : Nat}, 1n, one, Equal.sym(Nat, one, 1n, h1), enc_y32(y, b, hy, hb))

# E2: the decoder's sign bit (bit 255 of the bytes) is b
def enc_bit(+one: Nat, +h1: {one == 1n : Nat}, +y: Nat, +b: Nat, +hy: {C.fits(255n, y) == True{} : Bool}, +hb: {Nat.is_le(b, 1n) == True{} : Bool}) -> {SX.kbit(FS.value(ED.set_msb(SX.le_bytes(C.shift(5n, one), y), U32.from_nat(b))), 255n) == b : Nat}:
  Lg.subst(Nat, z => {SX.kbit(FS.value(ED.set_msb(SX.le_bytes(C.shift(5n, z), y), U32.from_nat(b))), 255n) == b : Nat}, 1n, one, Equal.sym(Nat, one, 1n, h1), enc_bit32(y, b, hy, hb))

# ---- E6: bounds ----

# a residue of a modulus at most 2^k is below 2^k
def mod_fits_k(+k: Nat, +one: Nat, +h1: {one == 1n : Nat}, +x: Nat, +mp: Nat, +hm: {Nat.is_le(1n+mp, C.shift(k, one)) == True{} : Bool}) -> {C.fits(k, Nat.mod(x, 1n+mp)) == True{} : Bool}:
  WW.fits_one(k, one, h1, Nat.mod(x, 1n+mp), N.lt_le_trans(Nat.mod(x, 1n+mp), 1n+mp, C.shift(k, one), NR.dm_lt(mp, x), hm))

# E6 (b)
def mod_fits(+one: Nat, +h1: {one == 1n : Nat}, +x: Nat, +mp: Nat, +hm: {Nat.is_le(1n+mp, C.shift(256n, one)) == True{} : Bool}) -> {C.fits(C.shift(8n, one), Nat.mod(x, 1n+mp)) == True{} : Bool}:
  Lg.subst(Nat, z => {C.fits(C.shift(8n, z), Nat.mod(x, 1n+mp)) == True{} : Bool}, 1n, one, Equal.sym(Nat, one, 1n, h1), mod_fits_k(256n, one, h1, x, mp, hm))

# a field element is below 2^255
def mod_fits255(+one: Nat, +h1: {one == 1n : Nat}, +x: Nat, +mp: Nat, +hm: {Nat.is_le(1n+mp, C.shift(255n, one)) == True{} : Bool}) -> {C.fits(255n, Nat.mod(x, 1n+mp)) == True{} : Bool}:
  mod_fits_k(255n, one, h1, x, mp, hm)

# n bytes are below 2^(8 n)
def okb_fits(n: Nat, xs: List<&2, U32>, +e: {LM.okb(n, xs, 255n) == True{} : Bool}) -> {C.fits(e8(n), FS.value(xs)) == True{} : Bool}:
  match n xs:
    case 0n Nil{}:
      {==}
    case 0n Con{x, xt}:
      Empty.absurd({C.fits(0n, FS.value(Con{x, xt})) == True{} : Bool}, Lg.false_true(e))
    case 1n+m Nil{}:
      Empty.absurd({C.fits(e8(1n+m), 0n) == True{} : Bool}, Lg.false_true(e))
    case 1n+ +m Con{+x, +xt}:
      WW.limbs_fit(8n, e8(m), U32.to_nat(x), FS.value(xt), WW.fits_of_lt(8n, U32.to_nat(x), N.le_lt_succ(U32.to_nat(x), 255n, LM.okb_head(m, x, xt, 255n, e))), okb_fits(m, xt, LM.okb_tail(m, x, xt, 255n, e)))

# n + m, by recursion on n
def pl(n: Nat, +m: Nat) -> Nat:
  match n:
    case 0n:
      m
    case 1n+k:
      1n+pl(k, m)

def first_okb(n: Nat, +m: Nat, xs: List<&2, U32>, +b: Nat, +e: {LM.okb(pl(n, m), xs, b) == True{} : Bool}) -> {LM.okb(n, ED.first(n, xs), b) == True{} : Bool}:
  match n:
    case 0n:
      {==}
    case 1n+ +k:
      match xs:
        case Nil{}:
          e
        case Con{+x, +xt}:
          Lg.and_intro(Nat.is_le(U32.to_nat(x), b), LM.okb(k, ED.first(k, xt), b), Lg.and_left(Nat.is_le(U32.to_nat(x), b), LM.okb(pl(k, m), xt, b), e), first_okb(k, m, xt, b, Lg.and_right(Nat.is_le(U32.to_nat(x), b), LM.okb(pl(k, m), xt, b), e)))

def secret_okb(+h: List<&2, U32>, +hh: {FS.bytes_ok(64n, h) == True{} : Bool}) -> {LM.okb(32n, SX.clamp(ED.first(32n, h)), 255n) == True{} : Bool}:
  %Equal.sym(List<&2, U32>, SX.clamp(ED.first(32n, h)), X.clamp(ED.first(32n, h)), Equal.sym(List<&2, U32>, X.clamp(ED.first(32n, h)), SX.clamp(ED.first(32n, h)), XB.clamp_eq(ED.first(32n, h)))) : {LM.okb(32n, _, 255n) == True{} : Bool}
  XB.clamp_okb(ED.first(32n, h), first_okb(32n, 32n, h, 255n, LM.bytes_okb(64n, h, hh)))

# E6 (a): the secret scalar of a 64-byte hash is below 2^256
def secret_fits(+one: Nat, +h1: {one == 1n : Nat}, +h: List<&2, U32>, +hh: {FS.bytes_ok(64n, h) == True{} : Bool}) -> {C.fits(C.shift(8n, one), ED.secret(h)) == True{} : Bool}:
  Lg.subst(Nat, z => {C.fits(C.shift(8n, z), FS.value(SX.clamp(ED.first(32n, h)))) == True{} : Bool}, 1n, one, Equal.sym(Nat, one, 1n, h1), okb_fits(32n, SX.clamp(ED.first(32n, h)), secret_okb(h, hh)))

# a SHA-512 digest is 64 bytes
def sha_bytes_ok(+seed: List<&2, U32>) -> {FS.bytes_ok(64n, SHA.sha512_bytes(seed)) == True{} : Bool}:
  LM.okb_bytes(64n, SHA.sha512_bytes(seed), Lg.subst(List<&2, U32>, z => {LM.okb(64n, z, 255n) == True{} : Bool}, HS.hash(seed), SHA.sha512_bytes(seed), EB.sha_eq(seed), EB.sha_okb(seed)))

# E6 (a) for the hash of a seed (every seed)
def secret_sha_fits(+one: Nat, +h1: {one == 1n : Nat}, +seed: List<&2, U32>) -> {C.fits(C.shift(8n, one), ED.secret(SHA.sha512_bytes(seed))) == True{} : Bool}:
  secret_fits(one, h1, SHA.sha512_bytes(seed), sha_bytes_ok(seed))
