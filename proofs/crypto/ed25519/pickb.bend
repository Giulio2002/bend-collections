import Base
import ../../../src/crypto/curve25519/fe.bend as FE
import ../../../src/crypto/curve25519/limbs.bend as LS
import ../../../src/crypto/ed25519/pick.bend as PK

# The straight-line selection is the list form on the limbs: one
# evaluation on symbolic limbs (written by tools/gen_pick.py together
# with src/crypto/ed25519/pick.bend).

def sel16_b(+m0: Nat, +m1: Nat, +m2: Nat, +m3: Nat, +m4: Nat, +m5: Nat, +m6: Nat, +m7: Nat, +m8: Nat, +m9: Nat, +m10: Nat, +m11: Nat, +m12: Nat, +m13: Nat, +m14: Nat, +m15: Nat, +f0: FE.Fe, +f1: FE.Fe, +f2: FE.Fe, +f3: FE.Fe, +f4: FE.Fe, +f5: FE.Fe, +f6: FE.Fe, +f7: FE.Fe, +f8: FE.Fe, +f9: FE.Fe, +f10: FE.Fe, +f11: FE.Fe, +f12: FE.Fe, +f13: FE.Fe, +f14: FE.Fe, +f15: FE.Fe) -> {FE.to_list(PK.sel16(PK.M16{m0, m1, m2, m3, m4, m5, m6, m7, m8, m9, m10, m11, m12, m13, m14, m15}, f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15)) == LS.pick(15n, [m0, m1, m2, m3, m4, m5, m6, m7, m8, m9, m10, m11, m12, m13, m14, m15], [FE.to_list(f0), FE.to_list(f1), FE.to_list(f2), FE.to_list(f3), FE.to_list(f4), FE.to_list(f5), FE.to_list(f6), FE.to_list(f7), FE.to_list(f8), FE.to_list(f9), FE.to_list(f10), FE.to_list(f11), FE.to_list(f12), FE.to_list(f13), FE.to_list(f14), FE.to_list(f15)]) : List<&2, Nat>}:
  match f0 f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 f13 f14 f15:
    case FE.Fe{x0_0, x0_1, x0_2, x0_3, x0_4, x0_5, x0_6, x0_7, x0_8, x0_9, x0_10, x0_11, x0_12, x0_13, x0_14} FE.Fe{x1_0, x1_1, x1_2, x1_3, x1_4, x1_5, x1_6, x1_7, x1_8, x1_9, x1_10, x1_11, x1_12, x1_13, x1_14} FE.Fe{x2_0, x2_1, x2_2, x2_3, x2_4, x2_5, x2_6, x2_7, x2_8, x2_9, x2_10, x2_11, x2_12, x2_13, x2_14} FE.Fe{x3_0, x3_1, x3_2, x3_3, x3_4, x3_5, x3_6, x3_7, x3_8, x3_9, x3_10, x3_11, x3_12, x3_13, x3_14} FE.Fe{x4_0, x4_1, x4_2, x4_3, x4_4, x4_5, x4_6, x4_7, x4_8, x4_9, x4_10, x4_11, x4_12, x4_13, x4_14} FE.Fe{x5_0, x5_1, x5_2, x5_3, x5_4, x5_5, x5_6, x5_7, x5_8, x5_9, x5_10, x5_11, x5_12, x5_13, x5_14} FE.Fe{x6_0, x6_1, x6_2, x6_3, x6_4, x6_5, x6_6, x6_7, x6_8, x6_9, x6_10, x6_11, x6_12, x6_13, x6_14} FE.Fe{x7_0, x7_1, x7_2, x7_3, x7_4, x7_5, x7_6, x7_7, x7_8, x7_9, x7_10, x7_11, x7_12, x7_13, x7_14} FE.Fe{x8_0, x8_1, x8_2, x8_3, x8_4, x8_5, x8_6, x8_7, x8_8, x8_9, x8_10, x8_11, x8_12, x8_13, x8_14} FE.Fe{x9_0, x9_1, x9_2, x9_3, x9_4, x9_5, x9_6, x9_7, x9_8, x9_9, x9_10, x9_11, x9_12, x9_13, x9_14} FE.Fe{x10_0, x10_1, x10_2, x10_3, x10_4, x10_5, x10_6, x10_7, x10_8, x10_9, x10_10, x10_11, x10_12, x10_13, x10_14} FE.Fe{x11_0, x11_1, x11_2, x11_3, x11_4, x11_5, x11_6, x11_7, x11_8, x11_9, x11_10, x11_11, x11_12, x11_13, x11_14} FE.Fe{x12_0, x12_1, x12_2, x12_3, x12_4, x12_5, x12_6, x12_7, x12_8, x12_9, x12_10, x12_11, x12_12, x12_13, x12_14} FE.Fe{x13_0, x13_1, x13_2, x13_3, x13_4, x13_5, x13_6, x13_7, x13_8, x13_9, x13_10, x13_11, x13_12, x13_13, x13_14} FE.Fe{x14_0, x14_1, x14_2, x14_3, x14_4, x14_5, x14_6, x14_7, x14_8, x14_9, x14_10, x14_11, x14_12, x14_13, x14_14} FE.Fe{x15_0, x15_1, x15_2, x15_3, x15_4, x15_5, x15_6, x15_7, x15_8, x15_9, x15_10, x15_11, x15_12, x15_13, x15_14}:
      {==}
