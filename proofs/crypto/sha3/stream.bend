    case b0 <> Nil{} 0n:
      {==}
    case b0 <> Nil{} 1n:
      {==}
    case b0 <> Nil{} 2n:
      {==}
    case b0 <> Nil{} 3n:
      {==}
    case b0 <> Nil{} 4n:
