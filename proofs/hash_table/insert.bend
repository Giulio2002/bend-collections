# the result of an update: a good shadow whose model agrees with the
# specification's set on every lookup and on the size
def SetM(~V: Data, +m: List<&2, S.Entry<V>>, +key: String, +x: V, r: H.HashMap<&2, V>) -> Type:
  Sigma<&1, &1, ST.Sh<V>, sh2 => {r == ST.real(~V, sh2) : H.HashMap<&2, V>} & ({ST.good(~V, sh2) == True{} : Bool} & ((@+q: String -> {S.lookup(~V, ST.model(~V, sh2), q) == S.lookup(~V, S.set(~V, m, key, x), q) : Maybe<&2, V>}) & {S.size(~V, ST.model(~V, sh2)) == S.size(~V, S.set(~V, m, key, x)) : Nat}))>


# THEOREM: placing a new entry without growing the table refines set
