# set: the implementation's set agrees with the specification's set, for
# every key's lookup and for the size.

def SetOK(~V: Data, +sh: ST.Sh<V>, +key: String, +x: V, r: H.HashMap<&2, V>) -> Type:
  Sigma<&1, &1, ST.Sh<V>, sh2 => {r == ST.real(~V, sh2) : H.HashMap<&2, V>} & ({ST.good(~V, sh2) == True{} : Bool} & ((@+q: String -> {S.lookup(~V, ST.model(~V, sh2), q) == S.lookup(~V, S.set(~V, ST.model(~V, sh), key, x), q) : Maybe<&2, V>}) & {S.size(~V, ST.model(~V, sh2)) == S.size(~V, S.set(~V, ST.model(~V, sh), key, x)) : Nat}))>

def sz_old(~V: Data, +m: List<&2, S.Entry<V>>, +key: String, +x: V, +mv: Maybe<&2, V>, +hmv: {S.lookup(~V, m, key) == mv : Maybe<&2, V>}, +hs: {ST.some_b(~V, mv) == True{} : Bool}) -> {S.size(~V, S.set(~V, m, key, x)) == S.size(~V, m) : Nat}:
  match mv:
    case None{}:
      Empty.absurd({S.size(~V, S.set(~V, m, key, x)) == S.size(~V, m) : Nat}, L.false_true(hs))
    case Some{+v0}:
      SL.size_set_old(~V, m, key, x, v0, hmv)

