def dinv(+kl: List<&2, String>, +K: Nat, +bp: Nat, +V0: List<&2, B.Bk>, +e0: Nat, st: DSt) -> Bool:
  match st:
    case DS{+iU, +h, +kU, +dk, +T}:
      dinvF(kl, K, bp, V0, e0, iU, h, kU, dk, T)

def dfuel(+bp: Nat, +e0: Nat, +f: Nat, st: DSt) -> Bool:
  match st:
    case DS{iU, +h, kU, +dk, T}:
      Nat.is_lt(M.dist(1n+bp, h, e0), Nat.add(dk, f))


