# del_at: the implementation's backward shift is the bucket-level one.


# ---- writing one bucket, the key arena unchanged ----

def d_other(+tb: List<&2, U32>, +kl: List<&2, String>, +e: Nat, +w: U32, +l: U32, +j: Nat, +hne: {Nat.is_eq(e, j) == False{} : Bool}) -> {TB.dec(SC.update(U32, SC.update(U32, tb, Nat.double(e), w), 1n+Nat.double(e), l), kl, j) == TB.dec(tb, kl, j) : B.Bk}:
  +wj = TB.nth0(tb, Nat.double(j))
  Equal.trans(B.Bk, TB.dec(SC.update(U32, SC.update(U32, tb, Nat.double(e), w), 1n+Nat.double(e), l), kl, j), TB.dec_c(wj, TB.nth0(SC.update(U32, SC.update(U32, tb, Nat.double(e), w), 1n+Nat.double(e), l), 1n+Nat.double(j)), kl, U32.is_eq(wj, 0)), TB.dec(tb, kl, j), Equal.cong(U32, B.Bk, a => TB.dec_c(a, TB.nth0(SC.update(U32, SC.update(U32, tb, Nat.double(e), w), 1n+Nat.double(e), l), 1n+Nat.double(j)), kl, U32.is_eq(a, 0)), TB.nth0(SC.update(U32, SC.update(U32, tb, Nat.double(e), w), 1n+Nat.double(e), l), Nat.double(j)), wj, IA.w_other(tb, e, w, l, j, hne)), Equal.cong(U32, B.Bk, a => TB.dec_c(wj, a, kl, U32.is_eq(wj, 0)), TB.nth0(SC.update(U32, SC.update(U32, tb, Nat.double(e), w), 1n+Nat.double(e), l), 1n+Nat.double(j)), TB.nth0(tb, 1n+Nat.double(j)), IA.l_other(tb, e, w, l, j, hne)))

def d_at(+tb: List<&2, U32>, +kl: List<&2, String>, +e: Nat, +w: U32, +l: U32, +htb: {Nat.is_lt(1n+Nat.double(e), SC.length(U32, tb)) == True{} : Bool}) -> {TB.dec(SC.update(U32, SC.update(U32, tb, Nat.double(e), w), 1n+Nat.double(e), l), kl, e) == TB.dec_c(w, l, kl, U32.is_eq(w, 0)) : B.Bk}:
