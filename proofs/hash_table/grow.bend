def p_h2(+K: Nat, +hK: {Nat.is_lt(K, 31n) == True{} : Bool}, +T: AR.Tree<U32>, +pt: {AR.perfect(U32, 1n+K, T) == True{} : Bool}, +e: Nat, +he: {Nat.is_lt(e, SC.pow2(K)) == True{} : Bool}, +w: U32, +l: U32) -> {Nat.is_lt(UD.v(U32.inc(U32.shl(U32.from_nat(e)))), SC.pow2(1n+K)) == True{} : Bool}:
