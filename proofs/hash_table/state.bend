import Base
import ../lib/logic.bend as L
import ../lib/array.bend as AR
import ../spec/common.bend as SC
import ../spec/hash_table.bend as S
import ../math/u32div.bend as UD
import ../../src/containers/hash_table.bend as H
import ./table.bend as TB
import ./buckets.bend as B
import ./cyc.bend as CY
import ./inv.bend as IV

# The hash map as a Data shadow: its U32 fields, the table and arena
# exponents k (2^k buckets) and sd (2^sd slots), and a mirror tree for each
# array. real(sh) is the HashMap<&2, V> the implementation holds.

type Sh<-V: Data> is Data:
  HS{n: U32, k: Nat, td: U32, fresh: U32, sz: U32, sd: Nat, sdU: U32, free: U32, tabT: AR.Tree<U32>, ksT: AR.Tree<String>, vsT: AR.Tree<Maybe<&2, V>>, nxT: AR.Tree<U32>}

def real(~V: Data, sh: Sh<V>) -> H.HashMap<&2, V>:
  match sh:
    case HS{n, k, td, fresh, sz, sd, sdU, free, tabT, ksT, vsT, nxT}:
      H.HM{n, CY.msk(k), td, fresh, sz, sdU, free, AR.thaw(U32, tabT), AR.thaw(String, ksT), AR.thaw(Maybe<&2, V>, vsT), AR.thaw(U32, nxT)}

# ---- the abstraction ----

def some_b(~V: Data, m: Maybe<&2, V>) -> Bool:
  match m:
    case None{}:
      False{}
    case Some{v}:
      True{}

def lvs(~V: Data, vsl: List<&2, Maybe<&2, V>>) -> List<&2, Bool>:
  match vsl:
    case Nil{}:
      Nil{}
    case Con{m, t}:
      Con{some_b(~V, m), lvs(~V, t)}

def nthm(~V: Data, vsl: List<&2, Maybe<&2, V>>, +i: Nat) -> Maybe<&2, V>:
  match vsl i:
    case Nil{} _:
      None{}
    case Con{m, t} 0n:
      m
    case Con{m, t} 1n+p:
      nthm(~V, t, p)

def ent_m(~V: Data, +k: String, m: Maybe<&2, V>) -> List<&2, S.Entry<V>>:
  match m:
    case None{}:
      Nil{}
    case Some{v}:
      Con{S.E{k, v}, Nil{}}

# the entry of a bucket
def ent(~V: Data, b: B.Bk, +vsl: List<&2, Maybe<&2, V>>) -> List<&2, S.Entry<V>>:
  match b:
    case B.BE{}:
      Nil{}
    case B.BF{w, +l, +k}:
      ent_m(~V, k, nthm(~V, vsl, UD.v(H.slot(l))))

# the entries of buckets j .. j + m - 1, in bucket order
def absm(~V: Data, +bs: List<&2, B.Bk>, +vsl: List<&2, Maybe<&2, V>>, +m: Nat, +j: Nat) -> List<&2, S.Entry<V>>:
  match m:
    case 0n:
      Nil{}
    case 1n+p:
      SC.append(S.Entry<V>, ent(~V, B.at(bs, j), vsl), absm(~V, bs, vsl, p, 1n+j))

def bsof(~V: Data, sh: Sh<V>) -> List<&2, B.Bk>:
  match sh:
    case HS{n, +k, td, fresh, sz, sd, sdU, free, +tabT, +ksT, vsT, nxT}:
      TB.buckets(AR.slots(U32, tabT), AR.slots(String, ksT), SC.pow2(k))

def model(~V: Data, sh: Sh<V>) -> List<&2, S.Entry<V>>:
  match sh:
    case HS{n, +k, td, fresh, sz, sd, sdU, free, +tabT, +ksT, +vsT, nxT}:
      absm(~V, TB.buckets(AR.slots(U32, tabT), AR.slots(String, ksT), SC.pow2(k)), AR.slots(Maybe<&2, V>, vsT), SC.pow2(k), 0n)

# ---- the invariant ----

def memn(+s: Nat, xs: List<&2, Nat>) -> Bool:
  match xs:
    case Nil{}:
      False{}
    case Con{+x, t}:
      Bool.or(Nat.is_eq(x, s), memn(s, t))

# no full bucket among the first m uses slot s
def noslot(+bs: List<&2, B.Bk>, +s: Nat, +m: Nat) -> Bool:
  match m:
    case 0n:
      True{}
    case 1n+j:
      Bool.and(Bool.not(Bool.and(B.occ(B.at(bs, j)), Nat.is_eq(UD.v(H.slot(B.lnk(B.at(bs, j)))), s))), noslot(bs, s, j))

# the free list from link f: within fuel steps it ends, and every slot on it
# is below fresh, used by no bucket and not repeated
def fl_ok(+bs: List<&2, B.Bk>, +nb: Nat, +nxl: List<&2, U32>, +fuel: Nat, +f: U32, +fr: Nat, +seen: List<&2, Nat>) -> Bool:
  match fuel:
    case 0n:
      U32.is_eq(f, 0)
    case 1n+p:
      Bool.or(U32.is_eq(f, 0), Bool.and(Bool.and(Nat.is_lt(UD.v(H.slot(f)), fr), Bool.and(noslot(bs, UD.v(H.slot(f)), nb), Bool.not(memn(UD.v(H.slot(f)), seen)))), fl_ok(bs, nb, nxl, p, TB.nth0(nxl, UD.v(H.slot(f))), fr, Con{UD.v(H.slot(f)), seen})))

def ck(~V: Data, sh: Sh<V>) -> Bool:
  match sh:
    case HS{+n, +k, +td, +fresh, +sz, +sd, +sdU, +free, +tabT, +ksT, +vsT, +nxT}:
      Bool.and(Nat.is_lt(k, 31n), Nat.is_lt(0n, k))

def csd(~V: Data, sh: Sh<V>) -> Bool:
  match sh:
    case HS{+n, +k, +td, +fresh, +sz, +sd, +sdU, +free, +tabT, +ksT, +vsT, +nxT}:
      Nat.is_lt(sd, 32n)

def cpt(~V: Data, sh: Sh<V>) -> Bool:
  match sh:
    case HS{+n, +k, +td, +fresh, +sz, +sd, +sdU, +free, +tabT, +ksT, +vsT, +nxT}:
      AR.perfect(U32, 1n+k, tabT)

def cpk(~V: Data, sh: Sh<V>) -> Bool:
  match sh:
    case HS{+n, +k, +td, +fresh, +sz, +sd, +sdU, +free, +tabT, +ksT, +vsT, +nxT}:
      AR.perfect(String, sd, ksT)

def cpv(~V: Data, sh: Sh<V>) -> Bool:
  match sh:
    case HS{+n, +k, +td, +fresh, +sz, +sd, +sdU, +free, +tabT, +ksT, +vsT, +nxT}:
      AR.perfect(Maybe<&2, V>, sd, vsT)

def cpn(~V: Data, sh: Sh<V>) -> Bool:
  match sh:
    case HS{+n, +k, +td, +fresh, +sz, +sd, +sdU, +free, +tabT, +ksT, +vsT, +nxT}:
      AR.perfect(U32, sd, nxT)

def ctd(~V: Data, sh: Sh<V>) -> Bool:
  match sh:
    case HS{+n, +k, +td, +fresh, +sz, +sd, +sdU, +free, +tabT, +ksT, +vsT, +nxT}:
      Nat.is_eq(UD.v(td), 1n+k)

def csz(~V: Data, sh: Sh<V>) -> Bool:
  match sh:
    case HS{+n, +k, +td, +fresh, +sz, +sd, +sdU, +free, +tabT, +ksT, +vsT, +nxT}:
      Nat.is_eq(UD.v(sz), SC.pow2(sd))

def csdu(~V: Data, sh: Sh<V>) -> Bool:
  match sh:
    case HS{+n, +k, +td, +fresh, +sz, +sd, +sdU, +free, +tabT, +ksT, +vsT, +nxT}:
      Nat.is_eq(UD.v(sdU), sd)

def cwell(~V: Data, sh: Sh<V>) -> Bool:
  match sh:
    case HS{+n, +k, +td, +fresh, +sz, +sd, +sdU, +free, +tabT, +ksT, +vsT, +nxT}:
      B.all_lt(B.PWell{TB.buckets(AR.slots(U32, tabT), AR.slots(String, ksT), SC.pow2(k)), sd}, SC.pow2(k))

def cclus(~V: Data, sh: Sh<V>) -> Bool:
  match sh:
    case HS{+n, +k, +td, +fresh, +sz, +sd, +sdU, +free, +tabT, +ksT, +vsT, +nxT}:
      B.cluster(TB.buckets(AR.slots(U32, tabT), AR.slots(String, ksT), SC.pow2(k)), SC.pow2(k), CY.msk(k))

def cuniq(~V: Data, sh: Sh<V>) -> Bool:
  match sh:
    case HS{+n, +k, +td, +fresh, +sz, +sd, +sdU, +free, +tabT, +ksT, +vsT, +nxT}:
      B.all_lt(B.PUniq{TB.buckets(AR.slots(U32, tabT), AR.slots(String, ksT), SC.pow2(k))}, SC.pow2(k))

def cn(~V: Data, sh: Sh<V>) -> Bool:
  match sh:
    case HS{+n, +k, +td, +fresh, +sz, +sd, +sdU, +free, +tabT, +ksT, +vsT, +nxT}:
      Nat.is_eq(UD.v(n), IV.occn(TB.buckets(AR.slots(U32, tabT), AR.slots(String, ksT), SC.pow2(k)), SC.pow2(k)))

def cload(~V: Data, sh: Sh<V>) -> Bool:
  match sh:
    case HS{+n, +k, +td, +fresh, +sz, +sd, +sdU, +free, +tabT, +ksT, +vsT, +nxT}:
      Nat.is_le(Nat.double(UD.v(n)), SC.pow2(k))

def clive(~V: Data, sh: Sh<V>) -> Bool:
  match sh:
    case HS{+n, +k, +td, +fresh, +sz, +sd, +sdU, +free, +tabT, +ksT, +vsT, +nxT}:
      B.all_lt(B.PLive{TB.buckets(AR.slots(U32, tabT), AR.slots(String, ksT), SC.pow2(k)), lvs(~V, AR.slots(Maybe<&2, V>, vsT)), UD.v(fresh)}, SC.pow2(k))

def cfresh(~V: Data, sh: Sh<V>) -> Bool:
  match sh:
    case HS{+n, +k, +td, +fresh, +sz, +sd, +sdU, +free, +tabT, +ksT, +vsT, +nxT}:
      Nat.is_le(UD.v(fresh), UD.v(sz))

def cfree(~V: Data, sh: Sh<V>) -> Bool:
  match sh:
    case HS{+n, +k, +td, +fresh, +sz, +sd, +sdU, +free, +tabT, +ksT, +vsT, +nxT}:
      fl_ok(TB.buckets(AR.slots(U32, tabT), AR.slots(String, ksT), SC.pow2(k)), SC.pow2(k), AR.slots(U32, nxT), SC.pow2(sd), free, UD.v(fresh), Nil{})

