# ---- a fresh slot ----

def live_all(+bs: List<&2, B.Bk>, +lv: List<&2, Bool>, +f: Nat, +f2: Nat, +hle: {Nat.is_le(f, f2) == True{} : Bool}, +n: Nat, +h: {B.all_lt(B.PLive{bs, lv, f}, n) == True{} : Bool}, +m: Nat, +hm: {Nat.is_le(m, n) == True{} : Bool}) -> {B.all_lt(B.PLive{bs, lv, f2}, m) == True{} : Bool}:
  match m:
    case 0n:
      {==}
    case 1n+q:
      +hq = N.succ_le_lt(q, n, hm)
      L.and_intro(B.live_b(lv, f2, B.at(bs, q)), B.all_lt(B.PLive{bs, lv, f2}, q), IM.live_mono(lv, f, f2, hle, B.at(bs, q), B.all_inst(B.PLive{bs, lv, f}, n, h, q, hq)), live_all(bs, lv, f, f2, hle, n, h, q, N.lt_le(q, n, hq)))


