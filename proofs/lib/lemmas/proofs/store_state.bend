def bounded(-V: Data, +c: C.Cache<String, V>, +key: String, value: V, deadline: T.Int64, flag: Bool, events: List<&2, T.LruEvent<String, V>>) -> Data:
  {Nat.is_le(C.len(String, V, C.step_cache(String, V, C.store(String, V, c, key, key, value, deadline, flag, events))), C.capacity(String, V, c)) == True{} : Bool}

def output_valid(-V: Data, c: C.Cache<String, V>, +key: String, value: V, deadline: T.Int64, flag: Bool, events: List<&2, T.LruEvent<String, V>>, valid: {Inv.representation(~String, ~Codec.string_encode, V, c) == True{} : Bool}, room: bounded(V, c, key, value, deadline, flag, events)) -> {Inv.representation(~String, ~Codec.string_encode, V, C.step_cache(String, V, C.store(String, V, c, key, key, value, deadline, flag, events))) == True{} : Bool}:
  Rep.store(~String, ~Codec.string_encode, V, c, key, key, value, deadline, flag, events, valid, {==}, room)

def binding_lookup(-V: Data, +c: C.Cache<String, V>, +key: String, +value: V, +deadline: T.Int64, +flag: Bool, +events: List<&2, T.LruEvent<String, V>>, +query: String, +valid: {Inv.representation(~String, ~Codec.string_encode, V, c) == True{} : Bool}, room: bounded(V, c, key, value, deadline, flag, events)) -> {S.find(~String, ~Lookup.string_same, V, B.model_bindings(String, V, Order.normal(V, C.step_cache(String, V, C.store(String, V, c, key, key, value, deadline, flag, events)))), query) == Store.target(V, Order.normal(V, c), key, value, deadline, flag, events, query) : Maybe<&2, T.Entry<String, V>>}:
  C.State{+cap, +table, +order, +life, T.Counts{+i, +e, +r, +h, +m}, +cb} = c
  Equal.trans(Maybe<&2, T.Entry<String, V>>, S.find(~String, ~Lookup.string_same, V, B.model_bindings(String, V, Order.normal(V, C.step_cache(String, V, C.store(String, V, C.State{cap, table, order, life, T.Counts{i, e, r, h, m}, cb}, key, key, value, deadline, flag, events)))), query), C.lookup(String, V, C.step_cache(String, V, C.store(String, V, C.State{cap, table, order, life, T.Counts{i, e, r, h, m}, cb}, key, key, value, deadline, flag, events)), query), Store.target(V, Order.normal(V, C.State{cap, table, order, life, T.Counts{i, e, r, h, m}, cb}), key, value, deadline, flag, events, query), Equal.sym(Maybe<&2, T.Entry<String, V>>, C.lookup(String, V, C.step_cache(String, V, C.store(String, V, C.State{cap, table, order, life, T.Counts{i, e, r, h, m}, cb}, key, key, value, deadline, flag, events)), query), S.find(~String, ~Lookup.string_same, V, B.model_bindings(String, V, Order.normal(V, C.step_cache(String, V, C.store(String, V, C.State{cap, table, order, life, T.Counts{i, e, r, h, m}, cb}, key, key, value, deadline, flag, events)))), query), Removal.normal_lookup(V, C.step_cache(String, V, C.store(String, V, C.State{cap, table, order, life, T.Counts{i, e, r, h, m}, cb}, key, key, value, deadline, flag, events)), query, output_valid(V, C.State{cap, table, order, life, T.Counts{i, e, r, h, m}, cb}, key, value, deadline, flag, events, valid, room))), Store.correspondence(V, C.State{cap, table, order, life, T.Counts{i, e, r, h, m}, cb}, key, value, deadline, flag, events, query, valid))

def lookups_stored(-V: Data, +c: C.Cache<String, V>, +key: String, +value: V, +deadline: T.Int64, +flag: Bool, +events: List<&2, T.LruEvent<String, V>>, +valid: {Inv.representation(~String, ~Codec.string_encode, V, c) == True{} : Bool}, +room: bounded(V, c, key, value, deadline, flag, events), xs: List<&2, String>) -> {E.lookups(~String, ~Lookup.string_same, V, xs, B.model_bindings(String, V, Order.normal(V, C.step_cache(String, V, C.store(String, V, c, key, key, value, deadline, flag, events))))) == E.lookups(~String, ~Lookup.string_same, V, xs, B.model_bindings(String, V, O.observed_state(String, V, O.write(~String, ~Lookup.string_same, V, Order.normal(V, c), key, value, deadline, flag, events)))) : List<&2, Maybe<&2, T.Entry<String, V>>>}:
  match xs:
    case Nil{}: {==}
    case Con{+q, +rest}: CS.cons_equal(Maybe<&2, T.Entry<String, V>>, S.find(~String, ~Lookup.string_same, V, B.model_bindings(String, V, Order.normal(V, C.step_cache(String, V, C.store(String, V, c, key, key, value, deadline, flag, events)))), q), Store.target(V, Order.normal(V, c), key, value, deadline, flag, events, q), E.lookups(~String, ~Lookup.string_same, V, rest, B.model_bindings(String, V, Order.normal(V, C.step_cache(String, V, C.store(String, V, c, key, key, value, deadline, flag, events))))), E.lookups(~String, ~Lookup.string_same, V, rest, B.model_bindings(String, V, O.observed_state(String, V, O.write(~String, ~Lookup.string_same, V, Order.normal(V, c), key, value, deadline, flag, events)))), binding_lookup(V, c, key, value, deadline, flag, events, q, valid, room), lookups_stored(V, c, key, value, deadline, flag, events, valid, room, rest))

def normalized(-V: Data, +c: C.Cache<String, V>, +key: String, +value: V, +deadline: T.Int64, +flag: Bool, +events: List<&2, T.LruEvent<String, V>>, +valid: {Inv.representation(~String, ~Codec.string_encode, V, c) == True{} : Bool}, +room: bounded(V, c, key, value, deadline, flag, events)) -> E.states(~String, ~Lookup.string_same, V, Order.normal(V, C.step_cache(String, V, C.store(String, V, c, key, key, value, deadline, flag, events))), O.observed_state(String, V, O.write(~String, ~Lookup.string_same, V, Order.normal(V, c), key, value, deadline, flag, events))):
  C.State{+cap, +table, +order, +life, T.Counts{+i, +e, +r, +h, +m}, +cb} = c
  Native.by_fields(V, cap, List.append(&2, String, C.without(order, key), Con{key, Nil{}}), List.append(&2, String, S.unlist(~String, ~Lookup.string_same, order, key), Con{key, Nil{}}), life, T.Counts{Word.inc(64n, i), e, r, h, m}, cb, F.bindings(String, V, Map.to_list(&2, Maybe<&2, T.Entry<String, V>>, Map.set(&2, Maybe<&2, T.Entry<String, V>>, table, key, Some{T.Item{key, value, deadline}}))), Con{T.Item{key, value, deadline}, S.erase(~String, ~Lookup.string_same, V, F.bindings(String, V, Map.to_list(&2, Maybe<&2, T.Entry<String, V>>, table)), key)}, Equal.cong(List<&2, String>, List<&2, String>, xs => List.append(&2, String, xs, Con{key, Nil{}}), C.without(order, key), S.unlist(~String, ~Lookup.string_same, order, key), Order.filter(order, key)), lookups_stored(V, C.State{cap, table, order, life, T.Counts{i, e, r, h, m}, cb}, key, value, deadline, flag, events, valid, room, List.append(&2, String, S.unlist(~String, ~Lookup.string_same, order, key), Con{key, Nil{}})), Native.stray_normal(V, cap, Map.set(&2, Maybe<&2, T.Entry<String, V>>, table, key, Some{T.Item{key, value, deadline}}), List.append(&2, String, C.without(order, key), Con{key, Nil{}}), life, T.Counts{Word.inc(64n, i), e, r, h, m}, cb, output_valid(V, C.State{cap, table, order, life, T.Counts{i, e, r, h, m}, cb}, key, value, deadline, flag, events, valid, room)), CS.written_stray(V, cap, F.bindings(String, V, Map.to_list(&2, Maybe<&2, T.Entry<String, V>>, table)), order, life, T.Counts{Word.inc(64n, i), e, r, h, m}, cb, key, value, deadline, Native.stray_normal(V, cap, table, order, life, T.Counts{i, e, r, h, m}, cb, valid)))

# Internal store law: Add must derive room rather than exposing it as a public
# correctness assumption. All existing public Add capacity proofs are retained.
def correspondence(-V: Data, +c: C.Cache<String, V>, +key: String, +value: V, +deadline: T.Int64, +flag: Bool, +events: List<&2, T.LruEvent<String, V>>, +valid: {Inv.representation(~String, ~Codec.string_encode, V, c) == True{} : Bool}, +room: bounded(V, c, key, value, deadline, flag, events)) -> E.states(~String, ~Lookup.string_same, V, F.abstract(String, V, C.step_cache(String, V, C.store(String, V, c, key, key, value, deadline, flag, events))), O.observed_state(String, V, O.write(~String, ~Lookup.string_same, V, F.abstract(String, V, c), key, value, deadline, flag, events))):
  %Equal.sym(S.Model<String, V>, F.abstract(String, V, C.step_cache(String, V, C.store(String, V, c, key, key, value, deadline, flag, events))), Order.normal(V, C.step_cache(String, V, C.store(String, V, c, key, key, value, deadline, flag, events))), Order.normalize(V, C.step_cache(String, V, C.store(String, V, c, key, key, value, deadline, flag, events)), output_valid(V, c, key, value, deadline, flag, events, valid, room))) : E.states(~String, ~Lookup.string_same, V, _, O.observed_state(String, V, O.write(~String, ~Lookup.string_same, V, F.abstract(String, V, c), key, value, deadline, flag, events)))
  %Equal.sym(S.Model<String, V>, F.abstract(String, V, c), Order.normal(V, c), Order.normalize(V, c, valid)) : E.states(~String, ~Lookup.string_same, V, Order.normal(V, C.step_cache(String, V, C.store(String, V, c, key, key, value, deadline, flag, events))), O.observed_state(String, V, O.write(~String, ~Lookup.string_same, V, _, key, value, deadline, flag, events)))
  normalized(V, c, key, value, deadline, flag, events, valid, room)

def observation(-V: Data, +c: C.Cache<String, V>, +key: String, +value: V, +deadline: T.Int64, +flag: Bool, +events: List<&2, T.LruEvent<String, V>>, valid: {Inv.representation(~String, ~Codec.string_encode, V, c) == True{} : Bool}, room: bounded(V, c, key, value, deadline, flag, events)) -> E.observations(~String, ~Lookup.string_same, V, F.observe(String, V, C.store(String, V, c, key, key, value, deadline, flag, events)), O.write(~String, ~Lookup.string_same, V, F.abstract(String, V, c), key, value, deadline, flag, events)):
  C.State{+cap, +table, +order, +life, T.Counts{+i, +e, +r, +h, +m}, +cb} = c
  (correspondence(V, C.State{cap, table, order, life, T.Counts{i, e, r, h, m}, cb}, key, value, deadline, flag, events, valid, room), {==}, {==}, {==})
